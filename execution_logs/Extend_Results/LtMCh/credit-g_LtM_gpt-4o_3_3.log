# interaction_duration_zscore_credit_amount_to_income_ratio
# Feature description: Interaction term combining duration_zscore and credit_amount_to_income_ratio to detect patterns between loan duration and repayment burden.
# Usefulness: Reflects how longer or shorter loan durations might interplay with credit repayment burdens for assessing risk.
df['interaction_duration_zscore_credit_amount_to_income_ratio'] = df['duration_zscore'] * df['credit_amount_to_income_ratio']
end

python
# interaction_employment_checking_status
# Feature description: Combines employment_duration_encoded and checking_status to capture interactions between employment stability and financial standing.
# Usefulness: Captures how different employment durations interact with financial liquidity (checking status) to influence creditworthiness.
df['interaction_employment_checking_status'] = df['employment_duration_encoded'].astype(str) + '_' + df['checking_status']
end

python
# savings_flag_high
# Feature description: Aggregates one-hot encoded savings_status_* flags into a single binary feature indicating whether savings are high (>=500 Deutsche Mark).
# Usefulness: Simplifies representation of savings into a binary flag, consolidating valuable signals for model interpretability and risk assessment.
df['savings_flag_high'] = (df['savings_status_500<=X<1000'] | df['savings_status_>=1000']).astype(int)
end

python
# job_target_encoded
# Feature description: Target-encoded job feature based on average creditworthiness for each job category.
# Usefulness: Incorporates category-specific trends for occupations, reflecting how job types influence credit risk and repayment patterns.
job_target_map = df.groupby('job')['target'].mean()
df['job_target_encoded'] = df['job'].map(job_target_map)
end

python
# duration_credit_amount_bin
# Feature description: Bins the product of duration and credit_amount into quartiles, capturing non-linear effects of high loan requests over long durations.
# Usefulness: Captures risk trends associated with the simultaneous increase of loan size and repayment periods, ensuring pattern recognition in risky combinations.
df['duration_credit_amount_product'] = df['duration'] * df['credit_amount']
df['duration_credit_amount_bin'] = pd.qcut(df['duration_credit_amount_product'], 4, labels=False)
end

python
