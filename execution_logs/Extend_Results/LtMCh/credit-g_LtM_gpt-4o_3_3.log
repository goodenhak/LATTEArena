# credit_amount_to_income_ratio
# Feature description: Ratio of credit_amount to installment_commitment to approximate the burden of requested credit on disposable income.
# Usefulness: Provides insight into repayment burden relative to disposable income, reflecting affordability and potential risk.
df['credit_amount_to_income_ratio'] = df['credit_amount'] / df['installment_commitment']
end

python
# log_credit_amount
# Feature description: Log-transformed credit_amount to handle potential skewness in its distribution.
# Usefulness: Reduces the impact of large credit value outliers, aiding smoother model learning and enabling better generalization.
df['log_credit_amount'] = np.log(df['credit_amount'])
end

python
# duration_zscore
# Feature description: Z-score normalized duration feature to standardize variability across all ranges.
# Usefulness: Standardizes the duration feature, ensuring it has a comparable scale to other numerical features, reducing distortion caused by extreme loan durations.
df['duration_zscore'] = (df['duration'] - df['duration'].mean()) / df['duration'].std()
end

python
# purpose_target_encoded
# Feature description: Target-encoded purpose feature based on average creditworthiness values for each loan purpose category.
# Usefulness: Reflects correlation trends between loan purpose and approval likelihood, improving model capacity to identify category-level patterns.
purpose_target_map = df.groupby('purpose')['target'].mean()
df['purpose_target_encoded'] = df['purpose'].map(purpose_target_map)
end

python
# employment_duration_encoded
# Feature description: Label-encoded employment duration feature, converting categories into sequential ordinal values.
# Usefulness: Encodes job stability on an ordinal scale by ranking employment durations, reflecting their influence on credit decisions.
employment_map = {'unemployed': 0, '<1': 1, '1<=X<4': 2, '4<=X<7': 3, '>=7': 4}
df['employment_duration_encoded'] = df['employment_duration'].map(employment_map)
end

python
# installment_commitment_scaled
# Feature description: Min-max scaled installment_commitment to normalize values between 0 and 1.
# Usefulness: Prevents large installment values from disproportionately affecting model results, enhancing comparability of values.
df['installment_commitment_scaled'] = (df['installment_commitment'] - df['installment_commitment'].min()) / (df['installment_commitment'].max() - df['installment_commitment'].min())
end

python
# savings_status_encoded
# Feature description: One-hot encoded savings_status, creating separate binary flags for each savings category.
# Usefulness: Isolates contributions of individual savings categories, allowing the model to better leverage them as distinct creditworthiness indicators.
savings_status_dummies = pd.get_dummies(df['savings_status'], prefix='savings_status')
df = pd.concat([df, savings_status_dummies], axis=1)
end

python
# credit_history_encoded
# Feature description: One-hot encoded credit_history, generating binary flags to represent repayment behaviors.
# Usefulness: Captures differentiated risk insights from separate credit history categories, improving predictions by leveraging historical payment behavior.
credit_history_dummies = pd.get_dummies(df['credit_history'], prefix='credit_history')
df = pd.concat([df, credit_history_dummies], axis=1)
end

python
df.drop(columns=['credit_history', 'savings_status', 'employment_duration', 'installment_commitment', 'purpose'], inplace=True)
end
