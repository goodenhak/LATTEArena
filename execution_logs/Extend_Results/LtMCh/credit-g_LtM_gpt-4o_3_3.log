# log_credit_amount
# Feature description: Log-transformed credit_amount to handle potential skewness in the distribution of credit amounts.
# Usefulness: Reduces the impact of large credit amount outliers, ensuring smoother model learning.
df['log_credit_amount'] = np.log(df['credit_amount'])
end

python
# duration_zscore
# Feature description: Z-score normalized duration feature to standardize variability across its range.
# Usefulness: Allows duration to be treated on a comparable scale, reducing the influence of extreme values.
df['duration_zscore'] = (df['duration'] - df['duration'].mean()) / df['duration'].std()
end

python
# credit_amount_to_income_ratio
# Feature description: Ratio of credit_amount to installment_commitment to approximate the burden of requested credit on disposable income.
# Usefulness: Provides insight into the borrower’s repayment capability relative to their financial obligations.
df['credit_amount_to_income_ratio'] = df['credit_amount'] / df['installment_commitment']
end

python
# purpose_target_encoded
# Feature description: Target-encoded purpose feature based on average creditworthiness for each purpose category.
# Usefulness: Incorporates category-specific trends relating to the contribution of loan purpose to credit approval.
purpose_target_map = df.groupby('purpose')['target'].mean()
df['purpose_target_encoded'] = df['purpose'].map(purpose_target_map)
end

python
# employment_duration_encoded
# Feature description: Label encoded employment feature to translate the categories into ordinal numerical values.
# Usefulness: Quantitatively represents employment duration as a stability measure for model training.
employment_mapping = {'unemployed': 0, '<1': 1, '1<=X<4': 2, '4<=X<7': 3, '>=7': 4}
df['employment_duration_encoded'] = df['employment'].map(employment_mapping)
end

python
# installment_commitment_scaled
# Feature description: Min-max scaled installment_commitment to normalize it between 0 and 1.
# Usefulness: Prevents undue influence of larger installment rates on model training while keeping relative differences.
df['installment_commitment_scaled'] = (df['installment_commitment'] - df['installment_commitment'].min()) / (df['installment_commitment'].max() - df['installment_commitment'].min())
end

python
# savings_status_encoded
# Feature description: One-hot encoded savings_status to create separate binary flags for each savings status category.
# Usefulness: Captures the potential influence of different savings categories on creditworthiness as distinct signals.
savings_status_dummies = pd.get_dummies(df['savings_status'], prefix='savings_status')
df = pd.concat([df, savings_status_dummies], axis=1)
end

python
# credit_history_encoded
# Feature description: One-hot encoded credit_history to create separate binary flags for each credit history category.
# Usefulness: Enables the model to learn the impact of different credit history categories on repayment patterns.
credit_history_dummies = pd.get_dummies(df['credit_history'], prefix='credit_history')
df = pd.concat([df, credit_history_dummies], axis=1)
end

python
# interaction_duration_zscore_credit_amount_to_income_ratio
# Feature description: Interaction term combining duration_zscore and credit_amount_to_income_ratio to detect patterns between loan duration and repayment burden.
# Usefulness: Reflects how longer or shorter loan durations might interplay with credit repayment burdens for assessing risk.
df['interaction_duration_zscore_credit_amount_to_income_ratio'] = df['duration_zscore'] * df['credit_amount_to_income_ratio']
end

python
# savings_flag_high
# Feature description: Aggregates one-hot encoded savings_status_* flags into a single binary feature indicating whether savings are high (>=500 Deutsche Mark).
# Usefulness: Simplifies the representation of savings into a binary flag, consolidating valuable signals for model interpretability.
df['savings_flag_high'] = (df['savings_status_500<=X<1000'] | df['savings_status_>=1000']).astype(int)
end

python
# Drop redundant features
df.drop(columns=['savings_status_500<=X<1000', 'savings_status_>=1000', 'savings_status_no known savings', 'job', 'credit_history', 'savings_status', 'employment', 'installment_commitment', 'purpose'], inplace=True)
end
