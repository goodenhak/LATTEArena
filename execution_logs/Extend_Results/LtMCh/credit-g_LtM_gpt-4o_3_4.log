# ratio_credit_to_duration
# Ratio of credit amount to duration.
# Usefulness: This feature shows the loan intensity per month, providing insight into the burden of repayment relative to loan duration.
df['ratio_credit_to_duration'] = df['credit_amount'] / df['duration']
end

python
# credit_amount_log
# Log-transformed credit amount.
# Usefulness: Captures diminishing risk-return of high loan amounts and reduces skewness in credit_amount distribution.
df['credit_amount_log'] = np.log1p(df['credit_amount'])
end

python
# savings_status_encoded
# Encoded savings status into ordinal levels.
# Usefulness: Quantifies financial buffer for repayments, making it easier for models to interpret applicant's savings capacity.
savings_status_mapping = {'>=1000': 4, '500<=X<1000': 3, '100<=X<500': 2, '<100': 1, 'no known savings': 0}
df['savings_status_encoded'] = df['savings_status'].map(savings_status_mapping)
end

python
# income_stability_score
# Combined score for income stability from employment and savings.
# Usefulness: Aggregates applicant’s job stability (if available) and financial reserves into a single indicator of income stability.
df['income_stability_score'] = df['savings_status_encoded'] + df.get('employment_encoded', 0)
end

python
# loan_burden_score
# Combined loan burden score based on ratio of credit-to-duration and other obligations.
# Usefulness: Evaluates total strain on income due to loan commitments, aiding repayment capability prediction.
df['loan_burden_score'] = df['ratio_credit_to_duration'] * df.get('installment_commitment', 1)
end

python
# housing_encoded
# Encoded housing status into ordinal levels.
# Usefulness: Reflects applicant's residential stability and asset ownership type.
housing_mapping = {'own': 2, 'for free': 1, 'rent': 0}
df['housing_encoded'] = df['housing'].map(housing_mapping)
end

python
# property_encoded
# Encoded property magnitude into ordinal levels.
# Usefulness: Captures asset ownership as a measure of financial stability.
property_mapping = {'real estate': 3, 'life insurance': 2, 'car': 1, 'no known property': 0}
df['property_encoded'] = df['property_magnitude'].map(property_mapping)
end

python
# ownership_stability_score
# Combined score for housing and property magnitude.
# Usefulness: Represents financial stability and asset ownership, combining living and asset factors into a single score.
df['ownership_stability_score'] = df['housing_encoded'] + df['property_encoded']
end

python
# credit_history_encoded
# Encoded credit history into ordinal levels based on repayment behavior.
# Usefulness: Represents creditworthiness by simplifying payment history into a numerical rank of reliability.
credit_history_mapping = {'no credits/all paid': 4, 'all paid': 3, 'existing paid': 2, 'delayed previously': 1, 'critical/other existing credit': 0}
df['credit_history_encoded'] = df['credit_history'].map(credit_history_mapping)
end

python
df.drop(columns=['own_telephone'], inplace=True)
end

python
df.drop(columns=['num_dependents'], inplace=True)
end

python
df.drop(columns=['existing_credits'], inplace=True)
