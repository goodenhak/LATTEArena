# ratio_credit_to_duration
# Ratio of credit amount to duration.
# Usefulness: This feature shows the loan intensity per month, providing insight into the burden of repayment relative to loan duration.
df['ratio_credit_to_duration'] = df['credit_amount'] / df['duration']
end

python
# employment_encoded
# Encoded employment status into ordinal levels.
# Usefulness: Converts employment into a numeric scale reflecting income/job stability, making it easier for models to interpret.
employment_mapping = {>=7: 4, 4<=X<7: 3, 1<=X<4: 2, <1: 1, unemployed: 0}
df['employment_encoded'] = df['employment'].map(employment_mapping)
end

python
# savings_status_encoded
# Encoded savings status into ordinal levels.
# Usefulness: Converts savings information into a numeric scale to better represent the financial buffer for repayments.
savings_status_mapping = {>=1000: 4, 500<=X<1000: 3, 100<=X<500: 2, <100: 1, no known savings: 0}
df['savings_status_encoded'] = df['savings_status'].map(savings_status_mapping)
end

python
# credit_history_encoded
# Encoded credit history with ordinal values based on trustworthiness.
# Usefulness: Captures essential information about repayment behavior and credit risk.
credit_history_mapping = {no credits/all paid: 4, all paid: 3, existing paid: 2, delayed previously: 1, critical/other existing credit: 0}
df['credit_history_encoded'] = df['credit_history'].map(credit_history_mapping)
end

python
# age_bin
# Binned age into discreet categories.
# Usefulness: Groups age into ranges to capture lifecycle stages which could indicate financial habits and reliability.
bins = [0, 25, 35, 50, 75, float(inf)]
labels = [Young, Young Adult, Middle Aged, Senior, Elderly]
df['age_bin'] = pd.cut(df['age'], bins=bins, labels=labels)
end

python
# income_stability_score
# A combined score for income stability derived from employment and savings.
# Usefulness: Aggregates savings and employment stability to represent overall income reliability.
df['income_stability_score'] = df['employment_encoded'] + df['savings_status_encoded']
end

python
# loan_burden_score
# Combination of credit-to-duration ratio and installment commitment.
# Usefulness: Indicates the financial burden of the loan on disposable income.
df['loan_burden_score'] = df['ratio_credit_to_duration'] * df['installment_commitment']
end

python
# ownership_stability_score
# Encodes the interaction between housing and property magnitude.
