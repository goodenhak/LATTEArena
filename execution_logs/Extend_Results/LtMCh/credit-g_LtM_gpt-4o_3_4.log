# ratio_credit_to_duration
# Ratio of credit amount to duration.
# Usefulness: Represents the loan repayment burden per month for the applicant, providing insights into the intensity of repayment relative to loan duration.
df['ratio_credit_to_duration'] = df['credit_amount'] / df['duration']
end

python
# credit_history_encoded
# Encoded credit history into ordinal levels based on repayment behavior.
# Usefulness: Captures historical repayment reliability and creditworthiness in a numerical representation, aiding prediction models.
credit_history_mapping = {'no credits/all paid': 4, 'all paid': 3, 'existing paid': 2, 'delayed previously': 1, 'critical/other existing credit': 0}
df['credit_history_encoded'] = df['credit_history'].map(credit_history_mapping)
end

python
# savings_status_encoded
# Encoded savings status into ordinal levels.
# Usefulness: Quantifies the financial reserves of the applicant, directly impacting their ability to manage repayments effectively.
savings_status_mapping = {'>=1000': 4, '500<=X<1000': 3, '100<=X<500': 2, '<100': 1, 'no known savings': 0}
df['savings_status_encoded'] = df['savings_status'].map(savings_status_mapping)
end

python
# ownership_stability_score
# Combines housing and property encodings into a single stability score.
# Usefulness: Represents financial security by aggregating residential stability and asset ownership, simplifying the model's understanding of applicant stability.
housing_mapping = {'own': 2, 'for free': 1, 'rent': 0}
property_mapping = {'real estate': 3, 'life insurance': 2, 'car': 1, 'no known property': 0}
df['housing_encoded'] = df['housing'].map(housing_mapping)
df['property_encoded'] = df['property_magnitude'].map(property_mapping)
df['ownership_stability_score'] = df['housing_encoded'] + df['property_encoded']
end

python
# age_bin
# Binned age into lifecycle stages.
# Usefulness: Groups applicants into lifecycle stages, which may reflect financial maturity, spending patterns, and repayment risk.
bins = [0, 25, 35, 50, 75, float('inf')]
labels = ['Young', 'Young Adult', 'Middle Aged', 'Senior', 'Elderly']
df['age_bin'] = pd.cut(df['age'], bins=bins, labels=labels)
end

python
# income_stability_score
# Combined score for income stability from employment and savings.
# Usefulness: Aggregates employment reliability and financial reserves into a single indicator of overall income stability, improving predictive accuracy.
employment_mapping = {'>=7': 4, '4<=X<7': 3, '1<=X<4': 2, '<1': 1, 'unemployed': 0}
df['employment_encoded'] = df['employment'].map(employment_mapping)
df['income_stability_score'] = df['savings_status_encoded'] + df['employment_encoded']
end

python
df.drop(columns=['existing_credits'], inplace=True)
end

python
df.drop(columns=['num_dependents'], inplace=True)
end

python
df.drop(columns=['own_telephone'], inplace=True)
end
