# ratio_credit_to_duration
# Ratio of credit amount to duration in months
# Usefulness: Shows the loan intensity per month, providing insight into the burden of repayment relative to loan duration.
df['ratio_credit_to_duration'] = df['credit_amount'] / df['duration']
end

python
# income_stability_score
# Aggregated income stability from employment and savings
# Usefulness: Combines job stability (if available) and financial buffer to represent overall reliability of income source.
savings_status_mapping = {'>=1000': 4, '500<=X<1000': 3, '100<=X<500': 2, '<100': 1, 'no known savings': 0}
employment_mapping = {'>=7': 4, '4<=X<7': 3, '1<=X<4': 2, '<1': 1, 'unemployed': 0}
df['savings_status_encoded'] = df['savings_status'].map(savings_status_mapping)
df['employment_encoded'] = df['employment'].map(employment_mapping)
df['income_stability_score'] = df['savings_status_encoded'] + df['employment_encoded']
end

python
# ownership_stability_score
# Interaction of housing status and property magnitude
# Usefulness: Represents financial asset security by capturing residential stability and ownership-based assets into a single score.
housing_mapping = {'own': 2, 'for free': 1, 'rent': 0}
property_mapping = {'real estate': 3, 'life insurance': 2, 'car': 1, 'no known property': 0}
df['housing_encoded'] = df['housing'].map(housing_mapping)
df['property_encoded'] = df['property_magnitude'].map(property_mapping)
df['ownership_stability_score'] = df['housing_encoded'] + df['property_encoded']
end

python
# credit_history_encoded
# Encoding credit history into ordinal levels
# Usefulness: Captures repayment behavior and creditworthiness, providing a numeric indicator of risk.
credit_history_mapping = {'no credits/all paid': 4, 'all paid': 3, 'existing paid': 2, 'delayed previously': 1, 'critical/other existing credit': 0}
df['credit_history_encoded'] = df['credit_history'].map(credit_history_mapping)
end

python
# credit_amount_log
# Log-transformed credit amount
# Usefulness: Reduces skewness in credit amount while capturing diminishing risk-return dynamics of high loan amounts.
df['credit_amount_log'] = np.log1p(df['credit_amount'])
end

python
# age_bin
# Binning age into lifecycle stages
# Usefulness: Groups applicants into age categories reflecting lifecycle stages, which may impact financial habits and credit behavior.
bins = [0, 25, 35, 50, 75, float('inf')]
labels = ['Young', 'Young Adult', 'Middle Aged', 'Senior', 'Elderly']
df['age_bin'] = pd.cut(df['age'], bins=bins, labels=labels)
end

python
df.drop(columns=['own_telephone'], inplace=True)
end

python
df.drop(columns=['num_dependents'], inplace=True)
end

python
df.drop(columns=['existing_credits'], inplace=True)
