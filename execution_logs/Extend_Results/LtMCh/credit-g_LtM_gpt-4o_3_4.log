df['ownership_stability_score'] = df['housing_encoded'] + df['property_encoded']
end

python
# income_stability_score
# Aggregated score for income stability from savings status.
# Usefulness: Reflects the financial reliability of the applicant by considering both their savings and other financial buffers.
df['income_stability_score'] = df['savings_status_encoded']
end

python
# credit_stability_score
# Combined score of repayment burden and credit history.
# Usefulness: Represents the historical repayment behavior in relation to current financial obligations, capturing both reliability and stress.
df['credit_stability_score'] = df['ratio_credit_to_duration'] * df['credit_history_encoded']
end

python
# age_bin
# Binned age into lifecycle stages.
# Usefulness: Groups applicants into lifecycle stages (e.g., young, middle-aged) that may reflect financial maturity and risk levels.
bins = [0, 25, 35, 50, 75, float('inf')]
labels = ['Young', 'Young Adult', 'Middle Aged', 'Senior', 'Elderly']
df['age_bin'] = pd.cut(df['age'], bins=bins, labels=labels)
end

python
df.drop(columns=['existing_credits'], inplace=True)
end

python
df.drop(columns=['num_dependents'], inplace=True)
end

python
df.drop(columns=['own_telephone'], inplace=True)
end
