# ratio_credit_to_duration
# Ratio of credit amount to duration.
# Usefulness: Represents the repayment burden per month, providing insight into the intensity of the loan obligation relative to its duration.
df['ratio_credit_to_duration'] = df['credit_amount'] / df['duration']
end

python
# credit_amount_log
# Log-transformed credit amount.
# Usefulness: Reduces skewness in the credit amount distribution, capturing the diminishing risk-return dynamics of large loan amounts and improving model interpretability.
df['credit_amount_log'] = np.log1p(df['credit_amount'])
end

python
# savings_status_encoded
# Encoded savings status into ordinal levels.
# Usefulness: Quantifies the financial buffer for repayment, making it easier for models to interpret an applicant's financial reserves.
savings_status_mapping = {'>=1000': 4, '500<=X<1000': 3, '100<=X<500': 2, '<100': 1, 'no known savings': 0}
df['savings_status_encoded'] = df['savings_status'].map(savings_status_mapping)
end

python
# credit_history_encoded
# Encoded credit history into ordinal levels based on repayment behavior.
# Usefulness: Captures historical credit reliability by assigning numerical values to risk levels, facilitating downstream machine learning models.
credit_history_mapping = {'no credits/all paid': 4, 'all paid': 3, 'existing paid': 2, 'delayed previously': 1, 'critical/other existing credit': 0}
df['credit_history_encoded'] = df['credit_history'].map(credit_history_mapping)
end

python
# housing_encoded
# Encoded housing status into ordinal levels.
# Usefulness: Reflects the applicant's residential stability and ownership situation, which can serve as a proxy for financial security.
housing_mapping = {'own': 2, 'for free': 1, 'rent': 0}
df['housing_encoded'] = df['housing'].map(housing_mapping)
end

python
# property_encoded
# Encoded property magnitude into ordinal levels.
# Usefulness: Captures financial security through asset ownership by ranking ownership types based on stability and value.
property_mapping = {'real estate': 3, 'life insurance': 2, 'car': 1, 'no known property': 0}
df['property_encoded'] = df['property_magnitude'].map(property_mapping)
end

python
# ownership_stability_score
# Combined housing and property magnitude encoding into a single score.
# Usefulness: Represents financial stability based on residential situation and ownership-based assets, simplifying feature importance for predictions.
df['ownership_stability_score'] = df['housing_encoded'] + df['property_encoded']
end

python
# income_stability_score
# Aggregated score for income stability from savings status.
# Usefulness: Reflects the financial reliability of the applicant by considering both their savings and other financial buffers.
df['income_stability_score'] = df['savings_status_encoded']
end

python
# credit_stability_score
# Combined score of repayment burden and credit history.
# Usefulness: Represents the historical repayment behavior in relation to current financial obligations, capturing both reliability and stress.
df['credit_stability_score'] = df['ratio_credit_to_duration'] * df['credit_history_encoded']
end

python
# age_bin
# Binned age into lifecycle stages.
# Usefulness: Groups applicants into lifecycle stages (e.g., young, middle-aged) that may reflect financial maturity and risk levels.
bins = [0, 25, 35, 50, 75, float('inf')]
labels = ['Young', 'Young Adult', 'Middle Aged', 'Senior', 'Elderly']
df['age_bin'] = pd.cut(df['age'], bins=bins, labels=labels)
end

python
df.drop(columns=['existing_credits'], inplace=True)
end

python
df.drop(columns=['num_dependents'], inplace=True)
end

