# ratio_credit_to_duration
# Ratio of credit amount to duration.
# Usefulness: Represents repayment burden per month, useful for determining the intensity of the loan repayment relative to the loan duration.
df['ratio_credit_to_duration'] = df['credit_amount'] / df['duration']
end

python
# savings_status_encoded
# Encoded savings status into ordinal levels.
# Usefulness: Quantifies financial buffer, making it easier for models to interpret applicant's savings capacity.
savings_status_mapping = {'>=1000': 4, '500<=X<1000': 3, '100<=X<500': 2, '<100': 1, 'no known savings': 0}
df['savings_status_encoded'] = df['savings_status'].map(savings_status_mapping)
end

python
# credit_history_encoded
# Encoded credit history with ordinal values.
# Usefulness: Represents creditworthiness and repayment behavior in a simplified numeric format for prediction models.
credit_history_mapping = {'no credits/all paid': 4, 'all paid': 3, 'existing paid': 2, 'delayed previously': 1, 'critical/other existing credit': 0}
df['credit_history_encoded'] = df['credit_history'].map(credit_history_mapping)
end

python
# employment_encoded
# Encoded employment status into ordinal levels.
# Usefulness: Reflects job stability and income reliability in a numeric scale, aiding in creditworthiness analysis.
employment_mapping = {'>=7': 4, '4<=X<7': 3, '1<=X<4': 2, '<1': 1, 'unemployed': 0}
df['employment_encoded'] = df['employment'].map(employment_mapping)
end

python
# age_bin
# Binned age into discrete categories.
# Usefulness: Groups age into lifecycle stages to predict financial habits and maturity, impacting repayment behavior.
bins = [0, 25, 35, 50, 75, float('inf')]
labels = ['Young', 'Young Adult', 'Middle Aged', 'Senior', 'Elderly']
df['age_bin'] = pd.cut(df['age'], bins=bins, labels=labels)
end

python
# income_stability_score
# Combined score for income stability from employment and savings.
# Usefulness: Represents overall financial reliability, combining both job and savings stability.
df['income_stability_score'] = df['savings_status_encoded'] + df['employment_encoded']
end

python
# ownership_stability_score
# Encodes the interaction between housing and property magnitude into a stability score.
# Usefulness: Represents financial asset stability by combining housing and ownership status.
housing_mapping = {'own': 2, 'for free': 1, 'rent': 0}
property_mapping = {'real estate': 3, 'life insurance': 2, 'car': 1, 'no known property': 0}
df['ownership_stability_score'] = df['housing'].map(housing_mapping) + df['property_magnitude'].map(property_mapping)
end

