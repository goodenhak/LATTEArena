# SQRT_COMPACTNESS
# Square root of COMPACTNESS to emphasize smaller compactness values for nuanced shape comparisons.
# Usefulness: Helps in capturing subtle variations in compact vehicle shapes.
df['SQRT_COMPACTNESS'] = np.sqrt(df['COMPACTNESS'])
end

python
# CIRCULARITY_RATIO
# Ratio of CIRCULARITY to DISTANCE_CIRCULARITY reflecting balance between roundness and boundary spread.
# Usefulness: Differentiates more circular silhouettes from elongated or irregular ones.
df['CIRCULARITY_RATIO'] = df['CIRCULARITY'] / df['DISTANCE_CIRCULARITY']
end

python
# PR.AXIS_ASPECT_RATIO_RECIP
# Reciprocal of PR.AXIS_ASPECT_RATIO to amplify the importance of highly asymmetric silhouettes.
# Usefulness: Highlights discernible asymmetry in the vehicle shape, useful for less symmetric vehicle types.
df['PR.AXIS_ASPECT_RATIO_RECIP'] = 1 / df['PR.AXIS_ASPECT_RATIO']
end

python
# MAX_ASPECT_EXP
# Exponential of MAX.LENGTH_ASPECT_RATIO to magnify the importance of higher elongation ratios.
# Usefulness: Effectively differentiates vehicles like buses with extreme elongation from compact van-like shapes.
df['MAX_ASPECT_EXP'] = np.exp(df['MAX.LENGTH_ASPECT_RATIO'])
end

python
# COMPACTNESS_ELONGATEDNESS_RATIO
# Ratio of COMPACTNESS to ELONGATEDNESS combining shape density with stretching.
# Usefulness: Highlights contrasts between compact stretched vehicles and compact non-stretched ones.
df['COMPACTNESS_ELONGATEDNESS_RATIO'] = df['COMPACTNESS'] / df['ELONGATEDNESS']
end

python
# HOLLOWS_SHAPE_RATIO
# Ratio of HOLLOWS_RATIO to CIRCULARITY linking hollowness to roundness.
# Usefulness: Effective for isolating hollow-centered silhouettes like buses from solid ones like vans.
df['HOLLOWS_SHAPE_RATIO'] = df['HOLLOWS_RATIO'] / df['CIRCULARITY']
end

python
# ZSCORE_RADIUS_RATIO
# Z-Normalization of RADIUS_RATIO for consistent comparisons of silhouette irregularity.
# Usefulness: Reduces the effect of large spread in values, improving comparability across vehicle classes.
df['ZSCORE_RADIUS_RATIO'] = (df['RADIUS_RATIO'] - df['RADIUS_RATIO'].mean()) / df['RADIUS_RATIO'].std()
end

python
# MINMAX_SCATTER_RATIO
# Min-Max normalization of SCATTER_RATIO scaling it into a 0-1 range.
# Usefulness: Simplifies interpretation of inertia-related scatter differences between silhouettes.
df['MINMAX_SCATTER_RATIO'] = (df['SCATTER_RATIO'] - df['SCATTER_RATIO'].min()) / (df['SCATTER_RATIO'].max() - df['SCATTER_RATIO'].min())
end

python
# DIFF_RADIUS_CIRC
# Difference between RADIUS_RATIO and CIRCULARITY for assessing relative irregularity vs roundness.
# Usefulness: Captures uniquely shaped vehicles by emphasizing variations between irregularity and smoothness.
df['DIFF_RADIUS_CIRC'] = df['RADIUS_RATIO'] - df['CIRCULARITY']
end

python
df.drop(columns=['SKEWNESS_ABOUT_MINOR_AXIS', 'KURTOSIS_ABOUT_MINOR_AXIS'], inplace=True)
end
