# ZSCORE_COMPACTNESS
# Z-Score normalization of COMPACTNESS to standardize its scale for improved model learning.
# Usefulness: Handles differing scales and improves comparability across instances for compactness-related distinctions.

df['ZSCORE_COMPACTNESS'] = (df['COMPACTNESS'] - df['COMPACTNESS'].mean()) / df['COMPACTNESS'].std()
end

python
# LOG_SCALED_VARIANCE_ALONG_MINOR_AXIS 
# Log transformation of SCALED_VARIANCE_ALONG_MINOR_AXIS to reduce skewness and emphasize smaller values.
# Usefulness: Improves distribution uniformity and aids in separability of spatial spread characteristics.

df['LOG_SCALED_VARIANCE_ALONG_MINOR_AXIS'] = np.log(df['SCALED_VARIANCE_ALONG_MINOR_AXIS'])
end

python
# RATIO_MAJOR_TO_MINOR_VARIANCE
# Ratio of SCALED_VARIANCE_ALONG_MAJOR_AXIS to SCALED_VARIANCE_ALONG_MINOR_AXIS capturing relative spread patterns.
# Usefulness: Provides insights into how mass distribution differs along major and minor axes.

df['RATIO_MAJOR_TO_MINOR_VARIANCE'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] / df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# RECIP_MAX_LENGTH_ASPECT_RATIO
# Reciprocal of MAX.LENGTH_ASPECT_RATIO to amplify the importance of smaller aspect ratios.
# Usefulness: Highlights less elongated, compact shapes that may belong to specific vehicle classes.

df['RECIP_MAX_LENGTH_ASPECT_RATIO'] = 1 / df['MAX.LENGTH_ASPECT_RATIO']
end

python
# COMPACTNESS_CIRCULARITY_RATIO
# Ratio of COMPACTNESS to CIRCULARITY reflecting shape-to-area to roundness balance.
# Usefulness: Differentiates between highly compact yet irregular shapes and smoother circular ones.

df['COMPACTNESS_CIRCULARITY_RATIO'] = df['COMPACTNESS'] / df['CIRCULARITY']
end

python
# DIFF_MAJOR_MINOR_VARIANCE
# Difference between SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCALED_VARIANCE_ALONG_MINOR_AXIS for relative spread.
# Usefulness: Captures shape asymmetry and directional concentration.

df['DIFF_MAJOR_MINOR_VARIANCE'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
