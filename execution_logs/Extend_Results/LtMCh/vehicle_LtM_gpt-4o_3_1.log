df['DIFF_MAJOR_MINOR_VARIANCE'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# HOLLOWS_CIRCULARITY_RATIO
# Ratio of HOLLOWS_RATIO to CIRCULARITY to link hollowness with shape roundness.
# Usefulness: Identifies hollow-centered silhouettes like buses compared to compact, solid shapes like vans.
df['HOLLOWS_CIRCULARITY_RATIO'] = df['HOLLOWS_RATIO'] / df['CIRCULARITY']
end

python
# RECIP_RATIO_MAJOR_TO_MINOR_VARIANCE
# Reciprocal of RATIO_MAJOR_TO_MINOR_VARIANCE to amplify differences in smaller variance ratios.
# Usefulness: Highlights compact shapes with tight axis variance important for classification.
df['RECIP_RATIO_MAJOR_TO_MINOR_VARIANCE'] = 1 / df['RATIO_MAJOR_TO_MINOR_VARIANCE']
end

python
# LOG_SCALED_VARIANCE_ALONG_MINOR_AXIS
# Logarithm of SCALED_VARIANCE_ALONG_MINOR_AXIS to reduce skewness and focus on smaller spatial spreads.
# Usefulness: Improves the separability of mass spread along the minor axis across different vehicle types.
df['LOG_SCALED_VARIANCE_ALONG_MINOR_AXIS'] = np.log(df['SCALED_VARIANCE_ALONG_MINOR_AXIS'])
end

python
# ZSCORE_ELONGATION_HOLLOW_RATIO
# Z-score normalization of ELONGATION_HOLLOW_RATIO to standardize variation across the dataset.
# Usefulness: Allows the model to compare interaction effects of elongation and hollowness without scale bias.
df['ZSCORE_ELONGATION_HOLLOW_RATIO'] = (df['ELONGATION_HOLLOW_RATIO'] - df['ELONGATION_HOLLOW_RATIO'].mean()) / df['ELONGATION_HOLLOW_RATIO'].std()
end

python
# BIN_CIRCULARITY
# Binning CIRCULARITY values into quartiles to capture non-linear shape roundness.
# Usefulness: Simplifies the classification of silhouettes with significantly different circularity levels.
df['BIN_CIRCULARITY'] = pd.qcut(df['CIRCULARITY'], q=4, labels=False)
end

python
# DROP_UNUSED_COLUMNS
# Remove less informative columns to simplify the dataset and avoid model overfitting.
df.drop(columns=['SKEWNESS_ABOUT_MINOR_AXIS', 'KURTOSIS_ABOUT_MINOR_AXIS'], inplace=True)
end
