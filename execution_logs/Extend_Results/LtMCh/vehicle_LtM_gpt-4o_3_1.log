# LOG_DISTANCE_CIRCULARITY
# Logarithm of DISTANCE_CIRCULARITY to reduce skewness and emphasize smaller boundary irregularities.
# Usefulness: Highlights boundary compactness influence on silhouette variability.
df['LOG_DISTANCE_CIRCULARITY'] = np.log(df['DISTANCE_CIRCULARITY'])
end

python
# RATIO_MAJOR_TO_MINOR_VARIANCE
# Ratio of SCALED_VARIANCE_ALONG_MAJOR_AXIS to SCALED_VARIANCE_ALONG_MINOR_AXIS capturing relative spread along axes.
# Usefulness: Captures directional asymmetry in mass distribution, important for differentiating vehicle shapes.
df['RATIO_MAJOR_TO_MINOR_VARIANCE'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] / df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# COMPACTNESS_CIRCULARITY_RATIO
# Ratio of COMPACTNESS to CIRCULARITY to reflect the balance between shape compactness and roundness.
# Usefulness: Differentiates compact but irregular shapes from smoother, rounder shapes typical of certain vehicle classes.
df['COMPACTNESS_CIRCULARITY_RATIO'] = df['COMPACTNESS'] / df['CIRCULARITY']
end

python
# ELONGATION_HOLLOW_RATIO
# Ratio of ELONGATEDNESS to HOLLOWS_RATIO highlighting interplay between stretch and hollowness.
# Usefulness: Distinguishes elongated hollow shapes like buses from compact solid shapes like vans.
df['ELONGATION_HOLLOW_RATIO'] = df['ELONGATEDNESS'] / df['HOLLOWS_RATIO']
end

python
# DIFF_RADIUS_CIRCULARITY
# Difference between RADIUS_RATIO and CIRCULARITY to assess relative irregularity versus roundness.
# Usefulness: Provides nuanced insights into shape variability across irregular and smooth silhouettes.
df['DIFF_RADIUS_CIRCULARITY'] = df['RADIUS_RATIO'] - df['CIRCULARITY']
end

python
# SQRT_COMPACTNESS
# Square root of COMPACTNESS to emphasize smaller compactness values for nuanced shape comparisons.
# Usefulness: Helps capture subtle variations in compact vehicle shapes.
df['SQRT_COMPACTNESS'] = np.sqrt(df['COMPACTNESS'])
end

python
# PR.AXIS_ADJUSTED_COMPACTNESS
# Product of PR.AXIS_ASPECT_RATIO and COMPACTNESS adjusting symmetry influence on compactness.
# Usefulness: Reflects how symmetry impacts compactness in the vehicle silhouette, emphasizing balance and asymmetry.
df['PR.AXIS_ADJUSTED_COMPACTNESS'] = df['PR.AXIS_ASPECT_RATIO'] * df['COMPACTNESS']
end

python
# RECIP_MAX_LENGTH_ASPECT_RATIO
# Reciprocal of MAX.LENGTH_ASPECT_RATIO to amplify the importance of smaller aspect ratios.
# Usefulness: Highlights less elongated, compact shapes that may belong to specific vehicle classes.
df['RECIP_MAX_LENGTH_ASPECT_RATIO'] = 1 / df['MAX.LENGTH_ASPECT_RATIO']
end

python
# LOG_SCALED_VARIANCE_ALONG_MINOR_AXIS
# Log transformation of SCALED_VARIANCE_ALONG_MINOR_AXIS to reduce skewness and emphasize smaller spatial spreads.
# Usefulness: Improves distribution uniformity and separability of mass distribution along the minor axis.
df['LOG_SCALED_VARIANCE_ALONG_MINOR_AXIS'] = np.log(df['SCALED_VARIANCE_ALONG_MINOR_AXIS'])
end

python
