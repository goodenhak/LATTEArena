# Usefulness: Improves distribution uniformity and aids in distinguishing mass spread variations across vehicles.
df['LOG_SCALED_VARIANCE_ALONG_MINOR_AXIS'] = np.log(df['SCALED_VARIANCE_ALONG_MINOR_AXIS'])
end

python
