# LOG_COMPACTNESS
# Logarithm of COMPACTNESS to reduce skewness and emphasize smaller compactness values for nuanced shape differences.
# Usefulness: Highlights meaningful shape density differences often observed among smaller vehicles, aiding in classification.
df['LOG_COMPACTNESS'] = np.log(df['COMPACTNESS'])
end

python
# COMPACTNESS_CIRCULARITY_RATIO
# Ratio of COMPACTNESS to CIRCULARITY reflecting the balance between density and roundness.
# Usefulness: Differentiates compact irregular shapes from rounder and smoother shapes across vehicle classes.
df['COMPACTNESS_CIRCULARITY_RATIO'] = df['COMPACTNESS'] / df['CIRCULARITY']
end

python
# RECIP_RATIO_MAJOR_TO_MINOR_VARIANCE
# Reciprocal of RATIO_MAJOR_TO_MINOR_VARIANCE to amplify smaller ratios where compact shapes with tight variance are captured.
# Usefulness: Highlights differences in compact, symmetric shapes, improving finer class distinctions (e.g., between compact cars and buses).
df['RECIP_RATIO_MAJOR_TO_MINOR_VARIANCE'] = 1 / df['RATIO_MAJOR_TO_MINOR_VARIANCE']
end

python
# LOG_SCALED_VARIANCE_ALONG_MINOR_AXIS
# Logarithmic transformation of SCALED_VARIANCE_ALONG_MINOR_AXIS to mitigate skewness and focus on subtle spatial spreads along the minor axis.
# Usefulness: Distinguishes mass spread variations along the minor axis across vehicle classes, such as elongated buses and compact vans.
df['LOG_SCALED_VARIANCE_ALONG_MINOR_AXIS'] = np.log(df['SCALED_VARIANCE_ALONG_MINOR_AXIS'])
end

python
# HOLLOWS_CIRCULARITY_RATIO
# Ratio of HOLLOWS_RATIO to CIRCULARITY linking hollowness to silhouette roundness.
# Usefulness: Useful for isolating hollow-centered silhouettes (e.g., buses) from compact, solid, and round shapes (e.g., vans).
df['HOLLOWS_CIRCULARITY_RATIO'] = df['HOLLOWS_RATIO'] / df['CIRCULARITY']
end

python
# ZSCORE_ELONGATION_HOLLOW_RATIO
# Z-score normalization of ELONGATION_HOLLOW_RATIO to standardize variation and suppress scale effects.
# Usefulness: Ensures comparative consistency in elongation vs hollowness across the dataset, aiding in classification.
df['ZSCORE_ELONGATION_HOLLOW_RATIO'] = (df['ELONGATION_HOLLOW_RATIO'] - df['ELONGATION_HOLLOW_RATIO'].mean()) / df['ELONGATION_HOLLOW_RATIO'].std()
end

python
# DIFF_MAJOR_MINOR_VARIANCE
# Difference between SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCALED_VARIANCE_ALONG_MINOR_AXIS to capture spatial asymmetry.
# Usefulness: Highlights distributional asymmetry critical for distinguishing elongated shapes like buses or compact solid shapes like vans.
df['DIFF_MAJOR_MINOR_VARIANCE'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# BIN_CIRCULARITY
# Binning CIRCULARITY into quartiles to categorize roundness levels across vehicles.
# Usefulness: Groups silhouettes with similar roundness properties to simplify classification differences, especially between buses and vans.
df['BIN_CIRCULARITY'] = pd.qcut(df['CIRCULARITY'], q=4, labels=False)
end

