# SQRT_COMPACTNESS
# Square root of COMPACTNESS to emphasize smaller compactness values for nuanced shape comparisons.
# Usefulness: Highlights subtle variations in compact vehicle shapes, useful for distinguishing between compact cars like OPEL and vans.
df['SQRT_COMPACTNESS'] = np.sqrt(df['COMPACTNESS'])
end

python
# PR.AXIS_ADJUSTED_COMPACTNESS
# Product of PR.AXIS_ASPECT_RATIO and COMPACTNESS to adjust symmetry's influence on compactness.
# Usefulness: Captures balance and asymmetry in vehicle silhouettes, critical for shape-based classification.
df['PR.AXIS_ADJUSTED_COMPACTNESS'] = df['PR.AXIS_ASPECT_RATIO'] * df['COMPACTNESS']
end

python
# LOG_COMPACTNESS
# Logarithmic function of COMPACTNESS to reduce skewness and focus on lower compactness values.
# Usefulness: Helps highlight meaningful shape density differences often observed among smaller vehicles.
df['LOG_COMPACTNESS'] = np.log(df['COMPACTNESS'])
end

python
# COMPACTNESS_CIRCULARITY_RATIO
# Ratio of COMPACTNESS to CIRCULARITY for balancing compactness and smoothness.
# Usefulness: Differentiates shapes that are compact but irregular from rounder and smoother vehicle silhouettes.
df['COMPACTNESS_CIRCULARITY_RATIO'] = df['COMPACTNESS'] / df['CIRCULARITY']
end

python
# DIFF_MAJOR_MINOR_VARIANCE
# Difference between SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCALED_VARIANCE_ALONG_MINOR_AXIS to capture axis variability.
# Usefulness: Highlights asymmetry in mass distribution, which is critical to identifying elongated shapes like buses.
df['DIFF_MAJOR_MINOR_VARIANCE'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# HOLLOWS_CIRCULARITY_RATIO
# Ratio of HOLLOWS_RATIO to CIRCULARITY to associate hollowness with smoothness.
# Usefulness: Isolates hollow-focused silhouettes such as buses versus solid, compact, and rounder shapes such as vans.
df['HOLLOWS_CIRCULARITY_RATIO'] = df['HOLLOWS_RATIO'] / df['CIRCULARITY']
end

python
# RECIP_RATIO_MAJOR_TO_MINOR_VARIANCE
# Reciprocal of RATIO_MAJOR_TO_MINOR_VARIANCE to emphasize smaller axis variance ratios.
# Usefulness: Highlights differences in compact shapes with tight variance distributions, aiding finer class separation.
df['RECIP_RATIO_MAJOR_TO_MINOR_VARIANCE'] = 1 / df['RATIO_MAJOR_TO_MINOR_VARIANCE']
end

python
# LOG_SCALED_VARIANCE_ALONG_MINOR_AXIS
# Logarithm of SCALED_VARIANCE_ALONG_MINOR_AXIS for reducing skewness and focusing on smaller spatial spreads.
# Usefulness: Distinguishes minor axis mass spread variations across vehicles, crucial for classification.
df['LOG_SCALED_VARIANCE_ALONG_MINOR_AXIS'] = np.log(df['SCALED_VARIANCE_ALONG_MINOR_AXIS'])
end

python
# ZSCORE_ELONGATION_HOLLOW_RATIO
# Z-score normalization of ELONGATION_HOLLOW_RATIO to standardize its distribution.
# Usefulness: Ensures elongation vs hollowness interplay is consistently comparable across diverse vehicle types.
df['ZSCORE_ELONGATION_HOLLOW_RATIO'] = (df['ELONGATION_HOLLOW_RATIO'] - df['ELONGATION_HOLLOW_RATIO'].mean()) / df['ELONGATION_HOLLOW_RATIO'].std()
end

python
# BIN_CIRCULARITY
# Binning CIRCULARITY into quartiles to capture non-linear shape roundness.
# Usefulness: Simplifies classification of vehicles with significant differences in circularity, such as buses vs vans.
df['BIN_CIRCULARITY'] = pd.qcut(df['CIRCULARITY'], q=4, labels=False)
end

python
df.drop(columns=['SKEWNESS_ABOUT_MINOR_AXIS', 'KURTOSIS_ABOUT_MINOR_AXIS'], inplace=True)
end
