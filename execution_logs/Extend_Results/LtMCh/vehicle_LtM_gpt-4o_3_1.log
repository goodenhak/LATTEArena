# Usefulness: Reflects how symmetry impacts compactness in the vehicle silhouette.

df['PRINCIPAL_AXIS_ADJUSTED_COMPACTNESS'] = df['PR.AXIS_ASPECT_RATIO'] * df['COMPACTNESS']
end

python
