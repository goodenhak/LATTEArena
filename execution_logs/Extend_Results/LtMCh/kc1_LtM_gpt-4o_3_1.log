# complexity_ratio
# Cyclomatic complexity per line of code, capturing the density of decision points within the code.
# Usefulness: Higher complexity per line indicates modules that are harder to maintain and more error-prone, aligning with software defect likelihood.
df['complexity_ratio'] = df['v(g)'] / (df['loc'] + 1e-5)
end

python
# essential_complexity_ratio
# Essential complexity as a fraction of total cyclomatic complexity.
# Usefulness: Reflects the fundamental complexity of the code logic, useful in identifying inherently harder-to-debug modules.
df['essential_complexity_ratio'] = df['ev(g)'] / (df['v(g)'] + 1e-5)
end

python
# effort_per_volume
# Effort required per unit of Halstead volume.
# Usefulness: Captures inefficiencies by normalizing effort with respect to the code size, highlighting potentially problematic areas.
df['effort_per_volume'] = df['e'] / (df['v'] + 1e-5)
end

python
# comment_density
# Lines of comments per line of code.
# Usefulness: Higher comment density suggests better readability and maintainability, which can reduce defect occurrence.
df['comment_density'] = df['lOComment'] / (df['loc'] + 1e-5)
end

python
# blank_density
# Blank lines per line of code.
# Usefulness: Indicates readability and potential structural issues, where excessive blanks might suggest inefficiencies or poor formatting.
df['blank_density'] = df['lOBlank'] / (df['loc'] + 1e-5)
end

python
# log_effort
# Logarithm of Halstead effort.
# Usefulness: Stabilizes skewed distributions of effort measurements, making predictions more robust to outliers.
df['log_effort'] = np.log(df['e'] + 1)
end

python
# log_volume
# Logarithm of Halstead volume.
# Usefulness: Reduces skew in the volume distribution, ensuring better generalizability for different module sizes.
df['log_volume'] = np.log(df['v'] + 1)
end

python
# log_loc
# Logarithm of lines of code.
# Usefulness: Normalizes the distribution of code size, helping the model process information from modules of varying lengths.
df['log_loc'] = np.log(df['loc'] + 1)
end

python
# design_vs_code_complexity
# Design complexity as a fraction of overall cyclomatic complexity.
# Usefulness: Highlights how much of a module’s complexity derives from design decisions rather than its logic, aiding maintainability analysis.
df['design_vs_code_complexity'] = df['iv(g)'] / (df['v(g)'] + 1e-5)
end

python
# normalized_operands
# Density of total operands relative to unique operands.
# Usefulness: Measures operand reuse patterns, where higher values may indicate redundancy and potential for inefficiencies in code.
df['normalized_operands'] = df['total_Opnd'] / (df['uniq_Opnd'] + 1e-5)
end

python
# intelligence_ratio
# Intelligence per Halstead effort.
# Usefulness: Indicates how efficiently effort is translated into readable and maintainable code, which correlates with defect rates.
df['intelligence_ratio'] = df['i'] / (df['e'] + 1e-5)
end

python
# rolling_mean_v
# Rolling mean of Halstead volume (window=3).
# Usefulness: Captures local trends in code volume, highlighting areas with increasing or decreasing complexity.
df['rolling_mean_v'] = df['v'].rolling(window=3, min_periods=1).mean()
end

python
# rolling_mean_e
# Rolling mean of Halstead effort (window=3).
# Usefulness: Identifies local effort spikes, providing insight into periods of inconsistent effort that might lead to defects.
df['rolling_mean_e'] = df['e'].rolling(window=3, min_periods=1).mean()
end

python
# loc_to_code_comment_ratio
# Ratio of lines of code (loc) to lines of code and comment (locCodeAndComment).
# Usefulness: Highlights the proportion of uncommented code, which could signal maintainability and defect risks.
df['loc_to_code_comment_ratio'] = df['loc'] / (df['locCodeAndComment'] + 1e-5)
end

python
