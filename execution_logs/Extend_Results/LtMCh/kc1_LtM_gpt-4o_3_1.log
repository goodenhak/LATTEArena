_complexity\n# Design complexity as a fraction of overall cyclomatic complexity.\n# Usefulness: Separates design-induced complexity from logic-based complexity, identifying maintainability issues in code design.\ndf['design_vs_code_complexity'] = df['iv(g)'] / (df['v(g)'] + 1e-5)", "# normalized_operands\n# Density of total operands relative to unique operands.\n# Usefulness: Highlights repetition in operand usage, with high values pointing to inefficiencies or redundancy in code.\ndf['normalized_operands'] = df['total_Opnd'] / (df['uniq_Opnd'] + 1e-5)", "# intelligence_ratio\n# Intelligence per Halstead effort.\n# Usefulness: Measures the efficiency of code effort in producing intelligent code, identifying areas with potential defects.\ndf['intelligence_ratio'] = df['i'] / (df['e'] + 1e-5)", "# loc_to_code_comment_ratio\n# Ratio of lines of code (loc) to lines of code and comment (locCodeAndComment).\n# Usefulness: Captures the proportion of uncommented code, indicating potential maintainability and defect density issues.\ndf['loc_to_code_comment_ratio'] = df['loc'] / (df['locCodeAndComment'] + 1e-5)", "# rolling_mean_v\n# Rolling mean of Halstead volume (window=3).\n# Usefulness: Detects trends in code volume, indicating problematic areas prone to defects or quick interventions.\ndf['rolling_mean_v'] = df['v'].rolling(window=3, min_periods=1).mean()", "# rolling_mean_e\n# Rolling mean of Halstead effort (window=3).\n# Usefulness: Highlights spikes in effort, which may indicate error-prone code areas.\ndf['rolling_mean_e'] = df['e'].rolling(window=3, min_periods=1).mean()", "# rolling_std_v\n# Rolling standard deviation of Halstead volume over a window of 3.\n# Usefulness: Identifies fluctuation in code size consistency, revealing modules with varying complexity.\ndf['rolling_std_v'] = df['v'].rolling(window=3, min_periods=1).std()", "# rolling_std_e\n# Rolling standard deviation of Halstead effort over a window of 3.\n# Usefulness: Highlights variation in the effort required, pointing to efficiency inconsistencies across modules.\ndf['rolling_std_e'] = df['e'].rolling(window=3, min_periods=1).std()", "# volume_effort_ratio\n# Ratio of Halstead volume to effort.\n# Usefulness: Validates how aligned the module size is to projected effort, with high deviations indicating potential coding inefficiencies.\ndf['volume_effort_ratio'] = df['v'] / (df['e'] + 1e-5)", "# loc_effort_ratio\n# Effort required per line of code.\n# Usefulness: Detects areas of inefficiency by highlighting above-average effort for the size of code modules.\ndf['loc_effort_ratio'] = df['e'] / (df['loc'] + 1e-5)", "# loc_volume_ratio\n# Halstead volume per line of code.\n# Usefulness: Indicates computational density, helping identify complexity hotspots in modules.\ndf['loc_volume_ratio'] = df['v'] / (df['loc'] + 1e-5)", "# opcode_reuse_ratio\n# Ratio of total operators to unique operators.\n# Usefulness: Indicates repetitive or redundant operator usage, which may introduce maintainability or efficiency issues.\ndf['opcode_reuse_ratio'] = df['total_Op'] / (df['uniq_Op'] + 1e-5)", "# operand_reuse_ratio\n# Ratio of total operands to unique operands.\n# Usefulness: Highlights repetition patterns in operand usage, which could imply inefficiencies or low-quality code.\ndf['operand_reuse_ratio'] = df['total_Opnd'] / (df['uniq_Opnd'] + 1e-5)", "# effort_intelligence_ratio\n# Ratio of Halstead effort to intelligence.\n# Usefulness: Identifies inefficient effort investment, indicating areas of potential defect injection.\ndf['effort_intelligence_ratio'] = df['e'] / (df['i'] + 1e-5)", "# cumsum_effort\n# Cumulative sum of Halstead effort across the dataset.\n# Usefulness: Identifies high-effort zones within the overall system, shedding light on resource-demanding modules.\ndf['cumsum_effort'] = df['e'].cumsum()", "# cumsum_volume\n# Cumulative sum of Halstead volume across the dataset.\n# Usefulness: Highlights zones contributing disproportionately to overall code comp