# complexity_ratio
# Cyclomatic complexity per line of code.
# Usefulness: Higher complexity per line can indicate modules that are harder to maintain or more error-prone, correlating with defect likelihood.
df['complexity_ratio'] = df['v(g)'] / (df['loc'] + 1e-5)
end

python
# essential_complexity_ratio
# Essential complexity as a fraction of total cyclomatic complexity.
# Usefulness: Highlights fundamental complexity versus optional complexity in the code, aiding in debugging and quality assessment.
df['essential_complexity_ratio'] = df['ev(g)'] / (df['v(g)'] + 1e-5)
end

python
# effort_per_volume
# Effort required per unit of Halstead volume.
# Usefulness: Reveals inefficiency by normalizing effort with respect to the size of the code, indicating potentially problematic areas.
df['effort_per_volume'] = df['e'] / (df['v'] + 1e-5)
end

python
# comment_density
# Lines of comments per line of code.
# Usefulness: Higher comment density suggests better readability and maintainability, reducing defect occurrence.
df['comment_density'] = df['lOComment'] / (df['loc'] + 1e-5)
end

python
# blank_density
# Blank lines per line of code.
# Usefulness: Indicates structural readability and possible redundancy, which can reflect maintainability of the code.
df['blank_density'] = df['lOBlank'] / (df['loc'] + 1e-5)
end

python
# log_effort
# Logarithm of Halstead effort.
# Usefulness: Stabilizes the distribution of effort, ensuring the model is less influenced by extreme values in large modules.
df['log_effort'] = np.log(df['e'] + 1)
end

python
# log_volume
# Logarithm of Halstead volume.
# Usefulness: Reduces skewness in volume distribution, helping the model generalize better over varying code sizes.
df['log_volume'] = np.log(df['v'] + 1)
end

python
# log_loc
# Logarithm of lines of code.
# Usefulness: Normalizes the distribution of lines of code for better interpretability and reduces the effect of outliers.
df['log_loc'] = np.log(df['loc'] + 1)
end

python
