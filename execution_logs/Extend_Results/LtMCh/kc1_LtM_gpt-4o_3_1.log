[{'["# loc_to_code_comment_ratio\\n# Ratio of lines of code (loc) to lines of code and comment (locCodeAndComment).\\n# Usefulness: Captures the proportion of uncommented code within a module, indicating maintainability and likely defect density.\\ndf[\'loc_to_code_comment_ratio\'] = df[\'loc\'] / (df[\'locCodeAndComment\'] + 1e-5)", "# comment_blank_ratio\\n# Ratio of lines of comments to blank lines.\\n# Usefulness: Balances structural organization versus documentation to identify areas potentially lacking proper commentary.\\ndf[\'comment_blank_ratio\'] = df[\'lOComment\'] / (df[\'lOBlank\'] + 1e-5)", "# essential_complexity_to_design_ratio\\n# Ratio of essential complexity to design complexity.\\n# Usefulness: Indicates whether code complexity arises more from the essential logic or from design decisions, useful for debugging.\\ndf[\'essential_complexity_to_design_ratio\'] = df[\'ev(g)\'] / (df[\'iv(g)\'] + 1e-5)", "# v(g)_to_branch_ratio\\n# Ratio of cyclomatic complexity (v(g)) to branch count.\\n# Usefulness: Reflects decision-making density in code, aiding in identifying overly complex branching structures.\\ndf[\'v(g)_to_branch_ratio\'] = df[\'v(g)\'] / (df[\'branchCount\'] + 1e-5)", "# effort_intelligence_ratio\\n# Ratio of Halstead effort to intelligence.\\n# Usefulness: Measures how well the effort aligns with intelligent code implementation, with inefficient efforts indicating potential defects.\\ndf[\'effort_intelligence_ratio\'] = df[\'e\'] / (df[\'i\'] + 1e-5)", "# difficulty_per_line\\n# Halstead difficulty normalized by lines of code (loc).\\n# Usefulness: Provides the average difficulty of a module per line, capturing complexity normalized by size.\\ndf[\'difficulty_per_line\'] = df[\'d\'] / (df[\'loc\'] + 1e-5)", "# opcode_reuse_ratio\\n# Ratio of total operators to unique operators.\\n# Usefulness: Indicates operator repetition, where higher values can imply redundant or non-optimized code patterns leading to errors.\\ndf[\'opcode_reuse_ratio\'] = df[\'total_Op\'] / (df[\'uniq_Op\'] + 1e-5)", "# operand_reuse_ratio\\n# Ratio of total operands to unique operands.\\n# Usefulness: Highlights operand reuse, which may signify inefficiencies or repetitive patterns in the code.\\ndf[\'operand_reuse_ratio\'] = df[\'total_Opnd\'] / (df[\'uniq_Opnd\'] + 1e-5)", "# rolling_std_v\\n# Rolling standard deviation of Halstead volume over a window of 3.\\n# Usefulness: Identifies fluctuations in code volume, highlighting inconsistent complexity over consecutive modules.\\ndf[\'rolling_std_v\'] = df[\'v\'].rolling(window=3, min_periods=1).std()", "# rolling_std_e\\n# Rolling standard deviation of Halstead effort over a window of 3.\\n# Usefulness: Detects variability in effort requirements, indicating inconsistencies in code efficiency or maintainability.\\ndf[\'rolling_std_e\'] = df[\'e\'].rolling(window=3, min_periods=1).std()", "# volume_effort_ratio\\n# Ratio of Halstead volume to effort.\\n# Usefulness: Validates correspondence between module size (volume) and effort, where low values may reveal inefficient coding practices.\\ndf[\'volume_effort_ratio\'] = df[\'v\'] / (df[\'e\'] + 1e-5)", "# loc_effort_ratio\\n# Effort required per line of code.\\n# Usefulness: Indicates the distribution of effort needed within a module, highlighting potential areas of inefficiency.\\ndf[\'loc_effort_ratio\'] = df[\'e\'] / (df[\'loc\'] + 1e-5)", "# loc_volume_ratio\\n# Halstead volume per line of code.\\n# Usefulness: Highlights density of computation in a module and can indicate potential hotspots for defects or inefficiencies.\\ndf[\'loc_volume_ratio\'] = df[\'v\'] / (df[\'loc\'] + 1e-5)", "# cumsum_effort\\n# Cumulative sum of Halstead effort across the dataset.\\n# Usefulness: Tracks the cumulative effort required, identifying overall areas within the codebase demanding high effort.\\ndf[\'cumsum_effort\'] = df[\'e\'].cumsum()", "# cumsum_volume\\n# Cumulative sum of Halstead volume across the dataset.\\n# Usefulness: Monitors total accumulated complexity, shedding light on modules contributing disproportionately to overall complexity.\\ndf[\'cumsum_volume\'] = df[\'v\'].cumsum()"]': 0.016587677725118488}, {'["# complexity_ratio\\n# Cyclomatic complexity per line of code, capturing the density of decision points within the code.\\n# Usefulness: Higher complexity per line can indicate modules that are harder to maintain or more error-prone, aligning with software defect likelihood.\\ndf[\'complexity_ratio\'] = df[\'v(g)\'] / (df[\'loc\'] + 1e-5)", "# essential_complexity_ratio\\n# Essential complexity as a fraction of total cyclomatic complexity.\\n# Usefulness: Reflects how much of the complexity is fundamental, shedding light on potential areas that are inherently complex and harder to debug.\\ndf[\'essential_complexity_ratio\'] = df[\'ev(g)\'] / (df[\'v(g)\'] + 1e-5)", "# effort_per_volume\\n# Effort required per unit of Halstead volume.\\n# Usefulness: Encapsulates how much effort is needed relative to the size of the code, which can indicate inefficiencies or defects in implementation.\\ndf[\'effort_per_volume\'] = df[\'e\'] / (df[\'v\'] + 1e-5)", "# comment_density\\n# Lines of comments per line of code.\\n# Usefulness: A higher comment density generally improves code readability and maintainability, reducing defect likelihood.\\ndf[\'comment_density\'] = df[\'lOComment\'] / (df[\'loc\'] + 1e-5)", "# blank_density\\n# Blank lines per line of code.\\n# Usefulness: Indicates potential code readability or lack of conciseness; excessive blank lines may signify areas needing cleanup.\\ndf[\'blank_density\'] = df[\'lOBlank\'] / (df[\'loc\'] + 1e-5)", "# log_effort\\n# Logarithm of Halstead effort.\\n# Usefulness: Stabilizes the skewed distribution of effort, ensuring the metric is not dominated by extreme values.\\ndf[\'log_effort\'] = np.log(df[\'e\'] + 1)", "# log_volume\\n# Logarithm of Halstead volume.\\n# Usefulness: Reduces skew in code volume distribution, making the model less sensitive to outliers in large modules.\\ndf[\'log_volume\'] = np.log(df[\'v\'] + 1)", "# log_loc\\n# Logarithm of lines of code.\\n# Usefulness: Normalizes the distribution of lines of code, addressing skewness and enabling the model to generalize better across modules of different sizes.\\ndf[\'log_loc\'] = np.log(df[\'loc\'] + 1)", "# design_vs_code_complexity\\n# Design complexity as a fraction of overall cyclomatic complexity.\\n# Usefulness: Highlights the proportion of a module\'s complexity that is derived from its design rather than its implementation, aiding in defect detection.\\ndf[\'design_vs_code_complexity\'] = df[\'iv(g)\'] / (df[\'v(g)\'] + 1e-5)", "# normalized_operands\\n# Density of total operands relative to unique operands.\\n# Usefulness: Measures how much repetition exists in operand usage, where higher repetition might indicate lower code quality.\\ndf[\'normalized_operands\'] = df[\'total_Opnd\'] / (df[\'uniq_Opnd\'] + 1e-5)", "# intelligence_ratio\\n# Intelligence per Halstead effort.\\n# Usefulness: Provides an indication of how efficiently the effort is being utilized to write intelligent code, relating to maintainability and potential defects.\\ndf[\'intelligence_ratio\'] = df[\'i\'] / (df[\'e\'] + 1e-5)", "# rolling_mean_v\\n# Rolling mean of Halstead volume (window=3).\\n# Usefulness: Helps identify local patterns or trends in code volume that might indicate areas prone to defects.\\ndf[\'rolling_mean_v\'] = df[\'v\'].rolling(window=3, min_periods=1).mean()", "# rolling_mean_e\\n# Rolling mean of Halstead effort (window=3).\\n# Usefulness: Detects local effort spikes, which may indicate areas requiring higher effort and potentially more error-prone.\\ndf[\'rolling_mean_e\'] = df[\'e\'].rolling(window=3, min_periods=1).mean()"]': 0.0023696682464454666}]
