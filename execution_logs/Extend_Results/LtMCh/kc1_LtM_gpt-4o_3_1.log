# cyclomatic_complexity_density
# Cyclomatic complexity density measures decision density normalized by square root of lines of code.
# Usefulness: Captures hotspots where decision points are disproportionately dense relative to code size, aiding defect identification.
df['cyclomatic_complexity_density'] = df['v(g)'] / (df['loc']  0.5 + 1e-5)
end

python
# essential_effort_ratio
# Essential effort per line measures alignment of essential complexity with overall effort.
# Usefulness: Balances workload and fundamental complexity within the code, indicating modules requiring disproportionate mental resources.
df['essential_effort_ratio'] = (df['ev(g)'] * df['e']) / (df['loc'] + 1e-5)
end

python
# scaled_complexity_ratio
# Scaled complexity combines cyclomatic complexity with logarithm-adjusted lines of code.
# Usefulness: Highlights decision density, adjusted for logarithmic growth in code size, linking density and defect hotspots.
df['scaled_complexity_ratio'] = df['v(g)'] / (np.log(df['loc'] + 1) + 1e-5)
end

python
# design_effort_ratio
# Design-to-effort ratio measures complexity derived purely from design decisions relative to effort spent.
# Usefulness: Identifies inefficiency caused by poor design choices requiring extensive developer effort.
df['design_effort_ratio'] = df['iv(g)'] / (df['e'] + 1e-5)
end

python
# essential_to_design_ratio
# Ratio comparing essential versus design-related complexity of the code.
# Usefulness: Pinpoints whether inherent logic or design is the source of complexity, aiding in targeting areas to simplify.
df['essential_to_design_ratio'] = df['ev(g)'] / (df['iv(g)'] + 1e-5)
end

python
# cumulative_design_complexity
# Tracks cumulative design complexity across modules, providing insight on progressively complex design patterns.
# Usefulness: Identifies modules where total design complexity disproportionately contributes to overall project complexity.
df['cumulative_design_complexity'] = df['iv(g)'].cumsum()
end

python
# rolling_design_std
# Rolling standard deviation of design complexity (window=3).
# Usefulness: Highlights spurts in unstable design patterns, which could introduce inconsistent behavior or defects.
df['rolling_design_std'] = df['iv(g)'].rolling(window=3, min_periods=1).std()
end

python
# log_effort_per_line
# Logarithmic effort per line stabilizes variability for effort distributed across modules.
# Usefulness: Mitigates skewed effort distributions, linking normalized effort with defect likelihood.
df['log_effort_per_line'] = np.log((df['e'] / (df['loc'] + 1e-5)) + 1)
end

python
# log_volume_per_line
# Logarithmic Halstead volume per line stabilizes variability in high-volume modules.
# Usefulness: Balances complexity measures across varying size modules, ensuring smaller modules’ impact isn’t overwhelmed.
df['log_volume_per_line'] = np.log((df['v'] / (df['loc'] + 1e-5)) + 1)
end

python
# rolling_mean_complexity
# Rolling mean of cyclomatic complexity (window=3).
# Usefulness: Tracks recent trends in complexity, capturing areas where defects may arise from rapidly increasing logic density.
df['rolling_mean_complexity'] = df['v(g)'].rolling(window=3, min_periods=1).mean()
end

python
# rolling_variance_effort
# Rolling variance of effort (window=3).
# Usefulness: Highlights inconsistent effort requirements, flagging erratic modules prone to defects.
df['rolling_variance_effort'] = df['e'].rolling(window=3, min_periods=1).var()
end

python
# normalized_branch_factor
# Normalized branch factor (branch count per line).
# Usefulness: Marks modules with disproportionately high branching, indicative of potential decision logic overload and risks.
df['normalized_branch_factor'] = df['branchCount'] / (df['loc'] + 1e-5)
end

python
# log_scaled_code_comment_ratio
# Logarithmic scaling of code-to-code and comment ratio.
# Usefulness: Stabilizes distribution and highlights modules with disproportionately low or high code-to-comment ratios.
df['log_scaled_code_comment_ratio'] = np.log(df['loc_to_code_comment_ratio'] + 1)
end

python
# cognitive_effort_to_branch
# Effort per decision branch combines cognitive load with the density of decisions in the module.
# Usefulness: Highlights module inefficiencies caused by high branching requiring extensive effort investment.
df['cognitive_effort_to_branch'] = df['e'] / (df['branchCount'] + 1e-5)
end
