# LOG_COMPACTNESS_RATIO
# Log transformation of COMPACTNESS to emphasize proportional differences and reduce skewness.
# Usefulness: Adds interpretability to compactness variations across vehicle silhouettes.
df['LOG_COMPACTNESS_RATIO'] = np.log(df['COMPACTNESS'])
end

python
# RADIUS_RATIO_SQRT
# Square root transformation of RADIUS_RATIO to compress the range and highlight gradual asymmetries.
# Usefulness: Emphasizes subtle asymmetry patterns critical for classification across viewing angles.
df['RADIUS_RATIO_SQRT'] = np.sqrt(df['RADIUS_RATIO'])
end

python
# HOLLOWS_COMPACTNESS_FACTOR
# Ratio of HOLLOWS_RATIO to COMPACTNESS to assess structural voids relative to compactness.
# Usefulness: Links hollow areas to compactness, aiding in differentiating vehicle types effectively.
df['HOLLOWS_COMPACTNESS_FACTOR'] = df['HOLLOWS_RATIO'] / df['COMPACTNESS']
end

python
# RECTANGULARITY_NORMALIZED
# Difference of RECTANGULARITY_DIFFERENCE divided by MAX.LENGTH_RECTANGULARITY to highlight scaled bounding discrepancies.
# Usefulness: Captures proportional discrepancies in bounding approaches significant for vehicle classification.
df['RECTANGULARITY_NORMALIZED'] = df['RECTANGULARITY_DIFFERENCE'] / df['MAX.LENGTH_RECTANGULARITY']
end

python
# SKEWNESS_LENGTH_RATIO
# Ratio of SKEWNESS_ABOUT_MAJOR_AXIS to MAX.LENGTH_ASPECT_RATIO to analyze symmetry deviations relative to length.
# Usefulness: Highlights symmetry deviations linked to core shape dimensions for differentiation across vehicle classes.
df['SKEWNESS_LENGTH_RATIO'] = df['SKEWNESS_ABOUT_MAJOR_AXIS'] / df['MAX.LENGTH_ASPECT_RATIO']
end

python
# KURTOSIS_SKETCH_PRODUCT
# Product of KURTOSIS_ABOUT_MAJOR_AXIS and MAX.LENGTH_ASPECT_RATIO to emphasize tailedness linked with major proportions.
# Usefulness: Amplifies relationships between distribution tail properties and proportional lengths for better shape differentiation.
df['KURTOSIS_SKETCH_PRODUCT'] = df['KURTOSIS_ABOUT_MAJOR_AXIS'] * df['MAX.LENGTH_ASPECT_RATIO']
end

python
# RADIUS_HOLLOWS_INTERACTION
# Product of RADIUS_RATIO_SQRT and HOLLOWS_RATIO to combine radial asymmetry with structural voids.
# Usefulness: Enhances the analysis of radial and void interaction patterns in vehicle shapes.
df['RADIUS_HOLLOWS_INTERACTION'] = df['RADIUS_RATIO_SQRT'] * df['HOLLOWS_RATIO']
end

python
# ELONGATION_SKETCH_RATIO
# Ratio of ELONGATION_COMPACTNESS_RATIO to SCALED_RADIUS_OF_GYRATION to capture elongation effects normalized by radius proportions.
# Usefulness: Enhances elongation tendencies by measuring impacts of elongation relative to overall shape dispersion.
df['ELONGATION_SKETCH_RATIO'] = df['ELONGATION_COMPACTNESS_RATIO'] / df['SCALED_RADIUS_OF_GYRATION']
end

python
# DROP_SCALED_RADIUS_OF_GYRATION
# Removal of SCALED_RADIUS_OF_GYRATION, a high variance feature redundant with radius-based metrics.
# Usefulness: Ensures focus on features with proportional relevance rather than redundant raw spatial scales.
df.drop(columns=['SCALED_RADIUS_OF_GYRATION'], inplace=True)
end

python
# DROP_KURTOSIS_ABOUT_MAJOR_AXIS
# Removal of KURTOSIS_ABOUT_MAJOR_AXIS due to limited interpretability with skew-independent tailedness effects.
# Usefulness: Simplifies feature set while retaining tailedness properties via interaction terms and higher-order metrics.
df.drop(columns=['KURTOSIS_ABOUT_MAJOR_AXIS'], inplace=True)
end

python
# DROP_HOLLOWS_RATIO
# Removal of HOLLOWS_RATIO due to redundancy with HOLLOWS_COMPACTNESS_FACTOR and other derived features.
# Usefulness: Prevents duplicated information that contributes minimal additional differentiation power for classification.
df.drop(columns=['HOLLOWS_RATIO'], inplace=True)
end
