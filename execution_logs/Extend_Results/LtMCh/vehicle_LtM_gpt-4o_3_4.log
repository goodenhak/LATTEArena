TH_ASPECT_RATIO']", "# RADIUS_HOLLOWS_INTERACTION\n# Product of RADIUS_RATIO_SQRT and HOLLOWS_RATIO to combine radial asymmetry with structural voids.\n# Usefulness: Enhances the analysis of radial and void interaction patterns in vehicle shapes.\ndf['RADIUS_HOLLOWS_INTERACTION'] = df['RADIUS_RATIO_SQRT'] * df['HOLLOWS_RATIO']", "# ELONGATION_SKETCH_RATIO\n# Ratio of ELONGATION_COMPACTNESS_RATIO to SCALED_RADIUS_OF_GYRATION to capture elongation effects normalized by radius proportions.\n# Usefulness: Enhances elongation tendencies by measuring impacts of elongation relative to overall shape dispersion.\ndf['ELONGATION_SKETCH_RATIO'] = df['ELONGATION_COMPACTNESS_RATIO'] / df['SCALED_RADIUS_OF_GYRATION']", "# DROP_SCALED_RADIUS_OF_GYRATION\n# Removal of SCALED_RADIUS_OF_GYRATION, a high variance feature redundant with radius-based metrics.\n# Usefulness: Ensures focus on features with proportional relevance rather than redundant raw spatial scales.\ndf.drop(columns=['SCALED_RADIUS_OF_GYRATION'], inplace=True)", "# DROP_KURTOSIS_ABOUT_MAJOR_AXIS\n# Removal of KURTOSIS_ABOUT_MAJOR_AXIS due to limited interpretability with skew-independent tailedness effects.\n# Usefulness: Simplifies feature set while retaining tailedness properties via interaction terms and higher-order metrics.\ndf.drop(columns=['KURTOSIS_ABOUT_MAJOR_AXIS'], inplace=True)", "# DROP_HOLLOWS_RATIO\n# Removal of HOLLOWS_RATIO due to redundancy with HOLLOWS_COMPACTNESS_FACTOR and other derived features.\n# Usefulness: Prevents duplicated information that contributes minimal additional differentiation power for classification.\ndf.drop(columns=['HOLLOWS_RATIO'], inplace=True)"]
