df['HOLLOWS_RADIUS_RATIO'] = df['HOLLOWS_RATIO'] / df['RADIUS_RATIO']
end

python
# SCATTER_RATIO_ZSCORE
# Z-score normalization of SCATTER_RATIO to standardize scale and highlight deviations in inertia distribution.
# Usefulness: Makes patterns in relative axis inertia comparable across different types while accounting for deviations from mean.
df['SCATTER_RATIO_ZSCORE'] = (df['SCATTER_RATIO'] - df['SCATTER_RATIO'].mean()) / df['SCATTER_RATIO'].std()
end

python
# CIRCULARITY_AXIS_PRODUCT
# Product of PR.AXIS_ASPECT_RATIO and ELONGATEDNESS to emphasize roundness relative to axis dimensions.
# Usefulness: Combines axis proportions with circularity proxy, capturing structural geometry and roundness effectively.
df['CIRCULARITY_AXIS_PRODUCT'] = df['PR.AXIS_ASPECT_RATIO'] * df['ELONGATEDNESS']
end

python
# INERTIA_VARIANCE_PRODUCT
# Product of SCATTER_RATIO and SCALED_VARIANCE_ALONG_MAJOR_AXIS to capture inertia linked to spatial variance.
# Usefulness: Strengthens the relationship between inertia effects and spatial variance, distinguishing vehicle silhouette types effectively.
df['INERTIA_VARIANCE_PRODUCT'] = df['SCATTER_RATIO'] * df['SCALED_VARIANCE_ALONG_MAJOR_AXIS']
end

python
# KURTOSIS_MINOR_ABS
# Absolute value of KURTOSIS_ABOUT_MINOR_AXIS to neutralize polarity and emphasize distribution tail variations.
# Usefulness: Neutralizes extreme tailedness effects, capturing subtle outlier tendencies significant for classification.
df['KURTOSIS_MINOR_ABS'] = np.abs(df['KURTOSIS_ABOUT_MINOR_AXIS'])
end

python
# SKEWNESS_MAJOR_SIGMOID
# Sigmoid transformation of SKEWNESS_ABOUT_MAJOR_AXIS to amplify differences in central symmetry values.
# Usefulness: Enhances sensitivity to skewness patterns that vary moderately across geometric distributions.
df['SKEWNESS_MAJOR_SIGMOID'] = 1 / (1 + np.exp(-df['SKEWNESS_ABOUT_MAJOR_AXIS']))
end

