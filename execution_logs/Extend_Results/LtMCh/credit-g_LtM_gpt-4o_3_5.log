# repayment_burden_ratio
# Measures repayment burden relative to income by dividing credit amount by installment rate as percentage of disposable income.
# Usefulness: Provides insight into whether the applicant can feasibly make payments based on their disposable income.
df['repayment_burden_ratio'] = df['credit_amount'] / df['installment_commitment']
end

python
# duration_bins
# Divides duration into discrete bins using specified cutoff points to categorize repayment terms.
# Usefulness: Helps identify patterns in credit decisions based on repayment duration groups.
df['duration_bins'] = pd.cut(df['duration'], bins=[0, 12, 24, 36, 48, 60], labels=['1yr', '2yr', '3yr', '4yr', '5yr'])
end

python
# savings_to_credit_ratio
# Calculates the ratio of savings status encoding to log-transformed credit amount.
# Usefulness: Reflects the relationship between the applicant's savings and their requested credit amount in a normalized way.
df['savings_to_credit_ratio'] = df['target_encoded_savings_status'] / df['log_credit_amount']
end

python
# duration_log_credit_cross
# Combines duration and log_credit_amount via multiplication to capture interaction between loan duration and normalized loan amount.
# Usefulness: Highlights how loan size and repayment period together influence credit decision-making.
df['duration_log_credit_cross'] = df['duration'] * df['log_credit_amount']
end

python
# repayment_duration_score
# Measures the relative duration to the median using z-score transformation.
# Usefulness: Helps normalize repayment duration and identifies how far each instance lies from the median.
df['repayment_duration_score'] = (df['duration'] - df['duration'].mean()) / df['duration'].std()
end

python
# total_dependents_flag
# Creates a binary indicator if the number of dependents exceeds 1.
# Usefulness: Identifies if the applicant has a higher-than-average number of dependents, impacting repayment ability.
df['total_dependents_flag'] = (df['num_dependents'] > 1).astype(int)
end

python
# job_encoded
# Encodes job categories using label encoding to represent employment stability levels numerically.
# Usefulness: Simplifies categorical data for analysis and captures employment stability.
job_mapping = {'skilled': 2, 'high qualif/self emp/mgmt': 3, 'unemp/unskilled non res': 0, 'unskilled resident': 1}
df['job_encoded'] = df['job'].replace(job_mapping)
end

python
# one_hot_other_parties
# Applies one-hot encoding to other parties involved in the credit application.
# Usefulness: Represents the categorical variables in a binary vector format for compatibility with machine learning models.
df = pd.get_dummies(df, columns=['other_parties'], prefix='other_parties', drop_first=True)
end

python
df.drop(columns=['checking_status', 'savings_status'], inplace=True)
end
