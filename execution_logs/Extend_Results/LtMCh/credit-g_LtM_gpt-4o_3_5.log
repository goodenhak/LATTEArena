# repayment_burden_ratio
# Measures repayment burden relative to income by dividing credit amount by installment rate as percentage of disposable income.
# Usefulness: Indicates the affordability of repayment, capturing the financial burden of the loan relative to income.
df['repayment_burden_ratio'] = df['credit_amount'] / df['installment_commitment']
end

python
# log_credit_amount
# Applies log transformation to credit amount to handle skewness and normalize large credit values.
# Usefulness: Provides a more normalized view of credit amounts, reducing the influence of outliers for predictive models.
df['log_credit_amount'] = df['credit_amount'].apply(lambda x: np.log(x))
end

python
# duration_bins
# Divides duration into discrete bins using specified cutoff points to categorize repayment terms.
# Usefulness: Simplifies repayment duration into categorical bins, facilitating pattern recognition for approval decisions.
df['duration_bins'] = pd.cut(df['duration'], bins=[0, 12, 24, 36, 48, 60], labels=['1yr', '2yr', '3yr', '4yr', '5yr'])
end

python
# target_encoded_credit_history
# Encodes credit_history using target approval rate per category to highlight predictive relationships.
# Usefulness: Reflects repayment reliability and its impact on credit approval likelihood.
credit_history_mean = df.groupby('credit_history')['target'].mean()
df['target_encoded_credit_history'] = df['credit_history'].map(credit_history_mean)
end

python
# target_encoded_savings_status
# Encodes savings_status using target approval rate per category to highlight predictive relationships.
# Usefulness: Reflects the relationship between savings and credit approval, emphasizing financial stability.
savings_status_mean = df.groupby('savings_status')['target'].mean()
df['target_encoded_savings_status'] = df['savings_status'].map(savings_status_mean)
end

python
# checking_credit_history_cross
# Creates an interaction term by combining checking_status and credit_history.
# Usefulness: Captures the combined influence of financial stability and repayment reliability on credit approval likelihood.
df['checking_credit_history_cross'] = df['checking_status'] + '_' + df['credit_history']
end

python
# checking_savings_cross
# Creates an interaction term by combining checking_status and savings_status.
# Usefulness: Captures the combined effect of checking account status and savings levels on credit approval likelihood.
df['checking_savings_cross'] = df['checking_status'] + '_' + df['savings_status']
end

python
# duration_log_credit_cross
# Combines duration and log_credit_amount via multiplication to capture interaction between loan duration and normalized loan amount.
# Usefulness: Highlights how loan size and repayment period together influence credit approval propensity.
df['duration_log_credit_cross'] = df['duration'] * df['log_credit_amount']
end

python
# total_dependents_flag
# Creates a binary indicator for whether the number of dependents exceeds 1.
# Usefulness: Identifies applicants with higher financial dependency burdens, a risk factor for credit repayment.
df['total_dependents_flag'] = (df['num_dependents'] > 1).astype(int)
end

python
# job_encoded
# Encodes job categories using label encoding to represent employment stability numerically.
# Usefulness: Simplifies job data into numerical values to represent applicant stability and employment levels.
job_mapping = {'skilled': 2, 'high qualif/self emp/mgmt': 3, 'unemp/unskilled non res': 0, 'unskilled resident': 1}
df['job_encoded'] = df['job'].replace(job_mapping)
end

python
# Drop unused columns
df.drop(columns=['checking_status', 'savings_status'], inplace=True)
end
