# COMPACTNESS_log
# Log-transform of COMPACTNESS to reduce skewness and highlight small differences.
# Usefulness: Captures variances in compactness between vehicles with large shape irregularities and compact shapes.
df['COMPACTNESS_log'] = np.log(df['COMPACTNESS'])
end

python
# DISTANCE_CIRCULARITY_reciprocal
# Reciprocal transform of DISTANCE_CIRCULARITY to emphasize smaller values linked to compact shapes.
# Usefulness: Highlights differences in silhouettes with tighter boundaries versus those with dispersed outlines.
df['DISTANCE_CIRCULARITY_reciprocal'] = 1 / df['DISTANCE_CIRCULARITY']
end

python
# RADIUS_RATIO_sqrt
# Square root transform of RADIUS_RATIO to compress larger values while preserving relationships.
# Usefulness: Helps differentiate vehicles with extremes in elongatedness or radius variation.
df['RADIUS_RATIO_sqrt'] = np.sqrt(df['RADIUS_RATIO'])
end

python
# SCATTER_RATIO_to_ELONGATEDNESS_ratio
# Ratio of SCATTER_RATIO to ELONGATEDNESS, representing the proportional density distribution to slenderness.
# Usefulness: Provides insights into how mass distribution correlates with shape elongation.
df['SCATTER_RATIO_to_ELONGATEDNESS_ratio'] = df['SCATTER_RATIO'] / df['ELONGATEDNESS']
end

python
# SCALED_VARIANCE_major_to_minor_ratio
# Ratio of SCALED_VARIANCE_ALONG_MAJOR_AXIS to SCALED_VARIANCE_ALONG_MINOR_AXIS, showing dimensional balance.
# Usefulness: Differentiates vehicles based on variance in width relative to height.
df['SCALED_VARIANCE_major_to_minor_ratio'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] / df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# HOLLOWS_RATIO_target_encoded
# Mean HOLLOWS_RATIO values grouped by vehicle type using target encoding.
# Usefulness: Provides encoded insights into hollows as a distinguishing feature across vehicle categories.
hollows_grouped = df.groupby('Answer')['HOLLOWS_RATIO'].mean()
df['HOLLOWS_RATIO_target_encoded'] = df['Answer'].map(hollows_grouped)
end

python
# MAX.LENGTH_ASPECT_RATIO_to_PR.AXIS_ASPECT_RATIO
# Ratio of MAX.LENGTH_ASPECT_RATIO to PR.AXIS_ASPECT_RATIO to assess proportional balance between vehicle length and axis dimensions.
# Usefulness: Highlights shape balance and proportion differences across vehicle classes.
df['MAX.LENGTH_ASPECT_RATIO_to_PR.AXIS_ASPECT_RATIO'] = df['MAX.LENGTH_ASPECT_RATIO'] / df['PR.AXIS_ASPECT_RATIO']
end

python
# VARIANCE_BALANCE_RATIO
# Ratio of SCALED_VARIANCE_ALONG_MAJOR_AXIS to SCALED_VARIANCE_ALONG_MINOR_AXIS, accounting for symmetry across dimensions.
# Usefulness: Differentiates between balanced and asymmetrical vehicle shapes.
df['VARIANCE_BALANCE_RATIO'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] / df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# RADIUS_RATIO_to_COMPACTNESS_ratio
# Ratio of RADIUS_RATIO to COMPACTNESS, to capture combined effects of radial variations and compactness.
# Usefulness: Helps distinguish vehicles based on elongation and overall boundary tightness combined.
df['RADIUS_RATIO_to_COMPACTNESS_ratio'] = df['RADIUS_RATIO'] / df['COMPACTNESS']
end

python
# COMPACTNESS_Radius_Aggregate
# Aggregated mean of COMPACTNESS and RADIUS_RATIO to combine compactness and boundary variation measures.
# Usefulness: Merges boundary tightness and radial variation, increasing clarity of combined silhouette traits.
df['COMPACTNESS_Radius_Aggregate'] = (df['COMPACTNESS'] + df['RADIUS_RATIO']) / 2
end

python
df.drop(columns=['SKEWNESS_ABOUT_MINOR_AXIS'], inplace=True)
end

python
df.drop(columns=['PR.AXIS_RECTANGULARITY'], inplace=True)
end

python
df.drop(columns=['ELONGATEDNESS'], inplace=True)
end
