# COMPACTNESS_log
# Log-transform of COMPACTNESS to reduce skewness and highlight small differences.
# Usefulness: Captures subtle differences in shape compactness that vary across vehicle types.
df['COMPACTNESS_log'] = np.log(df['COMPACTNESS'])
end

python
# DISTANCE_CIRCULARITY_reciprocal
# Reciprocal transform of DISTANCE_CIRCULARITY to emphasize smaller values linked to compact shapes.
# Usefulness: Highlights compact boundaries versus dispersed silhouettes, aiding in vehicle classification.
df['DISTANCE_CIRCULARITY_reciprocal'] = 1 / df['DISTANCE_CIRCULARITY']
end

python
# RADIUS_RATIO_sqrt
# Square root transform of RADIUS_RATIO to compress larger values while preserving proportional differences.
# Usefulness: Differentiates elongated or irregular shapes from more uniform ones.
df['RADIUS_RATIO_sqrt'] = np.sqrt(df['RADIUS_RATIO'])
end

python
# SCATTER_RATIO_to_ELONGATEDNESS_ratio
# Ratio of SCATTER_RATIO to ELONGATEDNESS, describing mass density relative to slenderness.
# Usefulness: Correlates the evenly distributed mass of vehicle silhouettes with their elongation.
df['SCATTER_RATIO_to_ELONGATEDNESS_ratio'] = df['SCATTER_RATIO'] / df['ELONGATEDNESS']
end

python
# SCALED_VARIANCE_major_to_minor_ratio
# Ratio of SCALED_VARIANCE_ALONG_MAJOR_AXIS to SCALED_VARIANCE_ALONG_MINOR_AXIS for dimensional balance.
# Usefulness: Reflects symmetry between the major and minor axes, distinguishing shapes of vehicles.
df['SCALED_VARIANCE_major_to_minor_ratio'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] / df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# HOLLOWS_RATIO_target_encoded
# Mean HOLLOWS_RATIO values grouped by vehicle type using target encoding.
# Usefulness: Encodes hollow proportions specific to vehicle types, helping to differentiate between classes.
hollows_grouped = df.groupby('Answer')['HOLLOWS_RATIO'].mean()
df['HOLLOWS_RATIO_target_encoded'] = df['Answer'].map(hollows_grouped)
end

python
# KURTOSIS_minor_to_major_ratio
# Ratio of KURTOSIS_ABOUT_MINOR_AXIS to KURTOSIS_ABOUT_MAJOR_AXIS, showing higher-order moment balance.
# Usefulness: Highlights the distribution of extreme points around minor versus major axes.
df['KURTOSIS_minor_to_major_ratio'] = df['KURTOSIS_ABOUT_MINOR_AXIS'] / df['KURTOSIS_ABOUT_MAJOR_AXIS']
end

python
df.drop(columns=['SKEWNESS_ABOUT_MINOR_AXIS'], inplace=True)
end

python
df.drop(columns=['PR.AXIS_RECTANGULARITY'], inplace=True)
end

python
df.drop(columns=['ELONGATEDNESS'], inplace=True)
end
