df['risk_liquidity_interaction'] = df['liquidity_index'] * df['delayed_flag']
end

python
# liquidity_income_ratio
# Feature description: Ratio of liquidity_index to installment_commitment as a proxy for financial reserves relative to repayment obligations.
# Usefulness: Highlights the applicant’s capacity to manage repayment obligations based on their financial reserves.
df['liquidity_income_ratio'] = df['liquidity_index'] / (df['installment_commitment'] + 1)
end

python
# purpose_based_risk
# Feature description: Normalizes credit_purpose_risk by dividing it by credit_amount, reflecting proportional risk based on loan size.
# Usefulness: Exposes the relative level of credit risk compared to the monetary size of the loan, facilitating comparisons across applicants.
df['purpose_based_risk'] = df['credit_purpose_risk'] / (df['credit_amount'] + 1)
end

python
# debt_adjusted_liquidity
# Feature description: Ratio of debt_to_income_ratio to liquidity_index, assessing debt burden relative to financial reserves.
# Usefulness: Highlights an applicant's ability to handle debt based on their financial liquidity, helping to evaluate affectable repayment capacity.
df['debt_adjusted_liquidity'] = df['debt_to_income_ratio'] / (df['liquidity_index'] + 1)
end

python
# stability_risk_indicator
# Feature description: Combined flag of residence_duration_flag and delayed_flag to measure compounded risk of residential instability and poor credit history.
# Usefulness: Detects individuals with heightened default probability due to limited residential stability and previous risky credit behavior.
df['stability_risk_indicator'] = df['residence_duration_flag'] + df['delayed_flag']
end

python
# credit_purpose_scaled
# Feature description: Log transformed credit_purpose_risk to handle high variance in feature values and reduce potential bias in model training.
# Usefulness: Improves interpretability, reduces the influence of outliers, and makes risk assessment more manageable when relative risk values are large.
df['credit_purpose_scaled'] = np.log(df['credit_purpose_risk'] + 1)
end

