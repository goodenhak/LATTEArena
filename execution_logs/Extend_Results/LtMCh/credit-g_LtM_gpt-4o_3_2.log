# liquidity_index
# Feature description: Combines checking_status and savings_status by label encoding them and adding together. Higher values indicate better liquidity (more reserves or higher account balance).
# Usefulness: Aggregates financial liquidity indicators into a single metric of financial stability that directly ties to the ability to repay credits.
df['checking_status_encoded'] = df['checking_status'].map({'<0': 1, 'no checking': 0, '0<=X<200': 2, '>=200': 3})
df['savings_status_encoded'] = df['savings_status'].map({'<100': 1, 'no known savings': 0, '100<=X<500': 2, '500<=X<1000': 3, '>=1000': 4})
df['liquidity_index'] = df['checking_status_encoded'] + df['savings_status_encoded']
end

python
# debt_to_income_ratio 
# Feature description: Ratio of loan credit_amount to the product of duration and installment commitment (proxy for income). Larger values indicate higher relative debt burden.
# Usefulness: Captures affordability of the credit relative to income, adjusted by repayment term and rate, directly affecting creditworthiness.
df['debt_to_income_ratio'] = df['credit_amount'] / (df['duration'] * df['installment_commitment'])
end

python
# adjusted_debt_ratio
# Feature description: Interaction feature between debt_to_income_ratio and liquidity_index to assess debt burden relative to financial reserves.
# Usefulness: Highlights interplay between liquidity and debt burden, improving representation of financial stability.
df['adjusted_debt_ratio'] = df['debt_to_income_ratio'] / (df['liquidity_index'] + 1)
end

python
# stability_risk_indicator
# Feature description: Combines residence_duration_flag with delayed_flag to assess compounded risk of instability and poor credit history.
# Usefulness: Highlights individuals with higher default probability due to limited residential stability and risky past behavior.
df['stability_risk_indicator'] = df['residence_duration_flag'] + df['delayed_flag']
end

python
# purpose_based_risk
# Feature description: Normalizes credit_purpose_risk by dividing it with credit_amount to reflect proportional risk of loan purpose.
# Usefulness: Exposes relative risk of credit purpose adjusted for loan size, helping to compare applicants fairly.
df['purpose_based_risk'] = df['credit_purpose_risk'] / (df['credit_amount'] + 1)
end

python
# liquidity_income_ratio
# Feature description: Ratio of liquidity_index to installment_commitment as a proxy for financial reserves relative to repayment obligations.
# Usefulness: Highlights the financial capacity of an individual to manage installment obligations based on liquidity.
df['liquidity_income_ratio'] = df['liquidity_index'] / (df['installment_commitment'] + 1)
end

python
# credit_purpose_scaled
# Feature description: Log-transformed version of credit_purpose_risk to handle high variance in feature values and reduce potential bias in model training.
# Usefulness: Reduces the influence of outliers and improves interpretability for risk assessment when feature values are highly variable.
df['credit_purpose_scaled'] = np.log(df['credit_purpose_risk'] + 1)
end

python
df.drop(columns=['checking_status_encoded', 'savings_status_encoded'], inplace=True)
end
