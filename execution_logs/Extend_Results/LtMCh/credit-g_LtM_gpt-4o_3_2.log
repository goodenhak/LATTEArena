# liquidity_index
# Feature description: Combines checking_status and savings_status by label encoding them and adding together. Higher values indicate better liquidity (more reserves or higher account balance).
# Usefulness: Aggregates financial liquidity indicators into a single metric of financial stability to assess repayment capability.
df['checking_status_encoded'] = df['checking_status'].map({'<0': 1, 'no checking': 0, '0<=X<200': 2, '>=200': 3})
df['savings_status_encoded'] = df['savings_status'].map({'<100': 1, 'no known savings': 0, '100<=X<500': 2, '500<=X<1000': 3, '>=1000': 4})
df['liquidity_index'] = df['checking_status_encoded'] + df['savings_status_encoded']
end

python
# debt_to_income_ratio
# Feature description: Ratio of loan credit_amount to the product of duration and installment_commitment (proxy for income). Larger values indicate higher relative debt burden.
# Usefulness: Reflects affordability of the credit relative to income and repayment period, providing insight into financial stress.
df['debt_to_income_ratio'] = df['credit_amount'] / (df['duration'] * df['installment_commitment'])
end

python
# delayed_flag
# Feature description: Binary flag where credit_history is delayed previously, indicating risky past behavior.
# Usefulness: Encodes past defaults or delays in credit servicing, directly reflecting credit reliability.
df['delayed_flag'] = (df['credit_history'] == 'delayed previously').astype(int)
end

python
# residence_duration_flag
# Feature description: Binary flag for individuals with residence_since below the mean value of 2.8. Low residence duration can indicate instability.
# Usefulness: Highlights individuals with lower residential stability, which correlates to financial reliability.
df['residence_duration_flag'] = (df['residence_since'] < 3).astype(int)
end

python
# risk_liquidity_interaction
# Feature description: Interaction term between liquidity_index and delayed_flag to assess combined risk of poor liquidity and risky credit history.
# Usefulness: Identifies applicants with weak liquidity and a history of delayed payments, indicating compounded financial risk.
df['risk_liquidity_interaction'] = df['liquidity_index'] * df['delayed_flag']
end

python
# credit_purpose_risk
# Feature description: Label encode purpose and compute interaction with credit_amount to create a risk-adjusted loan purpose feature.
# Usefulness: Captures embedded risk of credit purpose based on the monetary size, allowing purpose-specific risk assessment.
df['purpose_encoded'] = df['purpose'].map({'radio/tv': 1, 'new car': 2, 'used car': 3, 'education': 4, 'business': 5, 'furniture/equipment': 6, 'other': 7, 'repairs': 8, 'domestic appliance': 9, 'retraining': 10})
df['credit_purpose_risk'] = df['credit_amount'] * df['purpose_encoded']
end

python
# credit_purpose_scaled
# Feature description: Log-transformed credit_purpose_risk to handle high variance in feature values and reduce potential bias in model training.
# Usefulness: Reduces the influence of outliers, improves interpretability, and balances large variations in risk values.
df['credit_purpose_scaled'] = np.log(df['credit_purpose_risk'] + 1)
end

python
# liquidity_income_ratio
# Feature description: Ratio of liquidity_index to installment_commitment as a proxy for financial reserves relative to repayment obligation.
# Usefulness: Highlights individual capacity to manage repayment obligations based on financial liquidity, indicating financial resilience.
df['liquidity_income_ratio'] = df['liquidity_index'] / (df['installment_commitment'] + 1)
end

python
df.drop(columns=['checking_status_encoded', 'savings_status_encoded', 'purpose_encoded'], inplace=True)
end
