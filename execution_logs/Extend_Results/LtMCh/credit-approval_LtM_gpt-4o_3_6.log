# Usefulness: Reveals systemic trends in default behavior across different ethnic groups, providing additional context for credit risk factors.
df['Ethnicity_default_rate'] = df.groupby('Ethnicity')['PriorDefault'].transform('mean')
end

python
# Industry_mean_income
# Aggregation of mean Income for each Industry.
# Usefulness: Benchmarks individual income against job sector averages, enriching creditworthiness considerations with industry context.
df['Industry_mean_income'] = df.groupby('Industry')['Income'].transform('mean')
end

python
# Low_income_indicator
# Binary indicator for individuals earning below the first quartile (Q1) of Income.
# Usefulness: Flags financially vulnerable individuals likely to struggle with credit obligations.
df['Low_income_indicator'] = (df['Income'] < df['Income'].quantile(0.25)).astype(int)
end

python
# High_debt_indicator
# Binary indicator for individuals with Debt exceeding the third quartile (Q3).
# Usefulness: Identifies individuals under high financial stress due to excessive debt, which may indicate risk potential.
df['High_debt_indicator'] = (df['Debt'] > df['Debt'].quantile(0.75)).astype(int)
end

python
# No_employment_history
# Binary indicator for individuals with zero years of employment history.
# Usefulness: Highlights individuals without job history, signaling potential long-term credit risk.
df['No_employment_history'] = (df['YearsEmployed'] == 0).astype(int)
end

python
df.drop(columns=['DriversLicense'], inplace=True)
end

python
df.drop(columns=['ZipCode'], inplace=True)
end
