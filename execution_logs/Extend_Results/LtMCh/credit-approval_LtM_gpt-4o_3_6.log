# Debt_to_income_ratio
# Ratio of Debt to (Income + 1), measuring financial burden relative to income capacity.
# Usefulness: Indicates how much of an individual’s income is allocated to servicing debt, a key determinant of financial stability.
df['Debt_to_income_ratio'] = df['Debt'] / (df['Income'] + 1)
end

python
# Income_log
# Log transformation of Income to reduce skewness and emphasize relative income differences.
# Usefulness: Highlights differences in financial capacity while mitigating the effects of extreme outliers, which aids in better creditworthiness assessment.
df['Income_log'] = np.log1p(df['Income'])
end

python
# CreditScore_to_income_ratio
# Ratio of CreditScore to (Income + 1), assessing how creditworthiness aligns with financial capacity.
# Usefulness: Highlights credit behavior in relation to financial capacity, helping identify more responsible borrowers.
df['CreditScore_to_income_ratio'] = df['CreditScore'] / (df['Income'] + 1)
end

python
# Low_income_indicator
# Binary indicator for individuals earning below the first quartile (Q1) of Income.
# Usefulness: Flags financially vulnerable individuals likely to face challenges in managing credit obligations.
df['Low_income_indicator'] = (df['Income'] < df['Income'].quantile(0.25)).astype(int)
end

python
# High_debt_indicator
# Binary indicator for individuals with Debt exceeding the third quartile (Q3).
# Usefulness: Identifies individuals under high financial stress due to excessive debt, signaling potential risk.
df['High_debt_indicator'] = (df['Debt'] > df['Debt'].quantile(0.75)).astype(int)
end

python
# YearsEmployed_to_age_ratio
# Ratio of YearsEmployed to (Age + 1), standardizing employment stability by life stage.
# Usefulness: Captures workforce reliability relative to an individual’s life stage, providing a normalized measure of employment stability.
df['YearsEmployed_to_age_ratio'] = df['YearsEmployed'] / (df['Age'] + 1)
end

python
# BankCustomer_and_employment_cross
# Interaction feature combining BankCustomer and Employed attributes.
# Usefulness: Evaluates the interplay between access to banking facilities and employment on financial stability and capacity.
df['BankCustomer_and_employment_cross'] = df['BankCustomer'] * df['Employed']
end

python
# CreditScore_to_age_ratio
# Ratio of CreditScore to (Age + 1), normalizing creditworthiness progression over life stage.
# Usefulness: Reflects responsible credit behavior relative to age, suggesting long-term financial reliability.
df['CreditScore_to_age_ratio'] = df['CreditScore'] / (df['Age'] + 1)
end

python
# Ethnicity_default_rate
# Aggregation of mean PriorDefault rate for each Ethnicity.
# Usefulness: Reveals systemic trends in default behavior among different ethnic groups, providing crucial context for credit risk evaluation.
df['Ethnicity_default_rate'] = df.groupby('Ethnicity')['PriorDefault'].transform('mean')
end

python
# Industry_mean_income
# Aggregation of mean Income for each Industry.
# Usefulness: Benchmarks an individual’s income against job sector averages for contextualizing financial standing.
df['Industry_mean_income'] = df.groupby('Industry')['Income'].transform('mean')
end

python
# Age_and_marriage_cross
# Interaction feature combining Age with Married status.
# Usefulness: Examines how both age and marital status together influence financial reliability and credit behavior.
df['Age_and_marriage_cross'] = df['Age'] * df['Married']
end

python
# No_employment_history
# Binary indicator for individuals with zero years of employment history.
# Usefulness: Highlights individuals without job history, which may indicate long-term credit risk.
df['No_employment_history'] = (df['YearsEmployed'] == 0).astype(int)
end

python
df.drop(columns=['DriversLicense'], inplace=True)
end

python
df.drop(columns=['ZipCode'], inplace=True)
end
