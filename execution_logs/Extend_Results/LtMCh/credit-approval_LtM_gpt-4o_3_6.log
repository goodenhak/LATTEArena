# Debt_to_income_ratio
# Ratio of Debt to (Income + 1), measuring financial burden relative to income capacity.
# Usefulness: Indicates how much of an individual’s income is allocated to servicing debt, a critical factor in financial stability.
df['Debt_to_income_ratio'] = df['Debt'] / (df['Income'] + 1)
end

python
# CreditScore_to_age_ratio
# Ratio of CreditScore to (Age + 1), normalizing creditworthiness progression over life stage.
# Usefulness: Reflects responsible credit behavior relative to age, suggesting long-term financial reliability.
df['CreditScore_to_age_ratio'] = df['CreditScore'] / (df['Age'] + 1)
end

python
# YearsEmployed_to_age_ratio
# Ratio of YearsEmployed to (Age + 1), standardizing employment stability by life stage.
# Usefulness: Captures workforce reliability relative to an individual’s life stage, improving creditworthiness evaluation.
df['YearsEmployed_to_age_ratio'] = df['YearsEmployed'] / (df['Age'] + 1)
end

python
# Income_log
# Log transformation of Income, reducing skewness and emphasizing relative income differences.
# Usefulness: Highlights differences in financial capacity while mitigating the effects of outliers, relevant for assessing creditworthiness.
df['Income_log'] = np.log1p(df['Income'])
end

python
# Married_and_income_cross
# Interaction feature combining Married and Income attributes.
# Usefulness: Investigates the combined effect of marital status and income on financial reliability and credit behavior.
df['Married_and_income_cross'] = df['Married'] * df['Income']
end

python
# BankCustomer_and_employment_cross
# Interaction feature combining BankCustomer and Employed attributes.
# Usefulness: Evaluates the interplay between banking access and employment on financial stability and capacity.
df['BankCustomer_and_employment_cross'] = df['BankCustomer'] * df['Employed']
end

python
# Age_and_marriage_cross
# Interaction feature combining Age with Married status.
# Usefulness: Analyzes how both age and marital stability together influence financial patterns and credit behavior.
df['Age_and_marriage_cross'] = df['Age'] * df['Married']
end

python
# Industry_mean_income
# Aggregation of mean Income for each Industry.
# Usefulness: Benchmarks individual income against job sector averages, enriching creditworthiness considerations with industry context.
df['Industry_mean_income'] = df.groupby('Industry')['Income'].transform('mean')
end

python
# Ethnicity_default_rate
# Aggregation of mean PriorDefault rate for each Ethnicity.
# Usefulness: Reveals systemic trends in default behavior across different ethnic groups, providing additional context for credit risk factors.
df['Ethnicity_default_rate'] = df.groupby('Ethnicity')['PriorDefault'].transform('mean')
end

python
# Low_income_indicator
# Binary indicator for individuals earning below the first quartile (Q1) of Income.
# Usefulness: Flags financially vulnerable individuals likely to struggle with credit obligations, enhancing risk stratification.
df['Low_income_indicator'] = (df['Income'] < df['Income'].quantile(0.25)).astype(int)
end

python
# High_debt_indicator
# Binary indicator for individuals with Debt exceeding the third quartile (Q3).
# Usefulness: Identifies individuals under high financial stress due to excessive debt, which may indicate risk potential.
df['High_debt_indicator'] = (df['Debt'] > df['Debt'].quantile(0.75)).astype(int)
end

python
# No_employment_history
# Binary indicator for individuals with zero years of employment history.
# Usefulness: Highlights individuals without job history, signaling potential long-term credit risk.
df['No_employment_history'] = (df['YearsEmployed'] == 0).astype(int)
end

python
df.drop(columns=['DriversLicense'], inplace=True)
end

python
df.drop(columns=['ZipCode'], inplace=True)
end
