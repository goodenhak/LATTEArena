# Debt_to_income_ratio
# Ratio of Debt to (Income + 1) to measure financial burden relative to income capacity.
# Usefulness: Indicates how much of an individual's income is used to service debt, a critical factor in creditworthiness.
df['Debt_to_income_ratio'] = df['Debt'] / (df['Income'] + 1)
end

python
# CreditScore_to_income_ratio
# Ratio of CreditScore to Income to assess how creditworthiness aligns with financial capacity.
# Usefulness: Highlights credit behavior in relation to financial capacity, useful for identifying responsible borrowers.
df['CreditScore_to_income_ratio'] = df['CreditScore'] / (df['Income'] + 1)
end

python
# High_debt_indicator
# Binary indicator for individuals with Debt > Q3 (top quartile), flagging high-risk individuals.
# Usefulness: Identifies individuals with significantly high debt levels, providing insight into potential financial instability.
df['High_debt_indicator'] = (df['Debt'] > df['Debt'].quantile(0.75)).astype(int)
end

python
# Low_income_indicator
# Binary indicator for individuals earning below the first quartile (Q1) of Income.
# Usefulness: Flags financially vulnerable individuals who may face challenges in managing credit.
df['Low_income_indicator'] = (df['Income'] < df['Income'].quantile(0.25)).astype(int)
end

python
# YearsEmployed_to_age_ratio
# Ratio of YearsEmployed to (Age + 1) to reflect job stability relative to life stage.
# Usefulness: Provides a standardized measure of life-stage-adjusted employment stability, valuable for assessing workforce reliability.
df['YearsEmployed_to_age_ratio'] = df['YearsEmployed'] / (df['Age'] + 1)
end

python
# Ethnicity_default_rate
# Mean of PriorDefault for each Ethnicity (target encoding).
# Usefulness: Captures trends in defaulting behavior based on ethnicity, revealing systemic credit risk factors.
df['Ethnicity_default_rate'] = df.groupby('Ethnicity')['PriorDefault'].transform('mean')
end

python
# Industry_mean_income
# Mean Income aggregated by Industry.
# Usefulness: Provides context for comparing individual incomes within their job sector.
df['Industry_mean_income'] = df.groupby('Industry')['Income'].transform('mean')
end

python
# CreditScore_to_age_ratio
# Ratio of CreditScore to (Age + 1) to capture creditworthiness progression over life stages.
# Usefulness: Reflects responsible credit behavior relative to an individual's age, indicating long-term stability.
df['CreditScore_to_age_ratio'] = df['CreditScore'] / (df['Age'] + 1)
end

python
# Marital_status_and_income_cross
# Interaction feature combining Married and Income.
# Usefulness: Examines how marital status interacts with earning capacity and impacts creditworthiness.
df['Marital_status_and_income_cross'] = df['Married'] * df['Income']
end

python
