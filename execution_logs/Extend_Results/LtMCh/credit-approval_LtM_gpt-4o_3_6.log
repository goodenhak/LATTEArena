# Age_zscore
# Z-Score normalization of Age to standardize the scale across individuals.
# Usefulness: Captures relative life stage variations in a standardized format, improving interpretability of demographic influence.
df['Age_zscore'] = (df['Age'] - df['Age'].mean()) / df['Age'].std()
end

python
# Income_log
# Log transformation of Income to reduce skewness and highlight relative differences in income levels.
# Usefulness: Emphasizes differences in income levels for financial stability while mitigating the impact of extreme outliers.
df['Income_log'] = np.log1p(df['Income'])
end

python
# Debt_to_income_ratio
# The ratio of Debt to (Income + 1) to measure financial burden relative to income.
# Usefulness: Provides insight into the proportion of income used to service debt, a critical factor in creditworthiness.
df['Debt_to_income_ratio'] = df['Debt'] / (df['Income'] + 1)
end

python
# CreditScore_to_age_ratio
# The ratio of CreditScore to (Age + 1) to capture creditworthiness progression over life stages.
# Usefulness: Indicates how well an individual's credit score aligns with their age, signaling responsible credit behavior over time.
df['CreditScore_to_age_ratio'] = df['CreditScore'] / (df['Age'] + 1)
end

python
# YearsEmployed_to_age_ratio
# The ratio of YearsEmployed to (Age + 1) to reflect the job stability relative to life stage.
# Usefulness: Demonstrates how much of an individual's life has been spent working, helping to capture workforce stability.
df['YearsEmployed_to_age_ratio'] = df['YearsEmployed'] / (df['Age'] + 1)
end

python
# Industry_mean_income
# The mean Income for each Industry (group-based aggregation).
# Usefulness: Benchmarks an individual's income against their industry peers, providing context for financial comparisons.
df['Industry_mean_income'] = df.groupby('Industry')['Income'].transform('mean')
end

python
# Ethnicity_default_rate
# The mean of PriorDefault for each Ethnicity (target encoding).
# Usefulness: Highlights ethnicity-related trends in defaulting behavior, providing additional context for credit risk factors.
df['Ethnicity_default_rate'] = df.groupby('Ethnicity')['PriorDefault'].transform('mean')
end

python
# ZipCode_median_income
# The median Income for each ZipCode (group-based aggregation).
# Usefulness: Reflects local economic conditions and benchmarks individuals against their regional peers.
df['ZipCode_median_income'] = df.groupby('ZipCode')['Income'].transform('median')
end

python
# Low_income_indicator
# Binary indicator for individuals earning below the first quartile (Q1) of Income.
# Usefulness: Identifies individuals who may face challenges in managing credit due to low income levels.
df['Low_income_indicator'] = (df['Income'] < df['Income'].quantile(0.25)).astype(int)
end

python
# High_debt_indicator
# Binary indicator for individuals with Debt above the third quartile (Q3).
# Usefulness: Flags individuals with exceptionally high debt levels, who may be at higher risk.
df['High_debt_indicator'] = (df['Debt'] > df['Debt'].quantile(0.75)).astype(int)
end

python
# No_employment_history
# Binary indicator for individuals with no employment history (YearsEmployed == 0).
# Usefulness: Highlights individuals without a stable job history, a key factor in assessing long-term credit reliability.
df['No_employment_history'] = (df['YearsEmployed'] == 0).astype(int)
end

python
df.drop(columns=['DriversLicense'], inplace=True)
end

python
df.drop(columns=['ZipCode'], inplace=True)
end
