# effort_per_loc_log
# Log transformation of 'effort_per_loc'
# Usefulness: Reduces the skewness for the effort per LOC metric and highlights variations in the cognitive load of defect-prone modules.
df['effort_per_loc_log'] = np.log1p(df['effort_per_loc'])
end

python
# log_v_per_loc
# Log transformation of 'v_per_loc'
# Usefulness: Treats the skewed distribution of Halstead 'volume' per LOC, enabling models to better capture patterns associated with defect-prone modules.
df['log_v_per_loc'] = np.log1p(df['v_per_loc'])
end

python
# effort_complexity_interaction
# Product of effort_per_loc and complexity_per_branch
# Usefulness: Captures the joint impact of physical line effort and control flow complexity, highlighting their combined effect on defect probability.
df['effort_complexity_interaction'] = df['effort_per_loc'] * df['complexity_per_branch']
end

python
# branch_difficulty_interaction
# Product of branch_density and difficulty_ratio
# Usefulness: Represents the interaction between control flow complexity and cognitive difficulty as a potential source of defects.
df['branch_difficulty_interaction'] = df['branch_density'] * df['difficulty_ratio']
end

python
# code_complexity_ratio
# Ratio of cyclomatic complexity and design complexity to LOC
# Usefulness: Represents the normalized complexity of code and modular design, potential indicator of defect-prone areas.
df['code_complexity_ratio'] = (df['v(g)'] + df['iv(g)']) / (df['loc'] + 1e-10)
end

python
# scaled_effort_to_difficulty
# Z-score normalization of Halstead 'effort_to_difficulty'
# Usefulness: Normalizes the feature for standardized and meaningful comparison across modules.
df['scaled_effort_to_difficulty'] = (df['effort_to_difficulty'] - df['effort_to_difficulty'].mean()) / (df['effort_to_difficulty'].std() + 1e-10)
end

python
# scaled_branch_density
# Z-score normalization of 'branch_density'
# Usefulness: Normalizes branch density to account for modules with different LOC scales for detecting branching complexity.
df['scaled_branch_density'] = (df['branch_density'] - df['branch_density'].mean()) / (df['branch_density'].std() + 1e-10)
end

python
# scaled_code_to_total_ratio
# Min-max normalization of 'code_to_total_lines_ratio'
# Usefulness: Measures the relative amount of non-commentary code versus total lines, enabling models to capture poorly documented or dense modules.
df['scaled_code_to_total_ratio'] = (df['code_to_total_lines_ratio'] - df['code_to_total_lines_ratio'].min()) / (df['code_to_total_lines_ratio'].max() - df['code_to_total_lines_ratio'].min())
end

python
# scaled_difficulty_ratio
# Z-score normalization of 'difficulty_ratio'
# Usefulness: Standardizes the difficulty ratio for identifying challenging-to-comprehend modules.
df['scaled_difficulty_ratio'] = (df['difficulty_ratio'] - df['difficulty_ratio'].mean()) / (df['difficulty_ratio'].std() + 1e-10)
end

python
df.drop(columns=['iv(g)'], inplace=True)
end

python
df.drop(columns=['lOCode'], inplace=True)
end
