# log_effort_per_loc
# Log transformation of effort_per_loc
# Usefulness: Reduces skewness in the effort per LOC metric and emphasizes significant variations in cognitive load for defect-prone modules.
df['log_effort_per_loc'] = np.log1p(df['effort_per_loc'])
end

python
# log_v_per_loc
# Log transformation of v_per_loc
# Usefulness: Handles skewness in Halstead volume per LOC, highlighting patterns in logical density associated with defects.
df['log_v_per_loc'] = np.log1p(df['v_per_loc'])
end

python
# scaled_branch_density
# Z-score normalization of branch_density
# Usefulness: Standardizes branch density to highlight deviations in control flow complexity across modules of different sizes.
df['scaled_branch_density'] = (df['branch_density'] - df['branch_density'].mean()) / (df['branch_density'].std() + 1e-10)
end

python
# scaled_difficulty_ratio
# Z-score normalization of difficulty_ratio
# Usefulness: Normalizes difficulty_ratio, enabling models to detect modules that are cognitively challenging and error-prone.
df['scaled_difficulty_ratio'] = (df['difficulty_ratio'] - df['difficulty_ratio'].mean()) / (df['difficulty_ratio'].std() + 1e-10)
end

python
# scaled_effort_to_difficulty
# Z-score normalization of Halstead effort_to_difficulty
# Usefulness: Standardizes the comparison of cognitive workload to code complexity across modules, highlighting areas requiring excessive effort.
df['scaled_effort_to_difficulty'] = (df['effort_to_difficulty'] - df['effort_to_difficulty'].mean()) / (df['effort_to_difficulty'].std() + 1e-10)
end

python
# scaled_code_to_total_lines_ratio
# Min-max normalization of code_to_total_lines_ratio
# Usefulness: Captures the relative amount of non-commentary code per total lines, highlighting documentation quality and its impact on defects.
df['scaled_code_to_total_lines_ratio'] = (df['code_to_total_lines_ratio'] - df['code_to_total_lines_ratio'].min()) / (df['code_to_total_lines_ratio'].max() - df['code_to_total_lines_ratio'].min())
end

python
# effort_complexity_interaction
# Product of effort_per_loc and complexity_per_branch
# Usefulness: Represents combined cognitive effort and structural complexity, highlighting areas prone to defects due to high difficulty.
df['effort_complexity_interaction'] = df['effort_per_loc'] * df['complexity_per_branch']
end

python
# branch_difficulty_interaction
# Product of branch_density and difficulty_ratio
# Usefulness: Captures the interplay of control flow complexity and cognitive difficulty, emphasizing likely defect-prone code segments.
df['branch_difficulty_interaction'] = df['branch_density'] * df['difficulty_ratio']
end

python
# code_complexity_ratio
# Ratio of cyclomatic complexity and design complexity to LOC
# Usefulness: Represents normalized structural complexity relative to module size, highlighting intricate areas with higher defect potential.
df['code_complexity_ratio'] = (df['v(g)'] + df['iv(g)']) / (df['loc'] + 1e-10)
end

