# log_effort_per_loc
# Log transformation of 'effort_per_loc'
# Usefulness: Reduces skewness in effort per LOC, emphasizing variations in cognitive load across modules to detect defect-prone areas.
df['log_effort_per_loc'] = np.log1p(df['effort_per_loc'])
end

python
# log_v_per_loc
# Log transformation of 'v_per_loc'
# Usefulness: Addresses the skewness in 'v_per_loc' to better capture patterns related to logical density and defect-prone modules.
df['log_v_per_loc'] = np.log1p(df['v_per_loc'])
end

python
# scaled_branch_density
# Z-score normalization of 'branch_density'
# Usefulness: Normalizes branch density to detect deviations in control flow complexity for assessing defect probability across modules of different sizes.
df['scaled_branch_density'] = (df['branch_density'] - df['branch_density'].mean()) / (df['branch_density'].std() + 1e-10)
end

python
# scaled_code_to_total_lines_ratio
# Min-max normalization of 'code_to_total_lines_ratio'
# Usefulness: Highlights the proportion of non-commentary code, enabling better understanding of documentation quality's impact on defects.
df['scaled_code_to_total_lines_ratio'] = (df['code_to_total_lines_ratio'] - df['code_to_total_lines_ratio'].min()) / (df['code_to_total_lines_ratio'].max() - df['code_to_total_lines_ratio'].min())
end

python
# code_complexity_ratio
# Ratio of cyclomatic complexity and design complexity to LOC
# Usefulness: Represents the normalized complexity of code and modular design relative to size, a potential indicator of defect-prone areas.
df['code_complexity_ratio'] = (df['v(g)'] + df['iv(g)']) / (df['loc'] + 1e-10)
end

python
# effort_complexity_interaction
# Product of 'effort_per_loc' and 'complexity_per_branch'
# Usefulness: Captures the combined effect of physical effort and control flow complexity, useful for detecting code segments with increased defect propensity.
df['effort_complexity_interaction'] = df['effort_per_loc'] * df['complexity_per_branch']
end

python
# branch_difficulty_interaction
# Product of 'branch_density' and 'difficulty_ratio'
# Usefulness: Represents the interaction between cognitive difficulty and branching density, helpful in identifying overly complex defect-prone systems.
df['branch_difficulty_interaction'] = df['branch_density'] * df['difficulty_ratio']
end

python
