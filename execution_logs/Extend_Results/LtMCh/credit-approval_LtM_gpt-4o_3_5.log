# Debt_to_Income_Ratio
# Ratio of Debt to Income to evaluate repayment capacity.
# Usefulness: Provides insight into financial stability and repayment ability, which are linked to credit card approval.

def Debt_to_Income_Ratio(row):
    return row['Debt'] / (row['Income'] + 1)  # Adding 1 to avoid division by zero
df['Debt_to_Income_Ratio'] = df.apply(Debt_to_Income_Ratio, axis=1)
end

python
# Log_Income
# Log transformation of Income to reduce skewness and capture diminishing returns on impact of higher income.
# Usefulness: Helps normalize skewed income distribution, highlighting differences in applicant financial capacity more accurately.

df['Log_Income'] = np.log(df['Income'] + 1)  # Adding 1 to avoid log(0)
end

python
# Log_Debt
# Log transformation of Debt to reduce skewness.
# Usefulness: Normalizes debt distribution, enabling better evaluation of risk.

df['Log_Debt'] = np.log(df['Debt'] + 1)  # Adding 1 to avoid log(0)
end

python
# Zscore_CreditScore
# Standardized CreditScore to focus on relative risk positions.
# Usefulness: Captures applicant behavior trends while reducing the impact of outliers.

df['Zscore_CreditScore'] = (df['CreditScore'] - df['CreditScore'].mean()) / df['CreditScore'].std()
end

python
# Age_Bins
# Categorized Age groups: young (<25), mid-age (25-50), senior (>50).
# Usefulness: Explains credit card approval by stratifying applicant stability and maturity by age groups.

df['Age_Bins'] = pd.cut(df['Age'], bins=[15, 25, 50, 77], labels=['Young', 'Mid-Age', 'Senior'])
end

python
# Debt_to_YearsEmployed
# Ratio of Debt to YearsEmployed to evaluate if employment supports repayment.
# Usefulness: Links financial obligation to employment stability, representing risk alignment.

def Debt_to_YearsEmployed(row):
    return row['Debt'] / (row['YearsEmployed'] + 0.1)  # Adding 0.1 to avoid division by zero
df['Debt_to_YearsEmployed'] = df.apply(Debt_to_YearsEmployed, axis=1)
end

python
# Cross_Married_YearsEmployed
# Interaction between Married and YearsEmployed.
# Usefulness: Highlights the role of stability in married applicants for credit card approval.

df['Cross_Married_YearsEmployed'] = df['Married'] * df['YearsEmployed']
end

python
# TargetEncoding_Industry
# Encodes Industry using average approval rates by sector.
# Usefulness: Explains likely approval patterns based on job sectors.

industry_mean = df.groupby('Industry')['CreditCardApproval'].mean()
df['TargetEncoding_Industry'] = df['Industry'].map(industry_mean)
end

python
# TargetEncoding_Ethnicity
# Encodes Ethnicity using average approval rates by ethnicity group.
# Usefulness: Captures socioeconomic influences on credit card approval.

ethnicity_mean = df.groupby('Ethnicity')['CreditCardApproval'].mean()
df['TargetEncoding_Ethnicity'] = df['Ethnicity'].map(ethnicity_mean)
end

python
# TargetEncoding_Citizen
# Encodes Citizenship statuses using approval rates by citizenship types.
# Usefulness: Generates a feature that captures long-term reliability based on applicant citizenship status.

citizen_mean = df.groupby('Citizen')['CreditCardApproval'].mean()
df['TargetEncoding_Citizen'] = df['Citizen'].map(citizen_mean)
end

python
# ZipCode_IncomeMean
# Mean Income per ZipCode.
# Usefulness: Captures regional socioeconomic profiles impacting credit card approval.

zipcode_income_mean = df.groupby('ZipCode')['Income'].mean()
df['ZipCode_IncomeMean'] = df['ZipCode'].map(zipcode_income_mean)
end

python
# ZipCode_CreditScoreStd
# Standard deviation of CreditScore per ZipCode.
# Usefulness: Explains variability of creditworthiness within regional clusters.

zipcode_credit_std = df.groupby('ZipCode')['CreditScore'].std()
df['ZipCode_CreditScoreStd'] = df['ZipCode'].map(zipcode_credit_std)
end

python
df.drop(columns=['ZipCode'], inplace=True)
end

python
df.drop(columns=['DriversLicense'], inplace=True)
end
