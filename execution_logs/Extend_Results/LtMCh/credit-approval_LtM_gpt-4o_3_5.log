# Debt_to_Log_Income_Ratio
# Ratio of Debt to Log-transformed Income to further handle skewness and highlight repayment capacity.
# Usefulness: Combines financial obligations and income in a way that attenuates the impact of skewed income distribution while capturing repayment ability.
df['Debt_to_Log_Income_Ratio'] = df['Debt'] / (np.log(df['Income'] + 1) + 1)
end

python
# Normalized_Debt
# Z-score transformation of Debt to evaluate relative financial obligations.
# Usefulness: Centers and scales debt values to standardize across the population, highlighting applicants with unusually high or low financial obligations.
df['Normalized_Debt'] = (df['Debt'] - df['Debt'].mean()) / df['Debt'].std()
end

python
# Income_Employed_Interaction
# Interaction feature between Employment status and Income.
# Usefulness: Captures the income disparity between employed and unemployed applicants, which correlates to repayment capacity.
df['Income_Employed_Interaction'] = df['Employed'] * np.log(df['Income'] + 1)
end

python
# AgeBin_YearsEmployed
# Interaction between age bins and years employed to capture stability across age groups.
# Usefulness: Explains how age-specific employment trends relate to credit card approval likelihood, emphasizing stability in each age group.
df['AgeBin_YearsEmployed'] = df['Age_Bins'].cat.codes * df['Cross_Married_YearsEmployed']
end

python
# Gender_Income_Interaction
# Interaction between Gender and Income to capture potential gender-specific financial patterns.
# Usefulness: Highlights income disparities and repayment tendencies specific to gender, reflecting societal and economic trends.
df['Gender_Income_Interaction'] = df['Gender'] * np.log(df['Income'] + 1)
end

python
# Citizen_Mean_Income
# Mean Income per Citizenship type to capture socioeconomic trends.
# Usefulness: Identifies patterns of financial capacity linked to citizenship status, potentially revealing long-term reliability.
df['Citizen_Mean_Income'] = df.groupby('Citizen')['Income'].transform('mean')
end

python
# Citizen_Median_Debt
# Median Debt per Citizenship type to capture socioeconomic trends.
# Usefulness: Reflects the typical financial obligations for applicants of different citizenship statuses, aiding risk assessment.
df['Citizen_Median_Debt'] = df.groupby('Citizen')['Debt'].transform('median')
end

python
# Industry_Target_Encoding
# Target encoding for Industry to capture sector-specific approval rates.
# Usefulness: Leverages historical data to explain approval likelihoods for applicants working in different job sectors.
industry_mean = df.groupby('Industry')['Answer'].mean()
df['Industry_Target_Encoding'] = df['Industry'].map(industry_mean)
end

python
# AgeBin_Target_Encoding
# Target encoding for Age_Bins to relate maturity levels to approval rates.
# Usefulness: Correlates age-specific maturity with the likelihood of approval, making distinctions between young, mid-age, and senior applicants.
agebin_mean = df.groupby('Age_Bins')['Answer'].mean()
df['AgeBin_Target_Encoding'] = df['Age_Bins'].map(agebin_mean)
end

