2026-05-25 03:11:56,643 - INFO - ops_string = ["# Log_Transformed_Debt\n# Logarithmic transformation applied to Debt (log(1 + Debt)).\n# Usefulness: Reduces skewness of the Debt distribution, making it amenable to linear modeling.\ndf['Log_Transformed_Debt'] = np.log1p(df['Debt'])", "# Log_Transformed_Income\n# Logarithmic transformation applied to Income (log(1 + Income)).\n# Usefulness: Reduces skewness in income data, capturing its diminishing returns as the value increases.\ndf['Log_Transformed_Income'] = np.log1p(df['Income'])", "# Log_Transformed_CreditScore\n# Logarithmic transformation applied to CreditScore (log(1 + CreditScore)).\n# Usefulness: Controls for skewness in credit score distribution, making patterns clearer for modeling.\ndf['Log_Transformed_CreditScore'] = np.log1p(df['CreditScore'])", "# ZScore_Debt\n# Z-score transformation applied to Debt.\n# Usefulness: Normalizes Debt for interpretability and comparative analysis.\ndf['ZScore_Debt'] = (df['Debt'] - df['Debt'].mean()) / df['Debt'].std()", "# Debt_to_Income_Ratio\n# Debt divided by (Income + 1), representing financial stability relative to earnings.\n# Usefulness: Captures how debt burden impacts earning capacity.\ndf['Debt_to_Income_Ratio'] = df['Debt'] / (df['Income'] + 1)", "# CreditScore_to_Debt_Ratio\n# CreditScore divided by (Debt + 1), representing financial leverage.\n# Usefulness: Reflects balance between creditworthiness and financial obligations.\ndf['CreditScore_to_Debt_Ratio'] = df['CreditScore'] / (df['Debt'] + 1)", "# Employed_Income_Interaction\n# Interaction term as Employed * Income.\n# Usefulness: Captures increasing financial reliability from being employed and earning income.\ndf['Employed_Income_Interaction'] = df['Employed'] * df['Income']", "# Married_Log_Debt_Interaction\n# Interaction term as Married * Log_Transformed_Debt.\n# Usefulness: Highlights how marital status interacts with financial obligations.\ndf['Married_Log_Debt_Interaction'] = df['Married'] * df['Log_Transformed_Debt']", "# YearsEmployed_CreditScore_Interaction\n# Interaction term as YearsEmployed_Sqrt * CreditScore.\n# Usefulness: Captures how employment duration amplifies creditworthiness.\ndf['YearsEmployed_CreditScore_Interaction'] = df['YearsEmployed_Sqrt'] * df['CreditScore']", "# Industry_LogDebt_Mean\n# Group-wise mean of Log_Transformed_Debt by Industry.\n# Usefulness: Encodes average industry-level financial obligations.\ndf['Industry_LogDebt_Mean'] = df.groupby('Industry')['Log_Transformed_Debt'].transform('mean')", "# Ethnicity_CumMean_Success\n# Cumulative success rate by Ethnicity.\n# Usefulness: Provides a running average of credit card success rates for each ethnicity.\ndf['Ethnicity_CumMean_Success'] = df.groupby('Ethnicity')['Success'].cumsum() / (df.groupby('Ethnicity').cumcount() + 1)", "df.drop(columns=['ZipCode'], inplace=True)", "df.drop(columns=['DriversLicense'], inplace=True)", "df.drop(columns=['Gender'], inplace=True)"]
