ication success.\\ndf[\'TargetEncoded_Citizen\'] = df[\'Citizen\'].map(df.groupby(\'Citizen\')[\'Success\'].mean())", "df.drop(columns=[\'ZipCode\'], inplace=True)", "df.drop(columns=[\'DriversLicense\'], inplace=True)", "df.drop(columns=[\'Gender\'], inplace=True)"]': 0.0}, {'["# Final Feature Engineering\\n\\n# Reusing Relevant Existing Features\\n#------------------------------------------------------------------------------\\n\\n# PriorDefault\\n# Indicates prior default history, a strong predictor of creditworthiness.\\n# Usefulness: Captures prior credit risk (binary, 0/1).\\ndf[\'PriorDefault\'] = df[\'PriorDefault\']\\n\\n# Debt\\n# The current outstanding debt of the individual.\\n# Usefulness: Indicates financial obligations, crucial for assessing stability.\\ndf[\'Debt\'] = df[\'Debt\']\\n\\n# Log_Transformed_Debt\\n# Logarithmic transformation applied to Debt (log(1 + Debt)).\\n# Usefulness: Reduces skewness in the Debt distribution for better modeling.\\ndf[\'Log_Transformed_Debt\'] = np.log1p(df[\'Debt\'])\\n\\n# CreditScore_to_Income_Ratio\\n# CreditScore divided by (Income + 1), indicating creditworthiness relative to earning capacity.\\n# Usefulness: Reflects the relationship between income and credit assessment.\\ndf[\'CreditScore_to_Income_Ratio\'] = df[\'CreditScore\'] / (df[\'Income\'] + 1)\\n\\n# BankCustomer_CreditScore_Interaction\\n# Interaction term as BankCustomer * CreditScore.\\n# Usefulness: Represents how having a bank account influences creditworthiness.\\ndf[\'BankCustomer_CreditScore_Interaction\'] = df[\'BankCustomer\'] * df[\'CreditScore\']\\n\\n# Employed\\n# Indicates employment status (binary, 0/1).\\n# Usefulness: Flag for current steady income source and financial stability.\\ndf[\'Employed\'] = df[\'Employed\']\\n\\n# YearsEmployed_Sqrt\\n# Square root transformation applied to YearsEmployed.\\n# Usefulness: Diminishes impact of longer employment durations while preserving meaningful data.\\ndf[\'YearsEmployed_Sqrt\'] = np.s