# Debt_to_Income_Ratio
# Debt divided by (Income + 1), representing financial obligations relative to earning capacity.
# Usefulness: A key metric for financial stability, highlighting how debt burden scales with income.
df['Debt_to_Income_Ratio'] = df['Debt'] / (df['Income'] + 1)
end

python
# Log_Transformed_Income
# Logarithmic transformation applied to Income (log(1 + Income)).
# Usefulness: Reduces skewness in income distribution and captures diminishing returns at higher income levels.
df['Log_Transformed_Income'] = np.log1p(df['Income'])
end

python
# Employed_CreditScore_Interaction
# Interaction term as Employed * CreditScore.
# Usefulness: Captures how being employed enhances the effect of creditworthiness.
df['Employed_CreditScore_Interaction'] = df['Employed'] * df['CreditScore']
end

python
# Married_Income_Interaction
# Interaction term as Married * Income.
# Usefulness: Reflects how marital status and income together affect financial stability.
df['Married_Income_Interaction'] = df['Married'] * df['Income']
end

python
# Log_Transformed_CreditScore
# Logarithmic transformation applied to CreditScore (log(1 + CreditScore)).
# Usefulness: Controls for skewness in credit score data and improves interpretability.
df['Log_Transformed_CreditScore'] = np.log1p(df['CreditScore'])
end

python
# Age_at_Career_Start
# Derived as Age - YearsEmployed, representing the estimated age when the person started working.
# Usefulness: Provides insights into stability and career progression.
df['Age_at_Career_Start'] = df['Age'] - df['YearsEmployed']
end

python
# TargetEncoded_Industry
# Target encoding applied to Industry based on the mean target value for each category.
# Usefulness: Encodes the likelihood of credit card application success while retaining industry-specific patterns.
df['TargetEncoded_Industry'] = df['Industry'].map(df.groupby('Industry')['Success'].mean())
end

python
# TargetEncoded_Citizen
# Target encoding applied to Citizen based on the mean target value for each category.
# Usefulness: Encodes citizenship status relative to historical success likelihood for credit card approvals.
df['TargetEncoded_Citizen'] = df['Citizen'].map(df.groupby('Citizen')['Success'].mean())
end

python
# TargetEncoded_Ethnicity
# Target encoding applied to Ethnicity based on the mean target value for each category.
# Usefulness: Reduces the categorical nature of Ethnicity by encoding it with respect to credit card success rates.
df['TargetEncoded_Ethnicity'] = df['Ethnicity'].map(df.groupby('Ethnicity')['Success'].mean())
end

python
# Log_Transformed_Debt
# Logarithmic transformation applied to Debt (log(1 + Debt)).
# Usefulness: Reduces skewness and normalizes the Debt feature, enhancing linear modeling compatibility.
df['Log_Transformed_Debt'] = np.log1p(df['Debt'])
end

python
# Drop ZipCode
df.drop(columns=['ZipCode'], inplace=True)
end

python
# Drop DriversLicense
df.drop(columns=['DriversLicense'], inplace=True)
end

python
# Drop Gender
df.drop(columns=['Gender'], inplace=True)
end
