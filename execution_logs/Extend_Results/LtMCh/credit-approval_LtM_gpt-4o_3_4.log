# Debt_to_Income_Ratio
# Debt divided by (Income + 1), to represent financial stability in terms of obligations relative to earning capacity.
# Usefulness: Helps capture the person’s debt burden relative to income, which is a predictive indicator of creditworthiness.
df['Debt_to_Income_Ratio'] = df['Debt'] / (df['Income'] + 1)
end

python
# CreditScore_to_Income_Ratio
# CreditScore divided by (Income + 1), to indicate creditworthiness relative to earning capacity.
# Usefulness: Enhances understanding of how income levels relate to existing creditworthiness.
df['CreditScore_to_Income_Ratio'] = df['CreditScore'] / (df['Income'] + 1)
end

python
# Age_at_Career_Start
# Derived as Age - YearsEmployed, representing the estimated age when the person started their career.
# Usefulness: Helpful in understanding stability and career progression.
df['Age_at_Career_Start'] = df['Age'] - df['YearsEmployed']
end

python
# Log_Transformed_Debt
# Logarithmic transformation applied to Debt (log(1 + Debt)).
# Usefulness: Reduces skewness of the Debt distribution, making it amenable to linear modeling.
df['Log_Transformed_Debt'] = np.log1p(df['Debt'])
end

python
# Log_Transformed_Income
# Logarithmic transformation applied to Income (log(1 + Income)).
# Usefulness: Captures diminishing returns of higher income levels and reduces skewness.
df['Log_Transformed_Income'] = np.log1p(df['Income'])
end

python
# Log_Transformed_CreditScore
# Logarithmic transformation applied to CreditScore (log(1 + CreditScore)).
# Usefulness: Normalizes the CreditScore feature to account for a highly skewed distribution.
df['Log_Transformed_CreditScore'] = np.log1p(df['CreditScore'])
end

python
# Married_Income_Interaction
# Interaction term as Married * Income.
# Usefulness: Captures combined influence of marital status and income level, which may affect financial stability.
df['Married_Income_Interaction'] = df['Married'] * df['Income']
end

python
# Employed_CreditScore_Interaction
# Interaction term as Employed * CreditScore.
# Usefulness: Helps capture how employment status enhances the impact of creditworthiness.
df['Employed_CreditScore_Interaction'] = df['Employed'] * df['CreditScore']
end

python
# BankCustomer_CreditScore_Interaction
# Interaction term as BankCustomer * CreditScore.
# Usefulness: Represents how having a bank account influences creditworthiness.
df['BankCustomer_CreditScore_Interaction'] = df['BankCustomer'] * df['CreditScore']
end

python
# YearsEmployed_Sqrt
# Square root transformation applied to YearsEmployed.
# Usefulness: Captures diminishing effects of longer employment duration.
df['YearsEmployed_Sqrt'] = np.sqrt(df['YearsEmployed'])
end

python
# Age_Bin
# Binned feature for Age into categories: [0-20, 20-35, 35-50, 50-65, 65+].
# Usefulness: Simplifies the Age feature into meaningful groups for analysis.
df['Age_Bin'] = pd.cut(df['Age'], bins=[0, 20, 35, 50, 65, float('inf')], labels=['0-20', '20-35', '35-50', '50-65', '65+'])
end

python
# TargetEncoded_Industry
# Target encoding applied to Industry based on the mean target value for each category.
# Usefulness: Encodes Industry with respect to the likelihood of credit card success, preserving relevant information.
df['TargetEncoded_Industry'] = df['Industry'].map(df.groupby('Industry')['Success'].mean())
end

python
# TargetEncoded_Ethnicity
# Target encoding applied to Ethnicity based on the mean target value for each category.
# Usefulness: Encodes Ethnicity with respect to the likelihood of credit card success, reducing its categorical nature.
df['TargetEncoded_Ethnicity'] = df['Ethnicity'].map(df.groupby('Ethnicity')['Success'].mean())
end

python
# TargetEncoded_Citizen
# Target encoding applied to Citizen based on the mean target value for each category.
# Usefulness: Encodes Citizen with respect to the likelihood of credit card success, preserving relevant patterns.
df['TargetEncoded_Citizen'] = df['Citizen'].map(df.groupby('Citizen')['Success'].mean())
end

python
