# complexity_to_token_ratio
# Ratio of total complexity to total tokens ((v(g) + ev(g) + iv(g)) / module_tokens)
# Usefulness: This metric combines all complexity metrics scaled by the token count, highlighting areas with disproportionately high complexity relative to the module's size.
df['complexity_to_token_ratio'] = (df['v(g)'] + df['ev(g)'] + df['iv(g)']) / df['module_tokens'] 
end

python
# volume_to_token_ratio
# Ratio of Halstead volume to total tokens (v / module_tokens)
# Usefulness: This feature captures the density of the program size (volume) relative to tokens, which can highlight highly compressed or dense modules that might be error-prone.
df['volume_to_token_ratio'] = df['v'] / df['module_tokens'] 
end

python
# documentation_density
# Enhanced comment density considering all effective lines (lOComment / (lOCode + lOComment + lOBlank))
# Usefulness: This metric measures the quality of documentation across the module by normalizing the comments over all effective lines, aiding in identifying under-documented modules.
df['documentation_density'] = df['lOComment'] / (df['lOCode'] + df['lOComment'] + df['lOBlank']) 
end

python
# normalized_loc
# Normalized lines of code relative to token count (loc / module_tokens)
# Usefulness: Normalizes lines of code by token count, identifying modules that may have an unusual line-to-token ratio which could indicate defects.
df['normalized_loc'] = df['loc'] / df['module_tokens'] 
end

python
# effort_complexity_interaction
# Interaction between effort per line and normalized total complexity (effort_per_line * normalized_total_complexity)
# Usefulness: This computed feature emphasizes regions where high effort and complexity intersect, which are often potential areas for defects.
df['effort_complexity_interaction'] = df['effort_per_line'] * df['normalized_total_complexity'] 
end

python
# effort_volume_product
# Product of Halstead effort and volume (e * v)
# Usefulness: Captures the interaction between the mental effort needed and the code size, amplifying the impact of these two important attributes for defect prediction.
df['effort_volume_product'] = df['e'] * df['v'] 
end

python
# log_effort
# Log-transformed Halstead effort (log(e))
# Usefulness: Reduces the scale of highly skewed Halstead effort values, facilitating better pattern identification and model performance.
df['log_effort'] = np.log(df['e'].replace(0, np.nan)) 
end

python
# log_difficulty_weighted_effort
# Log-transformed difficulty-weighted effort metric (log(d * e + 1))
# Usefulness: Addresses the skewed distribution of the product of difficulty and effort, highlighting areas of compounding challenges while improving interpretability.
df['log_difficulty_weighted_effort'] = np.log(df['difficulty_weighted_effort'] + 1) 
end

python
# log_operator_operand_ratio
# Logarithm of the operator-to-operand ratio (log(operator_operand_ratio + 1))
# Usefulness: Log-transformed to manage skew, this metric helps identify anomalies in token usage balance, where high ratios might indicate potential issues in code readability or design.
df['log_operator_operand_ratio'] = np.log(df['operator_operand_ratio'] + 1) 
end

python
# complexity_density_with_branching
# Product of branch density and complexity density (branch_density * complexity_density)
# Usefulness: Highlights modules where control flow complexity and decision density intersect, which are likely areas for defects.
df['complexity_density_with_branching'] = df['branch_density'] * df['complexity_density'] 
end

python
# structure_interaction
# Product of lines of code and branch count (loc * branchCount)
# Usefulness: Combines physical size and decision points, emphasizing modules where structural size and branching complexity may contribute to errors.
df['structure_interaction'] = df['loc'] * df['branchCount'] 
end

python
# unused_code_ratio
# Ratio of non-effective code to total lines ((loc - lOCode) / loc)
# Usefulness: Identifies code with a high proportion of non-effective lines (e.g., comments or blank lines), which may signal potential maintenance or readability issues.
df['unused_code_ratio'] = (df['loc'] - df['lOCode']) / df['loc'] 
end

python
# Remove redundant or less relevant features
df.drop(columns=['locCodeAndComment'], inplace=True) 
end
