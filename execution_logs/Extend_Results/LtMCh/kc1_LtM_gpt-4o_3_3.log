[{'["# complexity_density\\n# Ratio of cyclomatic complexity to lines of code (v(g) / loc)\\n# Usefulness: Indicates the density of control flow complexity per line of code, useful to detect defect-prone dense modules.\\ndf[\'complexity_density\'] = df[\'v(g)\'] / df[\'loc\']", "# essential_complexity_density\\n# Ratio of essential complexity to lines of code (ev(g) / loc)\\n# Usefulness: Captures logical complexity per line, identifying difficult-to-maintain areas of code prone to defects.\\ndf[\'essential_complexity_density\'] = df[\'ev(g)\'] / df[\'loc\']", "# branch_density\\n# Ratio of branch count to lines of code (branchCount / loc)\\n# Usefulness: Denotes decision-making density per line of code, linking to potential edge cases prone to errors.\\ndf[\'branch_density\'] = df[\'branchCount\'] / df[\'loc\']", "# effort_per_line\\n# Effort per line of code (e / loc)\\n# Usefulness: Quantifies implementation effort for each line of code, useful for identifying overly demanding or complex sections.\\ndf[\'effort_per_line\'] = df[\'e\'] / df[\'loc\']", "# difficulty_weighted_effort\\n# Product of Halstead difficulty and effort (d × e)\\n# Usefulness: Highlights areas where high difficulty and effort coincide, implying potential for defects due to complexity and workload.\\ndf[\'difficulty_weighted_effort\'] = df[\'d\'] * df[\'e\']", "# operator_operand_ratio\\n# Ratio of total operators to total operands (total_Op / total_Opnd)\\n# Usefulness: Reflects token balance, where disproportionate usage may indicate non-standard or harder-to-read code.\\ndf[\'operator_operand_ratio\'] = df[\'total_Op\'] / df[\'total_Opnd\']", "# normalized_total_complexity\\n# Normalized total complexity ((v(g) + ev(g) + iv(g)) / loc)\\n# Usefulness: Combines all complexity metrics into a single normalized feature for evaluating overall code complexity by line.\\ndf[\'normalized_total_complexity\'] = (df[\'v(g)\'] + df[\'ev(g)\'] + df[\'iv(g)\']) / df[\'loc\']", "# log_volume\\n# Log-transformed Halstead volume (log(v))\\n# Usefulness: Reduces the scale of highly skewed Halstead volume values, making it easier to capture patterns in the data.\\ndf[\'log_volume\'] = np.log(df[\'v\'].replace(0, np.nan))", "# comment_density\\n# Proportion of commented lines to total lines (lOComment / loc)\\n# Usefulness: Higher comment density suggests better documentation, aiding maintainability and potentially reducing defects.\\ndf[\'comment_density\'] = df[\'lOComment\'] / df[\'loc\']", "# volume_per_effective_line\\n# Ratio of Halstead volume to effective lines of code (v / (lOCode + lOComment + lOBlank))\\n# Usefulness: Provides a perspective on how much data is processed per effective line, signaling overly dense or compact code.\\ndf[\'volume_per_effective_line\'] = df[\'v\'] / (df[\'lOCode\'] + df[\'lOComment\'] + df[\'lOBlank\']).replace(0, np.nan)", "# module_tokens\\n# Total tokens in the module (total_Op + total_Opnd)\\n# Usefulness: Reflects the absolute size in terms of token count, relevant since larger modules often correlate with higher defect rates.\\ndf[\'module_tokens\'] = df[\'total_Op\'] + df[\'total_Opnd\']", "# cyclomatic_difficulty\\n# Product of cyclomatic complexity and Halstead difficulty (v(g) × d)\\n# Usefulness: Highlights defect-prone areas by combining control flow complexity with code comprehension difficulty.\\ndf[\'cyclomatic_difficulty\'] = df[\'v(g)\'] * df[\'d\']", "# effective_effort_density\\n# Ratio of Halstead effort to branch count (e / branchCount)\\n# Usefulness: Denotes the effort required per decision point in the code, identifying resource-expensive and complex decision areas.\\ndf[\'effective_effort_density\'] = df[\'e\'] / df[\'branchCount\']", "# Remove redundant or less relevant features\\ndf.drop(columns=[\'locCodeAndComment\'], inplace=True)"]': 0.0023696682464455776}]
