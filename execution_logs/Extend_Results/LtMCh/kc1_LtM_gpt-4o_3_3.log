2026-05-25 03:26:47,453 - INFO - ops_string = ["# log_normalized_loc\n# Log-transformed normalized lines of code relative to token count (log(loc / module_tokens + 1))\n# Usefulness: Highlights modules deviating significantly in line-to-token ratios, emphasizing potential abnormalities.\ndf['log_normalized_loc'] = np.log(df['loc'] / df['module_tokens'] + 1)", "# effort_complexity_interaction\n# Interaction between difficulty-weighted effort and complexity_density_with_branching (difficulty_weighted_effort * complexity_density_with_branching)\n# Usefulness: Captures compounded effects of cognitive effort and branching-heavy complexity, focusing on defect-prone areas.\ndf['effort_complexity_interaction'] = df['difficulty_weighted_effort'] * df['complexity_density_with_branching']", "# log_unused_code_ratio\n# Log-transformed ratio of non-effective code to total lines (log(unused_code_ratio + 1))\n# Usefulness: Normalizes skewness in unused code metric, identifying components with excessive non-effective code prone to maintenance challenges.\ndf['log_unused_code_ratio'] = np.log(df['unused_code_ratio'] + 1)", "# decision_density\n# Ratio of branch count to lines of code (branchCount / loc)\n# Usefulness: Highlights decision-making density, strongly linked to defect-prone branching logic.\ndf['decision_density'] = df['branchCount'] / df['loc']", "# log_effort_volume_interaction\n# Log-transformed interaction of Halstead effort and volume (log_effort * log_volume)\n# Usefulness: Enhances predictive capacity by emphasizing areas where high effort and size intersect, indicating a higher defect risk.\ndf['log_effort_volume_interaction'] = df['log_effort'] * df['log_volume']", "# normalized_volume_to_token_ratio\n# Normalized volume-to-token ratio (volume_to_token_ratio / module_tokens)\n# Usefulness: Focuses on the effective density of program size over token count.\ndf['normalized_volume_to_token_ratio'] = df['volume_to_token_ratio'] / df['module_tokens']", "# log_difficulty_branch_interaction\n# Log-transformed product of Halstead difficulty and branch density (log(d * branch_density + 1))\n# Usefulness: Represents the interaction of difficulty and branching logic, a strong indicator for identifying complex decision areas prone to defects.\ndf['log_difficulty_branch_interaction'] = np.log(df['d'] * df['branch_density'] + 1)", "# log_operator_to_operand_ratio\n# Log-transformed operator-to-operand ratio (log((uniq_Op / module_tokens) + 1))\n# Usefulness: Balances skewed distribution in operator diversity relative to token count, flagging deviations in code readability.\ndf['log_operator_to_operand_ratio'] = np.log((df['uniq_Op'] / df['module_tokens']) + 1)", "# enhanced_comment_density\n# Enhanced comment density normalized across all effective lines (lOComment / (lOCode + lOComment + lOBlank))\n# Usefulness: Provides a robust metric of documentation adequacy in the module, aiding maintainability and defect avoidance.\ndf['enhanced_comment_density'] = df['lOComment'] / (df['lOCode'] + df['lOComment'] + df['lOBlank']).replace(0, np.nan)", "# complexity_density_with_branching\n# Product of branch density and complexity density (branch_density * complexity_density)\n# Usefulness: Highlights modules where control flow complexity and decision density intersect, which are likely areas for defects.\ndf['complexity_density_with_branching'] = df['branch_density'] * df['complexity_density']", "# structure_interaction\n# Product of lines of code and branch count (loc * branchCount)\n# Usefulness: Combines physical size and decision points, emphasizing modules where structural size and branching complexity contribute to errors.\ndf['structure_interaction'] = df['loc'] * df['branchCount']", "# volume_to_token_ratio\n# Ratio of Halstead volume to total tokens (v / module_tokens)\n# Usefulness: Captures density of program size (volume) relative to tokens, highlighting highly compressed or dense modules that might be error-prone.\ndf['volume_to_token_ratio'] = df['v'] / df['module_tokens']", "# log_difficulty_weighted_effort\n# Log-transformed difficulty-weighted effort metric (log(d * e + 1))\n# Usefulness: Addresses skewed distribution of the product of difficulty and effort, highlighting areas of compounding challenges while improving interpretability.\ndf['log_difficulty_weighted_effort'] = np.log(df['difficulty_weighted_effort'] + 1)", "# effort_volume_product\n# Product of Halstead effort and volume (e * v)\n# Usefulness: Captures the interaction between the mental effort needed and code size, emphasizing impactful metrics for defect prediction.\ndf['effort_volume_product'] = df['e'] * df['v']", "# normalized_loc\n# Normalized lines of code relative to token count (loc / module_tokens)\n# Usefulness: Normalizes lines of code by token count, identifying modules with unusual line-to-token ratios indicating potential defects.\ndf['normalized_loc'] = df['loc'] / df['module_tokens']", "df.drop(columns=['locCodeAndComment'], inplace=True)"]
