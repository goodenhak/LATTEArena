df['nO_ratio'] = df['nO'] / (df['nO'] + df['nN'] + df['nX'] + 1e-8)
end

python
# nHDon_ratio
# Ratio of hydrogen bond donors to oxygen atoms
# Usefulness: Demonstrates hydrogen bonding capacity relative to oxygen content, relevant for assessing molecular biodegradability.
df['nHDon_ratio'] = df['nHDon'] / (df['nO'] + 1e-8)
end

python
# SdO_log
# Log transformation of the sum of dO E-states
# Usefulness: Captures wide variations in electronic states while maintaining numerical stability across biodegradation patterns.
df['SdO_log'] = np.log(1 + abs(df['SdO']))
end

python
# LOC_square
# Square of the lopping centric index
# Usefulness: Amplifies the effect of higher structural complexity, essential for understanding molecular topology influencing biodegradation.
df['LOC_square'] = df['LOC']  2
end

python
# O_N_interaction
# Interaction term between oxygen and nitrogen atoms
# Usefulness: Co-occurrence of oxygen and nitrogen is significant for biodegradation processes linked to chemical reactivity and bonding.
df['O_N_interaction'] = df['nO'] * df['nN']
end

python
# Halogen_penalty
# Interaction term between halogens and structural complexity
# Usefulness: Addresses the combined detrimental effects of halogens and molecular structure on biodegradability.
df['Halogen_penalty'] = df['nX'] * df['LOC']
end

python
# groupbythenmean_nO
# Mean of oxygen atoms grouped by target classes
# Usefulness: Establishes class-specific oxygen atom baselines for better discrimination between biodegradable and non-biodegradable chemicals.
