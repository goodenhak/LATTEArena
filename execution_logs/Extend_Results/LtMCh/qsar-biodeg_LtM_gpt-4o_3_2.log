# nO_ratio
# Ratio of oxygen atoms to the sum of oxygen, nitrogen, and halogens
# Usefulness: Highlights the relative dominance of oxygen atoms, critical for hydrogen bonding and oxidative degradation processes.
df['nO_ratio'] = df['nO'] / (df['nO'] + df['nN'] + df['nX'] + 1e-8)
end

python
# nHDon_ratio
# Ratio of hydrogen bond donors to oxygen atoms
# Usefulness: Demonstrates the hydrogen bonding capacity relative to oxygen content, significant for assessing biodegradability.
df['nHDon_ratio'] = df['nHDon'] / (df['nO'] + 1e-8)
end

python
# SdO_log
# Log transformation of the sum of dO E-states
# Usefulness: Stabilizes variability in the electronic states of oxygen atoms, aiding in identifying biodegradation patterns.
df['SdO_log'] = np.log(1 + abs(df['SdO']))
end

python
# LOC_square
# Square of the lopping centric index
# Usefulness: Amplifies the effect of higher structural complexity, which strongly correlates with molecular reactivity and stability.
df['LOC_square'] = df['LOC']  2
end

python
# O_N_interaction
# Interaction term between number of oxygen and nitrogen atoms
# Usefulness: Represents the co-occurrence of oxygen and nitrogen, which is critical for biodegradation reactivity.
df['O_N_interaction'] = df['nO'] * df['nN']
end

python
# Halogen_penalty
# Interaction term between halogens and molecular complexity
# Usefulness: Captures the detrimental impact of halogen presence combined with structural complexity on biodegradability.
df['Halogen_penalty'] = df['nX'] * df['LOC']
end

python
# groupbythenmean_nO
# Mean value of oxygen atoms grouped by target class
# Usefulness: Establishes class-specific baselines that help distinguish patterns relevant to biodegradability classification.
df['groupbythenmean_nO'] = df.groupby('Answer')['nO'].transform('mean')
end

python
# groupbythenstd_LOC
# Standard deviation of molecular structural complexity grouped by target class
# Usefulness: Highlights variability and class-specific trends in structural complexity, providing insights for classification models.
df['groupbythenstd_LOC'] = df.groupby('Answer')['LOC'].transform('std')
end

python
df.drop(columns=['F01[N-N]'], inplace=True)
end

python
df.drop(columns=['F04[C-N]'], inplace=True)
end

python
df.drop(columns=['nCRX3'], inplace=True)
end
