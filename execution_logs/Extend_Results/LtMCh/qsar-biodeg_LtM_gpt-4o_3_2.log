# nO_ratio
# Ratio of oxygen atoms to the sum of oxygen, nitrogen, and halogens
# Usefulness: Highlights the relative dominance of oxygen atoms, which are critical for hydrogen bonding and oxidative degradation processes.
df['nO_ratio'] = df['nO'] / (df['nO'] + df['nN'] + df['nX'] + 1e-8)  # Adding epsilon to avoid division by zero
end

python
# nHDon_ratio
# Ratio of hydrogen bond donors to oxygen atoms
# Usefulness: Significant for understanding the hydrogen bonding capacity per oxygen, as it relates to biodegradability.
df['nHDon_ratio'] = df['nHDon'] / (df['nO'] + 1e-8)  # Adding epsilon to avoid division by zero
end

python
# SdO_log
# Log transformation of the sum of dO E-states
# Usefulness: Captures variability in the electronic states of oxygen atoms while ensuring stable numerical behavior for wide ranges.
df['SdO_log'] = np.log(1 + abs(df['SdO']))
end

python
# LOC_square
# Square of the lopping centric index
# Usefulness: Highlights higher structural complexity, which is a critical aspect of molecular biodegradability.
df['LOC_square'] = df['LOC']  2
end

python
# O_N_interaction
# Interaction term between number of oxygen and nitrogen atoms
# Usefulness: Represents the co-occurrence of oxygen and nitrogen, key elements influencing biodegradation.
df['O_N_interaction'] = df['nO'] * df['nN']
end

python
# Halogen_penalty
# Interaction term between halogens and structural complexity
# Usefulness: Captures the combined detrimental effect of halogens and complex structures on biodegradability.
df['Halogen_penalty'] = df['nX'] * df['LOC']
end

python
