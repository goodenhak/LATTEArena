# debt_to_income_ratio
# Debt-to-Income Ratio: Measures repayment burden by comparing credit amount to the product of installment commitment and duration.
# Usefulness: Provides an assessment of an individual's ability to repay loans relative to their disposable income and loan duration.
df['debt_to_income_ratio'] = df['credit_amount'] / (df['installment_commitment'] * df['duration'])
end

python
# credit_amount_per_unit_time
# Credit Amount Per Unit Time: Represents repayment concentration, indicating how much credit needs to be repaid per month.
# Usefulness: Captures repayment pressure over the credit duration, highlighting loan affordability.
df['credit_amount_per_unit_time'] = df['credit_amount'] / df['duration']
end

python
# savings_to_credit_ratio
# Savings-to-Credit Ratio: Compares financial security (savings) to repayment requirements (credit amount).
# Usefulness: Highlights financial stability, revealing if an individual’s savings can sufficiently cover their credit burden.
savings_mapping = {'>=1000': 1000, '<100': 50, '500<=X<1000': 750, 'no known savings': 0, '100<=X<500': 300}
df['savings_status_encoded'] = df['savings_status'].map(savings_mapping)
df['savings_to_credit_ratio'] = df['savings_status_encoded'] / df['credit_amount']
end

python
# stability_score
# Stability Score: Aggregates stability from residence duration and employment years to measure overall stability.
# Usefulness: Promotes better assessment of an individual’s long-term reliability and rooting in their local financial environment.
employment_mapping = {'>=7': 7, '<1': 0, '1<=X<4': 2.5, '4<=X<7': 5.5, 'unemployed': 0}
df['employment_encoded'] = df['employment'].map(employment_mapping)
df['stability_score'] = df['residence_since'] + df['employment_encoded']
end

python
# dependency_impact
# Dependency Impact: Assesses how the credit burden distributes among individuals dependent on the applicant.
# Usefulness: Reflects potential strain on repayment capability due to dependents relying on applicant's resources.
df['dependency_impact'] = df['credit_amount'] / df['num_dependents']
end

python
# credit_history_score
# Credit History Score: Encodes credit history to reflect repayment reliability levels.
# Usefulness: Helps predict repayment likelihood directly connected to past credit performance.
credit_history_mapping = {
    'critical/other existing credit': 0, 'delayed previously': 1, 
    'existing paid': 2, 'all paid': 3, 'no credits/all paid': 4
}
df['credit_history_score'] = df['credit_history'].map(credit_history_mapping)
end

python
# housing_encoded
# Housing Encoded: One-hot encodes housing to analyze living situation effects on financial reliability.
# Usefulness: Captures correlations between housing stability (e.g., owning property) and credit reliability.
df = pd.get_dummies(df, columns=['housing'], prefix='housing')
end

python
# personal_status_interaction
# Personal Status Interaction: Interacts personal status category with age to measure demographic group effects.
# Usefulness: Captures demographic reliability signals, revealing age-specific behavior across personal status groups.
personal_status_mapping = {'male single': 1, 'female div/dep/mar': 2, 'male mar/wid': 3, 'male div/sep': 0}
df['personal_status_encoded'] = df['personal_status'].map(personal_status_mapping)
df['personal_status_interaction'] = df['personal_status_encoded'] * df['age']
end

python
df.drop(columns=['savings_status_encoded', 'employment_encoded', 'personal_status_encoded'], inplace=True)
end
