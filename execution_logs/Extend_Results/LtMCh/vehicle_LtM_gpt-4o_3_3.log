[{'["# COMPACTNESS_LOG\\n# Log transformation of Compactness to reduce skewness and outliers impact.\\n# Usefulness: High compactness values may vary sharply between vehicle types; log transformation stabilizes these differences for better comparisons.\\ndf[\'COMPACTNESS_LOG\'] = np.log(df[\'COMPACTNESS\'])", "# VARIANCE_RATIO\\n# Ratio of scaled variance along major axis to minor axis.\\n# Usefulness: Captures the relative spread along major vs. minor axis to differentiate elongated or circular vehicles.\\ndf[\'VARIANCE_RATIO\'] = df[\'SCALED_VARIANCE_ALONG_MAJOR_AXIS\'] / df[\'SCALED_VARIANCE_ALONG_MINOR_AXIS\']", "# HOLLOWS_COMPACTNESS_RATIO\\n# Ratio of Hollows ratio to Compactness.\\n# Usefulness: Highlights the space occupied by hollows relative to how tightly packed the silhouette is, useful for differentiating hollow heavy vehicles like buses.\\ndf[\'HOLLOWS_COMPACTNESS_RATIO\'] = df[\'HOLLOWS_RATIO\'] / df[\'COMPACTNESS\']", "# ASPECT_RATIO_DIFFERENCE\\n# Difference between PR.Axis Aspect Ratio and Max Length Aspect Ratio.\\n# Usefulness: Reflects distinction in axis and length proportions that varies between vehicle types (e.g., vans vs cars).\\ndf[\'ASPECT_RATIO_DIFFERENCE\'] = df[\'PR.AXIS_ASPECT_RATIO\'] - df[\'MAX.LENGTH_ASPECT_RATIO\']", "# COMPACTNESS_ZSCORE\\n# Z-Score normalization of Compactness.\\n# Usefulness: Standardizes Compactness to identify deviations centered around the mean, useful for across-class comparisons.\\ndf[\'COMPACTNESS_ZSCORE\'] = (df[\'COMPACTNESS\'] - df[\'COMPACTNESS\'].mean()) / df[\'COMPACTNESS\'].std()", "# MAX_LENGTH_RECTANGULARITY_SQ\\n# Square of Max Length Rectangularity.\\n# Usefulness: Captures prominent nonlinear geometric patterns associated with the maximum bounding rectangle dimensions.\\ndf[\'MAX_LENGTH_RECTANGULARITY_SQ\'] = df[\'MAX.LENGTH_RECTANGULARITY\']  2", "# SCATTER_ELONGATEDNESS_INTERACTION\\n# Product of Scatter Ratio and Elongatedness.\\n# Usefulness: Combines scatter information with area-to-width shrinkage, emphasizing elongated geometries for classifiers.\\ndf[\'SCATTER_ELONGATEDNESS_INTERACTION\'] = df[\'SCATTER_RATIO\'] * df[\'ELONGATEDNESS\']", "# CIRCULARITY_BIN\\n# Binning Circularity into discrete intervals (Low, Medium, High).\\n# Usefulness: Categorizes circular resemblance thresholds for simpler pattern capture among vehicle types.\\ndf[\'CIRCULARITY_BIN\'] = pd.cut(df[\'CIRCULARITY\'], bins=[0, 40, 50, 60], labels=[\'Low\', \'Medium\', \'High\'])", "# SKEWNESS_DIFFERENCE\\n# Difference between Skewness About Major Axis and Skewness About Minor Axis.\\n# Usefulness: Contrasts symmetrical deviations along both axes, assisting in differentiating asymmetric shapes.\\ndf[\'SKEWNESS_DIFFERENCE\'] = df[\'SKEWNESS_ABOUT_MAJOR_AXIS\'] - df[\'SKEWNESS_ABOUT_MINOR_AXIS\']", "# GROUPBY_VEHICLE_TYPE_MEAN_COMPACTNESS\\n# Mean Compactness within each vehicle class (target encoding).\\n# Usefulness: Encodes class-level Compactness aggregation, capturing distinct compactness traits per vehicle type.\\ndf[\'GROUPBY_VEHICLE_TYPE_MEAN_COMPACTNESS\'] = df.groupby(\'vehicle_type\')[\'COMPACTNESS\'].transform(\'mean\')", "# DROP UNUSED COLUMN\\n# Dropping uninformative or redundant feature, CIRCULARITY_BIN was exploratory but might lead to loss due to discretization.\\ndf.drop(columns=[\'CIRCULARITY_BIN\'], inplace=True)"]': 0.01183431952662728}]
