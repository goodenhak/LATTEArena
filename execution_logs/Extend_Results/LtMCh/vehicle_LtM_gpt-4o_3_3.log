# COMPACTNESS_LOG
# Log transformation of Compactness to reduce skewness and outliers impact.
# Usefulness: Stabilizes differences in Compactness values for clearer comparisons across classes.
df['COMPACTNESS_LOG'] = np.log(df['COMPACTNESS'])
end

python
# VARIANCE_RATIO
# Ratio of scaled variance along major axis to minor axis.
# Usefulness: Captures relative spread across axes to highlight elongation or symmetry distinctions.
df['VARIANCE_RATIO'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] / df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# HOLLOWS_COMPACTNESS_RATIO
# Ratio of Hollows ratio to Compactness.
# Usefulness: Differentiates hollow-heavy vehicles by relating hollow space to silhouette compactness.
df['HOLLOWS_COMPACTNESS_RATIO'] = df['HOLLOWS_RATIO'] / df['COMPACTNESS']
end

python
# ASPECT_RATIO_DIFFERENCE
# Difference between PR.Axis Aspect Ratio and Max Length Aspect Ratio.
# Usefulness: Highlights differences in axis proportions for geometry-based vehicle type separation.
df['ASPECT_RATIO_DIFFERENCE'] = df['PR.AXIS_ASPECT_RATIO'] - df['MAX.LENGTH_ASPECT_RATIO']
end

python
# COMPACTNESS_ZSCORE
# Z-Score normalization of Compactness.
# Usefulness: Standardizes Compactness to measure deviations from the mean for cross-class comparisons.
df['COMPACTNESS_ZSCORE'] = (df['COMPACTNESS'] - df['COMPACTNESS'].mean()) / df['COMPACTNESS'].std()
end

python
# SCATTER_ELONGATEDNESS_INTERACTION
# Product of Scatter Ratio and Elongatedness.
# Usefulness: Combines inertia and shrink-width geometry to emphasize elongated silhouettes.
df['SCATTER_ELONGATEDNESS_INTERACTION'] = df['SCATTER_RATIO'] * df['ELONGATEDNESS']
end

python
# SKEWNESS_DIFFERENCE
# Difference between Skewness About Major Axis and Skewness About Minor Axis.
# Usefulness: Highlights symmetry contrasts by comparing axis skewness distributions.
df['SKEWNESS_DIFFERENCE'] = df['SKEWNESS_ABOUT_MAJOR_AXIS'] - df['SKEWNESS_ABOUT_MINOR_AXIS']
end

python
# MAX_LENGTH_RECTANGULARITY_SQ
# Square of Max Length Rectangularity.
# Usefulness: Captures prominent nonlinear geometric patterns associated with the maximum bounding rectangle dimensions.
df['MAX_LENGTH_RECTANGULARITY_SQ'] = df['MAX.LENGTH_RECTANGULARITY']  2
end

python
# GROUPBY_VEHICLE_TYPE_MEAN_COMPACTNESS
# Mean Compactness within each vehicle class (target encoding).
# Usefulness: Encodes class-specific Compactness traits for enhanced geometric differentiation.
df['GROUPBY_VEHICLE_TYPE_MEAN_COMPACTNESS'] = df.groupby('vehicle_type')['COMPACTNESS'].transform('mean')
end

python
# DROP UNUSED COLUMN
# Dropping uninformative or redundant feature, CIRCULARITY_BIN was exploratory but might lead to loss due to discretization.
df.drop(columns=['CIRCULARITY_BIN'], inplace=True)
end
