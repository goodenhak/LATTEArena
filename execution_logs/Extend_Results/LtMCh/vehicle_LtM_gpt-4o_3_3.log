# COMPACTNESS_LOG
# Log transformation of Compactness to reduce skewness and outliers impact.
# Usefulness: Stabilizes differences in Compactness values for clearer comparisons across classes.
df['COMPACTNESS_LOG'] = np.log(df['COMPACTNESS'])
end

python
# VARIANCE_RATIO
# Ratio of scaled variance along major axis to minor axis.
# Usefulness: Highlights relative spread across axes to differentiate elongated or symmetric vehicle shapes.
df['VARIANCE_RATIO'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] / df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# HOLLOWS_COMPACTNESS_RATIO
# Ratio of Hollows ratio to Compactness.
# Usefulness: Differentiates hollow-heavy vehicle designs, associating hollowness with the silhouette's compactness.
df['HOLLOWS_COMPACTNESS_RATIO'] = df['HOLLOWS_RATIO'] / df['COMPACTNESS']
end

python
# ASPECT_RATIO_DIFFERENCE
# Difference between PR.Axis Aspect Ratio and Max Length Aspect Ratio.
# Usefulness: Highlights variations in axis proportions to separate vehicles with asymmetric length and width geometry.
df['ASPECT_RATIO_DIFFERENCE'] = df['PR.AXIS_ASPECT_RATIO'] - df['MAX.LENGTH_ASPECT_RATIO']
end

python
# COMPACTNESS_ZSCORE
# Z-Score normalization of Compactness.
# Usefulness: Standardizes Compactness values, capturing deviations from the mean for cross-class comparisons.
df['COMPACTNESS_ZSCORE'] = (df['COMPACTNESS'] - df['COMPACTNESS'].mean()) / df['COMPACTNESS'].std()
end

python
# MAX_LENGTH_RECTANGULARITY_SQ
# Square of Max Length Rectangularity.
# Usefulness: Captures nonlinear geometric patterns along maximum bounding rectangle dimensions.
df['MAX_LENGTH_RECTANGULARITY_SQ'] = df['MAX.LENGTH_RECTANGULARITY']  2
end

python
# SCATTER_ELONGATEDNESS_INTERACTION
# Product of Scatter Ratio and Elongatedness.
# Usefulness: Combines inertia spread with area-to-width shrinkage, emphasizing elongated geometries.
df['SCATTER_ELONGATEDNESS_INTERACTION'] = df['SCATTER_RATIO'] * df['ELONGATEDNESS']
end

python
# SKEWNESS_DIFFERENCE
# Difference between Skewness About Major Axis and Skewness About Minor Axis.
# Usefulness: Highlights symmetry contrasts by comparing axis skewness deviations.
df['SKEWNESS_DIFFERENCE'] = df['SKEWNESS_ABOUT_MAJOR_AXIS'] - df['SKEWNESS_ABOUT_MINOR_AXIS']
end

python
# KURTOSIS_INTERACTION
# Product of Kurtosis About Major Axis and Kurtosis About Minor Axis.
# Usefulness: Amplifies extreme shape deviations in axis-specific distributions for precise distinction.
df['KURTOSIS_INTERACTION'] = df['KURTOSIS_ABOUT_MAJOR_AXIS'] * df['KURTOSIS_ABOUT_MINOR_AXIS']
end

python
# SCALED_RADIUS_TO_COMPACTNESS
# Ratio of Scaled Radius of Gyration to Compactness.
# Usefulness: Relates radius spread to packing efficiency, emphasizing tightly packed versus widely spread silhouettes.
df['SCALED_RADIUS_TO_COMPACTNESS'] = df['SCALED_RADIUS_OF_GYRATION'] / df['COMPACTNESS']
end

python
# GROUPBY_VEHICLE_TYPE_MEAN_COMPACTNESS
# Mean Compactness within each vehicle class (target encoding).
# Usefulness: Encodes class-specific Compactness traits for improved classification performance.
df['GROUPBY_VEHICLE_TYPE_MEAN_COMPACTNESS'] = df.groupby('vehicle_type')['COMPACTNESS'].transform('mean')
end

python
df.drop(columns=['CIRCULARITY_BIN'], inplace=True)
end
