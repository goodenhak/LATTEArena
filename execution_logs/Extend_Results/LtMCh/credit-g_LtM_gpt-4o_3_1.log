# credit_duration_ratio
# Feature description: Ratio of credit_amount to duration. This indicates loan affordability and aligns loan size with repayment period.
# Usefulness: Links loan size with repayment capacity, influencing approval likelihood based on repayment feasibility.
df['credit_duration_ratio'] = df['credit_amount'] / df['duration']
end

python
# housing_cost_burden
# Feature description: Ratio of installment_commitment to residence_since (proxy for housing cost burden over time).
# Usefulness: Higher values may indicate unsustainable housing costs, representing financial stress, important for credit risk assessment.
df['housing_cost_burden'] = df['installment_commitment'] / df['residence_since']
end

python
# purpose_financial_interaction
# Feature description: Aligns approval likelihood by purpose (purpose_target_encoding) with loan affordability (credit_duration_ratio).
# Usefulness: Combines the purpose of the loan with its financial structure to signal risk/reward balance.
df['purpose_financial_interaction'] = df['purpose_target_encoding'] * df['credit_duration_ratio']
end

python
# property_housing_credit_cross
# Feature description: Combines property_housing_interaction with credit_history, capturing alignment of assets and liabilities.
# Usefulness: Reflects financial stability by linking past credit behavior with property-housing dynamics.
df['property_housing_credit_cross'] = df['property_housing_interaction'] + '_' + df['credit_history']
end

python
# credit_history_target_encoding
# Feature description: Encodes credit_history categories based on their mean target value (credit approval rates).
# Usefulness: Embeds historical approval risk tied to different credit histories, enabling better prediction of creditworthiness.
credit_history_target_mean = df.groupby('credit_history')['target'].mean()  # Assuming 'target' is the label column
df['credit_history_target_encoding'] = df['credit_history'].map(credit_history_target_mean)
end

python
# duration_zscore
# Feature description: Z-score standardization of duration feature, to make its scale comparable across applicants.
# Usefulness: Offers fair representation of loan repayment periods, especially for models sensitive to scale.
df['duration_zscore'] = (df['duration'] - df['duration'].mean()) / df['duration'].std()
end

python
# checking_status_target_encoding
# Feature description: Encodes checking_status categories based on mean target value (credit approval rates per status).
