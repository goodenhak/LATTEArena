# credit_duration_ratio
# Feature description: Ratio of credit_amount to duration. This indicates loan affordability and aligns loan size with repayment period.
# Usefulness: Higher ratio indicates larger loans over shorter durations, which might influence default risk and approval decisions.
df['credit_duration_ratio'] = df['credit_amount'] / df['duration']
end

python
# installment_to_credit_ratio
# Feature description: Ratio of installment_commitment to credit_amount. This reflects the burden of monthly payments relative to the credit amount.
# Usefulness: Helps determine if the installment is manageable given the loan size, directly indicating financial pressure.
df['installment_to_credit_ratio'] = df['installment_commitment'] / df['credit_amount']
end

python
# log_credit_amount
# Feature description: Log transformation of credit_amount to address skewed distribution and reduce impact of outliers.
# Usefulness: Outliers in credit_amount can disproportionately influence predictions; taking the log mitigates this while preserving rank order.
df['log_credit_amount'] = np.log1p(df['credit_amount'])
end

python
# age_zscore
# Feature description: Z-score standardization of age. This scales age data to a mean of 0 and standard deviation of 1.
# Usefulness: Standardizes the age feature for models sensitive to scale, improving interpretability and fair comparison.
df['age_zscore'] = (df['age'] - df['age'].mean()) / df['age'].std()
end

