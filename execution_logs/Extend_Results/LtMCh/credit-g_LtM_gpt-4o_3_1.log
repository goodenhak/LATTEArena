# credit_duration_ratio
# Feature description: Ratio of credit_amount to duration. This indicates loan affordability and aligns loan size with repayment period.
# Usefulness: Higher ratio indicates larger loans over shorter durations, which might influence default risk and approval decisions.
df['credit_duration_ratio'] = df['credit_amount'] / df['duration']
end

python
# installment_to_credit_ratio
# Feature description: Ratio of installment_commitment to credit_amount. This reflects the burden of monthly payments relative to the credit amount.
# Usefulness: Helps determine if the installment is manageable given the loan size, directly indicating financial pressure.
df['installment_to_credit_ratio'] = df['installment_commitment'] / df['credit_amount']
end

python
# log_credit_amount
# Feature description: Log transformation of credit_amount to address skewed distribution and reduce impact of outliers.
# Usefulness: Outliers in credit_amount can disproportionately influence predictions; taking the log mitigates this while preserving rank order.
df['log_credit_amount'] = np.log1p(df['credit_amount'])
end

python
# age_zscore
# Feature description: Z-score standardization of age. This scales age data to a mean of 0 and standard deviation of 1.
# Usefulness: Standardizes the age feature for models sensitive to scale, improving interpretability and fair comparison.
df['age_zscore'] = (df['age'] - df['age'].mean()) / df['age'].std()
end

python
# purpose_target_encoding
# Feature description: Encoded purpose category using the mean target value (credit approval rate per purpose).
# Usefulness: Encodes likelihood of approval associated with each purpose, adding context about historical risk/reward of different credit purposes.
purpose_target_mean = df.groupby('purpose')['target'].mean()  # Assuming 'target' is the label column
df['purpose_target_encoding'] = df['purpose'].map(purpose_target_mean)
end

python
# property_housing_interaction
# Feature description: Interaction between property_magnitude and housing situation (e.g., assets relative to housing).
# Usefulness: Reflects the alignment between housing status and asset ownership, representing financial stability.
df['property_housing_interaction'] = df['property_magnitude'] + '_' + df['housing']
end

python
# personal_status_employment_cross
# Feature description: Cross feature combining personal_status and employment to reflect commitments and stability.
# Usefulness: Captures the interplay between personal responsibilities (e.g., marital status) and work stability, indicating creditworthiness.
df['personal_status_employment_cross'] = df['personal_status'] + '_' + df['employment']
end

python
# checking_savings_interaction
# Feature description: Interaction between checking_status and savings_status to combine account stability information.
# Usefulness: Captures liquid financial assets from both checking and savings accounts for comprehensive stability assessment.
df['checking_savings_interaction'] = df['checking_status'] + '_' + df['savings_status']
end

python
# is_young_borrower
# Feature description: Binary feature indicating if the applicant is younger than 30.
# Usefulness: Differentiates younger borrowers who may have less credit history but potential future earning capacity.
df['is_young_borrower'] = (df['age'] < 30).astype(int)
end

python
# housing_cost_burden
# Feature description: Ratio of installment_commitment to residence_since (proxy for housing cost burden over time).
# Usefulness: Increased ratios could reflect unsustainable housing cost burdens, relevant for financial risk assessment.
df['housing_cost_burden'] = df['installment_commitment'] / df['residence_since']
end

python
# Drop columns with limited signal
df.drop(columns=['own_telephone', 'other_payment_plans'], inplace=True)
end
