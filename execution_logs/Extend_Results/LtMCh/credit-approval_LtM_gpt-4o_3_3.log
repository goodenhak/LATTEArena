python
# log_income
# Log-transformed Income: Log transformation of Income to handle skewness and compress extreme values.
# Usefulness: Provides better scaling of Income for models sensitive to distribution differences.
df['log_income'] = np.log1p(df['Income'])
end

python
# log_debt
# Log-transformed Debt: Log transformation of Debt to reduce the impact of outliers and skewness.
# Usefulness: Reduces effects of extreme debt values, improving prediction accuracy and feature interpretability.
df['log_debt'] = np.log1p(df['Debt'])
end

python
# credit_score_zscore
# Z-Score Normalized CreditScore: Normalized feature to center around the mean with unit variance.
# Usefulness: Standardization ensures better scaling and compatibility across features with varying distributions.
df['credit_score_zscore'] = (df['CreditScore'] - df['CreditScore'].mean()) / df['CreditScore'].std()
end

python
# employment_consistency
# Employment Consistency: Interaction of YearsEmployed and Employed to capture job stability.
# Usefulness: Job tenure combined with active employment is a strong indicator of financial security.
df['employment_consistency'] = df['YearsEmployed'] * df['Employed']
end

python
# marital_stability_interaction
# Marital Stability Interaction: Product of Age and Married, combining life stage and stability.
# Usefulness: Represents demographic stability tied to life stages strongly associated with credit trustworthiness.
df['marital_stability_interaction'] = df['Age'] * df['Married']
end

python
# prior_default_credit_score_interaction
# Prior Default and Credit Score Interaction: Interaction to adjust financial risk by past defaults and creditworthiness.
# Usefulness: Tracks the compound effect of past defaults combined with current credit strength for better risk profiling.
df['prior_default_credit_score_interaction'] = df['PriorDefault'] * df['CreditScore']
end

python
# age_bins
# Binned Age: Categorizes Age into lifecycle phases for mapping patterns in financial behavior.
# Usefulness: Identifies typical lifecycle-related credit behaviors through categorization.
df['age_bins'] = pd.cut(df['Age'], bins=[0, 25, 35, 50, 75], labels=['Young', 'YoungAdult', 'Adult', 'Senior'])
end

python
