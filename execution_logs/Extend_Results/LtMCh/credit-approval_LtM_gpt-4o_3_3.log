# Usefulness: Encodes citizenship as a demographic marker linked to stability and credit success.
le_citizen = LabelEncoder()
df['citizen_encoded'] = le_citizen.fit_transform(df['Citizen'])
end

python
# debt_to_credit_ratio
# Debt-to-CreditScore Ratio: Proportion of Debt to CreditScore as a financial stress indicator.
# Usefulness: Highlights stress on financial capacity relative to credit strength.
df['debt_to_credit_ratio'] = df['Debt'] / (df['CreditScore'] + 1e-6)
end

python
# income_per_year_employed
# Income Per Year Employed: Ratio of Income to YearsEmployed to measure productivity and career income stability.
# Usefulness: Reflects consistency in income generation relative to job tenure, an important financial trait.
df['income_per_year_employed'] = df['Income'] / (df['YearsEmployed'] + 1e-6)
end

