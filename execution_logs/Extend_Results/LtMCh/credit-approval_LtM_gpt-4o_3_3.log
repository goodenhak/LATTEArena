df['employment_consistency'] = df['YearsEmployed'] * df['Employed']
end

python
# marital_stability_interaction
# Marital Stability Interaction: Product of Age and Married, indicating life stage and demographic stability.
# Usefulness: Age combined with marital status reflects life phase stability, often linked to creditworthiness assessments.
df['marital_stability_interaction'] = df['Age'] * df['Married']
end

python
# prior_default_credit_score_interaction
# Prior Default and Credit Score Interaction: Interaction term to adjust risk by previous default and credit score strength.
# Usefulness: Tracks the compound impact of prior defaults and current creditworthiness on financial risk assessment.
df['prior_default_credit_score_interaction'] = df['PriorDefault'] * df['CreditScore']
end

python
# age_bins
# Binned Age: Categorized Age into bins reflecting lifecycle phases.
# Usefulness: Captures differing credit behaviors across demographics such as Young, YoungAdult, Adult, and Senior.
df['age_bins'] = pd.cut(df['Age'], bins=[0, 25, 35, 50, 75], labels=['Young', 'YoungAdult', 'Adult', 'Senior'])
end

python
# ethnicity_encoded
# Encoded Ethnicity: Label encoded Ethnicity to convert it into a numerical value.
# Usefulness: Enables assessment of correlations between ethnicity groups and financial behaviors.
from sklearn.preprocessing import LabelEncoder
le_ethnicity = LabelEncoder()
df['ethnicity_encoded'] = le_ethnicity.fit_transform(df['Ethnicity'])
end

python
# citizen_encoded
# Encoded Citizenship: Label encoded Citizen to convert it into a numerical value.
# Usefulness: Captures group-based dynamics in citizenship status for demographic and risk modeling.
le_citizen = LabelEncoder()
df['citizen_encoded'] = le_citizen.fit_transform(df['Citizen'])
end

python
# debt_to_credit_ratio
# Debt-to-CreditScore Ratio: Comparison of debt with credit score strength.
# Usefulness: Indicates financial health relative to an individual’s creditworthiness, illuminating financial stress levels.
df['debt_to_credit_ratio'] = df['Debt'] / (df['CreditScore'] + 1e-6)
end

python
# income_per_year_employed
# Income Per Year Employed: Income normalized by YearsEmployed, measuring financial stability or productivity over time.
# Usefulness: Highlights income generation consistency and career trajectory across applicants.
df['income_per_year_employed'] = df['Income'] / (df['YearsEmployed'] + 1e-6)
end

python
# marital_stability_and_employment_consistency
# Combined Marital Stability and Employment Consistency: Product of marital_stability_interaction and employment_consistency.
# Usefulness: Highlights compounding effects of life stage stability and job stability for higher creditworthiness.
df['marital_stability_and_employment_consistency'] = df['marital_stability_interaction'] * df['employment_consistency']
end

python
df.drop(columns=['ZipCode'], inplace=True)
end
