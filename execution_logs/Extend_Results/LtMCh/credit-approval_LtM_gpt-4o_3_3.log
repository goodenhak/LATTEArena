python
# log_income
# Log-transformed Income: Log transformation of Income to handle skewness and compress extreme values.
# Usefulness: Provides better scaling of the Income feature for models sensitive to wide distributions and skewness in raw income.
df['log_income'] = np.log1p(df['Income'])
end

python
# log_debt
# Log-transformed Debt: Log transformation of Debt to address skewness and reduce impact of outliers.
# Usefulness: Handles the wide range and skewness in debt data, improving stability and interpretability of debt-related features.
df['log_debt'] = np.log1p(df['Debt'])
end

python
# credit_score_zscore
# Z-Score Normalized CreditScore: Normalizes CreditScore to have mean 0 and variance 1.
# Usefulness: Standardization ensures better scaling and compatibility across models while adjusting for distribution variances in credit score.
df['credit_score_zscore'] = (df['CreditScore'] - df['CreditScore'].mean()) / df['CreditScore'].std()
end

python
# employment_consistency
# Employment Consistency: Interaction between YearsEmployed and Employed to highlight job stability.
# Usefulness: Reflects the impact of long-term, consistent employment on financial responsibility and creditworthiness.
df['employment_consistency'] = df['YearsEmployed'] * df['Employed']
end

python
# marital_stability_interaction
# Marital Stability Interaction: Product of Age and Married, indicating life phase and demographic stability.
# Usefulness: Captures the influence of stable life stages (like marriage) and maturity (age) on financial responsibility and credit success.
df['marital_stability_interaction'] = df['Age'] * df['Married']
end

python
# prior_default_credit_score_interaction
# Prior Default and Credit Score Interaction: Combines Prior Default and CreditScore to adjust for risk.
# Usefulness: Tracks the compound effect of current credit strength and past defaults on financial reliability.
df['prior_default_credit_score_interaction'] = df['PriorDefault'] * df['CreditScore']
end

python
# age_bins
# Binned Age: Categorizes Age into lifecycle phases (e.g., Young, YoungAdult, Adult, Senior).
