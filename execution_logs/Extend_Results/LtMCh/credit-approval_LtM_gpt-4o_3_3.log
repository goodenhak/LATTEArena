# debt_to_income_ratio
# Debt-to-Income Ratio: Proportion of debt to income, indicating financial stress or stability.
# Usefulness: Higher ratios suggest financial strain, while lower ratios indicate better financial health, directly impacting creditworthiness.
df['debt_to_income_ratio'] = df['Debt'] / (df['Income'] + 1e-6)
end

python
# log_income
# Log-transformed Income: Log transformation of Income to handle skewness and compress extreme values.
# Usefulness: Provides better scaling of the Income feature for downstream models sensitive to distribution differences.
df['log_income'] = np.log1p(df['Income'])
end

python
# log_debt
# Log-transformed Debt: Log transformation of Debt to reduce the impact of outliers and skewness.
# Usefulness: Helps address wide ranges and skewness in debt values, improving prediction accuracy.
df['log_debt'] = np.log1p(df['Debt'])
end

python
# credit_score_zscore
# Z-Score Normalized CreditScore: Normalized feature to center around mean with unit variance.
# Usefulness: Standardization reduces variance disparities and improves compatibility with machine learning models.
df['credit_score_zscore'] = (df['CreditScore'] - df['CreditScore'].mean()) / df['CreditScore'].std()
end

python
# employment_consistency
# Employment Consistency: Interaction between YearsEmployed and Employed to highlight job stability.
# Usefulness: Longer employment tenure combined with active employment signals financial security and increases credit eligibility.
df['employment_consistency'] = df['YearsEmployed'] * df['Employed']
end

python
# marital_stability_interaction
# Marital Stability Interaction: Product of Age and Married, indicating life-phase stability.
# Usefulness: Age combined with marital status represents demographic stability, often used for creditworthiness assessments.
df['marital_stability_interaction'] = df['Age'] * df['Married']
end

python
# prior_default_credit_score_interaction
# Prior Default and Credit Score Interaction: Interaction term to adjust risk by previous default and credit score strength.
# Usefulness: Tracks the compound impact of prior defaults and current creditworthiness on financial risk assessment.
df['prior_default_credit_score_interaction'] = df['PriorDefault'] * df['CreditScore']
end

python
# age_bins
# Binned Age: Categorized Age into bins reflecting lifecycle phases.
# Usefulness: Captures differing credit behaviors across demographics such as Young, Adult, and Senior.
df['age_bins'] = pd.cut(df['Age'], bins=[0, 25, 35, 50, 75], labels=['Young', 'YoungAdult', 'Adult', 'Senior'])
end

python
# ethnicity_encoded
# Encoded Ethnicity: Label encoded Ethnicity to convert it into a numerical value.
# Usefulness: Enables assessment of correlations between ethnicity groups and financial behaviors.
from sklearn.preprocessing import LabelEncoder
le_ethnicity = LabelEncoder()
df['ethnicity_encoded'] = le_ethnicity.fit_transform(df['Ethnicity'])
end

python
# citizen_encoded
# Encoded Citizenship: Label encoded Citizen to convert it into a numerical value.
# Usefulness: Allows citizenship status to be modeled as a feature reflecting demographic stability.
le_citizen = LabelEncoder()
df['citizen_encoded'] = le_citizen.fit_transform(df['Citizen'])
end

python
# debt_to_credit_ratio
# Debt-to-CreditScore Ratio: Comparison of debt with credit score strength.
# Usefulness: Indicates financial health relative to an individual's creditworthiness, highlighting financial risk.
df['debt_to_credit_ratio'] = df['Debt'] / (df['CreditScore'] + 1e-6)
end

python
# income_per_year_employed
# Income Per Year Employed: Income normalized by YearsEmployed to measure productivity or financial stability.
# Usefulness: Assesses career trajectory and income generation capacity over time.
df['income_per_year_employed'] = df['Income'] / (df['YearsEmployed'] + 1e-6)
end

python
# marital_stability_and_employment_consistency
# Combined Marital Stability and Employment Consistency: Product of marital_stability_interaction and employment_consistency.
# Usefulness: Highlights the compounding stability factor from both life phase stability and job stability.
df['marital_stability_and_employment_consistency'] = df['marital_stability_interaction'] * df['employment_consistency']
end

python
df.drop(columns=['ZipCode'], inplace=True)
end
