end

python
# credit_score_zscore
# Z-Score Normalized CreditScore: Normalized feature to center around mean with unit variance.
# Usefulness: Standardization reduces variance disparities and improves compatibility with machine learning models.
df['credit_score_zscore'] = (df['CreditScore'] - df['CreditScore'].mean()) / df['CreditScore'].std()
end

python
# employment_consistency
# Employment Consistency: Interaction between YearsEmployed and Employed to highlight job stability.
# Usefulness: Longer employment tenure combined with active employment signals financial security and increases credit eligibility.
df['employment_consistency'] = df['YearsEmployed'] * df['Employed']
end

python
# marital_stability_interaction
# Marital Stability Interaction: Product of Age and Married, indicating life phase stability.
# Usefulness: Age combined with marital status represents demographic stability, often linked to creditworthiness assessments.
df['marital_stability_interaction'] = df['Age'] * df['Married']
end

python
# prior_default_credit_score_interaction
# Prior Default and Credit Score Interaction: Interaction term to adjust risk by previous default and credit score strength.
# Usefulness: Tracks the compound impact of prior defaults and current creditworthiness on financial risk assessment.
df['prior_default_credit_score_interaction'] = df['PriorDefault'] * df['CreditScore']
