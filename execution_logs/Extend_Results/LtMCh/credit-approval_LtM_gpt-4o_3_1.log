# Debt_to_Income_Ratio
# Ratio of Debt to Income; stabilized using log to handle large variance.
# Usefulness: Illustrates financial health and an individual's ability to manage debt relative to earnings.
df['Debt_to_Income_Ratio'] = df['Debt'] / (df['Income'] + 1)
end

python
# Debt_Sqrt
# Square root transformation of Debt.
# Usefulness: Reduces skewness and highlights smaller debt values that may be overlooked in raw form.
df['Debt_Sqrt'] = np.sqrt(df['Debt'])
end

python
# CreditScore_ZScore
# Z-score normalized CreditScore.
# Usefulness: Standardizes credit scores for use in algorithms sensitive to scale, aiding comparisons.
df['CreditScore_ZScore'] = (df['CreditScore'] - df['CreditScore'].mean()) / df['CreditScore'].std()
end

python
# Employment_Status
# Cross feature of Employed and YearsEmployed.
# Usefulness: Distinguishes between stable long-term employment versus short-term/current employment.
df['Employment_Status'] = df['Employed'] * df['YearsEmployed']
end

python
# CreditScore_Employment_Cross
# Cross feature multiplying CreditScore with Employment_Status.
# Usefulness: Captures synergy between employment stability and creditworthiness on application success.
df['CreditScore_Employment_Cross'] = df['CreditScore'] * df['Employment_Status']
end

python
# Married_Debt_Interaction
# Interaction feature of Married and Debt.
# Usefulness: Examines how marital commitments influence financial liabilities and creditworthiness.
df['Married_Debt_Interaction'] = df['Married'] * df['Debt']
end

python
# Industry_TargetEncoding
# Target encoding for Industry using downstream target variable.
# Usefulness: Captures the statistical relationship of Industries with credit card application success rates.
industry_target_mean = df.groupby('Industry')['Target'].mean()
df['Industry_TargetEncoding'] = df['Industry'].map(industry_target_mean)
end

python
# Ethnicity_TargetEncoding
# Target encoding for Ethnicity using downstream target variable.
# Usefulness: Maps Ethnicity to its mean target value to capture potential socioeconomic disparities or trends.
ethnicity_target_mean = df.groupby('Ethnicity')['Target'].mean()
df['Ethnicity_TargetEncoding'] = df['Ethnicity'].map(ethnicity_target_mean)
end

python
# Age_Binned
# Binned Age feature categorizing individuals into different life stages.
# Usefulness: Captures stage-based influence on credit behavior (e.g., younger applicants vs. retirees).
df['Age_Binned'] = pd.cut(df['Age'], bins=[0, 25, 35, 50, 100], labels=['Young', 'Mid_Age', 'Mature', 'Senior'])
end

python
# Citizen_LabelEncode
# Label encoding for Citizen feature.
# Usefulness: Converts the categorical feature into numerical form for use in machine learning algorithms.
from sklearn.preprocessing import LabelEncoder
le = LabelEncoder()
df['Citizen_LabelEncode'] = le.fit_transform(df['Citizen'])
end

python
# BankCustomer_Scaled
# Min-max normalization of BankCustomer.
# Usefulness: Ensures binary features like BankCustomer are on the same scale as other numerical features.
df['BankCustomer_Scaled'] = (df['BankCustomer'] - df['BankCustomer'].min()) / (df['BankCustomer'].max() - df['BankCustomer'].min())
end

python
# Age_EmploymentStart
# Employment start age computed as Age minus YearsEmployed.
# Usefulness: Identifies individuals who started their careers earlier or later, which may influence their creditworthiness.
df['Age_EmploymentStart'] = df['Age'] - df['YearsEmployed']
end

python
df.drop(columns=['ZipCode'], inplace=True)
end
