# log_C_O_ratio
# Logarithm of C_O_ratio (log(C_O_ratio + 1))
# Usefulness: Stabilizes the wide range of C_O_ratio values, capturing proportional effects of carbon and oxygen important for structural and bond complexity.
df['log_C_O_ratio'] = np.log1p(df['C_O_ratio'])
end

python
# SpMax_diff
# Difference between SpMax_L and SpMax_B(m) (SpMax_L - SpMax_B(m))
# Usefulness: Highlights structural asymmetry in leading eigenvalues, which is predictive of variations in molecular connectivity affecting biodegradability.
df['SpMax_diff'] = df['SpMax_L'] - df['SpMax_B(m)']
end

python
# exp_neg_HyWi
# Exponential of negative HyWi_B(m) (exp(-HyWi_B(m)))
# Usefulness: Models nonlinear decay patterns based on hybridization indices, aiding in detecting subtle patterns in biodegradability.
df['exp_neg_HyWi'] = np.exp(-df['HyWi_B(m)'])
end

python
# nO_nCIR_interaction
# Interaction term between nO and nCIR (nO * nCIR)
# Usefulness: Captures the combined effect of oxygen presence and structural circuit complexity, which can influence biodegradability levels.
df['nO_nCIR_interaction'] = df['nO'] * df['nCIR']
end

python
# SM6_diff_ratio
# Difference ratio between SM6_L and SM6_B(m) ((SM6_L - SM6_B(m)) / (SM6_B(m) + 1e-6))
# Usefulness: Measures the proportional spectral gap between Laplace and Burden matrices, uncovering structural uniqueness critical for biodegradability.
df['SM6_diff_ratio'] = (df['SM6_L'] - df['SM6_B(m)']) / (df['SM6_B(m)'] + 1e-6)
end

python
# CIR_bin
# Binned version of nCIR (bins = [0, 1, 10, infinity])
# Usefulness: Groups molecules by the number of circuits into low, medium, and high complexity levels for better generalization of circuit influence.
df['CIR_bin'] = pd.cut(df['nCIR'], bins=[-np.inf, 1, 10, np.inf], labels=[0, 1, 2])
end

python
# Hybrid_mass_ratio
# Ratio of HyWi_B(m) to SpMax_B(m) (HyWi_B(m) / SpMax_B(m))
# Usefulness: Demonstrates proportional dependence between hybridization (HyWi_B(m)) and molecular mass spectral properties, predictive of biodegradability.
df['Hybrid_mass_ratio'] = df['HyWi_B(m)'] / (df['SpMax_B(m)'] + 1e-6)
end

python
# Freq_C_N_mean
# Mean of frequencies of all C-N bonds (mean of F02[C-N], F03[C-N], F04[C-N])
# Usefulness: Captures the average role of C-N bond relationships across different distances impacting molecular connectivity and biodegradability.
df['Freq_C_N_mean'] = df[['F02[C-N]', 'F03[C-N]', 'F04[C-N]']].mean(axis=1)
end

python
# log_SdO
# Logarithm of SdO (log(SdO + 1))
# Usefulness: Stabilizes the variance of sum of Sanderson electronegativity differences, which enhances interpretability in structural contributions to biodegradability.
df['log_SdO'] = np.log1p(df['SdO'])
end

python
df.drop(columns=['N-073'], inplace=True)
end

python
df.drop(columns=['B04[C-Br]'], inplace=True)
end
