[{'["# C_O_ratio\\n# Ratio of carbon atoms to oxygen atoms (C% / nO)\\n# Usefulness: Measures the balance of carbon and oxygen, critical for determining molecular structure impact on biodegradability.\\ndf[\'C_O_ratio\'] = df[\'C%\'] / (df[\'nO\'] + 1e-6)", "# N_HDon_ratio\\n# Ratio of nitrogen atoms to hydrogen donor atoms (nN / nHDon)\\n# Usefulness: Identifies balance between nitrogen and hydrogen donors that directly influence molecule\'s polarity and biodegradability.\\ndf[\'N_HDon_ratio\'] = df[\'nN\'] / (df[\'nHDon\'] + 1e-6)", "# SpMax_SM6_diff\\n# Difference between SpMax_L and SM6_L (SpMax_L - SM6_L)\\n# Usefulness: Highlights structural asymmetry in leading eigenvalues, indicative of molecular connectivity variations.\\ndf[\'SpMax_SM6_diff\'] = df[\'SpMax_L\'] - df[\'SM6_L\']", "# Polarization_ratio\\n# Ratio of SpPosA_B(p) to Psi_i_A (SpPosA_B(p) / Psi_i_A)\\n# Usefulness: Captures proportional relationship between spectral polarization and intrinsic pseudoconnectivity.\\ndf[\'Polarization_ratio\'] = df[\'SpPosA_B(p)\'] / (df[\'Psi_i_A\'] + 1e-6)", "# LOC_squared\\n# Square of LOC (LOC^2)\\n# Usefulness: Helps emphasize non-linear effects of the molecular looping-centric index on biodegradation potential.\\ndf[\'LOC_squared\'] = df[\'LOC\']  2", "# log_SdO\\n# Logarithm of SdO (log(SdO + 1))\\n# Usefulness: Stabilizes variance of sum of dO E-states and highlights its contribution to biodegradability.\\ndf[\'log_SdO\'] = np.log1p(df[\'SdO\'])", "# exp_NEG_Loc\\n# Exponential of negative LOC (exp(-LOC))\\n# Usefulness: Transforms LOC for better modeling of exponential relationships in structural loops impacting biodegradability.\\ndf[\'exp_NEG_Loc\'] = np.exp(-df[\'LOC\'])", "# CIR_bin\\n# Binned version of nCIR (bins = [0, 1, 10, max])\\n# Usefulness: Groups the number of circuits into bins to capture low, medium, and high levels of molecular circuit complexity.\\ndf[\'CIR_bin\'] = pd.cut(df[\'nCIR\'], bins=[-np.inf, 1, 10, np.inf], labels=[0, 1, 2])", "# nO_presence\\n# Binary flag for oxygen presence (nO > 0)\\n# Usefulness: Identifies molecules containing oxygen as an essential biodegradability trigger.\\ndf[\'nO_presence\'] = (df[\'nO\'] > 0).astype(int)", "# SM6_diff_ratio\\n# (SM6_L - SM6_B(m)) / (SM6_B(m) + 1e-6)\\n# Usefulness: Calculates proportional gap in spectral moments between Laplace and Burden matrices, capturing structural uniqueness.\\ndf[\'SM6_diff_ratio\'] = (df[\'SM6_L\'] - df[\'SM6_B(m)\']) / (df[\'SM6_B(m)\'] + 1e-6)", "# Freq_C_N_mean\\n# Mean of all C-N frequencies (mean of F02[C-N], F03[C-N], F04[C-N])\\n# Usefulness: Combines C-N bond frequencies across topological distances to generalize their role in molecular connectivity.\\ndf[\'Freq_C_N_mean\'] = df[[\'F02[C-N]\', \'F03[C-N]\', \'F04[C-N]\']].mean(axis=1)", "# Freq_C_O_sum\\n# Sum of C-O frequencies (sum of F03[C-O])\\n# Usefulness: Highlights effect of C-O bonds at multiple distances, contributing to biodegradability predictions.\\ndf[\'Freq_C_O_sum\'] = df[\'F03[C-O]\']", "# Hybrid_mass_ratio\\n# Ratio of HyWi_B(m) to SpMax_B(m) (HyWi_B(m) / SpMax_B(m))\\n# Usefulness: Depicts proportional dependence between Burden-matrix-related hybridization and spectral maximum by molecular mass.\\ndf[\'Hybrid_mass_ratio\'] = df[\'HyWi_B(m)\'] / (df[\'SpMax_B(m)\'] + 1e-6)", "# Me_Mi_diff\\n# Difference between mean electronegativity (Me) and ionization potential (Mi) (Me - Mi)\\n# Usefulness: Highlights subtle electronic differences critical to predicting chemical biodegradability.\\ndf[\'Me_Mi_diff\'] = df[\'Me\'] - df[\'Mi\']", "df.drop(columns=[\'N-073\'], inplace=True)", "df.drop(columns=[\'B04[C-Br]\'], inplace=True)"]': 0.018957345971564066}, {'["# log_C_O_ratio\\n# Logarithm of C_O_ratio (log(C_O_ratio + 1))\\n# Usefulness: Stabilizes the wide range of C_O_ratio values, capturing proportional effects of carbon and oxygen important for structural and bond complexity.\\ndf[\'log_C_O_ratio\'] = np.log1p(df[\'C_O_ratio\'])", "# SpMax_diff\\n#