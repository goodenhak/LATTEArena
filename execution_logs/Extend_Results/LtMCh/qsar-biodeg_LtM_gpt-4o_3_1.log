# C_O_ratio
# Ratio of carbon atoms to oxygen atoms (C% / nO)
# Usefulness: Measures the balance of carbon and oxygen, critical for determining molecular structure impact on biodegradability.
df['C_O_ratio'] = df['C%'] / (df['nO'] + 1e-6)
end

python
# Polarization_ratio
# Ratio of SpPosA_B(p) to Psi_i_A (SpPosA_B(p) / Psi_i_A)
# Usefulness: Captures proportional relationship between spectral polarization and intrinsic pseudoconnectivity.
df['Polarization_ratio'] = df['SpPosA_B(p)'] / (df['Psi_i_A'] + 1e-6)
end

python
# log_SdO
# Logarithm of SdO (log(SdO + 1))
# Usefulness: Stabilizes variance of sum of dO E-states and highlights its contribution to biodegradability.
df['log_SdO'] = np.log1p(df['SdO'])
end

python
# Hybrid_mass_ratio
# Ratio of HyWi_B(m) to SpMax_B(m) (HyWi_B(m) / SpMax_B(m))
# Usefulness: Depicts proportional dependence between Burden-matrix-related hybridization and spectral maximum by molecular mass.
df['Hybrid_mass_ratio'] = df['HyWi_B(m)'] / (df['SpMax_B(m)'] + 1e-6)
end

python
# SpMax_diff
# Difference between SpMax_L and SpMax_B(m) (SpMax_L - SpMax_B(m))
# Usefulness: Highlights structural asymmetry in leading eigenvalues, indicative of molecular connectivity variations.
df['SpMax_diff'] = df['SpMax_L'] - df['SpMax_B(m)']
end

python
# Freq_C_O_sum
# Sum of C-O frequencies (sum of F03[C-O])
# Usefulness: Highlights effect of C-O bonds at multiple distances, contributing to biodegradability predictions.
df['Freq_C_O_sum'] = df['F03[C-O]']
end

python
# nO_nCIR_interaction
# Interaction term between nO and nCIR (nO * nCIR)
# Usefulness: Captures combined effect of oxygen presence and structural circuit complexity in influencing biodegradability.
df['nO_nCIR_interaction'] = df['nO'] * df['nCIR']
end

python
# CIR_bin
# Binned version of nCIR (bins = [0, 1, 10, max])
# Usefulness: Groups the number of circuits into bins to capture low, medium, and high levels of molecular circuit complexity.
df['CIR_bin'] = pd.cut(df['nCIR'], bins=[-np.inf, 1, 10, np.inf], labels=[0, 1, 2])
end

python
# nO_presence
# Binary flag for oxygen presence (nO > 0)
# Usefulness: Identifies molecules containing oxygen as an essential biodegradability trigger.
df['nO_presence'] = (df['nO'] > 0).astype(int)
end

python
# exp_neg_HyWi
# Exponential of negative HyWi_B(m) (exp(-HyWi_B(m)))
# Usefulness: Models nonlinear decay patterns based on hybridization indices, helping to detect subtle biodegradability trends.
df['exp_neg_HyWi'] = np.exp(-df['HyWi_B(m)'])
end

python
# Freq_C_N_mean
# Mean of all C-N frequencies (mean of F02[C-N], F03[C-N], F04[C-N])
# Usefulness: Combines C-N bond frequencies across topological distances to generalize their role in molecular connectivity.
df['Freq_C_N_mean'] = df[['F02[C-N]', 'F03[C-N]', 'F04[C-N]']].mean(axis=1)
end

python
# SM6_diff_ratio
# Difference ratio between SM6_L and SM6_B(m) ((SM6_L - SM6_B(m)) / (SM6_B(m) + 1e-6))
# Usefulness: Captures proportional gap in spectral moments between Laplace and Burden matrices, highlighting structural uniqueness.
df['SM6_diff_ratio'] = (df['SM6_L'] - df['SM6_B(m)']) / (df['SM6_B(m)'] + 1e-6)
end

python
# Drop N-073
# Presence of N-073 descriptor which may be redundant in biodegradation prediction.
df.drop(columns=['N-073'], inplace=True)
end

python
# Drop B04[C-Br]
# Presence of B04[C-Br] descriptor which may have low relevance to molecular structural complexity and biodegradability.
df.drop(columns=['B04[C-Br]'], inplace=True)
end
