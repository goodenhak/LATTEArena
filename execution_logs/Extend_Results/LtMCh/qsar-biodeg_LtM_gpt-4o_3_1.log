# C_O_ratio
# Ratio of carbon atoms to oxygen atoms (C% / nO)
# Usefulness: Measures the balance of carbon and oxygen, critical for determining molecular structure impact on biodegradability.
df['C_O_ratio'] = df['C%'] / (df['nO'] + 1e-6)
end

python
# log_C_O_ratio
# Logarithm of C_O_ratio (log(C_O_ratio + 1))
# Usefulness: Stabilizes the wide range of C_O_ratio values, capturing proportional effects of carbon and oxygen.
df['log_C_O_ratio'] = np.log1p(df['C_O_ratio'])
end

python
# SpMax_diff
# Difference between SpMax_L and SpMax_B(m) (SpMax_L - SpMax_B(m))
# Usefulness: Highlights structural asymmetry in leading eigenvalues, indicative of molecular connectivity variations.
df['SpMax_diff'] = df['SpMax_L'] - df['SpMax_B(m)']
end

python
# Hybrid_mass_ratio
# Ratio of HyWi_B(m) to SpMax_B(m) (HyWi_B(m) / SpMax_B(m))
# Usefulness: Depicts proportional dependence between hybridization and molecular mass spectral properties.
df['Hybrid_mass_ratio'] = df['HyWi_B(m)'] / (df['SpMax_B(m)'] + 1e-6)
end

python
# exp_neg_HyWi
# Exponential of negative HyWi_B(m) (exp(-HyWi_B(m)))
# Usefulness: Models nonlinear decay patterns based on hybridization indices, aiding in detecting subtle patterns in biodegradability.
df['exp_neg_HyWi'] = np.exp(-df['HyWi_B(m)'])
end

python
# nO_nCIR_interaction
# Interaction term between nO and nCIR (nO * nCIR)
# Usefulness: Captures the combined effect of oxygen presence and structural circuit complexity, which can influence biodegradability levels.
df['nO_nCIR_interaction'] = df['nO'] * df['nCIR']
end

python
# Freq_C_O_sum
# Sum of C-O frequencies (sum of F03[C-O])
# Usefulness: Highlights the effect of C-O bonds at multiple distances, contributing to biodegradability predictions.
df['Freq_C_O_sum'] = df['F03[C-O]']
end

python
# CIR_bin
# Binned version of nCIR into [low, medium, high] complexity (bins = [0, 1, 10, infinity])
# Usefulness: Groups molecules by the number of circuits for generalized circuit complexity impact on biodegradability patterns.
df['CIR_bin'] = pd.cut(df['nCIR'], bins=[-np.inf, 1, 10, np.inf], labels=[0, 1, 2])
end

python
# log_SdO
# Logarithm of SdO (log(SdO + 1))
# Usefulness: Stabilizes variance of Sanderson electronegativity differences and highlights structural contributions to biodegradability.
df['log_SdO'] = np.log1p(df['SdO'])
end

python
# Polarization_ratio
# Ratio of SpPosA_B(p) to Psi_i_A (SpPosA_B(p) / Psi_i_A)
# Usefulness: Captures proportional relationship between spectral polarization and intrinsic pseudoconnectivity.
df['Polarization_ratio'] = df['SpPosA_B(p)'] / (df['Psi_i_A'] + 1e-6)
end

python
# SM6_diff_ratio
# Proportional gap between SM6_L and SM6_B(m) ((SM6_L - SM6_B(m)) / (SM6_B(m) + 1e-6))
