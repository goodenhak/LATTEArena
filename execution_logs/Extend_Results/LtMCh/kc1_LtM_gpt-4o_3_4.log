# normalized_effort
# Normalized Halstead effort: e / max(e) across all modules.
# Usefulness: Captures relative effort across modules for better interpretability and scaling, identifying outlier modules with excessive effort.
df['normalized_effort'] = df['e'] / df['e'].max()
end

python
# complexity_per_size
# Ratio of cyclomatic complexity to Halstead volume: v(g) / (v + 1).
# Usefulness: Normalizes cyclomatic complexity by Halstead volume, emphasizing decision-making complexity per unit of program cognitive complexity.
df['complexity_per_size'] = df['v(g)'] / (df['v'] + 1)
end

python
# halstead_efficiency
# Ratio of Halstead's intelligence to effort: i / (e + 1).
# Usefulness: Measures logical efficiency, identifying modules where cognitive effort is well-optimized.
df['halstead_efficiency'] = df['i'] / (df['e'] + 1)
end

python
# cyclomatic_branch_interaction
# Interaction between cyclomatic complexity and branching: v(g) * branchCount.
# Usefulness: Amplifies intricate logic by combining cyclomatic complexity and the number of branching points, which are both strong indicators of defect-prone modules.
df['cyclomatic_branch_interaction'] = df['v(g)'] * df['branchCount']
end

python
# log_volume
# Log transformation of Halstead volume: log(v + 1).
# Usefulness: Normalizes skewed Halstead volume values, reducing the impact of extreme outliers on predictive modeling.
df['log_volume'] = np.log(df['v'] + 1)
end

python
# mean_complexity_per_line
# Mean complexity per line: (v(g) * l) / (loc + 1).
# Usefulness: Combines cyclomatic complexity and Halstead program length, normalized by lines of code, to represent average complexity per line.
df['mean_complexity_per_line'] = (df['v(g)'] * df['l']) / (df['loc'] + 1)
end

python
# cognitive_complexity
# Cognitive complexity index: branchCount * v_g_per_loc.
# Usefulness: Measures the intensity of branching and decision complexity relative to module size, highlighting modules with compact but challenging control structures.
df['cognitive_complexity'] = df['branchCount'] * df['v_g_per_loc']
end

python
# drop_unused_columns
# Drop columns that are redundant or irrelevant for prediction.
# Usefulness: Removes unnecessary columns that do not contribute meaningful information to the downstream task.
df.drop(columns=['locCodeAndComment', 'lOComment', 'lOBlank'], inplace=True)
end
