# v_g_per_loc
# Ratio of cyclomatic complexity to lines of code: v(g)/loc
# Usefulness: Measures relative decision complexity per unit of code size, which is indicative of defect-proneness.

df['v_g_per_loc'] = df['v(g)'] / df['loc']
end

python
# design_vs_essential_complexity
# Ratio of design complexity to essential complexity: iv(g)/ev(g)
# Usefulness: Highlights proportion of interaction-driven complexity, capturing modules with overly intricate designs.

df['design_vs_essential_complexity'] = df['iv(g)'] / df['ev(g)']
end

python
# effort_over_volume
# Ratio of Halstead effort to volume: e/v
# Usefulness: Reflects effort efficiency in development or understanding relative to cognitive complexity.

df['effort_over_volume'] = df['e'] / df['v']
end

python
# branching_density
# Ratio of branch count to lines of code: branchCount/loc
# Usefulness: Indicates branching density, closely linked to testing effort and defect likelihood in logic-heavy modules.

df['branching_density'] = df['branchCount'] / df['loc']
end

python
# accidental_complexity
# Difference between cyclomatic complexity and essential complexity: v(g) - ev(g)
# Usefulness: Quantifies accidental complexity, which can be a major source of unexpected defects.

df['accidental_complexity'] = df['v(g)'] - df['ev(g)']
end

python
# total_op_vs_total_opnd
# Difference between total operators and total operands: total_Op - total_Opnd
# Usefulness: Highlights operator-heavy or operand-heavy modules, which could indicate imbalance in module design.

df['total_op_vs_total_opnd'] = df['total_Op'] - df['total_Opnd']
end

python
# log_effort
# Log transformation of Halstead effort: log(e)
# Usefulness: Normalizes skewed effort distribution to improve predictive model accuracy.

df['log_effort'] = np.log(df['e'] + 1)
end

python
# sqrt_branchCount
# Square root transformation of branch count: sqrt(branchCount)
# Usefulness: Reduces the variance in branch count, making it more manageable for modeling.

df['sqrt_branchCount'] = np.sqrt(df['branchCount'])
end

python
# sigmoid_difficulty
# Sigmoid transformation of Halstead difficulty: sigmoid(d)
# Usefulness: Normalizes difficulty metric into [0,1] to aid scaled comparison across modules.

df['sigmoid_difficulty'] = 1 / (1 + np.exp(-df['d']))
end

python
# rolling_mean_loc
# Rolling mean of lines of code (loc): Captures trends in modular size consistency across adjacent modules.
# Usefulness: Highlights gradual changes in module sizes, potentially related to defect-prone patterns.

df['rolling_mean_loc'] = df['loc'].rolling(window=3, min_periods=1).mean()
end

python
# cumulative_effort
# Cumulative sum of Halstead effort (e): Tracks accumulation of workload for predictive insights in large projects.
# Usefulness: Identifies sections of software with excessive cumulative complexity, often indicative of defects.

df['cumulative_effort'] = df['e'].cumsum()
end

python
# complexity_interaction
# Interaction between cyclomatic complexity and Halstead difficulty: v(g) * d
# Usefulness: Links decision-making complexity with algorithm difficulty, amplifying defect-prone correlations.

df['complexity_interaction'] = df['v(g)'] * df['d']
end

