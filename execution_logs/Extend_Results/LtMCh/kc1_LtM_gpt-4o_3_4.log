end

python
# rolling_mean_loc
# Rolling mean of lines of code (loc): Captures trends in modular size consistency across adjacent modules.
# Usefulness: Highlights gradual changes in module sizes, potentially related to defect-prone patterns.
df['rolling_mean_loc'] = df['loc'].rolling(window=3, min_periods=1).mean()
end

python
# cumulative_effort
