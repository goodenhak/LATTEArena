# v_g_per_loc
# Ratio of cyclomatic complexity to lines of code: v(g)/loc
# Usefulness: Measures relative decision complexity per unit of code size, which is indicative of defect-proneness.
df['v_g_per_loc'] = df['v(g)'] / df['loc']
end

python
# design_vs_essential_complexity
# Ratio of design complexity to essential complexity: iv(g)/ev(g)
# Usefulness: Highlights proportion of interaction-driven complexity, capturing modules with overly intricate designs.
df['design_vs_essential_complexity'] = df['iv(g)'] / df['ev(g)']
end

python
# effort_over_volume
