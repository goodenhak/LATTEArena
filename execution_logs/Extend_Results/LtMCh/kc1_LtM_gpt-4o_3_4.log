# Difference between total operators and total operands: total_Op - total_Opnd
# Usefulness: Highlights modules with operator-heavy or operand-heavy designs, indicative of structural inefficiencies.
df['total_op_vs_total_opnd'] = df['total_Op'] - df['total_Opnd']
end

python
# log_effort
# Log transformation of Halstead effort: log(e+1)
# Usefulness: Normalizes skewed effort distribution, making the effort metric more suitable for predictive modeling.
df['log_effort'] = np.log(df['e'] + 1)
end

python
# sqrt_branchCount
# Square root transformation of branch count: sqrt(branchCount)
# Usefulness: Reduces variance in branching density, facilitating improved handling in defect prediction models.
df['sqrt_branchCount'] = np.sqrt(df['branchCount'])
end

python
# complexity_interaction
# Interaction between cyclomatic complexity and Halstead difficulty: v(g) * d
# Usefulness: Links decision-making complexity with algorithm difficulty, amplifying defect-prone correlations.
df['complexity_interaction'] = df['v(g)'] * df['d']
end

python
# loc_ev_branch_interaction
# Cross feature: loc * ev(g) * branchCount
# Usefulness: Captures combined effects of module size, essential complexity, and branching logic on defect likelihood.
df['loc_ev_branch_interaction'] = df['loc'] * df['ev(g)'] * df['branchCount']
end

