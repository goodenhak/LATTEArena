# v_g_per_loc
# Ratio of cyclomatic complexity to lines of code: v(g)/loc
# Usefulness: Captures decision complexity relative to module size, indicating defect-proneness in dense decision points.
df['v_g_per_loc'] = df['v(g)'] / df['loc']
end

python
# branching_density
# Ratio of branch count to lines of code: branchCount/loc
# Usefulness: Reflects branching intensity, often correlated with defect risks in logic-heavy modules.
df['branching_density'] = df['branchCount'] / df['loc']
end

python
# effort_over_volume
# Ratio of Halstead effort to Halstead volume: e/(v+1)
# Usefulness: Evaluates effort efficiency relative to program cognitive complexity, highlighting modules with high effort relative to their complexity.
df['effort_over_volume'] = df['e'] / (df['v'] + 1)
end

python
# design_vs_essential_complexity
# Ratio of design complexity to essential complexity: iv(g)/(ev(g)+1)
# Usefulness: Highlights proportion of interaction-driven complexity, identifying modules with overly intricate designs.
df['design_vs_essential_complexity'] = df['iv(g)'] / (df['ev(g)'] + 1)
end

python
# accidental_complexity
# Difference between cyclomatic complexity and essential complexity: v(g) - ev(g)
# Usefulness: Quantifies additional complexity due to poor design, which is a common source of software defects.
df['accidental_complexity'] = df['v(g)'] - df['ev(g)']
end

python
# total_op_vs_total_opnd
# Difference between total operators and total operands: total_Op - total_Opnd
# Usefulness: Indicates potential imbalance in operator vs. operand usage, highlighting structural inefficiencies in the module.
df['total_op_vs_total_opnd'] = df['total_Op'] - df['total_Opnd']
end

python
# log_effort
# Log transformation of Halstead effort: log(e+1)
# Usefulness: Normalizes skewness in effort values, improving predictive modeling accuracy for modules with widely varying efforts.
df['log_effort'] = np.log(df['e'] + 1)
end

python
# sqrt_branchCount
# Square root transformation of branch count: sqrt(branchCount)
# Usefulness: Reduces variance in branch count, enabling smoother analysis of branching intensity in defect prediction models.
df['sqrt_branchCount'] = np.sqrt(df['branchCount'])
end

python
# sigmoid_difficulty
# Sigmoid transformation of Halstead difficulty: sigmoid(d)
# Usefulness: Scales difficulty into a [0,1] range, making comparative analysis across modules more interpretable.
df['sigmoid_difficulty'] = 1 / (1 + np.exp(-df['d']))
end

python
# complexity_interaction
# Interaction between cyclomatic complexity and Halstead difficulty: v(g) * d
# Usefulness: Amplifies defect-prone correlations by linking control-flow complexity with cognitive difficulty.
df['complexity_interaction'] = df['v(g)'] * df['d']
end

python
# loc_ev_branch_interaction
# Cross feature: loc * ev(g) * branchCount
# Usefulness: Captures combined effects of module size, essential complexity, and control flow, identifying risky code segments.
df['loc_ev_branch_interaction'] = df['loc'] * df['ev(g)'] * df['branchCount']
end

python
# rolling_mean_loc
# Rolling mean of lines of code (loc) with a window of 3.
# Usefulness: Captures trends in modular size consistency across neighboring modules, identifying gradual defect-inducing size shifts.
df['rolling_mean_loc'] = df['loc'].rolling(window=3, min_periods=1).mean()
end

python
# cumulative_effort
# Cumulative sum of Halstead effort (e) over all processed modules.
# Usefulness: Tracks accumulation of developer workload across modules, providing insights into sections with excessive cumulative complexity.
df['cumulative_effort'] = df['e'].cumsum()
end

python
df.drop(columns=['locCodeAndComment'], inplace=True)
end

python
df.drop(columns=['lOComment'], inplace=True)
end

python
df.drop(columns=['lOBlank'], inplace=True)
end
