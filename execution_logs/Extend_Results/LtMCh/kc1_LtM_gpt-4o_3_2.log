2026-05-25 03:21:53,635 - INFO - ops_string = ["# log_loc\n# Log transformation of loc (line count of code).\n# Usefulness: Normalizes the skewed distribution of loc, better capturing the relationship between code size and defect likelihood.\ndf['log_loc'] = np.log1p(df['loc'])", "# log_e\n# Log transformation of Halstead effort (e).\n# Usefulness: Reduces the skewness in effort distribution and highlights its relationship to defect likelihood while managing outliers.\ndf['log_e'] = np.log1p(df['e'])", "# log_difficulty\n# Log transformation of Halstead difficulty (d).\n# Usefulness: Normalizes the skewed range of d, enhancing its interpretability in predicting defect likelihood.\ndf['log_difficulty'] = np.log1p(df['d'])", "# sqrt_vg\n# Square root transformation of cyclomatic complexity (v(g)).\n# Usefulness: Mitigates the effect of extreme cyclomatic complexity values while preserving nonlinear relationships with defects.\ndf['sqrt_vg'] = np.sqrt(df['v(g)'])", "# sigmoid_branchCount\n# Sigmoid transformation of branchCount.\n# Usefulness: Scales branchCount to a [0, 1] range, highlighting its defect contribution in a normalized manner while dampening extreme values.\ndf['sigmoid_branchCount'] = 1 / (1 + np.exp(-df['branchCount']))", "# loc_vg_interaction\n# Interaction between loc (line count of code) and v(g) (cyclomatic complexity).\n# Usefulness: Captures the combined effects of code size and control flow complexity on defect likelihood.\ndf['loc_vg_interaction'] = df['loc'] * df['v(g)']", "# effective_complexity\n# Difference between cyclomatic complexity (v(g)) and essential complexity (ev(g)).\n# Usefulness: Isolates non-essential complexity, pinpointing overly complex regions that may be defect-prone.\ndf['effective_complexity'] = df['v(g)'] - df['ev(g)']", "# loc_per_branch\n# Ratio of loc (line count of code) to branchCount (branching in flow graph).\n# Usefulness: Indicates average lines of code per branching point to reveal dense or defect-prone decision-making areas.\ndf['loc_per_branch'] = df['loc'] / df['branchCount']", "# branch_loc_ratio\n# Ratio of loc (line count of code) to branchCount (branch count in the control flow graph).\n# Usefulness: Identifies the distribution of code across decision points, exposing areas of complex flow logic.\ndf['branch_loc_ratio'] = df['loc'] / df['branchCount']", "# avg_uniq_op_density\n# Ratio of uniq_Op (unique operators) to loc (line count of code).\n# Usefulness: Gauges operator diversity per line, potentially revealing dense and complicated computation areas.\ndf['avg_uniq_op_density'] = df['uniq_Op'] / df['loc']", "# halstead_b_to_loc\n# Ratio of Halstead b (error estimate) to loc (line count of code).\n# Usefulness: Estimates potential defect/error density within the module logic per code line.\ndf['halstead_b_to_loc'] = df['b'] / df['loc']", "# effort_per_loc\n# Ratio of Halstead effort (e) to loc (line count of code).\n# Usefulness: Highlights effort required per line of code, linking labor intensity to defect likelihood.\ndf['effort_per_loc'] = df['e'] / df['loc']", "# cognitive_load\n# Product of Halstead volume (v) and Halstead difficulty (d), divided by loc.\n# Usefulness: Quantifies cognitive effort per line of code, identifying areas that may be harder to understand or maintain.\ndf['cognitive_load'] = (df['v'] * df['d']) / df['loc']", "# normalized_loc_density\n# Ratio of loc to the sum of loc, lOComment, and lOBlank (code density).\n# Usefulness: Captures the effective concentration of actionable code within a module, ignoring non-code lines.\ndf['normalized_loc_density'] = df['loc'] / (df['loc'] + df['lOComment'] + df['lOBlank'])", "# ivg_ev_diff\n# Difference between iv(g) (design complexity) and ev(g) (essential complexity).\n# Usefulness: Explores design flaws or unnecessary complexities in the structural decisions of the code.\ndf['ivg_ev_diff'] = df['iv(g)'] - df['ev(g)']", "df.drop(columns=['locCodeAndComment'], inplace=True)", "df.drop(columns=['lOComment'], inplace=True)", "df.drop(columns=['lOBlank'], inplace=True)"]
