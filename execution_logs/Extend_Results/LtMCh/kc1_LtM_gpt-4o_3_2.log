# log_loc
# Log transformation of loc (line count of code).
# Usefulness: Normalizes the skewed distribution of loc to better capture the relationship between code size and defect likelihood.
df['log_loc'] = np.log1p(df['loc'])
end

python
# log_e
# Log transformation of Halstead effort (e).
# Usefulness: Reduces the skewness in effort distribution and highlights its relationship to defect likelihood while managing outliers.
df['log_e'] = np.log1p(df['e'])
end

python
# sqrt_vg
# Square root transformation of cyclomatic complexity (v(g)).
# Usefulness: Reduces the effect of extreme cyclomatic complexity values while preserving nonlinear relationships with defects.
df['sqrt_vg'] = np.sqrt(df['v(g)'])
end

python
# sigmoid_branchCount
# Sigmoid transformation of branchCount.
# Usefulness: Scales branchCount to a normalized [0, 1] range, highlighting its defect contribution while dampening extreme values.
df['sigmoid_branchCount'] = 1 / (1 + np.exp(-df['branchCount']))
end

python
# effort_per_loc
# Ratio of Halstead effort (e) to loc (line count of code).
# Usefulness: Identifies areas of high workload or effort required per line of code, linking to potential defect occurrence.
df['effort_per_loc'] = df['e'] / df['loc']
end

python
# avg_uniq_op_density
# Ratio of uniq_Op (unique operators) to loc (line count of code).
# Usefulness: Indicates operator diversity (uniqueness) per line of code, revealing areas that may involve dense and complex logic.
df['avg_uniq_op_density'] = df['uniq_Op'] / df['loc']
end

python
# normalized_loc_density
# Ratio of loc to the sum of loc, lOComment, and lOBlank (code density).
# Usefulness: Reflects the concentration of actionable code within a module, ignoring non-code lines to highlight defect-prone modules.
df['normalized_loc_density'] = df['loc'] / (df['loc'] + df['lOComment'] + df['lOBlank'])
end

python
# cognitive_load
# Product of Halstead volume (v) and difficulty (d), divided by loc.
# Usefulness: Quantifies cognitive effort per line of code; higher values indicate areas harder to understand or maintain, which can lead to defects.
df['cognitive_load'] = (df['v'] * df['d']) / df['loc']
end

python
# loc_per_branch
# Ratio of loc (line count of code) to branchCount (branch count in the control flow graph).
# Usefulness: Indicates the density of code per branching point, exposing potentially dense or defect-prone decision-making areas.
df['loc_per_branch'] = df['loc'] / df['branchCount']
end

python
# loc_vg_interaction
# Interaction between loc (line count of code) and v(g) (cyclomatic complexity).
# Usefulness: Captures the combined effects of code size and control flow complexity on defect likelihood.
df['loc_vg_interaction'] = df['loc'] * df['v(g)']
end

python
# effective_complexity
# Difference between cyclomatic complexity (v(g)) and essential complexity (ev(g)).
# Usefulness: Isolates non-essential logic complexity, highlighting overly complicated sections that can be prone to defects.
df['effective_complexity'] = df['v(g)'] - df['ev(g)']
end

python
# halstead_b_to_loc
# Ratio of Halstead b (error estimate) to loc (line count of code).
# Usefulness: Estimates the potential defect or error density per line, linking higher error rates to defect-prone modules.
df['halstead_b_to_loc'] = df['b'] / df['loc']
end

python
# ivg_ev_diff
# Difference between iv(g) (design complexity) and ev(g) (essential complexity).
# Usefulness: Captures design flaws or unnecessary complexities arising from the structural decisions within the code.
df['ivg_ev_diff'] = df['iv(g)'] - df['ev(g)']
end

python
# branch_loc_ratio
# Ratio of loc (line count of code) to branchCount (branch count in the control flow graph).
# Usefulness: Identifies the distribution of code across decision points, exposing overly dense areas that may introduce defects.
df['branch_loc_ratio'] = df['loc'] / df['branchCount']
end
    
python
df.drop(columns=['locCodeAndComment'], inplace=True)
end

python
df.drop(columns=['lOComment'], inplace=True)
end

python
df.drop(columns=['lOBlank'], inplace=True)
end
