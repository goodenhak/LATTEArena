# log_loc
# Log transformation of loc (line count of code).
# Usefulness: Normalizes the skewed distribution of loc to better capture the relationship between code size and defect likelihood.
df['log_loc'] = np.log1p(df['loc'])
end

python
# log_e
# Log transformation of Halstead effort (e).
# Usefulness: Reduces the skewness in effort distribution and highlights its relationship to defect likelihood while managing outliers.
df['log_e'] = np.log1p(df['e'])
end

python
# sqrt_vg
# Square root transformation of cyclomatic complexity (v(g)).
# Usefulness: Reduces the effect of extreme cyclomatic complexity values while preserving nonlinear relationships with defects.
df['sqrt_vg'] = np.sqrt(df['v(g)'])
end

python
# avg_uniq_op_density
# Ratio of unique operators (uniq_Op) to loc (line count of code).
# Usefulness: Measures the diversity of operations per line, which can indicate areas of concentrated decision-making.
df['avg_uniq_op_density'] = df['uniq_Op'] / df['loc']
end

python
# effort_density
# Ratio of Halstead effort (e) to loc (line count of code).
# Usefulness: Quantifies labor intensity per line of code, revealing complex areas prone to defects.
df['effort_density'] = df['e'] / df['loc']
end

python
# loc_per_branch
# Ratio of loc (line count of code) to branchCount (branching in flow graph).
# Usefulness: Gauges the density of lines of code per branching point, exposing dense or poorly distributed code.
df['loc_per_branch'] = df['loc'] / df['branchCount']
end

python
# effective_complexity
# Difference between cyclomatic complexity (v(g)) and essential complexity (ev(g)).
# Usefulness: Isolates non-essential/control flow complexity, identifying logically dense and potentially defective regions.
df['effective_complexity'] = df['v(g)'] - df['ev(g)']
end

python
# loc_vg_interaction
# Interaction between loc (line count of code) and v(g) (cyclomatic complexity).
# Usefulness: Highlights the combined effect of code size and control flow complexity on defect likelihood.
df['loc_vg_interaction'] = df['loc'] * df['v(g)']
end

python
# sigmoid_branchCount
# Sigmoid transformation of branchCount.
# Usefulness: Scales branchCount to a normalized [0,1] range, emphasizing smaller values while dampening extreme ones.
df['sigmoid_branchCount'] = 1 / (1 + np.exp(-df['branchCount']))
end

python
# normalized_loc_density
# Ratio of loc to the sum of loc, lOComment, and lOBlank (code density).
# Usefulness: Reflects the concentration of actionable code within a module while ignoring non-code lines.
df['normalized_loc_density'] = df['loc'] / (df['loc'] + df['lOComment'] + df['lOBlank'])
end

python
# cognitive_load
# Product of Halstead volume (v) and difficulty (d), divided by loc.
# Usefulness: Captures cognitive complexity per line of code that may be harder to understand or maintain.
df['cognitive_load'] = (df['v'] * df['d']) / df['loc']
end

python
# halstead_b_to_loc
# Ratio of Halstead b (error estimate) to loc (line count of code).
# Usefulness: Estimates the potential defect/error density per line, linking error-prone modules with higher precision.
df['halstead_b_to_loc'] = df['b'] / df['loc']
end

python
# ivg_ev_diff
# Difference between iv(g) (design complexity) and ev(g) (essential complexity).
# Usefulness: Explores design flaws or unnecessary complexities arising from structural decisions in the code.
df['ivg_ev_diff'] = df['iv(g)'] - df['ev(g)']
end

python
# branch_loc_ratio
# Ratio of loc (line count of code) to branchCount (branch count in the control flow graph).
# Usefulness: Identifies the distribution of code across decision points, exposing areas of complex flow logic.
df['branch_loc_ratio'] = df['loc'] / df['branchCount']
end

python
df.drop(columns=['locCodeAndComment'], inplace=True)
end

python
df.drop(columns=['lOComment'], inplace=True)
end

python
df.drop(columns=['lOBlank'], inplace=True)
end
