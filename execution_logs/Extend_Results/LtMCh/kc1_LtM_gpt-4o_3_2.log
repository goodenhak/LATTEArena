[{'["# log_loc\\n# Log transformation of loc (line count of code).\\n# Usefulness: Normalizes the skewed distribution of loc to better capture the relationship between code size and defect likelihood.\\ndf[\'log_loc\'] = np.log1p(df[\'loc\'])", "# log_v\\n# Log transformation of Halstead volume (v).\\n# Usefulness: Helps manage the highly skewed distribution of v, representing cognitive load and its relation to defect-prone modules.\\ndf[\'log_v\'] = np.log1p(df[\'v\'])", "# loc_vg_interaction\\n# Interaction between loc and v(g) (cyclomatic complexity).\\n# Usefulness: Highlights combined effects of module size and control flow complexity on defect likelihood.\\ndf[\'loc_vg_interaction\'] = df[\'loc\'] * df[\'v(g)\']", "# effective_complexity\\n# Difference between cyclomatic complexity (v(g)) and essential complexity (ev(g)).\\n# Usefulness: Isolates non-essential/control flow complexity, identifying potential defect-prone regions caused by complex logic.\\ndf[\'effective_complexity\'] = df[\'v(g)\'] - df[\'ev(g)\']", "# loc_per_branch\\n# Ratio of loc (line count of code) to branchCount (branching in flow graph).\\n# Usefulness: Indicates average lines of code per branching point, revealing density in decision-making sections.\\ndf[\'loc_per_branch\'] = df[\'loc\'] / df[\'branchCount\']", "# effort_per_loc\\n# Ratio of Halstead effort (e) to loc (line count of code).\\n# Usefulness: Highlights effort required per line of code, linking labor intensity to defect likelihood.\\ndf[\'effort_per_loc\'] = df[\'e\'] / df[\'loc\']", "# normalized_loc_density\\n# Ratio of loc to the sum of loc, lOComment, and lOBlank (code density).\\n# Usefulness: Captures the effective concentration of actionable code within a module, ignoring non-code lines.\\ndf[\'normalized_loc_density\'] = df[\'loc\'] / (df[\'loc\'] + df[\'lOComment\'] + df[\'lOBlank\'])", "# cognitive_load\\n# Product of Halstead volume (v) and Halstead difficulty (d), divided by loc.\\n# Usefulness: Quantifies cognitive effort per line of code, identifying areas that may be harder to understand or maintain.\\ndf[\'cognitive_load\'] = (df[\'v\'] * df[\'d\']) / df[\'loc\']", "# sqrt_vg\\n# Square root transformation of cyclomatic complexity (v(g)).\\n# Usefulness: Emphasizes nonlinear relationships between v(g) and defect-prone tendencies while mitigating high outliers.\\ndf[\'sqrt_vg\'] = np.sqrt(df[\'v(g)\'])", "# sigmoid_branchCount\\n# Sigmoid transformation of branchCount.\\n# Usefulness: Scales branchCount to a [0, 1] range, highlighting its defect contribution in a normalized manner.\\ndf[\'sigmoid_branchCount\'] = 1 / (1 + np.exp(-df[\'branchCount\']))", "# avg_uniq_op_density\\n# Ratio of uniq_Op (unique operators) to loc (line count of code).\\n# Usefulness: Gauges operator diversity per line, potentially revealing dense and complicated computation areas.\\ndf[\'avg_uniq_op_density\'] = df[\'uniq_Op\'] / df[\'loc\']", "# log_difficulty\\n# Log transformation of Halstead difficulty (d).\\n# Usefulness: Normalizes the skewed range of d, enhancing its interpretability in predicting defect likelihood.\\ndf[\'log_difficulty\'] = np.log1p(df[\'d\'])", "# ivg_ev_diff\\n# Difference between iv(g) (design complexity) and ev(g) (essential complexity).\\n# Usefulness: Captures design flaws or unnecessary complexities in the module\'s structural design.\\ndf[\'ivg_ev_diff\'] = df[\'iv(g)\'] - df[\'ev(g)\']", "# halstead_b_to_loc\\n# Ratio of Halstead b (error estimate) to loc (line count of code).\\n# Usefulness: Estimates potential defects/error density within the module logic per code line.\\ndf[\'halstead_b_to_loc\'] = df[\'b\'] / df[\'loc\']", "df.drop(columns=[\'locCodeAndComment\'], inplace=True)", "df.drop(columns=[\'lOComment\'], inplace=True)", "df.drop(columns=[\'lOBlank\'], inplace=True)"]': 0.023696682464455}, {'["# log_loc\\n# Log transformation of loc (line count of code).\\n# Usefulness: Normalizes the skewed distribution of loc to better capture the relationship b