# Usefulness: Stabilizes variance while retaining meaningful scale for biodegradability classification.
df['sqrt_nO'] = np.sqrt(df['nO'])
end

python
# sigmoid_Psi_i_A
# Sigmoid scaling of Psi_i_A, standardizing pseudoconnectivity values into a bounded range.
# Usefulness: Minimizes the impact of extreme pseudoconnectivity variations, aiding stability in biodegradation prediction.
df['sigmoid_Psi_i_A'] = 1 / (1 + np.exp(-df['Psi_i_A']))
end

python
# interaction_SpMax_L_Psi_i_A
# Interaction between SpMax_L (leading eigenvalue) and Psi_i_A (pseudoconnectivity index), combining connectivity with intrinsic state effects.
# Usefulness: Captures the joint impact of molecular structural properties influencing biodegradation processes.
df['interaction_SpMax_L_Psi_i_A'] = df['SpMax_L'] * df['Psi_i_A']
end

python
# ratio_nO_nHDon
# Ratio of nO (oxygen atoms) to nHDon (hydrogen bond donors), representing balance between heteroatoms contributing to polar interactions.
# Usefulness: Reflects interplay of oxygen contribution and hydrogen bonding potential critical to biodegradability.
df['ratio_nO_nHDon'] = df['nO'] / (df['nHDon'] + 1)
end

python
# cross_SdO_F03[C-N]
# Product of SdO (oxidation state descriptor) and F03[C-N] (nitrogen bonding frequency).
# Usefulness: Quantifies polar interactions combining oxidative effects and nitrogen bonding relevant to biodegradability.
df['cross_SdO_F03[C-N]'] = df['SdO'] * df['F03[C-N']
end

python
# ratio_F03[C-O]_nCIR
# Ratio of F03[C-O] (oxygen bonding frequency) to nCIR (number of circuits), capturing functional group abundance relative to circuit complexity.
# Usefulness: Balances oxygen bonding patterns against molecular complexity to highlight degradation pathways.
df['ratio_F03[C-O]_nCIR'] = df['F03[C-O'] / (df['nCIR'] + 1)
end

python
# diff_SpPosA_B(p)_SpMax_L
# Difference between SpPosA_B(p) and SpMax_L, revealing disparities between polarizability-weighted sums and molecular connectivity measures.
# Usefulness: Highlights molecules with disproportionate structural and polarizability patterns relevant for biodegradation mechanisms.
df['diff_SpPosA_B(p)_SpMax_L'] = df['SpPosA_B(p'] - df['SpMax_L']
end

python
# sum_nO_nN
# Sum of nO (oxygen atoms) and nN (nitrogen atoms), combining heteroatom contributions.
# Usefulness: Reflects total heteroatom presence aiding polar interactions and biodegradability classification.
df['sum_nO_nN'] = df['nO'] + df['nN']
end

