# sqrt_F03[C-O]
# Square root transformation of F03[C-O], reducing skewness and stabilizing variance in oxygen bonding frequency.
# Usefulness: Highlights the impact of oxygen bonding contributions, which are significant to biodegradability processes.
df['sqrt_F03[C-O]'] = np.sqrt(df['F03[C-O']])
end

python
# log_F04[C-N]
# Log transformation of F04[C-N], reducing skewness in nitrogen bonding frequencies.
# Usefulness: Stabilizes variability in small bonding values, augmenting patterns linked to nitrogen-related biodegradation traits.
df['log_F04[C-N]'] = np.log1p(df['F04[C-N']])
end

python
# zscore_SpMax_L
# Z-score normalization of SpMax_L, capturing relative differences in leading eigenvalue from the Laplace matrix.
# Usefulness: Normalization enhances contrast between molecules with varying connectivity parameters, aiding classification.
df['zscore_SpMax_L'] = (df['SpMax_L'] - df['SpMax_L'].mean()) / df['SpMax_L'].std()
end

python
# sigmoid_Psi_i_A
# Sigmoid scaling of Psi_i_A, compressing pseudoconnectivity values into a standardized range.
# Usefulness: Reduces the influence of extreme values in pseudoconnectivity, aiding consistent biodegradability characterization.
df['sigmoid_Psi_i_A'] = 1 / (1 + np.exp(-df['Psi_i_A']))
end

python
# ratio_F03[C-O]_F03[C-N]
# Ratio of F03[C-O] to F03[C-N], comparing oxygen versus nitrogen bonding frequencies.
# Usefulness: Captures relative abundance of oxygenated versus nitrogenated groups in molecules tied to classifications.
df['ratio_F03[C-O]_F03[C-N'] = df['F03[C-O'] / (df['F03[C-N'] + 1)
end

python
# ratio_nO_nHDon
