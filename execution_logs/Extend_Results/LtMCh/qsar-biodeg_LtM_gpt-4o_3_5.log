# sqrt_F03[C-O]
# Square root transformation of F03[C-O], reducing skewness and stabilizing variance in oxygen bonding frequency.
# Usefulness: Highlights the impact of oxygen bonding contributions, which are significant to biodegradability processes.
df['sqrt_F03[C-O]'] = np.sqrt(df['F03[C-O]'])
end

python
# zscore_nO
# Z-score normalization of nO, normalizing the number of oxygen atoms to highlight relative differences.
# Usefulness: Enhances differentiation based on oxygen atom presence, a critical factor in biodegradability.
df['zscore_nO'] = (df['nO'] - df['nO'].mean()) / df['nO'].std()
end

python
# interaction_SpMax_L_Psi_i_A
# Product of SpMax_L (leading eigenvalue) and Psi_i_A (pseudoconnectivity index).
# Usefulness: Captures the interaction between molecular connectivity and intrinsic state, impacting stability and biodegradability.
df['interaction_SpMax_L_Psi_i_A'] = df['SpMax_L'] * df['Psi_i_A']
end

python
# ratio_nO_nHDon
# Ratio of nO (oxygen atoms) to nHDon (hydrogen bond donors).
# Usefulness: Reveals the balance between oxygen atoms and hydrogen bond donors, critical to polar interactions in biodegradability.
df['ratio_nO_nHDon'] = df['nO'] / (df['nHDon'] + 1)
end

python
# log_F04[C-N]
# Log transformation of F04[C-N], reducing the skewness in nitrogen bonding frequency.
# Usefulness: Highlights smaller bonding frequencies while stabilizing the variability linked to biodegradation patterns.
df['log_F04[C-N]'] = np.log1p(df['F04[C-N]'])
end

python
# sigmoid_Psi_i_A
# Sigmoid scaling of Psi_i_A, compressing intrinsic state values into a standardized range.
# Usefulness: Reduces the effects of extreme pseudoconnectivity values, enhancing classification robustness.
df['sigmoid_Psi_i_A'] = 1 / (1 + np.exp(-df['Psi_i_A']))
end

python
# interaction_nO_nN
# Product of nO (oxygen atoms) and nN (nitrogen atoms).
# Usefulness: Captures the joint role of oxygen and nitrogen atoms, key heteroatoms that influence molecular biodegradability.
df['interaction_nO_nN'] = df['nO'] * df['nN']
end

python
# diff_SpPosA_B_p_SpMax_L
# Difference between SpPosA_B(p) and SpMax_L, quantifying the disparity between polarizability-weighted sums and connectivity.
# Usefulness: Highlights molecules with disproportionate structural connectivity versus polarizability, relevant to biodegradability mechanisms.
df['diff_SpPosA_B_p_SpMax_L'] = df['SpPosA_B(p)'] - df['SpMax_L']
end

python
# ratio_F03[C-O]_nCIR
# Ratio of F03[C-O] (oxygen bonding frequency) to nCIR (number of circuits).
# Usefulness: Balances functional group presence with circuit complexity, relevant for degradation potential.
df['ratio_F03[C-O]_nCIR'] = df['F03[C-O]'] / (df['nCIR'] + 1)
end

python
# sum_nO_nN
# Sum of nO (oxygen atoms) and nN (nitrogen atoms).
# Usefulness: Represents combined heteroatom presence, crucial for polar group interactions and biodegradability classification.
df['sum_nO_nN'] = df['nO'] + df['nN']
end

python
# rolling_mean_nCIR
# Rolling mean of nCIR (number of circuits) over a window of 3.
# Usefulness: Smooths short-term fluctuations in circuit counts to identify broader degradation-related trends.
df['rolling_mean_nCIR'] = df['nCIR'].rolling(window=3, min_periods=1).mean()
end

python
# cube_nCrt
# Cubic transformation of nCrt (ring tertiary C).
# Usefulness: Amplifies distinctions in rare tertiary carbon occurrences, relevant for biodegradability profile identification.
df['cube_nCrt'] = df['nCrt']  3
end

python
# minmax_SpMax_L
# Min-max normalization of SpMax_L.
# Usefulness: Scales structural connectivity values between 0 and 1, aiding interpretability and reducing scale disparities in models.
df['minmax_SpMax_L'] = (df['SpMax_L'] - df['SpMax_L'].min()) / (df['SpMax_L'].max() - df['SpMax_L'].min())
end

python
df.drop(columns=['NssssC', 'nN-N', 'F01[N-N]'], inplace=True)
end
