[{'["# zscore_SpMax_L\\n# Z-score normalization of SpMax_L, capturing relative differences in leading eigenvalue from the Laplace matrix.\\n# Usefulness: Normalization enhances contrast between molecules with varying connectivity parameters, aiding classification.\\ndf[\'zscore_SpMax_L\'] = (df[\'SpMax_L\'] - df[\'SpMax_L\'].mean()) / df[\'SpMax_L\'].std()", "# zscore_J_Dz(e)\\n# Z-score normalization of J_Dz(e), capturing scaled Balaban index values for electronegativity.\\n# Usefulness: Standardization emphasizes differences, especially for medium to high-range values linked to polarity.\\ndf[\'zscore_J_Dz(e)\'] = (df[\'J_Dz(e)\'] - df[\'J_Dz(e)\'].mean()) / df[\'J_Dz(e)\'].std()", "# log_SdO\\n# Log transformation of SdO to reduce range skewness and highlight smaller oxidation state contributions.\\n# Usefulness: Enhances interpretability of oxidative group effects linked to biodegradability.\\ndf[\'log_SdO\'] = np.log1p(df[\'SdO\'])", "# ratio_C_per_O_N\\n# Ratio of C% to (nO + nN), depicting carbon dominance relative to polar atoms.\\n# Usefulness: Compounds with higher carbon content tend to be less biodegradable based on dataset patterns.\\ndf[\'ratio_C_per_O_N\'] = df[\'C%\'] / (df[\'nO\'] + df[\'nN\'] + 1)", "# interaction_SpMax_L_HyWi_B\\n# Product of SpMax_L and HyWi_B(m), combining connectivity with shape complexity.\\n# Usefulness: Captures interaction of structural descriptors that influence compound stability.\\ndf[\'interaction_SpMax_L_HyWi_B\'] = df[\'SpMax_L\'] * df[\'HyWi_B(m)\']", "# sqrt_F04[C-N]\\n# Square root transformation of F04[C-N], representing nitrogen bonding with stabilized variability.\\n# Usefulness: Surgically reduces the spread of bonding frequency data catering to balanced classification.\\ndf[\'sqrt_F04[C-N]\'] = np.sqrt(df[\'F04[C-N]\'])", "# diff_SpMax_L_SpMax_A\\n# Difference between SpMax_L and SpMax_A, quantifying the disparity in molecular connectivity measures.\\n# Usefulness: Highlights connectivity anomalies that may impact readiness for biodegradation.\\ndf[\'diff_SpMax_L_SpMax_A\'] = df[\'SpMax_L\'] - df[\'SpMax_A\']", "# product_LOC_nCIR\\n# Product of LOC and nCIR, combining topological stability with circuit count.\\n# Usefulness: Reflects complex ring systems that influence molecular degradation profiles.\\ndf[\'product_LOC_nCIR\'] = df[\'LOC\'] * df[\'nCIR\']", "# cross_SdO_F03[C-N]\\n# Product of SdO and F03[C-N], combining oxidation states with nitrogen bonding frequency.\\n# Usefulness: Quantifies the role of polar group interactions relevant to degradation pathways.\\ndf[\'cross_SdO_F03[C-N]\'] = df[\'SdO\'] * df[\'F03[C-N]\']", "# ratio_F03[C-O]_F03[C-N]\\n# Ratio of F03[C-O] to F03[C-N], comparing oxygen versus nitrogen bonding frequencies.\\n# Usefulness: Captures relative abundance of oxygenated versus nitrogenated groups in molecules tied to classifications.\\ndf[\'ratio_F03[C-O]_F03[C-N\'] = df[\'F03[C-O\'] / (df[\'F03[C-N\'] + 1)", "# sigmoid_nCIR\\n# Sigmoid scaling of nCIR, compressing the range of circuit-related counts into bounds.\\n# Usefulness: Reduces the impact of large circuit counts while preserving meaningful variability.\\ndf[\'sigmoid_nCIR\'] = 1 / (1 + np.exp(-df[\'nCIR\']))", "# log_TI2_L\\n# Log transformation of TI2_L (Mohar index) to handle skewed topological data.\\n# Usefulness: Compresses data variability while retaining the ordering of molecular stability.\\ndf[\'log_TI2_L\'] = np.log1p(df[\'TI2_L\'])", "# square_SdssC\\n# Square transformation of SdssC to amplify small E-state values linked to carbon interactions.\\n# Usefulness: Emphasizes the cumulative effect of connected carbon nodes on biodegradability.\\ndf[\'square_SdssC\'] = df[\'SdssC\']  2", "# interaction_nN_F02[C-N]\\n# Product of nN (nitrogen atoms) and F02[C-N], representing nitrogen-related molecular interactions.\\n# Usefulness: Captures nitrogen presence combined with its bonding patterns for classification relevance.\\ndf[\'interaction_nN_F02[C-N\'] = df[\'nN\'] * df[\'F0