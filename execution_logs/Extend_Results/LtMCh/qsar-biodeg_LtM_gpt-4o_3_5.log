# Usefulness: Reflects the balance between oxygen atom count and hydrogen bonding capacity, enhancing polar interactions in biodegradation.
df['ratio_nO_nHDon'] = df['nO'] / (df['nHDon'] + 1)
end

python
# interaction_nO_nN
# Product of nO (oxygen atoms) and nN (nitrogen atoms).
# Usefulness: Captures joint influence of heteroatoms pivotal for molecular stability and biodegradability pathways.
df['interaction_nO_nN'] = df['nO'] * df['nN']
end

python
# interaction_SpMax_L_Psi_i_A
# Product of SpMax_L (leading eigenvalue) and Psi_i_A (pseudoconnectivity index).
# Usefulness: Encapsulates the combined role of molecular connectivity and intrinsic state, relevant for stability and degradation.
df['interaction_SpMax_L_Psi_i_A'] = df['SpMax_L'] * df['Psi_i_A']
end

python
# cross_SdO_F03[C-N]
# Product of SdO and F03[C-N], combining oxidation states with nitrogen bonding frequency.
# Usefulness: Quantifies the role of polar group interactions relevant to degradation pathways.
df['cross_SdO_F03[C-N'] = df['SdO'] * df['F03[C-N']
end

python
