# zscore_nO
# Z-score normalization of nO, normalizing the number of oxygen atoms to highlight relative differences.
# Usefulness: Enhances differentiation based on oxygen atom presence, a critical factor in biodegradability.
df['zscore_nO'] = (df['nO'] - df['nO'].mean()) / df['nO'].std()
end

python
# sigmoid_nCIR
# Sigmoid scaling of nCIR, compressing the range of circuit-related counts into bounds.
# Usefulness: Reduces the impact of large circuit counts while preserving meaningful variability for classification.
df['sigmoid_nCIR'] = 1 / (1 + np.exp(-df['nCIR']))
end

python
# ratio_nO_nHDon
# Ratio of nO (oxygen atoms) to nHDon (hydrogen bond donors).
# Usefulness: Highlights the balance between oxygen contribution and hydrogen-bonding potential, influencing biodegradation readiness.
df['ratio_nO_nHDon'] = df['nO'] / (df['nHDon'] + 1)
end

python
# interaction_nO_nN
# Product of nO (oxygen atoms) and nN (nitrogen atoms).
# Usefulness: Captures the joint role of oxygen and nitrogen atoms, key heteroatoms that influence molecular biodegradability.
df['interaction_nO_nN'] = df['nO'] * df['nN']
end

python
# sqrt_F03[C-O]
# Square root transformation of F03[C-O], reducing skewness and stabilizing variance in oxygen bonding frequency.
# Usefulness: Highlights the impact of oxygen bonding contributions, which are significant to biodegradability processes.
df['sqrt_F03[C-O]'] = np.sqrt(df['F03[C-O]'])
end

python
# cross_SdO_F03[C-N]
# Product of SdO and F03[C-N], combining oxidation states with nitrogen bonding frequency.
# Usefulness: Quantifies the role of polar group interactions relevant to degradation pathways.
df['cross_SdO_F03[C-N]'] = df['SdO'] * df['F03[C-N]']
end

python
# diff_SpPosA_B_p_SpMax_L
# Difference between SpPosA_B(p) and SpMax_L, quantifying disparity between polarizability-weighted sums and connectivity measures.
# Usefulness: Highlights molecules where connectivity and polarizability influence biodegradation differently.
df['diff_SpPosA_B_p_SpMax_L'] = df['SpPosA_B(p)'] - df['SpMax_L']
end

python
# ratio_F03[C-O]_nCIR
# Ratio of F03[C-O] (oxygen bonding frequency) to nCIR (number of circuits).
# Usefulness: Balances functional group abundance against circuit complexity, relevant to biodegradation degradation pathways.
df['ratio_F03[C-O]_nCIR'] = df['F03[C-O]'] / (df['nCIR'] + 1)
end

python
# log_F04[C-N]
# Log transformation of F04[C-N], reducing skewness in nitrogen bonding frequencies.
# Usefulness: Stabilizes variability in small bonding values, augmenting patterns linked to nitrogen-related biodegradation traits.
df['log_F04[C-N]'] = np.log1p(df['F04[C-N]'])
end

python
# rolling_mean_nCIR
# Rolling mean of nCIR (number of circuits) over a window of 3.
# Usefulness: Reduces local fluctuations in circuit counts and reveals broader trends linked to molecular stability.
df['rolling_mean_nCIR'] = df['nCIR'].rolling(window=3, min_periods=1).mean()
end

python
# cube_nCrt
# Cubic transformation of nCrt (ring tertiary C).
# Usefulness: Amplifies distinctions in rare tertiary carbon occurrences, relevant to biodegradability classification.
df['cube_nCrt'] = df['nCrt']  3
end

python
df.drop(columns=['NssssC', 'nN-N', 'F01[N-N]'], inplace=True)
end
