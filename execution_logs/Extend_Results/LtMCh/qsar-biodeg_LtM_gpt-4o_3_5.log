end

python
# interaction_SpMax_L_Psi_i_A
# Product of SpMax_L (leading eigenvalue) and Psi_i_A (pseudoconnectivity index).
# Usefulness: Encapsulates the combined role of molecular connectivity and intrinsic state, relevant for stability and degradation.
df['interaction_SpMax_L_Psi_i_A'] = df['SpMax_L'] * df['Psi_i_A']
end

python
# log_F04[C-N]
