# interaction_J_Dz_e_SpMax_L
# Interaction of Balaban index weighted by electronegativity (J_Dz(e)) with Laplace matrix leading eigenvalue (SpMax_L).
# Usefulness: Captures the relationship between molecular topology and electronegativity, both of which are crucial for chemical reactivity and biodegradability.
df['interaction_J_Dz_e_SpMax_L'] = df['J_Dz(e)'] * df['SpMax_L']
end

python
# oxygen_to_carbon_ratio
# Ratio of oxygen atoms (nO) to carbon percentage (C%).
# Usefulness: Represents oxygen density relative to carbon composition, highlighting the role of oxygen in biodegradation.
df['oxygen_to_carbon_ratio'] = df['nO'] / (df['C%'] + 1e-5)
end

python
# nitrogen_total_ratio
# Ratio of nitrogen atoms (nN) to the sum of nitrogen, oxygen, and substituted benzene atoms (nCb-).
# Usefulness: Assists in understanding nitrogen's proportional role in enhancing or inhibiting biodegradability through heteroatom contributions.
df['nitrogen_total_ratio'] = df['nN'] / (df['nN'] + df['nO'] + df['nCb-'] + 1e-5)
end

python
# log_F04_CN
# Logarithmic transformation of frequency of C-N bonds at topological distance 4 (F04[C-N]).
# Usefulness: Reduces skewness for this feature and normalizes its distribution over a wide range, improving interpretability and modeling performance.
df['log_F04_CN'] = np.log1p(df['F04[C-N]'])
end

python
# spectral_moment_mean
# Mean of spectral moments from Laplace matrix (SM6_L) and Burden matrix weighted by mass (SM6_B(m)).
# Usefulness: Provides a consolidated view of structural topology information captured by spectral measures, which are key for modeling molecular properties.
df['spectral_moment_mean'] = (df['SM6_L'] + df['SM6_B(m)']) / 2
end

python
# function_group_sum
# Summation of functional group frequencies related to C-N bonds at different distances (F02[C-N], F03[C-N], F04[C-N]).
# Usefulness: Aggregates similar functional group properties for a more robust representation of molecular characteristics relevant to biodegradation.
df['function_group_sum'] = df['F02[C-N]'] + df['F03[C-N]'] + df['F04[C-N]']
end

python
# electronegativity_polarizability_ratio
# Ratio of polarizability-weighted spectral sum (SpPosA_B(p)) to mean atomic Sanderson electronegativity (Me).
