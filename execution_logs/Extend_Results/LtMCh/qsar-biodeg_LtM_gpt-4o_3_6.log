# interaction_J_Dz_e_SpMax_L
# Interaction of Balaban index weighted by electronegativity (J_Dz(e)) with Laplace matrix leading eigenvalue (SpMax_L).
# Usefulness: Captures the relationship between molecular topology and electronegativity, both crucial for chemical reactivity and biodegradability.
df['interaction_J_Dz_e_SpMax_L'] = df['J_Dz(e)'] * df['SpMax_L']
end

python
# oxygen_to_carbon_ratio
# Ratio of oxygen atoms (nO) to carbon percentage (C%).
# Usefulness: Highlights oxygen density relative to carbon composition, which has a critical influence on biodegradation processes.
df['oxygen_to_carbon_ratio'] = df['nO'] / (df['C%'] + 1e-5)
end

python
# nitrogen_total_ratio
# Ratio of nitrogen atoms (nN) to the total of nitrogen (nN), oxygen (nO), and substituted benzene atoms (nCb-).
# Usefulness: Helps understand nitrogen's proportional role in biodegradability in the context of other heteroatoms.
df['nitrogen_total_ratio'] = df['nN'] / (df['nN'] + df['nO'] + df['nCb-'] + 1e-5)
end

python
# log_F04_CN
# Logarithmic transformation of frequency of C-N bonds at topological distance 4 (F04[C-N]).
# Usefulness: Reduces the skewness of this feature and normalizes its distribution over a wide range, improving interpretability and modeling performance.
df['log_F04_CN'] = np.log1p(df['F04[C-N]'])
end

python
# spectral_moment_mean
# Mean of spectral moments from Laplace matrix (SM6_L) and Burden matrix weighted by mass (SM6_B(m)).
# Usefulness: Consolidates global structural topology information captured by spectral measures, which are crucial for modeling molecular properties.
df['spectral_moment_mean'] = (df['SM6_L'] + df['SM6_B(m)']) / 2
end

python
# function_group_sum
# Summation of functional group frequencies related to C-N bonds at different distances (F02[C-N], F03[C-N], F04[C-N]).
# Usefulness: Aggregates similar functional group properties for a more robust representation of molecular characteristics relevant to biodegradation.
df['function_group_sum'] = df['F02[C-N]'] + df['F03[C-N]'] + df['F04[C-N]']
end

python
# electronegativity_polarizability_ratio
# Ratio of polarizability-weighted spectral sum (SpPosA_B(p)) to mean atomic Sanderson electronegativity (Me).
# Usefulness: Demonstrates the interaction between molecular polarizability and electronegativity, which jointly impact chemical reactivity and biodegradability.
df['electronegativity_polarizability_ratio'] = df['SpPosA_B(p)'] / (df['Me'] + 1e-5)
end

python
# sigmoid_Me
# Sigmoid transformation of mean atomic Sanderson electronegativity (Me).
# Usefulness: Handles the limited range of this feature while preserving linear separability; captures non-linear relationships influencing biodegradability.
df['sigmoid_Me'] = 1 / (1 + np.exp(-df['Me']))
end

python
# cube_nHDon
# Cube transformation of the number of donor atoms for hydrogen bonds (nHDon).
# Usefulness: Emphasizes extreme values of donor atom counts, allowing improved modeling of non-linear biodegradation effects.
df['cube_nHDon'] = df['nHDon']  3
end

python
# polarizability_by_mass
# Interaction of polarizability-weighted spectral sum (SpPosA_B(p)) with Burden matrix leading eigenvalue by molecular mass (SpMax_B(m)).
# Usefulness: Represents how polarizability weighted by molecular mass influences chemical interaction patterns, which are important for biodegradability.
df['polarizability_by_mass'] = df['SpPosA_B(p)'] * df['SpMax_B(m)']
end

python
df.drop(columns=['F01[N-N]', 'NssssC', 'nCRX3', 'N-073', 'B01[C-Br]', 'B04[C-Br]', 'nArNO2', 'nArCOOR', 'B03[C-Cl]'], inplace=True)
end
