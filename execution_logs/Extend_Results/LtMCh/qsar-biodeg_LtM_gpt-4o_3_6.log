odegradation.\ndf['function_group_sum'] = df['F02[C-N]'] + df['F03[C-N]'] + df['F04[C-N]']", "# electronegativity_polarizability_ratio\n# Ratio of polarizability-weighted spectral sum (SpPosA_B(p)) to mean atomic Sanderson electronegativity (Me).\n# Usefulness: Demonstrates the interaction between molecular polarizability and electronegativity, which jointly affect chemical reactivity and biodegradability.\ndf['electronegativity_polarizability_ratio'] = df['SpPosA_B(p)'] / (df['Me'] + 1e-5)", "# sigmoid_Me\n# Sigmoid transformation of mean atomic Sanderson electronegativity (Me).\n# Usefulness: Handles the limited range of the data while preserving linear separability and enhances modeling of non-linear effects.\ndf['sigmoid_Me'] = 1 / (1 + np.exp(-df['Me']))", "# cube_nHDon\n# Cube transformation of number of donor atoms for hydrogen bonds (nHDon).\n# Usefulness: Emphasizes the extreme values for donor atoms and models non-linear relationships more expressively.\ndf['cube_nHDon'] = df['nHDon']  3", "# polarizability_by_mass\n# Interaction of polarizability-weighted spectral sum (SpPosA_B(p)) with the Burden matrix leading eigenvalue by mass (SpMax_B(m)).\n# Usefulness: Represents how polarizability weighted by mass affects molecular interaction patterns, which can influence biodegradability.\ndf['polarizability_by_mass'] = df['SpPosA_B(p)'] * df['SpMax_B(m)']", "df.drop(columns=['F01[N-N]', 'NssssC', 'nCRX3', 'N-073', 'B01[C-Br]', 'B04[C-Br]', 'nArNO2', 'nArCOOR', 'B03[C-Cl]'], inplace=True)"]
