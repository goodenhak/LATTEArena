n_group_sum'] = df['F02[C-N]'] + df['F03[C-N]'] + df['F04[C-N]']", "# electronegativity_polarizability_ratio\n# Ratio of polarizability-weighted spectral sum (SpPosA_B(p)) to mean atomic Sanderson electronegativity (Me).\n# Usefulness: Demonstrates the interaction between molecular polarizability and electronegativity, which jointly impact chemical reactivity and biodegradability.\ndf['electronegativity_polarizability_ratio'] = df['SpPosA_B(p)'] / (df['Me'] + 1e-5)", "# sigmoid_Me\n# Sigmoid transformation of mean atomic Sanderson electronegativity (Me).\n# Usefulness: Handles the limited range of this feature while preserving linear separability; captures non-linear relationships influencing biodegradability.\ndf['sigmoid_Me'] = 1 / (1 + np.exp(-df['Me']))", "# cube_nHDon\n# Cube transformation of the number of donor atoms for hydrogen bonds (nHDon).\n# Usefulness: Emphasizes extreme values of donor atom counts, allowing improved modeling of non-linear biodegradation effects.\ndf['cube_nHDon'] = df['nHDon']  3", "# polarizability_by_mass\n# Interaction of polarizability-weighted spectral sum (SpPosA_B(p)) with Burden matrix leading eigenvalue by molecular mass (SpMax_B(m)).\n# Usefulness: Represents how polarizability weighted by molecular mass influences chemical interaction patterns, which are important for biodegradability.\ndf['polarizability_by_mass'] = df['SpPosA_B(p)'] * df['SpMax_B(m)']", "df.drop(columns=['F01[N-N]', 'NssssC', 'nCRX3', 'N-073', 'B01[C-Br]', 'B04[C-Br]', 'nArNO2', 'nArCOOR', 'B03[C-Cl]'], inplace=True)"]
