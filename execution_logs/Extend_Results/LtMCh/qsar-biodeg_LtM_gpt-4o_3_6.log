# interaction_J_Dz_e_SpMax_L
# Interaction of Balaban index weighted by electronegativity with Laplace matrix leading eigenvalue.
# Usefulness: Captures the relationship between molecular topology and electronegativity, both of which influence chemical reactivity and biodegradability.
df['interaction_J_Dz_e_SpMax_L'] = df['J_Dz(e)'] * df['SpMax_L']
end

python
# oxygen_to_carbon_ratio
# Ratio of oxygen atoms to carbon percentage.
# Usefulness: Represents oxygen density relative to the carbon composition, highlighting oxygen's critical role in biodegradation.
df['oxygen_to_carbon_ratio'] = df['nO'] / (df['C%'] + 1e-5)
end

python
# nitrogen_total_ratio
# Ratio of nitrogen atoms to the sum of nitrogen, oxygen, and substituted benzene atoms.
# Usefulness: Highlights nitrogen's proportional role in enhancing or inhibiting biodegradability through heteroatom contributions.
df['nitrogen_total_ratio'] = df['nN'] / (df['nN'] + df['nO'] + df['nCb-'] + 1e-5)
end

python
# log_F04_CN
# Logarithmic transformation of frequency of C-N bonds at topological distance 4.
# Usefulness: Reduces skewness for this feature and normalizes its distribution over a wide range, improving interpretability and modeling performance.
df['log_F04_CN'] = np.log1p(df['F04[C-N]'])
end

python
# spectral_moment_mean
# Mean of spectral moments from Laplace matrix and Burden matrix weighted by mass.
# Usefulness: Provides a consolidated view of structural topology information captured by spectral measures, key for modeling molecular properties.
df['spectral_moment_mean'] = (df['SM6_L'] + df['SM6_B(m)']) / 2
end

python
# function_group_sum
# Summation of functional group frequencies related to C-N bonds at different distances.
# Usefulness: Aggregates frequency of related functional groups, providing an enhanced descriptor for molecular characteristics linked to biodegradation.
df['function_group_sum'] = df['F02[C-N]'] + df['F03[C-N]'] + df['F04[C-N]']
end

python
# electronegativity_polarizability_ratio
# Ratio of polarizability-weighted spectral sum to mean atomic Sanderson electronegativity.
# Usefulness: Demonstrates interaction between molecular polarizability and electronegativity, which jointly affect chemical reactivity and biodegradability.
df['electronegativity_polarizability_ratio'] = df['SpPosA_B(p)'] / (df['Me'] + 1e-5)
end

python
# sigmoid_Me
# Sigmoid transformation of the mean atomic Sanderson electronegativity.
# Usefulness: Handles the limited range of the data while preserving separability and models non-linear effects on biodegradability.
df['sigmoid_Me'] = 1 / (1 + np.exp(-df['Me']))
end

python
# cube_nHDon
# Cube transformation of the number of donor atoms for hydrogen bonds.
# Usefulness: Emphasizes extreme values of donor atoms, enhancing modeling of potentially complex non-linear biodegradation effects.
df['cube_nHDon'] = df['nHDon']  3
end

python
# polarizability_by_mass
# Interaction of polarizability-weighted spectral sum with Burden matrix leading eigenvalue by molecular mass.
# Usefulness: Represents how polarizability weighted by molecular mass affects chemical interaction patterns influencing biodegradability.
df['polarizability_by_mass'] = df['SpPosA_B(p)'] * df['SpMax_B(m)']
end

