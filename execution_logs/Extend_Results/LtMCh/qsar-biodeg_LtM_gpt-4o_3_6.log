# interaction_J_Dz_e_SpMax_L
# Interaction of Balaban index weighted by electronegativity (J_Dz(e)) with Laplace matrix leading eigenvalue (SpMax_L).
# Usefulness: Captures the relationship between molecular topology and electronegativity, both critical for modeling biodegradability.
df['interaction_J_Dz_e_SpMax_L'] = df['J_Dz(e)'] * df['SpMax_L']
end

python
# oxygen_to_carbon_ratio
# Ratio of oxygen atoms (nO) to carbon percentage (C%).
# Usefulness: Highlights oxygen density relative to carbon composition, emphasizing oxygen's key role in biodegradability.
df['oxygen_to_carbon_ratio'] = df['nO'] / (df['C%'] + 1e-5)
end

python
# nitrogen_total_ratio
# Ratio of nitrogen atoms (nN) to the total sum of nitrogen (nN), oxygen (nO), and substituted benzene atoms (nCb-).
# Usefulness: Represents nitrogen's proportional contribution to biodegradability alongside related heteroatoms.
df['nitrogen_total_ratio'] = df['nN'] / (df['nN'] + df['nO'] + df['nCb-'] + 1e-5)
end

python
# log_F04_CN
# Logarithmic transformation of the frequency of C-N bonds at topological distance 4 (F04[C-N]).
# Usefulness: Reduces skewness and normalizes wide ranges, improving interpretability and performance in models.
df['log_F04_CN'] = np.log1p(df['F04[C-N]'])
end

python
# spectral_moment_mean
# Mean of spectral moments from Laplace matrix (SM6_L) and Burden matrix weighted by mass (SM6_B(m)).
# Usefulness: Combines structural topology insights from both matrices, enhancing modeling of molecular properties linked to biodegradability.
df['spectral_moment_mean'] = (df['SM6_L'] + df['SM6_B(m)']) / 2
end

python
# function_group_sum
# Total summation of functional group frequencies for C-N bonds at different topological distances (F02[C-N], F03[C-N], F04[C-N]).
# Usefulness: Provides a holistic view of C-N bond frequencies, which are relevant for characterizing molecular structures.
df['function_group_sum'] = df['F02[C-N]'] + df['F03[C-N]'] + df['F04[C-N]']
end

python
# electronegativity_polarizability_ratio
# Ratio of polarizability-weighted spectral sum (SpPosA_B(p)) to mean atomic Sanderson electronegativity (Me).
# Usefulness: Captures the interplay between polarizability and electronegativity, which can influence chemical reactivity and biodegradability.
df['electronegativity_polarizability_ratio'] = df['SpPosA_B(p)'] / (df['Me'] + 1e-5)
end

python
# sigmoid_Me
# Sigmoid transformation of mean atomic Sanderson electronegativity (Me).
# Usefulness: Creates a bounded, non-linear transformation that preserves separability and models complex patterns in biodegradation data.
df['sigmoid_Me'] = 1 / (1 + np.exp(-df['Me']))
end

python
# cube_nHDon
# Cube transformation of the number of donor atoms for hydrogen bonds (nHDon).
# Usefulness: Amplifies variations and accounts for potentially non-linear relationships between H-bond donors and biodegradability.
df['cube_nHDon'] = df['nHDon']  3
end

python
# polarizability_by_mass
# Interaction of polarizability-weighted spectral sum (SpPosA_B(p)) with the Burden matrix leading eigenvalue weighted by mass (SpMax_B(m)).
# Usefulness: Highlights how polarizability, when scaled by molecular mass, impacts features critical to chemical interactions and biodegradability.
df['polarizability_by_mass'] = df['SpPosA_B(p)'] * df['SpMax_B(m)']
end

