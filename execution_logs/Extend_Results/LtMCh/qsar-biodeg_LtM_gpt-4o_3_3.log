     df['Psi_i_A_SpMax_L_interaction'] = df['Psi_i_A'] * df['SpMax_L']
     df['Psi_i_A_SpMax_A_interaction'] = df['Psi_i_A'] * df['SpMax_A']
     

### 3. Aggregates
