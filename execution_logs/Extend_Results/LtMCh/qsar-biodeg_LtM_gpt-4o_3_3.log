# nO_ratio_nHM
# Ratio of the number of oxygen atoms (nO) to the number of heavy atoms (nHM).
# Usefulness: Highlights oxygen enrichment relative to molecular size, directly tied to oxidative biodegradation.
df['nO_ratio_nHM'] = df['nO'] / (df['nHM'] + 1e-6)
end

python
# nN_ratio_nHM
# Ratio of the number of nitrogen atoms (nN) to the number of heavy atoms (nHM).
# Usefulness: Reflects nitrogen functional groups normalized to molecular size, influencing nitrogen-specific biodegradability.
df['nN_ratio_nHM'] = df['nN'] / (df['nHM'] + 1e-6)
end

python
# C_percent_ratio_nHM
# Ratio of carbon percentage (C%) to the number of heavy atoms (nHM).
# Usefulness: Normalizes carbon content by molecular size for insights into hydrophobicity and molecular structure.
df['C_percent_ratio_nHM'] = df['C%'] / (df['nHM'] + 1e-6)
end

python
# mean_bond_frequency
# Average frequency of C-N and C-O bonds across topological distances (F02[C-N], F03[C-N], F03[C-O], F04[C-N]).
# Usefulness: Summarizes bond frequencies into a single metric to capture key structural influences on biodegradability.
df['mean_bond_frequency'] = (df['F02[C-N]'] + df['F03[C-N]'] + df['F03[C-O]'] + df['F04[C-N]']) / 4
end

python
# oxidation_reactivity
# Product of mean atomic Sanderson electronegativity (Me) and mean first ionization potential (Mi).
# Usefulness: Captures combined electronic effects on molecular oxidation and biodegradability potential.
df['oxidation_reactivity'] = df['Me'] * df['Mi']
end

python
# electronic_diff
# Difference between mean atomic Sanderson electronegativity (Me) and mean first ionization potential (Mi).
# Usefulness: Reflects electronic property interplay critical for understanding reactivity and biodegradation potential.
df['electronic_diff'] = df['Me'] - df['Mi']
end

python
# Psi_i_A_SpMax_L_interaction
# Product of intrinsic state pseudoconnectivity index type S average (Psi_i_A) and Laplace eigenvalue (SpMax_L).
# Usefulness: Links electronic connectivity and molecular structure compactness to assess biodegradability.
df['Psi_i_A_SpMax_L_interaction'] = df['Psi_i_A'] * df['SpMax_L']
end

python
# SpMax_L_SM6_L_ratio
# Ratio of Laplace eigenvalue (SpMax_L) to spectral moment order 6 (SM6_L).
# Usefulness: Balances molecular connectivity and compactness, directly influencing biodegradability predictions.
df['SpMax_L_SM6_L_ratio'] = df['SpMax_L'] / df['SM6_L']
end

python
# log_SdO
# Log-transformed sum of dO E-states (SdO).
# Usefulness: Reduces the skewness of SdO while emphasizing smaller values important for oxidation-related biodegradability.
df['log_SdO'] = np.log(df['SdO'] + 1e-6)
end

python
# sigmoid_TI2_L
# Sigmoid-transformed second Mohar index from Laplace matrix (TI2_L).
# Usefulness: Normalizes structural diversity indicators into a bounded range (0, 1), improving interpretability and model compatibility.
df['sigmoid_TI2_L'] = 1 / (1 + np.exp(-df['TI2_L']))
end

python
# bond_presence_sum
# Sum of bond-presence indicators for halogen bonds (B01[C-Br], B03[C-Cl], B04[C-Br]).
# Usefulness: Aggregates halogen bond indicators known for their stability and reduced biodegradability impact.
df['bond_presence_sum'] = df['B01[C-Br]'] + df['B03[C-Cl]'] + df['B04[C-Br]']
end

python
# halogen_presence_flag
# Binary flag indicating halogen presence based on nX > 0.
# Usefulness: Simplifies representation of halogen presence, aiding in analyzing its negative effect on biodegradability.
df['halogen_presence_flag'] = (df['nX'] > 0).astype(int)
end

python
df.drop(columns=['nN-N', 'nCRX3', 'N-073', 'B01[C-Br]', 'B04[C-Br]', 'SdssC'], inplace=True)
end
