# nO_ratio_nHM
# Proportion of oxygen to heavy atoms.
# Usefulness: Reflects the oxygen enrichment in relation to heavy atoms, which may indicate reactivity tied to biodegradability.
df['nO_ratio_nHM'] = df['nO'] / (df['nHM'] + 1e-6)
end

python
# nN_ratio_nHM
# Proportion of nitrogen to heavy atoms.
# Usefulness: Indicates nitrogen enrichment, which may reveal nitrogen-based functional groups that are key for biodegradation.
df['nN_ratio_nHM'] = df['nN'] / (df['nHM'] + 1e-6)
end

python
# mean_bond_frequency
# Average frequency of significant bond types related to biodegradability (C-N and C-O bonds).
# Usefulness: Aggregates bond frequencies into a simplified feature to represent overall bond abundance, aiding interpretability.
df['mean_bond_frequency'] = (df['F02[C-N]'] + df['F03[C-N]'] + df['F03[C-O]'] + df['F04[C-N]']) / 4
end

python
# electronegativity_diff
# Difference between mean atomic Sanderson electronegativity (Me) and the mean first ionization potential (Mi).
# Usefulness: Reflects a balance between electronegativity and ionization energy, indicative of the electronic properties' impact on biodegradation.
df['electronegativity_diff'] = df['Me'] - df['Mi']
end

python
# SdO_ratio_nO
# Ratio of the sum of dO E-states (SdO) to the number of oxygen atoms (nO).
# Usefulness: Measures the electronic state contribution of oxygen per atom, indicating oxygen-related electronegativity relevant to biodegradability.
df['SdO_ratio_nO'] = df['SdO'] / (df['nO'] + 1e-6)
end

python
# SpMax_L_SM6_L_ratio
# Ratio of leading eigenvalue from Laplace matrix (SpMax_L) to the spectral moment of order 6 from Laplace matrix (SM6_L).
# Usefulness: Captures structural characteristics like connectivity and molecular compactness that might influence biodegradation.
df['SpMax_L_SM6_L_ratio'] = df['SpMax_L'] / df['SM6_L']
end

python
# Psi_i_A_SpMax_L_interaction
# Product of intrinsic state pseudoconnectivity index type S average (Psi_i_A) and leading eigenvalue from Laplace matrix (SpMax_L).
# Usefulness: Highlights the interaction between connectivity and intrinsic pseudoconnectivity, which captures molecular interaction potential.
df['Psi_i_A_SpMax_L_interaction'] = df['Psi_i_A'] * df['SpMax_L']
end

python
# halogen_presence_flag
# Binary flag indicating the presence of any halogen atom (nX > 0).
# Usefulness: Provides a simple indicator of the presence of halogens, which might reduce biodegradability.
df['halogen_presence_flag'] = (df['nX'] > 0).astype(int)
end

python
# bond_presence_sum
# Sum of bond-presence flags for halogen bonds: B01[C-Br], B03[C-Cl], and B04[C-Br].
# Usefulness: Aggregates indicators for halogen bonds, which can exhibit biodegradation-resisting properties.
df['bond_presence_sum'] = df['B01[C-Br]'] + df['B03[C-Cl]'] + df['B04[C-Br]']
end

python
# log_SdO
# Log transformation of the sum of dO E-states (SdO).
# Usefulness: Reduces skewness of SdO and highlights smaller values, which may provide stronger signals for biodegradability in some models.
df['log_SdO'] = np.log(df['SdO'] + 1e-6)
end

python
# sigmoid_TI2_L
# Sigmoid transformation of the second Mohar index from Laplace matrix (TI2_L).
# Usefulness: Maps the values of TI2_L into a bounded range (0, 1), enhancing interpretability and suitability for logistic models.
df['sigmoid_TI2_L'] = 1 / (1 + np.exp(-df['TI2_L']))
end

