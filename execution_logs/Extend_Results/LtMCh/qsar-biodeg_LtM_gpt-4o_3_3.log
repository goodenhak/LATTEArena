# nO_ratio_nHM
# Ratio of the number of oxygen atoms (nO) to the number of heavy atoms (nHM).
# Usefulness: Highlights oxygen enrichment relevant to oxidative biodegradation reactions.
df['nO_ratio_nHM'] = df['nO'] / (df['nHM'] + 1e-6)
end

python
# nN_ratio_nHM
# Ratio of the number of nitrogen atoms (nN) to the number of heavy atoms (nHM).
# Usefulness: Reflects nitrogen functional groups relative to molecular size, impacting biodegradability.
df['nN_ratio_nHM'] = df['nN'] / (df['nHM'] + 1e-6)
end

python
# C_percent_ratio_nHM
# Ratio of carbon percentage (C%) to the number of heavy atoms (nHM).
# Usefulness: Normalizes carbon content by molecular size to provide insights into molecular structure and hydrophobicity.
df['C_percent_ratio_nHM'] = df['C%'] / (df['nHM'] + 1e-6)
end

python
# oxidation_reactivity
# Product of mean atomic Sanderson electronegativity (Me) and mean first ionization potential (Mi).
# Usefulness: Represents the combined effect of electronic properties on molecular oxidation and reactivity.
df['oxidation_reactivity'] = df['Me'] * df['Mi']
end

python
# electronic_diff
# Difference between mean atomic Sanderson electronegativity (Me) and mean first ionization potential (Mi).
# Usefulness: Analyzes the interplay between electronegativity and ionization potential, influencing breakdown potential.
df['electronic_diff'] = df['Me'] - df['Mi']
end

python
# mean_bond_frequency
# Average frequency of significant bond types across C-N and C-O bonds.
# Usefulness: Aggregates key bond types affecting biodegradability, summarizing their abundance in chemical structure.
df['mean_bond_frequency'] = (df['F02[C-N]'] + df['F03[C-N]'] + df['F03[C-O]'] + df['F04[C-N]']) / 4
end

python
# Psi_i_A_SpMax_L_interaction
# Product of intrinsic state pseudoconnectivity index type S average (Psi_i_A) and leading eigenvalue of Laplace matrix (SpMax_L).
# Usefulness: Captures an interaction metric between molecular electronic connectivity and structure related to biodegradability.
df['Psi_i_A_SpMax_L_interaction'] = df['Psi_i_A'] * df['SpMax_L']
end

python
# SpMax_L_SM6_L_ratio
# Ratio of leading eigenvalue from Laplace matrix (SpMax_L) to spectral moment of order 6 from Laplace matrix (SM6_L).
# Usefulness: Represents the relative connectivity to molecular compactness, influencing biodegradability.
df['SpMax_L_SM6_L_ratio'] = df['SpMax_L'] / df['SM6_L']
end

python
# log_SdO
# Log-transformed sum of dO E-states (SdO).
# Usefulness: Reduces skewness and emphasizes smaller values, highlighting oxidation-related contribution to biodegradability.
df['log_SdO'] = np.log(df['SdO'] + 1e-6)
end

python
# sigmoid_TI2_L
# Sigmoid transformation of the second Mohar index from Laplace matrix (TI2_L).
# Usefulness: Normalizes structural diversity index into a bounded range (0, 1), making it more interpretable and suitable for models.
df['sigmoid_TI2_L'] = 1 / (1 + np.exp(-df['TI2_L']))
end

python
# bond_presence_sum
# Sum of bond-presence indicators for halogen bonds (B01[C-Br], B03[C-Cl], B04[C-Br]).
# Usefulness: Aggregates indicators for stable bonds, typically associated with reduced biodegradability.
df['bond_presence_sum'] = df['B01[C-Br]'] + df['B03[C-Cl]'] + df['B04[C-Br]']
end

python
# halogen_presence_flag
# Binary flag indicating halogen presence based on the number of halogen atoms (nX > 0).
# Usefulness: Simplifies analysis of halogen impact, as halogens are correlated with reduced biodegradability.
df['halogen_presence_flag'] = (df['nX'] > 0).astype(int)
end

python
df.drop(columns=['nN-N', 'nCRX3', 'N-073', 'B01[C-Br]', 'B04[C-Br]', 'SdssC'], inplace=True)
end
