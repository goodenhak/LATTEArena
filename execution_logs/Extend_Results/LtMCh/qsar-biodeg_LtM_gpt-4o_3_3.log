# nO_ratio_nHM
# Ratio of the number of oxygen atoms (nO) to the number of heavy atoms (nHM).
# Usefulness: Highlights oxygen enrichment relative to molecular size, influencing oxidative biodegradation reactions.
df['nO_ratio_nHM'] = df['nO'] / (df['nHM'] + 1e-6)
end

python
# nN_ratio_nHM
# Ratio of the number of nitrogen atoms (nN) to the number of heavy atoms (nHM).
# Usefulness: Reflects nitrogen content in relation to molecular size, identifying nitrogen-containing functional groups influencing biodegradability.
df['nN_ratio_nHM'] = df['nN'] / (df['nHM'] + 1e-6)
end

python
# mean_bond_frequency
# Average frequency of significant biodegradability-related bonds (C-N and C-O).
# Usefulness: Aggregates the frequencies of relevant bonds (F02[C-N], F03[C-N], F03[C-O], F04[C-N]) into a single, interpretable feature.
df['mean_bond_frequency'] = (df['F02[C-N]'] + df['F03[C-N]'] + df['F03[C-O]'] + df['F04[C-N]']) / 4
end

python
# electronic_diff
# Difference between mean atomic Sanderson electronegativity (Me) and mean first ionization potential (Mi).
# Usefulness: Reflects the interplay between electronegativity and ionization potential, critical for understanding molecular reactivity.
df['electronic_diff'] = df['Me'] - df['Mi']
end

python
# oxidation_reactivity
# Product of mean atomic Sanderson electronegativity (Me) and mean first ionization potential (Mi).
# Usefulness: Highlights the combined impact of electronic properties influencing oxidation reactions associated with biodegradability.
df['oxidation_reactivity'] = df['Me'] * df['Mi']
end

python
# SpMax_L_SM6_L_ratio
# Ratio of leading eigenvalue from Laplace matrix (SpMax_L) to the spectral moment of order 6 from Laplace matrix (SM6_L).
# Usefulness: Represents the relative connectivity to molecular compactness, influencing biodegradability.
df['SpMax_L_SM6_L_ratio'] = df['SpMax_L'] / df['SM6_L']
end

python
# Psi_i_A_SpMax_L_interaction
# Product of intrinsic state pseudoconnectivity index type S average (Psi_i_A) and leading eigenvalue from Laplace matrix (SpMax_L).
# Usefulness: Highlights interactions between electronic connectivity and molecular structure, capturing biodegradation-relevant patterns.
df['Psi_i_A_SpMax_L_interaction'] = df['Psi_i_A'] * df['SpMax_L']
end

python
# bond_presence_sum
# Sum of bond-presence indicators for halogen bonds (B01[C-Br], B03[C-Cl], B04[C-Br]).
# Usefulness: Aggregates stable halogen-carbon bond indicators, which are typically associated with reduced biodegradability.
df['bond_presence_sum'] = df['B01[C-Br]'] + df['B03[C-Cl]'] + df['B04[C-Br]']
end

python
# halogen_presence_flag
# Binary flag indicating the presence of halogens based on the number of halogen atoms (nX > 0).
# Usefulness: Provides a single indicator for halogen presence, simplifying analysis of its negative effect on biodegradability.
df['halogen_presence_flag'] = (df['nX'] > 0).astype(int)
end

python
# log_SdO
# Log transformation of the sum of dO E-states (SdO).
# Usefulness: Reduces skewness and emphasizes smaller values, which may better capture oxidation-related contributions to biodegradability.
df['log_SdO'] = np.log(df['SdO'] + 1e-6)
end

python
# sigmoid_TI2_L
# Sigmoid transformation of the second Mohar index from Laplace matrix (TI2_L).
# Usefulness: Maps the index into a bounded range (0, 1), making it more interpretable and suitable for models requiring normalized features.
df['sigmoid_TI2_L'] = 1 / (1 + np.exp(-df['TI2_L']))
end

