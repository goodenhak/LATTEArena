[{'["# SpMax_L_ratio_SM6_L\\n# Ratio of leading eigenvalue from Laplace matrix (SpMax_L) to spectral moment order 6 from Laplace matrix (SM6_L).\\n# Usefulness: Represents the relative structural characteristics of the molecule, capturing variations in connectivity and compactness.\\ndf[\'SpMax_L_ratio_SM6_L\'] = df[\'SpMax_L\'] / df[\'SM6_L\']", "# J_Dz_e_ratio_SpPosA_B_p\\n# Ratio of Balaban-like index weighted by Sanderson electronegativity (J_Dz(e)) to normalized spectral positive sum by polarizability (SpPosA_B(p)).\\n# Usefulness: Relates electronegativity-based topological descriptors to polarizability and bonding in molecular structures.\\ndf[\'J_Dz_e_ratio_SpPosA_B_p\'] = df[\'J_Dz(e)\'] / df[\'SpPosA_B(p)\']", "# nN_fraction_nHM\\n# Ratio of the number of nitrogen atoms (nN) to the number of heavy atoms (nHM).\\n# Usefulness: Indicates the relative nitrogen content in the molecular structure, which can influence biodegradability.\\ndf[\'nN_fraction_nHM\'] = df[\'nN\'] / (df[\'nHM\'] + 1e-6)", "# nO_fraction_nHM\\n# Ratio of the number of oxygen atoms (nO) to the number of heavy atoms (nHM).\\n# Usefulness: Reflects the oxygen enrichment in relation to heavy atoms, important for understanding biodegradation potential.\\ndf[\'nO_fraction_nHM\'] = df[\'nO\'] / (df[\'nHM\'] + 1e-6)", "# bond_presence_sum\\n# Sum of bond-presence indicators for B01[C-Br], B03[C-Cl], and B04[C-Br].\\n# Usefulness: Aggregates halogen bond-related features that could negatively impact biodegradability by indicating the presence of stable halogen bonds.\\ndf[\'bond_presence_sum\'] = df[\'B01[C-Br]\'] + df[\'B03[C-Cl]\'] + df[\'B04[C-Br]\']", "# electronic_diff\\n# Difference between mean atomic Sanderson electronegativity (Me) and mean first ionization potential (Mi).\\n# Usefulness: Captures the interplay between electronegativity and ionization potential, which could impact chemical reactivity.\\ndf[\'electronic_diff\'] = df[\'Me\'] - df[\'Mi\']", "# interaction_index_Psi_SpMax\\