x (SpMax_L).\n# Usefulness: Identifies interactions between electronic connectivity and molecular structure, helping assess biodegradability.\ndf['Psi_i_A_SpMax_L_interaction'] = df['Psi_i_A'] * df['SpMax_L']", "# SpMax_L_SM6_L_ratio\n# Ratio of leading eigenvalue from Laplace matrix (SpMax_L) to spectral moment of order 6 from Laplace matrix (SM6_L).\n# Usefulness: Quantifies molecular connectivity relative to compactness, both factors determining biodegradability.\ndf['SpMax_L_SM6_L_ratio'] = df['SpMax_L'] / df['SM6_L']", "# bond_presence_sum\n# Sum of bond-presence indicators for halogen bonds (B01[C-Br], B03[C-Cl], B04[C-Br]).\n# Usefulness: Aggregates indicators for halogen bond presence, which are associated with reduced biodegradability.\ndf['bond_presence_sum'] = df['B01[C-Br]'] + df['B03[C-Cl]'] + df['B04[C-Br]']", "# halogen_presence_flag\n# Binary flag indicating halogen presence based on the number of halogen atoms (nX > 0).\n# Usefulness: Provides a single indicator for halogen presence, simplifying the analysis of halogen impact on biodegradability.\ndf['halogen_presence_flag'] = (df['nX'] > 0).astype(int)", "# log_SdO\n# Log-transformed sum of dO E-states (SdO).\n# Usefulness: Reduces skewness and highlights smaller values of SdO, better capturing features related to oxidative degradation.\ndf['log_SdO'] = np.log(df['SdO'] + 1e-6)", "# sigmoid_TI2_L\n# Sigmoid transformation of the second Mohar index from Laplace matrix (TI2_L).\n# Usefulness: Maps structural diversity into a bounded range (0, 1), making it more interpretable and model-compliant.\ndf['sigmoid_TI2_L'] = 1 / (1 + np.exp(-df['TI2_L']))", "df.drop(columns=['nN-N', 'nCRX3', 'N-073', 'B01[C-Br]', 'B04[C-Br]', 'SdssC'], inplace=True)"]
