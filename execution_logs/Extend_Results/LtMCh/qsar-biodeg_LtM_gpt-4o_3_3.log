# SpMax_L_ratio_SM6_L
# Ratio of leading eigenvalue from Laplace matrix (SpMax_L) to spectral moment order 6 from Laplace matrix (SM6_L).
# Usefulness: Represents the relative structural characteristics of the molecule, capturing variations in connectivity and compactness.
df['SpMax_L_ratio_SM6_L'] = df['SpMax_L'] / df['SM6_L']
end

python
# J_Dz_e_ratio_SpPosA_B_p
# Ratio of Balaban-like index weighted by Sanderson electronegativity (J_Dz(e)) to normalized spectral positive sum by polarizability (SpPosA_B(p)).
# Usefulness: Relates electronegativity-based topological descriptors to polarizability and bonding in molecular structures.
df['J_Dz_e_ratio_SpPosA_B_p'] = df['J_Dz(e)'] / df['SpPosA_B(p)']
end

python
# nN_fraction_nHM
# Ratio of the number of nitrogen atoms (nN) to the number of heavy atoms (nHM).
# Usefulness: Indicates the relative nitrogen content in the molecular structure, which can influence biodegradability.
df['nN_fraction_nHM'] = df['nN'] / (df['nHM'] + 1e-6)
end

python
# nO_fraction_nHM
# Ratio of the number of oxygen atoms (nO) to the number of heavy atoms (nHM).
# Usefulness: Reflects the oxygen enrichment in relation to heavy atoms, important for understanding biodegradation potential.
df['nO_fraction_nHM'] = df['nO'] / (df['nHM'] + 1e-6)
end

python
# bond_presence_sum
# Sum of bond-presence indicators for B01[C-Br], B03[C-Cl], and B04[C-Br].
# Usefulness: Aggregates halogen bond-related features that could negatively impact biodegradability by indicating the presence of stable halogen bonds.
df['bond_presence_sum'] = df['B01[C-Br]'] + df['B03[C-Cl]'] + df['B04[C-Br]']
end

python
# electronic_diff
# Difference between mean atomic Sanderson electronegativity (Me) and mean first ionization potential (Mi).
# Usefulness: Captures the interplay between electronegativity and ionization potential, which could impact chemical reactivity.
df['electronic_diff'] = df['Me'] - df['Mi']
end

python
# interaction_index_Psi_SpMax
# Product of intrinsic state pseudoconnectivity index type S average (Psi_i_A) and leading eigenvalue from adjacency matrix (SpMax_A).
# Usefulness: Combines connectivity and intrinsic electronic structure indices to represent interaction potential.
df['interaction_index_Psi_SpMax'] = df['Psi_i_A'] * df['SpMax_A']
end

python
# mean_bond_frequency
# Mean frequency of C-N and C-O bonds across topological distances (F02[C-N], F03[C-N], F03[C-O], F04[C-N]).
# Usefulness: Provides a summarized perspective on the frequency of key bond types, which can influence biodegradability.
df['mean_bond_frequency'] = (df['F02[C-N]'] + df['F03[C-N]'] + df['F03[C-O]'] + df['F04[C-N]']) / 4
end

python
# SdO_norm_nHM
# Normalized sum of dO E-states (SdO) by division with the number of heavy atoms (nHM).
# Usefulness: Represents the spatial and electronic distribution of oxygen relative to the molecular size.
df['SdO_norm_nHM'] = df['SdO'] / (df['nHM'] + 1e-6)
end

python
# halogen_presence_flag
# Binary flag indicating the presence of any halogen atom based on nX > 0.
# Usefulness: Provides a single indicator for the presence of halogens, linked to lower biodegradability.
df['halogen_presence_flag'] = (df['nX'] > 0).astype(int)
end

