# nO_ratio_nHM
# Ratio of oxygen atoms to heavy atoms.
# Usefulness: Reflects oxygen enrichment relative to heavy atoms, which is important for oxidative biodegradation.
df['nO_ratio_nHM'] = df['nO'] / (df['nHM'] + 1e-6)
end

python
# nN_ratio_nHM
# Ratio of nitrogen atoms to heavy atoms.
# Usefulness: Indicates the nitrogen contribution relative to molecular size, highlighting key nitrogen-containing functional groups that aid in biodegradability.
df['nN_ratio_nHM'] = df['nN'] / (df['nHM'] + 1e-6)
end

python
# C_percent_ratio_nHM
# Ratio of carbon percentage to heavy atoms.
# Usefulness: Normalizes carbon composition by molecular size to better understand the hydrophobicity and molecular structure.
df['C_percent_ratio_nHM'] = df['C%'] / (df['nHM'] + 1e-6)
end

python
# oxidation_reactivity
# Product of mean atomic Sanderson electronegativity (Me) and mean first ionization potential (Mi).
# Usefulness: Captures the balance of electronic properties that impact molecular reactivity and biodegradability.
df['oxidation_reactivity'] = df['Me'] * df['Mi']
end

python
# SdO_norm_nO
# Normalized sum of dO E-states by number of oxygen atoms.
# Usefulness: Represents the spatial and electronic influence of oxygen per atom, relevant for oxidative degradation indicators.
df['SdO_norm_nO'] = df['SdO'] / (df['nO'] + 1e-6)
end

python
# electronic_diff
# Difference between mean atomic Sanderson electronegativity (Me) and mean first ionization potential (Mi).
# Usefulness: Reflects the interplay between electronegativity and ionization potential, critical for understanding molecular reactivity.
df['electronic_diff'] = df['Me'] - df['Mi']
end

python
# mean_bond_frequency
# Average frequency of significant bond types related to biodegradability (C-N and C-O).
# Usefulness: Summarizes the abundance of key bond types influencing biodegradability into a single feature.
df['mean_bond_frequency'] = (df['F02[C-N]'] + df['F03[C-N]'] + df['F03[C-O]'] + df['F04[C-N]']) / 4
end

python
# log_SdO
# Log transformation of the sum of dO E-states (SdO).
# Usefulness: Reduces skewness of SdO and highlights smaller values, important for capturing oxidation-related contributions to biodegradability.
df['log_SdO'] = np.log(df['SdO'] + 1e-6)
end

python
# sigmoid_TI2_L
# Sigmoid transformation of the second Mohar index from Laplace matrix (TI2_L).
# Usefulness: Maps TI2_L into a bounded range (0, 1), enhancing feature interpretation and suitability for logistic models.
df['sigmoid_TI2_L'] = 1 / (1 + np.exp(-df['TI2_L']))
end

python
# halogen_presence_flag
# Binary flag indicating the presence of any halogen atom based on nX > 0.
# Usefulness: Single indicator for halogen presence, as halogens are typically associated with reduced biodegradability.
df['halogen_presence_flag'] = (df['nX'] > 0).astype(int)
end

python
# bond_presence_sum
# Sum of bond-presence flags for halogen bonds: B01[C-Br], B03[C-Cl], and B04[C-Br].
# Usefulness: Aggregates indicators for halogen bonds, which can protect against biodegradation due to stable halogen-carbon bonds.
df['bond_presence_sum'] = df['B01[C-Br]'] + df['B03[C-Cl]'] + df['B04[C-Br]']
end

python
df.drop(columns=['nN-N', 'nCRX3', 'N-073', 'B01[C-Br]', 'B04[C-Br]', 'SdssC'], inplace=True)
end
