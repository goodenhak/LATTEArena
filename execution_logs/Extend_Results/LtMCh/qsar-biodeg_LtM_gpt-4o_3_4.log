# feature_C_O_ratio
# Ratio of total carbon atoms to oxygen atoms, capturing the balance between carbon-heavy and oxygen-heavy components.
# Usefulness: Biodegradability can depend on the carbon-to-oxygen ratio, as oxygenation often facilitates biodegradation.
df['feature_C_O_ratio'] = df['C%'] / (df['nO'] + 1)
end

python
# feature_N_O_ratio
# Ratio of nitrogen atoms to oxygen atoms representing nitrogen-heavy vs. oxygen-heavy molecular fragments.
# Usefulness: This metric captures how nitrogen versus oxygen influences compound stability and reactivity, directly affecting biodegradability.
df['feature_N_O_ratio'] = df['nN'] / (df['nO'] + 1)
end

python
# feature_bond_freq_distance_diff
# Difference in bonding frequencies at different topological distances for C-N bonds.
# Usefulness: Identifies structural complexity and how bonding patterns influence molecule stability over spatial configurations.
df['feature_bond_freq_distance_diff'] = df['F04[C-N]'] - df['F02[C-N]']
end

python
# feature_SdO_transformed
# Square-root-transformed sum of dO E-states to handle skewness and emphasize meaningful variabilities in oxygen states.
# Usefulness: Normalized representation of oxygen's electronic state impact, a factor critical in oxidation-linked biodegradability.
df['feature_SdO_transformed'] = np.sqrt(df['SdO'])
end

python
# feature_hyper_spectral_interaction
# Product of Hyper-Wiener-like index and spectral moment of order 6 to capture higher-order structural features.
# Usefulness: Strengthens insights into global and higher-order molecular structural contributions to biodegradability.
df['feature_hyper_spectral_interaction'] = df['HyWi_B(m)'] * df['SM6_L']
end

python
# feature_centricity_eigenvalue_interaction
# Interaction between Laplace matrix eigenvalue and lopping centric index, combining global structure with centricity features.
# Usefulness: Highlights how molecular connectivity and loops contribute to structural stability, crucial for predicting biodegradability.
df['feature_centricity_eigenvalue_interaction'] = df['SpMax_L'] * df['LOC']
end

python
# feature_log_C_percentage
# Log-transformed percentage of carbon atoms to stabilize skewed representations.
# Usefulness: Highlights biodegradable potential by normalizing carbon composition, a central element in organic molecules.
df['feature_log_C_percentage'] = np.log(df['C%'] + 1)
end

python
# feature_ready_biodegradable_indicator
