n by zero.\n# Usefulness: Reflects the balance between nitrogen-heavy and oxygen-heavy components, which can influence biodegradability.\ndf['feature_N_O_ratio'] = df['nN'] / (df['nO'] + 1)", "# feature_bonding_diversity\n# Aggregate bonding frequencies across varying topological distances (F03[C-O], F02[C-N], F04[C-N]).\n# Usefulness: Measures the overall diversity of bonding patterns, reflecting molecular connectivity and structural complexity.\ndf['feature_bonding_diversity'] = df['F03[C-O]'] + df['F02[C-N]'] + df['F04[C-N]']", "# feature_log_C_percentage\n# Log-transformed percentage of Carbon atoms (C%).\n# Usefulness: Normalizes skewed distribution of carbon content, relevant since carbon proportion impacts biodegradability.\ndf['feature_log_C_percentage'] = np.log(df['C%'] + 1)", "# feature_ready_biodegradable_indicator\n# Binary indicator for potential ready biodegradability based on thresholds: Laplace index (TI2_L), Carbon percentage (C%), and oxygen atoms (nO).\n# Usefulness: Encodes a heuristic rule to predict ready biodegradability using key molecular properties.\ndf['feature_ready_biodegradable_indicator'] = (\n    (df['TI2_L'] > 2.5) & \n    (df['C%'] > 40) & \n    (df['nO'] > 2)\n).astype(int)", "df.drop(columns=[\n    'nHM',  # Mostly zero with Q1, Median, and Q3 all 0.0, not expected to provide significant new signal.\n    'F01[N-N]',  # Extremely low mean, no variance across the majority of observations.\n    'NssssC',  # Low mean and minimal presence, implying limited significance.\n    'B01[C-Br]',  # Binary and extremely sparse, with a mean close to 0.\n    'B03[C-Cl]',  # Binary and sparse, low contribution to biodegradability insights.\n    'B04[C-Br]',  # Binary and sparse, not expected to significantly impact predictions.\n    'nN-N',  # Extremely sparse feature, majority are 0.\n    'nCRX3',  # Low and sparse counts, not statistically meaningful for degradability tasks.\n    'nArCOOR',  # Sparse feature across dataset, not adding significa