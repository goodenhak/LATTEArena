2026-05-25 10:33:04,325 - INFO - ops_string = ["# feature_SpMaxL_LOC_interaction\n# Interaction between Laplace matrix eigenvalue (SpMax_L) and lopping centric index (LOC).\n# Usefulness: Highlights the contribution of molecular connectivity and loops to the molecule's stability, influencing biodegradability.\ndf['feature_SpMaxL_LOC_interaction'] = df['SpMax_L'] * df['LOC']", "# feature_SdO_F03CO_interaction\n# Interaction between oxygen electronic states (SdO) and the frequency of C-O bonds at topological distance 3 (F03[C-O]).\n# Usefulness: Captures how oxygen's electronic states influence bonding patterns, critical for oxidation-based biodegradability.\ndf['feature_SdO_F03CO_interaction'] = df['SdO'] * df['F03[C-O]']", "# feature_C_O_ratio\n# Ratio of total carbon atoms (C%) to oxygen atoms (nO), adjusted to avoid division by zero.\n# Usefulness: Represents the balance between carbon and oxygen content, which is a key factor in biodegradability, as higher oxygenation tends to facilitate decomposition.\ndf['feature_C_O_ratio'] = df['C%'] / (df['nO'] + 1)", "# feature_SdO_transformed\n# Square-root transformation of the sum of dO E-states (SdO).\n# Usefulness: Normalizes the representation of oxygen's electronic state impact, a factor critical in oxidation-linked biodegradability.\ndf['feature_SdO_transformed'] = np.sqrt(df['SdO'])", "# feature_hyper_spectral_interaction\n# Product of the Hyper-Wiener-like index (HyWi_B(m)) and spectral moment of order 6 (SM6_L).\n# Usefulness: Captures higher-order structural patterns that influence global stability and contribute to biodegradability.\ndf['feature_hyper_spectral_interaction'] = df['HyWi_B(m)'] * df['SM6_L']", "# feature_aromatic_aliphatic_ratio\n# Ratio of aromatic carbons (nCb-) to primary aliphatic carbons (nCp), adjusted to avoid division by zero.\n# Usefulness: Differentiates aromatic vs. aliphatic compositions, as these degrade differently under biological processes.\ndf['feature_aromatic_aliphatic_ratio'] = df['nCb-'] / (df['nCp'] + 1)", "# feature_N_O_ratio\n# Ratio of nitrogen atoms (nN) to oxygen atoms (nO), adjusted to avoid division by zero.\n# Usefulness: Provides insight into the balance between nitrogen-heavy and oxygen-heavy molecular components, influencing biodegradation behavior.\ndf['feature_N_O_ratio'] = df['nN'] / (df['nO'] + 1)", "# feature_bonding_diversity\n# Aggregate bonding frequencies across varying topological distances (F03[C-O], F02[C-N], F04[C-N]).\n# Usefulness: Measures overall diversity in bonding patterns, reflecting molecular connectivity and complexity, which are important for biodegradability.\ndf['feature_bonding_diversity'] = df['F03[C-O]'] + df['F02[C-N]'] + df['F04[C-N]']", "# feature_log_C_percentage\n# Log-transformed percentage of carbon atoms (C%).\n# Usefulness: Normalizes skewed carbon content to better represent its contribution to the molecule's structural properties and biodegradability.\ndf['feature_log_C_percentage'] = np.log(df['C%'] + 1)", "# feature_ready_biodegradable_indicator\n# Binary indicator for potential ready biodegradability based on thresholds for Laplace index (TI2_L), Carbon percentage (C%), and oxygen atoms (nO).\n# Usefulness: Encodes a heuristic rule to classify ready biodegradability based on known molecular property thresholds.\ndf['feature_ready_biodegradable_indicator'] = (\n    (df['TI2_L'] > 2.5) &\n    (df['C%'] > 40) &\n    (df['nO'] > 2)\n).astype(int)", "# feature_log_TI2L\n# Log-transformed second Mohar index from Laplace matrix (TI2_L).\n# Usefulness: Stabilizes and improves interpretability of TI2_L's contributions to molecular structure and biodegradability.\ndf['feature_log_TI2L'] = np.log(df['TI2_L'] + 1)", "# feature_electronic_bonding\n# Interaction between electronic stability (SdssC) and bonding diversity (feature_bonding_diversity).\n# Usefulness: Integrates molecular flexibility and connectivity, highlighting how they influence biodegradability.\ndf['feature_electronic_bonding'] = df['SdssC'] * df['feature_bonding_diversity']", "# feature_exp_SpMaxA\n# Exponential transformation of adjacency matrix eigenvalue (SpMax_A).\n# Usefulness: Emphasizes contributions from highly reactive molecular configurations, relevant for predicting biodegradability.\ndf['feature_exp_SpMaxA'] = np.exp(df['SpMax_A'])", "# feature_SdO_Me_ratio\n# Ratio of oxygen electronic states (SdO) to mean Sanderson electronegativity (Me).\n# Usefulness: Highlights interactions between oxygen's state and overall electronegativity, indicative of oxidation-reduction activity influencing biodegradability.\ndf['feature_SdO_Me_ratio'] = df['SdO'] / (df['Me'] + 1)", "# feature_oxygen_bond_aggregate\n# Aggregate measure of oxygen and bonding interactions: sum of SdO, F03[C-O], and F02[C-N].\n# Usefulness: Quantifies oxygen-centric bonding interactions, reflecting their role in molecule breakdown and biodegradability.\ndf['feature_oxygen_bond_aggregate'] = df['SdO'] + df['F03[C-O]'] + df['F02[C-N]']", "# feature_sqrt_SM6_L\n# Square-root transformation of the spectral moment of order 6 (SM6_L).\n# Usefulness: Normalizes variability in structural patterns, refining its contributions to stability and biodegradability assessments.\ndf['feature_sqrt_SM6_L'] = np.sqrt(df['SM6_L'])", "df.drop(columns=[\n    'nHM',  # Mostly zero with Q1, Median, and Q3 all 0.0, not expected to provide significant new signal.\n    'F01[N-N]',  # Extremely low mean, no variance across the majority of observations.\n    'NssssC',  # Low mean and minimal significance.\n    'B01[C-Br]',  # Sparse binary feature with low relevance.\n    'B03[C-Cl]',  # Sparse binary feature, providing minimal predictive value.\n    'B04[C-Br]',  # Sparse binary feature, not expected to significantly contribute to predictors.\n    'nN-N',  # Sparse feature containing mostly zeros.\n    'nCRX3',  # Sparse feature not statistically meaningful.\n    'nArCOOR',  # Sparse and offers minimal distinct information.\n    'Psi_i_1d'  # Near