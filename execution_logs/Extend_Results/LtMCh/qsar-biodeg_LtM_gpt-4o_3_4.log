# Interaction between Laplace matrix eigenvalue (SpMax_L) and lopping centric index (LOC).
# Usefulness: Highlights how molecular connectivity and loops contribute to molecule stability, influencing biodegradability.
df['feature_SpMaxL_LOC_interaction'] = df['SpMax_L'] * df['LOC']
end

python
# feature_SdO_F03CO_interaction
# Interaction between sum of dO E-states (SdO) and frequency of C-O bonds at topological distance 3 (F03[C-O]).
# Usefulness: Captures how oxygen electronic states influence bonding patterns, critical for oxidation-based biodegradability.
df['feature_SdO_F03CO_interaction'] = df['SdO'] * df['F03[C-O]']
end

python
# feature_C_O_ratio
# Ratio of total carbon atoms (C%) to oxygen atoms (nO), adjusted to avoid division by zero.
# Usefulness: Biodegradability can depend on the carbon-to-oxygen ratio, as oxygenation often facilitates biodegradation.
df['feature_C_O_ratio'] = df['C%'] / (df['nO'] + 1)
end

python
# feature_SdO_transformed
# Square-root-transformed sum of dO E-states (SdO).
# Usefulness: Normalizes representation of oxygen's electronic state impact, a critical factor in oxidation-linked biodegradability.
df['feature_SdO_transformed'] = np.sqrt(df['SdO'])
end

python
# feature_hyper_spectral_interaction
# Product of Hyper-Wiener-like index (HyWi_B(m)) and spectral moment of order 6 (SM6_L).
# Usefulness: Captures higher-order structural patterns influencing global stability and contributions to biodegradability.
df['feature_hyper_spectral_interaction'] = df['HyWi_B(m)'] * df['SM6_L']
end

python
# feature_aromatic_aliphatic_ratio
# Ratio of aromatic carbons (nCb-) to primary aliphatic carbons (nCp).
# Usefulness: Differentiates aromatic vs. aliphatic compositions, as they degrade differently in biological contexts.
df['feature_aromatic_aliphatic_ratio'] = df['nCb-'] / (df['nCp'] + 1)
end

python
# feature_N_O_ratio
# Ratio of nitrogen atoms (nN) to oxygen atoms (nO), adjusted to avoid division by zero.
# Usefulness: Reflects the balance between nitrogen-heavy and oxygen-heavy components, which can influence biodegradability.
df['feature_N_O_ratio'] = df['nN'] / (df['nO'] + 1)
end

python
# feature_bonding_diversity
# Aggregate bonding frequencies across varying topological distances (F03[C-O], F02[C-N], F04[C-N]).
# Usefulness: Measures the overall diversity of bonding patterns, reflecting molecular connectivity and structural complexity.
df['feature_bonding_diversity'] = df['F03[C-O]'] + df['F02[C-N]'] + df['F04[C-N]']
end

python
# feature_log_C_percentage
# Log-transformed percentage of Carbon atoms (C%).
# Usefulness: Normalizes skewed distribution of carbon content, relevant since carbon proportion impacts biodegradability.
df['feature_log_C_percentage'] = np.log(df['C%'] + 1)
end

python
# feature_ready_biodegradable_indicator
# Binary indicator for potential ready biodegradability based on thresholds: Laplace index (TI2_L), Carbon percentage (C%), and oxygen atoms (nO).
# Usefulness: Encodes a heuristic rule to predict ready biodegradability using key molecular properties.
df['feature_ready_biodegradable_indicator'] = (
    (df['TI2_L'] > 2.5) & 
    (df['C%'] > 40) & 
    (df['nO'] > 2)
).astype(int)
end

