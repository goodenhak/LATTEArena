# feature_SpMaxL_LOC_interaction
# Interaction between Laplace matrix eigenvalue (SpMax_L) and lopping centric index (LOC).
# Usefulness: Highlights molecular connectivity and loops contribution to molecule stability and biodegradability.
df['feature_SpMaxL_LOC_interaction'] = df['SpMax_L'] * df['LOC']
end

python
# feature_SdO_F03CO_interaction
# Interaction between sum of dO E-states (SdO) and frequency of C-O bonds at topological distance 3 (F03[C-O]).
# Usefulness: Captures the influence of oxygen's electronic states on bond formation, critical for oxidation-based biodegradability.
df['feature_SdO_F03CO_interaction'] = df['SdO'] * df['F03[C-O]']
end

python
# feature_C_O_ratio
# Ratio of total carbon atoms (C%) to oxygen atoms (nO), adjusted to avoid division by zero.
# Usefulness: Indicates the balance of carbon and oxygen, influencing oxidation and biodegradation pathways.
df['feature_C_O_ratio'] = df['C%'] / (df['nO'] + 1)
end

python
# feature_SdO_transformed
# Square-root transformation of the sum of dO E-states (SdO).
# Usefulness: Normalizes variability in oxygen electronic states, enhancing representation of oxidation-related patterns.
df['feature_SdO_transformed'] = np.sqrt(df['SdO'])
end

python
# feature_hyper_spectral_interaction
# Product of Hyper-Wiener-like index (HyWi_B(m)) and spectral moment of order 6 (SM6_L).
# Usefulness: Captures structural patterns reflecting molecular stability and biodegradability.
df['feature_hyper_spectral_interaction'] = df['HyWi_B(m)'] * df['SM6_L']
end

python
# feature_aromatic_aliphatic_ratio
# Ratio of aromatic carbons (nCb-) to primary aliphatic carbons (nCp), adjusted to avoid division by zero.
# Usefulness: Differentiates aromatic versus aliphatic compositions, relevant due to different degradation pathways.
df['feature_aromatic_aliphatic_ratio'] = df['nCb-'] / (df['nCp'] + 1)
end

python
# feature_N_O_ratio
# Ratio of nitrogen atoms (nN) to oxygen atoms (nO), adjusted to avoid division by zero.
# Usefulness: Highlights the balance between nitrogen-heavy and oxygen-heavy compounds, affecting biodegradation.
df['feature_N_O_ratio'] = df['nN'] / (df['nO'] + 1)
end

python
# feature_bonding_diversity
# Aggregate bonding frequency across varying topological distances (F03[C-O], F02[C-N], F04[C-N]).
# Usefulness: Measures overall diversity in bonding patterns, providing insights into molecular connectivity.
df['feature_bonding_diversity'] = df['F03[C-O]'] + df['F02[C-N]'] + df['F04[C-N]']
end

python
# feature_log_C_percentage
# Log-transformed percentage of Carbon atoms (C%).
# Usefulness: Normalized representation of carbon content, a key determinant of biodegradability.
df['feature_log_C_percentage'] = np.log(df['C%'] + 1)
end

python
# feature_log_TI2L
# Log-transformed second Mohar index from Laplace matrix (TI2_L).
# Usefulness: Stabilizes structural complexity representation, emphasizing non-linear relationships to biodegradability.
df['feature_log_TI2L'] = np.log(df['TI2_L'] + 1)
end

python
# feature_electronic_bonding
# Interaction between electronic stability (SdssC) and bonding diversity (feature_bonding_diversity).
# Usefulness: Captures molecular dynamics influenced by electronic stability and structural diversity for biodegradability insights.
df['feature_electronic_bonding'] = df['SdssC'] + (df['Me'] * df['feature_bonding_diversity'])
end

python
# feature_exp_SpMaxA
# Exponential transformation of adjacency matrix eigenvalue (SpMax_A).
# Usefulness: Emphasizes reactive molecular configurations, relevant for predicting reactivity-driven biodegradability.
df['feature_exp_SpMaxA'] = np.exp(df['SpMax_A'])
end

python
# feature_ready_biodegradable_indicator
# Binary indicator for potential ready biodegradability based on thresholds for Laplace index, Carbon percentage, and oxygen atoms.
# Usefulness: Encodes a heuristic rule using key attributes to aid in biodegradability classification.
df['feature_ready_biodegradable_indicator'] = (
    (df['TI2_L'] > 2.5) & 
    (df['C%'] > 40) & 
    (df['nO'] > 2)
).astype(int)
end

