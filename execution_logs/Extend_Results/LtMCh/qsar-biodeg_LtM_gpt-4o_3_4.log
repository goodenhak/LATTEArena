ilities in oxygen states.\n# Usefulness: Normalized representation of oxygen's electronic state impact, a factor critical in oxidation-linked biodegradability.\n\ndf['feature_SdO_transformed'] = np.sqrt(df['SdO'])", "# feature_hyper_spectral_interaction\n# Product of Hyper-Wiener-like index and spectral moment of order 6 to capture higher-order structural features.\n# Usefulness: Strengthens insights into global and higher-order molecular structural contributions to biodegradability.\n\ndf['feature_hyper_spectral_interaction'] = df['HyWi_B(m)'] * df['SM6_L']", "# feature_log_C_percentage\n# Log-transformed percentage of carbon atoms to stabilize skewed representations.\n# Usefulness: Highlights biodegradable potential by normalizing carbon composition, a central element in organic molecules.\n\ndf['feature_log_C_percentage'] = np.log(df['C%'] + 1)", "# feature_ready_biodegradable_indicator\n# Binary indicator for potential ready biodegradability based on thresholds for Laplace index, C%, and nO.\n# Usefulness: Encodes a first-order heuristic to predict ready biodegradability based on key molecular thresholds.\n\ndf['feature_ready_biodegradable_indicator'] = (\n    (df['TI2_L'] > 2.5) & \n    (df['C%'] > 40) & \n    (df['nO'] > 2)\n).astype(int)", "# Columns to be dropped due to low variance or low direct relevance to biodegradability processes\ndf.drop(columns=[\n    'nHM',  # Mostly zero with Q1, Median, and Q3 all 0.0, not expected to provide significant new signal.\n    'F01[N-N]',  # Extremely low mean, no variance across majority of observations.\n    'NssssC',  # Low mean and minimal presence, implying limited significance.\n    'B01[C-Br]',  # Binary and extremely sparse, with mean close to 0.\n    'B03[C-Cl]',  # Binary and sparse, low contribution to biodegradability insights.\n    'B04[C-Br]',  # Binary and sparse, not expected to significantly impact predictions.\n    'nN-N',  # Extremely sparse feature, majority are 0.\n    'nCRX3',  # Low and sparse cou