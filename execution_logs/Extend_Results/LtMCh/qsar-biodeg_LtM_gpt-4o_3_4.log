[{'["# feature_SdO_LOC_interaction\\n# Interaction between sum of dO E-states (SdO) and lopping centric index (LOC).\\n# Usefulness: Captures oxygen-based electronic effects combined with molecular loops and centricity, influencing biodegradation.\\ndf[\'feature_SdO_LOC_interaction\'] = df[\'SdO\'] * df[\'LOC\']", "# feature_bonding_SpMaxL_interaction\\n# Interaction between bonding frequency diversity (feature_bonding_diversity) and Laplace eigenvalue (SpMax_L).\\n# Usefulness: Reflects how molecular connectivity couples with bonding diversity to impact biodegradation processes.\\ndf[\'feature_bonding_SpMaxL_interaction\'] = df[\'feature_bonding_diversity\'] * df[\'SpMax_L\']", "# feature_SdO_Me_ratio\\n# Ratio of oxygen electronic states (SdO) to mean atomic Sanderson electronegativity (Me).\\n# Usefulness: Reveals how oxygen\'s electronic states balance with molecular electronegativity, aiding prediction of oxidation-based degradation.\\ndf[\'feature_SdO_Me_ratio\'] = df[\'SdO\'] / (df[\'Me\'] + 1)", "# feature_sqrt_SM6_L\\n# Square-root-transformed spectral moment of order 6 (SM6_L).\\n# Usefulness: Normalizes variability in structural patterns, refining contributions of higher-order moments to molecule stability assessments.\\ndf[\'feature_sqrt_SM6_L\'] = np.sqrt(df[\'SM6_L\'])", "# feature_oxygen_bond_aggregate\\n# Aggregate measure of oxygen and bonding interactions: sum of SdO, F03[C-O], and F02[C-N].\\n# Usefulness: Quantifies oxygen-centric bonding and their roles in driving biodegradation via diverse molecular interactions.\\ndf[\'feature_oxygen_bond_aggregate\'] = df[\'SdO\'] + df[\'F03[C-O]\'] + df[\'F02[C-N]\']", "# feature_log_F03CO\\n# Log-transformed frequency of C-O bonds at topological distance 3 (F03[C-O]).\\n# Usefulness: Stabilizes skewness in bonding distribution, improving interpretability of oxidative bond contributions to degradation.\\ndf[\'feature_log_F03CO\'] = np.log(df[\'F03[C-O]\'] + 1)", "# feature_log_TI2L\\n# Log-transformed second