python
# Age_zscore
# Feature description: Z-score transformation of Age for standardization.
# Usefulness: Makes Age comparable to other features by normalizing it.
df['Age_zscore'] = (df['Age'] - df['Age'].mean()) / df['Age'].std()
end

python
# Income_log
# Feature description: Log transformation of Income to capture nonlinear contribution.
# Usefulness: Models relationship between income levels and success rates, especially diminishing impacts at higher incomes.
df['Income_log'] = np.log1p(df['Income'])
end

python
# Debt_income_ratio
# Feature description: The ratio of Debt to Income.
# Usefulness: Measures financial health by directly comparing obligations to earnings.
df['Debt_income_ratio'] = df['Debt'] / (df['Income'] + 1e-6)
end

python
# CreditScore_log
# Feature description: Log transformation of CreditScore.
# Usefulness: Captures nonlinear effects in the relationship between creditworthiness and application success.
df['CreditScore_log'] = np.log1p(df['CreditScore'])
end

python
# CreditScore_zscore
# Feature description: Z-score normalization of CreditScore.
# Usefulness: Normalizes CreditScore to ensure comparability with other features.
df['CreditScore_zscore'] = (df['CreditScore'] - df['CreditScore'].mean()) / df['CreditScore'].std()
end

python
# PriorDefault_CreditScore_interaction
# Feature description: Interaction term between PriorDefault and CreditScore.
# Usefulness: Models compound risk associated with poor credit history and applicant creditworthiness.
df['PriorDefault_CreditScore_interaction'] = df['PriorDefault'] * df['CreditScore']
end

python
# Married_income_interaction
# Feature description: Interaction between Married and Income.
# Usefulness: Captures household dynamics wherein marriage might influence financial capacity.
df['Married_income_interaction'] = df['Married'] * df['Income']
end

python
