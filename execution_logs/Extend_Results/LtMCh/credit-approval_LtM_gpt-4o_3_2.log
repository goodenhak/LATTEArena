python
# DriversLicense_Age_interaction
# Feature description: Interaction between DriversLicense and Age.
# Usefulness: Models maturity and responsibility in relation to driving eligibility and predicted success.
df['DriversLicense_Age_interaction'] = df['DriversLicense'] * df['Age']
end

python
# Employed_income_interaction
# Feature description: Interaction between Employed and Income.
# Usefulness: Captures how employment status amplifies or diminishes the effect of income on credit card success.
df['Employed_income_interaction'] = df['Employed'] * df['Income']
end

python
# Gender_onehot
# Feature description: One-hot encoded Gender.
# Usefulness: Helps model potential differences in prediction outcomes based on gender without assuming polarity.
df = pd.concat([df, pd.get_dummies(df['Gender'], prefix='Gender')], axis=1)
end

python
# Ethnicity_onehot
# Feature description: One-hot encoding of Ethnicity.
# Usefulness: Models categorical disparities or trends in credit card success based on ethnicity.
df = pd.concat([df, pd.get_dummies(df['Ethnicity'], prefix='Ethnicity')], axis=1)
end

python
# Industry_onehot
# Feature description: One-hot encoding of Industry.
# Usefulness: Differentiates applicants based on industry-specific factors that affect financial behavior.
df = pd.concat([df, pd.get_dummies(df['Industry'], prefix='Industry')], axis=1)
end

python
# Target_encoding_Ethnicity
# Feature description: Target encoding of Ethnicity based on average success rates.
# Usefulness: Captures success trends associated with ethnic groups for improved prediction.
ethnicity_target_mean = df.groupby('Ethnicity')['Target'].mean()
df['Target_encoding_Ethnicity'] = df['Ethnicity'].map(ethnicity_target_mean)
end

python
# Income_zscore
# Feature description: Z-score normalization of Income.
# Usefulness: Normalizes Income to ensure comparability across the dataset for downstream models.
df['Income_zscore'] = (df['Income'] - df['Income'].mean()) / df['Income'].std()
end

python
# Debt_zscore
# Feature description: Z-score normalization of Debt.
# Usefulness: Normalizes Debt so it can be compared across features with different units of measure.
df['Debt_zscore'] = (df['Debt'] - df['Debt'].mean()) / df['Debt'].std()
end

python
# YearsEmployed_log
# Feature description: Log transformation of YearsEmployed.
# Usefulness: Models the nonlinear effect of employment duration on perceived financial stability.
df['YearsEmployed_log'] = np.log1p(df['YearsEmployed'])
end

python
# Drop unnecessary columns: ZipCode and Citizen.
df.drop(columns=['ZipCode', 'Citizen'], inplace=True)
end
