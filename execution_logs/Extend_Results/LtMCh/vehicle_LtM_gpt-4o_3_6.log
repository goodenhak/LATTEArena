# interaction_COMPACTNESS_CIRCULARITY
# Interaction term between COMPACTNESS and CIRCULARITY.
# Usefulness: Captures combined impact of compactness and circularity, distinguishing rounded and elongated shapes.
df['interaction_COMPACTNESS_CIRCULARITY'] = df['COMPACTNESS'] * df['CIRCULARITY']
end

python
# ratio_PR.AXIS_ASPECT_RATIO_MAX.LENGTH_ASPECT_RATIO
# Ratio of PR.AXIS_ASPECT_RATIO to MAX.LENGTH_ASPECT_RATIO.
# Usefulness: Highlights proportional relationships between axis aspect ratios and maximum length ratios, aiding vehicle shape differentiation.
df['ratio_PR.AXIS_ASPECT_RATIO_MAX.LENGTH_ASPECT_RATIO'] = df['PR.AXIS_ASPECT_RATIO'] / df['MAX.LENGTH_ASPECT_RATIO']
end

python
# diff_SCALED_VARIANCE_MAJOR_MINOR
# Difference between SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCALED_VARIANCE_ALONG_MINOR_AXIS.
# Usefulness: Indicates asymmetry or contrast in axis variances, which helps identify structural shape differences among vehicles.
df['diff_SCALED_VARIANCE_MAJOR_MINOR'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# log_SCALED_VARIANCE_ALONG_MAJOR_AXIS
# Log-transformed value of SCALED_VARIANCE_ALONG_MAJOR_AXIS.
# Usefulness: Reduces skewness and emphasizes subtle differences in major axis variance for improved shape analysis of vehicle geometries.
df['log_SCALED_VARIANCE_ALONG_MAJOR_AXIS'] = np.log(df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'])
end

python
# log_SCALED_VARIANCE_ALONG_MINOR_AXIS
# Log-transformed value of SCALED_VARIANCE_ALONG_MINOR_AXIS.
# Usefulness: Mitigates skewness and highlights meaningful differences in minor axis variance, aiding vehicle shape classification.
df['log_SCALED_VARIANCE_ALONG_MINOR_AXIS'] = np.log(df['SCALED_VARIANCE_ALONG_MINOR_AXIS'])
end

python
# reciprocal_HOLLOWS_RATIO
# Reciprocal of HOLLOWS_RATIO.
# Usefulness: Reduces the impact of large values in hollow ratios and focuses on informative variations in smaller hollow regions.
df['reciprocal_HOLLOWS_RATIO'] = 1 / df['HOLLOWS_RATIO']
end

python
# target_encoding_RADIUS_RATIO
# Mean value of RADIUS_RATIO grouped by vehicle type (target encoding).
# Usefulness: Embeds vehicle-type-specific patterns in RADIUS_RATIO, helping distinguish vehicle types based on class-specific asymmetry trends.
df['target_encoding_RADIUS_RATIO'] = df.groupby('vehicle_type')['RADIUS_RATIO'].transform('mean')
end

python
# rolling_mean_ELONGATEDNESS
# Rolling mean of ELONGATEDNESS with a window size of 3.
# Usefulness: Captures localized trends in ELONGATEDNESS, aiding distinction of stretched profiles under different viewing angles.
df['rolling_mean_ELONGATEDNESS'] = df['ELONGATEDNESS'].rolling(window=3).mean()
end

python
# group_mean_COMPACTNESS
# Mean value of COMPACTNESS grouped by vehicle type.
# Usefulness: Captures vehicle-type-specific trends in compactness that aid in classifying based on group-level shape characteristics.
df['group_mean_COMPACTNESS'] = df.groupby('vehicle_type')['COMPACTNESS'].transform('mean')
end

python
# group_std_CIRCULARITY
# Standard deviation of CIRCULARITY grouped by vehicle type.
# Usefulness: Highlights intra-class variability in CIRCULARITY, complementing mean-based group patterns to improve classification accuracy.
df['group_std_CIRCULARITY'] = df.groupby('vehicle_type')['CIRCULARITY'].transform('std')
end

python
df.drop(columns=['SCALED_RADIUS_OF_GYRATION'], inplace=True)
end
