# interaction_COMPACTNESS_CIRCULARITY
# Feature description: Interaction term between COMPACTNESS and CIRCULARITY.
# Usefulness: Captures the combined effects of compactness and circularity, helping distinguish between rounded and elongated vehicular shapes.
df['interaction_COMPACTNESS_CIRCULARITY'] = df['COMPACTNESS'] * df['CIRCULARITY']
end

python
# ratio_PR.AXIS_ASPECT_RATIO_MAX.LENGTH_ASPECT_RATIO
# Feature description: Ratio between PR.AXIS_ASPECT_RATIO and MAX.LENGTH_ASPECT_RATIO.
# Usefulness: Highlights the proportional relationship between axis aspect ratios and maximum length ratios for classifying elongated versus compact vehicle types.
df['ratio_PR.AXIS_ASPECT_RATIO_MAX.LENGTH_ASPECT_RATIO'] = df['PR.AXIS_ASPECT_RATIO'] / df['MAX.LENGTH_ASPECT_RATIO']
end

python
# diff_SCALED_VARIANCE_MAJOR_MINOR
# Feature description: Difference between SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCALED_VARIANCE_ALONG_MINOR_AXIS.
# Usefulness: Reflects asymmetry in axis-wise variances, helping differentiate vehicles with irregular shapes.
df['diff_SCALED_VARIANCE_MAJOR_MINOR'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# log_SCALED_VARIANCE_ALONG_MAJOR_AXIS
# Feature description: Log-transformed value of SCALED_VARIANCE_ALONG_MAJOR_AXIS.
# Usefulness: Reduces skewness and emphasizes smaller differences in variance along the major axis for better differentiation.
df['log_SCALED_VARIANCE_ALONG_MAJOR_AXIS'] = np.log(df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'])
end

python
# log_SCALED_VARIANCE_ALONG_MINOR_AXIS
# Feature description: Log-transformed value of SCALED_VARIANCE_ALONG_MINOR_AXIS.
# Usefulness: Mitigates skewness and highlights meaningful differences in variance along the minor axis, aiding subtle classification.
df['log_SCALED_VARIANCE_ALONG_MINOR_AXIS'] = np.log(df['SCALED_VARIANCE_ALONG_MINOR_AXIS'])
end

python
# reciprocal_HOLLOWS_RATIO
# Feature description: Reciprocal of HOLLOWS_RATIO.
# Usefulness: Reduces the influence of large hollow area values, amplifying subtle variations in the compactness of hollow regions.
df['reciprocal_HOLLOWS_RATIO'] = 1 / df['HOLLOWS_RATIO']
end

python
# rolling_mean_ELONGATEDNESS
# Feature description: Rolling mean of ELONGATEDNESS with a window size of 3.
# Usefulness: Captures localized trends in elongation across consecutive data points, useful in representing shape changes due to viewing angles.
df['rolling_mean_ELONGATEDNESS'] = df['ELONGATEDNESS'].rolling(window=3).mean()
end

python
# zscore_COMPACTNESS
# Feature description: Z-score normalized value of COMPACTNESS.
# Usefulness: Standardizes COMPACTNESS for comparability and alignment in scale, aiding downstream predictive models.
df['zscore_COMPACTNESS'] = (df['COMPACTNESS'] - 94.0611) / 8.4417
end

python
# group_mean_COMPACTNESS
# Feature description: Mean value of COMPACTNESS grouped by vehicle type.
# Usefulness: Captures group-specific compactness patterns, improving classifier accuracy by embedding prior vehicle-type distributions.
df['group_mean_COMPACTNESS'] = df.groupby('vehicle_type')['COMPACTNESS'].transform('mean')
end

python
# group_std_CIRCULARITY
# Feature description: Standard deviation of CIRCULARITY grouped by vehicle type.
# Usefulness: Reflects the variability within CIRCULARITY across vehicle types, complementing mean-based grouping for robust classification.
df['group_std_CIRCULARITY'] = df.groupby('vehicle_type')['CIRCULARITY'].transform('std')
end

python
# target_encoding_RADIUS_RATIO
# Feature description: Mean of RADIUS_RATIO per vehicle type (target encoding).
# Usefulness: Dynamically embeds vehicle-type-specific asymmetry patterns in RADIUS_RATIO, enhancing classification accuracy.
df['target_encoding_RADIUS_RATIO'] = df.groupby('vehicle_type')['RADIUS_RATIO'].transform('mean')
end

python
df.drop(columns=['SCALED_RADIUS_OF_GYRATION'], inplace=True)
end
