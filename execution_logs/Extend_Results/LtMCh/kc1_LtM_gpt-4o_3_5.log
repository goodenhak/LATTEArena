# v_g_per_loc
# Cyclomatic complexity per line of code to normalize complexity by module size.
# Usefulness: Accounts for modules with disproportionately high logic density, increasing defect risk.
df['v_g_per_loc'] = df['v(g)'] / df['loc']
end

python
# branch_density
# Control flow structure density, measured as branches per line of code.
# Usefulness: Highlights modules with increased branching which are more susceptible to defects.
df['branch_density'] = df['branchCount'] / df['loc']
end

python
# essential_complexity_ratio
# Proportion of essential complexity to total cyclomatic complexity.
# Usefulness: Differentiates inherently complex modules (higher maintenance risk) from those with manageable complexity.
df['essential_complexity_ratio'] = df['ev(g)'] / df['v(g)']
end

python
# design_complexity_ratio
# Proportion of design complexity to total cyclomatic complexity.
# Usefulness: Captures design-level interactions contributing to overall complexity, which could indicate increased defect risk.
df['design_complexity_ratio'] = df['iv(g)'] / df['v(g)']
end

python
# effort_per_loc
# Effort per line of code to normalize maintenance burden by module size.
# Usefulness: Highlights modules with higher cognitive load relative to size, indicating potential risk areas.
df['effort_per_loc'] = df['e'] / df['loc']
end

python
# intelligence_per_loc
# Intelligence per line of code as a measure of code quality relative to its cognitive effort and size.
# Usefulness: Measures the efficiency of code design and development effort relative to size.
df['intelligence_per_loc'] = df['i'] / df['loc']
end

python
# difficulty_per_length
# Difficulty normalized by program length.
# Usefulness: Identifies complex elements within relatively small or overly verbose codebases.
df['difficulty_per_length'] = df['d'] / df['l']
end

python
# effort_per_volume
# Effort divided by Halstead volume to capture efficiency in effort distribution.
# Usefulness: Detects segments where excessive effort is required despite manageable computational volume.
df['effort_per_volume'] = df['e'] / df['v']
end

python
# operators_per_loc
# Total count of operators and operands normalized by lines of code.
# Usefulness: Identifies overly verbose expressions which can reduce code clarity and increase defect risks.
df['operators_per_loc'] = df['n'] / df['loc']
end

python
# uniq_op_ratio
# Proportion of unique to total operators.
# Usefulness: Highlights modules with diverse operator usage, which can indicate complex or inconsistent coding patterns.
df['uniq_op_ratio'] = df['uniq_Op'] / df['total_Op']
end

python
# uniq_opnd_ratio
# Proportion of unique to total operands.
# Usefulness: Reflects the diversity of data variables used, which can signal inconsistencies or potential defect-prone regions.
df['uniq_opnd_ratio'] = df['uniq_Opnd'] / df['total_Opnd']
end

python
# volume_per_branch
# Halstead volume normalized by branch count.
# Usefulness: Identifies computationally dense branches, which can be harder to maintain and more bug-prone.
df['volume_per_branch'] = df['v'] / df['branchCount']
end

python
# effort_per_branch
# Development and maintenance effort normalized by branch count.
# Usefulness: Highlights branches that contribute disproportionately to cognitive load, increasing defect likelihood.
df['effort_per_branch'] = df['e'] / df['branchCount']
end

python
# code_density
# Proportion of code lines to total lines of the module.
# Usefulness: Distinguishes modules with excessive comments or sparse code, which can impact maintainability.
df['code_density'] = df['lOCode'] / df['loc']
end

python
# noncode_density
# Proportion of non-code lines (comments + blanks) to total lines.
# Usefulness: Highlights modules with imbalanced documentation or potentially confusing structure.
df['noncode_density'] = (df['lOComment'] + df['lOBlank']) / df['loc']
end

python
# complexity_interaction
# Interaction between cyclomatic complexity and Halstead difficulty.
# Usefulness: Captures areas where procedural complexity and cognitive load synergize to indicate defect-prone code.
df['complexity_interaction'] = df['v(g)'] * df['d']
end

python
# size_interaction
# Interaction between total operators/operands and Halstead volume.
# Usefulness: Reflects the joint effect of structural and cognitive size on module maintainability.
df['size_interaction'] = df['n'] * df['v']
end

python
df.drop(columns=['locCodeAndComment'], inplace=True)
end
