end

python
# effort_per_branch
# Development and maintenance effort normalized by branch count.
# Usefulness: Captures branches that disproportionately contribute to maintenance burden.
df['effort_per_branch'] = df['e'] / df['branchCount']
end

python
# log_effort
# Log-transformed Halstead effort to reduce skewness and manage outliers.
# Usefulness: Identifies modules with disproportionately high effort while minimizing the effect of outliers.
df['log_effort'] = np.log(df['e'] + 1)
end

python
# complexity_interaction
# Interaction between cyclomatic complexity and Halstead difficulty.
# Usefulness: Captures how procedural complexity synergizes with cognitive difficulty to predict defect likelihood.
df['complexity_interaction'] = df['v(g)'] * df['reciprocal_d']
end

python
# operator_diversity
# Ratio of unique operators to total operators.
# Usefulness: Reflects diversity of operator usage, indicating variation in coding strategy and complexity.
df['operator_diversity'] = df['uniq_Op'] / df['total_Op']
end

python
# volume_per_branch
# Halstead volume normalized by branch count.
# Usefulness: Highlights computationally dense branches where defects are more likely to surface.
df['volume_per_branch'] = df['v'] / df['branchCount']
end

python
# rank_v
# Rank transformation of Halstead volume.
# Usefulness: Reduces the impact of extreme volume values, enabling meaningful comparisons across modules.
df['rank_v'] = df['v'].rank()
end

python
# size_interaction
# Interaction between total operators/operands and Halstead volume.
# Usefulness: Reflects the combined effect of structural size and cognitive aspects, identifying potential risk areas.
df['size_interaction'] = df['total_Op'] * df['v']
end

python
# effort_size_interaction
# Interaction between Halstead effort and size (volume).
# Usefulness: Highlights regions requiring excessive effort for the given size, contributing to defect risk.
df['effort_size_interaction'] = df['e'] * df['v']
end

python
# complexity_diversity_interaction
# Interaction between cyclomatic complexity and operator diversity.
# Usefulness: Reflects the impact of logical complexity and code diversity on defect likelihood.
df['complexity_diversity_interaction'] = df['v(g)'] * df['operator_diversity']
end

python
# normalized_diversity
# Proportion of unique operands to normalized code density.
# Usefulness: Indicates how operand diversity aligns with a module's code density, reflecting coding style and structure.
df['normalized_diversity'] = df['uniq_opnd_ratio'] / df['code_density']
end

python
# effort_per_branch_density
# Effort per density of branches in the module.
# Usefulness: Highlights code with ineffective mapping of effort across control flow complexity.
df['effort_per_branch_density'] = df['e'] / df['branch_density']
end

python
# volume_size_ratio
# Ratio of Halstead volume to lines of code.
# Usefulness: Indicates computational density relative to module size, reflecting higher concentration of logic.
df['volume_size_ratio'] = df['v'] / df['loc']
end

python
# reciprocal_complexity
# Reciprocal transformation of cyclomatic complexity.
# Usefulness: Reduces the impact of extreme complexity values, emphasizing moderate complexity levels.
df['reciprocal_complexity'] = 1 / (df['v(g)'] + 1)
end

python
# zscore_v
# Z-score normalized Halstead volume.
# Usefulness: Enables comparison of relative volume across modules of varying sizes and complexities.
df['zscore_v'] = (df['v'] - df['v'].mean()) / df['v'].std()
end

python
df.drop(columns=['locCodeAndComment'], inplace=True)
end
