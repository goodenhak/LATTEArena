df['branch_density'] = df['branchCount'] / df['loc']
end

python
# volume_per_branch
# Halstead volume normalized by branch count.
# Usefulness: Highlights sections of code that are computationally dense.
df['volume_per_branch'] = df['v'] / df['branchCount']
end

python
# effort_per_branch
# Development and maintenance effort normalized by branch count.
# Usefulness: Identifies branches that may disproportionately contribute to cognitive load.
df['effort_per_branch'] = df['e'] / df['branchCount']
end

python
# essential_complexity_ratio
# Proportion of essential complexity to total cyclomatic complexity.
# Usefulness: Differentiates structured complexity from overall complexity, which could indicate harder-to-maintain regions in the module.
df['essential_complexity_ratio'] = df['ev(g)'] / df['v(g)']
end

python
# operator_diversity
# Ratio of unique operators to total operators.
# Usefulness: Reflects the diversity of operator use, signaling complex or varied coding techniques.
df['operator_diversity'] = df['uniq_Op'] / df['total_Op']
end

