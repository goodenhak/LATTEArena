[{'["# v_g_per_loc\\n# Cyclomatic complexity per line of code to normalize complexity by module size.\\n# Usefulness: Accounts for how dense the logic is in a module relative to its size.\\ndf[\'v_g_per_loc\'] = df[\'v(g)\'] / df[\'loc\']", "# branch_density\\n# Control flow structure density, measured as branches per line of code.\\n# Usefulness: Highlights modules with an unusually high or low density of branches, which can influence defect likelihood.\\ndf[\'branch_density\'] = df[\'branchCount\'] / df[\'loc\']", "# essential_complexity_ratio\\n# Proportion of essential complexity to total cyclomatic complexity.\\n# Usefulness: Differentiates structured complexity from overall complexity, which could indicate harder-to-maintain regions in the module.\\ndf[\'essential_complexity_ratio\'] = df[\'ev(g)\'] / df[\'v(g)\']", "# design_complexity_ratio\\n# Proportion of design complexity to total cyclomatic complexity.\\n# Usefulness: Captures the extent to which design-level interactions contribute to overall procedural complexity.\\ndf[\'design_complexity_ratio\'] = df[\'iv(g)\'] / df[\'v(g)\']", "# effort_per_loc\\n# Effort per line of code to normalize maintenance burden by module size.\\n# Usefulness: Enables comparison of cognitive effort relative to the module\'s size.\\ndf[\'effort_per_loc\'] = df[\'e\'] / df[\'loc\']", "# intelligence_per_loc\\n# Intelligence per line of code as a measure of code quality relative to its cognitive effort and size.\\n# Usefulness: Indicates whether code achieves efficiency despite its size by requiring less conceptual effort.\\ndf[\'intelligence_per_loc\'] = df[\'i\'] / df[\'loc\']", "# difficulty_per_length\\n# Difficulty normalized by program length.\\n# Usefulness: Highlights modules with unnecessary complexity relative to their functionality or size.\\ndf[\'difficulty_per_length\'] = df[\'d\'] / df[\'l\']", "# effort_per_volume\\n# Effort divided by Halstead volume to capture efficiency in effort distribution.\\n# Usefulness: Highlights inefficient areas where disproportionate effort is needed despite volume.\\ndf[\'effort_per_volume\'] = df[\'e\'] / df[\'v\']", "# operators_per_loc\\n# Total count of operators and operands normalized by lines of code.\\n# Usefulness: Distinguishes verbose code with potential maintenance challenges.\\ndf[\'operators_per_loc\'] = df[\'n\'] / df[\'loc\']", "# uniq_op_ratio\\n# Proportion of unique to total operators.\\n# Usefulness: Indicates lexical diversity of the code, which may reflect coding style or complexity.\\ndf[\'uniq_op_ratio\'] = df[\'uniq_Op\'] / df[\'total_Op\']", "# uniq_opnd_ratio\\n# Proportion of unique to total operands.\\n# Usefulness: Indicates the diversity of variables used, which could reveal code structure and quality.\\ndf[\'uniq_opnd_ratio\'] = df[\'uniq_Opnd\'] / df[\'total_Opnd\']", "# volume_per_branch\\n# Halstead volume normalized by branch count.\\n# Usefulness: Highlights sections of code that are computationally dense.\\ndf[\'volume_per_branch\'] = df[\'v\'] / df[\'branchCount\']", "# effort_per_branch\\n# Development and maintenance effort normalized by branch count.\\n# Usefulness: Identifies branches that may disproportionately contribute to cognitive load.\\ndf[\'effort_per_branch\'] = df[\'e\'] / df[\'branchCount\']", "# code_density\\n# Proportion of code lines to total lines of the module.\\n# Usefulness: Evaluates how much of the file is dedicated to code versus comments or blanks, which can influence maintainability.\\ndf[\'code_density\'] = df[\'lOCode\'] / df[\'loc\']", "# noncode_density\\n# Proportion of non-code lines (comments + blanks) to total lines.\\n# Usefulness: Highlights modules with either under-commenting or excessive non-code content.\\ndf[\'noncode_density\'] = (df[\'lOComment\'] + df[\'lOBlank\']) / df[\'loc\']", "# complexity_interaction\\n# Interaction between cyclomatic complexity and Halstead difficulty.\\n# Usefulness: Captures how procedural complexity combines with cognitive difficulty to predict defect likelihood.\\ndf[\'complexity_interaction\'] = df[\'v(g)\'] * df[\'d\']", "# size_interaction\\n# Interaction between total operators/operands and Halstead volume.\\n# Usefulness: Reflects how structural size interacts with cognitive attributes of the code.\\ndf[\'size_interaction\'] = df[\'n\'] * df[\'v\']", "df.drop(columns=[\'locCodeAndComment\'], inplace=True)"]': 0.0071090047393364}, {'["# log_v\\n# Log-transformed Halstead volume to reduce skewness and manage outliers.\\n# Usefulness: Captures manageable differences in volume, reducing the impact of extreme values, which could indicate defect-prone modules.\\ndf[\'log_v\'] = df[\'v\'].apply(lambda x: np.log(x + 1))", "# log_effort\\n# Log-transformed Halstead effort to reduce skewness and manage outliers.\\n# Usefulness: Helps identify modules with disproportionately high effort while managing extreme values.\\ndf[\'log_effort\'] = df[\'e\'].apply(lambda x: np.log(x + 1))", "# reciprocal_d\\n# Reciprocal transformation of Halstead difficulty to address extreme values.\\n# Usefulness: Compresses high difficulty values to emphasize manageable areas of code complexity.\\ndf[\'reciprocal_d\'] = 1 / (df[\'d\'] + 1)", "# zscore_v\\n# Z-score normalized Halstead volume.\\n# Usefulness: Standardizes this feature to compare across modules of varying sizes and complexity.\\ndf[\'zscore_v\'] = (df[\'v\'] - df[\'v\'].mean()) / df[\'v\'].std()", "# complexity_difficulty_score\\n# Interaction between cyclomatic complexity and Halstead difficulty.\\n# Usefulness: Captures modules with high control flow complexity and cognitive burden, which are likely defect-prone.\\ndf[\'complexity_difficulty_score\'] = df[\'v(g)\'] * df[\'d\']", "# branch_effort\\n# Interaction between branch count and Halstead effort.\\n# Usefulness: Identifies modules where branching contributes disproportionately to cognitive effort, indicating potential defect risks.\\ndf[\'branch_effort\'] = df[\'branchCount\'] * df[\'e\']", "# volume_intelligence_interaction\\n# Interaction between Halstead volume and intelligence per line of code.\\n# Usefulness: Highlights areas of the code with high computational density and low cognitive load, reflecting effective design.\\ndf[\'volume_intelligence_interaction\'] = df[\'v\'] * (df[\'i\'] / df[\'loc\'])", "# operator_diversity\\n# Ratio of unique operators to total operators.\\n# Usefulness: Reflects the diversity of operator use, signaling complex or varied coding techniques.\\ndf[\'operator_diversity\'] = df[\'uniq_Op\'] / df[\'total_Op\']", "# operand_diversity\\n# Ratio of unique operands to total operands.\\n# Usefulness: Indicates the diversity of data variables, which is tied to modular structure and organization.\\ndf[\'operand_diversity\'] = df[\'uniq_Opnd\'] / df[\'total_Opnd\']", "# effort_density\\n# Effort normalized by lines of code.\\n# Usefulness: Highlights modules with disproportionately high cognitive effort relative to size, signaling risk areas.\\ndf[\'effort_density\'] = df[\'e\'] / df[\'loc\']", "# cumsum_effort\\n# Cumulative sum of Halstead effort.\\n# Usefulness: Tracks incremental effort across multiple modules or within the codebase, identifying areas of excessive complexity buildup.\\ndf[\'cumsum_effort\'] = df[\'e\'].cumsum()", "# rank_v\\n# Rank transformation of Halstead volume.\\n# Usefulness: Handles outliers by ranking modules based on volume, enabling better relative comparisons.\\ndf[\'rank_v\'] = df[\'v\'].rank()", "df.drop(columns=[\'locCodeAndComment\'], inplace=True)"]': 0.004739336492891044}]
