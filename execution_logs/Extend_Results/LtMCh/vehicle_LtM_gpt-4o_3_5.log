       python
       df['ZSHAPE_VARIANCE_RATIO'] = (df['SHAPE_VARIANCE_RATIO'] - df['SHAPE_VARIANCE_RATIO'].mean()) / df['SHAPE_VARIANCE_RATIO'].std()
       
