[{'["# COMPACTNESS_RANK\\n# Rank COMPACTNESS values to assess relative compactness across vehicle silhouettes.\\n# Usefulness: This feature provides a direct comparison of compactness, aiding in distinguishing broad shape differences.\\n\\ndf[\'COMPACTNESS_RANK\'] = df[\'COMPACTNESS\'].rank()", "# CIRCULARITY_RATIO\\n# Ratio of CIRCULARITY to COMPACTNESS to highlight circularity relative to compactness.\\n# Usefulness: Emphasizes how circular a silhouette is for a given compactness, helping capture nuanced shape differences.\\n\\ndf[\'CIRCULARITY_RATIO\'] = df[\'CIRCULARITY\'] / df[\'COMPACTNESS\']", "# HOLLOWS_DIFF\\n# Difference between HOLLOWS_RATIO and ELONGATEDNESS to capture hollow spaces relative to elongation.\\n# Usefulness: Identifies silhouettes with higher hollow area patterns for elongated shapes, aiding size and shape analysis.\\n\\ndf[\'HOLLOWS_DIFF\'] = df[\'HOLLOWS_RATIO\'] - df[\'ELONGATEDNESS\']", "# ASYMMETRY_SCORE_MAJOR\\n# Ratio of SKEWNESS_ABOUT_MAJOR_AXIS to KURTOSIS_ABOUT_MAJOR_AXIS to reflect asymmetry along the major axis.\\n# Usefulness: Measures irregularity or asymmetry on the major axis, key for identifying distinct symmetry distortions.\\n\\ndf[\'ASYMMETRY_SCORE_MAJOR\'] = df[\'SKEWNESS_ABOUT_MAJOR_AXIS\'] / df[\'KURTOSIS_ABOUT_MAJOR_AXIS\']", "# ASYMMETRY_SCORE_MINOR\\n# Ratio of SKEWNESS_ABOUT_MINOR_AXIS to KURTOSIS_ABOUT_MINOR_AXIS to capture asymmetry along the minor axis.\\n# Usefulness: Helps assess asymmetry on the minor axis, highlighting subtle differences in silhouette symmetry.\\n\\ndf[\'ASYMMETRY_SCORE_MINOR\'] = df[\'SKEWNESS_ABOUT_MINOR_AXIS\'] / df[\'KURTOSIS_ABOUT_MINOR_AXIS\']", "# MAJOR_MINOR_VARIANCE_RATIO\\n# Ratio of SCALED_VARIANCE_ALONG_MINOR_AXIS to SCALED_VARIANCE_ALONG_MAJOR_AXIS to compare variance between axes.\\n# Usefulness: Helps detect differences in size distribution along the major and minor axes, key for shape classification.\\n\\ndf[\'MAJOR_MINOR_VARIANCE_RATIO\'] = df[\'SCALED_VARIANCE_ALONG_MINOR_AXIS\'] / df[\'SCALED_VARIANCE_ALONG_MAJOR_AXIS\']", "# GYRATION_ZSCORE\\n# Z-score normalization of SCALED_RADIUS_OF_GYRATION to identify outliers in gyration patterns.\\n# Usefulness: Standardizes mass distribution for consistent comparison, helping spot anomalies across silhouettes.\\n\\ndf[\'GYRATION_ZSCORE\'] = (df[\'SCALED_RADIUS_OF_GYRATION\'] - df[\'SCALED_RADIUS_OF_GYRATION\'].mean()) / df[\'SCALED_RADIUS_OF_GYRATION\'].std()", "# RECTANGULARITY_RATIO\\n# Ratio of PR.AXIS_RECTANGULARITY to MAX.LENGTH_RECTANGULARITY to emphasize variations in rectangularity patterns.\\n# Usefulness: Highlights how rectangularity differs based on principal and max length axes, aiding aspect ratio analysis.\\n\\ndf[\'RECTANGULARITY_RATIO\'] = df[\'PR.AXIS_RECTANGULARITY\'] / df[\'MAX.LENGTH_RECTANGULARITY\']", "# AXIS_ASPECT_DIFF\\n# Difference between PR.AXIS_ASPECT_RATIO and MAX.LENGTH_ASPECT_RATIO to assess relative axis ratios.\\n# Usefulness: Captures the difference between principal axis and max length aspect ratios, crucial for structural differentiation.\\n\\ndf[\'AXIS_ASPECT_DIFF\'] = df[\'PR.AXIS_ASPECT_RATIO\'] - df[\'MAX.LENGTH_ASPECT_RATIO\']", "# SHAPE_SYMMETRY_SCORE\\n# Product of COMPACTNESS and SCATTER_RATIO to combine shape and symmetry in a single metric.\\n# Usefulness: Provides a combined measure of compactness and symmetry, offering a holistic shape-symmetry descriptor.\\n\\ndf[\'SHAPE_SYMMETRY_SCORE\'] = df[\'COMPACTNESS\'] * df[\'SCATTER_RATIO\']", "# GLOBAL_IRREGULARITY\\n# Product of HOLLOWS_RATIO and ELONGATEDNESS to capture overall irregularities in shape.\\n# Usefulness: Highlights silhouettes with irregular hollow patterns and elongation, key for detecting outliers.\\n\\ndf[\'GLOBAL_IRREGULARITY\'] = df[\'HOLLOWS_RATIO\'] * df[\'ELONGATEDNESS\']", "# SIZE_ELONGATION_RATIO\\n# Ratio of SCALED_RADIUS_OF_GYRATION to ELONGATEDNESS to assess how mass distribution relates to elongation.\\n# Usefulness: Connects overall shape distribution to elongation, 