IRCULARITY_VARIANCE_COMPOSITE\n# Product of CIRCULARITY_RATIO and SCALED_VARIANCE_ALONG_MINOR_AXIS.\n# Usefulness: Links circularity metrics to minor axis variance, capturing distribution irregularities paramount for identifying vehicle type differences.\ndf['CIRCULARITY_VARIANCE_COMPOSITE'] = df['CIRCULARITY_RATIO'] * df['SCALED_VARIANCE_ALONG_MINOR_AXIS']", "# RECTANGULARITY_SYMMETRY_LOG_RATIO\n# Logarithmic ratio of RECTANGULARITY_RATIO to SHAPE_SYMMETRY_SCORE for a nonlinear perspective on rectangularity-symmetry patterns.\n# Usefulness: Emphasizes additional nonlinear insights into how rectangular shapes align with symmetry properties critical for classification.\ndf['RECTANGULARITY_SYMMETRY_LOG_RATIO'] = np.log(df['RECTANGULARITY_RATIO']) - np.log(df['SHAPE_SYMMETRY_SCORE'])", "# HOLLOWS_SIZE_PRODUCT\n# Product of HOLLOWS_DIFF and SIZE_ELONGATION_RATIO to explore hollow area differences in relation to elongated mass distribution.\n# Usefulness: Reflects how hollow spaces integrate with elongated mass properties, aiding the differentiation of vehicle shapes.\ndf['HOLLOWS_SIZE_PRODUCT'] = df['HOLLOWS_DIFF'] * df['SIZE_ELONGATION_RATIO']", "# GYRATION_ASYMMETRY_PRODUCT\n# Product of GYRATION_ZSCORE and ASYMMETRY_BALANCE_DIFF to capture gyration effects relative to symmetry balance contrasts.\n# Usefulness: Highlights mass distribution anomalies linked with symmetry balances for deeper outlier detection.\ndf['GYRATION_ASYMMETRY_PRODUCT'] = df['GYRATION_ZSCORE'] * df['ASYMMETRY_BALANCE_DIFF']", "# SHAPE_SCATTER_METRIC\n# Product of SHAPE_SYMMETRY_SCORE and SCATTER_RATIO to combine shape symmetry with inertia-based distribution.\n# Usefulness: Encapsulates major shape and symmetry properties necessary for broad silhouette differentiation.\ndf['SHAPE_SCATTER_METRIC'] = df['SHAPE_SYMMETRY_SCORE'] * df['SCATTER_RATIO']"]
