2026-05-25 11:12:28,858 - INFO - ops_string = ["# COMBINED_SHAPE_FACTOR\n# Product of RECTANGULARITY_RATIO, SHAPE_SYMMETRY_SCORE, and CIRCULARITY_RATIO to merge key shape properties.\n# Usefulness: Creates a comprehensive feature combining geometry, symmetry, and circularity for robust shape classification.\ndf['COMBINED_SHAPE_FACTOR'] = df['RECTANGULARITY_RATIO'] * df['SHAPE_SYMMETRY_SCORE'] * df['CIRCULARITY_RATIO']", "# GLOBAL_SHAPE_COMPLEXITY\n# Cumulative product of SCATTER_RATIO, SHAPE_SYMMETRY_SCORE, and RECTANGULARITY_ELONGATION_PRODUCT for a holistic representation of shape complexity.\n# Usefulness: Aggregates shape, symmetry, and rectangularity measures into one descriptor, enhancing differentiation of complex silhouette patterns.\ndf['GLOBAL_SHAPE_COMPLEXITY'] = df['SCATTER_RATIO'] * df['SHAPE_SYMMETRY_SCORE'] * df['RECTANGULARITY_ELONGATION_PRODUCT']", "# NONLINEAR_ASPECT_COMPARISON\n# Logarithmic difference between PR.AXIS_ASPECT_RATIO and MAX.LENGTH_ASPECT_RATIO to capture subtle aspect ratio variations.\n# Usefulness: Captures nonlinear interactions among aspect ratios, revealing structural geometry nuances critical for vehicle classification.\ndf['NONLINEAR_ASPECT_COMPARISON'] = np.log(df['PR.AXIS_ASPECT_RATIO'] + 1) - np.log(df['MAX.LENGTH_ASPECT_RATIO'] + 1)", "# RECTANGULARITY_TO_ELONGATION_RATIO\n# Ratio of RECTANGULARITY_RATIO to SIZE_ELONGATION_RATIO to emphasize how rectangularity varies with elongation.\n# Usefulness: Highlights geometric interplay between rectangularity patterns and elongation, aiding differentiation of compact vs. elongated silhouettes.\ndf['RECTANGULARITY_TO_ELONGATION_RATIO'] = df['RECTANGULARITY_RATIO'] / df['SIZE_ELONGATION_RATIO']", "# ASYMMETRY_COMPOSITE_METRIC\n# Product of ASYMMETRY_SCORE_MAJOR, ASYMMETRY_SCORE_MINOR, and ASYMMETRY_BALANCE_DIFF to capture overall symmetry-related irregularities.\n# Usefulness: Combines major and minor asymmetry metrics with symmetry balance differences, providing a global measure of silhouette irregularities.\ndf['ASYMMETRY_COMPOSITE_METRIC'] = df['ASYMMETRY_SCORE_MAJOR'] * df['ASYMMETRY_SCORE_MINOR'] * df['ASYMMETRY_BALANCE_DIFF']", "# CIRCULARITY_HOLLOW_PRODUCT\n# Product of CIRCULARITY_RATIO and HOLLOWS_DIFF to reflect the interplay between circularity metrics and hollow area differences.\n# Usefulness: Enhances understanding of shapes with larger hollow areas and circularity, useful for identifying compact or non-compact silhouettes.\ndf['CIRCULARITY_HOLLOW_PRODUCT'] = df['CIRCULARITY_RATIO'] * df['HOLLOWS_DIFF']", "# ASYMMETRY_ELONGATION_INTERPLAY\n# Interaction of ASYMMETRY_SCORE_MAJOR, ASYMMETRY_SCORE_MINOR, and SIZE_ELONGATION_RATIO to connect asymmetry with elongation.\n# Usefulness: Links symmetry distortions to elongation, adding granularity in analyzing irregular silhouette structures.\ndf['ASYMMETRY_ELONGATION_INTERPLAY'] = df['ASYMMETRY_SCORE_MAJOR'] * df['ASYMMETRY_SCORE_MINOR'] * df['SIZE_ELONGATION_RATIO']", "# SCATTER_RATIO_MINMAX\n# Min-Max scaling for SCATTER_RATIO to normalize the range for better model interpretation.\n# Usefulness: Brings SCATTER_RATIO to a common scale, improving its utility in machine learning models and for inter-feature relations.\ndf['SCATTER_RATIO_MINMAX'] = (df['SCATTER_RATIO'] - df['SCATTER_RATIO'].min()) / (df['SCATTER_RATIO'].max() - df['SCATTER_RATIO'].min())", "# ZSHAPE_VARIANCE_RATIO\n# Z-score normalization of SHAPE_VARIANCE_RATIO to identify outliers in shape distribution patterns.\n# Usefulness: Standardizes variability in shape distribution, comparing subtle differences uniformly across vehicle silhouettes.\ndf['ZSHAPE_VARIANCE_RATIO'] = (df['SHAPE_VARIANCE_RATIO'] - df['SHAPE_VARIANCE_RATIO'].mean()) / df['SHAPE_VARIANCE_RATIO'].std()", "# GYRATION_SCATTER_COMPOSITE\n# Product of GYRATION_SCATTER_PRODUCT and CIRCULARITY_HOLLOW_PRODUCT to capture mass distribution irregularities tied to circularity and hollows.\n# Usefulness: Enhances understanding of the interplay between mass distribution anomalies and shape-related characteristics, crucial for outlier detection.\ndf['GYRATION_SCATTER_COMPOSITE'] = df['GYRATION_SCATTER_PRODUCT'] * df['CIRCULARITY_HOLLOW_PRODUCT']", "# Drop uninformative or redundant columns based on feature importance\ndf.drop(columns=['ASYMMETRY_SCORE_MINOR', 'ASYMMETRY_SCORE_MAJOR', 'PR.AXIS_RECTANGULARITY'], inplace=True)"]
