# Usefulness: Brings SCATTER_RATIO to a common scale, improving its utility in machine learning models and for inter-feature relations.
df['SCATTER_RATIO_MINMAX'] = (df['SCATTER_RATIO'] - df['SCATTER_RATIO'].min()) / (df['SCATTER_RATIO'].max() - df['SCATTER_RATIO'].min())
end
