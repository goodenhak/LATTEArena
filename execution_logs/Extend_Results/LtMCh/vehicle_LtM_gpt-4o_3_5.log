# Usefulness: Aggregates metrics representing shape, symmetry, and rectangularity into a single feature to differentiate intricate silhouettes.
df['GLOBAL_SHAPE_COMPLEXITY'] = df['SCATTER_RATIO'] * df['SHAPE_SYMMETRY_SCORE'] * df['RECTANGULARITY_ELONGATION_PRODUCT']
end

python
# ASYMMETRY_COMPOSITE_METRIC
