# RECTANGULARITY_ADJUSTED
# Combine RECTANGULARITY_RATIO with PR.AXIS_ASPECT_RATIO to adjust rectangularity values according to shape elongation.
# Usefulness: Highlights how the rectangularity metric varies when taking shape elongation into account, providing additional geometric insight.
df['RECTANGULARITY_ADJUSTED'] = df['RECTANGULARITY_RATIO'] / df['PR.AXIS_ASPECT_RATIO']
end

python
# ASYMMETRY_SCATTER_PRODUCT
# Product of SCATTER_RATIO, ASYMMETRY_SCORE_MINOR, and ASYMMETRY_SCORE_MAJOR to capture combined asymmetry and scatter patterns.
# Usefulness: Consolidates multiple symmetry and distribution asymmetry measures to quantify a vehicle's overall structural imbalance.
df['ASYMMETRY_SCATTER_PRODUCT'] = df['SCATTER_RATIO'] * df['ASYMMETRY_SCORE_MINOR'] * df['ASYMMETRY_SCORE_MAJOR']
end

python
# MAJOR_MINOR_CENTER_VARIANCE
# Difference between KURTOSIS_ABOUT_MAJOR_AXIS and KURTOSIS_ABOUT_MINOR_AXIS to highlight variance differences between axes.
# Usefulness: Identifies anisotropic, non-uniform spread of mass along principal axes, helping differentiate vehicle types.
df['MAJOR_MINOR_CENTER_VARIANCE'] = df['KURTOSIS_ABOUT_MAJOR_AXIS'] - df['KURTOSIS_ABOUT_MINOR_AXIS']
end

python
# SKEWNESS_AXIS_DIFFERENCE
# Difference between SKEWNESS_ABOUT_MAJOR_AXIS and SKEWNESS_ABOUT_MINOR_AXIS to isolate skew patterns across axes.
# Usefulness: Differentiates asymmetry due to mass distribution focus, providing insight into directional shape traits.
df['SKEWNESS_AXIS_DIFFERENCE'] = df['SKEWNESS_ABOUT_MAJOR_AXIS'] - df['SKEWNESS_ABOUT_MINOR_AXIS']
end

python
# SYMMETRY_SHAPE_MULTIPLES
# Product of SHAPE_SYMMETRY_SCORE and GYRATION_ZSCORE to describe symmetry variations across outlier distributions.
# Usefulness: Encapsulates major symmetries and their deviations influenced by mass distribution irregularities to capture rare shapes.
df['SYMMETRY_SHAPE_MULTIPLES'] = df['SHAPE_SYMMETRY_SCORE'] * df['GYRATION_ZSCORE']
end

python
# HOLLOWS_COMPACTNESS
# Product of HOLLOWS_DIFF and CIRCULARITY_RATIO to combine hollow regions with circularity.
# Usefulness: Provides a measure of how hollow spaces correspond to circular-shaped silhouettes, aiding in finer classification.
df['HOLLOWS_COMPACTNESS'] = df['HOLLOWS_DIFF'] * df['CIRCULARITY_RATIO']
end

python
# GLOBAL_COMPACT_ELONGATION
# Product of SIZE_ELONGATION_RATIO, SHAPE_SYMMETRY_SCORE, and SCATTER_RATIO to form a global shape metric.
# Usefulness: Aggregates key descriptors into a single feature to better capture overall vehicle shape patterns for classification.
df['GLOBAL_COMPACT_ELONGATION'] = df['SIZE_ELONGATION_RATIO'] * df['SHAPE_SYMMETRY_SCORE'] * df['SCATTER_RATIO']
end

python
# AREA_ADJUSTED_SYMMETRY
# Ratio of SCATTER_RATIO to PR.AXIS_RECTANGULARITY to reflect symmetry influence relative to silhouette area.
# Usefulness: Adjusts symmetry measures for area-based variations, hence normalizing the measure for fairer comparison.
df['AREA_ADJUSTED_SYMMETRY'] = df['SCATTER_RATIO'] / df['PR.AXIS_RECTANGULARITY']
end

python
# PR_AXIS_RECTANGULARITY_ZSCORE
# Z-score normalize PR.AXIS_RECTANGULARITY to identify major outliers in axis-related rectangularity.
# Usefulness: Standardizes this feature to make it comparable across samples and identify silhouettes with extreme rectangularity.
df['PR_AXIS_RECTANGULARITY_ZSCORE'] = (df['PR.AXIS_RECTANGULARITY'] - df['PR.AXIS_RECTANGULARITY'].mean()) / df['PR.AXIS_RECTANGULARITY'].std()
end

python
# SCATTER_RATIO_MINMAX
