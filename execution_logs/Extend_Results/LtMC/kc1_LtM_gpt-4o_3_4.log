python
# normalized_cyclomatic_complexity
# Normalized cyclomatic complexity per line of code (cyclomatic density).
# Usefulness: Emphasizes relative complexity within modules, making it easier to compare defect-prone code regardless of size.
df['normalized_cyclomatic_complexity'] = df['v(g)'] / df['loc']
end

python
# effort_per_complexity
# Effort normalized by cyclomatic complexity (effort distribution across complexity regions).
# Usefulness: Differentiates modules with high complexity but low effort from defect-prone areas requiring significant effort.
df['effort_per_complexity'] = df['e'] / df['v(g)']
end

python
# syntax_effort_ratio
# Interaction between operator diversity and development effort.
# Usefulness: Combines cognitive richness (syntax complexity) with development effort to pinpoint defect-prone areas.
