2026-05-26 01:16:57,830 - INFO - ops_string = ["# loc_log\n# Log-transformed lines of code to stabilize variance and improve interpretability in relation to complexity.\n# Usefulness: Stabilizes variance of line of code feature and provides a clearer relationship to cyclomatic complexity.\n\ndf['loc_log'] = np.log(df['loc'])", "# complexity_density\n# Cyclomatic complexity per line of code (v(g) / loc).\n# Usefulness: Identifies modules with high logic density that are prone to defects.\n\ndf['complexity_density'] = df['v(g)'] / df['loc']", "# branch_complexity_ratio\n# Branch count to cyclomatic complexity ratio (branchCount / v(g)).\n# Usefulness: Detects structural imbalance in flow logic, which may result in defects.\n\ndf['branch_complexity_ratio'] = df['branchCount'] / df['v(g)']", "# effort_per_line\n# Effort (e) divided by lines of code (loc).\n# Usefulness: Highlights modules requiring disproportional cognitive effort, which increases defect risk.\n\ndf['effort_per_line'] = df['e'] / df['loc']", "# operand_uniqueness\n# Ratio of unique operands to total operands (uniq_Opnd / total_Opnd).\n# Usefulness: Evaluates the uniqueness of design elements, impacting code readability and maintainability.\n\ndf['operand_uniqueness'] = df['uniq_Opnd'] / df['total_Opnd']", "# operator_diversity\n# Ratio of unique operators to total operators (uniq_Op / total_Op).\n# Usefulness: Analyzes design variability and modularity, which influences defect likelihood.\n\ndf['operator_diversity'] = df['uniq_Op'] / df['total_Op']", "# difficulty_effort_ratio\n# Halstead difficulty divided by effort (d / e).\n# Usefulness: Highlights modules with manageable vs excessive complexity-to-effort ratios.\n\ndf['difficulty_effort_ratio'] = df['d'] / df['e']", "# intelligence_difficulty_product\n# Product of Halstead intelligence and difficulty (i * d).\n# Usefulness: Captures the cognitive processing demand and complexity interaction.\n\ndf['intelligence_difficulty_product'] = df['i'] * df['d']", "# branching_effort_interaction\n# Effort multiplied by branch count (e * branchCount).\n# Usefulness: Reflects the relationship between module complexity (flow branching) and cognitive effort.\n\ndf['branching_effort_interaction'] = df['e'] * df['branchCount']", "# mean_line_complexity\n# Design complexity normalized by Halstead line count (iv(g) / lOCode).\n# Usefulness: Detects high-complexity modules that may lead to structural defects.\n\ndf['mean_line_complexity'] = df['iv(g)'] / df['lOCode']", "# code_documentation_ratio\n# Ratio of commented lines to code lines (lOComment / lOCode).\n# Usefulness: Reflects code clarity and maintainability, reducing defect risks.\n\ndf['code_documentation_ratio'] = df['lOComment'] / df['lOCode']", "df.drop(columns=['lOBlank'], inplace=True)"]
