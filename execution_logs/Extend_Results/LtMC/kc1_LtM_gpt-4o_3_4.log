# Usefulness: Highly skewed distribution of loc (Std: 30.8972) stabilizes to better capture realistic trends in module size.
df['loc_log'] = np.log1p(df['loc'])
end

python
# complexity_density
# Cyclomatic complexity per line of code (v(g) / loc).
# Usefulness: Identifies modules with dense complexity where defects are more likely.
df['complexity_density'] = df['v(g)'] / df['loc']
end

python
# branch_complexity_ratio
# Branch count to cyclomatic complexity ratio (branchCount / v(g)).
# Usefulness: Differentiates code where control flow (branching) dominates and directly contributes toward defects.
df['branch_complexity_ratio'] = df['branchCount'] / (df['v(g)'] + 1e-6)
end

python
# effort_per_line
# Effort (e) divided by lines of code (loc).
# Usefulness: Highlights areas with concentrated coding effort, possibly leading to higher defect likelihood.
df['effort_per_line'] = df['e'] / (df['loc'] + 1e-6)
end

python
# operand_uniqueness
# Ratio of unique operands to total operands (uniq_Opnd / total_Opnd).
# Usefulness: Measures operand variability, reflecting code reusability vs redundancy linked to defect chances.
df['operand_uniqueness'] = df['uniq_Opnd'] / (df['total_Opnd'] + 1e-6)
end

python
# operator_diversity
# Ratio of unique operators to total operators (uniq_Op / total_Op).
# Usefulness: Highlights operator diversification which can influence code correctness and readability.
df['operator_diversity'] = df['uniq_Op'] / (df['total_Op'] + 1e-6)
end

python
# difficulty_effort_ratio
# Halstead difficulty divided by effort (d / e).
# Usefulness: Correlates with the use of inefficient coding practices, often linked to defect-prone code.
df['difficulty_effort_ratio'] = df['d'] / (df['e'] + 1e-6)
end

python
# intelligence_difficulty_product
# Product of Halstead intelligence and difficulty (i * d).
# Usefulness: Encodes compounding complexity and cognitive demand factors reflecting defect-prone modules.
df['intelligence_difficulty_product'] = df['i'] * df['d']
end

python
# branching_effort_interaction
# Effort multiplied by branch count (e * branchCount).
# Usefulness: Captures interaction between effort-intensive modules and complex control flows, indicative of defect risk.
df['branching_effort_interaction'] = df['e'] * df['branchCount']
end 

python
# normalized_volume_effort
# Halstead volume divided by effort (v / e).
# Usefulness: Efficiency metric capturing coding comprehension quality.
df['normalized_volume_effort'] = df['v'] / (df['e'] + 1e-6)
end

python
# mean_line_complexity
# Design complexity normalized by Halstead line count (iv(g) / lOCode).
# Usefulness: Reflects complexity levels of the module's architecture as related to code density, aiding defect prediction.
df['mean_line_complexity'] = df['iv(g)'] / (df['lOCode'] + 1e-6)
end

python
# code_documentation_ratio
# Ratio of commented lines to code lines (lOComment / lOCode).
# Usefulness: Indicates quality of documentation, which impacts understandability and defect likelihood.
df['code_documentation_ratio'] = df['lOComment'] / (df['lOCode'] + 1e-6)
end

python
df.drop(columns=['locCodeAndComment'], inplace=True)
end
