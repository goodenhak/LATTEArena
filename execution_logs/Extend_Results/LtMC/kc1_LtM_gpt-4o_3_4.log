# Usefulness: Indicates difficulty relative to code branching, helping to characterize structural bottlenecks.
df['difficulty_branch_ratio'] = df['d'] / (df['branchCount'] + 1)
end

python
# operator_uniqueness_effort_interaction
# Operator diversity multiplied by Halstead effort.
# Usefulness: Measures interaction between operator diversity and effort, potentially highlighting complex code patterns.
df['operator_uniqueness_effort_interaction'] = df['operator_diversity'] * df['e']
end

python
# operand_diversity_effort_interaction
# Operand uniqueness multiplied by Halstead effort.
# Usefulness: Similar to operator diversity interaction, but focused on operands. Helps identify intricate operand structures requiring effort.
df['operand_diversity_effort_interaction'] = df['operand_uniqueness'] * df['e']
end

python
# commented_code_ratio
# Ratio of lines of comments to (lines of code + 1) to avoid division by zero.
# Usefulness: Indicates quality documentation relative to code volume, which could correlate with fewer defects.
df['commented_code_ratio'] = df['lOComment'] / (df['loc'] + 1)
end

python
# log_effort
# Log-transformed Halstead effort.
# Usefulness: Stabilizes variance in effort, ensuring interpretability and mitigating skewed data.
df['log_effort'] = np.log(df['e'] + 1)
end

python
# sqrt_complexity_density
# Square root of complexity density.
# Usefulness: Reduces the impact of outliers, providing a balanced view on regions with high logical density.
df['sqrt_complexity_density'] = np.sqrt(df['complexity_density'])
end

python
# sigmoid_effort
# Sigmoid transformation of Halstead effort.
# Usefulness: Maps mental effort values into a bounded range, useful for models sensitive to scale.
df['sigmoid_effort'] = 1 / (1 + np.exp(-df['e']))
end

python
# zscore_complexity_density
# Z-score transformation for complexity density.
# Usefulness: Standardizes complexity density for statistical comparisons across modules.
df['zscore_complexity_density'] = (df['complexity_density'] - df['complexity_density'].mean()) / df['complexity_density'].std()
end

python
# branch_effort_product
# Branch count multiplied by Halstead effort.
# Usefulness: Captures the interaction between code branching and mental effort, highlighting potentially defect-prone areas.
df['branch_effort_product'] = df['branchCount'] * df['e']
end

python
# branch_effort_ratio
# Branch count divided by (Halstead effort + 1).
# Usefulness: Weighs code branching against effort intensity, providing insights into code performance relative to branching.
df['branch_effort_ratio'] = df['branchCount'] / (df['e'] + 1)
end

python
# unique_operand_complexity_interaction
# Unique operand count multiplied by cyclomatic complexity.
# Usefulness: Links operand uniqueness to complexity, potentially identifying intricate code logic.
df['unique_operand_complexity_interaction'] = df['uniq_Opnd'] * df['v(g)']
end

python
# unique_operator_complexity_interaction
# Unique operator count multiplied by design complexity.
# Usefulness: Captures interaction between operator uniqueness and design complexity, highlighting potential design bottlenecks.
df['unique_operator_complexity_interaction'] = df['uniq_Op'] * df['iv(g)']
end

