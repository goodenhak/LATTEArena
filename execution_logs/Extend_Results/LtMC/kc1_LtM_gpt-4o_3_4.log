# cyclomatic_complexity_per_loc
# Cyclomatic complexity per line of code, indicates density of control flow complexity within a module.
# Usefulness: High complexity density may increase defect likelihood due to inherent testing challenges.
df['cyclomatic_complexity_per_loc'] = df['v(g)'] / df['loc']
end

python
# halstead_volume_per_loc
# Halstead volume per line of code, captures cognitive load relative to size of the module.
# Usefulness: Modules with high cognitive load per line are often error-prone and harder to understand.
df['halstead_volume_per_loc'] = df['v'] / df['loc']
end

python
# branch_density
# Density of branching logic per line of code, from flow graph properties.
# Usefulness: Higher branching density reflects complex decision structures which may lead to defects.
df['branch_density'] = df['branchCount'] / df['loc']
end

python
# avg_operands_per_operator
# Average number of operands per operator to capture code clarity and operational intensity.
# Usefulness: Clearer operand usage typically leads to fewer defects in logical operations.
df['avg_operands_per_operator'] = df['n'] / df['uniq_Op']
end

python
# operator_operand_ratio
# Ratio of total operators to total operands, captures logic complexity in the operations.
# Usefulness: Modules with imbalanced operator-to-operand ratios may introduce logical flaws and defects.
df['operator_operand_ratio'] = df['total_Op'] / df['total_Opnd']
end

python
# essential_design_complexity_discrepancy
# Difference between essential and design complexity to highlight structural imbalance.
# Usefulness: Discrepancy in structural simplification versus design complexity could signal defect-prone areas.
df['essential_design_complexity_discrepancy'] = df['ev(g)'] - df['iv(g)']
end

python
# cyclomatic_minus_branch_complexity
# Difference between cyclomatic complexity and branching logic density.
# Usefulness: Captures non-linear flow characteristics that might introduce defects.
df['cyclomatic_minus_branch_complexity'] = df['v(g)'] - df['branchCount']
end

python
# log_halstead_volume
# Logarithmic transformation of Halstead volume to handle skewed data distribution.
# Usefulness: Reduces the impact of outliers in volume, while retaining its relation to defect likelihood.
df['log_halstead_volume'] = np.log1p(df['v'])
end

python
# sqrt_lines_of_code
# Square root of lines of code for outlier scaling.
# Usefulness: Compressing the range of line count can aid in better model interpretability.
df['sqrt_lines_of_code'] = np.sqrt(df['loc'])
end

python
# effort_program_length_interaction
# Multiplication interaction between effort and program length.
# Usefulness: Links cognitive development effort to the simplicity of program structure, aligned with defect probability.
df['effort_program_length_interaction'] = df['e'] * df['l']
end

python
# cumulative_operational_effort
# Cumulative sum of total operators and operands.
# Usefulness: Tracks total operational effort for modules sequentially, capturing aggregate complexity trends.
df['cumulative_operational_effort'] = df['total_Op'] + df['total_Opnd'].cumsum()
end

python
# comment_code_ratio
# Ratio of comment lines to total lines of code.
# Usefulness: Higher comment ratios can improve documentation clarity and reduce defect likelihood.
df['comment_code_ratio'] = df['lOComment'] / (df['loc'] + 1e-9)
end

python
# locCodeAndComment_ratio
# Ratio of lines combining code and comments to total lines of code.
# Usefulness: Provides insight into documentation practices in modules that impact code readability and defect-proneness.
df['locCodeAndComment_ratio'] = df['locCodeAndComment'] / (df['loc'] + 1e-9)
end

python
# standardized_cyclomatic_complexity
# Z-score normalization of cyclomatic complexity.
# Usefulness: Normalized scale enables easy comparison across modules with varying complexity levels.
df['standardized_cyclomatic_complexity'] = (df['v(g)'] - df['v(g)'].mean()) / df['v(g)'].std()
end

python
# standardized_lines_of_code
# Z-score normalization of lines of code.
# Usefulness: Reduces bias due to size variability between different software modules.
df['standardized_lines_of_code'] = (df['loc'] - df['loc'].mean()) / df['loc'].std()
end

python
# drop_unused_features
# Removing attributes that add minimal predictive value after transformation.
# Usefulness: Simplifies dataset by excluding redundant columns that are now represented in engineered features.
df.drop(columns=['lOBlank', 'locCodeAndComment'], inplace=True)
end
