# installment_to_income_ratio
# Feature description: Ratio of installment commitment to duration, reflecting the burden of repayments relative to repayment length.
# Usefulness: This combines two key repayment-related variables, compressing their combined signal to measure the strain on financial resources during the repayment period.
df['installment_to_income_ratio'] = df['installment_commitment'] / df['duration']
end

python
# log_credit_amount
# Feature description: Log-transformed credit amount to reduce skewness and amplify relative differences in credit size.
# Usefulness: Large differences in requested credit are better captured in a compressed log scale, which is more robust to outliers in financial data.
df['log_credit_amount'] = df['credit_amount'].apply(lambda x: np.log(x))
end

python
# repayment_burden
# Feature description: Approximates the total repayment burden by multiplying installment_commitment by duration.
# Usefulness: Captures the overall load of repayments over time, highlighting scenarios where extended durations could inflate the total burden.
df['repayment_burden'] = df['installment_commitment'] * df['duration']
end

python
# encoded_checking_status
# Feature description: One-hot encoded representation of checking_status.
# Usefulness: Converts nominal categories into numerical features, preserving the indication of financial liquidity.
df = pd.get_dummies(df, columns=['checking_status'], prefix='checking_status')
end

python
# encoded_savings_status
# Feature description: One-hot encoded representation of savings_status.
# Usefulness: Converts nominal categories into numerical features, capturing the availability and granularity of financial savings.
df = pd.get_dummies(df, columns=['savings_status'], prefix='savings_status')
end

python
# ordinal_employment
# Feature description: Ordinal encoding of employment duration (<1 = 1, 1<=X<4 = 2, 4<=X<7 = 3, >=7 = 4, unemployed = 0).
# Usefulness: Provides an ordered representation of employment stability, which correlates with financial reliability.
employment_map = {'unemployed': 0, '<1': 1, '1<=X<4': 2, '4<=X<7': 3, '>=7': 4}
df['ordinal_employment'] = df['employment'].map(employment_map)
end

python
# encoded_credit_history
# Feature description: Label-encoded representation of credit_history reflecting risk levels (no credits/all paid = 4, existing paid = 3, delayed previously = 2, critical/other = 1).
# Usefulness: Translates historical credit behavior into an ordinal scale, quantifying risk based on past reliability.
credit_history_map = {'no credits/all paid': 4, 'all paid': 4, 'existing paid': 3, 'delayed previously': 2, 'critical/other existing credit': 1}
df['encoded_credit_history'] = df['credit_history'].map(credit_history_map)
end

python
# credit_behavior_score
# Feature description: Combines credit_history (risk level) with existing_credits to reflect cumulative credit risk.
# Usefulness: Aggregates the weight of current credit reliability and the count of associated credits to assess overall credit behavior.
df['credit_behavior_score'] = df['encoded_credit_history'] * df['existing_credits']
end

python
# Drop unnecessary or redundant categorical columns
df.drop(columns=['checking_status', 'savings_status', 'employment', 'credit_history'], inplace=True)
end
