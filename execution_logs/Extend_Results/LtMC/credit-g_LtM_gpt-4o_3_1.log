# repayment_to_duration_ratio
# Feature description: Represents repayment burden normalized by loan duration using repayment_burden / duration.
# Usefulness: Standardizes repayment strain across different loan terms, which can help differentiate candidates with varying loan durations and repayment burdens.

df['repayment_to_duration_ratio'] = df['repayment_burden'] / df['duration']
end

python
# log_credit_behavior
# Feature description: Log transformation of credit_behavior_score.
# Usefulness: Stabilizes variance and highlights differences for higher credit behavior scores, offering better resolution for high-risk or stable candidates.

df['log_credit_behavior'] = np.log(df['credit_behavior_score'])
end

python
# savings_checking_liquidity
# Feature description: Combines low savings and low checking account status using savings_status_<100 & checking_status_<0.
# Usefulness: Provides a liquidity indicator to assess individuals with poor financial reserves, helping identify credit risks proactively.

df['savings_checking_liquidity'] = (df['savings_status_<100'] & df['checking_status_<0']).astype(int)
end

python
# employment_rank
# Feature description: Rank transformation of ordinal_employment.
# Usefulness: Strengthens the ordinal employment signal by emphasizing relative financial stability.

df['employment_rank'] = df['ordinal_employment'].rank(method=dense).astype(int)
end

python
# savings_high_threshold
# Feature description: Binary indicator for high savings status using (savings_status_500<=X<1000 | savings_status_100<=X<500).
# Usefulness: Differentiates individuals with moderate to high savings reserves, aiding in creditworthiness assessment.

df['savings_high_threshold'] = ((df['savings_status_500<=X<1000'] | df['savings_status_100<=X<500']).astype(int))
end

python
# job_property_cross
# Feature description: Interaction feature capturing job classification and property magnitude (job + '_' + property_magnitude).
# Usefulness: Reflects socioeconomic stability and financial assets simultaneously, enabling sharper credit profiling.

df['job_property_cross'] = df['job'] + '_' + df['property_magnitude']
end

python
df.drop(columns=['property_magnitude', 'job'], inplace=True)
end

python
# final_credit_decision
# Feature description: Prediction output feature based on dataset signal patterns and learned distributions.
# Usefulness: Aggregates numeric, categorical, and interaction signals to determine the binary credit approval decision.

df['final_credit_decision'] = np.where(
    (df['credit_behavior_score'] >= 3) & 
    (df['repayment_to_duration_ratio'] < 6) & 
    (df['employment_rank'] >= 2) &
    (df['savings_high_threshold'] == 1) &
    (df['savings_checking_liquidity'] == 0), 
    1, 0)
end
