# credit_to_duration_ratio
# Ratio of credit amount to loan duration, measuring proportional debt burden per month.
# Usefulness: Captures monthly repayment burden relative to loan size, directly tied to repayment pressure.
df['credit_to_duration_ratio'] = df['credit_amount'] / df['duration']
end

python
# credit_to_installment_ratio
# Ratio of credit amount to installment commitment, indicating how much debt is tied to fixed income expenditure.
# Usefulness: Highlights the proportion of disposable income consumed by repayments, aiding real-world credit assessment.
df['credit_to_installment_ratio'] = df['credit_amount'] / df['installment_commitment']
end

python
# log_credit_amount
# Logarithm of credit amount to reduce skewness and emphasize credit variations in lower ranges.
# Usefulness: Stabilizes variance for credit amount and captures the significance of small amounts in classification.
df['log_credit_amount'] = df['credit_amount'].apply(np.log1p)
end

python
# log_duration
# Log transformation of loan duration to handle skewness and normalize its distribution.
# Usefulness: Improves modeling by highlighting month-to-month variability in a stabilized manner.
df['log_duration'] = df['duration'].apply(np.log1p)
end

python
# target_encoded_checking_status
# Target encoding of checking_status based on historical approval rates.
# Usefulness: Encodes creditworthiness directly tied to prior approval rates associated with each checking_status.
df['target_encoded_checking_status'] = df.groupby('checking_status')['credit_approved'].transform('mean')
end

python
# target_encoded_savings_status
# Target encoding of savings_status based on historical approval outcomes.
# Usefulness: Reflects creditworthiness derived from the connection between savings and historical repayment behavior.
df['target_encoded_savings_status'] = df.groupby('savings_status')['credit_approved'].transform('mean')
end

python
# target_encoded_credit_history
# Target encoding of credit_history based on historical approval records.
# Usefulness: Directly captures the predictive influence of credit history patterns on approval decisions.
df['target_encoded_credit_history'] = df.groupby('credit_history')['credit_approved'].transform('mean')
end

python
# credit_history_checking_cross
# Interaction between credit_history and checking_status.
# Usefulness: Captures joint effects of creditworthiness-related features and their combined influence on approvals.
df['credit_history_checking_cross'] = df['credit_history'].astype(str) + '_' + df['checking_status'].astype(str)
end

python
# debt_to_income_proxy
# Proxy for debt-to-income ratio using credit amount, installment commitment, and employment duration.
# Usefulness: Serves as an approximation to gauge the borrower's ability to repay.
df['debt_to_income_proxy'] = df['credit_amount'] / (df['employment'].apply(lambda x: 1 if x == '<1' else int(x.split('<=X<')[-1].split('>')[0])) + df['installment_commitment'])
end

python
# residence_employment_stability
# Aggregated feature computing rank-based stability for residence_since and employment.
# Usefulness: Assesses socioeconomic stability by combining tenure effects in residence and job status.
df['residence_employment_stability'] = df['residence_since'] + df['employment'].apply(lambda x: {'<1': 0, '1<=X<4': 1, '4<=X<7': 2, '>=7': 3, 'unemployed': 0}[x])
end

python
# purpose_target_encoded
# Target encoding of the purpose field based on historical approval rates.
# Usefulness: Captures patterns between intended loan purposes and their likelihood of being associated with credit grants.
df['purpose_target_encoded'] = df.groupby('purpose')['credit_approved'].transform('mean')
end

python
# Drop redundant original columns (if necessary, based on transformations)
df.drop(columns=['credit_history', 'checking_status', 'savings_status'], inplace=True)
end
