2026-05-26 01:35:00,541 - INFO - ops_string = ["# ratio_nX_nO\n# Ratio of halogen atoms (nX) to oxygen atoms (nO + 1). This expresses the balance between halogenation and oxygenation, relevant for hetero-atom effects.\n# Usefulness: Helps capture the influence of halogens relative to oxygen, which can modulate chemical reactivity and environmental impact.\ndf['ratio_nX_nO'] = df['nX'] / (df['nO'] + 1)", "# ratio_nCp_SpMax_B_m\n# Ratio of terminal primary carbons (nCp) to the mass-weighted Burden eigenvalue (SpMax_B(m)). Represents the normalized contribution of carbon atom diversity in defining structure.\n# Usefulness: Highlights how structural properties driven by carbon atoms influence biodegradability.\ndf['ratio_nCp_SpMax_B_m'] = df['nCp'] / df['SpMax_B(m)']", "# ratio_abs_SdssC_log_C_percent\n# Ratio of absolute SdssC to log-transformed carbon percentage (log_C_percent). Captures the magnitude of carbon bonding relative to total carbon composition.\n# Usefulness: Provides a stability-aware feature for understanding the role of carbon bonding in chemical classification.\ndf['ratio_abs_SdssC_log_C_percent'] = df['abs_SdssC'] / df['log_C_percent']", "# exp_neg_Psi_i_A\n# Exponential decay of the intrinsic state pseudoconnectivity index (Psi_i_A). Models the vanishing impact of high connectivity states.\n# Usefulness: Explores nonlinear relationships for the pseudoconnectivity index that may influence the biodegradation process.\ndf['exp_neg_Psi_i_A'] = np.exp(-df['Psi_i_A'])", "# log_ratio_SdO_nO1\n# Logarithm of the ratio of SdO (oxygen bonding) to oxygen atoms (nO + 1) plus 1. Stabilizes feature derived from oxygen bonding and atom count.\n# Usefulness: Reduces variance and captures nuanced effects of oxygen bonding environments on biodegradability.\ndf['log_ratio_SdO_nO1'] = np.log(df['ratio_SdO_nO'] + 1)", "# cube_SpMax_L\n# Cube of the leading eigenvalue of the Laplace matrix (SpMax_L). Higher-order transformation for capturing complex interdependencies in molecular structure.\n# Usefulness: Accounts for nonlinear effects of molecular topology on biodegradability.\ndf['cube_SpMax_L'] = df['SpMax_L']  3", "# rolling_mean_SpMax_B_m\n# Rolling mean of SpMax_B(m) over a 5-row window. Captures trends in molecular size across sequential data points.\n# Usefulness: Identifies local patterns in molecular size changes that may influence classification.\ndf['rolling_mean_SpMax_B_m'] = df['SpMax_B(m)'].rolling(window=5).mean()", "# groupbythenmean_cumulative_nArNO2_Class\n# Grouped mean of cumulative_nArNO2 by class (target variable). Provides class-level summary statistics for aromatic nitro groups.\n# Usefulness: Captures class-specific distribution of aromatic nitro groups, which are indicative of biodegradability.\ndf['groupbythenmean_cumulative_nArNO2_Class'] = df.groupby('Class')['cumulative_nArNO2'].transform('mean')", "# groupbythenstd_SdO_Class\n# Grouped standard deviation of SdO (oxygen bonding states) by class (target variable). Examines the variability of oxygen bonding within each class.\n# Usefulness: Highlights structural diversity in oxygen bonding and its association with biodegradability.\ndf['groupbythenstd_SdO_Class'] = df.groupby('Class')['SdO'].transform('std')", "# drop_extra_features\n# Drop unused or irrelevant columns to reduce dimensionality and prevent contributions from noisy features.\n# Usefulness: Focuses the model on relevant descriptors and reduces potential for overfitting by removing less meaningful or redundant features.\ndf.drop(columns=['interaction_SdO_Psi', 'nN-N', 'B03[C-Cl]', 'cumulative_nArNO2'], inplace=True)"]
