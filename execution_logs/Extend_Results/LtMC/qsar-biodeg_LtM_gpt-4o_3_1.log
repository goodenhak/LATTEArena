# log_nCp
# Logarithm of number of terminal primary C(sp3) (nCp) plus 1.
# Usefulness: Stabilizes the variance and highlights the impact of terminal primary carbons which influence molecular branching.
df['log_nCp'] = np.log1p(df['nCp'])
end

python
# sqrt_SdO
# Square root of Sum of dO E-states (SdO).
# Usefulness: Reduces the scale of SdO while preserving relative differences, focusing on oxygen bonding contributions.
df['sqrt_SdO'] = np.sqrt(df['SdO'])
end

python
# ratio_SpMaxL_log_C_percent
# Ratio of SpMax_L to log_C_percent.
# Usefulness: Highlights the balance between molecular topology and the proportion of carbon atoms in the chemical structure.
df['ratio_SpMaxL_log_C_percent'] = df['SpMax_L'] / df['log_C_percent']
end

python
# abs_interaction_SdO_Psi
# Absolute value of interaction between SdO and Psi_i_A.
# Usefulness: Focuses on the magnitude of the bonding environment and the intrinsic state interaction for stability analysis.
df['abs_interaction_SdO_Psi'] = abs(df['interaction_SdO_Psi'])
end

python
# combined_C_N_ratio_log
# Log of F03C_O_F02C_N_ratio plus 1.
# Usefulness: Compresses the scale of the ratio, better capturing functional group interaction patterns that matter for biodegradability.
df['combined_C_N_ratio_log'] = np.log1p(df['F03C_O_F02C_N_ratio'])
end

python
# exp_zscore_SpMax_L
# Exponent of zscore_SpMax_L.
# Usefulness: Non-linearly amplifies deviations in eigenvalue-based topological descriptors for molecules.
df['exp_zscore_SpMax_L'] = np.exp(df['zscore_SpMax_L'])
end

python
# interaction_nO_SpMaxL
# Interaction between the number of oxygen atoms (nO) and SpMax_L.
# Usefulness: Captures the combined influence of oxygen atom count and molecular structural complexity.
df['interaction_nO_SpMaxL'] = df['nO'] * df['SpMax_L']
end

python
# sigmoid_SpMax_B(m)
# Sigmoid transformation of SpMax_B(m).
# Usefulness: Enhances interpretability of eigenvalues in a bounded space, capturing non-linear influences.
df['sigmoid_SpMax_B(m)'] = 1 / (1 + np.exp(-df['SpMax_B(m)']))
end

python
# cubic_SdssC
# Cube of SdssC.
# Usefulness: Emphasizes extreme values in the bonding environment while highlighting E-state irregularities.
df['cubic_SdssC'] = df['SdssC']  3
end

python
# minmax_Psi_i_A
# Min-max normalized Psi_i_A.
# Usefulness: Scales the intrinsic state pseudoconnectivity index for effective comparison across chemicals.
df['minmax_Psi_i_A'] = (df['Psi_i_A'] - df['Psi_i_A'].min()) / (
    df['Psi_i_A'].max() - df['Psi_i_A'].min())
end

python
# interaction_F02CN_nCIR
# Interaction of F02[C-N] and nCIR.
# Usefulness: Highlights functional group interaction with molecular circuits, relevant for structural assessment.
df['interaction_F02CN_nCIR'] = df['F02[C-N]'] * df['nCIR']
end

python
# log_nX_cumsum
# Logarithm of cumulative sum of halogen atoms (nX) plus 1.
# Usefulness: Tracks cumulative halogen presence, emphasizing their cumulative effect in a logarithmic scale.
df['log_nX_cumsum'] = np.log1p(df['nX'].cumsum())
end

python
# sine_Mi
# Sine of mean ionization potential (Mi).
# Usefulness: Applies a periodic transformation to highlight cyclic patterns in ionization behavior.
df['sine_Mi'] = np.sin(df['Mi'])
end

python
# groupbythenmean_nX_ready
# Mean value of nX grouped by biodegradability class.
# Usefulness: Explores average halogen atom count differences across classes.
df['groupbythenmean_nX_ready'] = df.groupby('class')['nX'].transform('mean')
end

python
df.drop(columns=['cumulative_nArNO2'], inplace=True)
end

python
df.drop(columns=['nCRX3'], inplace=True)
end

python
df.drop(columns=['N-073'], inplace=True)
end
