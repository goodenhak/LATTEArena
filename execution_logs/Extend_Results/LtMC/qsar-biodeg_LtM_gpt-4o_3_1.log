# abs_SdO
# Absolute value of SdO to focus on the magnitude of oxygen bonding environment.
# Usefulness: Captures the magnitude of E-states for oxygen, which aligns with bonding relevance in biodegradation.
df['abs_SdO'] = df['SdO'].abs()
end

python
# ratio_SdO_nCp
# Ratio of SdO to nCp+1 to evaluate oxygen bonding relative to terminal primary C(sp3).
# Usefulness: Highlights the interaction of oxygen with specific carbon configurations, potentially impacting biodegradation.
df['ratio_SdO_nCp'] = df['SdO'] / (df['nCp'] + 1)
end

python
# product_SdO_SpMax_B
# Product of SdO and SpMax_B(m) to combine oxygen bonding with the eigenvalue from Burden matrix weighted by mass.
# Usefulness: Bridges bonding relevance and molecular mass properties indicative of biodegradation potential.
df['product_SdO_SpMax_B'] = df['SdO'] * df['SpMax_B(m)']
end

python
# log_combined_C_O_C_ratio
# Logarithm transformation of combined_C_O_C_ratio to stabilize variance.
# Usefulness: Stabilizes the high variance in this feature, which combines bonding interactions and oxygen-carbon ratios.
df['log_combined_C_O_C_ratio'] = df['combined_C_O_C_ratio'].apply(lambda x: np.log(x + 1))
end

python
# interaction_SpMax_L_J_Dz
# Product of SpMax_L and J_Dz(e) to capture combined effects of Laplace-based metrics and electronegativity-weighted descriptors.
# Usefulness: Reflects interactions between different eigenvalue-based descriptors relevant to molecular structure.
df['interaction_SpMax_L_J_Dz'] = df['SpMax_L'] * df['J_Dz(e)']
end

python
# ratio_nO_nCp
# Ratio of nO to nCp+1 to balance oxygen and terminal primary C(sp3) effects.
# Usefulness: Represents a proportional relationship between oxygen and carbon configurations tied to biodegradation.
df['ratio_nO_nCp'] = df['nO'] / (df['nCp'] + 1)
end

python
# cross_combined_C_O_with_ratio_SdO_nO
# Interaction term (multiply) between combined_C_O_C_ratio and ratio_SdO_nO.
# Usefulness: Captures a higher-level interaction between oxygen-carbon ratios and SdO-derived features, enhancing biodegradability association.
df['cross_combined_C_O_with_ratio_SdO_nO'] = df['combined_C_O_C_ratio'] * df['ratio_SdO_nO']
end

python
# zscore_SdO
# Z-score normalization of SdO to center and scale values.
# Usefulness: Standardizes the oxygen bonding feature for easier integration into machine learning models.
df['zscore_SdO'] = (df['SdO'] - df['SdO'].mean()) / df['SdO'].std()
end

python
# rolling_mean_nCp
# Rolling mean of nCp over a window of 5 to capture local patterns in terminal primary C(sp3).
# Usefulness: Emphasizes short-term trends in carbon configuration that may contribute to biodegradability prediction.
df['rolling_mean_nCp'] = df['nCp'].rolling(window=5, min_periods=1).mean()
end

python
# cumulative_nX
# Cumulative sum of nX to monitor progressive influence of halogens across data points.
# Usefulness: Aggregates halogen atom counts, crucial for understanding halogen impact over the dataset.
df['cumulative_nX'] = df['nX'].cumsum()
end

python
# square_Psi_i_A
# Square transformation of Psi_i_A for higher-order modeling of intrinsic state connectivity.
# Usefulness: Highlights quadratic effects of intrinsic connectivity states linked to structural properties.
df['square_Psi_i_A'] = df['Psi_i_A']  2
end

python
# reciprocal_nArNO2
# Reciprocal transformation of nArNO2+1 for diminishing impact of outliers.
# Usefulness: Addresses sparsity of nitro group count while retaining meaningful influence on biodegradability.
df['reciprocal_nArNO2'] = 1 / (df['nArNO2'] + 1)
end

python
# abs_SdssC
# Absolute value of SdssC to focus on magnitude rather than sign of bonding environment E-states for carbon.
# Usefulness: Magnitude provides additional insight into bonding environments without directional bias.
df['abs_SdssC'] = df['SdssC'].abs()
end

python
df.drop(columns=['F02[C-N]', 'F03C_O_F02C_N_ratio'], inplace=True)
end
