2026-05-26 01:35:59,744 - INFO - ops_string = ["# log_nO_plus_log_nX\n# Sum of logarithms of nO and nX plus 1, capturing combined atomic composition diversity for oxygen and halogens.\n# Usefulness: Highlights interplay between oxygen and halogen abundance, which are critical for chemical reactivity and biodegradability.\ndf['log_nO_plus_log_nX'] = df['log_nO'] + df['log_nX']", "# ratio_nO_nCp\n# Ratio of number of oxygen atoms (nO) to number of terminal primary C(sp3) (nCp) plus 1.\n# Usefulness: Evaluates the balance between oxygen and carbon-based structures, essential for molecular degradation potential.\ndf['ratio_nO_nCp'] = df['nO'] / (df['nCp'] + 1)", "# interaction_SdO_Psi_i_A\n# Interaction between SdO (sum of dO E-states) and Psi_i_A (intrinsic state pseudoconnectivity index).\n# Usefulness: Captures the relationship between oxygen bonding environments and intrinsic molecular connectivity.\ndf['interaction_SdO_Psi_i_A'] = df['SdO'] * df['Psi_i_A']", "# square_SdO\n# Square of sum of dO E-states (SdO) to amplify higher values of oxygen bonding.\n# Usefulness: Highlights stronger oxygen bonding patterns, which are important for reactivity and biodegradation.\ndf['square_SdO'] = df['SdO']  2", "# cube_F02C_N\n# Cube of frequency of C-N bonds at topological distance 2 (F02[C-N]).\n# Usefulness: Amplifies the impact of higher frequencies of C-N bonds, which can relate to specific compound reactivity.\ndf['cube_F02C_N'] = df['F02[C-N]']  3", "# ratio_SdO_SdssC\n# Ratio of sum of dO E-states (SdO) to absolute value of SdssC plus a small epsilon (0.001).\n# Usefulness: Analyzes the relationship between oxygen bonding and carbon bonding environments in a stable manner.\ndf['ratio_SdO_SdssC'] = df['SdO'] / (df['abs_SdssC'] + 0.001)", "# sigmoid_Mi\n# Sigmoid transformation of mean first ionization potential (Mi).\n# Usefulness: Nonlinear scaling emphasizes mid-range ionization potentials relevant for chemical activity.\ndf['sigmoid_Mi'] = 1 / (1 + np.exp(-df['Mi']))", "# relative_C_O_ratio\n# Ratio of combined_C_O_C_ratio to sigmoid transformation of log_C_percent.\n# Usefulness: Highlights the relative carbon-to-oxygen influence scaled by molecular carbon percentage effects.\ndf['relative_C_O_ratio'] = df['combined_C_O_C_ratio'] / df['sigmoid_log_C_percent']", "# ratio_SpMax_B_nCIR\n# Ratio of SpMax_B(m) (leading eigenvalue from Burden matrix) to number of circuits (nCIR) plus 1.\n# Usefulness: Assesses global molecular descriptors relative to circuit counts for topological complexity.\ndf['ratio_SpMax_B_nCIR'] = df['SpMax_B(m)'] / (df['nCIR'] + 1)", "# exp_SpMax_B\n# Exponential transformation of SpMax_B(m) (leading eigenvalue from Burden matrix).\n# Usefulness: Enhances high descriptor values to reflect their significance in molecular topology.\ndf['exp_SpMax_B'] = np.exp(df['SpMax_B(m)'])", "# Sag_environment\n# Product of SdO (sum of dO E-states) and Psi_i_A (intrinsic state pseudoconnectivity index).\n# Usefulness: Captures combined effects of oxygen bonding and molecular connectivity on chemical behavior.\ndf['Sag_environment'] = df['SdO'] * df['Psi_i_A']", "# drop_cumulative_nArNO2\n# Drop cumulative_nArNO2 as it does not directly provide individual chemical molecule differentiation.\ndf.drop(columns=['cumulative_nArNO2'], inplace=True)", "# drop_F03C_O_F02C_N_ratio\n# Drop F03C_O_F02C_N_ratio due to its extreme range and potential instability for reliable patterns.\ndf.drop(columns=['F03C_O_F02C_N_ratio'], inplace=True)"]
