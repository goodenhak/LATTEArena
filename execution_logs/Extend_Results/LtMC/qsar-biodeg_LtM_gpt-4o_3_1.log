# nO_nHDon_interaction
# Product of number of oxygen atoms (nO) and number of hydrogen bond donor atoms (nHDon).
# Usefulness: Highlights the interplay between oxygen and hydrogen donor atoms, which are critical for biodegradability. 
df['nO_nHDon_interaction'] = df['nO'] * df['nHDon']
end

python
# F03C_O_C_percent_ratio
# Ratio of frequency of C-O bonds at topological distance 3 (F03[C-O]) to percentage of Carbon atoms (C%).
# Usefulness: Normalizes C-O bond presence by carbon composition, providing a scale-independent insight into oxidizable carbon bonding.
df['F03C_O_C_percent_ratio'] = df['F03[C-O]'] / (df['C%'] + 1e-5)
end

python
# SdO_SdssC_interaction
# Sum of SdO and SdssC (bonding environment E-states for oxygen and carbon).
# Usefulness: Aggregates carbon and oxygen E-states, relevant for assessing molecular reactive sites.
df['SdO_SdssC_interaction'] = df['SdO'] + df['SdssC']
end

python
# SpMax_L_TI2_L_sum
# Sum of leading eigenvalue from Laplace matrix (SpMax_L) and second Mohar index from Laplace matrix (TI2_L).
# Usefulness: Combines topological molecular descriptors to represent molecular structure comprehensively.
df['SpMax_L_TI2_L_sum'] = df['SpMax_L'] + df['TI2_L']
end

python
# log_nO
# Logarithm of number of oxygen atoms (nO) plus 1.
# Usefulness: Dampens the range of nO to reduce scale variability and emphasize lower values more sensitively.
df['log_nO'] = np.log(df['nO'] + 1)
end

python
# square_J_Dz_e
# Square of Balaban-like index from Barysz matrix weighted by Sanderson electronegativity (J_Dz(e)).
# Usefulness: Highlights nonlinear effects of electronegativity-weighted graph indices on biodegradability.
df['square_J_Dz_e'] = df['J_Dz(e)']  2
end

python
# nN_nO_ratio
# Ratio of number of nitrogen atoms (nN) to number of oxygen atoms (nO).
# Usefulness: Captures the nitrogen-to-oxygen relationship, which is critical for classifying nitrogenous or oxygenated compounds' degradation.
df['nN_nO_ratio'] = df['nN'] / (df['nO'] + 1e-5)
end

python
# F03C_O_F02C_N_ratio
# Ratio of frequency of C-O bonds (F03[C-O]) to frequency of C-N bonds at topological distance 2 (F02[C-N]).
# Usefulness: Compares C-O and C-N bond occurrence normalized to each other, which can indicate degradation site priority.
df['F03C_O_F02C_N_ratio'] = df['F03[C-O]'] / (df['F02[C-N]'] + 1e-5)
end

python
# zscore_SpMax_L
# Z-score normalization of SpMax_L (leading eigenvalue from Laplace matrix).
# Usefulness: Normalizes SpMax_L across the data, facilitating comparisons across differing magnitudes.
df['zscore_SpMax_L'] = (df['SpMax_L'] - df['SpMax_L'].mean()) / df['SpMax_L'].std()
end

python
# nHDon_Me_interaction
# Product of nHDon (number of H-bond donors) and Me (mean atomic Sanderson electronegativity).
# Usefulness: Represents how donor capacity interacts with electronegativity, key for biodegradation.
df['nHDon_Me_interaction'] = df['nHDon'] * df['Me']
end

python
# C_percent_nO_ratio
# Ratio of percentage of Carbon atoms (C%) to number of oxygen atoms (nO).
# Usefulness: Reflects carbon-to-oxygen ratio, important for assessing oxidation-linked degradation pathways.
df['C_percent_nO_ratio'] = df['C%'] / (df['nO'] + 1e-5)
end

python
# log_C_percent
# Logarithm of percentage of Carbon atoms (C%) plus 1.
# Usefulness: Dampens scale variability of carbon percentage and emphasizes smaller values more.
df['log_C_percent'] = np.log(df['C%'] + 1)
end

python
# lag_SdO
# Lag feature for Sum of dO E-states (SdO).
# Usefulness: Evaluates temporal or preceding-state influence of SdO in sequences, potentially identifying patterns over time.
df['lag_SdO'] = df['SdO'].shift(1)
end

python
# rank_Tl2_L
# Ranking feature for second Mohar index from Laplace matrix (TI2_L).
# Usefulness: Converts numerical values into ranks for evaluating relative positions without distributional assumptions.
df['rank_Tl2_L'] = df['TI2_L'].rank()
end
