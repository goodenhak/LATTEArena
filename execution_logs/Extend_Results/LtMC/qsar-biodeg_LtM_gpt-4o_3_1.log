# log_F03C_O_F02C_N_ratio
# Logarithm of F03C_O_F02C_N_ratio plus 1 to reduce skewness.
# Usefulness: Reduces skewness in the F03C_O_F02C_N_ratio feature, which has a highly skewed range, and highlights interactions between C-O and C-N bonds.
df['log_F03C_O_F02C_N_ratio'] = np.log(df['F03C_O_F02C_N_ratio'] + 1)
end

python
# ratio_SdO_nO
# Ratio of SdO to (nO + 1) to evaluate oxygen bonding relative to oxygen atoms.
# Usefulness: Captures the relationship between bonding environment and oxygen atom presence, which is important for biodegradability.
df['ratio_SdO_nO'] = df['SdO'] / (df['nO'] + 1)
end

python
# interaction_SdO_Psi
# Interaction between SdO and Psi_i_A to combine bonding environment with intrinsic state index.
# Usefulness: Highlights how the bonding environment interacts with molecular connectivity properties for classifying biodegradability.
df['interaction_SdO_Psi'] = df['SdO'] * df['Psi_i_A']
end

python
# zscore_SpMax_L
# Z-score normalization of SpMax_L to normalize values.
# Usefulness: Normalizes the feature SpMax_L concerning molecular topology, enabling better comparability across samples.
df['zscore_SpMax_L'] = (df['SpMax_L'] - df['SpMax_L'].mean()) / df['SpMax_L'].std()
end

python
# log_nX
# Logarithm of nX plus 1 to stabilize its variance.
# Usefulness: Helps handle skewness in the number of halogen atoms (nX) by reducing the range of extreme values.
df['log_nX'] = np.log(df['nX'] + 1)
end

python
# combined_C_O_C_ratio
# Interaction of F03[C-O] and SpMax_L divided by log_C_percent.
# Usefulness: Links bonding environment (C-O bonds) with molecular topology (leading eigenvalue) and normalizes by carbon content.
df['combined_C_O_C_ratio'] = (df['F03[C-O]'] * df['SpMax_L']) / df['log_C_percent']
end

python
# abs_SdssC
# Absolute value of SdssC to focus on the magnitude of SdssC values.
# Usefulness: Simplifies the interpretation of extreme values in SdssC, which represent unique carbon bonding environments.
df['abs_SdssC'] = df['SdssC'].abs()
end

python
# sigmoid_log_C_percent
# Sigmoid transformation of log_C_percent to scale it non-linearly.
# Usefulness: Introduces non-linear scaling on carbon content, potentially reflecting logistic effects in biodegradability.
df['sigmoid_log_C_percent'] = 1 / (1 + np.exp(-df['log_C_percent']))
end

python
# cumulative_nArNO2
# Cumulative sum of nArNO2 across the dataset.
# Usefulness: Tracks the overall distribution of nitro groups, aiding in understanding their cumulative effect on biodegradability.
df['cumulative_nArNO2'] = df['nArNO2'].cumsum()
end

python
# sqrt_F02_C_N
# Square root of F02[C-N] to reduce skewness and emphasize smaller values.
# Usefulness: Emphasizes the importance of smaller values of C-N frequency in predicting biodegradability trends.
df['sqrt_F02_C_N'] = np.sqrt(df['F02[C-N]'])
end

