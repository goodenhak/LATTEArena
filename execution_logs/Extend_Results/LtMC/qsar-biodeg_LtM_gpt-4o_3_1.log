2026-05-26 01:37:14,697 - INFO - ops_string = ["# log_SpMax_L\n# Logarithm of SpMax_L to stabilize its variance and capture patterns in molecular topology.\n# Usefulness: SpMax_L relates to molecular connectivity, and log transformation helps stabilize skewness in its distribution.\ndf['log_SpMax_L'] = np.log(df['SpMax_L'])", "# SpMax_B_to_L_ratio\n# Ratio of SpMax_B(m) to SpMax_L to assess the relationship between Burden and Laplacian eigenvalues.\n# Usefulness: Captures the interaction between structure-derived eigenvalues, which could be indicative of molecule complexity.\ndf['SpMax_B_to_L_ratio'] = df['SpMax_B(m)'] / df['SpMax_L']", "# sqrt_F03C_O_F02C_N_ratio\n# Square root of F03C_O_F02C_N_ratio to reduce the range of ratio while keeping its proportional importance.\n# Usefulness: This feature captures the balance of specific chemical bonds related to oxygen (C-O) and nitrogen (C-N).\ndf['sqrt_F03C_O_F02C_N_ratio'] = np.sqrt(df['F03C_O_F02C_N_ratio'])", "# total_atom_count\n# Sum of nCp, nO, and nX to obtain the total number of key atoms.\n# Usefulness: Aggregates critical atom counts that influence biodegradability.\ndf['total_atom_count'] = df['nCp'] + df['nO'] + df['nX']", "# SpMax_L_log_C_interaction\n# Product of SpMax_L and log_C_percent to capture the interaction between molecular topology and carbon composition.\n# Usefulness: Highlights the contribution of structural connectivity in tandem with carbon concentration.\ndf['SpMax_L_log_C_interaction'] = df['SpMax_L'] * df['log_C_percent']", "# sigmoid_SdO\n# Sigmoid transformation of SdO to capture the nonlinear distribution of oxygen bonding environments.\n# Usefulness: Stabilizes and compresses the range of SdO while preserving nonlinear effects.\ndf['sigmoid_SdO'] = 1 / (1 + np.exp(-df['SdO']))", "# abs_SdO_minus_SpMax_B\n# Absolute difference between SdO and SpMax_B(m) to measure their magnitude difference.\n# Usefulness: Highlights significant discrepancies between oxygen bonding states and structural eigenvalues.\ndf['abs_SdO_minus_SpMax_B'] = abs(df['SdO'] - df['SpMax_B(m)'])", "# nO_to_nCp_ratio\n# Ratio of nO to (nCp + 1) to evaluate how oxygen atom count compares to terminal primary carbons.\n# Usefulness: An important indicator of oxygen density relative to carbon structure.\ndf['nO_to_nCp_ratio'] = df['nO'] / (df['nCp'] + 1)", "# interaction_Psi_nCp\n# Interaction between Psi_i_A and nCp to connect intrinsic molecular state and terminal primary carbons.\n# Usefulness: Captures the relationship between molecular connectivity and terminal carbon structures.\ndf['interaction_Psi_nCp'] = df['Psi_i_A'] * df['nCp']", "# zscore_nO\n# Z-score normalization of nO to standardize oxygen atom counts.\n# Usefulness: Normalizes oxygen counts to highlight their variation relative to other features.\ndf['zscore_nO'] = (df['nO'] - df['nO'].mean()) / df['nO'].std()", "# ratio_SpMax_B_and_Psi\n# Ratio of SpMax_B(m) to Psi_i_A to assess how structural topology and intrinsic connectivity relate.\n# Usefulness: Connects macro molecule structure with micro-level state indices.\ndf['ratio_SpMax_B_and_Psi'] = df['SpMax_B(m)'] / df['Psi_i_A']", "# log_interaction_nO_and_Cpercent\n# Log-transformed interaction between nO and log_C_percent to stabilize their product’s variance.\n# Usefulness: Captures joint effects of oxygen atom count and carbon concentration on biodegradability.\ndf['log_interaction_nO_and_Cpercent'] = np.log((df['nO'] + 1) * df['log_C_percent'])", "# drop_columns\ndf.drop(columns=['F03C_O_F02C_N_ratio', 'nCRX3', 'N-073'], inplace=True)"]
