# interaction_SpMax_B_nO
# Interaction between SpMax_B(m) and number of oxygen atoms (nO). Captures the effect of topology weighted by mass with oxygen content.
# Usefulness: Models structural influence combined with heteroatom content, relevant for chemical biodegradability.
df['interaction_SpMax_B_nO'] = df['SpMax_B(m)'] * df['nO']
end

python
# ratio_Psi_i_A_SdssC
# Ratio of intrinsic state pseudoconnectivity index (Psi_i_A) to sum of dssC (carbon bonding E-states).
# Usefulness: Explores relative pseudoconnectivity effects normalized by carbon bonding influence.
df['ratio_Psi_i_A_SdssC'] = df['Psi_i_A'] / (df['abs_SdssC'] + 1)
end

python
# log_interaction_SdO_Psi
# Logarithm of interaction between SdO (oxygen bonding environment) and Psi_i_A (pseudoconnectivity index) plus 1.
# Usefulness: Reduces skewness and highlights nonlinear relationships relevant to biodegradability.
df['log_interaction_SdO_Psi'] = np.log(df['interaction_SdO_Psi'] + 1)
end

python
# sqrt_SdO
# Square root of SdO (bonding environment E-states for oxygen).
# Usefulness: Captures nonlinear contributions of oxygen bonding to the molecular structure.
df['sqrt_SdO'] = np.sqrt(df['SdO'])
end

python
# relative_nO_nX
# Ratio of number of oxygen atoms (nO) to the number of halogen atoms (nX) plus 1.
# Usefulness: Highlights the relative presence of oxygen vs. halogens, key for modeling biodegradability.
df['relative_nO_nX'] = df['nO'] / (df['nX'] + 1)
end

python
# relative_SpMax_L_JDz
