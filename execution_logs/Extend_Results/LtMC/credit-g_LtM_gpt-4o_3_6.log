# feature_credit_to_income_ratio
# Feature description: Ratio of credit_amount to (age - 18 + 1), estimating the credit amount proportional to income age.
# Usefulness: Captures an estimate of credit eligibility based on earning age, considering larger loans may be riskier for younger individuals with less earning experience.
df['feature_credit_to_income_ratio'] = df['credit_amount'] / (df['age'] - 18 + 1)
end

python
# feature_repayment_burden_score
# Feature description: A combined index using final_inst_to_income_ratio and monthly_installment to summarize repayment burden.
# Usefulness: Direct measure of debt affordability over time, linking repayment capacity and income proxy.
df['feature_repayment_burden_score'] = df['final_inst_to_income_ratio'] * df['monthly_installment']
end

python
# feature_age_savings_maturity
# Feature description: Interaction of savings_status and age to reflect age-aligned savings capability.
# Usefulness: Models long-term financial planning and ability to save, which can correlate with credit repayment reliability.
df['feature_age_savings_maturity'] = df['age'] * df['savings_status'].apply(lambda x: 1 if x == '<100' else 2 if x == '100<=X<500' else 3 if x == '500<=X<1000' else 4 if x == '>=1000' else 0)
end

python
# feature_installment_volatility
# Feature description: Standard deviation of the installment_commitment for the individual's employment type (installment_std_by_employment).
# Usefulness: Indicates variability in repayment commitment across employment stability groups, modeling financial behavior risk.
df['feature_installment_volatility'] = df['installment_std_by_employment']
end

python
# feature_dependency_weighted_burden
# Feature description: dependency_ratio multiplied by repayment_burden proxy (installment_to_income_ratio).
# Usefulness: Reflects financial stress scaled by dependents, combining income burden and responsibilities.
df['feature_dependency_weighted_burden'] = df['dependency_ratio'] * df['installment_to_income_ratio']
end

python
# feature_combined_property_risk
# Feature description: Encoded risk score for property_housing_combined, with higher scores for riskier lifestyle combinations.
# Usefulness: Models how property and housing decisions affect credit risk (e.g., 'own' housing may signal stability, 'for free' and 'no known property' signal risk).
property_risk_map = {'car_own': 1, 'life insurance_own': 2, 'real estate_rent': 3, 'no known property_for free': 4, 
                     'real estate_for free': 5, 'life insurance_rent': 6, 'real estate_own': 7, 
                     'no known property_own': 8, 'car_rent': 9, 'no known property_rent': 10, 
                     'car_for free': 11, 'life insurance_for free': 12}
df['feature_combined_property_risk'] = df['property_housing_combined'].map(property_risk_map)
end

python
# feature_employment_times_credit
# Feature description: Employment stability label (employment_label) multiplied by credit_amount to reflect job stability and loan size correlation.
# Usefulness: Captures the interaction between financial responsibility and stability in employment versus loan expectations.
df['feature_employment_times_credit'] = df['employment_label'] * df['credit_amount']
end

python
# feature_lifecycle_credit_load
# Feature description: avg_credit_weight_by_age multiplied by personal_status_label to estimate credit load by life stage.
# Usefulness: Models how life stage (e.g., single, married) affects one's credit profile when considering past credit intensity.
df['feature_lifecycle_credit_load'] = df['avg_credit_weight_by_age'] * df['personal_status_label']
end

python
# feature_purpose_weighted_duration
# Feature description: Numeric encode of purpose multiplied by duration of credit to estimate purpose-driven repayment cycles.
# Usefulness: Helps predict duration-based credit decisions based on purpose trends such as short-term (e.g., radio/tv) vs. long-term (e.g., real estate).
purpose_map = {'radio/tv': 1, 'new car': 2, 'furniture/equipment': 3, 'used car': 4, 'business': 5, 
               'repairs': 6, 'education': 7, 'domestic appliance': 8, 'other': 9, 'retraining': 10}
df['feature_purpose_weighted_duration'] = df['purpose'].map(purpose_map) * df['duration']
end

python
# Dropping less critical columns
df.drop(columns=['installment_std_by_employment', 'property_housing_combined'], inplace=True)
end
