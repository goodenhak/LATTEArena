# repayment_to_income_ratio
# Ratio of monthly_installment to avg_credit_per_year to represent repayment burden relative to normalized income.
# Usefulness: Captures repayment risk by assessing monthly repayment pressure against normalized annual credit values.
df['repayment_to_income_ratio'] = df['monthly_installment'] / df['avg_credit_per_year']
end

python
# financial_stability_score
# Interaction term of residence_since and employment_label to measure stability in both residential and employment factors.
# Usefulness: Highlights consistency in financial and living situations, which impacts credit-worthiness.
df['financial_stability_score'] = df['residence_since'] * df['employment_label']
end

python
# overall_liquidity_score
# Combined categorical representation of savings_status and checking_status (cross interaction of liquidity metrics).
# Usefulness: Captures overall liquidity by combining two strong indicators of financial health.
df['overall_liquidity_score'] = df['savings_status'].astype(str) + _ + df['checking_status'].astype(str)
end

python
# repayment_efficiency
# Ratio of repayment_pressure_score to lifetime_credit_efficiency to evaluate repayment burden efficiency.
# Usefulness: Balances repayment stress with long-term credit usage efficiency for a comprehensive risk profile.
df['repayment_efficiency'] = df['repayment_pressure_score'] / df['lifetime_credit_efficiency']
end

python
# category_housing_credit_utilization
# Group-by mean credit_amount for each combination of housing and purpose to assess specific category credit behavior.
# Usefulness: Unveils credit patterns tailored to housing and purpose, enabling targeted financial analysis.
df['category_housing_credit_utilization'] = df.groupby(['housing', 'purpose'])['credit_amount'].transform('mean')
end

python
# normalized_risk_history
# Risk-adjusted credit history normalized by installment_commitment for repayment stress.
# Usefulness: Connects credit history risk while standardizing against disposable income commitment.
df['normalized_risk_history'] = df['risk_adjusted_credit_history'] / df['installment_commitment']
end

python
# repayment_latency_factor
# Ratio of employment_label to risk_adjusted_credit_history to encapsulate financial stability against repayment risks.
# Usefulness: Creates a scaled metric blending employment stability with contextual repayment risk.
df['repayment_latency_factor'] = df['employment_label'] / df['risk_adjusted_credit_history']
end

python
# monthly_to_group_credit_ratio
# Ratio of monthly_installment to group_credit_by_job for identifying repayment burden relative to job-specific credit patterns.
