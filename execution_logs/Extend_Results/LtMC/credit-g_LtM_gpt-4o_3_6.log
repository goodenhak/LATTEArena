# repayment_pressure_score
# Feature description: Weighted average combining installment_to_income_ratio and monthly_installment to create a high-level summary of repayment burden.
# Usefulness: Captures affordability and repayment pressure by consolidating granular ratios and installment data.
df['repayment_pressure_score'] = df['final_inst_to_income_ratio'] * 0.5 + df['monthly_installment'] * 0.5
end

python
# lifetime_credit_efficiency
# Feature description: Ratio of avg_credit_weight_by_age to avg_credit_per_year. Indicates efficiency of credit use over a lifetime relative to year-by-year credit utilization.
# Usefulness: Measures long-term credit efficiency and earning potential sustainability.
df['lifetime_credit_efficiency'] = df['avg_credit_weight_by_age'] / df['avg_credit_per_year']
end

python
# stability_index
# Feature description: Composite index combining employment_label, dependency_ratio, residence_since, and foreign_worker_encoded to summarize stability in a single metric.
# Usefulness: Aggregates multiple stability-related factors into a holistic view of personal and financial stability.
df['stability_index'] = (df['employment_label'] * 0.4 + (1 - df['dependency_ratio']) * 0.3 + df['residence_since'] * 0.2 + df['foreign_worker_encoded'] * 0.1)
end

python
# repayment_age_interaction
