# savings_to_installment_ratio
# Ratio of labeled savings_status to installment_commitment, indicating savings available relative to repayment burden.
# Usefulness: Combines saving strength with repayment commitment to assess financial affordability.
df['savings_to_installment_ratio'] = df['savings_status'].apply(lambda x: {'no known savings': 0, '<100': 1, '100<=X<500': 2, '500<=X<1000': 3, '>=1000': 4}[x]) / df['installment_commitment']
end

