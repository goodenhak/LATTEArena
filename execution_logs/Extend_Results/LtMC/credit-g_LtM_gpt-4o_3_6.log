# installment_to_income_ratio
# Ratio of installment_commitment to residence_since as a proxy for income saving over time.
# Usefulness: Captures affordability by comparing repayment burden to years of stable residence, reflecting financial prudence.
df['installment_to_income_ratio'] = df['installment_commitment'] / df['residence_since']
end

python
# avg_credit_per_year
# Credit amount normalized by years since adulthood (age - 18 + 1).
# Usefulness: Measures how aggressively credit is being taken compared to an individual's earning life, reflecting risk-taking behavior.
df['avg_credit_per_year'] = df['credit_amount'] / (df['age'] - 18 + 1)
end

python
# final_inst_to_income_ratio
# Higher granularity ratio of installment_commitment to residence_since.
# Usefulness: Provides refined insight into affordability and financial burden trends over time.
df['final_inst_to_income_ratio'] = df['installment_commitment'] / (df['residence_since'] + 0.0001)
end

python
# dependency_ratio
# Ratio of number of dependents to years at current residence.
# Usefulness: Reflects financial strain considering how residence duration affects household expenditures.
df['dependency_ratio'] = df['num_dependents'] / df['residence_since']
end

python
# property_housing_combined
# Interaction term combining property magnitude and housing categories.
# Usefulness: Links asset ownership and housing type to reflect overall financial security.
df['property_housing_combined'] = df['property_magnitude'] + '_' + df['housing']
end

python
# group_credit_by_job
# Mean credit amount grouped by job type.
# Usefulness: Reflects typical credit levels expected based on employment income brackets and stability.
df['group_credit_by_job'] = df.groupby('job')['credit_amount'].transform('mean')
end

python
# employment_label
# Label-encode employment categories to represent stability based on duration of employment.
# Usefulness: Encodes job stability which is a reliable proxy for repayment capacity.
df['employment_label'] = df['employment'].map({'<1': -1, '1<=X<4': 0, '4<=X<7': 2, '>=7': 3, 'unemployed': -1})
end

python
# credit_history_label
# Numerically encode credit_history categories.
# Usefulness: Encodes credit reliability based on past credit performance to simplify downstream modeling.
df['credit_history_label'] = df['credit_history'].map({
    'no credits/all paid': 4, 
    'all paid': 3, 
    'existing paid': 2, 
    'delayed previously': 1, 
