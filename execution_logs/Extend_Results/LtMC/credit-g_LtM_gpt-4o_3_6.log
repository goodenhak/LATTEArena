# savings_to_installment_ratio
# Ratio of labeled savings_status to installment_commitment, indicating savings available relative to repayment burden.
# Usefulness: Combines saving strength with repayment commitment to assess financial affordability.
df['savings_to_installment_ratio'] = df['savings_status'].apply(lambda x: {'no known savings': 0, '<100': 1, '100<=X<500': 2, '500<=X<1000': 3, '>=1000': 4}[x]) / df['installment_commitment']
end

python
# log_credit_amount
# Log transformation of credit_amount to reduce skewness and better highlight smaller, yet impactful, credit amounts.
# Usefulness: Stabilizes distribution of credit_amount, making it more comparable across values.
df['log_credit_amount'] = np.log(df['credit_amount'] + 1)
end

python
# savings_to_duration_ratio
# Ratio of label-encoded savings_status to duration, reflecting savings power per month of credit duration.
# Usefulness: Encodes financial reserve strength relative to the length of credit exposure.
df['savings_to_duration_ratio'] = df['savings_status'].apply(lambda x: {'no known savings': 0, '<100': 1, '100<=X<500': 2, '500<=X<1000': 3, '>=1000': 4}[x]) / df['duration']
end

python
# final_dependency_ratio
# Multiply dependency_ratio by avg_credit_weight_by_age for weighted financial dependency strength.
# Usefulness: Captures dependency impact factoring earning potential and credit distribution.
df['final_dependency_ratio'] = df['dependency_ratio'] * df['avg_credit_weight_by_age']
end

python
# employment_burden_score
# Product of employment_label and installment_to_income_ratio, signaling likelihood of repayment based on job stability and affordability.
# Usefulness: Combines stability of employment with repayment burden for nuanced credit analysis.
df['employment_burden_score'] = df['employment_label'] * df['installment_to_income_ratio']
end

python
# duration_credit_history_interaction
# Interaction term dividing duration by credit_history_label, measuring credit duration adjusted for past credit behavior.
# Usefulness: Connects the length of credit exposure to the quality of previous credit history.
df['duration_credit_history_interaction'] = df['duration'] / (df['credit_history_label'] + 1)
end

python
# avg_credit_burden_score
# Ratio of avg_credit_per_year to final_inst_to_income_ratio, combining yearly credit and repayment burden into an affordability metric.
# Usefulness: Encodes yearly credit use as a function of overall savings vs. burden balance.
df['avg_credit_burden_score'] = df['avg_credit_per_year'] / df['final_inst_to_income_ratio']
end

python
# residence_employment_interaction
# Product of residence_since and employment_label to capture stability across residence and employment.
# Usefulness: Reflects ecological and job stability, critical for repayment reliability.
df['residence_employment_interaction'] = df['residence_since'] * df['employment_label']
end

python
# weighted_credit_group_job
# Grouped mean credit_amount per job type weighted by installment_std_by_employment.
# Usefulness: Represents typical credit allocation per job type adjusted for variability in repayment obligations.
df['weighted_credit_group_job'] = df['group_credit_by_job'] * df['installment_std_by_employment']
end

python
# rolling_std_duration
# Rolling standard deviation of duration over window=3 to observe fluctuations in credit periods.
# Usefulness: Identifies inconsistencies in credit period lengths, signaling risk or variability.
