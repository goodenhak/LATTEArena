# repayment_pressure_score_zscore
# Z-score normalization of repayment_pressure_score to handle scale differences and highlight relative repayment pressure.
# Usefulness: Standardizes repayment pressure across individuals, making it easier to compare burdens.

df['repayment_pressure_score_zscore'] = (df['repayment_pressure_score'] - df['repayment_pressure_score'].mean()) / df['repayment_pressure_score'].std()
end

python
# repayment_pressure_duration_interaction
# Interaction between repayment_pressure_score and duration to incorporate long-term repayment stress.
# Usefulness: Helps understand the compounded effect of repayment burden over loan duration.

df['repayment_pressure_duration_interaction'] = df['repayment_pressure_score'] * df['duration']
end

python
# scaled_risk_adjusted_credit_history
# Log transformation of risk_adjusted_credit_history to smooth extreme values for better interpretability.
# Usefulness: Reduces the impact of outliers in risk representation and makes trends easier to identify.

df['scaled_risk_adjusted_credit_history'] = np.log(df['risk_adjusted_credit_history'] + 1e-6)
end

python
# liquidity_interaction
# Interaction term combining savings_status (encoded as numerical) and checking_status (encoded as numerical) to reflect cash reserves and liquidity.
# Usefulness: Represents available liquidity as an important indicator of creditworthiness.

df['liquidity_interaction'] = df['savings_status'].apply(lambda x: {'>=1000': 3, '500<=X<1000': 2, '100<=X<500': 1, '<100': 0, 'no known savings': -1}[x]) * df['checking_status'].apply(lambda x: {'>=200': 2, '0<=X<200': 1, 'no checking': 0, '<0': -1}[x])
end

python
# stability_adjusted_risk
# Multiplication of risk_adjusted_credit_history with employment_label to model risk moderated by employment stability.
# Usefulness: Highlights credit risk considering employment duration as a stability factor.

df['stability_adjusted_risk'] = df['risk_adjusted_credit_history'] * df['employment_label']
end

python
# lifetime_liquidity_adjusted_efficiency
# Ratio of lifetime_credit_efficiency to liquidity_interaction to incorporate long-term utilization efficiency moderated by liquidity.
# Usefulness: Combines credit efficiency over a lifetime with liquidity insights, better capturing financial health.

df['lifetime_liquidity_adjusted_efficiency'] = df['lifetime_credit_efficiency'] / (df['liquidity_interaction'] + 1e-6)
end

python
# duration_normalized_avg_credit
# Ratio of avg_credit_per_year to duration to normalize annualized credit usage by loan duration.
# Usefulness: Identifies whether borrowers use more credit annually compared to their repayment timeframes.

df['duration_normalized_avg_credit'] = df['avg_credit_per_year'] / (df['duration'] + 1e-6)
end

python
# drop_feature_median_duration_by_credit_history
# Removes redundant feature median_duration_by_credit_history as it's already represented in risk_adjusted_credit_history.
# Usefulness: Minimizes multicollinearity and unnecessary computation.

df.drop(columns=['median_duration_by_credit_history'], inplace=True)
end

python
# drop_feature_group_credit_by_job
# Removes group_credit_by_job as category_weighted_credit captures job-level credit insights in a more comprehensive manner.
# Usefulness: Reduces redundancy and enhances the feature set's predictive focus.

df.drop(columns=['group_credit_by_job'], inplace=True)
end
