of property_magnitude and housing categories.\n# Usefulness: Captures relationship between asset ownership and living condition, which can impact creditworthiness.\ndf['property_housing_combined'] = df['property_magnitude'] + '_' + df['housing']", "# avg_credit_per_year\n# Credit amount normalized by years since adulthood (age - 18 + 1).\n# Usefulness: Reflects credit behavior factoring the duration of financial maturity.\ndf['avg_credit_per_year'] = df['credit_amount'] / (df['age'] - 18 + 1)", "# personal_status_label\n# Label-encode personal_status categories.\n# Usefulness: Provides numerical representation of marital and financial responsibility context related to borrowing.\ndf['personal_status_label'] = df['personal_status'].map({'male single': 0, 'female div/dep/mar': 1, 'male mar/wid': 2, 'male div/sep': 3})", "# foreign_worker_encoded\n# Binary encoding for foreign_worker status.\n# Usefulness: Distinguishes individuals based on foreign worker status, which is an important contextual factor.\ndf['foreign_worker_encoded'] = df['foreign_worker'].map({'no': 0, 'yes': 1})", "# dependency_ratio\n# Ratio of num_dependents to residence_since.\n# Usefulness: Captures dependency burden relative to stability at the current residence.\ndf['dependency_ratio'] = df['num_dependents'] / df['residence_since']", "# group_credit_by_job\n# Mean credit amount for each job type.\n# Usefulness: Captures average borrowing patterns for specific employment categories, providing contextual feature importance.\ndf['group_credit_by_job'] = df.groupby('job')['credit_amount'].transform('mean')", "# median_duration_by_credit_history\n# Median credit duration based on credit history.\n# Usefulness: Highlights typical repayment periods for each credit history type, capturing specific patterns.\ndf['median_duration_by_credit_history'] = df.groupby('credit_history')['duration'].transform('median')", "# installment_std_by_employment\n# Standard deviation of installment_commitment for different employment types.\n# Usefulness: Indicates variability in installment burdens across employment categories, revealing financial strain patterns.\ndf['installment_std_by_employment'] = df.groupby('employment')['installment_commitment'].transform('std')", "df.drop(columns=['personal_status', 'other_parties', 'property_magnitude'], inplace=True)"]
