# log_checking_status
# Log transformation of checking_status to handle skewness in liquidity representation.
# Usefulness: Helps normalize financial account data and points to immediate liquidity position of the individual.
df['log_checking_status'] = np.log1p(df['checking_status'])
end

python
# employment_label
# Label-encode employment categories to represent stability based on duration of employment.
# Usefulness: Adds ordinal importance to employment categories, highlighting longer employment durations as more stable.
df['employment_label'] = df['employment'].map({'<1': 0, '1<=X<4': 1, '4<=X<7': 2, '>=7': 3, 'unemployed': -1})
end

python
# monthly_installment
# Monthly credit repayment burden calculated as credit_amount divided by duration in months.
# Usefulness: Captures repayment affordability based on repayment period and overall credit amount.
df['monthly_installment'] = df['credit_amount'] / df['duration']
end

python
# credit_to_savings_ratio
# Ratio of credit_amount to savings_status (smoothed by +1 to avoid division errors).
# Usefulness: Highlights individual's reliance on savings for credit repayment and financial safety margin.
df['credit_to_savings_ratio'] = df['credit_amount'] / (df['savings_status'] + 1)
end

python
# installment_to_income_ratio
# Ratio of installment_commitment to residence_since as a proxy for income saving over time.
# Usefulness: Indicates the individual's ability to allocate income toward credit installments.
df['installment_to_income_ratio'] = df['installment_commitment'] / df['residence_since']
end

python
# credit_history_label
# Numerically encode credit_history categories.
# Usefulness: Adds ordinal encoding to distinguish between levels of reliability in credit history.
df['credit_history_label'] = df['credit_history'].map({'no credits/all paid': 0, 'all paid': 1, 'existing paid': 2, 'delayed previously': 3, 'critical/other existing credit': 4})
end

python
# property_housing_combined
# Interaction term of property_magnitude and housing categories.
# Usefulness: Captures relationship between asset ownership and living condition, which can impact creditworthiness.
df['property_housing_combined'] = df['property_magnitude'] + '_' + df['housing']
end

python
# avg_credit_per_year
# Credit amount normalized by years since adulthood (age - 18 + 1).
# Usefulness: Reflects credit behavior factoring the duration of financial maturity.
df['avg_credit_per_year'] = df['credit_amount'] / (df['age'] - 18 + 1)
end

python
# personal_status_label
# Label-encode personal_status categories.
# Usefulness: Provides numerical representation of marital and financial responsibility context related to borrowing.
df['personal_status_label'] = df['personal_status'].map({'male single': 0, 'female div/dep/mar': 1, 'male mar/wid': 2, 'male div/sep': 3})
end

python
# foreign_worker_encoded
# Binary encoding for foreign_worker status.
# Usefulness: Distinguishes individuals based on foreign worker status, which is an important contextual factor.
df['foreign_worker_encoded'] = df['foreign_worker'].map({'no': 0, 'yes': 1})
end

python
# dependency_ratio
# Ratio of num_dependents to residence_since.
# Usefulness: Captures dependency burden relative to stability at the current residence.
df['dependency_ratio'] = df['num_dependents'] / df['residence_since']
end

python
# group_credit_by_job
# Mean credit amount for each job type.
# Usefulness: Captures average borrowing patterns for specific employment categories, providing contextual feature importance.
df['group_credit_by_job'] = df.groupby('job')['credit_amount'].transform('mean')
end

python
# median_duration_by_credit_history
# Median credit duration based on credit history.
# Usefulness: Highlights typical repayment periods for each credit history type, capturing specific patterns.
df['median_duration_by_credit_history'] = df.groupby('credit_history')['duration'].transform('median')
end

python
# installment_std_by_employment
# Standard deviation of installment_commitment for different employment types.
# Usefulness: Indicates variability in installment burdens across employment categories, revealing financial strain patterns.
df['installment_std_by_employment'] = df.groupby('employment')['installment_commitment'].transform('std')
end

python
df.drop(columns=['personal_status', 'other_parties', 'property_magnitude'], inplace=True)
end
