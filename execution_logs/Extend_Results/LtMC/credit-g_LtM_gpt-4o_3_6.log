# avg_credit_weight_by_age
# Weighted average of avg_credit_per_year normalized to years since adulthood, capturing earning potential over lifetime.
# Usefulness: Adjusts average credit data into a dynamically-aged interpretation, aiding the proxy for financial maturity.

df['avg_credit_weight_by_age'] = df['avg_credit_per_year'] / (df['age'] - 18 + 1)
end

