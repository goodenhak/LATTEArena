# Feature description: Logarithmic transformation of Income to reduce skewness and highlight proportional income differences.
# Usefulness: Provides a normalized scale for analyzing income-related impact on credit card application success.
df['LogIncome'] = np.log1p(df['Income'])
end

python
# CreditScoreSquared
# Feature description: Squared CreditScore to emphasize significant differences for high scores.
# Usefulness: Highlights outliers and amplifies the importance of higher credit scores in predictive modeling.
df['CreditScoreSquared'] = np.square(df['CreditScore'])
end

python
# RiskAmplificationIndex
# Feature description: Combines risk features — PriorDefault, CreditUtilizationRatio, and DebtAdjustedByEmployment — into a weighted index.
# Usefulness: Captures compounding risk effects in applicant behavior, aiding identification of high-risk profiles.
df['RiskAmplificationIndex'] = df['PriorDefault'] * df['CreditUtilizationRatio'] * df['DebtAdjustedByEmployment']
end

python
# StabilityRatio
# Feature description: Ratio of EmploymentIncomeFactor to Debt, representing financial stability relative to obligations.
# Usefulness: Indicates an applicant’s ability to manage debt based on stable income factors.
df['StabilityRatio'] = df['EmploymentIncomeFactor'] / (df['Debt'] + 1)
end

python
# IncomeBinned
# Feature description: Binned Income into low, medium, high categories using binning.
# Usefulness: Simplifies income analysis by creating interpretable risk segments.
df['IncomeBinned'] = pd.cut(df['Income'], bins=[-1, 500, 5000, 100000], labels=['Low', 'Medium', 'High'])
end

python
# DebtToLogIncomeRatio
# Feature description: Ratio of Debt to LogIncome for a scaled measure of debt burden.
# Usefulness: Demonstrates proportional debt burden, especially useful for high income outliers.
df['DebtToLogIncomeRatio'] = df['Debt'] / (df['LogIncome'] + 1)
end

python
# CreditScorePerEmploymentYear
# Feature description: Credit score divided by (YearsEmployed + 1) to reflect improvements considering employment length.
# Usefulness: Evaluates creditworthiness while stabilizing comparison across varying employment durations.
df['CreditScorePerEmploymentYear'] = df['CreditScore'] / (df['YearsEmployed'] + 1)
end

python
# CitizenNormalizedIncome
# Feature description: Income normalized by CitizenDefaultRisk to adjust for citizenship-based default likelihoods.
# Usefulness: Captures the combined effect of income and citizenship-associated risks in application probability.
df['CitizenNormalizedIncome'] = df['Income'] * (1 - df['CitizenDefaultRisk'])
end

python
# IndustryIncomeDeviation
# Feature description: Difference between an applicant's Income and IndustryIncomeRiskRatio.
# Usefulness: Highlights discrepancies between individual income and industry-level earning norms, identifying outliers.
df['IndustryIncomeDeviation'] = df['Income'] - df['IndustryIncomeRiskRatio']
end

python
# DefaultProbabilityScore
# Feature description: Combined log-transformed features (LogCreditScore and CreditUtilizationRatio) to calculate default likelihood.
# Usefulness: Enhances non-linear insights into credit and utilization behavior.
df['DefaultProbabilityScore'] = np.log1p(df['CreditScore']) * df['CreditUtilizationRatio']
end

python
# Drop redundant features
df.drop(columns=['ExpCreditScore', 'LogCreditScore', 'DebtAdjustedByEmployment'], inplace=True)
end
