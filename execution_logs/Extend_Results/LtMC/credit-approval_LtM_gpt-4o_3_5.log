# LogIncome
# Log transformation of Income to reduce the effect of outliers in the highly skewed income distribution.
# Usefulness: Provides a normalized representation of income, highlighting relative financial stability.
df['LogIncome'] = df['Income'].apply(lambda x: np.log1p(x))
end

python
# CreditBehaviorInteraction
# Interaction term combining CreditScore and CreditRiskScore to emphasize joint credit behavior.
# Usefulness: Captures the relationship between credit behavior and utilization risks, improving creditworthiness analysis.
df['CreditBehaviorInteraction'] = df['CreditScore'] * df['CreditRiskScore']
end

python
# AdjustedDebtToIncome
# Enhanced debt-to-income ratio considering a minimum Income buffer (Income + 1).
# Usefulness: A refined version of CreditUtilizationRatio, improving debt affordability estimations especially for low Income.
df['AdjustedDebtToIncome'] = df['Debt'] / (df['Income'] + 1)
end

python
# MaritalCreditInteraction
# Interaction term combining MaritalSupportFactor and ExpCreditScore to integrate marital and financial credit stability.
# Usefulness: Highlights the combined impact of marital status and credit scores on financial resilience.
df['MaritalCreditInteraction'] = df['MaritalSupportFactor'] * df['ExpCreditScore']
end

python
# IncomeContextRatio
# Ratio of Income to EthnicIncomeAverage to normalize earnings within ethnicity.
# Usefulness: Provides socioeconomic context by highlighting relative earning power within an applicant’s ethnic group.
df['IncomeContextRatio'] = df['Income'] / (df['EthnicIncomeAverage'] + 1)
end

python
