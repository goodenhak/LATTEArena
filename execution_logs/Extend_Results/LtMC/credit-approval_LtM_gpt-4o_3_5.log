# Feature name: CreditBehaviorRiskIndex
# Feature description: Product of ExpCreditScore and CreditRiskScore to emphasize higher credit scores while accounting for utilization risk.
# Usefulness: Combines exp-transformed credit score with utilization-based risk behavior, providing a crucial measure of credit stability and risk.
df['CreditBehaviorRiskIndex'] = df['ExpCreditScore'] * df['CreditRiskScore']
end

python
# Feature name: IncomeStabilityFactor
# Feature description: Product of EmploymentIncomeFactor and IncomeToEthnicAverageRatio to capture both individual income stability and group-level income expectations.
# Usefulness: Merges personal and group-level income stability patterns to highlight trends in financial capacity.
df['IncomeStabilityFactor'] = df['EmploymentIncomeFactor'] * df['IncomeToEthnicAverageRatio']
end

python
# Feature name: DefaultRiskIndex
# Feature description: Log transformation of the sum of PriorDefault and IndustryDefaultRisk to smooth and emphasize combined default risks.
# Usefulness: This transformation reduces skewness in risk indicators, providing a more nuanced representation of default propensity.
df['DefaultRiskIndex'] = np.log(df['PriorDefault'] + df['IndustryDefaultRisk'] + 1)
end

python
# Feature name: AdjustedDebtRatio
# Feature description: Ratio of Debt to (DebtAdjustedByEmployment + 1) to highlight relative debt burden after adjustment by employment duration.
