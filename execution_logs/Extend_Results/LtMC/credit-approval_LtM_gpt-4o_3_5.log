# LogIncome
# Logarithmic transformation of Income for better scaling and handling outliers.
# Usefulness: Handles extreme values in Income and captures diminishing returns in financial capacity.
df['LogIncome'] = df['Income'].apply(lambda x: np.log(x + 1))
end

python
# IncomeToDebtRatio
# Ratio of Income to (Debt + 1) to measure financial stability against financial obligations.
# Usefulness: Highlights the balance between an applicant's financial capacity and their debt load.
df['IncomeToDebtRatio'] = df['Income'] / (df['Debt'] + 1)
end

python
# Interaction_CreditScore_Debt
# Difference between CreditScore and Debt to balance creditworthiness against financial obligations.
# Usefulness: Combines credit and debt information into a single feature to emphasize net financial health.
df['Interaction_CreditScore_Debt'] = df['CreditScore'] - df['Debt']
end

python
# Multiplied_PriorDefault_IndustryRisk
# Product of PriorDefault and IndustryDefaultRisk to combine personal default history with sector-level risks.
# Usefulness: Highlights compounded default risk due to both individual and industry-level vulnerabilities.
df['Multiplied_PriorDefault_IndustryRisk'] = df['PriorDefault'] * df['IndustryDefaultRisk']
end

python
# LogDefaultRisk
# Logarithmic transformation of CreditRiskScore.
# Usefulness: Captures the risk level associated with credit scores and utilization ratio, mitigating outliers.
df['LogDefaultRisk'] = np.log(df['CreditRiskScore'] + 1)
end

python
# IncomeEmphasizedByCitizenRisk
# Product of Income and CitizenDefaultRisk to adjust financial capacity by citizenship-associated risks.
# Usefulness: Refines financial capacity estimates by incorporating citizenship type risk factors.
df['IncomeEmphasizedByCitizenRisk'] = df['Income'] * df['CitizenDefaultRisk']
end

python
# LogEthnicIncomeAverage
# Log transformation of EthnicIncomeAverage for better scaling and handling skewness.
# Usefulness: Normalizes group-level income averages for interpretability and model stability.
df['LogEthnicIncomeAverage'] = np.log(df['EthnicIncomeAverage'] + 1)
end

python
# PriorDefault_Sigmoid
# Sigmoid transformation of PriorDefault for nonlinear signal capture.
# Usefulness: Smoothes binary information from PriorDefault and enhances its interaction potential with other variables.
df['PriorDefault_Sigmoid'] = 1 / (1 + np.exp(-df['PriorDefault']))
end

python
# IndustryIncomeNormalized
# Ratio of Income to IndustryDefaultRisk, emphasizing individual financial capacity within industry risks.
# Usefulness: Measures financial strength while controlling for sector-specific risk factors.
df['IndustryIncomeNormalized'] = df['Income'] / (df['IndustryDefaultRisk'] + 1)
end

python
# Bin_EmploymentYears
# Binned YearsEmployed into discrete categories for categorical analysis.
# Usefulness: Simplifies employment duration data for better interpretability in decision tree models.
df['Bin_EmploymentYears'] = pd.cut(df['DebtAdjustedByEmployment'], bins=[-1, 1, 5, np.inf], labels=['ShortTerm', 'MidTerm', 'LongTerm'])
end

python
# Employment_Income_FactorSum
# Sum of original Employment and scaled EmploymentIncomeFactor to adjust stability by earnings and tenure.
# Usefulness: Highlights employment suitability for credit based on earnings/time.
df[CombinedEmploymentSignal]=df.Employed+(.23 )
