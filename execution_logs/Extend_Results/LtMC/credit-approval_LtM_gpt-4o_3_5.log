# Income-to-CreditScore Ratio
# Feature description: Ratio of income to (credit score + 1), indicating financial stability relative to creditworthiness.
# Usefulness: Captures the balance between financial capability and past credit behavior; higher values indicate strong financial standing.
df['Income_to_CreditScore_Ratio'] = df['Income'] / (df['CreditScore'] + 1)
end

python
# Debt-to-YearsEmployed Ratio
# Feature description: Ratio of debt to (years employed + 1), reflecting long-term financial debt stability.
# Usefulness: Indicates whether applicants are maintaining manageable debt levels relative to their employment duration.
df['Debt_to_YearsEmployed_Ratio'] = df['Debt'] / (df['YearsEmployed'] + 1)
end

python
# ScaledPriorDefault
# Feature description: Product of PriorDefault and IndustryDefaultRisk, combining personal credit history with industry-level default trends.
# Usefulness: Flags applicants with both individual and systemic risk factors, enhancing default risk assessment.
df['ScaledPriorDefault'] = df['PriorDefault'] * df['IndustryDefaultRisk']
end

python
# CreditReputationFactor
# Feature description: Product of LogCreditScore and CreditUtilizationRatio, measuring the interaction between creditworthiness and financial stress.
# Usefulness: Provides insight into how credit behaviors align with financial obligations, emphasizing applicants with balanced credit usage.
df['CreditReputationFactor'] = df['LogCreditScore'] * df['CreditUtilizationRatio']
end

python
# DefaultRiskScaledIncome
# Feature description: Product of IndustryDefaultRisk and Income, encoding the income level relative to industry-specific default risks.
# Usefulness: Adjusts income measures based on systemic risk factors in the applicant's job sector, adding contextual socioeconomic understanding.
df['DefaultRiskScaledIncome'] = df['IndustryDefaultRisk'] * df['Income']
end

python
# JobStabilityIndex
# Feature description: Product of YearsEmployed and Employed, combining employment duration and current employment status.
# Usefulness: Quantifies employment stability, a strong predictor for financial reliability and successful applications.
df['JobStabilityIndex'] = df['YearsEmployed'] * df['Employed']
end

python
# IndustryEffectScaled
# Feature description: Encodes Industry using label encoding, then multiplies with IndustryDefaultRisk to capture sector-specific default risks.
# Usefulness: Encodes the interactions between applicant's job sector and the associated systemic risk into a single numeric feature.
df['IndustryEffectScaled'] = df['Industry'].factorize()[0] * df['IndustryDefaultRisk']
end

python
# CitizenCategoryImpact
# Feature description: Target encoding of Citizen against success (Answer), representing approval success likelihood based on citizenship type.
# Usefulness: Identifies potential patterns in approvals based on long-term residence or citizenship status, adding demographic predictive value.
df['CitizenCategoryImpact'] = df.groupby('Citizen')['Answer'].transform('mean')
end

python
# CitizenDefaultAdj
# Feature description: Product of target encoding of Citizen against PriorDefault and PriorDefault, linking citizenship type with default history.
# Usefulness: Encodes citizenship-specific relevance to historical default probabilities, improving demographic contextualization.
df['CitizenDefaultAdj'] = df.groupby('Citizen')['PriorDefault'].transform('mean') * df['PriorDefault']
end

python
# Gender-Income Interaction
# Feature description: Product of Gender and Income, capturing potential gender-specific patterns in income.
# Usefulness: Reflects societal or financial trends that differ by gender, linking gender behavior with earning power.
df['Gender_Income_Interaction'] = df['Gender'] * df['Income']
end

python
# Marital-Debt Influence
# Feature description: Ratio of MaritalSupportFactor to (Debt + 1), measuring combined spousal support relative to financial obligations.
# Usefulness: Highlights the financial support dynamic provided by marriage in balancing debt obligations.
df['Marital_Debt_Influence'] = df['MaritalSupportFactor'] / (df['Debt'] + 1)
end

python
# Ethnicity-Adjusted Income Score
# Feature description: Difference between Income and EthnicIncomeAverage, representing deviation from ethnic group average income.
# Usefulness: Captures individualized income levels relative to shared socioeconomic backgrounds, enhancing demographic context.
df['Ethnicity_Adj_Income_Score'] = df['Income'] - df['EthnicIncomeAverage']
end

python
# EthnicDebtRatio
# Feature description: Ratio of Debt to EthnicIncomeAverage, measuring financial obligations with demographic context.
# Usefulness: Provides a normalized view on debt while controlling for typical earnings within the ethnic demographic.
df['EthnicDebtRatio'] = df['Debt'] / df['EthnicIncomeAverage']
end

python
# IndustrySuccessRate
# Feature description: Target encoding of Industry against success (Answer), representing approval success likelihood in specific sectors.
# Usefulness: Adds sector-specific predictive power by leveraging historical approval data within industries.
df['IndustrySuccessRate'] = df.groupby('Industry')['Answer'].transform('mean')
end

python
# Income-LogScaled
# Feature description: Log-transformed Income + 1, stabilizing variance and emphasizing differences in lower income ranges.
# Usefulness: Handles income outliers and captures diminishing returns on higher incomes.
df['Income_Log_Scaled'] = np.log(df['Income'] + 1)
end

python
# CreditBehaviorSigmoid
# Feature description: Sigmoid transformation of CreditScore, stabilizing values and emphasizing mid-score differentiations.
# Usefulness: Adds non-linear scaling to the credit score feature, improving model sensitivity to midrange scores.
df['CreditBehaviorSigmoid'] = 1 / (1 + np.exp(-df['CreditScore']))
end

python
# Dropping redundant or non-informative columns
df.drop(columns=['NormalizedZipRank'], inplace=True)
end
