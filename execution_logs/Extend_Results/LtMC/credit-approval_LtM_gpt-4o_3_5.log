# PriorDefaultCreditScoreInteraction
# Feature description: Product of PriorDefault and CreditScore.
# Usefulness: Combines past credit risk and current credit responsibility to reveal long-term risk trends.
df['PriorDefaultCreditScoreInteraction'] = df['PriorDefault'] * df['CreditScore']
end

python
# DebtToIncomeRatio
# Feature description: Ratio of Debt to Income to assess financial leverage.
# Usefulness: Critical for capturing financial burden relative to income capacity.
df['DebtToIncomeRatio'] = df['Debt'] / (df['Income'] + 1e-6)
end

python
# CreditUtilizationByScore
# Feature description: Ratio of CreditScore to CreditUtilizationRatio.
# Usefulness: Balances creditworthiness against credit utilization efficiency.
df['CreditUtilizationByScore'] = df['CreditScore'] / (df['CreditUtilizationRatio'] + 1e-6)
end

python
# EmploymentIncomeFactor
# Feature description: Product of YearsEmployed and Income.
# Usefulness: Captures income stability in conjunction with employment duration.
df['EmploymentIncomeFactor'] = df['YearsEmployed'] * df['Income']
end

python
# AdjustedDebtByEmployment
# Feature description: Debt divided by (YearsEmployed + 1), adjusting for employment stability.
# Usefulness: Provides an adjusted view on debt risk based on employment duration.
df['AdjustedDebtByEmployment'] = df['Debt'] / (df['YearsEmployed'] + 1)
end

python
# LogCreditScore
# Feature description: Log transformation of CreditScore + 1.
# Usefulness: Captures diminishing returns at higher scores and reduces skewness.
df['LogCreditScore'] = np.log(df['CreditScore'] + 1)
end

python
# ExponentialCreditScore
# Feature description: Exponential transformation of LogCreditScore.
# Usefulness: Emphasizes higher credit scores, creating nonlinear emphasis on financial responsibility.
df['ExponentialCreditScore'] = np.exp(df['LogCreditScore'])
end

python
# SigmoidDebt
# Feature description: Sigmoid transformation of Debt.
# Usefulness: Normalizes high debt values, reducing their impact while emphasizing moderate values.
df['SigmoidDebt'] = 1 / (1 + np.exp(-df['Debt']))
end

python
# SigmoidCreditUtilization
# Feature description: Sigmoid transformation of CreditUtilizationRatio.
# Usefulness: Regularizes high utilization values and emphasizes moderate behavior patterns.
df['SigmoidCreditUtilization'] = 1 / (1 + np.exp(-df['CreditUtilizationRatio']))
end

python
# CitizenDefaultRisk
# Feature description: Average PriorDefault rate grouped by Citizen (via target encoding).
# Usefulness: Adjusts for systemic risk indicators tied to demographic citizenship groups.
df['CitizenDefaultRisk'] = df.groupby('Citizen')['PriorDefault'].transform('mean')
end

python
# IndustryIncome
# Feature description: Mean Income for each Industry (via group-based aggregation).
# Usefulness: Contextualizes applicant income relative to industry-level norms.
df['IndustryIncome'] = df.groupby('Industry')['Income'].transform('mean')
end

python
# drop_columns
df.drop(columns=['EthnicIncomeAverage', 'MaritalCreditSupport'], inplace=True)
end
