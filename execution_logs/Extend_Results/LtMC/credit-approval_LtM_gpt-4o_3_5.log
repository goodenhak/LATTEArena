2026-05-26 00:47:36,650 - INFO - ops_string = ["# DebtIncomeInteraction\n# Feature description: Combined effect of Debt and Income to capture financial obligations correlated with earning capacity.\n# Usefulness: Evaluates the applicant's debt burden relative to their income, an important creditworthiness indicator.\ndf['DebtIncomeInteraction'] = df['Debt'] * df['Income']", "# CreditRiskScore\n# Feature description: Joint indicator of LogCreditScore and CreditUtilizationRatio, emphasizing credit behavior and utilization risks.\n# Usefulness: Enhances understanding of combined credit efficiency and risk for more accurate creditworthiness evaluation.\ndf['CreditRiskScore'] = df['LogCreditScore'] * df['CreditUtilizationRatio']", "# IncomeToEthnicAverageRatio\n# Feature description: Ratio of an applicant's Income to the EthnicIncomeAverage.\n# Usefulness: Normalizes applicant income based on their ethnicity-based earning trends to capture demographic income context.\ndf['IncomeToEthnicAverageRatio'] = df['Income'] / (df['EthnicIncomeAverage'] + 1e-5)", "# DebtAdjustedByEmployment\n# Feature description: Debt divided by (YearsEmployed + 1), adjusting outstanding debt by employment duration.\n# Usefulness: Indicates debt burden with consideration for employment stability, helping assess financial strain.\ndf['DebtAdjustedByEmployment'] = df['Debt'] / (df['YearsEmployed'] + 1)", "# ExpCreditScore\n# Feature description: Exponential transformation of LogCreditScore for emphasizing higher credit scores.\n# Usefulness: Captures exponential impact of higher credit scores, reflecting greater credit reliability.\ndf['ExpCreditScore'] = np.exp(df['LogCreditScore'])", "# SqrtIncome\n# Feature description: Square root transformation of Income to reduce outlier influence.\n# Usefulness: Reduces sensitivity to very high incomes while retaining scale relationships.\ndf['SqrtIncome'] = np.sqrt(df['Income'])", "# IndustryIncomeRiskRatio\n# Feature description: Applicant's Income divided by IndustryDefaultRisk, normalized by group-level risk.\n# Usefulness: Adjusts income contextually by industry-associated default risks for better sectoral risk modeling.\ndf['IndustryIncomeRiskRatio'] = df['Income'] / (df['IndustryDefaultRisk'] + 1e-5)", "# CitizenDefaultRisk\n# Feature description: Average PriorDefault rate grouped by Citizen (via target_encoding).\n# Usefulness: Encodes citizenship-type-specific risk to capture legal and financial stability patterns across groups.\ncitizen_default_risk = df.groupby('Citizen')['PriorDefault'].transform('mean')\ndf['CitizenDefaultRisk'] = citizen_default_risk", "# EmploymentIncomeFactor\n# Feature description: Product of YearsEmployed and Income to capture income stability over employment duration.\n# Usefulness: Reflects long-term earning stability and reliability, a proxy for financial security.\ndf['EmploymentIncomeFactor'] = df['YearsEmployed'] * df['Income']", "# MaritalCreditSupport\n# Feature description: Product of MaritalSupportFactor and LogCreditScore, combining marital and credit stability indicators.\n# Usefulness: Highlights the financial support structure from marital status and credit strength.\ndf['MaritalCreditSupport'] = df['MaritalSupportFactor'] * df['LogCreditScore']", "# CitizenRiskWeightedIncome\n# Feature description: Product of Income and CitizenDefaultRisk to adjust financial capacity by citizenship risk.\n# Usefulness: Provides a risk-adjusted view of earning power based on citizenship-associated credit risks.\ndf['CitizenRiskWeightedIncome'] = df['Income'] * df['CitizenDefaultRisk']", "# Drop NormalizedZipRank\n# Feature description: This column has constant value (1.0) across all examples, adding no predictive power.\ndf.drop(columns=['NormalizedZipRank'], inplace=True)"]
