# duration_to_employment_ratio
# Ratio of credit duration to years of employment. Provides insights into applicant's stability vs. repayment commitment.
# Usefulness: Applicants with shorter durations relative to employment stability might be considered more credible.

df['duration_to_employment_ratio'] = df['duration'] / df['employment'].apply(lambda x: int(str(x).split('<=X<')[-1]) if '<=X<' in str(x) else (7 if '>=' in str(x) else 0))
end

python
# normalized_savings_ratio
# Ratio of savings to credit_amount, normalized by the maximum credit_amount. Highlights reserve sufficiency relative to liabilities.
# Usefulness: Emphasizes applicant's financial health and ability to support debt repayment.

df['normalized_savings_ratio'] = df['log_loan_to_savings_ratio'] / (df['credit_amount'] / df['credit_amount'].max())
end

python
# age_employment_factor
# Interaction of age and employment duration to represent maturity and stability of financial commitments.
# Usefulness: Older applicants with longer employment histories might exhibit better repayment reliability.

df['age_employment_factor'] = df['age'] * df['employment'].apply(lambda x: int(str(x).split('<=X<')[-1]) if '<=X<' in str(x) else (7 if '>=' in str(x) else 0))
end

python
# repayment_volatility
# Interaction of normalized_existing_credits and volatility_existing_credits to measure credit repayment fluctuations.
# Usefulness: Applicants with volatile repayment patterns signal higher risk.

df['repayment_volatility'] = df['normalized_existing_credits'] * df['volatility_existing_credits']
end

python
# stability_score
# Aggregate score based on zscore_employment_stability, age, and ratio_duration_installment_commitment to capture holistic credit stability.
# Usefulness: Applicants with higher scores signal better financial stability and repayment capability.

df['stability_score'] = (
    df['zscore_employment_stability'] + 
    df['age'].apply(lambda x: (x - df['age'].mean()) / df['age'].std()) - 
    df['ratio_duration_installment_commitment'].apply(lambda x: (x - df['ratio_duration_installment_commitment'].mean()) / df['ratio_duration_installment_commitment'].std())
)
end

python
# debt_to_income_interaction_score
# Interaction between log_debt_to_income_ratio and credit_history indicators to emphasize repayment suitability.
# Usefulness: Highlights credit history patterns interacting with debt-income burden, improving reliability assessment.

df['debt_to_income_interaction_score'] = (
    df['log_debt_to_income_ratio'] * (
        df['credit_history_existing paid'].astype(int) - 
        df['credit_history_critical/other existing credit'].astype(int)
    )
)
end

python
# foreign_worker_credit_ratio
# Interaction of foreign_worker category and ratio_credit_amount_loan_to_savings to represent diversity-adjusted affordability.
# Usefulness: Identifies repayment strength adjusted for foreign workers, which may contribute to inclusive approval models.

df['foreign_worker_credit_ratio'] = df['foreign_worker'].apply(lambda x: 1 if x == 'yes' else 0) * df['ratio_credit_amount_loan_to_savings']
end

python
# drop unused features
df.drop(columns=['personal_status', 'own_telephone', 'property_magnitude', 'num_dependents', 'other_payment_plans'], inplace=True)
end
