# effective_income_ratio
# Ratio of 'log_debt_to_income_ratio' to 'log_loan_to_savings_ratio' to identify applicants balancing income and savings stability against debt obligations.
# Usefulness: Combines critical thresholds of debt-to-income and savings to highlight financial robustness.

df['effective_income_ratio'] = df['log_debt_to_income_ratio'] / df['log_loan_to_savings_ratio']
end

python
# repayment_capacity_score
# Product of 'ratio_duration_installment_commitment' and 'zscore_installment_commitment' to capture repayment burden relative to income and loan term.
# Usefulness: Quantifies repayment feasibility by integrating term length and proportional installment burdens.

df['repayment_capacity_score'] = df['ratio_duration_installment_commitment'] * df['zscore_installment_commitment']
end

python
# stability_interaction
# Interaction between 'zscore_employment_stability' and 'age_employment_mean' to assess financial stability trends and age-adjusted employment behaviors.
# Usefulness: Highlights patterns combining maturity (age) and employment stability for informed credit assessment.

df['stability_interaction'] = df['zscore_employment_stability'] * df['age_employment_mean']
end

python
# adjusted_existing_credits
# Ratio of 'normalized_existing_credits' to 'volatility_existing_credits' to capture variability in outstanding obligations against stable credit trends.
# Usefulness: Reflects credit behavior resilience to address applicants with stable liabilities over volatile trends.

df['adjusted_existing_credits'] = df['normalized_existing_credits'] / df['volatility_existing_credits']
end

python
# financial_burden_index
# Weighted sum of 'ratio_credit_amount_loan_to_savings' and 'effective_income_ratio', emphasizing credit amount burden against income resilience.
# Usefulness: Integrates savings, income, and credit amount dependency for overall burdens.

df['financial_burden_index'] = (df['ratio_credit_amount_loan_to_savings'] * 0.6) + (df['effective_income_ratio'] * 0.4)
end

python
# aggregate_credit_history_score
# Sum of one-hot encoded 'credit_history' features to create a cumulative credit repayment pattern score.
# Usefulness: Aggregates repayment history categories to summarize applicant behavioral reliability.

df['aggregate_credit_history_score'] = (
    df['credit_history_all paid'] +
    df['credit_history_critical/other existing credit'] +
    df['credit_history_delayed previously'] +
    df['credit_history_existing paid'] +
    df['credit_history_no credits/all paid']
)
