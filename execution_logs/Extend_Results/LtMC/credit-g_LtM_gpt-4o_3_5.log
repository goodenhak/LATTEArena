# credit_behavior_score
# Combination of zscore_employment_stability * log_debt_to_income_ratio to reflect the interplay between financial health and job stability.
# Usefulness: Highlights applicants who maintain strong financial behavior under stable employment conditions, emphasizing their ability to repay loans.
df['credit_behavior_score'] = df['zscore_employment_stability'] * df['log_debt_to_income_ratio']
end

python
# repayment_burden_ratio
# Ratio of credit_amount to log_loan_to_savings_ratio to assess loan burden relative to financial reserves.
# Usefulness: Captures how borrowers’ savings buffer impacts loan repayment capability, directly linked to creditworthiness.
df['repayment_burden_ratio'] = df['credit_amount'] / df['log_loan_to_savings_ratio']
end

python
# financial_resilience_score
# Interaction between normalized_existing_credits and log_loan_to_savings_ratio to measure financial resilience.
# Usefulness: Reflects the ability to manage existing credit requirements without overwhelming reserves.
df['financial_resilience_score'] = df['normalized_existing_credits'] * df['log_loan_to_savings_ratio']
end

python
# stable_income_factor
# Ratio of zscore_employment_stability to ratio_duration_installment_commitment to weight stability by repayment burden.
# Usefulness: Highlights applicants with stable income managing their financial obligations efficiently.
df['stable_income_factor'] = df['zscore_employment_stability'] / df['ratio_duration_installment_commitment']
end

python
