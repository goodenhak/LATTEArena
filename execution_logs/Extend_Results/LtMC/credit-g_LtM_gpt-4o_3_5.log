# repayment_pressure_score
# Ratio of 'duration' to 'installment_commitment', normalized by z-score standardization.
# Usefulness: Represents repayment burden indexed against repayment period for fair comparison across applicants.
df['repayment_pressure_score'] = (df['duration'] / df['ratio_duration_installment_commitment']).transform(lambda x: (x - x.mean()) / x.std())
end

python
# financial_risk_ratio
# Combination of 'log_debt_to_income_ratio' and 'log_loan_to_savings_ratio' using a weighted sum (0.6 and 0.4 respectively).
# Usefulness: Captures aggregate financial risk by merging borrowing burden and savings stability into a single score.
df['financial_risk_ratio'] = 0.6 * df['log_debt_to_income_ratio'] + 0.4 * df['log_loan_to_savings_ratio']
end

python
# trustworthiness_score
# Weighted interaction of normalized_existing_credits and credit history reliability (using one-hot encoded credit history features).
# Usefulness: Quantifies credit history trustworthiness relative to past consistent repayment and engagement history.
df['trustworthiness_score'] = df['normalized_existing_credits'] * (
    0.4 * df['credit_history_existing paid'] + 
    0.3 * df['credit_history_all paid'] - 
    0.3 * df['credit_history_critical/other existing credit']
)
end

python
# stability_factor
# Interaction of zscore_employment_stability and ratio_credit_amount_loan_to_savings.
# Usefulness: Measures overall stability combining employment trends and financial burden on reserves in a unified metric.
df['stability_factor'] = df['zscore_employment_stability'] * df['ratio_credit_amount_loan_to_savings']
end

python
# volatility_adjusted_risk
# Product of volatility_existing_credits and log_debt_to_income_ratio.
# Usefulness: Incorporates variability in historical credit behavior with the stabilized financial burden for dynamic risk profiling.
df['volatility_adjusted_risk'] = df['volatility_existing_credits'] * df['log_debt_to_income_ratio']
end

python
