2026-05-26 00:24:20,462 - INFO - ops_string = ["# labeled_checking_status\n# Label-encoded 'checking_status' to make it numerically representable for modeling interactions.\n# Usefulness: Captures financial liquidity and delinquency risk in a numerical format for modeling downstream interactions.\ndf['labeled_checking_status'] = df['checking_status'].map({'no checking': 0, '<0': 1, '0<=X<200': 2, '>=200': 3})", "# log_debt_to_income_ratio\n# Log-transformed 'debt_to_income_ratio' to stabilize variance and emphasize smaller values that are critical for creditworthiness.\n# Usefulness: Highlights repayment capacity nuances, especially for individuals with lower debt-to-income ratios, reducing skew.\ndf['log_debt_to_income_ratio'] = df['debt_to_income_ratio'].apply(np.log1p)", "# one_hot_credit_history\n# One-hot encoding of 'credit_history' to capture discrete repayment patterns in a categorical format.\n# Usefulness: Captures differentiated behavior in credit repayment history and its impact on approval decisions.\ncredit_history_one_hot = pd.get_dummies(df['credit_history'], prefix='credit_history')\ndf = pd.concat([df, credit_history_one_hot], axis=1)", "# zscore_employment_stability\n# Z-score normalized 'employment_stability_score' to standardize values for relative comparison across individuals.\n# Usefulness: Reflects employment stability influence in a manner comparable across all applicants.\ndf['zscore_employment_stability'] = (df['employment_stability_score'] - df['employment_stability_score'].mean()) / df['employment_stability_score'].std()", "# log_loan_to_savings_ratio\n# Log-transformed 'loan_to_savings_ratio' for variance stabilization and reduced skewness.\n# Usefulness: Emphasizes differences in financial reserves that are critical for absorbing credit burdens.\ndf['log_loan_to_savings_ratio'] = df['loan_to_savings_ratio'].apply(np.log1p)", "# zscore_installment_commitment\n# Z-score normalized 'installment_commitment' to allow fair comparison across applicants’ repayment burdens.\n# Usefulness: Standardizes repayment burden relative to income for meaningful predictions.\ndf['zscore_installment_commitment'] = (df['installment_commitment'] - df['installment_commitment'].mean()) / df['installment_commitment'].std()", "# cross_checking_status_credit_history\n# Cross-feature interaction between 'labeled_checking_status' and 'credit_history' using one-hot features.\n# Usefulness: Captures the combined influence of financial liquidity and past repayment behavior on creditworthiness.\nfor col in credit_history_one_hot.columns:\n    df[f'cross_checking_status_{col}'] = df['labeled_checking_status'] * df[col]", "# ratio_duration_installment_commitment\n# Ratio of 'duration' to 'installment_commitment' to represent terms relative to repayment burden.\n# Usefulness: Reflects balance between loan terms and monthly repayment stability, important for assessing long-term risk.\ndf['ratio_duration_installment_commitment'] = df['duration'] / df['installment_commitment']", "# interaction_debt_to_income_employment_stability\n# Interaction between 'log_debt_to_income_ratio' and 'zscore_employment_stability' using multiplication.\n# Usefulness: Represents how repayment capacity interacts with job stability, a key determinant of credit risk.\ndf['interaction_debt_to_income_employment_stability'] = df['log_debt_to_income_ratio'] * df['zscore_employment_stability']", "# ratio_credit_amount_loan_to_savings\n# Ratio of 'credit_amount' to 'loan_to_savings_ratio' to indicate financial burden relative to reserves.\n# Usefulness: Highlights applicants’ capacity to absorb credit burden using available savings.\ndf['ratio_credit_amount_loan_to_savings'] = df['credit_amount'] / df['loan_to_savings_ratio']", "# groupbythenmean_age_employment\n# Age-adjusted stability trends by grouping 'age' and calculating mean for 'labeled employment' categories.\n# Usefulness: Reflects how employment categories differ in terms of average age, offering socioeconomic insights.\ndf['age_employment_mean'] = df.groupby('employment')['age'].transform('mean')", "# volatility_existing_credits\n# Credit obligations volatility calculated using standard deviation over 'normalized_existing_credits' grouped by 'residence_since'.\n# Usefulness: Identifies variations in existing credit patterns tied to residence stability, hinting at financial consistency or risk.\ndf['volatility_existing_credits'] = df.groupby('residence_since')['normalized_existing_credits'].transform('std')", "df.drop(columns=['checking_status', 'debt_to_income_ratio', 'employment_stability_score', 'loan_to_savings_ratio', 'installment_commitment'], inplace=True)"]
