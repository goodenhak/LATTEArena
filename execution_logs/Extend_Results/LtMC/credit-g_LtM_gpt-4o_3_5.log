# debt_to_income_ratio
# Debt-to-Income Ratio: credit_amount / (installment_commitment * duration)
# Usefulness: Represents affordability of credit relative to disposable income and payment period.

df['debt_to_income_ratio'] = df['credit_amount'] / (df['installment_commitment'] * df['duration'])
end

python
# loan_to_savings_ratio
# Loan-to-Savings Ratio: credit_amount / savings_status (label-encoded)
# Usefulness: Evaluates reliance on liquid reserves versus loan amount to understand financial stability.

df['savings_status_encoded'] = df['savings_status'].map({'<100': 1, 'no known savings': 2, '100<=X<500': 3, '500<=X<1000': 4, '>=1000': 5})
df['loan_to_savings_ratio'] = df['credit_amount'] / df['savings_status_encoded']
end

python
# installment_to_income_ratio
# Installment-to-Income Ratio: installment_commitment / duration
# Usefulness: Reflects repayment burden and affordability of installments per unit payment duration.

df['installment_to_income_ratio'] = df['installment_commitment'] / df['duration']
end

python
# normalized_existing_credits
# Existing Credits Normalized: existing_credits / residence_since
# Usefulness: Relates current credit obligations to stability in residence duration, influencing risk.

df['normalized_existing_credits'] = df['existing_credits'] / df['residence_since']
end

python
# employment_stability_score
# Employment Stability Score: Label encode employment and derive groupbythenmean for housing influence.
# Usefulness: Quantifies employment duration to cross-check housing stability for socio-economic positioning.

employment_mapping = {'unemployed': 1, '<1': 2, '1<=X<4': 3, '4<=X<7': 4, '>=7': 5}
df['employment_encoded'] = df['employment'].map(employment_mapping)
df['employment_stability_score'] = df.groupby('housing')['employment_encoded'].transform('mean')
end

python
# duration_burden_score
# Duration Burden Score: Apply zscore to duration for deviation in repayment period.
# Usefulness: Highlights repayment risk tied to unusually long or short loan durations.

df['duration_burden_score'] = (df['duration'] - df['duration'].mean()) / df['duration'].std()
end

python
# age_to_dependents_ratio
# Age-to-Dependents Ratio: age / num_dependents
# Usefulness: Normalizes age against the number of dependents to capture financial strain and responsibilities.

df['age_to_dependents_ratio'] = df['age'] / df['num_dependents']
end

python
# drop_savings_status_encoded
df.drop(columns=['savings_status_encoded'], inplace=True)
end

python
# drop_employment_encoded
df.drop(columns=['employment_encoded'], inplace=True)
end
