2026-05-26 02:23:00,866 - INFO - ops_string = ["# COMPACTNESS_LOG_CIRCULARITY_PRODUCT\n# Feature description: Logarithm of the product of COMPACTNESS and CIRCULARITY to capture compactness and circular resemblance on a standardized scale.\n# Usefulness: Combines two critical geometric metrics, reduces skewness, and highlights regions with high compactness and circularity contrast.\ndf['COMPACTNESS_LOG_CIRCULARITY_PRODUCT'] = np.log(df['COMPACTNESS'] * df['CIRCULARITY'])", "# ELONGATEDNESS_SYMMETRY_RATIO\n# Feature description: Ratio of ELONGATEDNESS to AXIS_SYMMETRY_VALUES to assess elongation relative to symmetry deviations.\n# Usefulness: Differentiates elongated entities with varying symmetry, which is critical in distinguishing vehicle silhouettes like VAN from BUS.\ndf['ELONGATEDNESS_SYMMETRY_RATIO'] = df['ELONGATEDNESS'] / df['AXIS_SYMMETRY_VALUES']", "# TEXTURE_VARIANCE_TO_ELONGATION\n# Feature description: Ratio of Texture_Variance_Interaction to ELONGATEDNESS to normalize texture variance by elongation characteristics.\n# Usefulness: Highlights textural anomalies in elongated shapes, crucial for distinguishing similar geometric features with different textures (e.g., SAAB vs OPEL).\ndf['TEXTURE_VARIANCE_TO_ELONGATION'] = df['Texture_Variance_Interaction'] / df['ELONGATEDNESS']", "# NORMALIZED_SHAPE_TEXTURE_DIFFERENCE\n# Feature description: Min-max scaled Shape_Texture_Difference to normalize the disparity between shape and texture for consistent magnitude representation.\n# Usefulness: Enhances comparability of shape-texture contrasts across all samples, a key discriminator for subtle vehicle silhouette differences.\ndf['NORMALIZED_SHAPE_TEXTURE_DIFFERENCE'] = (df['Shape_Texture_Difference'] - df['Shape_Texture_Difference'].min()) / (df['Shape_Texture_Difference'].max() - df['Shape_Texture_Difference'].min())", "# RECTANGULARITY_INTEGRATION_SCORE\n# Feature description: Sum of MAX.LENGTH_RECTANGULARITY and RECTANGULAR_SCORE to create a comprehensive rectangular fit indicator.\n# Usefulness: Aggregates complementary rectangular metrics for classifying vehicles like BUS and VAN with distinct rectangular shapes.\ndf['RECTANGULARITY_INTEGRATION_SCORE'] = df['MAX.LENGTH_RECTANGULARITY'] + df['RECTANGULAR_SCORE']", "# COMPACTNESS_VARIANCE_DISPARITY\n# Feature description: Ratio of COMPACTNESS to VARIANCE_DISPARITY_SCORE to combine compactness and variance disparity into a unified feature.\n# Usefulness: Differentiates vehicles with regular compact shapes from those exhibiting higher internal variance contrasts.\ndf['COMPACTNESS_VARIANCE_DISPARITY'] = df['COMPACTNESS'] / (df['VARIANCE_DISPARITY_SCORE'] + 1e-5)", "# TEXTURE_HOLLOW_INTEGRATION\n# Feature description: Product of TEXTURE_INTERACTION and HOLLOWS_RATIO to integrate texture and hollow space information.\n# Usefulness: Identifies vehicles with significant hollow and textural interplay, aiding in distinguishing geometrically distinct classes like VAN and SAAB.\ndf['TEXTURE_HOLLOW_INTEGRATION'] = df['TEXTURE_INTERACTION'] * df['HOLLOWS_RATIO']", "# FINAL_SHAPE_COMPACTNESS_METRIC\n# Feature description: Product of Shape_Compactness_Ratio and Z_Shape_Symmetry to capture compactness and normalized shape symmetry.\n# Usefulness: Provides a comprehensive metric that evaluates compactness scaled for symmetrical deviations, improving class-separation ability.\ndf['FINAL_SHAPE_COMPACTNESS_METRIC'] = df['Shape_Compactness_Ratio'] * df['Z_Shape_Symmetry']", "# DROP_IRRELEVANT_COLUMNS\n# Dropping columns that are redundant due to inclusion in derived features or non-informative for classification.\ndf.drop(columns=['Shape_Compactness_Ratio', 'RECTANGULAR_SCORE', 'Shape_Texture_Difference', 'TEXTURE_INTERACTION'], inplace=True)"]
