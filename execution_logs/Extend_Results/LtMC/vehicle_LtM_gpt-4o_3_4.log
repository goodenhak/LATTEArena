# COMPACTNESS_CIRCULARITY_RATIO
# Ratio of compactness to circularity to evaluate compactness relative to circular shape.
# Usefulness: Helps differentiate vehicles with more circular profiles (e.g., BUS) from compact ones (e.g., VAN).
df['COMPACTNESS_CIRCULARITY_RATIO'] = df['COMPACTNESS'] / df['CIRCULARITY']
end

python
# DISTANCE_RADIUS_CONTRAST
# Ratio of distance circularity to radius ratio to highlight boundary uniformity versus radial variability.
# Usefulness: Captures interplay between boundary shapes and elongation, useful for complex profiles like SAAB.
df['DISTANCE_RADIUS_CONTRAST'] = df['DISTANCE_CIRCULARITY'] / df['RADIUS_RATIO']
end

python
# AXIS_SYMMETRY_VALUES
# Difference between PR.AXIS_ASPECT_RATIO and MAX.LENGTH_ASPECT_RATIO to indicate symmetry variance.
# Usefulness: Helps identify shape differences in elongated versus more symmetrical designs, important for distinguishing OPEL or SAAB profiles.
df['AXIS_SYMMETRY_VALUES'] = df['PR.AXIS_ASPECT_RATIO'] - df['MAX.LENGTH_ASPECT_RATIO']
end

python
# VARIANCE_DISPARITY_SCORE
# Difference of z-scores of scaled variances along the major and minor axes.
# Usefulness: Highlights spread discrepancies in different axes, key for asymmetric or irregular shapes.
df['VARIANCE_DISPARITY_SCORE'] = (df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'].mean()) / df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'].std() - (df['SCALED_VARIANCE_ALONG_MINOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MINOR_AXIS'].mean()) / df['SCALED_VARIANCE_ALONG_MINOR_AXIS'].std()
end

python
# SKEWNESS_RATIO
# Ratio of skewness about the major axis to the minor axis.
# Usefulness: Describes skewness alignment and mass asymmetry, important for distinguishing nuanced shapes like SAAB vs. OPEL.
df['SKEWNESS_RATIO'] = df['SKEWNESS_ABOUT_MAJOR_AXIS'] / (df['SKEWNESS_ABOUT_MINOR_AXIS'] + 1e-5)
end

python
# KURTOSIS_DIFF
# Difference between kurtosis about the major and minor axes.
# Usefulness: Identifies peakedness variation along axes, differentiating vehicles with sharp mass distributions like VAN and OPEL.
df['KURTOSIS_DIFF'] = df['KURTOSIS_ABOUT_MAJOR_AXIS'] - df['KURTOSIS_ABOUT_MINOR_AXIS']
end

python
# HOLLOWS_VS_RECTANGULARITY
# Ratio of hollows ratio to PR.AXIS_RECTANGULARITY to compare hollow space to normalized primary axis area.
# Usefulness: Differentiates vehicles with significant hollow areas like BUS from compact structures like OPEL.
df['HOLLOWS_VS_RECTANGULARITY'] = df['HOLLOWS_RATIO'] / df['PR.AXIS_RECTANGULARITY']
end

python
# NORMALIZED_COMPACTNESS
# Min-max scaling of compactness.
# Usefulness: Normalizes compactness to a comparable range, useful for interpreting its relation to other features like CIRCULARITY.
df['NORMALIZED_COMPACTNESS'] = (df['COMPACTNESS'] - df['COMPACTNESS'].min()) / (df['COMPACTNESS'].max() - df['COMPACTNESS'].min())
end

python
# SCALED_ELONGATEDNESS_RADIUS
# Product of elongatedness and scaled radius of gyration.
# Usefulness: Combines shape stretch with mass distribution extent, useful for distinguishing elongated vehicles like VAN.
df['SCALED_ELONGATEDNESS_RADIUS'] = df['ELONGATEDNESS'] * df['SCALED_RADIUS_OF_GYRATION']
end

python
# DROP_LOW_VARIATION_FEATURES
# Drop features with low variation that may not contribute significantly to classification.
# Usefulness: Reduces noise from features with minimal variability.
df.drop(columns=['SKEWNESS_ABOUT_MINOR_AXIS', 'KURTOSIS_ABOUT_MINOR_AXIS'], inplace=True)
end
