# COMPACTNESS_SQRT
# Square root transformation of COMPACTNESS for reducing skewness.
# Usefulness: Helps normalize the data, addressing skewness and wide range in compactness values, making patterns more detectable.
df['COMPACTNESS_SQRT'] = df['COMPACTNESS']  0.5
end

python
# CIRCULARITY_LOG
# Log transformation of CIRCULARITY for reducing skewness and emphasizing smaller values.
# Usefulness: Helps capture subtle differences in shapes that closely resemble circular ones.
df['CIRCULARITY_LOG'] = np.log(df['CIRCULARITY'] + 1)
end

python
# PR.AXIS_TO_MAX.LENGTH_RATIO
# Ratio of PR.AXIS_ASPECT_RATIO to MAX.LENGTH_ASPECT_RATIO to evaluate relative axis symmetry.
# Usefulness: Highlights variations in symmetry, critical for distinguishing vehicle shapes.
df['PR.AXIS_TO_MAX.LENGTH_RATIO'] = df['PR.AXIS_ASPECT_RATIO'] / df['MAX.LENGTH_ASPECT_RATIO']
end

python
# SHAPE_AREA_EFFICIENCY_DIFF
# Difference between PR.AXIS_RECTANGULARITY and MAX.LENGTH_RECTANGULARITY for contrasting area efficiencies.
# Usefulness: Indicates how well the shape fits within the rectangular bounding frames, useful for shape characterization.
df['SHAPE_AREA_EFFICIENCY_DIFF'] = df['PR.AXIS_RECTANGULARITY'] - df['MAX.LENGTH_RECTANGULARITY']
end

python
# BOUNDARY_RADIAL_INTERACTION
# Interaction between DISTANCE_CIRCULARITY and RADIUS_RATIO to highlight boundary irregularities versus radial variations.
# Usefulness: Enhances detection of shapes with non-uniform boundaries, aiding vehicle type categorization.
df['BOUNDARY_RADIAL_INTERACTION'] = df['DISTANCE_CIRCULARITY'] * df['RADIUS_RATIO']
end

python
# MINOR_VARIANCE_GYRATION_PRODUCT
# Product of SCALED_RADIUS_OF_GYRATION and SCALED_VARIANCE_ALONG_MINOR_AXIS to emphasize minor axis variability.
# Usefulness: Captures the influence of minor axis distribution on overall shape spread.
df['MINOR_VARIANCE_GYRATION_PRODUCT'] = df['SCALED_RADIUS_OF_GYRATION'] * df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# SKEWNESS_KURTOSIS_INTERACTION
# Ratio of SKEWNESS_ABOUT_MAJOR_AXIS to KURTOSIS_ABOUT_MAJOR_AXIS for combining asymmetry and dispersion intensity.
# Usefulness: Links asymmetry and spread intensity to detect outliers or unique shapes.
df['SKEWNESS_KURTOSIS_INTERACTION'] = df['SKEWNESS_ABOUT_MAJOR_AXIS'] / df['KURTOSIS_ABOUT_MAJOR_AXIS']
end

python
# ELONGATION_SCATTER_PRODUCT
# Cross-product of ELONGATEDNESS and SCATTER_RATIO for elongation-inertia interaction.
# Usefulness: Highlights the relationship between elongation and axis scatter, aiding shape differentiation.
df['ELONGATION_SCATTER_PRODUCT'] = df['ELONGATEDNESS'] * df['SCATTER_RATIO']
end

python
# HOLLOWS_MAX.RECT_PRODUCT
# Product of HOLLOWS_RATIO and MAX.LENGTH_RECTANGULARITY to examine hollow impacts on maximal rectangularity.
# Usefulness: Connects hollow space proportions to rectangle efficiency, revealing shape intricacies.
df['HOLLOWS_MAX.RECT_PRODUCT'] = df['HOLLOWS_RATIO'] * df['MAX.LENGTH_RECTANGULARITY']
end

python
# WIDTH_VARIANCE_DISPARITY
# Difference of z-scores for SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCALED_VARIANCE_ALONG_MINOR_AXIS.
# Usefulness: Pinpoints shapes with major and minor axis variability discrepancies.
df['WIDTH_VARIANCE_DISPARITY'] = zscore(df['SCALED_VARIANCE_ALONG_MAJOR_AXIS']) - zscore(df['SCALED_VARIANCE_ALONG_MINOR_AXIS'])
end

python
# NORMALIZED_SKEWNESS_RATIO
# Min-max normalization of SKEWNESS_RATIO for better comparability of skewness differences.
# Usefulness: Reduces the impact of extreme values while preserving discrimination in skewness patterns.
df['NORMALIZED_SKEWNESS_RATIO'] = (df['SKEWNESS_RATIO'] - df['SKEWNESS_RATIO'].min()) / (df['SKEWNESS_RATIO'].max() - df['SKEWNESS_RATIO'].min())
end

python
# SCALED_COMPACTNESS_AREA_RATIO
# Ratio of NORMALIZED_COMPACTNESS to PR.AXIS_RECTANGULARITY to focus on compactness relative to primary axis area.
# Usefulness: Enhances understanding of how compactness varies with normalized area metrics.
df['SCALED_COMPACTNESS_AREA_RATIO'] = df['NORMALIZED_COMPACTNESS'] / df['PR.AXIS_RECTANGULARITY']
end

python
# LOG_ELONGATEDNESS
# Log transformation of ELONGATEDNESS to reduce skewness and emphasize lower elongation levels.
# Usefulness: Highlights subtle shape differences in less elongated forms.
df['LOG_ELONGATEDNESS'] = np.log(df['ELONGATEDNESS'] + 1)
end

python
df.drop(columns=['SKEWNESS_RATIO'], inplace=True)
end

python
df.drop(columns=['NORMALIZED_COMPACTNESS'], inplace=True)
end
