# COMPACTNESS_CIRCULARITY_RATIO
# Ratio of COMPACTNESS to CIRCULARITY to evaluate compactness relative to circular shape.
# Usefulness: Measures how compact a vehicle silhouette is in relation to its circular nature, aiding in distinguishing between class shapes like SAAB and OPEL.
df['COMPACTNESS_CIRCULARITY_RATIO'] = df['COMPACTNESS'] / df['CIRCULARITY']
end

python
# DISTANCE_RADIUS_CONTRAST
# Ratio of DISTANCE_CIRCULARITY to RADIUS_RATIO to highlight boundary uniformity versus radial variability.
# Usefulness: Distinguishes variability in boundary uniformity across classes, particularly useful in elongation-heavy shapes like VANs or BUSes.
df['DISTANCE_RADIUS_CONTRAST'] = df['DISTANCE_CIRCULARITY'] / df['RADIUS_RATIO']
end

python
# AXIS_SYMMETRY_VALUES
# Difference between PR.AXIS_ASPECT_RATIO and MAX.LENGTH_ASPECT_RATIO to indicate symmetry variance.
# Usefulness: Captures asymmetry in vehicle profiles, key in distinguishing shapes like buses from sedans.
df['AXIS_SYMMETRY_VALUES'] = df['PR.AXIS_ASPECT_RATIO'] - df['MAX.LENGTH_ASPECT_RATIO']
end

python
# SCALED_ELONGATEDNESS_RADIUS
# Product of ELONGATEDNESS and SCALED_RADIUS_OF_GYRATION to integrate overall length and rotational properties.
# Usefulness: Provides a magnitude-based feature integrating elongatedness and rotational variance, aiding in detailed shape classification.
df['SCALED_ELONGATEDNESS_RADIUS'] = df['ELONGATEDNESS'] * df['SCALED_RADIUS_OF_GYRATION']
end

python
# VARIANCE_DISPARITY_SCORE
# Difference of z-scores between SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCALED_VARIANCE_ALONG_MINOR_AXIS.
# Usefulness: Highlights disparity in how a silhouette's area varies along major versus minor axes, critical in asymmetric vehicle types.
df['VARIANCE_DISPARITY_SCORE'] = (df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'].mean()) / df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'].std() - \
                                  (df['SCALED_VARIANCE_ALONG_MINOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MINOR_AXIS'].mean()) / df['SCALED_VARIANCE_ALONG_MINOR_AXIS'].std()
end

python
# HOLLOWS_VS_RECTANGULARITY
# Ratio of HOLLOWS_RATIO to PR.AXIS_RECTANGULARITY to compare hollow space to normalized primary axis area.
# Usefulness: Differentiates shapes with significant hollow regions relative to axis-based rectangularity, like utility vehicles.
df['HOLLOWS_VS_RECTANGULARITY'] = df['HOLLOWS_RATIO'] / df['PR.AXIS_RECTANGULARITY']
end

python
# NORMALIZED_COMPACTNESS
# Min-max scaling of COMPACTNESS to normalize its range between 0 and 1.
# Usefulness: Scales compactness to remove bias from feature range differences, providing fair weight in predictive models.
df['NORMALIZED_COMPACTNESS'] = (df['COMPACTNESS'] - df['COMPACTNESS'].min()) / (df['COMPACTNESS'].max() - df['COMPACTNESS'].min())
end

python
# KURTOSIS_DIFF
# Difference between KURTOSIS_ABOUT_MAJOR_AXIS and an assumed KURTOSIS_ABOUT_MINOR_AXIS for higher moment analysis.
# Usefulness: Analyzes the distributional tails along major and minor axes for capturing outlier skew class-dependent behavior.
df['KURTOSIS_DIFF'] = df['KURTOSIS_ABOUT_MAJOR_AXIS'] - df['KURTOSIS_ABOUT_MAJOR_AXIS'].mean()
end

python
df.drop(columns=['KURTOSIS_ABOUT_MINOR_AXIS'], inplace=True)
end

python
df.drop(columns=['SKEWNESS_RATIO'], inplace=True)
end
