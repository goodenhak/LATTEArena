# Shape_Compactness_Ratio
# Ratio of SHAPE_SCORE to COMPACTNESS_CIRCULARITY_RATIO for integrating shape and circularity measurement.
# Usefulness: Combines shape and compactness circularity to better distinguish vehicles with compact or elongated silhouettes.
df['Shape_Compactness_Ratio'] = df['SHAPE_SCORE'] / df['COMPACTNESS_CIRCULARITY_RATIO']
end

python
# Symmetry_Texture_Ratio
# Ratio of AXIS_SYMMETRY_VALUES to TEXTURE_INTERACTION to capture combined symmetry and texture impacts across silhouette features.
# Usefulness: Highlights how symmetrical features relate to texture irregularities, crucial for distinguishing between vehicle types like BUS and VAN with differing hollow structures.
df['Symmetry_Texture_Ratio'] = df['AXIS_SYMMETRY_VALUES'] / df['TEXTURE_INTERACTION']
end

python
# Variance_Contrast_Symmetry_Difference
# Difference between DIRECTIONAL_VARIANCE_CONTRAST and AXIS_SYMMETRY_VALUES to combine variance contrast and symmetry variance.
# Usefulness: Provides contrast in variance attributed to symmetry properties, enhancing separability of less symmetric vehicles like VAN.
df['Variance_Contrast_Symmetry_Difference'] = df['DIRECTIONAL_VARIANCE_CONTRAST'] - df['AXIS_SYMMETRY_VALUES']
end

python
# Shape_Texture_Difference
# Difference between SHAPE_SCORE and TEXTURE_INTERACTION to highlight shape versus texture differences.
# Usefulness: Enables differentiation of vehicles based on dominant shape or texture influences, useful for capturing class-level differences.
df['Shape_Texture_Difference'] = df['SHAPE_SCORE'] - df['TEXTURE_INTERACTION']
end

python
# Z_Shape_Symmetry
# Z-score normalization for SHAPE_SCORE and SYMMETRY_SCORE for easier interpretability and comparison.
# Usefulness: Standardizes shape and symmetry features for modeling, improving interpretability and enhancing downstream task performance.
df['Z_Shape_Symmetry'] = (df['SHAPE_SCORE'] - df['SHAPE_SCORE'].mean()) / df['SHAPE_SCORE'].std()
end

python
# Elongated_Symmetry_Interaction
# Product of ELONGATEDNESS and AXIS_SYMMETRY_VALUES to capture elongation characteristics influenced by symmetry.
# Usefulness: Highlights the combined impact of elongation and symmetry, aiding in distinguishing elongated and symmetric silhouettes like OPEL and SAAB.
df['Elongated_Symmetry_Interaction'] = df['ELONGATEDNESS'] * df['AXIS_SYMMETRY_VALUES']
end

python
# Texture_Variance_Interaction
# Product of SCATTER_RATIO and DIRECTIONAL_VARIANCE_CONTRAST to merge texture orientation and variance disparity.
# Usefulness: Captures interaction between texture scatter and directional variance, differentiating classes with contrasting texture-density patterns like BUS and VAN.
df['Texture_Variance_Interaction'] = df['SCATTER_RATIO'] * df['DIRECTIONAL_VARIANCE_CONTRAST']
end

python
# Grouped_Variance_Mean
# Groupbythenmean applied on SCALED_VARIANCE_ALONG_MAJOR_AXIS by class to obtain within-class mean variability.
# Usefulness: Provides within-class variance tendency, useful for identifying consistent patterns in silhouettes per vehicle type.
df['Grouped_Variance_Mean'] = df.groupby('vehicle_class')['SCALED_VARIANCE_ALONG_MAJOR_AXIS'].transform('mean')
end

python
# Grouped_Variance_Std
# Groupbythenstd applied on SCALED_VARIANCE_ALONG_MINOR_AXIS by class to obtain within-class variance dispersion.
# Usefulness: Highlights dispersion in scaled variance within classes, emphasizing class-dependent variability in minor axis scaling.
df['Grouped_Variance_Std'] = df.groupby('vehicle_class')['SCALED_VARIANCE_ALONG_MINOR_AXIS'].transform('std')
end

python
# Grouped_Hollows_Mean
# Groupbythenmean applied on HOLLOWS_RATIO by class to obtain within-class average hollow ratios.
# Usefulness: Differentiates vehicles by average hollow space usage, critical for distinguishing classes like VAN and BUS with large hollow variations.
df['Grouped_Hollows_Mean'] = df.groupby('vehicle_class')['HOLLOWS_RATIO'].transform('mean')
end

python
# Dropping redundant columns
df.drop(columns=['Z_SKEWNESS_RATIO', 'SYMMETRY_SCORE'], inplace=True)
end
