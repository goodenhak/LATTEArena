# COMPACTNESS_CIRCULARITY_RATIO
# Ratio of compactness to circularity to evaluate compactness relative to circular shape.
# Usefulness: Differentiates between types of vehicles with rounded or elongated shapes.
df['COMPACTNESS_CIRCULARITY_RATIO'] = df['COMPACTNESS'] / df['CIRCULARITY']
end

python
# DISTANCE_RADIUS_CONTRAST
# Ratio of distance circularity to radius ratio to highlight boundary uniformity versus radial variability.
# Usefulness: Captures the contrast between boundary uniformity and radial variability, important for distinguishing vehicle contours.
df['DISTANCE_RADIUS_CONTRAST'] = df['DISTANCE_CIRCULARITY'] / df['RADIUS_RATIO']
end

python
# AXIS_SYMMETRY_VALUES
# Difference between PR.AXIS_ASPECT_RATIO and MAX.LENGTH_ASPECT_RATIO to indicate symmetry variance.
# Usefulness: Highlights asymmetry between primary and minor axis ratios, useful for characterizing different vehicle profiles.
df['AXIS_SYMMETRY_VALUES'] = df['PR.AXIS_ASPECT_RATIO'] - df['MAX.LENGTH_ASPECT_RATIO']
end

python
# VARIANCE_DISPARITY_SCORE
# Difference of z-scores of scaled variances along the major and minor axes.
# Usefulness: Measures spread contrast, useful in differentiating variance-heavy silhouettes like buses versus compact cars.
df['VARIANCE_DISPARITY_SCORE'] = (
    (df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'].mean()) / df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'].std()
    - (df['SCALED_VARIANCE_ALONG_MINOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MINOR_AXIS'].mean()) / df['SCALED_VARIANCE_ALONG_MINOR_AXIS'].std()
)
end

python
# HOLLOWS_VS_RECTANGULARITY
# Ratio of hollows ratio to PR.AXIS_RECTANGULARITY to compare hollow space to normalized primary axis area.
# Usefulness: Differentiates vehicles with significant internal voids (e.g., BUS) vs. those with more compact structures.
df['HOLLOWS_VS_RECTANGULARITY'] = df['HOLLOWS_RATIO'] / df['PR.AXIS_RECTANGULARITY']
end

python
# NORMALIZED_COMPACTNESS
# Min-max scaling of compactness.
# Usefulness: Normalized feature ensures uniformity for compactness comparisons across vehicles.
df['NORMALIZED_COMPACTNESS'] = (df['COMPACTNESS'] - df['COMPACTNESS'].min()) / (df['COMPACTNESS'].max() - df['COMPACTNESS'].min())
end

python
# SCALED_ELONGATEDNESS_RADIUS
# Product of elongatedness and scaled radius of gyration.
# Usefulness: Combines elongation and spread metrics to highlight larger vehicles, such as buses and vans, versus compact vehicles.
df['SCALED_ELONGATEDNESS_RADIUS'] = df['ELONGATEDNESS'] * df['SCALED_RADIUS_OF_GYRATION']
end

python
# SKEWNESS_RATIO
# Ratio of skewness about the major axis to the minor axis.
# Usefulness: Highlights asymmetry in higher-order shape moments, providing insights into the unevenness of vehicle silhouettes.
df['SKEWNESS_RATIO'] = df['SKEWNESS_ABOUT_MAJOR_AXIS'] / df['SKEWNESS_ABOUT_MAJOR_AXIS']
end

python
df.drop(columns=['SKEWNESS_RATIO'], inplace=True)
