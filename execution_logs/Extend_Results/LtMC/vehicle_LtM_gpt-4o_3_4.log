# SHAPE_SCORE
# Feature description: Mean of COMPACTNESS, CIRCULARITY, and ELONGATEDNESS to create an overall shape score.
# Usefulness: Summarizes key shape descriptors into a single metric to distinguish compact, circular, and elongated shapes effectively.
df['SHAPE_SCORE'] = (df['COMPACTNESS'] + df['CIRCULARITY'] + df['ELONGATEDNESS']) / 3
end

python
# SYMMETRY_SCORE
# Feature description: Difference between PR.AXIS_ASPECT_RATIO and MAX.LENGTH_ASPECT_RATIO to capture symmetry variance.
# Usefulness: Highlights symmetry imbalances, which are critical for differentiating asymmetrical silhouettes.
df['SYMMETRY_SCORE'] = df['PR.AXIS_ASPECT_RATIO'] - df['MAX.LENGTH_ASPECT_RATIO']
end

python
# TEXTURE_INTERACTION
# Feature description: Product of SCATTER_RATIO and HOLLOWS_RATIO to capture texture and hollow shape irregularities.
# Usefulness: Emphasizes texture variance by combining scatter inertia with hollow area contributions.
df['TEXTURE_INTERACTION'] = df['SCATTER_RATIO'] * df['HOLLOWS_RATIO']
end

python
# NORMALIZED_RADIUS_VARIABILITY
# Feature description: Ratio of DISTANCE_CIRCULARITY to RADIUS_RATIO to normalize boundary uniformity against radial variability.
# Usefulness: Refines variability analysis to distinguish silhouettes with irregular boundaries.
df['NORMALIZED_RADIUS_VARIABILITY'] = df['DISTANCE_CIRCULARITY'] / df['RADIUS_RATIO']
end

python
# LOG_COMPACTNESS
# Feature description: Logarithm of COMPACTNESS to reduce skewness and emphasize relative variations.
# Usefulness: Highlights deviations in compactness, particularly for elongated or highly compact silhouettes.
df['LOG_COMPACTNESS'] = np.log(df['COMPACTNESS'])
end

python
# DIRECTIONAL_VARIANCE_CONTRAST
# Feature description: Difference between SCALED_VARIANCE_ALONG_MINOR_AXIS and SCALED_VARIANCE_ALONG_MAJOR_AXIS to depict variance disparity.
# Usefulness: Captures directional variability contrast, aiding class differentiation based on shape anisotropy.
df['DIRECTIONAL_VARIANCE_CONTRAST'] = df['SCALED_VARIANCE_ALONG_MINOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MAJOR_AXIS']
end

python
# RECTANGULAR_SCORE
# Feature description: Sum of PR.AXIS_RECTANGULARITY and MAX.LENGTH_RECTANGULARITY to measure rectangular fit comprehensively.
# Usefulness: Aggregates two metrics tied to rectangle-like appearances, improving differentiation for rectangular silhouettes.
df['RECTANGULAR_SCORE'] = df['PR.AXIS_RECTANGULARITY'] + df['MAX.LENGTH_RECTANGULARITY']
end

python
# COMPACTNESS_CIRCULARITY_PRODUCT
# Feature description: Product of COMPACTNESS and CIRCULARITY to combine compactness and circular resemblance.
# Usefulness: Enhances classification for shapes that are compact but deviate from perfect circularity.
df['COMPACTNESS_CIRCULARITY_PRODUCT'] = df['COMPACTNESS'] * df['CIRCULARITY']
end

python
# HOLLOW_TEXTURE_RATIO
# Feature description: Ratio of HOLLOWS_RATIO to SCALED_RADIUS_OF_GYRATION to normalize hollow spaces by gyration scaling.
# Usefulness: Balances hollow texture measurements against radial gyration factors for sharper shape distinctions.
df['HOLLOW_TEXTURE_RATIO'] = df['HOLLOWS_RATIO'] / df['SCALED_RADIUS_OF_GYRATION']
end

python
# Z_SKEWNESS_RATIO
# Feature description: Z-score normalization of SKEWNESS_RATIO to standardize it for easier interpretability.
# Usefulness: Mitigates outlier effects while providing a better comparison of higher-order skewness across classes.
df['Z_SKEWNESS_RATIO'] = (df['SKEWNESS_RATIO'] - df['SKEWNESS_RATIO'].mean()) / df['SKEWNESS_RATIO'].std()
end

python
# COMPACTNESS_ELONGATEDNESS_CONTRAST
# Feature description: Ratio of COMPACTNESS to ELONGATEDNESS to measure compactness in the context of elongation.
# Usefulness: Differentiates between compact circular and stretched elongated silhouettes.
df['COMPACTNESS_ELONGATEDNESS_CONTRAST'] = df['COMPACTNESS'] / df['ELONGATEDNESS']
end

python
# SKEWNESS_KURTOSIS_FUSION
# Feature description: Sum of normalized SKEWNESS_ABOUT_MAJOR_AXIS and KURTOSIS_DIFF to combine skewness and kurtosis.
# Usefulness: Fuses shape asymmetry and peakedness descriptors for enhanced overall silhouette differentiation.
df['SKEWNESS_KURTOSIS_FUSION'] = (df['SKEWNESS_ABOUT_MAJOR_AXIS'] / df['SKEWNESS_ABOUT_MAJOR_AXIS'].max()) + (df['KURTOSIS_DIFF'] / df['KURTOSIS_DIFF'].max())
end

python
df.drop(columns=['SKEWNESS_RATIO'], inplace=True)
end

python
df.drop(columns=['KURTOSIS_DIFF'], inplace=True)
end
