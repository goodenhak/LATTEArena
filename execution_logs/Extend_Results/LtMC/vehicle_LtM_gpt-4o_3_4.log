df['Elongated_Symmetry_Product_Scaled'] = (df['Elongated_Symmetry_Interaction'] - df['Elongated_Symmetry_Interaction'].min()) / (df['Elongated_Symmetry_Interaction'].max() - df['Elongated_Symmetry_Interaction'].min())
end

