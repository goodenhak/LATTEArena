2026-05-26 02:22:30,143 - INFO - ops_string = ["# Shape_Elongatedness_Contrast\n# Ratio of SHAPE_SCORE to ELONGATEDNESS to integrate shape characteristics relative to elongated structures.\n# Usefulness: Captures how the overall shape is distributed relative to elongated features, relevant for categorizing distinct vehicle types.\ndf['Shape_Elongatedness_Contrast'] = df['SHAPE_SCORE'] / df['ELONGATEDNESS']", "# Symmetry_Shape_Mean\n# Arithmetic mean of AXIS_SYMMETRY_VALUES and SHAPE_SCORE to integrate symmetry and overall shape dimensions.\n# Usefulness: Useful for vehicles' varying body symmetries while taking into account their overall silhouette shape.\ndf['Symmetry_Shape_Mean'] = (df['AXIS_SYMMETRY_VALUES'] + df['SHAPE_SCORE']) / 2", "# Compactness_Texture_Difference\n# Difference between NORMALIZED_COMPACTNESS and TEXTURE_INTERACTION to highlight compactness versus texture irregularities.\n# Usefulness: Differentiates vehicles with compact designs versus those with irregular textural features.\ndf['Compactness_Texture_Difference'] = df['NORMALIZED_COMPACTNESS'] - df['TEXTURE_INTERACTION']", "# Log_Shape_Compactness_Ratio\n# Logarithm of Shape_Compactness_Ratio to reduce skewness effects in the feature distribution.\n# Usefulness: Scales the Shape_Compactness_Ratio metric for better interpretability and smoother distributions during model training.\ndf['Log_Shape_Compactness_Ratio'] = np.log(df['Shape_Compactness_Ratio'])", "# Z_Elongatedness\n# Z-score normalization of ELONGATEDNESS.\n# Usefulness: Standardizes elongatedness for effective comparison across vehicle classes, considering its wide variance.\ndf['Z_Elongatedness'] = (df['ELONGATEDNESS'] - df['ELONGATEDNESS'].mean()) / df['ELONGATEDNESS'].std()", "# Radius_Texture_Contrast\n# Ratio of RADIUS_RATIO to HOLLOW_TEXTURE_RATIO to distinguish boundary variability normalized by hollow-texture alignment.\n# Usefulness: Highlights vehicles with significant boundary irregularities versus texture balance.\ndf['Radius_Texture_Contrast'] = df['RADIUS_RATIO'] / df['HOLLOW_TEXTURE_RATIO']", "# Distance_Elongatedness_Product\n# Product of DISTANCE_CIRCULARITY and ELONGATEDNESS to integrate circular boundary and elongated design aspects.\n# Usefulness: Captures combined effects of boundary uniformity and lengthened geometry for vehicle classification.\ndf['Distance_Elongatedness_Product'] = df['DISTANCE_CIRCULARITY'] * df['ELONGATEDNESS']", "# Shape_Compactness_Texture\n# Product of SHAPE_SCORE, COMPACTNESS, and TEXTURE_INTERACTION to integrate geometry, density, and surface irregularity.\n# Usefulness: Creates a holistic metric that combines geometric shape, compactness, and texture for better classification.\ndf['Shape_Compactness_Texture'] = df['SHAPE_SCORE'] * df['COMPACTNESS'] * df['TEXTURE_INTERACTION']", "# Kurtosis_Contrast_Interaction\n# Product of KURTOSIS_ABOUT_MAJOR_AXIS and DIRECTIONAL_VARIANCE_CONTRAST to combine shape distribution and variance.\n# Usefulness: Highlights asymmetries in kurtosis and variance critical for differentiating vehicle profiles.\ndf['Kurtosis_Contrast_Interaction'] = df['KURTOSIS_ABOUT_MAJOR_AXIS'] * df['DIRECTIONAL_VARIANCE_CONTRAST']", "# Elongated_Symmetry_Product_Scaled\n# Min-max scaled version of Elongated_Symmetry_Interaction for dimensionless comparability.\n# Usefulness: Normalizes elongation and symmetry interactions for equal weighting across features.\ndf['Elongated_Symmetry_Product_Scaled'] = (df['Elongated_Symmetry_Interaction'] - df['Elongated_Symmetry_Interaction'].min()) / (df['Elongated_Symmetry_Interaction'].max() - df['Elongated_Symmetry_Interaction'].min())", "df.drop(columns=['Shape_Texture_Difference', 'Variance_Disparity_Score'], inplace=True)"]
