# Usefulness: Highlights asymmetries in kurtosis and variance critical for differentiating vehicle profiles.
df['Kurtosis_Contrast_Interaction'] = df['KURTOSIS_ABOUT_MAJOR_AXIS'] * df['DIRECTIONAL_VARIANCE_CONTRAST']
end

python
