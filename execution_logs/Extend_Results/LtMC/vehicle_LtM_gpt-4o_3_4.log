2026-05-26 02:23:51,974 - INFO - ops_string = ["# SCALED_COMPACTNESS\n# Log-normalized value of COMPACTNESS using Z-Score for better comparability across samples.\n# Usefulness: Reduces skewness and highlights relative variations of compactness across samples.\ndf['SCALED_COMPACTNESS'] = (df['COMPACTNESS'] - df['COMPACTNESS'].mean()) / df['COMPACTNESS'].std()", "# SHAPE_TEXTURE_RATIO\n# Ratio of SHAPE_SCORE to TEXTURE_INTERACTION to understand shape contribution relative to texture variability.\n# Usefulness: Highlights the balance between shape and texture, revealing distinct vehicle type patterns.\ndf['SHAPE_TEXTURE_RATIO'] = df['SHAPE_SCORE'] / df['TEXTURE_INTERACTION']", "# COMPACTNESS_SYMMETRY_PRODUCT\n# Product of NORMALIZED_COMPACTNESS and AXIS_SYMMETRY_VALUES to merge compactness and symmetry characteristics.\n# Usefulness: Captures the joint influence of compactness and symmetry, aiding in discriminating vehicle types.\ndf['COMPACTNESS_SYMMETRY_PRODUCT'] = df['NORMALIZED_COMPACTNESS'] * df['AXIS_SYMMETRY_VALUES']", "# NORMALIZED_CIRCULARITY\n# Min-max scaling of the CIRCULARITY feature for consistent comparability.\n# Usefulness: Normalization ensures that circular shapes are evaluated on a uniform scale.\ndf['NORMALIZED_CIRCULARITY'] = (df['CIRCULARITY'] - df['CIRCULARITY'].min()) / (df['CIRCULARITY'].max() - df['CIRCULARITY'].min())", "# TEXTURE_COMPACTNESS_DIFFERENCE\n# Difference between TEXTURE_INTERACTION and LOG_COMPACTNESS to measure contrast in textural and compactness effects.\n# Usefulness: Highlights areas where texture and compactness differences are most pronounced across silhouettes.\ndf['TEXTURE_COMPACTNESS_DIFFERENCE'] = df['TEXTURE_INTERACTION'] - df['LOG_COMPACTNESS']", "# SYMMETRY_ELONGATEDNESS_INTERACTION\n# Product of SYMMETRY values (PR.AXIS_ASPECT_RATIO) and ELONGATEDNESS to explore how symmetry affects elongation.\n# Usefulness: Captures the interplay between elongated shape and symmetry, useful for differentiating vehicle classes.\ndf['SYMMETRY_ELONGATEDNESS_INTERACTION'] = df['PR.AXIS_ASPECT_RATIO'] * df['ELONGATEDNESS']", "# COMPACTNESS_CIRCULARITY_RELATION\n# Ratio of COMPACTNESS to CIRCULARITY to evaluate compactness relative to circular shape attributes.\n# Usefulness: Identifies compactness deviations in a circular context, aiding classification.\ndf['COMPACTNESS_CIRCULARITY_RELATION'] = df['COMPACTNESS'] / df['CIRCULARITY']", "# SHAPE_COMPACTNESS_RATIO\n# Ratio of SHAPE_SCORE to normalized COMPACTNESS for integrated measurement of shape and compactness.\n# Usefulness: Provides a composite understanding of shape compactness in silhouettes.\ndf['SHAPE_COMPACTNESS_RATIO'] = df['SHAPE_SCORE'] / df['NORMALIZED_COMPACTNESS']", "# VARIANCE_SYMMETRY_DISPARITY\n# Difference between DIRECTIONAL_VARIANCE_CONTRAST and Z_Shape_Symmetry to observe variance disparity with normalized symmetry.\n# Usefulness: Highlights silhouettes with larger variance asymmetries relative to symmetry.\ndf['VARIANCE_SYMMETRY_DISPARITY'] = df['DIRECTIONAL_VARIANCE_CONTRAST'] - df['Z_Shape_Symmetry']", "# NORMALIZED_RADIUS_ADJUSTED\n# Z-score standardization of RADIUS_RATIO for enhanced interpretability across ranges.\n# Usefulness: Normalizes radius variability to better compare radial deviations across vehicle types.\ndf['NORMALIZED_RADIUS_ADJUSTED'] = (df['RADIUS_RATIO'] - df['RADIUS_RATIO'].mean()) / df['RADIUS_RATIO'].std()", "# DROP_UNUSED_FEATURES\n# Drop features that are inherently derivable or less likely useful for downstream tasks.\n# Features dropped: PR.AXIS_RECTANGULARITY (redundant with RECTANGULAR_SCORE), LOG_COMPACTNESS (used in further transformations).\ndf.drop(columns=['PR.AXIS_RECTANGULARITY', 'LOG_COMPACTNESS'], inplace=True)"]
