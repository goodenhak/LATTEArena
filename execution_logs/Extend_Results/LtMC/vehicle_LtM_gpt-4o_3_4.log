ON\n# Ratio of SKEWNESS_ABOUT_MAJOR_AXIS to KURTOSIS_ABOUT_MAJOR_AXIS for combining asymmetry and dispersion intensity.\n# Usefulness: Links asymmetry and spread intensity to detect outliers or unique shapes.\ndf['SKEWNESS_KURTOSIS_INTERACTION'] = df['SKEWNESS_ABOUT_MAJOR_AXIS'] / df['KURTOSIS_ABOUT_MAJOR_AXIS']", "# ELONGATION_SCATTER_PRODUCT\n# Cross-product of ELONGATEDNESS and SCATTER_RATIO for elongation-inertia interaction.\n# Usefulness: Highlights the relationship between elongation and axis scatter, aiding shape differentiation.\ndf['ELONGATION_SCATTER_PRODUCT'] = df['ELONGATEDNESS'] * df['SCATTER_RATIO']", "# HOLLOWS_MAX.RECT_PRODUCT\n# Product of HOLLOWS_RATIO and MAX.LENGTH_RECTANGULARITY to examine hollow impacts on maximal rectangularity.\n# Usefulness: Connects hollow space proportions to rectangle efficiency, revealing shape intricacies.\ndf['HOLLOWS_MAX.RECT_PRODUCT'] = df['HOLLOWS_RATIO'] * df['MAX.LENGTH_RECTANGULARITY']", "# WIDTH_VARIANCE_DISPARITY\n# Difference of z-scores for SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCALED_VARIANCE_ALONG_MINOR_AXIS.\n# Usefulness: Pinpoints shapes with major and minor axis variability discrepancies.\ndf['WIDTH_VARIANCE_DISPARITY'] = zscore(df['SCALED_VARIANCE_ALONG_MAJOR_AXIS']) - zscore(df['SCALED_VARIANCE_ALONG_MINOR_AXIS'])", "# NORMALIZED_SKEWNESS_RATIO\n# Min-max normalization of SKEWNESS_RATIO for better comparability of skewness differences.\n# Usefulness: Reduces the impact of extreme values while preserving discrimination in skewness patterns.\ndf['NORMALIZED_SKEWNESS_RATIO'] = (df['SKEWNESS_RATIO'] - df['SKEWNESS_RATIO'].min()) / (df['SKEWNESS_RATIO'].max() - df['SKEWNESS_RATIO'].min())", "# SCALED_COMPACTNESS_AREA_RATIO\n# Ratio of NORMALIZED_COMPACTNESS to PR.AXIS_RECTANGULARITY to focus on compactness relative to primary axis area.\n# Usefulness: Enhances understanding of how compactness varies with normalized area metrics.\ndf['SCALED_COMPACTNESS_AREA_RATIO'] = df['NORMALIZED_COMPACTNESS'] / df['PR.AXIS_RECTANGULARITY']", "# LOG_ELONGATEDNESS\n# Log transformation of ELONGATEDNESS to reduce skewness and emphasize lower elongation levels.\n# Usefulness: Highlights subtle shape differences in less elongated forms.\ndf['LOG_ELONGATEDNESS'] = np.log(df['ELONGATEDNESS'] + 1)", "df.drop(columns=['SKEWNESS_RATIO'], inplace=True)", "df.drop(columns=['NORMALIZED_COMPACTNESS'], inplace=True)"]
