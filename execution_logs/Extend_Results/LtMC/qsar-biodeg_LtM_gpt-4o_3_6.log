# ocr
# Calculate oxygen to carbon ratio: Measures relative oxygen content which can influence biodegradability. 
# Usefulness: Increased oxygen content can indicate higher likelihood of biodegradability.
df['ocr'] = df['nO'] / (df['C%'] + 1e-6)
end

python
# nhdon_per_hmat
# Ratio of H-bond donor atoms (N and O) to total heavy atoms: Evaluates the availability of donor atoms for interacting with enzymes.
# Usefulness: A higher ratio suggests increased likelihood of biodegradability.
df['nhdon_per_hmat'] = df['nHDon'] / (df['nHM'] + 1e-6)
end

python
# ncrx3_sum
# Sum of non-biodegradable functional groups: Combines key non-biodegradable indicators into a single feature to improve signal.
# Usefulness: Helps capture overall contribution of functional groups that resist biodegradation.
df['ncrx3_sum'] = df['nCRX3'] + df['nArNO2'] + df['nArCOOR']
end

python
# C_subt_benz
# Adjusted aromatic carbon count: Difference of number of substituted benzene C(sp2) and number of circuits.
# Usefulness: Highlights impact of aromaticity and benzene carbons on biodegradability.
df['C_subt_benz'] = df['nCb-'] - df['nCIR']
end

python
# spmax_c
# Interaction of SpMax_L (molecular size) and carbon composition (C%).
# Usefulness: Indicates potential influence of overall molecular topology combined with carbon composition.
df['spmax_c'] = df['SpMax_L'] * (df['C%'] + 1e-6)
end

python
# o_s_reactivity
# Interaction of oxygen reactivity (SdO) with mean electronegativity (Me).
# Usefulness: Captures the potential reactivity of oxygen atoms based on electronegativity.
df['o_s_reactivity'] = df['SdO'] * df['Me']
end

python
# f03_cn_loc
# Interaction between frequency of C-N at topological distance 3 and molecular lopping centric index (LOC).
# Usefulness: Encodes importance of C-N bonds affected by overall molecule topology.
df['f03_cn_loc'] = df['F03[C-N]'] * df['LOC']
end

python
# log_no
# Log transformation of number of oxygen atoms (nO).
# Usefulness: Smooths distribution and reduces the impact of skewness for oxygen-related features.
df['log_no'] = np.log1p(df['nO'])
end

python
# sqrt_c_pct
# Square root transformation of carbon percentage (C%).
# Usefulness: Mitigates spread of outliers in carbon composition while retaining signal importance.
df['sqrt_c_pct'] = np.sqrt(df['C%'])
end

python
# sigmoid_sdssC
# Sigmoid transformation of sum of dssC E-states (SdssC).
# Usefulness: Normalizes the contribution of SdssC to accommodate diminishing returns.
df['sigmoid_sdssC'] = 1 / (1 + np.exp(-df['SdssC']))
end

python
# bin_nx
# Bin halogen atoms (nX) into categories: 0, low (1-3), and high (>3).
# Usefulness: Differentiates chemical behavior based on halogen count's influence on biodegradability.
df['bin_nx'] = pd.cut(df['nX'], bins=[-np.inf, 0, 3, np.inf], labels=['no_halogen', 'low_halogen', 'high_halogen'])
end

python
