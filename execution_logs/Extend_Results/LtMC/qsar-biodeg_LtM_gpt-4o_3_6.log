# zscore_SpMax_L
# Z-score normalization of SpMax_L for scale invariance.
# Usefulness: Normalizes SpMax_L which is a spectral index with high variance, making it comparable to other features in magnitude.
df['zscore_SpMax_L'] = (df['SpMax_L'] - df['SpMax_L'].mean()) / df['SpMax_L'].std()
end

python
# ratio_C_N
# Ratio of Carbon percentage to Nitrogen count.
# Usefulness: This indicates the balance between Carbon and Nitrogen, which might influence biodegradation, as both are crucial to molecular composition.
df['ratio_C_N'] = df['C%'] / (df['nN'] + 1e-6)  # Adding small epsilon to avoid division by zero.
end

python
# interaction_SpMax_Ti2
# Interaction term between SpMax_L and TI2_L.
# Usefulness: Combines two key spectral indices to capture potential synergistic effects on biodegradability.
df['interaction_SpMax_Ti2'] = df['SpMax_L'] * df['TI2_L']
end

python
# log_F03_CN
# Log transformation on F03[C-N].
# Usefulness: Applies log transform on highly skewed bond frequency to stabilize variance and normalize.
df['log_F03_CN'] = np.log1p(df['F03[C-N]'])
end

python
# sum_HDon_O
# Sum of hydrogen bond donors (nHDon) and oxygen atoms (nO).
# Usefulness: Aggregates H-bond donors (N, O) and directly bonded oxygen atoms, which are crucial for biodegradability.
df['sum_HDon_O'] = df['nHDon'] + df['nO']
end

python
# cross_nHDon_F03_CO
# Cross feature of H-bond donors (nHDon) and frequency of C-O bonds at distance 3 (F03[C-O]).
# Usefulness: Captures how H-bond donors interact with oxygen bond frequencies, which can indicate enhanced biodegradability.
df['cross_nHDon_F03_CO'] = df['nHDon'] * df['F03[C-O]']
end

python
# spmax_a_b_ratio
# Ratio of SpMax_B(m) to SpMax_A.
# Usefulness: Indicates the relationship between adjacency and Burden matrix properties, which might affect molecular stability.
df['spmax_a_b_ratio'] = df['SpMax_B(m)'] / (df['SpMax_A'] + 1e-6)
end

python
# ranked_HyWi
# Rank transformation for HyWi_B(m).
# Usefulness: Puts HyWi_B(m) in a relative order, useful for categorizing its importance to biodegradability.
df['ranked_HyWi'] = df['HyWi_B(m)'].rank()
end

python
# is_high_Cp
# Binary flag indicating if nCp (number of terminal primary C atoms) is greater than 2.
# Usefulness: Categorizes molecules into high and low terminal C atoms, which affects structural properties.
df['is_high_Cp'] = (df['nCp'] > 2).astype(int)
end

python
# bin_C_percent
# Binned categories for percentage of Carbon atoms (C%).
# Usefulness: Groups C% into broader categories to capture general trends in Carbon influence.
df['bin_C_percent'] = pd.cut(df['C%'], bins=[0, 20, 40, 60, 80], labels=[1, 2, 3, 4])
end

python
# rolling_mean_SM6_L
# 3-sample rolling mean of SM6_L.
# Usefulness: Captures the short-term trend in spectral moment order 6, highlighting local behavior.
df['rolling_mean_SM6_L'] = df['SM6_L'].rolling(window=3).mean()
end

python
# reciprocal_Ti2_L
# Reciprocal transformation on TI2_L.
# Usefulness: Addresses potential non-linear relationships by exploring the inverse scaling effect of TI2_L on biodegradability.
df['reciprocal_Ti2_L'] = 1 / (df['TI2_L'] + 1e-6)
end

python
# abs_Psi_i_1d
# Absolute value of Psi_i_1d.
# Usefulness: Eliminates the directional effect to explore magnitude-only impacts of pseudoconnectivity.
df['abs_Psi_i_1d'] = df['Psi_i_1d'].abs()
end

python
df.drop(columns=['nCrt'], inplace=True)
end

python
df.drop(columns=['B04[C-Br]'], inplace=True)
end

python
df.drop(columns=['N-073'], inplace=True)
end
