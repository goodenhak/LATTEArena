# ratio_SdssC_SdO
# Ratio of SdssC to SdO. Measures the relative contribution of carbon (sp2) states to oxygen states.
# Usefulness: Highlights the interaction between carbon and oxygen electronic states, aiding in understanding their joint impact on degradation.

df['ratio_SdssC_SdO'] = df['SdssC'] / (df['SdO'] + 1e-6)  # Adding small constant to avoid division by zero.
end

python
# cross_Topology_Bonds
# Interaction term between SpMax_L and F03[C-O]. Captures the relationship between structural topology and frequency of C-O bonds.
# Usefulness: Represents structural and bond frequency synergies that may influence chemical reactivity tied to biodegradability.

df['cross_Topology_Bonds'] = df['SpMax_L'] * df['F03[C-O]']
end

python
# sqrt_interaction_SpMax_Ti2
# Square root of the interaction term between SpMax_L and TI2_L to model non-linear effects more effectively.
# Usefulness: Explores complex non-linear relationships between two critical structural descriptors.

df['sqrt_interaction_SpMax_Ti2'] = (df['SpMax_L'] * df['TI2_L'])  0.5
end

python
# exp_Me
# Exponential transformation of Me (mean atomic Sanderson electronegativity).
# Usefulness: Highlights the influence of highly electronegative molecules that could strongly impact biodegradation.

df['exp_Me'] = np.exp(df['Me'])
end

python
# sum_bond_freqs
# Sum of frequency of specific bond types (C-N, C-O, N-N at various distances).
# Usefulness: Aggregates information on bond types to capture potential combined influence on reactivity and biodegradability.

df['sum_bond_freqs'] = df[['F01[N-N]', 'F02[C-N]', 'F03[C-N]', 'F03[C-O]', 'F04[C-N]']].sum(axis=1)
end

python
# combined_e_state
# Combination of SdssC and abs_Psi_i_1d as a comprehensive representation of E-state behavior.
# Usefulness: Accounts for both positive and rectified electronic state descriptors to capture their joint impact on biodegradability.

df['combined_e_state'] = df['SdssC'] + df['abs_Psi_i_1d']
end

python
# rank_SdO
# Rank transformation for SdO (Sum of dO E-states).
# Usefulness: Captures relative order and distribution effects of oxygen states, significant for bonds involving oxygen.

df['rank_SdO'] = df['SdO'].rank()
end

python
# max_val_Topology_Props
# Maximum value between SpMax_L, SM6_L, and TI2_L.
# Usefulness: Focuses on the most dominant topological property influencing the molecule's structure and reactivity.

df['max_val_Topology_Props'] = df[['SpMax_L', 'SM6_L', 'TI2_L']].max(axis=1)
end

python
# bin_interaction_HyWi_TI2_L
# Interaction term between binned categories of HyWi_B(m) rank and reciprocal_Ti2_L.
# Usefulness: Aggregates binned HyWi and transformed TI2_L rankings to detect combined effects on biodegradability.

df['bin_HyWi'] = pd.cut(df['ranked_HyWi'], bins=[0, 200, 400, 600], labels=[1, 2, 3])
df['bin_interaction_HyWi_TI2_L'] = df['bin_HyWi'].astype(float) * df['reciprocal_Ti2_L']
end

python
# higher_order_Ti2_L
# Cube transformation of TI2_L to model higher-order effects.
# Usefulness: Explores higher-order relationships of the second Mohar index and its potential impact on biodegradability.

df['higher_order_Ti2_L'] = df['TI2_L']  3
end

python
# drop_uninformative_columns
# Drop non-informative or highly overlapping columns to reduce noise and redundancy.
# Usefulness: Removes columns that are unlikely to contribute additional insights to the model.

df.drop(columns=['zscore_SpMax_L', 'ranked_HyWi', 'bin_HyWi'], inplace=True)
end
