reduces the impact of skewness for oxygen-related features.\ndf['log_no'] = np.log1p(df['nO'])", "# sqrt_c_pct\n# Square root transformation of carbon percentage (C%).\n# Usefulness: Mitigates spread of outliers in carbon composition while retaining signal importance.\ndf['sqrt_c_pct'] = np.sqrt(df['C%'])", "# sigmoid_sdssC\n# Sigmoid transformation of sum of dssC E-states (SdssC).\n# Usefulness: Normalizes the contribution of SdssC to accommodate diminishing returns.\ndf['sigmoid_sdssC'] = 1 / (1 + np.exp(-df['SdssC']))", "# bin_nx\n# Bin halogen atoms (nX) into categories: 0, low (1-3), and high (>3).\n# Usefulness: Differentiates chemical behavior based on halogen count's influence on biodegradability.\ndf['bin_nx'] = pd.cut(df['nX'], bins=[-np.inf, 0, 3, np.inf], labels=['no_halogen', 'low_halogen', 'high_halogen'])", "# rank_sm6_bm\n# Rank spectral moment of order 6 (SM6_B(m)) among rows.\n# Usefulness: Converts this variable into a ranking feature to capture its distribution better.\ndf['rank_sm6_bm'] = df['SM6_B(m)'].rank()", "# drop_redundant_features\n# Drop redundant features with low descriptive power or excessively high missing values.\ndf.drop(columns=['nCRX3', 'nArNO2', 'nArCOOR', 'F01[N-N]', 'B01[C-Br]', 'B04[C-Br]', 'B03[C-Cl]', 'nN-N', 'N-073'], inplace=True)"]
