stics (SpMax_B(m)).\n\ndf['spmax_a_b_ratio'] = df['SpMax_B(m)'] / df['SpMax_A']", "# ranked_HyWi\n# Rank transformation for HyWi_B(m).\n# Usefulness: Encodes the relative contribution of Hyper-Wiener-like index, aiding non-linear pattern recognition while mitigating outliers.\n\ndf['ranked_HyWi'] = df['HyWi_B(m)'].rank()", "# is_high_Cp\n# Binary flag indicating if nCp (number of terminal primary C atoms) is greater than 2.\n# Usefulness: Categorizes molecules based on the abundance of terminal primary C atoms, which may influence biodegradability.\n\ndf['is_high_Cp'] = (df['nCp'] > 2).astype(int)", "# bin_C_percent\n# Binned categories for percentage of Carbon atoms (C%).\n# Usefulness: Groups molecules by carbon content percentages to provide discrete categories that simplify classification tasks.\n\ndf['bin_C_percent'] = pd.cut(df['C%'], bins=[0, 30, 40, 60], labels=[1, 2, 3])", "# rolling_mean_SM6_L\n# 3-sample rolling mean of SM6_L.\n# Usefulness: Captures temporal patterns or continuous trends in spectral moments, accounting for neighborhood effects.\n\ndf['rolling_mean_SM6_L'] = df['SM6_L'].rolling(window=3, min_periods=1).mean()", "# reciprocal_Ti2_L\n# Reciprocal transformation on TI2_L.\n# Usefulness: Highlights inverse relationships in Mohar index values, useful for capturing diminishing effects.\n\ndf['reciprocal_Ti2_L'] = 1 / (df['TI2_L'] + 1e-5)", "# abs_Psi_i_1d\n# Absolute value of Psi_i_1d.\n# Usefulness: Ensures the magnitude of intrinsic state pseudoconnectivity is considered, independent of sign, for better interpretability.\n\ndf['abs_Psi_i_1d'] = np.abs(df['Psi_i_1d'])", "df.drop(columns=['XX'], inplace=True)"]
