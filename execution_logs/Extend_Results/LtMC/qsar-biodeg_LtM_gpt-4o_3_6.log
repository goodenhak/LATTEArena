# interaction_SpMax_L_Ti2
# Feature description: Interaction term between SpMax_L and TI2_L.
# Usefulness: Captures the interaction between a key Laplacian eigenvalue (SpMax_L) and molecular topology (TI2_L), likely to highlight complex dependencies related to molecular structure.
df['interaction_SpMax_L_Ti2'] = df['SpMax_L'] * df['TI2_L']
end

python
# interaction_HyWi_SM6_L
# Feature description: Product of HyWi_B(m) and SM6_L.
# Usefulness: Combines spectral (HyWi_B(m)) and structural/topological properties (SM6_L) to capture the compound’s overall propensity for biodegradability.
df['interaction_HyWi_SM6_L'] = df['HyWi_B(m)'] * df['SM6_L']
end

python
# ratio_O_N
# Feature description: Ratio of oxygen atoms (nO) to nitrogen atoms (nN).
# Usefulness: Highlights the balance between two key elements, oxygen and nitrogen, which contribute significantly to chemical reactivity and biodegradability.
df['ratio_O_N'] = df['nO'] / (df['nN'] + 1e-6)
end

python
# ratio_HDon_O
# Feature description: Ratio of hydrogen bond donors (nHDon) to oxygen atoms (nO).
# Usefulness: Emphasizes hydrogen bond interactions and their contribution relative to the availability of oxygen, which is critical for chemical degradation.
df['ratio_HDon_O'] = df['nHDon'] / (df['nO'] + 1e-6)
end

python
# sum_C_O_N
# Feature description: Sum of atomic species Carbon, Oxygen, and Nitrogen.
# Usefulness: Aggregates the primary molecular compositions likely influencing biodegradability.
df['sum_C_O_N'] = df['C%'] + df['nO'] + df['nN']
end

python
# sum_Spectral_Descriptors
# Feature description: Sum of key spectral descriptors SpMax_L, SpMax_A, SpMax_B(m), and TI2_L.
# Usefulness: Combines critical spectral metrics that are indicative of molecular topology and structure.
df['sum_Spectral_Descriptors'] = df['SpMax_L'] + df['SpMax_A'] + df['SpMax_B(m)'] + df['TI2_L']
end

python
# log_ratio_C_N
# Feature description: Logarithm of ratio_C_N.
# Usefulness: Applies a log transformation to a highly skewed feature, reducing variance and emphasizing differences.
df['log_ratio_C_N'] = np.log1p(df['ratio_C_N'])
end

python
# sqrt_SM6_L
# Feature description: Square root of SM6_L.
# Usefulness: Reduces the scale of SM6_L to better capture variance and emphasize smaller values.
df['sqrt_SM6_L'] = np.sqrt(df['SM6_L'])
end

python
# exp_SdssC
# Feature description: Exponential transformation of SdssC.
# Usefulness: Emphasizes extreme values of SdssC which may have a strong nonlinear effect on biodegradability.
df['exp_SdssC'] = np.exp(df['SdssC'])
end

python
# group_HDon_by_Cpercent
# Feature description: Average number of hydrogen bond donors (nHDon) per binned carbon percentage (bin_C_percent).
# Usefulness: Captures relationships between carbon composition and hydrogen bond donating capacity.
df['group_HDon_by_Cpercent'] = df.groupby('bin_C_percent')['nHDon'].transform('mean')
end

python
# group_interaction_SpMax_Ti2_by_Cpercent
# Feature description: Average interaction term between SpMax_L and TI2_L, grouped by carbon percentage bin (bin_C_percent).
# Usefulness: Highlights average molecular topology interactions within different carbon content groups.
df['group_interaction_SpMax_Ti2_by_Cpercent'] = df.groupby('bin_C_percent')['interaction_SpMax_Ti2'].transform('mean')
end

python
# is_low_SM6_L
# Feature description: Binary flag indicating if SM6_L is less than its first quartile value.
# Usefulness: Identifies compounds with low spectral moments from the Laplace matrix, potentially correlating with specific biodegradability patterns.
df['is_low_SM6_L'] = (df['SM6_L'] < 9.533).astype(int)
end

python
df.drop(columns=['log_F03_CN', 'rolling_mean_SM6_L', 'ranked_HyWi'], inplace=True)
end
