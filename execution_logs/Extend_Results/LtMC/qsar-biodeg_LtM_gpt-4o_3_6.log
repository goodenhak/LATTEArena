# ratio_HDon_O
# Ratio of hydrogen bond donors (nHDon) to oxygen atoms (nO), accounting for donor-acceptor interaction effectiveness.
# Usefulness: Helps capture the impact of donor-acceptor interaction ratios on biodegradability, an important aspect of molecular behavior.
df['ratio_HDon_O'] = df['nHDon'] / (df['nO'] + 1e-9)
end

python
# ratio_Cp_O
# Ratio of terminal primary carbon atoms (nCp) to oxygen atoms (nO), reflecting the balance between carbon and functional oxygen groups.
# Usefulness: Provides insights into the interaction of carbon and oxygen atoms, which are key descriptors of chemical structure.
df['ratio_Cp_O'] = df['nCp'] / (df['nO'] + 1e-9)
end

python
# ratio_N_C
# Ratio of nitrogen atoms (nN) to carbon percentage (C%), adding molecular composition information.
# Usefulness: Captures the balance between nitrogen and carbon atoms, which can affect chemical reactivity and biodegradability.
df['ratio_N_C'] = df['nN'] / (df['C%'] + 1e-9)
end

python
# log_nHM
# Log transformation of number of heavy atoms (nHM).
# Usefulness: Addresses skewness and highlights subtle variations in the number of heavy atoms influencing biodegradability.
df['log_nHM'] = np.log(df['nHM'] + 1)
end

python
# log_SdO
# Log transformation of the sum of dO E-states (SdO).
# Usefulness: Mitigates skewness and captures the impact of SdO for carbon-oxygen bond states.
df['log_SdO'] = np.log(df['SdO'] + 1)
end

python
# log_Ti2_L
# Logarithmic transformation of the Mohar index from Laplace matrix (TI2_L).
# Usefulness: Helps handle non-linearity and improves representation of the molecular connectivity index.
df['log_Ti2_L'] = np.log(df['TI2_L'] + 1e-9)
end

python
# interaction_O_LC
# Interaction of oxygen atom count (nO) and lopping centric index (LOC).
# Usefulness: Highlights relationships between oxygen composition and molecular branching patterns.
df['interaction_O_LC'] = df['nO'] * df['LOC']
end

python
# interaction_SpMax_A_HDon
# Interaction of adjacency eigenvalue (SpMax_A) and hydrogen bond donor atoms (nHDon).
# Usefulness: Identifies how molecular eigenvalues and donor atom presence jointly predict biodegradability.
df['interaction_SpMax_A_HDon'] = df['SpMax_A'] * df['nHDon']
end

python
# interaction_C_Percent_HyWi
# Interaction term of carbon percentage (C%) and hyper-Wiener index (HyWi_B(m)).
# Usefulness: Reveals how carbon composition and matrix-based indices contribute together to biodegradability.
df['interaction_C_Percent_HyWi'] = df['C%'] * df['HyWi_B(m)']
end

python
# zscore_N
# Z-score transformation of nitrogen atom count (nN).
# Usefulness: Ensures scale invariance and helps model interpretability for the nitrogen atom count.
df['zscore_N'] = (df['nN'] - df['nN'].mean()) / (df['nN'].std() + 1e-9)
end

python
# reciprocal_SM6_L
# Reciprocal of spectral moment of order 6 from Laplace matrix (SM6_L).
# Usefulness: Models inverse relationships associated with spectral moments and biodegradability.
df['reciprocal_SM6_L'] = 1 / (df['SM6_L'] + 1e-9)
end

python
df.drop(columns=['ranked_HyWi'], inplace=True)
end

python
df.drop(columns=['log_F03_CN'], inplace=True)
end
