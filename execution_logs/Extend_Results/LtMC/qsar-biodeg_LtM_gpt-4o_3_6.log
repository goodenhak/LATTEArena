# zscore_SpMax_L
# Z-score normalization of SpMax_L for scale invariance.
# Usefulness: Ensures that SpMax_L, which is a measure of molecular structure derived from the Laplace matrix, is normalized and comparable across chemicals.

df['zscore_SpMax_L'] = (df['SpMax_L'] - 4.7825) / 0.5487
end

python
# ratio_C_N
# Ratio of Carbon percentage (C%) to Nitrogen count (nN).
# Usefulness: Captures the balance between carbon content and nitrogen atoms, which can be indicative of structural composition relevance to biodegradability.

df['ratio_C_N'] = df['C%'] / (df['nN'] + 1e-5)
end

python
# interaction_SpMax_Ti2
# Interaction term between SpMax_L and TI2_L.
# Usefulness: Represents the interplay between structural molecular descriptors (SpMax_L) and the Mohar index (TI2_L), both of which are influential on molecular stability and degradability.

df['interaction_SpMax_Ti2'] = df['SpMax_L'] * df['TI2_L']
end

python
# log_F03_CN
# Log transformation on F03[C-N].
# Usefulness: Reduces skewness in the distribution of C-N topological distances, providing a smoother representation for machine learning models.

df['log_F03_CN'] = np.log1p(df['F03[C-N]'])
end

python
# sum_HDon_O
# Sum of hydrogen bond donors (nHDon) and oxygen atoms (nO).
# Usefulness: Combines hydrogen bond donors with oxygen content, capturing a holistic measure of bonding characteristics related to biodegradability.

df['sum_HDon_O'] = df['nHDon'] + df['nO']
end

python
# cross_nHDon_F03_CO
# Cross feature of H-bond donors (nHDon) and frequency of C-O bonds at topological distance 3 (F03[C-O]).
# Usefulness: Highlights the relationship between bonding potential (H-bonds) and specific C-O bond arrangements, critical for predicting chemical behavior.

df['cross_nHDon_F03_CO'] = df['nHDon'] * df['F03[C-O]']
end

python
# spmax_a_b_ratio
# Ratio of SpMax_B(m) to SpMax_A.
# Usefulness: Provides insight into the balance between molecular adjacency (SpMax_A) and mass-weighted spectral characteristics (SpMax_B(m)).

df['spmax_a_b_ratio'] = df['SpMax_B(m)'] / df['SpMax_A']
end

python
# ranked_HyWi
# Rank transformation for HyWi_B(m).
# Usefulness: Encodes the relative contribution of Hyper-Wiener-like index, aiding non-linear pattern recognition while mitigating outliers.

df['ranked_HyWi'] = df['HyWi_B(m)'].rank()
end

python
# is_high_Cp
# Binary flag indicating if nCp (number of terminal primary C atoms) is greater than 2.
# Usefulness: Categorizes molecules based on the abundance of terminal primary C atoms, which may influence biodegradability.

df['is_high_Cp'] = (df['nCp'] > 2).astype(int)
end

python
# bin_C_percent
# Binned categories for percentage of Carbon atoms (C%).
# Usefulness: Groups molecules by carbon content percentages to provide discrete categories that simplify classification tasks.

df['bin_C_percent'] = pd.cut(df['C%'], bins=[0, 30, 40, 60], labels=[1, 2, 3])
end

python
# rolling_mean_SM6_L
# 3-sample rolling mean of SM6_L.
# Usefulness: Captures temporal patterns or continuous trends in spectral moments, accounting for neighborhood effects.

df['rolling_mean_SM6_L'] = df['SM6_L'].rolling(window=3, min_periods=1).mean()
end

python
# reciprocal_Ti2_L
# Reciprocal transformation on TI2_L.
# Usefulness: Highlights inverse relationships in Mohar index values, useful for capturing diminishing effects.

df['reciprocal_Ti2_L'] = 1 / (df['TI2_L'] + 1e-5)
end

python
# abs_Psi_i_1d
# Absolute value of Psi_i_1d.
# Usefulness: Ensures the magnitude of intrinsic state pseudoconnectivity is considered, independent of sign, for better interpretability.

df['abs_Psi_i_1d'] = np.abs(df['Psi_i_1d'])
end

python
df.drop(columns=['XX'], inplace=True)
end
