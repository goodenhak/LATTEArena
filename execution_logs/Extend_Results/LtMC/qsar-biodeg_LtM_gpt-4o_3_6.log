2026-05-26 02:00:49,677 - INFO - ops_string = ["# enhanced_F04_CN\n# Log transformation of F04[C-N] for stabilizing skewed relationships with classification.\n# Usefulness: Reduces the impact of extreme values in C-N frequencies and highlights meaningful variations.\ndf['enhanced_F04_CN'] = df['F04[C-N]'].apply(lambda x: np.log1p(x))", "# carbon_nitrogen_balance\n# Ratio of Carbon percentage (C%) to total count of Nitrogen atoms (nN).\n# Usefulness: Highlights the balance between predominant atom composition and its influence on biodegradability.\ndf['carbon_nitrogen_balance'] = df['C%'] / (df['nN'] + 1e-5)", "# interaction_HyWi_Cpercent\n# Interaction term between Hyper-Wiener index (HyWi_B(m)) and percentage of C atoms (C%).\n# Usefulness: Encodes the dependency of molecular shape and carbon composition simultaneously.\ndf['interaction_HyWi_Cpercent'] = df['HyWi_B(m)'] * df['C%']", "# composite_descriptor\n# Interaction term of ranked HyWi_B(m), SpMax_A, and reciprocal_Ti2_L.\n# Usefulness: Combines molecular weight, connectivity, and spectral features into a composite measure.\ndf['composite_descriptor'] = df['ranked_HyWi'] * df['SpMax_A'] * df['reciprocal_Ti2_L']", "# mean_SdO_ratio\n# Ratio of SdO to the mean sum of SdO’s group statistics.\n# Usefulness: Highlights relative scale differences of oxygen-based E-states against population averages.\nmean_sdo = df['SdO'].mean()\ndf['mean_SdO_ratio'] = df['SdO'] / (mean_sdo + 1e-5)", "# weighted_nArNO2\n# Weighted feature combining aromatic nitro groups (nArNO2) and SpPosA_B(p).\n# Usefulness: Reflects the influence of nitro groups and electron polarizability in biodegradability.\ndf['weighted_nArNO2'] = df['nArNO2'] * df['SpPosA_B(p)']", "# exp_LOC_effect\n# Exponential transformation of Lopping Centric Index (LOC).\n# Usefulness: Amplifies pronounced variations in Lopping Centric patterns for better discrimination in biodegradability.\ndf['exp_LOC_effect'] = np.exp(df['LOC'])", "# diff_SpMax_L_TI2\n# Difference between normalized SpMax_L and TI2_L.\n# Usefulness: Captures the deviation in behavior of structure and connectivity features.\ndf['diff_SpMax_L_TI2'] = df['zscore_SpMax_L'] - df['reciprocal_Ti2_L']", "# ratio_SpMax_Me\n# Ratio of spectral maximum eigenvalue (SpMax_B(m)) and mean atomic Sanderson electronegativity (Me).\n# Usefulness: Encodes the balance of structural behavior and electronic properties.\ndf['ratio_SpMax_Me'] = df['SpMax_B(m)'] / (df['Me'] + 1e-5)", "# square_SpMax_L\n# Square transformation of SpMax_L.\n# Usefulness: Highlights amplified structural differences for molecules with higher eigenvalues.\ndf['square_SpMax_L'] = df['SpMax_L']  2", "# tanh_Psi_i_A\n# Hyperbolic tangent transformation on Psi_i_A to compress extreme variations.\n# Usefulness: Smooths variations in intrinsic state pseudoconnectivity index while preserving important differences.\ndf['tanh_Psi_i_A'] = np.tanh(df['Psi_i_A'])", "# bin_Ti2_high_low\n# Binning of TI2_L into high and low ranges based on the mean.\n# Usefulness: Simplification of data by categorizing connectivity values for rule-based models.\ndf['bin_Ti2_high_low'] = df['TI2_L'].apply(lambda x: 1 if x > df['TI2_L'].mean() else 0)", "# rolling_zscore_SM6_L\n# Rolling mean z-scored transformation of SM6_L over window size of 3.\n# Usefulness: Combines trend detection with scale normalization to smooth local fluctuations.\ndf['rolling_zscore_SM6_L'] = df['rolling_mean_SM6_L'] - df['rolling_mean_SM6_L'].mean()", "df.drop(columns=['nCIR', 'LOC', 'B01[C-Br]', 'B03[C-Cl]', 'nHM', 'NssssC'], inplace=True)"]
