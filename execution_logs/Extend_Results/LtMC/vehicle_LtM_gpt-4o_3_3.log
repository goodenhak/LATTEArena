ABOUT_MINOR_AXIS'])", "# LOG_RADIUS_RATIO\n# Log-transformation of RADIUS_RATIO to reduce skew and enhance linear separability.\n# Usefulness: Scales down large ratios for elongation trends with better interpretability in models.\n\ndf['LOG_RADIUS_RATIO'] = np.log(df['RADIUS_RATIO'])", "# ZSCORE_MAJOR_VARIANCE\n# Z-score normalization of SCALED_VARIANCE_ALONG_MAJOR_AXIS for comparative scale standardization.\n# Usefulness: Standardizes major axis distribution characteristics for relative comparison across silhouette features.\n\ndf['ZSCORE_MAJOR_VARIANCE'] = (df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'].mean()) / df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'].std()", "# PR_AXIS_ASPECT_RATIO_DIFF\n# Difference between PR.AXIS_ASPECT_RATIO and MAX.LENGTH_ASPECT_RATIO, measuring imbalance across axes.\n# Usefulness: Highlights axis ratios misalignment, crucial for identifying symmetry differences among vehicle classes.\n\ndf['PR_AXIS_ASPECT_RATIO_DIFF'] = df['PR.AXIS_ASPECT_RATIO'] - df['MAX.LENGTH_ASPECT_RATIO']", "# RECIPROCAL_RADIUS_RATIO\n# Reciprocal transformation of RADIUS_RATIO to highlight inverse elongation trends.\n# Usefulness: Provides a unique perspective on extreme elongation trends for better separation between vehicle types.\n\ndf['RECIPROCAL_RADIUS_RATIO'] = 1 / df['RADIUS_RATIO']", "# DROP_HOLLOWS_RATIO\n# HOLLOWS_RATIO is dropped after using it in derived features as it has redundant information.\ndf.drop(columns=['HOLLOWS_RATIO'], inplace=True)"]
