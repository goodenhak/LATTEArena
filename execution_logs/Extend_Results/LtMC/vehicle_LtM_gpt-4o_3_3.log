# COMPACTNESS_CIRCULARITY_RATIO
# COMPACTNESS / CIRCULARITY
# Usefulness: Measures compactness relative to circularity, highlighting structural differences in vehicle shapes.
df['COMPACTNESS_CIRCULARITY_RATIO'] = df['COMPACTNESS'] / df['CIRCULARITY']
end

python
# SCATTER_RADIUS_RATIO
# SCATTER_RATIO / RADIUS_RATIO
# Usefulness: Captures asymmetry relative to radius variability, useful for identifying irregular shapes.
