# Usefulness: Converts continuous kurtosis values into discrete ranges to detect variability patterns unique to each vehicle class.

df['kurtosis_bin'] = pd.cut(df['KURTOSIS_ABOUT_MINOR_AXIS'], bins=4, labels=False)
end

python
