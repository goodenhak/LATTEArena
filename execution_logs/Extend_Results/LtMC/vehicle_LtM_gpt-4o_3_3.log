# COMPACTNESS_ZSCORE
# Z-score normalization of COMPACTNESS.
# Usefulness: Normalized compactness helps eliminate scale differences and highlights relative deviations for each silhouette.

df['COMPACTNESS_ZSCORE'] = (df['COMPACTNESS'] - df['COMPACTNESS'].mean()) / df['COMPACTNESS'].std()
end

python
# CIRCULARITY_ZSCORE
# Z-score normalization of CIRCULARITY.
# Usefulness: Normalized circularity emphasizes deviations reflecting roundness impact across different vehicle types.

df['CIRCULARITY_ZSCORE'] = (df['CIRCULARITY'] - df['CIRCULARITY'].mean()) / df['CIRCULARITY'].std()
end

python
# RADIUS_RATIO_LOG
# Log transformation of RADIUS_RATIO.
# Usefulness: Log scaling reduces dynamic range, capturing differences in radial asymmetry more effectively.

df['RADIUS_RATIO_LOG'] = np.log(df['RADIUS_RATIO'])
end

python
# SCATTER_ELONGATEDNESS_RATIO
# Ratio between SCATTER_RATIO and ELONGATEDNESS.
# Usefulness: Highlights the relationship between inertia distribution and area elongation, enhancing insights about shape details.

df['SCATTER_ELONGATEDNESS_RATIO'] = df['SCATTER_RATIO'] / df['ELONGATEDNESS']
end

python
# AXIS_ASPECT_RATIO_DIFFERENCE
# Difference between PR.AXIS_ASPECT_RATIO and MAX.LENGTH_ASPECT_RATIO.
# Usefulness: Captures perspective-induced skewness between axis definitions, valuable for angle invariance.

df['AXIS_ASPECT_RATIO_DIFFERENCE'] = df['PR.AXIS_ASPECT_RATIO'] - df['MAX.LENGTH_ASPECT_RATIO']
