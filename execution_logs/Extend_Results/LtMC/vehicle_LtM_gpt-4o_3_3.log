# compactness_circularity_ratio
# Ratio of COMPACTNESS to CIRCULARITY, capturing proportional relationships between perimeter-derived and radius-derived metrics.
# Usefulness: Helps differentiate the general shape descriptors of the silhouette across vehicle types.

df['compactness_circularity_ratio'] = df['COMPACTNESS'] / df['CIRCULARITY']
end

python
# radius_aspect_product
# Product of RADIUS_RATIO and PR.AXIS_ASPECT_RATIO, capturing compound effects of radial variability and axis proportions.
# Usefulness: Highlights geometric interactions that may be distinctive to specific vehicle types.

df['radius_aspect_product'] = df['RADIUS_RATIO'] * df['PR.AXIS_ASPECT_RATIO']
end

python
# scaled_variance_difference
# Difference between SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCALED_VARIANCE_ALONG_MINOR_AXIS.
# Usefulness: Measures variability differences along major and minor axes, useful for characterizing vehicle symmetry.

df['scaled_variance_difference'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# log_hollows_ratio
# Log transformation of HOLLOWS_RATIO.
# Usefulness: Captures subtleties in hollow proportions which could be important for classifying shapes.

df['log_hollows_ratio'] = np.log(df['HOLLOWS_RATIO'])
end

python
# scatter_elongated_ratio
# Ratio of SCATTER_RATIO to ELONGATEDNESS.
# Usefulness: Provides insight into the relationship between scatter distribution and elongation, distinguishing between compact and stretched forms.

df['scatter_elongated_ratio'] = df['SCATTER_RATIO'] / df['ELONGATEDNESS']
end

python
# scaled_radius_zscore
# Z-score transformation of SCALED_RADIUS_OF_GYRATION.
# Usefulness: Normalizes gyration metrics to capture deviations from the average, making it easier to compare across vehicles.

