# COMPACTNESS_log
# Log transformation of COMPACTNESS to reduce skewness and emphasize proportional changes in silhouette compactness.
# Usefulness: Enhances differentiation of vehicle silhouettes with varying compactness levels.
df['COMPACTNESS_log'] = np.log(df['COMPACTNESS'])
end

python
# CIRCULARITY_zscore
# Z-score standardization of CIRCULARITY to normalize and emphasize outliers in shape circularity.
# Usefulness: Helps uncover shapes with unique circularity that correlate with specific vehicle types.
df['CIRCULARITY_zscore'] = (df['CIRCULARITY'] - df['CIRCULARITY'].mean()) / df['CIRCULARITY'].std()
end

python
# COMPACTNESS_CIRCULARITY_ratio
# Ratio of COMPACTNESS to CIRCULARITY to capture geometric interplay between compactness and circularity.
# Usefulness: Highlights distinct shape characteristics linked to vehicle type classification.
df['COMPACTNESS_CIRCULARITY_ratio'] = df['COMPACTNESS'] / df['CIRCULARITY']
end

python
# PR.AXIS_ASPECT_RATIO_minus_SCATTER_RATIO
# Difference between PR.AXIS_ASPECT_RATIO and SCATTER_RATIO to measure relationships in axis geometry.
# Usefulness: Identifies the variance in axis-based geometry between vehicle silhouettes.
df['PR.AXIS_ASPECT_RATIO_minus_SCATTER_RATIO'] = df['PR.AXIS_ASPECT_RATIO'] - df['SCATTER_RATIO']
end

python
# RADIUS_RATIO_normalized
# Min-max scaling of RADIUS_RATIO to normalize its range and ensure uniform treatment of range disparities.
# Usefulness: Improves interpretability and importance of radius variation across vehicle types.
df['RADIUS_RATIO_normalized'] = (df['RADIUS_RATIO'] - df['RADIUS_RATIO'].min()) / (df['RADIUS_RATIO'].max() - df['RADIUS_RATIO'].min())
end

python
# MAX.LENGTH_ASPECT_RATIO_rolling_mean
# Rolling mean over MAX.LENGTH_ASPECT_RATIO to smooth noisy fluctuations (window=3).
# Usefulness: Reduces noise and captures broader trends in length aspect ratio variability.
df['MAX.LENGTH_ASPECT_RATIO_rolling_mean'] = df['MAX.LENGTH_ASPECT_RATIO'].rolling(window=3, center=False).mean()
end

python
# SCALED_VARIANCE_ratio
# Ratio of SCALED_VARIANCE_ALONG_MAJOR_AXIS to SCALED_VARIANCE_ALONG_MINOR_AXIS.
# Usefulness: Highlights major-to-minor axis variance distribution, amplifying distinct silhouette characteristics.
df['SCALED_VARIANCE_ratio'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] / df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# SKEWNESS_KURTOSIS_interaction
# Interaction of SKEWNESS_ABOUT_MAJOR_AXIS and KURTOSIS_ABOUT_MAJOR_AXIS through multiplication.
# Usefulness: Captures higher-order distribution characteristics potentially discriminative for vehicle types.
df['SKEWNESS_KURTOSIS_interaction'] = df['SKEWNESS_ABOUT_MAJOR_AXIS'] * df['KURTOSIS_ABOUT_MAJOR_AXIS']
end

python
# SCALED_RADIUS_diff
# Difference between SCALED_RADIUS_OF_GYRATION and ELONGATEDNESS.
# Usefulness: Measures comparative spread and elongation of the silhouette's bulk, aiding differentiation.
df['SCALED_RADIUS_diff'] = df['SCALED_RADIUS_OF_GYRATION'] - df['ELONGATEDNESS']
end

python
# HOLLOWS_RATIO_bin
# Categorizing HOLLOWS_RATIO into bins to group silhouettes with similar hollow characteristics.
# Usefulness: Helps identify specific vehicle hull configurations linked to vehicle types.
df['HOLLOWS_RATIO_bin'] = pd.cut(df['HOLLOWS_RATIO'], bins=[180, 190, 200, 210], labels=['Low', 'Medium', 'High'])
end

python
df.drop(columns=['PR.AXIS_RECTANGULARITY', 'MAX.LENGTH_RECTANGULARITY', 'KURTOSIS_ABOUT_MINOR_AXIS'], inplace=True)
end
