# COMPACTNESS_CIRCULARITY_RATIO
# The ratio of COMPACTNESS to CIRCULARITY, combining shape complexity metrics to highlight relative perimeter and radius characteristics.
# Usefulness: Separates vehicles based on perimeter-to-radius-derived compactness, crucial for analyzing silhouette complexity.

df['COMPACTNESS_CIRCULARITY_RATIO'] = df['COMPACTNESS'] / df['CIRCULARITY']
end

python
# ELONGATEDNESS_SCATTER_PRODUCT
# Product of ELONGATEDNESS and SCATTER_RATIO, combining shape elongation and internal distribution characteristics.
# Usefulness: Captures intricate relationships between elongation and symmetry distribution for distinguishing vehicles with elongated shapes.

df['ELONGATEDNESS_SCATTER_PRODUCT'] = df['ELONGATEDNESS'] * df['SCATTER_RATIO']
end

python
# VARIANCE_ELONGATION_RATIO
# Sum of SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCALED_VARIANCE_ALONG_MINOR_AXIS divided by ELONGATEDNESS.
# Usefulness: Highlights how distributional spread relates to general elongation for distinguishing distributions in different vehicle types.

df['VARIANCE_ELONGATION_RATIO'] = (df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] + df['SCALED_VARIANCE_ALONG_MINOR_AXIS']) / df['ELONGATEDNESS']
end

python
# HOLLOWS_ADJUSTED_COMPACTNESS
# Ratio of COMPACTNESS to HOLLOWS_RATIO, adjusting compactness metrics to account for hollow areas in silhouettes.
# Usefulness: Captures the compactness after accounting for void spaces, which helps identify hollow-intensive vehicle types.

df['HOLLOWS_ADJUSTED_COMPACTNESS'] = df['COMPACTNESS'] / df['HOLLOWS_RATIO']
end

python
# SKEW_KURT_DIFF
# Difference between KURTOSIS_ABOUT_MAJOR_AXIS and KURTOSIS_ABOUT_MINOR_AXIS, paired with skewness differences for symmetry measurement.
# Usefulness: Provides higher-order imbalance across axes to highlight silhouette asymmetries in complex shapes.

df['SKEW_KURT_DIFF'] = (df['KURTOSIS_ABOUT_MAJOR_AXIS'] - df['KURTOSIS_ABOUT_MINOR_AXIS']) * (df['SKEWNESS_ABOUT_MAJOR_AXIS'] - df['SKEWNESS_ABOUT_MINOR_AXIS'])
end

python
# LOG_RADIUS_RATIO
# Log-transformation of RADIUS_RATIO to reduce skew and enhance linear separability.
# Usefulness: Scales down large ratios for elongation trends with better interpretability in models.

df['LOG_RADIUS_RATIO'] = np.log(df['RADIUS_RATIO'])
end

python
# ZSCORE_MAJOR_VARIANCE
# Z-score normalization of SCALED_VARIANCE_ALONG_MAJOR_AXIS for comparative scale standardization.
# Usefulness: Standardizes major axis distribution characteristics for relative comparison across silhouette features.

df['ZSCORE_MAJOR_VARIANCE'] = (df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'].mean()) / df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'].std()
end

python
# PR_AXIS_ASPECT_RATIO_DIFF
# Difference between PR.AXIS_ASPECT_RATIO and MAX.LENGTH_ASPECT_RATIO, measuring imbalance across axes.
# Usefulness: Highlights axis ratios misalignment, crucial for identifying symmetry differences among vehicle classes.

df['PR_AXIS_ASPECT_RATIO_DIFF'] = df['PR.AXIS_ASPECT_RATIO'] - df['MAX.LENGTH_ASPECT_RATIO']
end

python
# RECIPROCAL_RADIUS_RATIO
# Reciprocal transformation of RADIUS_RATIO to highlight inverse elongation trends.
# Usefulness: Provides a unique perspective on extreme elongation trends for better separation between vehicle types.

df['RECIPROCAL_RADIUS_RATIO'] = 1 / df['RADIUS_RATIO']
end

