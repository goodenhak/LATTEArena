# COMPACTNESS_CIRCULARITY_RATIO
# Ratio of COMPACTNESS to CIRCULARITY, capturing contour and circularity patterns.
# Usefulness: Distinguishes between compact and circular silhouettes, highlighting differences in shape.

df['COMPACTNESS_CIRCULARITY_RATIO'] = df['COMPACTNESS'] / df['CIRCULARITY']
end

python
# HOLLOWS_ELONGATEDNESS_RATIO
# Ratio of HOLLOWS_RATIO to ELONGATEDNESS, indicating the proportion of hollow spaces relative to spread.
# Usefulness: Helps segment vehicles with larger hollows (e.g., vans or buses) from compact vehicles (e.g., Opel, Saab).

df['HOLLOWS_ELONGATEDNESS_RATIO'] = df['HOLLOWS_RATIO'] / df['ELONGATEDNESS']
end

python
# VARIANCE_AXIS_DIFFERENCE
# Difference between SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCALED_VARIANCE_ALONG_MINOR_AXIS, emphasizing asymmetry in spread.
