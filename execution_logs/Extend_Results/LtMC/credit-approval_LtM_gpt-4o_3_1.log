2026-05-26 00:40:34,130 - INFO - ops_string = ["# Debt_to_Income\n# Ratio of Debt to Income to highlight financial balance.\n# Usefulness: Captures financial health by comparing obligations to earning capacity.\ndf['Debt_to_Income'] = df['Debt'] / (df['Income'] + 1)  # Adding 1 to avoid division by zero", "# CreditScore_to_Income\n# Ratio of CreditScore to Income to normalize creditworthiness with respect to income.\n# Usefulness: Demonstrates whether individuals with higher credit scores have proportionally commensurate income levels.\ndf['CreditScore_to_Income'] = df['CreditScore'] / (df['Income'] + 1)", "# Debt_to_Sqrt_Income\n# Ratio of Debt to square root of Income to reduce the effect of extreme income values.\n# Usefulness: Normalizes the effect of high Income on Debt to better highlight financial obligations.\ndf['Debt_to_Sqrt_Income'] = df['Debt'] / (np.sqrt(df['Income'] + 1))", "# Log_Income\n# Natural log transformation of Income to reduce skewness in the income distribution.\n# Usefulness: Highlights proportional income differences while addressing extreme values often found in income attributes.\ndf['Log_Income'] = np.where(df['Income'] > 0, np.log(df['Income']), -11.512925464970229)  # Replace log(0) with minimum value", "# Log_Debt\n# Natural log transformation of Debt to reduce skewness in the debt distribution.\n# Usefulness: Makes Debt-related attributes more linear and interpretable for predictive modeling.\ndf['Log_Debt'] = np.where(df['Debt'] > 0, np.log(df['Debt']), 0)", "# Married_BankCustomer_Employed_Sum\n# Sum of Married, BankCustomer, and Employed categorical variables.\n# Usefulness: Represents aggregated lifestyle stability factors relevant for credit approval decisions.\ndf['Married_BankCustomer_Employed_Sum'] = df['Married'] + df['BankCustomer'] + df['Employed']", "# PriorDefault_and_Employed\n# Interaction between PriorDefault and Employed.\n# Usefulness: Explores how having previous defaults coupled with current employment status impacts credit eligibility.\ndf['PriorDefault_and_Employed'] = df['PriorDefault'] * df['Employed']", "# PriorDefault_CreditScore_Interaction\n# Interaction feature combining PriorDefault and CreditScore.\n# Usefulness: Captures how a prior history of default modifies the impact of credit score on creditworthiness.\ndf['PriorDefault_CreditScore_Interaction'] = df['PriorDefault'] * df['CreditScore']", "# Married_BankCustomer_Employed_Sum_to_Debt_Income\n# Product of Married_BankCustomer_Employed_Sum and Debt_to_Income.\n# Usefulness: Encodes lifestyle stability factors coupled with financial health to improve modeling depth.\ndf['Married_BankCustomer_Employed_Sum_to_Debt_Income'] = df['Married_BankCustomer_Employed_Sum'] * (df['Debt'] / (df['Income'] + 1))", "# Sqrt_Debt\n# Square root transformation of Debt to reduce skewness in distribution.\n# Usefulness: Provides a stabilized version of Debt, emphasizing smaller valued differences more significantly.\ndf['Sqrt_Debt'] = np.sqrt(df['Debt'])", "# Sqrt_CreditScore_to_Income\n# Square root transformation of CreditScore_to_Income ratio.\n# Usefulness: Reduces the volatility of the CreditScore/Income ratio and highlights lower values more distinctly.\ndf['Sqrt_CreditScore_to_Income'] = np.sqrt(df['CreditScore_to_Income'])", "# Zscore_YearsEmployed\n# Z-score normalization of YearsEmployed to standardize values.\n# Usefulness: Removes scale effects and provides comparisons of YearsEmployed relative to the population mean.\ndf['Zscore_YearsEmployed'] = (df['YearsEmployed'] - df['YearsEmployed'].mean()) / df['YearsEmployed'].std()", "# Industry_CreditScore_Mean\n# Mean CreditScore grouped by Industry.\n# Usefulness: Allows understanding of average creditworthiness within a specific industry for comparison.\ndf['Industry_CreditScore_Mean'] = df.groupby('Industry')['CreditScore'].transform('mean')", "# Ethnicity_Income_Median\n# Median Income grouped by Ethnicity.\n# Usefulness: Highlights socioeconomic disparities and relative earning capacity across ethnic groups.\ndf['Ethnicity_Income_Median'] = df.groupby('Ethnicity')['Income'].transform('median')", "df.drop(columns=['Citizen_Status_Sum'], inplace=True)"]
