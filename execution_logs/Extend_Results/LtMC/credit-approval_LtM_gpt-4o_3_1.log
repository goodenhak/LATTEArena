# Log_Income
# Natural log transformation of Income to reduce skewness and stabilize variance for better predictive modeling.
# Usefulness: Highlights the effect of income on credit card success while managing outlier effects.
df['Log_Income'] = df['Income'].apply(lambda x: np.log(x + 1) if x > 0 else -11.512925464970229)
end

python
# Log_Debt
# Natural log transformation of Debt to normalize and reduce highly skewed debt distributions.
# Usefulness: Captures the diminishing adverse impact of smaller debts compared to higher debts.
df['Log_Debt'] = df['Debt'].apply(lambda x: np.log(x + 1) if x > 0 else 0)
end

python
# Debt_to_CreditScore
# Ratio of Debt to CreditScore, normalized for very low credit scores.
# Usefulness: Reflects potential financial constraints relative to creditworthiness, critical for approval decisions.
df['Debt_to_CreditScore'] = df.apply(lambda row: row['Debt'] / (row['CreditScore'] + 1e-5), axis=1)
end

python
# Debt_to_Sqrt_Income
# Ratio of Debt to the square root of Income to normalize the effect of high income values.
# Usefulness: Balances high income effects to better understand debt burdens across income ranges.
df['Debt_to_Sqrt_Income'] = df.apply(lambda row: row['Debt'] / np.sqrt(row['Income'] + 1) if row['Income'] > 0 else 0, axis=1)
end

python
# Married_BankCustomer_Employed_Sum
# Aggregates lifestyle variables (married, bank account holder, employed) into a composite score.
# Usefulness: Highlights overall stability through a combination of indicators.
df['Married_BankCustomer_Employed_Sum'] = df[['Married', 'BankCustomer', 'Employed']].sum(axis=1)
end

python
# PriorDefault_CreditScore_Interaction
# Interaction between PriorDefault and CreditScore.
# Usefulness: Captures how past defaults weigh differently based on creditworthiness.
df['PriorDefault_CreditScore_Interaction'] = df['PriorDefault'] * df['CreditScore']
end

python
# Industry_CreditScore_Mean
# Mean CreditScore grouped by industry.
# Usefulness: Provides sector-level insight into the typical creditworthiness of applicants.
df['Industry_CreditScore_Mean'] = df.groupby('Industry')['CreditScore'].transform('mean')
end

python
# Ethnicity_Income_Median
# Median Income grouped by Ethnicity.
# Usefulness: Captures socioeconomic trends and disparities among different ethnic groups.
df['Ethnicity_Income_Median'] = df.groupby('Ethnicity')['Income'].transform('median')
end

python
# Sqrt_Debt
# Square root transformation of the Debt feature.
# Usefulness: Normalizes the effects of high debt values, improving model stability.
df['Sqrt_Debt'] = df['Debt'].apply(lambda x: np.sqrt(x))
end

python
# Sqrt_CreditScore_to_Income
# Square root transformation of CreditScore to Income ratio.
# Usefulness: Balances extreme ratio values, enhancing relationships between creditworthiness and income.
df['Sqrt_CreditScore_to_Income'] = df.apply(lambda row: np.sqrt((row['CreditScore'] + 1e-5) / (row['Income'] + 1)), axis=1)
end

python
# Zscore_YearsEmployed
# Z-score normalization of YearsEmployed.
# Usefulness: Standardizes the feature to highlight relative employment history across applicants.
df['Zscore_YearsEmployed'] = (df['YearsEmployed'] - df['YearsEmployed'].mean()) / df['YearsEmployed'].std()
end

python
# Group_Age_Median
# Median Age within Ethnicity subgroups.
# Usefulness: Captures age patterns and deviations within demographic groups, helping identify outliers.
df['Group_Age_Median'] = df.groupby('Ethnicity')['Age'].transform('median')
end

python
df.drop(columns=['Citizen_Status_Sum'], inplace=True)
end

python
df.drop(columns=['Married_BankCustomer_Employed_Sum_to_Debt_Income'], inplace=True)
end

python
df.drop(columns=['Debt'], inplace=True)
end
