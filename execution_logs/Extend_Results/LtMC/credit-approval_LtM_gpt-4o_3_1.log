# Debt_to_Income
# Ratio of Debt to Income.
# Usefulness: Captures the proportion of income that is allocated to existing debt, a critical indicator of financial stability.
df['Debt_to_Income'] = df['Debt'] / (df['Income'] + 1e-5)
end

python
# CreditScore_to_Income
# Ratio of CreditScore to Income.
# Usefulness: Highlights creditworthiness relative to income, emphasizing the individual's capacity to repay loans.
df['CreditScore_to_Income'] = df['CreditScore'] / (df['Income'] + 1e-5)
end

python
# Married_BankCustomer_Employed_Sum
# Sum of Married, BankCustomer, and Employed.
# Usefulness: Aggregates key binary indicators of stability into one feature, capturing cumulative financial and life stability factors.
df['Married_BankCustomer_Employed_Sum'] = df['Married'] + df['BankCustomer'] + df['Employed']
end

python
# PriorDefault_and_Employed
# Interaction between PriorDefault and Employed.
# Usefulness: Combines a risk indicator (PriorDefault) with employment status, helping capture contrasting dynamics of risk mitigation.
df['PriorDefault_and_Employed'] = df['PriorDefault'] * df['Employed']
end

python
# Log_Income
# Natural log transformation of Income.
# Usefulness: Reduces the impact of skewed income distribution, allowing models to better interpret income without dominance.
df['Log_Income'] = np.log(df['Income'] + 1e-5)
end

python
# Sqrt_Debt
# Square root transformation of Debt.
# Usefulness: Reduces the effect of extreme debt values, normalizing skewness to enhance model learning capabilities.
df['Sqrt_Debt'] = np.sqrt(df['Debt'])
end

python
# Married_x_Ethnicity
# Cross feature of Married and Ethnicity.
# Usefulness: Captures socioeconomic patterns intersecting marital status and ethnicity for tailored credit behavior analysis.
df['Married_x_Ethnicity'] = df['Married'].astype(str) + _ + df['Ethnicity']
end

python
# Industry_Target_Encoding
# Mean target encoding for Industry based on credit card approval rates.
# Usefulness: Embeds historical performance of different job sectors into the feature to help models infer sectoral risk profiles.
industry_mean = df.groupby('Industry')['Target'].mean()  # Assuming 'Target' is the outcome variable
df['Industry_Target_Encoding'] = df['Industry'].map(industry_mean)
end

python
# Group_Age_Median
# Median for Age within Ethnicity groups.
# Usefulness: Captures age-related trends in different ethnic groups for credit card approval patterns.
df['Group_Age_Median'] = df.groupby('Ethnicity')['Age'].transform('median')
end

python
# Zscore_YearsEmployed
# Z-score normalization of YearsEmployed.
# Usefulness: Standardizes years of employment, making it comparable across varying scales and distributions.
df['Zscore_YearsEmployed'] = (df['YearsEmployed'] - df['YearsEmployed'].mean()) / df['YearsEmployed'].std()
end

python
# Citizen_OneHot
# One-hot encoding for Citizen feature.
# Usefulness: Splits the Citizen categories into individual binary columns, ensuring categorical values are usable in models.
df = pd.get_dummies(df, columns=['Citizen'], prefix='Citizen')
end

python
# Dropping ZipCode
df.drop(columns=['ZipCode'], inplace=True)
end

python
# Dropping DriversLicense
df.drop(columns=['DriversLicense'], inplace=True)
end
