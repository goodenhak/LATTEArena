# Debt_to_Income
# Debt-to-Income Ratio = Debt / (Income + 1)
# Usefulness: Directly captures financial burden relative to income, a critical indicator of creditworthiness.
df['Debt_to_Income'] = df['Debt'] / (df['Income'] + 1)
end

python
# Log_Income
# Logarithmic transformation of Income = log(Income + 1)
# Usefulness: Helps manage skewness in income distribution and highlights incremental changes in income at lower ranges.
df['Log_Income'] = np.log(df['Income'] + 1)
end

python
# Log_Debt
# Logarithmic transformation of Debt = log(Debt + 1)
# Usefulness: Handles skewness in debt distribution, emphasizing smaller-scale differences.
df['Log_Debt'] = np.log(df['Debt'] + 1)
end

python
# CreditScore_ZScore
# Z-Score normalization of CreditScore = (CreditScore - mean(CreditScore)) / std(CreditScore)
# Usefulness: Standardizes CreditScore to highlight relative creditworthiness compared to the population.
df['CreditScore_ZScore'] = (df['CreditScore'] - df['CreditScore'].mean()) / df['CreditScore'].std()
end

python
# Married_x_Income
# Interaction term = Married × Income
# Usefulness: Captures whether being married correlates with higher financial capacity, which can influence approval likelihood.
df['Married_x_Income'] = df['Married'] * df['Income']
end

python
# Married_x_Debt
# Interaction term = Married × Debt
# Usefulness: Assesses if being married correlates with higher or lower debt burdens, impacting financial stability.
df['Married_x_Debt'] = df['Married'] * df['Debt']
end

python
# YearsEmployed_to_Age
# Ratio of YearsEmployed to Age = YearsEmployed / (Age + 0.1)
# Usefulness: Indicates career progression proportional to the individual’s age, useful for evaluating stability.
df['YearsEmployed_to_Age'] = df['YearsEmployed'] / (df['Age'] + 0.1)
end

python
# Employed_x_Income
# Interaction term = Employed × Income
# Usefulness: Highlights income levels for currently employed individuals, important for predicting repayment ability.
df['Employed_x_Income'] = df['Employed'] * df['Income']
end

python
# Industry_Citizen_Cross
# Cross feature combining Industry and Citizen = Industry × Citizen (categorical cross)
# Usefulness: Explores the interaction between job sector and citizenship, capturing systemic eligibility patterns.
df['Industry_Citizen_Cross'] = df['Industry'].astype(str) + _ + df['Citizen'].astype(str)
end

python
# Citizen_Label_Encoded
# Label encoding for Citizen feature
# Usefulness: Converts categorical citizenship status into numerical form for predictive models.
df['Citizen_Label_Encoded'] = df['Citizen'].astype('category').cat.codes
end

python
# Age_Binned
# Binned Age feature = bin(Age, bins=[0, 20, 30, 40, 50, 60, 80], labels=['Teen', '20s', '30s', '40s', '50s', '60+'])
# Usefulness: Groups individuals into age brackets that may reflect different credit-seeking behaviors and risk profiles.
df['Age_Binned'] = pd.cut(df['Age'], bins=[0, 20, 30, 40, 50, 60, 80], labels=['Teen', '20s', '30s', '40s', '50s', '60+'])
end

python
# Groupby_IncomeMean_ByCitizenship
# Grouped mean Income by Citizen category = groupbythenmean(Citizen, Income)
# Usefulness: Highlights average income patterns among citizenship types, showing systemic income differences.
citizen_income_mean = df.groupby('Citizen')['Income'].mean()
df['Groupby_IncomeMean_ByCitizenship'] = df['Citizen'].map(citizen_income_mean)
end

python
# PriorDefault_Negate
# Negation transformation = negate(PriorDefault)
# Usefulness: Inverts the prior default flag, creating a complementary view for models.
df['PriorDefault_Negate'] = 1 - df['PriorDefault']
end

python
# Drop Uninformative Columns
df.drop(columns=['ZipCode'], inplace=True)
end
