# Feature name: Debt_to_Income
# Feature description: Ratio of Debt to Income to assess financial pressure.
# Usefulness: Provides insight into a person's debt relative to their income, which is a strong indicator of financial stability.
df['Debt_to_Income'] = df['Debt'] / (df['Income'] + 1e-5)
