'] = df['Employed'] * df['Income']", "# Industry_Citizen_Cross\n# Cross feature combining Industry and Citizen = Industry × Citizen (categorical cross)\n# Usefulness: Explores the interaction between job sector and citizenship, capturing systemic eligibility patterns.\ndf['Industry_Citizen_Cross'] = df['Industry'].astype(str) + _ + df['Citizen'].astype(str)", "# Citizen_Label_Encoded\n# Label encoding for Citizen feature\n# Usefulness: Converts categorical citizenship status into numerical form for predictive models.\ndf['Citizen_Label_Encoded'] = df['Citizen'].astype('category').cat.codes", "# Age_Binned\n# Binned Age feature = bin(Age, bins=[0, 20, 30, 40, 50, 60, 80], labels=['Teen', '20s', '30s', '40s', '50s', '60+'])\n# Usefulness: Groups individuals into age brackets that may reflect different credit-seeking behaviors and risk profiles.\ndf['Age_Binned'] = pd.cut(df['Age'], bins=[0, 20, 30, 40, 50, 60, 80], labels=['Teen', '20s', '30s', '40s', '50s', '60+'])", "# Groupby_IncomeMean_ByCitizenship\n# Grouped mean Income by Citizen category = groupbythenmean(Citizen, Income)\n# Usefulness: Highlights average income patterns among citizenship types, showing systemic income differences.\ncitizen_income_mean = df.groupby('Citizen')['Income'].mean()\ndf['Groupby_IncomeMean_ByCitizenship'] = df['Citizen'].map(citizen_income_mean)", "# PriorDefault_Negate\n# Negation transformation = negate(PriorDefault)\n# Usefulness: Inverts the prior default flag, creating a complementary view for models.\ndf['PriorDefault_Negate'] = 1 - df['PriorDefault']", "# Drop Uninformative Columns\ndf.drop(columns=['ZipCode'], inplace=True)"]
