# Debt_to_Income
# Ratio of Debt to Income to understand financial burden relative to earnings.
# Usefulness: Helps capture financial stability by linking two key financial features, highlighting individuals overspending relative to their income.
df['Debt_to_Income'] = df['Debt'] / (df['Income'] + 1e-6)
end

python
# Married_BankCustomer_Employed_Sum_Normalized
# Min-max normalization of Married_BankCustomer_Employed_Sum.
# Usefulness: Normalizes lifestyle score to bring it to a comparable scale with other features, aiding interpretability and prediction.
df['Married_BankCustomer_Employed_Sum_Normalized'] = (df['Married_BankCustomer_Employed_Sum'] - df['Married_BankCustomer_Employed_Sum'].min()) / (df['Married_BankCustomer_Employed_Sum'].max() - df['Married_BankCustomer_Employed_Sum'].min())
end

python
# Employed_and_HighIncome
# Interaction term for Employed and high Income thresholds (Income > median).
# Usefulness: Captures the synergy between having both stable employment and higher-than-typical income, which may indicate financial stability.
df['Employed_and_HighIncome'] = df['Employed'] * (df['Income'] > df['Income'].median())
end

python
# Age_CreditScore_Ratio
# Ratio of Age to CreditScore.
# Usefulness: Highlights whether older individuals have proportionally reasonable credit scores compared to younger counterparts.
df['Age_CreditScore_Ratio'] = df['Age'] / (df['CreditScore'] + 1e-6)
end

python
# Debt_YearsEmployed_Interaction
# Interaction of Debt and YearsEmployed.
# Usefulness: Captures the relationship between outstanding debt and employment stability, as longer employment could correlate with better debt management.
df['Debt_YearsEmployed_Interaction'] = df['Debt'] * df['YearsEmployed']
end

python
# Ethnicity_CreditScore_Ratio
# Ratio of median Income within Ethnicity to Industry_CreditScore_Mean.
# Usefulness: Captures creditworthiness across different ethnic groups relative to their industrial credit score norms.
df['Ethnicity_CreditScore_Ratio'] = df['Ethnicity_Income_Median'] / (df['Industry_CreditScore_Mean'] + 1e-6)
end

python
# Log_Debt_to_Income
# Natural log of the Debt_to_Income ratio.
# Usefulness: Reduces skewness and highlights the burden of debt relative to income, normalized for extreme values.
df['Log_Debt_to_Income'] = np.log(df['Debt_to_Income'] + 1e-6)
end

python
# Zscore_Group_Age_Median
# Z-score normalization of Group_Age_Median.
# Usefulness: Standardizes age-related differences within ethnic groups for better interpretability within models.
df['Zscore_Group_Age_Median'] = (df['Group_Age_Median'] - df['Group_Age_Median'].mean()) / df['Group_Age_Median'].std()
end

python
# Married_to_YearsEmployed_Ratio
# Ratio of Married (binary indicator) to YearsEmployed.
# Usefulness: Demonstrates the balance between marital relationships and employment history, which could influence financial stability or obligations.
df['Married_to_YearsEmployed_Ratio'] = df['Married'] / (df['YearsEmployed'] + 1e-6)
end

python
# Citizen_Married_Interaction
# Interaction term for Citizen_Status_Sum and Married.
# Usefulness: Captures the impact of citizenship status in combination with marital stability on credit card application success.
df['Citizen_Married_Interaction'] = df['Citizen_Status_Sum'] * df['Married']
end

python
df.drop(columns=['Citizen_Status_Sum'], inplace=True)
end
