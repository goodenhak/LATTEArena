df['Age_Group_Bin'] = pd.cut(df['Age'], bins=[0, 22.6025, 28.46, 38.730000000000004, 80.25], labels=['Teen', 'Young Adult', 'Middle-Aged', 'Senior'])
end

python
# Debt_to_Income
# Feature description: Ratio of Debt to Income to understand financial liability relative to earning potential.
# Usefulness: Provides normalized insight into financial health, which is crucial for credit card application success evaluation.
df['Debt_to_Income'] = df['Debt'] / (df['Income'] + 1e-5)
end

python
# Age_Sqrt_Debt
# Feature description: Interaction feature multiplying Age and square root of Debt.
# Usefulness: Highlights the relationship between age and financial liabilities, considering non-linear relationships in Debt.
df['Age_Sqrt_Debt'] = df['Age'] * df['Sqrt_Debt']
end

python
# Married_and_BankCustomer
# Feature description: Interaction feature capturing individuals who are both Married and Bank Customers.
# Usefulness: Identifies stable lifestyle dynamics that often correlate with financial responsibility and creditworthiness.
df['Married_and_BankCustomer'] = df['Married'] * df['BankCustomer']
end

python
# Ethnicity_Median_Age_Log_Income
# Feature description: Product of Group_Age_Median (for Ethnicity) and Log_Income.
# Usefulness: Combines demographic insights with financial capability, capturing group-based stability trends.
df['Ethnicity_Median_Age_Log_Income'] = df['Group_Age_Median'] * df['Log_Income']
end

python
# CreditScore_YearsEmployed
# Feature description: Product of CreditScore and YearsEmployed.
# Usefulness: Highlights interaction between creditworthiness and job stability, relevant for financial decision-making.
df['CreditScore_YearsEmployed'] = df['CreditScore'] * df['YearsEmployed']
end

python
# PriorDefault_CreditScore_Weighted
# Feature description: Exponential interaction of PriorDefault and CreditScore.
# Usefulness: Exaggerates the effect of prior defaults on individuals with low credit scores, critical for risk evaluation.
df['PriorDefault_CreditScore_Weighted'] = df['PriorDefault'] * np.exp(df['CreditScore'])
end

python
# Zscore_Debt
# Feature description: Z-score normalization for the Debt feature.
# Usefulness: Brings Debt values to a standardized scale, facilitating model convergence and reducing feature variance impact.
df['Zscore_Debt'] = (df['Debt'] - df['Debt'].mean()) / df['Debt'].std()
end

python
# Married_BankCustomer_Employed_to_Log_Income
# Feature description: Product of Married_BankCustomer_Employed_Sum and Log_Income.
# Usefulness: Links lifestyle stability to financial health, emphasizing relationships between stability and earnings.
df['Married_BankCustomer_Employed_to_Log_Income'] = df['Married_BankCustomer_Employed_Sum'] * df['Log_Income']
end

python
