# Usefulness: Combat skewness and normalize its impact, especially since Age is right-skewed and varies significantly across the dataset.
df['Log_Age'] = np.log(df['Age'] + 1)
end

python
# Age_to_Group_Age_Median
# Ratio of Age to Group_Age_Median within Ethnicity.
# Usefulness: Captures relative age within demographic groups, reflecting potential behavioral differences by Ethnicity-Age interaction.
df['Age_to_Group_Age_Median'] = df['Age'] / df['Group_Age_Median']
end

python
# Debt_Income_Ratio
# Ratio of Debt to Income for assessing financial stress.
# Usefulness: Highlights individuals with disproportionate debt relative to income, a strong indicator of financial health.
df['Debt_Income_Ratio'] = df['Debt'] / (df['Income'] + 1)
end

python
# Debt_Married_BankCustomer_Sum
# Interaction of Debt with Married_BankCustomer_Employed_Sum.
# Usefulness: Combines financial strain with lifestyle indicators, highlighting individuals with potential affordability issues.
df['Debt_Married_BankCustomer_Sum'] = df['Debt'] * df['Married_BankCustomer_Employed_Sum']
end

python
# YearsEmployed_Age_Ratio
# Ratio of YearsEmployed to Age.
# Usefulness: Reflects work experience relative to age, providing insights into career stability and potential financial reliability.
df['YearsEmployed_Age_Ratio'] = df['YearsEmployed'] / (df['Age'] + 1)
end

python
# Log_Debt_to_Income
# Logarithmic transformation of Debt_Income_Ratio.
# Usefulness: Reduces skewness and improves interpretability of financial stress adjusted for income levels.
df['Log_Debt_to_Income'] = np.log(df['Debt_Income_Ratio'] + 0.0001)
end

python
# High_Income_Flag
# Binary flag indicating if Log_Income > Q3 (5.844230018329469).
# Usefulness: Differentiates high-income individuals; high income is a significant predictor of success.
df['High_Income_Flag'] = (df['Log_Income'] > 5.844230018329469).astype(int)
end

python
# PriorDefault_CreditScore_Ratio
# Ratio of PriorDefault_CreditScore_Interaction to Industry_CreditScore_Mean.
# Usefulness: Captures how prior defaults and CreditScore interact relative to industry-level norms.
df['PriorDefault_CreditScore_Ratio'] = df['PriorDefault_CreditScore_Interaction'] / (df['Industry_CreditScore_Mean'] + 0.0001)
end

python
# Debt_to_Age_Log
# Ratio of Debt to Log transformed Age.
# Usefulness: Combines financial strain (Debt) with normalized maturity (Log_Age) as older individuals might handle debt differently.
df['Debt_to_Age_Log'] = df['Debt'] / (df['Log_Age'] + 1)
end

python
# Married_and_PriorDefault_Interaction
# Interaction between Married and PriorDefault.
# Usefulness: Identifies default history among married individuals, who may behave differently in credit scenarios.
df['Married_and_PriorDefault_Interaction'] = df['Married'] * df['PriorDefault']
end

python
# Citizen_Temp_Employed_Cross
# Interaction of Citizen_Temporary and Employed.
# Usefulness: Highlights outcomes for temporarily residing individuals in the workforce, capturing unique behavioral patterns.
df['Citizen_Temp_Employed_Cross'] = df['Citizen_Temporary'] * df['Employed']
end

