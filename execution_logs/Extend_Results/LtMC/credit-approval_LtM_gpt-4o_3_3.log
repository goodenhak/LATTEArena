# married_x_debt_log
# Log transformation of married_x_debt to reduce skewness and better capture variations in household financial strain.
# Usefulness: Household financial strain is critical for credit card approval prediction, and log transformation stabilizes high dispersion.
df['married_x_debt_log'] = np.log1p(df['married_x_debt'])
end

python
# debt_to_income_log
# Log transformation of debt_to_income_ratio to better capture financial stress in a non-linear manner.
# Usefulness: Highlights proportional financial strain on income and alleviates skewness for improved model interpretation.
df['debt_to_income_log'] = np.log1p(df['debt_to_income_ratio'])
end

python
# debt_to_mean_income_ratio
# Ratio of Debt to zip_grouped_mean_income to measure individual debt relative to local income context.
# Usefulness: Captures regional economic disparity and individual financial strain in one metric.
df['debt_to_mean_income_ratio'] = df['Debt'] / (df['zip_grouped_mean_income'] + 1)
end

python
# credit_score_squared
# Square transformation of CreditScore to disproportionately emphasize higher scores.
# Usefulness: Higher credit scores can hold exponential importance in loan/credit approval likelihood.
df['credit_score_squared'] = np.square(df['CreditScore'])
end

python
# normalized_age
# Min-max normalization of Age to bring numerical stability and scale consistency with other features.
# Usefulness: Allows the model to capture age-related trends without numerical dominance.
df['normalized_age'] = (df['Age'] - df['Age'].min()) / (df['Age'].max() - df['Age'].min())
end

python
# prior_default_x_age
# Interaction term between PriorDefault and normalized_age to capture credit behavior through lifespan.
# Usefulness: Links historical financial reliability with age to assess life-long credit patterns.
df['prior_default_x_age'] = df['PriorDefault'] * df['normalized_age']
end

python
# debt_to_income_by_married
# Interaction term combining Married status and debt_to_income_ratio.
# Usefulness: Captures household-specific income stress impact on married individuals.
df['debt_to_income_by_married'] = df['Married'] * df['debt_to_income_ratio']
end

python
# debt_log_x_credit_score
# Interaction term combining log-transformed Debt and CreditScore.
# Usefulness: Links debt obligations with credit reliability, emphasizing smoother scaling.
df['debt_log_x_credit_score'] = df['debt_log'] * df['CreditScore']
end

python
