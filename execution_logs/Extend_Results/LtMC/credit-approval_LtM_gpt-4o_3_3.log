# DebtToIncomeRatio
# Ratio of Debt to Income to measure financial burden.
# Usefulness: Captures how much of an individual's income is allocated to outstanding debt, a crucial indicator of financial capability.
df['DebtToIncomeRatio'] = df['Debt'] / (df['Income'] + 1e-5)
end

python
# CreditScoreToDebtRatio
# Ratio of CreditScore to Debt to assess creditworthiness relative to debt level.
# Usefulness: Highlights individuals with good credit while managing their debt, a key indicator of reliability.
df['CreditScoreToDebtRatio'] = df['CreditScore'] / (df['Debt'] + 1e-5)
end

python
# Interaction_Employed_YearsEmployed
# Interaction term between Employed and YearsEmployed, indicating employment stability.
# Usefulness: Combines binary employment status and employment duration to better represent job stability.
df['Interaction_Employed_YearsEmployed'] = df['Employed'] * df['YearsEmployed']
end

python
