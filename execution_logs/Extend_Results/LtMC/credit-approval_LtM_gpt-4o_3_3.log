# Binary Stable Job Indicator: Longer employment implies stability
# Usefulness: Marks stable jobs as > 2 years of employment.
df['StableJobIndicator'] = (df['YearsEmployed'] > 2).astype(int)
end

python
# HasBankAccount: Interaction of financial participation and employment
