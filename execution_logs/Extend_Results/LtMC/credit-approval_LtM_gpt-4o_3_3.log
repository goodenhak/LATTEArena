# prior_default_x_credit_score_log
# Log transformation of prior_default_x_credit_score to reduce skewness and create a feature that better captures variability in historical credit behavior.
# Usefulness: Reduces skewness and emphasizes smaller values which may be more predictive of success.

df['prior_default_x_credit_score_log'] = df['prior_default_x_credit_score'].apply(lambda x: np.log(x + 1))
end

python
# debt_sqrt
# Square root transformation of Debt to capture nonlinear diminishing effects on financial stress with increasing debt.
# Usefulness: Reduces high debt impact while amplifying smaller value ranges, better modeling the relationship between debt and credit card success.

df['debt_sqrt'] = df['Debt'].apply(np.sqrt)
end

python
# debt_to_income_ratio_log
# Log transformation of debt_to_income_ratio to normalize this highly skewed financial stress measure.
# Usefulness: Improves prediction by limiting the impact of extreme outliers in debt-to-income ratios.

df['debt_to_income_ratio_log'] = df['debt_to_income_ratio'].apply(lambda x: np.log(x + 1))
end

python
# age_sqrt
# Square root transformation of Age to capture nonlinear progression in demographic features.
# Usefulness: Models nonlinear age-related creditworthiness variations more effectively.

df['age_sqrt'] = df['Age'].apply(np.sqrt)
end

python
# debt_x_prior_default
# Interaction term between Debt and Prior Default to evaluate how historical defaults impact the ability to manage debt for credit card applications.
# Usefulness: Combines important financial and historical behaviors for predicting credit card success.

df['debt_x_prior_default'] = df['Debt'] * df['PriorDefault']
end

python
# married_x_income_ratio
# Interaction term between Married status and debt_to_income_ratio to capture household financial stress based on marriage status.
# Usefulness: Accounts for household-level variability in financial obligations.

df['married_x_income_ratio'] = df['Married'] * df['debt_to_income_ratio']
end

python
# citizen_x_credit_score
# Interaction term between Citizen and CreditScore to analyze how citizenship type impacts creditworthiness across scores.
# Usefulness: Captures combined effects of demographic and behavioral attributes on success probability.

df['citizen_x_credit_score'] = df['citizen_encoded'] * df['CreditScore']
end

python
# debt_log_x_years_employed_ratio
# Interaction term between log-transformed Debt and debt_to_years_employed_ratio to measure financial strain versus career tenure in a transformed scale.
# Usefulness: Improves modeling of financial stress adjusted for employment stability.

df['debt_log_x_years_employed_ratio'] = df['debt_log'] * df['debt_to_years_employed_ratio']
end

python
# group_mean_income_by_industry
# Group-level aggregation: Average zip_grouped_mean_income for each Industry category.
# Usefulness: Captures industry-level income trends to better describe demographic and financial profiles relevant to credit card success.

df['group_mean_income_by_industry'] = df.groupby('Industry')['zip_grouped_mean_income'].transform('mean')
end

python
# group_std_income_by_industry
# Group-level aggregation: Standard deviation of zip_grouped_std_income for each Industry category.
# Usefulness: Identifies income variability within job sectors related to credit card prediction.

df['group_std_income_by_industry'] = df.groupby('Industry')['zip_grouped_std_income'].transform('std')
end

python
# age_bin
# Bucket Age into bins (5 segments) to analyze demographic trends across grouped age ranges.
# Usefulness: Enhances interpretation and prediction by clustering age-related behaviors.

df['age_bin'] = pd.cut(df['Age'], bins=5, labels=False)
end

python
# industry_target_encoding
# Target encoding: Maps each Industry category to the average application success rate in the dataset.
# Usefulness: Enables categorical variable (Industry) to be encoded using the downstream target which is predictive of credit card success rates.

success_rate_by_industry = df.groupby('Industry')['Answer'].mean()
df['industry_target_encoding'] = df['Industry'].map(success_rate_by_industry)
end

python
# citizen_target_encoding
# Target encoding: Maps citizenship type to application success rate based on historical data.
# Usefulness: Enhances the predictive power of categorical features using target-based encoding.

success_rate_by_citizen = df.groupby('Citizen')['Answer'].mean()
df['citizen_target_encoding'] = df['Citizen'].map(success_rate_by_citizen)
end

python
# Drop redundant features
df.drop(columns=['citizen_encoded', 'zip_grouped_std_income'], inplace=True)
end
