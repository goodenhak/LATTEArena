# debt_to_income_ratio
# Ratio of Debt to Income, created to measure financial stress and creditworthiness.
# Usefulness: Shows financial stability and the ability to manage debt relative to income, which is critical for credit card approval decisions.
df['debt_to_income_ratio'] = df['Debt'] / (df['Income'] + 1) # Add 1 to avoid division by zero
end

python
# prior_default_x_credit_score
# Interaction term between Prior Default and Credit Score to capture historical credit behavior in relation to current creditworthiness.
# Usefulness: Individuals with prior defaults but decent credit scores might indicate patterns in recovering from past credit issues.
df['prior_default_x_credit_score'] = df['PriorDefault'] * df['CreditScore']
end

python
# years_employed_x_income
# Interaction term between Years Employed and Income to capture stability and earning potential.
# Usefulness: Longer employment tenure paired with higher income reflects economic security beneficial for credit approval.
df['years_employed_x_income'] = df['YearsEmployed'] * df['Income']
end

python
# married_x_income
# Interaction term between Marriage status and Income to capture household financial stability.
# Usefulness: Married individuals with higher income may present as lower risk to lenders for credit applications.
df['married_x_income'] = df['Married'] * df['Income']
end

python
# credit_score_log
# Log transformation of the Credit Score to manage skewness and highlight differences among applicants with very low or high scores.
# Usefulness: Helps emphasize meaningful variations in credit scores to improve predictive power for credit approval.
df['credit_score_log'] = np.log1p(df['CreditScore']) # Apply log1p to handle zero values
end

python
# debt_log
# Log transformation of Debt to reduce skewness and improve model performance on highly dispersed values.
# Usefulness: Helps account for large variations in outstanding debt levels.
df['debt_log'] = np.log1p(df['Debt']) # Apply log1p to handle zero values
end

python
# debt_to_income_zscore
# Z-score of debt-to-income ratio for normalization.
# Usefulness: Captures relative financial stress across all applicants by standardizing the debt-to-income feature.
df['debt_to_income_zscore'] = (df['debt_to_income_ratio'] - df['debt_to_income_ratio'].mean()) / df['debt_to_income_ratio'].std()
end

python
# employed_x_drivers_license
# Interaction term between Employment status and Drivers License to capture practical dependability attributes.
# Usefulness: Employed individuals with drivers licenses might signal better economic and mobility stability.
df['employed_x_drivers_license'] = df['Employed'] * df['DriversLicense']
end

python
# married_x_debt
# Interaction term between Married status and Debt to capture potential household financial strain.
# Usefulness: Helps differentiate financial stress levels for married versus unmarried applicants with high outstanding debt.
df['married_x_debt'] = df['Married'] * df['Debt']
end

python
# debt_to_years_employed_ratio
# Ratio of Debt to Years Employed to measure how financial obligations compare to career tenure.
# Usefulness: Reflects stability and financial planning based on employment history.
df['debt_to_years_employed_ratio'] = df['Debt'] / (df['YearsEmployed'] + 1) # Add 1 to avoid division by zero
end

python
# citizen_encoded
# Label encoding for Citizenship feature.
# Usefulness: Converts categorical citizenship status into numerical values to enable modeling group-level effects.
df['citizen_encoded'] = df['Citizen'].map({'ByBirth': 0, 'ByOtherMeans': 1, 'Temporary': 2})
end

python
# ethnicity_target_encoding
# Target encoding for Ethnicity feature based on credit card application success rate.
# Usefulness: Captures group-level success rates tied to ethnicity for nuanced insights.
df['ethnicity_target_encoding'] = df.groupby('Ethnicity')['Answer'].transform('mean')
end

python
# industry_target_encoding
# Target encoding for Industry feature based on average success rate in credit card applications.
# Usefulness: Identifies industries with more successful applicants, tying job sector to creditworthiness.
df['industry_target_encoding'] = df.groupby('Industry')['Answer'].transform('mean')
end

python
# zip_grouped_mean_income
# Group-level aggregation: Mean Income by ZipCode.
# Usefulness: Adds regional context to applicant income by identifying income norms within zip codes.
df['zip_grouped_mean_income'] = df.groupby('ZipCode')['Income'].transform('mean')
end

python
# zip_grouped_std_income
# Group-level aggregation: Standard deviation of Income by ZipCode.
# Usefulness: Captures income dispersion within zip codes to assess regional economic disparity.
df['zip_grouped_std_income'] = df.groupby('ZipCode')['Income'].transform('std')
end

python
df.drop(columns=['ZipCode'], inplace=True)
end
