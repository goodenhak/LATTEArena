# debt_to_income_ratio
# Feature description: Ratio of Debt to (Income + 1) to account for financial obligations relative to earning capacity.
# Usefulness: Highlights the burden of debt relative to the ability to pay, crucial for assessing financial health.
df['debt_to_income_ratio'] = df['Debt'] / (df['Income'] + 1)
end

python
# credit_utilization
# Feature description: Ratio of CreditScore to (Debt + 1), reflecting effective credit management.
# Usefulness: Applicants with low debt and high credit scores demonstrate better risk management.
df['credit_utilization'] = df['CreditScore'] / (df['Debt'] + 1)
end

python
# log_income
# Feature description: Log transformation of Income to handle skewness in income distribution.
# Usefulness: Reduces the effect of extreme income values, better representing the majority.
df['log_income'] = np.log1p(df['Income'])
end

python
# log_debt
# Feature description: Log transformation of Debt to address its skewness.
# Usefulness: Gives balanced importance to variations in smaller versus larger debt values.
df['log_debt'] = np.log1p(df['Debt'])
end

python
# bin_age
# Feature description: Binned Age categories (e.g., 'Young', 'Middle-Aged', 'Senior') based on quantiles.
# Usefulness: Encodes age into discrete groups for simpler interpretability and captures nonlinear relationships.
df['bin_age'] = pd.cut(df['Age'], bins=[13, 25, 45, 75], labels=['Young', 'Middle-Aged', 'Senior'])
end

python
# low_income
# Feature description: Binary feature indicating if Income is below the first quartile (Q1).
# Usefulness: Identifies applicants in economically constrained groups.
df['low_income'] = (df['Income'] < 5.5).astype(int)
end

python
# employment_credit_interaction
# Feature description: Interaction term between Employed and CreditScore.
# Usefulness: Highlights cases where employed individuals also have higher credit scores, a positive success indicator.
df['employment_credit_interaction'] = df['Employed'] * df['CreditScore']
end

python
# stability_interaction
# Feature description: Interaction between YearsEmployed and Married.
# Usefulness: Combines job and personal stability to assess the reliability of applicants.
df['stability_interaction'] = df['YearsEmployed'] * df['Married']
end

python
# financial_health_index
# Feature description: Index constructed by normalizing and summing Debt, CreditScore, and Income.
# Usefulness: Provides an aggregated score to capture overall financial well-being.
df['financial_health_index'] = (df['Debt'] / df['Debt'].max()) + \
                                (df['CreditScore'] / df['CreditScore'].max()) + \
                                (df['Income'] / df['Income'].max())
end

python
# employment_stability_index
# Feature description: Index developed by combining YearsEmployed, Employed, and Married.
# Usefulness: Aggregates job and personal life stability into a single metric for reliability assessment.
df['employment_stability_index'] = df['YearsEmployed'] + df['Employed'] + df['Married']
end

python
# credit_risk_score
# Feature description: Composite score based on CreditScore, PriorDefault, and debt_to_income_ratio.
# Usefulness: Summarizes applicant credit risk into a single interpretable score.
df['credit_risk_score'] = (df['CreditScore'] / df['CreditScore'].max()) - \
                          df['PriorDefault'] - \
                          (df['Debt'] / (df['Income'] + 1))
end

python
# reliability_ratio
# Feature description: Ratio summarizing YearsEmployed and Employed relative to PriorDefault.
# Usefulness: Assesses overall dependability by contrasting stability factors with prior defaults.
df['reliability_ratio'] = (df['YearsEmployed'] + df['Employed']) / (df['PriorDefault'] + 1)
end

python
# target_encoded_industry
# Feature description: Derived feature using target encoding of Industry with respect to Answer.
# Usefulness: Captures the likelihood of credit card success based on job sector.
df['target_encoded_industry'] = df['Industry'].map(industry_target_encoding)
end

python
# target_encoded_ethnicity
# Feature description: Derived feature using target encoding of Ethnicity with respect to Answer.
# Usefulness: Encodes the relationship between ethnicity and success rate into a numeric feature.
df['target_encoded_ethnicity'] = df['Ethnicity'].map(ethnicity_target_encoding)
end

python
# groupby_zipcode_income
# Feature description: Mean Income grouped by ZipCode.
# Usefulness: Encodes regional income distribution, highlighting economic context.
df['groupby_zipcode_income'] = df.groupby('ZipCode')['Income'].transform('mean')
end

python
# groupby_zipcode_creditscore
# Feature description: Mean CreditScore grouped by ZipCode.
# Usefulness: Reflects regional credit behavior and access patterns.
df['groupby_zipcode_creditscore'] = df.groupby('ZipCode')['CreditScore'].transform('mean')
end

python
df.drop(columns=['ZipCode'], inplace=True)
end
