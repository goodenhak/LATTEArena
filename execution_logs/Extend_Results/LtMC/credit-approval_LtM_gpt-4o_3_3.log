2026-05-26 11:05:29,790 - INFO - ops_string = ["# married_x_debt_log\n# Log transformation of married_x_debt to reduce skewness and better capture variations in household financial strain.\n# Usefulness: Household financial strain is critical for credit card approval prediction, and log transformation stabilizes high dispersion.\ndf['married_x_debt_log'] = np.log1p(df['married_x_debt'])", "# debt_to_income_log\n# Log transformation of debt_to_income_ratio to better capture financial stress in a non-linear manner.\n# Usefulness: Highlights proportional financial strain on income and alleviates skewness for improved model interpretation.\ndf['debt_to_income_log'] = np.log1p(df['debt_to_income_ratio'])", "# debt_to_mean_income_ratio\n# Ratio of Debt to zip_grouped_mean_income to measure individual debt relative to local income context.\n# Usefulness: Captures regional economic disparity and individual financial strain in one metric.\ndf['debt_to_mean_income_ratio'] = df['Debt'] / (df['zip_grouped_mean_income'] + 1)", "# credit_score_squared\n# Square transformation of CreditScore to disproportionately emphasize higher scores.\n# Usefulness: Higher credit scores can hold exponential importance in loan/credit approval likelihood.\ndf['credit_score_squared'] = np.square(df['CreditScore'])", "# normalized_age\n# Min-max normalization of Age to bring numerical stability and scale consistency with other features.\n# Usefulness: Allows the model to capture age-related trends without numerical dominance.\ndf['normalized_age'] = (df['Age'] - df['Age'].min()) / (df['Age'].max() - df['Age'].min())", "# prior_default_x_age\n# Interaction term between PriorDefault and normalized_age to capture credit behavior through lifespan.\n# Usefulness: Links historical financial reliability with age to assess life-long credit patterns.\ndf['prior_default_x_age'] = df['PriorDefault'] * df['normalized_age']", "# debt_to_income_by_married\n# Interaction term combining Married status and debt_to_income_ratio.\n# Usefulness: Captures household-specific income stress impact on married individuals.\ndf['debt_to_income_by_married'] = df['Married'] * df['debt_to_income_ratio']", "# debt_log_x_credit_score\n# Interaction term combining log-transformed Debt and CreditScore.\n# Usefulness: Links debt obligations with credit reliability, emphasizing smoother scaling.\ndf['debt_log_x_credit_score'] = df['debt_log'] * df['CreditScore']", "# industry_target_encoded\n# Target encoding of Industry with respect to the success label.\n# Usefulness: Captures economic performance of specific job sectors and their impact on creditworthiness.\nindustry_target_mean = df.groupby('Industry')['success_label'].mean()\ndf['industry_target_encoded'] = df['Industry'].map(industry_target_mean)", "# debt_to_std_income_ratio\n# Ratio of Debt to zip_grouped_std_income to reflect variance-adjusted financial strain in the local population.\n# Usefulness: Highlights debt obligations in economically diverse neighborhoods for targeted predictions.\ndf['debt_to_std_income_ratio'] = df['Debt'] / (df['zip_grouped_std_income'] + 1)", "# employed_x_drivers_license_log\n# Log transformation of employed_x_drivers_license to stabilize variance in stability-dependent practical attributes.\n# Usefulness: Improves interpretability of interaction-based features related to dependability.\ndf['employed_x_drivers_license_log'] = np.log1p(df['employed_x_drivers_license'])", "# zip_grouped_mean_income_log\n# Log transformation of zip_grouped_mean_income to handle high dispersion of income values between regions.\n# Usefulness: Stabilizes regional income insights for fair modeling of credit approval factors.\ndf['zip_grouped_mean_income_log'] = np.log1p(df['zip_grouped_mean_income'])", "df.drop(columns=['citizen_encoded'], inplace=True)", "df.drop(columns=['citizen_encoded'], inplace=True)"]
