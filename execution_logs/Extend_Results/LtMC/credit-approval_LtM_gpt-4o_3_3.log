# Debt_to_Income
# Ratio of Debt to Income to measure financial burden relative to income.
# Usefulness: Captures the proportion of financial obligations relative to earnings, highlighting creditworthiness concerns.
df[Debt_to_Income] = df[Debt] / (df[Income] + 1)
end

python
# YearsEmployed_to_Age
# Ratio of Years Employed to Age to measure employment stability over age.
# Usefulness: Reflects work stability relative to life progress, emphasizing early vs. late career dynamics.
df[YearsEmployed_to_Age] = df[YearsEmployed] / (df[Age] + 1)
end

python
# Credit_to_Debt
# Ratio of CreditScore to (Debt + 1) to assess creditworthiness relative to outstanding debt.
# Usefulness: Highlights the strength of credit score in the context of existing financial burdens.
df[Credit_to_Debt] = df[CreditScore] / (df[Debt] + 1)
end

python
# log_Income
# Log transformation of Income to reduce skewness and emphasize relative differences in income levels.
# Usefulness: Tackles the heavy skew in Income while preserving the order of magnitude differences.
df[log_Income] = np.log(df[Income] + 1)
end

python
# sigmoid_CreditScore
# Sigmoid transformation of CreditScore to normalize and magnify impacts at extreme scores.
# Usefulness: Emphasizes the non-linear impacts of very high or very low credit scores on credit success.
df[sigmoid_CreditScore] = 1 / (1 + np.exp(-df[CreditScore]))
end

python
# sqrt_YearsEmployed
# Square root transformation of YearsEmployed to model diminishing returns in experience.
# Usefulness: Balances the wide range in experience while giving importance to early career years.
df[sqrt_YearsEmployed] = np.sqrt(df[YearsEmployed])
end

python
# Age_Bin
# Binning Age into categorical ranges to capture life stage patterns.
# Usefulness: Highlights differences in credit behavior across age groups (e.g., young, middle-aged, older applicants).
df[Age_Bin] = pd.cut(df[Age], bins=[0, 25, 35, 50, 100], labels=[<25, 25-35, 35-50, >50])
end

python
# Income_Binned
# Binning Income into quartiles to handle high skewness in income levels.
# Usefulness: Simplifies income into discrete ranges for capturing broader patterns of financial capacity.
df[Income_Binned] = pd.qcut(df[Income], q=4, labels=[Low, Medium, High, Very High])
end

python
# Employed_x_YearsEmployed
# Interaction feature multiplying Employed by YearsEmployed to highlight stability for currently employed applicants.
# Usefulness: Measures the compound effect of being employed and years of experience, making it relevant for stability assessment.
df[Employed_x_YearsEmployed] = df[Employed] * df[YearsEmployed]
end

python
# Married_x_Age
# Interaction feature combining Age and Married status to reflect stability with life stage.
# Usefulness: Captures the potential advantages of maturity and marital stability during credit evaluation.
df[Married_x_Age] = df[Married] * df[Age]
end

python
# One-hot encoding for Industry
# Converts Industry into multiple binary columns for each sector.
# Usefulness: Allows the model to capture sector-specific patterns that may influence financial behavior.
df = pd.get_dummies(df, columns=[Industry], prefix=Industry, drop_first=True)
end

python
# One-hot encoding for Ethnicity
# Converts Ethnicity into multiple binary columns for each group.
# Usefulness: Captures socioeconomic differences across ethnic groups that may influence credit behavior.
df = pd.get_dummies(df, columns=[Ethnicity], prefix=Ethnicity, drop_first=True)
end

python
# Target Encoding for Industry
# Encodes Industry by the mean success rate of each category.
# Usefulness: Provides aggregated success information by job sector while retaining variability per group.
industry_te = df.groupby(Industry)[Target].transform(mean)
df[Industry_TargetEncoded] = industry_te
end

python
# Removing unnecessary columns
# Drops ZipCode because it lacks meaningful predictive value for credit success.
df.drop(columns=[ZipCode], inplace=True)
end
