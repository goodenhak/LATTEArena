# debt_to_income_ratio
# Ratio of Debt to Income
# Usefulness: Captures financial burden relative to income, which is critical for understanding an applicant's ability to manage debt and expenses.
df['debt_to_income_ratio'] = df['Debt'] / (df['Income'] + 1)
end

python
# employment_stability_index
# Employment stability relative to age
# Usefulness: Measures how stable and experienced the applicant's employment is, considering their age, which is a useful proxy for reliability and financial maturity.
df['employment_stability_index'] = df['YearsEmployed'] / (df['Age'] + 1)
end

python
# default_employment_interaction
# Interaction of PriorDefault and Employed
# Usefulness: Highlights high-risk cases where applicants have prior defaults and are unemployed, complementing individual predictors.
df['default_employment_interaction'] = df['PriorDefault'] * (1 - df['Employed'])
end

python
# employment_binary_stability
# Binary indicator if employment years exceed the median of YearsEmployed
# Usefulness: A simple threshold-based feature that separates applicants based on employment stability, which is significant for credit risks.
df['employment_binary_stability'] = (df['YearsEmployed'] > df['YearsEmployed'].median()).astype(int)
end

python
# creditworthiness_score
# Composite creditworthiness score using CreditScore and Income
# Usefulness: Combines absolute credit score and income to better assess the applicant's financial standing relative to approval criteria.
df['creditworthiness_score'] = df['CreditScore'] + df['Income']
end

python
# age_binned
# Age grouped into bins ([18, 25, 35, 50, 75])
# Usefulness: Segments age into economically relevant categories, reflecting maturity and potential earning stages in life.
df['age_binned'] = pd.cut(df['Age'], bins=[18, 25, 35, 50, 75], labels=[1, 2, 3, 4])
end

python
# log_income
# Log transformation of Income
# Usefulness: Handles right-skewed income distribution, allowing the model to better learn predictive signals without disproportionate emphasis on large values.
df['log_income'] = np.log1p(df['Income'])
end

python
# scaled_credit_score
# Standardized CreditScore using z-score
# Usefulness: Normalizes credit score to comparable ranges, improving its interpretability and predictive value in the model.
df['scaled_credit_score'] = (df['CreditScore'] - df['CreditScore'].mean()) / df['CreditScore'].std()
end

python
# industry_target_encoding
# Target encoding for Industry column
# Usefulness: Encodes Industry with its mean success rate, capturing domain-specific insights about job sector influence on approval without adding large categorical dimensions.
industry_target_mean = df.groupby('Industry')['TargetColumn'].mean()
df['industry_target_encoding'] = df['Industry'].map(industry_target_mean)
end

python
# citizen_label_encoding
# Label encoding for Citizen column
# Usefulness: Encodes citizenship categories into numeric values for use in machine learning models while retaining ordinal relationships.
from sklearn.preprocessing import LabelEncoder
label_encoder = LabelEncoder()
df['citizen_label_encoding'] = label_encoder.fit_transform(df['Citizen'])
end

python
# ethnicity_industry_cross
# Combined Ethnicity and Industry feature
# Usefulness: Examines the joint effects of job sector and ethnicity, potentially uncovering richer interactions and group-specific trends in credit approval.
df['ethnicity_industry_cross'] = df['Ethnicity'].astype(str) + '_' + df['Industry'].astype(str)
end

python
