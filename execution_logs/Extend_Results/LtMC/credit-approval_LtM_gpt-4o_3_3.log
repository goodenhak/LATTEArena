# married_x_debt_zscore
# Z-score normalized version of married_x_debt to standardize its distribution and make its values comparable to other features.
# Usefulness: Standardizing this interaction term enhances its interpretability for financial strain across households.
df['married_x_debt_zscore'] = (df['married_x_debt'] - df['married_x_debt'].mean()) / df['married_x_debt'].std()
end

python
# debt_to_age_ratio
# Ratio of Debt to Age, designed to measure relative financial burden by life stage.
# Usefulness: Highlights individuals over-leveraged for their age, which may indicate financial immaturity or distress.
df['debt_to_age_ratio'] = df['Debt'] / df['Age']
end

python
# log_debt_to_income_ratio
# Log transformation of debt_to_income_ratio to reduce skewness and capture more realistic patterns of financial stress.
# Usefulness: Improves handling of highly skewed values in financial stress indicators for better predictive power.
df['log_debt_to_income_ratio'] = np.log1p(df['debt_to_income_ratio'])
end

python
# sigmoid_credit_score
# Sigmoid transformation of CreditScore to emphasize smaller differences in lower scores.
# Usefulness: Highlights small differences in low credit scores, which are critical for predicting creditworthiness.
df['sigmoid_credit_score'] = 1 / (1 + np.exp(-df['CreditScore']))
end

python
# debt_income_zip_interaction
# Interaction term between zip_grouped_mean_income and zip_grouped_std_income to capture income disparity within regions.
# Usefulness: Provides regional insights into financial stress due to high income disparity in zip code areas.
df['debt_income_zip_interaction'] = df['zip_grouped_mean_income'] * df['zip_grouped_std_income']
end

python
# prior_default_credit_sigmoid
# Sigmoid transformation applied to prior_default_x_credit_score to emphasize differentiating lower interaction values.
# Usefulness: Enhances interpretability of prior default risk combined with credit score through non-linear scaling.
df['prior_default_credit_sigmoid'] = 1 / (1 + np.exp(-df['prior_default_x_credit_score']))
end

python
# employed_citizen_interaction
# Interaction term between employed_x_drivers_license and citizen_encoded to model practical dependability alongside citizenship type.
# Usefulness: Captures compound effects of stable work characteristics and citizenship on credit card success.
df['employed_citizen_interaction'] = df['employed_x_drivers_license'] * df['citizen_encoded']
end

python
# drop_citizen_encoded
df.drop(columns=['citizen_encoded'], inplace=True)
end

python
# married_x_debt_highlow
# Binarized version of married_x_debt: 1 for above median, 0 otherwise.
# Usefulness: Converts interaction term into high/low categories for easier interpretability during analysis.
df['married_x_debt_highlow'] = (df['married_x_debt'] > df['married_x_debt'].median()).astype(int)
end

python
# debt_to_years_employed_log
# Log transformation of debt_to_years_employed_ratio to handle skewed distribution.
# Usefulness: Makes the distribution smoother and improves model sensitivity to employment-finance dynamics.
df['debt_to_years_employed_log'] = np.log1p(df['debt_to_years_employed_ratio'])
end

python
# financial_strain_index
# Aggregate metric of overall financial strain: sum of normalized debt_to_income_ratio, debt_to_years_employed_log, and married_x_debt_zscore.
# Usefulness: Combines multiple financial strain indicators to summarize overall financial distress level.
df['financial_strain_index'] = (
    (df['debt_to_income_ratio'] - df['debt_to_income_ratio'].mean()) / df['debt_to_income_ratio'].std() +
    (df['debt_to_years_employed_log'] - df['debt_to_years_employed_log'].mean()) / df['debt_to_years_employed_log'].std() +
    (df['married_x_debt_zscore'] - df['married_x_debt_zscore'].mean()) / df['married_x_debt_zscore'].std()
)
end

python
# age_zscore
# Z-score normalization of Age to standardize its distribution and make age comparable to other features.
# Usefulness: Normalizing this feature increases its comparability in downstream modeling tasks.
df['age_zscore'] = (df['Age'] - df['Age'].mean()) / df['Age'].std()
end

python
# age_binned
# Bin Age into quintiles to capture age group trends in creditworthiness.
# Usefulness: Groups people into age-related categories to identify cohort effects better.
df['age_binned'] = pd.qcut(df['Age'], 5, labels=False)
end
