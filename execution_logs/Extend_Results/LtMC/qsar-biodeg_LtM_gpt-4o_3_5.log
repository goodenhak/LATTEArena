# log_C_O_ratio
# Log transformation of C_O_ratio to compress its range and emphasize smaller values impacting molecular reactivity.
# Usefulness: Compresses the large range of C_O_ratio and highlights values that may correlate with biodegradability.

df['log_C_O_ratio'] = df['C_O_ratio'].apply(lambda x: np.log(x + 1))
end

python
# nHDon_ratio
# Ratio of nHDon to nO to reflect donor atom proportion relative to oxygen atoms.
# Usefulness: Emphasizes the balance between hydrogen bond donors and oxygen atoms, which impacts reactivity and biodegradability.

df['nHDon_ratio'] = df['nHDon'] / (df['nO'] + 1)
end

python
# C_N_ratio_distance_2_to_4
# Ratio of F02[C-N] to F04[C-N] to measure the distribution of C-N bonds across topological distances.
# Usefulness: Highlights how interactions between atoms vary with bond distances, potentially affecting chemical biodegradability.

df['C_N_ratio_distance_2_to_4'] = df['F02[C-N]'] / (df['F04[C-N]'] + 1)
end

python
# normalized_Me
# Min-max scaling on Me to normalize mean Sanderson electronegativity while preserving relational patterns.
# Usefulness: Helps unify feature distributions and makes comparisons across chemicals easier and interpretable.

df['normalized_Me'] = (df['Me'] - df['Me'].min()) / (df['Me'].max() - df['Me'].min())
end

python
# SpPosA_B_ratio_to_SM6_L
# Ratio of SpPosA_B(p) to SM6_L to combine global molecular reactivity with structural descriptors.
# Usefulness: Represents a relationship between reactivity and spectral structure that is linked to biodegradability.

df['SpPosA_B_ratio_to_SM6_L'] = df['SpPosA_B(p)'] / (df['SM6_L'] + 1)
end

python
# sqrt_TI2_L
# Square root of TI2_L to emphasize smaller values and address nonlinearity in molecular topology descriptors.
# Usefulness: Captures more nuance in features related to topology and branching of molecular structures.

df['sqrt_TI2_L'] = df['TI2_L'].apply(np.sqrt)
end

python
# zscore_nCp
# Z-score normalization of nCp to standardize the feature distribution.
# Usefulness: Ensures consistent scaling for nCp, useful for combining related features and improving model performance.

df['zscore_nCp'] = (df['nCp'] - df['nCp'].mean()) / df['zCp'].std()
end

python
# log_SdO_inverted
# Negated log transformation of SdO to invert impact and emphasize higher donor interactions.
# Usefulness: Adds interpretability by exploring an inverted relationship of donor electronegative capability.

df['log_SdO_inverted'] = -df['log_SdO']
end

python
# nCIR_cross_LOC
# Product of nCIR and LOC to combine cyclic structures with branching complexity.
# Usefulness: Represents interaction behavior of molecular rings and structural branching patterns affecting biodegradability.

df['nCIR_cross_LOC'] = df['nCIR'] * df['LOC']
end

python
# carbon_hydrogen_cross_ratio
# Product of carbon_hydrogen_ratio and C_O_ratio to combine carbon-hydrogen and carbon-oxygen proportions.
# Usefulness: Explores interaction between two ratio-based features impacting molecular biodegradability.

df['carbon_hydrogen_cross_ratio'] = df['carbon_hydrogen_ratio'] * df['C_O_ratio']
end

python
# drop_C_O_ratio
# Dropping C_O_ratio column since its log-transformed version is more interpretable and reduces skewness.
df.drop(columns=['C_O_ratio'], inplace=True)
end

python
# drop_SdO
# Dropping SdO column since its log transformation variants better fit the task and add more nuanced patterns.
df.drop(columns=['SdO'], inplace=True)
end
