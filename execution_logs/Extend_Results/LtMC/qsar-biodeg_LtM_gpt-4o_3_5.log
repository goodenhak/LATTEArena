# log_C_O_ratio
# Logarithmic transformation of the C_O_ratio to reduce skewness and emphasize smaller values influencing carbon-to-oxygen proportions.
# Usefulness: Reduces large range of C_O_ratio, highlighting the effect of smaller ratios related to reactivity.
df['log_C_O_ratio'] = np.log1p(df['C_O_ratio'])
end

python
# nHDon_to_nO_ratio
# Ratio of hydrogen bond donors (nHDon) to oxygen atoms (nO), showing balance in electronegative molecule interactions.
# Usefulness: Captures interaction between two key contributors to biodegradability: donors and oxygen atoms.
df['nHDon_to_nO_ratio'] = df['nHDon'] / (df['nO'] + 1e-6)
end

python
# interaction_SdssC_SpPosA
# Interaction of SdssC (sum of carbon E-states) and SpPosA_B(p) (polarizability-weighted descriptor).
# Usefulness: Explores joint contribution of electronic and structural attributes to biodegradability.
df['interaction_SdssC_SpPosA'] = df['SdssC'] * df['SpPosA_B(p)']
end

python
# interaction_Psi_iA_SpMax
# Interaction between Psi_i_A (pseudoconnectivity index) and SpMax_L (leading eigenvalue from Laplace matrix).
# Usefulness: Highlights interaction between connectivity and molecular structure complexity.
df['interaction_Psi_iA_SpMax'] = df['Psi_i_A'] * df['SpMax_L']
end

python
# zscore_C_O_ratio
# Z-score normalization of C_O_ratio for scale consistency across features.
# Usefulness: Helps standardize a highly skewed feature with a large range to prioritize relative deviations.
df['zscore_C_O_ratio'] = (df['C_O_ratio'] - df['C_O_ratio'].mean()) / df['C_O_ratio'].std()
end

python
# net_hydrogen_donors
# Net contribution of hydrogen donors by taking nHDon_minus_nO.
# Usefulness: Indicates dominance of hydrogen bonding capability over oxygen count, relevant for biodegradation.
df['net_hydrogen_donors'] = df['nHDon'] - df['nO']
end

python
# total_complexity
# Combined total of nCIR (number of circuits) and NssssC (atoms of type ssssC).
# Usefulness: Captures structural complexity indicating multiple bonding circuits and ssssC atom occurrences.
df['total_complexity'] = df['nCIR'] + df['NssssC']
end

python
# log_carbon_hydrogen_ratio
# Logarithmic transformation of carbon_hydrogen_ratio to reduce skewness and emphasize smaller values.
# Usefulness: Adjusts for the range of this ratio, reflecting structural contribution of terminal primary carbons.
df['log_carbon_hydrogen_ratio'] = np.log1p(df['carbon_hydrogen_ratio'])
end

python
# F03_F04_diff
# Difference between bond frequencies F03[C-N] and F04[C-N].
# Usefulness: Highlights structural differences in bonding at varying topological distances.
df['F03_F04_diff'] = df['F03[C-N]'] - df['F04[C-N]']
end

python
# target_encoded_arNO2
# Target encoding for nArNO2 (number of nitro groups).
# Usefulness: Captures impact of this discrete feature on biodegradability based on class correlations.
target_mean_nArNO2 = df.groupby('nArNO2')['biodegradability'].mean()
df['target_encoded_arNO2'] = df['nArNO2'].map(target_mean_nArNO2)
end

python
# Update final dataset by dropping columns less relevant to downstream tasks
df.drop(columns=['carbon_hydrogen_ratio', 'C_O_ratio', 'log_SdO'], inplace=True)
end
