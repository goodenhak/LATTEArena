# sqrt_SpMax_L
# Square root transformation of leading eigenvalue (SpMax_L) to reduce impact of extreme values in structural complexity.
# Usefulness: Highlights the molecular structural complexity while mitigating skewed data distribution.
df['sqrt_SpMax_L'] = df['SpMax_L']  0.5
end

python
# log_LOC_plus_1
# Log transformation of lopping centric index (LOC) plus 1 to handle skewness and emphasize smaller structurally significant values.
# Usefulness: Stabilizes variance for structural compactness considerations in biodegradability.
df['log_LOC_plus_1'] = np.log1p(df['LOC'])
end

python
# sqrt_nHDon_mult_nO
# Square root of product of hydrogen donors and oxygen atoms to capture interaction effects between the two.
# Usefulness: Reflects the combined contribution of hydrogen bond donors and oxygen atoms to biodegradability.
df['sqrt_nHDon_mult_nO'] = np.sqrt(df['nHDon'] * df['nO'])
end

python
# reciprocal_Me
# Reciprocal transformation of mean atomic Sanderson electronegativity (Me) to emphasize low electronegativity effects.
# Usefulness: Highlights degradability influenced by molecules with lower mean electronegativity values.
df['reciprocal_Me'] = 1 / df['Me']
end

python
# log_SdO_per_nO_plus_1
# Log transformation of SdO_per_nO (sum of atomic electronegativity per oxygen count) to stabilize its distribution.
# Usefulness: Captures relative donor atom electronegativity effects contributing to biodegradability.
df['log_SdO_per_nO_plus_1'] = np.log1p(df['SdO_per_nO'])
end

python
# SpPosA_B_p_times_log_SdO_positive
# Indicator feature marking samples with positive values of SpPosA_B_p_times_log_SdO.
# Usefulness: Differentiates molecules based on combined impact of normalized spectral burden measures and donor interactions.
df['SpPosA_B_p_times_log_SdO_positive'] = (df['SpPosA_B_p_times_log_SdO'] > 0).astype(int)
end

python
# SdO_plus_LOC_div_nO
# Sum of donor atom E-states (SdO) and LOC, normalized by the number of oxygen atoms (nO).
# Usefulness: Cross-interaction feature capturing the balance between structural details and donor atom interactions.
df['SdO_plus_LOC_div_nO'] = (df['SdO'] + df['LOC']) / (df['nO'] + 1e-9)
end

