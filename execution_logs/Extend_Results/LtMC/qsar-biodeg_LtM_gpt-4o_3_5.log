# new_feature_SpMax_L_normalized
# Normalized SpMax_L using min-max scaling to emphasize relative eigenvalue contribution to molecular topology.
# Usefulness: This enhances interpretability by scaling SpMax_L values to a fixed range, ensuring comparability across samples.
df['new_feature_SpMax_L_normalized'] = (df['SpMax_L'] - 2.0) / (6.496 - 2.0)
end

python
# new_feature_HBonding_Ratio
# Ratio of nHDon_plus_nO to SpMax_L to capture hydrogen-bonding capacity relative to molecular complexity.
# Usefulness: Links bonding potential to molecular eigenvalues for nuanced assessment of biodegradability contributions.
df['new_feature_HBonding_Ratio'] = df['nHDon_plus_nO'] / df['SpMax_L']
end

python
# new_feature_Spectral_Burden_Log
# Interaction of SpPosA_B(p) with log-transformed SdO to capture joint effects of polarizability and donor E-state contributions.
# Usefulness: Combines spectral metrics with bonding properties, providing a composite feature affecting degradability.
df['new_feature_Spectral_Burden_Log'] = df['SpPosA_B(p)'] * df['log_SdO']
end

python
# new_feature_C_O_Sqrt_Ratio
# Square root transformation of C_O_ratio for reduced skewness and better representation of relative carbon-oxygen proportions.
# Usefulness: Diminishing outlier influence emphasizes balanced carbon-oxygen ratios important for chemical reactivity.
df['new_feature_C_O_Sqrt_Ratio'] = df['C_O_ratio']  0.5
end

python
# new_feature_LOG_HBond_Aggregate
# Log-transformed nHDon_plus_nO to capture aggregate hydrogen-bond contributions while compressing extreme values.
# Usefulness: Stabilizes variance in data, allowing downstream models to better capture underlying relationships.
df['new_feature_LOG_HBond_Aggregate'] = np.log1p(df['nHDon_plus_nO'])
end

python
# new_feature_SdO_per_O_Scaled
# Scaled ratio of SdO to nO (if nO > 0), focusing on donor atom effects relative to molecular oxygen content.
# Usefulness: Reflects the efficiency of donor E-states presence in structures containing oxygen atoms.
df['new_feature_SdO_per_O_Scaled'] = np.where(df['nO'] > 0, df['SdO'] / df['nO'], 0)
end

python
# new_feature_LOG_SdO_Relative_LOC
# Log-transformed ratio of SdO plus 1 to LOC, emphasizing donor atom network effects relative to molecular topology.
# Usefulness: Highlights the relationship between donor E-state contributions and structural compactness.
df['new_feature_LOG_SdO_Relative_LOC'] = np.log1p(df['SdO']) / (df['LOC'] + 1e-9)
end

python
# new_feature_structural_topo_sum
# Sum of F02[C-N], F03[C-N], and F04[C-N] to compute an overall structural topology value.
# Usefulness: Aggregates C-N bonding information across multiple topological distances for a complete view on nitrogen contributions.
df['new_feature_structural_topo_sum'] = df['F02[C-N]'] + df['F03[C-N]'] + df['F04[C-N]']
end

python
# new_feature_sigmoid_Connectivity
# Sigmoid-transformed Psi_i_1d to capture nonlinear dependency in connectivity index.
# Usefulness: Converts a continuous feature to a bounded range, facilitating efficient machine learning model training.
df['new_feature_sigmoid_Connectivity'] = 1 / (1 + np.exp(-df['Psi_i_1d']))
end

python
# Drop unused/less-relevant original features
df.drop(columns=['SpMax_L', 'SpPosA_B(p)', 'nHDon_plus_nO', 'C_O_ratio', 'SdO', 'LOC', 'F02[C-N]', 'F03[C-N]', 'F04[C-N]', 'Psi_i_1d'], inplace=True)
end
