end

python
# sqrt_SdO_per_nO
# Square root of the ratio of donor atom E-states to the number of oxygen atoms.
# Usefulness: Reduces range and emphasizes smaller values influencing oxygen-related biodegradability trends.
df['sqrt_SdO_per_nO'] = np.sqrt(df['SdO_per_nO'])
end

python
# SpMax_L_div_SM6_L
# Ratio of the leading eigenvalue from the Laplace matrix to the spectral moment of order 6.
# Usefulness: Provides a measure of the relationship between different molecular topology metrics.
df['SpMax_L_div_SM6_L'] = df['SpMax_L'] / df['SM6_L']
end

python
# log_nHDon_log_nO_ratio
# Ratio of log-transformed number of hydrogen donors to log-transformed number of oxygen atoms.
# Usefulness: Explores the balance between donor atoms to oxygen atoms, capturing logarithmic-scaled interaction effects.
df['log_nHDon_log_nO_ratio'] = np.log(df['nHDon'] + 1) / np.log(df['nO'] + 1)
end

python
# sigmoid_zscore_TI2_L
# Sigmoid transformation of the Z-score normalized second Mohar index.
# Usefulness: Introduces nonlinearity, enhancing the interpretability of molecular topology on classification tasks.
df['sigmoid_zscore_TI2_L'] = 1 / (1 + np.exp(-df['zscore_TI2_L']))
end

python
