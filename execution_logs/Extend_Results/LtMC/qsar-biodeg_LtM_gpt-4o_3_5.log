# C_O_ratio
# Ratio of carbon atoms (C%) to oxygen atoms (nO) to reflect molecular reactivity influenced by carbon-to-oxygen proportions.
# Usefulness: Indicates the balance of an essential atomic composition influencing biodegradability potential.
df['C_O_ratio'] = df['C%'] / (df['nO'] + 1e-6)
end

python
# log_SdO
# Log transformation of SdO to compress its range and emphasize smaller values impacting donor interactions for electronegative atoms.
# Usefulness: Helps model precision by softening extreme values, optimizing biodegradability observation.
df['log_SdO'] = np.log(df['SdO'] + 1e-6)
end

python
# sqrt_SM6_L
# Square root transformation of spectral moment of order 6 from Laplace matrix (SM6_L).
# Usefulness: Smoothens spread for better connectivity interpretability, relevant to structural stability and biodegradability.
df['sqrt_SM6_L'] = np.sqrt(df['SM6_L'])
end

python
# zscore_SpMax_L
# Z-score normalization of SpMax_L, leading eigenvalue from Laplace matrix.
# Usefulness: Standardizes key connectivity features for proportional contribution influence.
df['zscore_SpMax_L'] = (df['SpMax_L'] - df['SpMax_L'].mean()) / df['SpMax_L'].std()
end

python
# nHDon_plus_nO
# Aggregate of donor atoms (nHDon) and oxygen atoms (nO), emphasizing hydrogen-bond and electronegative capability.
# Usefulness: Simple composition summarization vital for biodegradability predictions due to chemical interactions.
df['nHDon_plus_nO'] = df['nHDon'] + df['nO']
end

python
# interaction_SpMax_L_TI2_L
# Interaction term combining SpMax_L and TI2_L to represent more complex molecular connectivity properties.
# Usefulness: Captures interplay between Laplace matrix connectivity and Mohar index stability for molecular degradation.
df['interaction_SpMax_L_TI2_L'] = df['SpMax_L'] * df['TI2_L']
end

python
