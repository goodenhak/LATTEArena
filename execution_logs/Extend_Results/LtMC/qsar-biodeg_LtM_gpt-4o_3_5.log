r decision boundaries.\ndf[sigmoid_Psi_i_1d] = 1 / (1 + np.exp(-df[Psi_i_1d]))', '# SdO_per_nO\n# Ratio of donor atom E-states to the number of oxygen atoms\n# Usefulness: Reflects the efficiency of donor atoms based on oxygen atom count, key for understanding molecular bonding capabilities.\ndf[SdO_per_nO] = df[SdO] / df[nO]', '# LOC_div_Me\n# Lopping centric index divided by mean atomic Sanderson electronegativity\n# Usefulness: Combines structural centricity with atomic electronegativity to provide insights into molecular stability and reactivity.\ndf[LOC_div_Me] = df[LOC] / df[Me]', '# log_SdO\n# Log-transformed SdO to compress range and emphasize smaller values impacting donor interactions\n# Usefulness: Helps stabilize skewness in SdO distributions and highlights the impact of small values critical to molecular bonding.\ndf[log_SdO] = np.log(df[SdO] + 1)', '# bin_nArNO2\n# Binned indicator for the presence of aromatic nitro groups\n# Usefulness: Provides an interpretable, categorical feature representing the presence/absence of an important structural group.\ndf[bin_nArNO2] = (df[nArNO2] > 0).astype(int)']
