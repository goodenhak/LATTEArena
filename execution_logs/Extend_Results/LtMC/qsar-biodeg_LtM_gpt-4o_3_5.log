2026-05-26 01:55:11,340 - INFO - ops_string = ["# log_C_O_ratio\n# Log transformation of C_O_ratio to reduce skew and emphasize moderate carbon-to-oxygen reactivity ratios.\n# Usefulness: Compresses the large range of C_O_ratio values, making patterns in biodegradability more evident.\ndf['log_C_O_ratio'] = df['C_O_ratio'].apply(lambda x: np.log(x + 1))", "# sqrt_nHDon_plus_nO\n# Square root transformation of nHDon_plus_nO to diminish extreme values and enhance representation of hydrogen-bond donor and oxygen atom interactions.\n# Usefulness: Reduces impact of outliers while capturing finer variations in aggregated donor and oxygen atom values related to biodegradability.\ndf['sqrt_nHDon_plus_nO'] = df['nHDon_plus_nO'].apply(np.sqrt)", "# SpPosA_B_p_times_log_SdO\n# Interaction between normalized spectral Burden matrix measure and log-transformed donor atom E-state sum, emphasizing combined molecular features influencing degradability.\n# Usefulness: Captures joint effects of spectral measures and electronegativity-related donor interactions on biodegradability behavior.\ndf['SpPosA_B_p_times_log_SdO'] = df['SpPosA_B(p)'] * df['log_SdO']", "# nCp_squared\n# Square of terminal primary C(sp3) atoms to capture nonlinear effects of structural flexibility impacting degradation.\n# Usefulness: Models potential quadratic relationships between structural flexibility and readiness of biodegradation in chemicals.\ndf['nCp_squared'] = df['nCp']  2", "# SdssC_div_C_O_ratio\n# Ratio of SdssC (sum of electronic structure states) to the carbon-to-oxygen ratio, capturing electronic state influences relative to molecular reactivity proportions.\n# Usefulness: Highlights interaction between electronic structure and molecular reactivity as factors contributing to chemical biodegradability.\ndf['SdssC_div_C_O_ratio'] = df['SdssC'] / (df['C_O_ratio'] + 1)", "# log_SdO_plus_1\n# Log transformation of SdO + 1 to stabilize variance and compress extreme sum of donor atom E-state values.\n# Usefulness: Removes numerical instability and reduces outlier effects in biodegradability-related electronegativity characteristics.\ndf['log_SdO_plus_1'] = df['SdO'].apply(lambda x: np.log(x + 1))", "# Psi_i_A_sigmoid\n# Sigmoid transformation of Psi_i_A (intrinsic pseudoconnectivity index) to capture nonlinear trends in molecular connectivity.\n# Usefulness: Effective representation of biochemical reactivity influenced by molecular connectivity across varying scales.\ndf['Psi_i_A_sigmoid'] = df['Psi_i_A'].apply(lambda x: 1 / (1 + np.exp(-x)))", "# bin_C_O_ratio\n# Binning C_O_ratio into discrete categories for threshold analysis of biodegradability-related carbon-oxygen reactivity proportions.\n# Usefulness: Simplifies analysis by categorizing extended C_O_ratio values into groups, helping delineate roles in biodegradation readiness.\ndf['bin_C_O_ratio'] = pd.qcut(df['C_O_ratio'], q=4, labels=False)", "# zscore_TI2_L\n# Z-score normalization of TI2_L (second Mohar index) to standardize molecular topology metrics across samples.\n# Usefulness: Eliminates scale variance in molecular topology measures, enabling clearer comparison and patterns for prediction tasks.\ndf['zscore_TI2_L'] = (df['TI2_L'] - df['TI2_L'].mean()) / df['TI2_L'].std()", "df.drop(columns=['carbon_hydrogen_ratio'], inplace=True)", "df.drop(columns=['F01[N-N]'], inplace=True)"]
