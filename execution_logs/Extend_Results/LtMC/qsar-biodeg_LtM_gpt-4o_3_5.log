# log_nHDon_plus_nO_plus_1
# Log-transformed aggregate of donor atoms and oxygen atoms to compress skewed distributions
# Usefulness: It helps stabilize variance and emphasize smaller values impacting hydrogen-bonding or oxygen atom interactions.
df[log_nHDon_plus_nO_plus_1] = np.log1p(df[nHDon] + df[nO])
end

python
# sqrt_C_O_ratio
# Square root transformation of carbon-to-oxygen ratio
# Usefulness: Diminishes outliers in the carbon-to-oxygen proportions, providing a clearer picture of molecular reactivity trends.
df[sqrt_C_O_ratio] = np.sqrt(df[C_O_ratio])
end

python
# log_SdO_plus_1_div_LOC
# Ratio of log-transformed donor atom E-state sum (plus 1) to the lopping centric index
# Usefulness: Highlights donor activity normalized by molecular centricity, offering insight into structural stability and potential biodegradability.
df[log_SdO_plus_1_div_LOC] = np.log1p(df[SdO]) / df[LOC]
end

python
# SpPosA_B_p_times_log_SdO
# Interaction between spectral Burden matrix measure and log of donor atom E-states
# Usefulness: Captures intricate interactions affecting molecular features and biodegradability patterns.
df[SpPosA_B_p_times_log_SdO] = df[SpPosA_B(p)] * np.log(df[SdO] + 1)
end

python
# zscore_TI2_L
# Z-score normalization of TI2_L (second Mohar index)
# Usefulness: Standardizes molecular topology metrics across samples, making them scale-independent and comparable.
df[zscore_TI2_L] = (df[TI2_L] - df[TI2_L].mean()) / df[TI2_L].std()
end

python
# nHDon_plus_nO_div_SpMax_L
# Hydrogen-bonding capacity relative to molecular complexity
# Usefulness: Normalizes aggregate features for donor atoms (nHDon + nO) by molecular complexity, revealing proportional contributions to biodegradability.
df[nHDon_plus_nO_div_SpMax_L] = (df[nHDon] + df[nO]) / df[SpMax_L]
end

python
# sigmoid_Psi_i_1d
# Sigmoid-transformed intrinsic pseudoconnectivity index
# Usefulness: Captures nonlinear variations in molecular connectivity within bounded ranges, aiding precision for decision boundaries.
df[sigmoid_Psi_i_1d] = 1 / (1 + np.exp(-df[Psi_i_1d]))
end

python
# SdO_per_nO
# Ratio of donor atom E-states to the number of oxygen atoms
# Usefulness: Reflects the efficiency of donor atoms based on oxygen atom count, key for understanding molecular bonding capabilities.
df[SdO_per_nO] = df[SdO] / df[nO]
end

python
# LOC_div_Me
# Lopping centric index divided by mean atomic Sanderson electronegativity
# Usefulness: Combines structural centricity with atomic electronegativity to provide insights into molecular stability and reactivity.
df[LOC_div_Me] = df[LOC] / df[Me]
end

python
# log_SdO
# Log-transformed SdO to compress range and emphasize smaller values impacting donor interactions
# Usefulness: Helps stabilize skewness in SdO distributions and highlights the impact of small values critical to molecular bonding.
df[log_SdO] = np.log(df[SdO] + 1)
end

python
