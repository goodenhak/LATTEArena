# log_nHDon_plus_nO_plus_1
# Log-transformed aggregate of donor atoms and oxygen atoms, compressing skewed distributions and emphasizing their interactions in biodegradability.
# Usefulness: Reduces skewness and highlights the significance of hydrogen bonds and oxygen in chemical reactivity and biodegradability.
df['log_nHDon_plus_nO_plus_1'] = np.log(df['nHDon_plus_nO'] + 1)
end

python
# sqrt_C_O_ratio
# Square root transformation of the carbon-to-oxygen ratio, emphasizing the role of this proportion in determining reactivity.
# Usefulness: This feature reduces extreme values, allowing better numerical handling while maintaining the emphasis on reactivity influenced by carbon-oxygen balance.
df['sqrt_C_O_ratio'] = np.sqrt(df['C_O_ratio'])
end

python
# log_SdO_plus_1_div_LOC
# Ratio of log-transformed donor atom E-states (plus one) to the lopping centric index, emphasizing donor contributions relative to molecular branching.
# Usefulness: Highlights donor atom contributions in complex molecular structures, which is important for biodegradability.
df['log_SdO_plus_1_div_LOC'] = df['log_SdO_plus_1'] / (df['LOC'] + 1e-8)  # Adding small value for numerical stability.
end

python
# nHDon_plus_nO_div_SpMax_L
# Ratio of hydrogen-bonding capacity (aggregate donor atoms and oxygen) to molecular complexity (SpMax_L).
# Usefulness: Quantifies the biodegradation capability by balancing bonding capacity with molecular complexity.
df['nHDon_plus_nO_div_SpMax_L'] = df['nHDon_plus_nO'] / (df['SpMax_L'] + 1e-8)
end

python
# SpMax_L_squared
# Square of SpMax_L, capturing non-linear effects of molecular complexity on biodegradability.
# Usefulness: Features non-linear relationships between molecular complexity and degradability.
df['SpMax_L_squared'] = df['SpMax_L']  2
end

python
# sigmoid_Psi_i_1d
# Sigmoid transformation of intrinsic pseudoconnectivity index - type 1d.
# Usefulness: Captures and standardizes non-linear trends in molecular connectivity, an important factor in biodegradability.
df['sigmoid_Psi_i_1d'] = 1 / (1 + np.exp(-df['Psi_i_1d']))
end

python
# LOC_div_Me
# Ratio of lopping centric index (LOC) to mean atomic Sanderson electronegativity (Me).
# Usefulness: Highlights the interplay between molecular branching and electronegativity in influencing biodegradability.
df['LOC_div_Me'] = df['LOC'] / (df['Me'] + 1e-8)
end

python
# Interaction_LOC_nHDon_plus_nO
# Interaction term between LOC and nHDon_plus_nO to capture relational trends between structure and bond interactions.
# Usefulness: Models joint contributions of molecular structure and bonding capacity relevant to degradation.
df['Interaction_LOC_nHDon_plus_nO'] = df['LOC'] * df['nHDon_plus_nO']
end

python
# bin_C_O_ratio_category
# Binned discrete categories from continuous C_O_ratio.
# Usefulness: Simplifies highly skewed C_O_ratio into more interpretable bins while preserving important biodegradability signals.
df['bin_C_O_ratio_category'] = pd.cut(df['C_O_ratio'], bins=[-np.inf, 10, 100, np.inf], labels=[0, 1, 2]).astype(float)
end

python
# bin_nArNO2
# Binary indicator for the presence of aromatic nitro groups.
# Usefulness: Adds a strong binary signal denoting the presence of nitro groups critical for biodegradability.
df['bin_nArNO2'] = (df['nArNO2'] > 0).astype(float)
end

python
# Dropping redundant or less meaningful features based on advanced feature selection.
df.drop(columns=['C_O_ratio', 'Psi_i_1d', 'nHDon_plus_nO'], inplace=True)
end
