# aggregate_local_effort\n# Aggregated effort density for nearby modules (rolling_mean(effort_density), window=3)\n# Usefulness: Smoothens out noise and highlights high-effort clusters contributing to defects.\ndf['aggregate_local_effort'] = df['effort_density'].rolling(window=3, min_periods=1).mean()", "# drop_columns\n# Drops insignificant, redundant, or overly correlated columns that hinder model generalization.\ndf.drop(columns=['redundancy_per_operator', 'b', 'normalized_effort_by_volume', 'total_Op', 'branch_to_size_ratio'], inplace=True)"]
