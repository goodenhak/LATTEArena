# log_loc
# Logarithmic transformation of lines of code (loc).
# Usefulness: Normalizes skewed distributions of loc to better capture patterns across modules of varying sizes.
df['log_loc'] = np.log(df['loc'] + 1)
end

python
# log_v
# Logarithmic transformation of Halstead 'volume' (v).
# Usefulness: Addresses skewness in the distribution of Halstead volume to ensure comparability across samples.
df['log_v'] = np.log(df['v'] + 1)
end

python
# log_effort
# Logarithmic scaling of Halstead effort (e).
# Usefulness: Reduces the extremely wide range of effort values and emphasizes relative differences in smaller scales.
df['log_effort'] = np.log(df['e'] + 1)
end

python
# cg_to_size_ratio
# Cyclomatic complexity per line of code (v(g) / loc).
# Usefulness: Highlights modules with disproportionately high complexity relative to their size, which may indicate defect-prone patterns.
df['cg_to_size_ratio'] = df['v(g)'] / (df['loc'] + 1e-10)
end

python
# branch_to_size_ratio
# Ratio of branchCount to lines of code (branchCount / loc).
# Usefulness: Captures density of decision points relative to the module’s size, an indicator of potential defects arising from logical complexity.
df['branch_to_size_ratio'] = df['branchCount'] / (df['loc'] + 1e-10)
end

python
# effort_density
# Effort per unit complexity and size (e / (loc * v(g))).
# Usefulness: Reflects how efficiently effort scales with complexity and size, helping identify modules requiring disproportionate effort.
df['effort_density'] = df['e'] / ((df['loc'] * df['v(g)']) + 1e-10)
end

python
# normalized_effort_by_volume
# Halstead effort per unit volume (e / v).
# Usefulness: Highlights code with excessive effort requirements per unit of functional volume, which can point to maintainability issues.
df['normalized_effort_by_volume'] = df['e'] / (df['v'] + 1e-10)
end

python
# redundancy_indicator
# Indicator of operator/operand redundancy (1 - (uniq_Op + uniq_Opnd) / n).
# Usefulness: Quantifies the redundancy in code by comparing unique and overall occurrences of operators and operands, associated with maintainability.
df['redundancy_indicator'] = 1 - ((df['uniq_Op'] + df['uniq_Opnd']) / (df['n'] + 1e-10))
end

python
# v_g_scaled_by_difficulty
# Cyclomatic complexity scaled by Halstead difficulty (v(g) * d).
# Usefulness: Combines two important indicators of code complexity to emphasize how structural and logical complexity interact.
df['v_g_scaled_by_difficulty'] = df['v(g)'] * df['d']
end

python
# density_complexity
# Complexity density reflecting how cyclomatic complexity scales with combined code size (v(g) / (loc + lOCode)).
# Usefulness: Integrates structural complexity relative to total code and comment lines, capturing control flow density.
df['density_complexity'] = df['v(g)'] / ((df['loc'] + df['lOCode']) + 1e-10)
end

python
# code_effort_alignment
# Code effort alignment score (e / loc_code_and_comment).
# Usefulness: Indicates the alignment of effort required for a module relative to its overall size (code and comments).
df['code_effort_alignment'] = df['e'] / ((df['loc'] + df['lOCode'] + df['lOComment']) + 1e-10)
end

python
# effective_volume_per_line
# Effective Halstead volume per line of code (v / loc).
# Usefulness: Highlights the computational work embedded per line of code, indirectly indicating complexity intensity.
df['effective_volume_per_line'] = df['v'] / (df['loc'] + 1e-10)
end

python
# threshold_complexity_flag
# Binary flag indicating high cyclomatic complexity (v(g) > 10).
# Usefulness: Identifies thresholds for high-complexity modules, aiding in detecting extreme cases related to defects.
df['threshold_complexity_flag'] = (df['v(g)'] > 10).astype(int)
end

python
df.drop(columns=['complexity_per_uniq_operator', 'loc_effort_ratio'], inplace=True)
end
