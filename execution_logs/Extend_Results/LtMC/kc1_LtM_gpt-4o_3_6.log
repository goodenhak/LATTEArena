# cyclomatic_complexity_density
# Cyclomatic complexity density reflecting complexity as a proportion of total code and comments.
# Usefulness: Provides a normalized view of complexity adjusted to overall size, aiding in identifying modules with disproportionately high complexity.
df['cyclomatic_complexity_density'] = df['v(g)'] / df['loc_code_and_comment']
end

python
# log_total_ops_and_opnds
# Logarithmic transformation of sum of total operators and operands.
# Usefulness: Mitigates skewness in the distribution of total operators + operands, which is crucial for high-size modules.
df['log_total_ops_and_opnds'] = np.log1p(df['aggregate_total_ops_and_opnds'])
end

python
# branch_complexity_per_line
# Measure of branch complexity per line of code.
# Usefulness: Highlights modules with disproportionately high branch complexity relative to their size, a common defect factor.
df['branch_complexity_per_line'] = df['branchCount'] / df['loc']
end

python
# adjusted_effort_density
# Effort density adjusted for normalized volume and cyclomatic complexity.
# Usefulness: Identifies high-effort modules factoring size and essential complexity, which increases defect probabilities.
df['adjusted_effort_density'] = df['e'] / (df['v'] * df['v(g)'])
end

python
# redundancy_per_operator
# Redundancy per unique operator, reflecting redundancy level across unique operators.
# Usefulness: Captures operator-specific inefficiencies, potentially correlating with bugs in code logic.
df['redundancy_per_operator'] = df['redundancy_indicator'] / df['uniq_Op']
end

python
# sqrt_loc_scaled_by_branch
# Square root transformation of loc divided by branch count.
# Usefulness: Normalizes and highlights code size impact relative to structural branching, mitigating imbalance in long or complex modules.
df['sqrt_loc_scaled_by_branch'] = np.sqrt(df['loc'] / df['branchCount'])
end

python
# critical_complexity_ratio
# Proportion of cyclomatic complexity flagged as high to total complexity.
# Usefulness: Focuses on identifying subsets of complexity exceeding standard thresholds, strongly associated with defects.
df['critical_complexity_ratio'] = df['threshold_complexity_flag'] / df['v(g)']
end

python
# sustained_effort_scaled
# Effort scaled by redundancy and operator density to reflect long-term maintainability challenges.
# Usefulness: Helps identify modules where redundant or complex coding styles lead to excessive long-term maintenance efforts.
df['sustained_effort_scaled'] = df['e'] * df['redundancy_indicator'] / (df['uniq_Op'] + df['uniq_Opnd'])
end

python
# normalized_complexity_entropy
# Normalized complexity using unique operators and operands entropy.
# Usefulness: Quantifies the diversity in operator and operand usage, tied to maintainability and error-proneness.
df['normalized_complexity_entropy'] = df['v(g)'] / (df['uniq_Op'] * df['uniq_Opnd'])
end

python
# drop ineffective columns
# Remove columns that are highly correlated or provide no new useful information based on previous analysis.
df.drop(columns=['complexity_per_uniq_operator', 'loc_effort_ratio'], inplace=True)
end
