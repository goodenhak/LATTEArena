2026-05-26 01:29:32,515 - INFO - ops_string = ["# v_g_times_v (Cyclomatic Complexity * Halstead Volume)\n# Interaction between complexity and code volume. \n# Usefulness: Highlights joint impact of control flow complexity and size on defect occurrence.\ndf['v_g_times_v'] = df['v(g)'] * df['v']", "# e_times_d (Effort * Difficulty)\n# Interaction between mental effort and cognitive difficulty.\n# Usefulness: Captures the combined effects of effort and complexity, often correlating with defect-prone code.\ndf['e_times_d'] = df['e'] * df['d']", "# branchCount_by_d (Branch Count / Difficulty)\n# Scaling branch count by Halstead difficulty.\n# Usefulness: Highlights branching complexity in areas of higher cognitive difficulty, mapping to potential defect-prone hotspots.\ndf['branchCount_by_d'] = df['branchCount'] / df['d'].replace(0, np.nan)", "# v_by_loc (Volume / Lines of Code)\n# Ratio of Halstead volume to lines of code.\n# Usefulness: Measures density of the implementation, linking complexity to the size of code.\ndf['v_by_loc'] = df['v'] / df['loc'].replace(0, np.nan)", "# e_by_branchCount (Effort / Branch Count)\n# Effort per branch within the control flow.\n# Usefulness: Reflects the workload associated with control structures in the code.\ndf['e_by_branchCount'] = df['e'] / df['branchCount'].replace(0, np.nan)", "# v_g_by_loc (Cyclomatic Complexity / Lines of Code)\n# Ratio of cyclomatic complexity to lines of code.\n# Usefulness: Indicates complexity density in the code, essential for maintaining software quality.\ndf['v_g_by_loc'] = df['v(g)'] / df['loc'].replace(0, np.nan)", "# log_e (Log of Effort)\n# Logarithmic transform of Halstead effort.\n# Usefulness: Reduces the skew of effort values for better learning and interpretation.\ndf['log_e'] = np.log1p(df['e'])", "# zscore_v_g (Z-Score Normalization of Cyclomatic Complexity)\n# Z-score normalization of cyclomatic complexity.\n# Usefulness: Highlights relative deviations in control flow complexity.\ndf['zscore_v_g'] = (df['v(g)'] - df['v(g)'].mean()) / df['v(g)'].std()", "# zscore_loc (Z-Score Normalization of Lines of Code)\n# Z-score normalization of lines of code.\n# Usefulness: Indicates outliers or significant deviations in code size, correlated with defect risks.\n# Already present in the dataset; ensures proper handling.\ndf['zscore_loc'] = (df['loc'] - df['loc'].mean()) / df['loc'].std()", "# rolling_mean_effort_density (Rolling Mean of Effort Density)\n# Rolling mean of effort density over a window of size 5.\n# Usefulness: Captures temporal trends in effort density, potentially highlighting defect-prone regions dynamically.\ndf['rolling_mean_effort_density'] = df['effort_density'].rolling(window=5, min_periods=1).mean()", "# bin_redundancy_indicator (Binned Redundancy Indicator)\n# Categorical binning for redundancy_indicator into low, medium, and high.\n# Usefulness: Groups redundancy into discrete interpretable bins for qualitative defect analysis.\ndf['bin_redundancy_indicator'] = pd.cut(df['redundancy_indicator'], bins=[-1, 0.3, 0.6, 1], labels=['low', 'medium', 'high'])", "# mean_branch_size (Mean Branch Size)\n# Mean branch size calculated as lines of code divided by branch count.\n# Usefulness: Indicates the average size of logical branches, relevant to defect-proneness.\ndf['mean_branch_size'] = df['loc'] / df['branchCount'].replace(0, np.nan)", "# drop_column_redundancy_per_operator\n# Dropping redundancy_per_operator due to infinite values, making it non-usable for modeling.\ndf.drop(columns=['redundancy_per_operator'], inplace=True)", "# drop_column_critical_complexity_ratio\n# Removing critical_complexity_ratio due to its near-zero variance across the dataset, providing limited utility.\ndf.drop(columns=['critical_complexity_ratio'], inplace=True)"]
