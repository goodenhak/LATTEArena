# log_v
# Logarithm of Halstead 'volume' (v)
# Usefulness: Reduces skewness in the volume and highlights its relative contribution to defects.
df['log_v'] = np.log1p(df['v'])
end

python
# log_effort
# Logarithm of Halstead 'effort' (e)
# Usefulness: Accounts for the exponential growth in effort needed for complex modules, providing better scalability insights.
df['log_effort'] = np.log1p(df['e'])
end

python
# log_loc
# Logarithm of lines of code (loc)
# Usefulness: Reduces the skew in loc, helping to capture the impact of size on defect likelihood in a normalized manner.
df['log_loc'] = np.log1p(df['loc'])
end

python
# effort_to_complexity_ratio
# Ratio of normalized effort to cyclomatic complexity (e / v(g))
# Usefulness: Highlights efficiency or strain characterized by effort spent per unit of complexity.
df['effort_to_complexity_ratio'] = df['e'] / (df['v(g)'] + 1e-10)
end

python
# relative_effort_density
# Relative scaled effort density (effort_density / Mean effort density)
# Usefulness: Provides a comparative measure for modules with unusually high defect-prone characteristics based on effort scaling.
df['relative_effort_density'] = df['effort_density'] / df['effort_density'].mean()
end

python
# v_per_line
# Halstead Volume per line of code (v / loc)
# Usefulness: Consolidates size and complexity into a single measure to identify dense modules prone to defects.
df['v_per_line'] = df['v'] / (df['loc'] + 1e-10)
end

python
# branch_effort_ratio
# Ratio of effort scaled by branch count (effort_scaled_by_branches / branchCount)
# Usefulness: Quantifies effort contributions per branching logic in the control flow to identify hotspots.
df['branch_effort_ratio'] = df['effort_scaled_by_branches'] / (df['branchCount'] + 1e-10)
end

python
# redundancy_complexity_interaction
# Interactive effect of redundancy and complexity (redundancy_indicator * v(g))
# Usefulness: Highlights modules with redundant and complex sections which are difficult to maintain and prone to defects.
df['redundancy_complexity_interaction'] = df['redundancy_indicator'] * df['v(g)']
end

python
# avg_branch_density
# Average density of branching logic across code length (branchCount / loc_code_and_comment)
# Usefulness: Captures the distribution of branching within documented and coded logic for identifying control flow defects.
df['avg_branch_density'] = df['branchCount'] / (df['loc_code_and_comment'] + 1e-10)
end

python
# effort_complexity_flag
# Binary flag for high threshold of effort and complexity ((e > 90th percentile) & (threshold_complexity_flag == 1))
# Usefulness: Flags extreme effort-complexity combinations which are highly prone to software defects.
effort_threshold = df['e'].quantile(0.9)
df['effort_complexity_flag'] = ((df['e'] > effort_threshold) & (df['threshold_complexity_flag'] == 1)).astype(int)
end

python
# standardized_complexity
# Z-score normalization of cyclomatic complexity (v(g))
# Usefulness: Allows comparison of relative complexity across modules and identifies unusually complex code patterns.
df['standardized_complexity'] = (df['v(g)'] - df['v(g)'].mean()) / (df['v(g)'].std() + 1e-10)
end

python
# effort_vs_maintainability
# Effort scaled by long-term maintainability challenges (e / sustained_effort_scaled)
# Usefulness: Narrows down maintainability bottlenecks that draw disproportionately high effort.
df['effort_vs_maintainability'] = df['e'] / (df['sustained_effort_scaled'] + 1e-10)
end

python
# loc_scaled_complexity
# Interaction of scaled lines of code and complexity (loc * v(g))
# Usefulness: Encapsulates size-scaled complexity to emphasize defect-prone large and complex code sections.
df['loc_scaled_complexity'] = df['loc'] * df['v(g)']
end

python
# high_operational_redundancy
# Binary flag for redundancy exceeding threshold (redundancy_indicator > 0.75)
# Usefulness: Highlights modules with excessive operational redundancy contributing to defect risks.
df['high_operational_redundancy'] = (df['redundancy_indicator'] > 0.75).astype(int)
end

python
# aggregate_local_effort
# Aggregated effort density for nearby modules (rolling_mean(effort_density), window=3)
# Usefulness: Smoothens out noise and highlights high-effort clusters contributing to defects.
df['aggregate_local_effort'] = df['effort_density'].rolling(window=3, min_periods=1).mean()
end

python
# drop_columns
# Drops insignificant, redundant, or overly correlated columns that hinder model generalization.
df.drop(columns=['redundancy_per_operator', 'b', 'normalized_effort_by_volume', 'total_Op', 'branch_to_size_ratio'], inplace=True)
end
