# effort_complexity_ratio
# Effort per cyclomatic complexity unit (e / v(g)).
# Usefulness: Cyclomatic complexity is a strong indicator of structural complexity; scaling effort helps capture effort-intensive modules prone to defects.
df['effort_complexity_ratio'] = df['e'] / df['v(g)']
end

python
# complexity_size_ratio
# Lines of code per unit of cyclomatic complexity (loc / v(g)).
# Usefulness: Modules with high size-to-complexity ratios may reveal highly factorable designs or excessive boilerplate, potentially linked to defects.
df['complexity_size_ratio'] = df['loc'] / df['v(g)']
end

python
# normalized_volume_ratio
# Relative volume per scaling factor (v / loc_scaled_by_volume).
# Usefulness: Exposes patterns in scaling inefficiencies by comparing Halstead volume to volume-scaled LOC.
df['normalized_volume_ratio'] = df['v'] / df['loc_scaled_by_volume']
end

python
# log_effort_density
# Logarithmic transformation of effort_density to capture nonlinear scaling effects (log(effort_density)).
# Usefulness: Effort density provides key insight into coding intensity; log transforms allow better regression performance for skewed data.
df['log_effort_density'] = np.log(df['effort_density'] + 1)
end

python
# redundancy_ratio
# Average ratio of unique operands and operators to total operands and operators ((uniq_opnd_to_total_opnd_ratio + uniq_op_to_total_op_ratio) / 2).
# Usefulness: Provides aggregate redundancy insight, key for identifying potential defect-related inefficiencies in operand/operator usage.
df['redundancy_ratio'] = (df['uniq_opnd_to_total_opnd_ratio'] + df['uniq_op_to_total_op_ratio']) / 2
end

python
# effort_adjusted_by_difficulty
# Halstead effort normalized by Halstead difficulty (e / d).
# Usefulness: Adjusting effort by difficulty offers insight into maintenance cost and likelihood of defects in modules deemed highly complex.
df['effort_adjusted_by_difficulty'] = df['e'] / df['d']
end

python
# volume_complexity_interaction
# Interaction between Halstead volume and cyclomatic complexity (v * v(g)).
# Usefulness: Combines cognitive load (volume) and structural complexity (complexity) to flag modules prone to faults.
df['volume_complexity_interaction'] = df['v'] * df['v(g)']
end

python
# code_alignment_indicator
# Code effort alignment multiplied by redundancy indicator, highlighting flawed execution patterns (code_effort_alignment * redundancy_indicator).
# Usefulness: Indicates modules that exhibit both coding inefficiency (alignment) and operational redundancy features, often linked to defects.
df['code_alignment_indicator'] = df['code_effort_alignment'] * df['redundancy_indicator']
end

python
# effective_operational_density
# Combined operator and operand density over lines of code ((total_Op + total_Opnd) / loc).
# Usefulness: Provides coverage of operational intensity, highlighting modules with dense interaction areas prone to logic defects.
df['effective_operational_density'] = (df['total_Op'] + df['total_Opnd']) / df['loc']
end

python
# t_scaled_by_effort
# Halstead time estimator scaled by effort (t / e).
# Usefulness: Represents time cost per effort unit, useful for determining inefficiently structured modules linked to high defect rates.
df['t_scaled_by_effort'] = df['t'] / (df['e'] + 1)
end

python
# adjusted_redundancy_impact
# Redundancy per operator scaled to adjusted effort density (redundancy_per_operator * adjusted_effort_density).
# Usefulness: Identifies whether redundancy correlates to modules with high defect-prone effort density, highlighting efficiency gaps.
df['adjusted_redundancy_impact'] = df['redundancy_per_operator'] * df['adjusted_effort_density']
end

python
# normalized_branch_ratio
# Logarithmic transformation of branch-to-size ratio for better scaling (log(branch_to_size_ratio)).
# Usefulness: Fundamental complexity of branches relative to module size reveals logic density gaps potentially linked to defects.
df['normalized_branch_ratio'] = np.log(df['branch_to_size_ratio'] + 1)
end

python
# scaled_essential_complexity
# Essential complexity adjusted by design complexity (ev(g) / iv(g)).
# Usefulness: Separates critical complexity elements tied to module defects by scaling core essential factors against design complexity baseline.
df['scaled_essential_complexity'] = df['ev(g)'] / (df['iv(g)'] + 1)
end

