# Usefulness: Reflects maintainability challenges as they relate to branching complexity.
df['sustained_effort_per_branch'] = df['sustained_effort_scaled'] / (df['branchCount'] + 1e-5)
end

python
# high_complexity_area
# Binary flag indicating regions with both high cyclomatic complexity (v(g) > 10) and large codebases (loc > Q3).
# Usefulness: Pinpoints parts of the codebase that pose significant risks in terms of complexity and maintainability effort.
df['high_complexity_area'] = ((df['threshold_complexity_flag'] == 1) & (df['loc'] > 41)).astype(int)
end

python
