# Usefulness: Combines volume and branch complexity, reflecting code expansiveness relative to control flow divisions.
df['log_v_scaled_by_branch'] = df['log_v'] / (df['branchCount'] + 1e-8)
end

python
# complexity_effort_interaction
# Interaction term combining cyclomatic complexity (v(g)) and Halstead effort (e), measuring joint difficulty.
# Usefulness: Highlights modules with both high logical complexity and high computational effort.
df['complexity_effort_interaction'] = df['v(g)'] * df['e']
end

python
# redundancy_complexity_ratio
# Ratio of redundancy indicator to cyclomatic complexity (redundancy_indicator / v(g)).
# Usefulness: Identifies inefficient code structures with high redundancy relative to complexity.
df['redundancy_complexity_ratio'] = df['redundancy_indicator'] / (df['v(g)'] + 1e-8)
end

python
# effort_log_complexity_ratio
# Normalized ratio of effort (log scale) to cyclomatic complexity (log_effort / (v(g) + 1)).
# Usefulness: Assesses the efficiency of code effort allocation relative to logical complexity.
df['effort_log_complexity_ratio'] = df['log_effort'] / (df['v(g)'] + 1)
end

python
# sustained_branches_effort
# Interaction of effort scaled for maintainability with branch count (sustained_effort_scaled * branchCount).
# Usefulness: Captures maintainability challenges amplified by structural branching decisions.
df['sustained_branches_effort'] = df['sustained_effort_scaled'] * df['branchCount']
end

python
# normed_volume_density
# Effective volume density by lines of code (effective_volume_per_line / loc).
# Usefulness: Normalizes code volume by size, emphasizing sections compact yet high in computation.
df['normed_volume_density'] = df['effective_volume_per_line'] / (df['loc'] + 1e-8)
end

python
# uniq_operand_operator_mix
# Interaction of unique operand and operator ratios (uniq_opnd_to_total_opnd_ratio * uniq_op_to_total_op_ratio).
# Usefulness: Balances operator uniqueness and operand diversity for code variability insights.
df['uniq_operand_operator_mix'] = df['uniq_opnd_to_total_opnd_ratio'] * df['uniq_op_to_total_op_ratio']
end

python
# avg_branch_effort
# Average effort distributed across branches (e / (branchCount + 1)).
# Usefulness: Highlights areas with disproportionate effort allocation in branching logic.
df['avg_branch_effort'] = df['e'] / (df['branchCount'] + 1)
end

python
# critical_normalized_complexity
# Product of critical complexity ratio and normalized cyclomatic complexity (critical_complexity_ratio * (v(g) / loc)).
# Usefulness: Promotes focus on critical sections of code complexity adjusted for size scaling.
df['critical_normalized_complexity'] = df['critical_complexity_ratio'] * (df['v(g)'] / (df['loc'] + 1e-8))
end

python
# scaled_log_effort_density
# Effort density scaled logarithmically by complexity (log_effort * effort_density).
# Usefulness: Models non-linear effort allocation focusing on density patterns.
df['scaled_log_effort_density'] = df['log_effort'] * df['effort_density']
end

python
# Drop irrelevant columns
df.drop(columns=['redundancy_per_operator', 'normed_effort_by_volume', 't', 'l', 'b'], inplace=True)
end
