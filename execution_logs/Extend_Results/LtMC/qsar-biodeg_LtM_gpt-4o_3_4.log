# oxygen_to_carbon_ratio
# Ratio of oxygen atoms to carbon percentage, highlighting the interaction between atomic composition and biodegradability.
# Usefulness: Oxygen is crucial for biodegradation, and its proportion relative to carbon provides insight into molecular reactivity.
df['oxygen_to_carbon_ratio'] = df['nO'] / (df['C%'] + 1e-5)
end

python
# nitrogen_to_carbon_ratio
# Ratio of nitrogen atoms to carbon percentage, emphasizing nitrogen's role in environmental degradation pathways.
# Usefulness: Nitrogen often appears in functional groups linked to biodegradation processes; its proportion to carbon is informative.
df['nitrogen_to_carbon_ratio'] = df['nN'] / (df['C%'] + 1e-5)
end

python
# terminal_carbon_ratio
# Ratio of terminal primary carbon (C(sp3)) to the number of heavy atoms, identifying structural end groups affecting stability.
# Usefulness: Molecular stability affected by terminal carbon configurations can influence biodegradation rates.
df['terminal_carbon_ratio'] = df['nCp'] / (df['nHM'] + 1e-5)
end

python
# oxygen_state_difference
# Difference between sum of dO E-states and sum of dssC E-states, contrasting oxygen and carbon-related molecular properties.
# Usefulness: Captures the relative reactivity driven by oxygen functionalities versus carbon bonding.
df['oxygen_state_difference'] = df['SdO'] - df['SdssC']
end

python
# electronegativity_ionization_gap
# Gap between mean atomic Sanderson electronegativity and the first ionization potential, showcasing molecular reactivity.
# Usefulness: Highlights interplay between an element's tendency to attract electrons and its ionization energy.
df['electronegativity_ionization_gap'] = df['Me'] - df['Mi']
end

python
# log_transformed_oxygen
# Log-transform of oxygen atom count, emphasizing molecules with increased oxygen presence in non-linear scales.
# Usefulness: Enhances representation of oxygen's contribution in cases of larger molecular diversity.
df['log_transformed_oxygen'] = np.log1p(df['nO'])
end

python
# exponential_wiener_laplace
# Exponential transformation of Hyper-Wiener index divided by Laplace spectral moment, emphasizing topology-based molecular features.
# Usefulness: Aids in discovering complex relationships between molecular connectivity and mass-weighted spectral properties.
df['exponential_wiener_laplace'] = np.exp(df['HyWi_B(m)'] / df['SM6_L'])
end

python
# sqrt_burden_polarizability
# Square root combination of Burden matrix spectral indices and polarizability weighted sums.
# Usefulness: Evaluates synergistic effects between mass and polarizability features for biodegradability prediction.
df['sqrt_burden_polarizability'] = np.sqrt(df['SpMax_B(m)'] * df['SpPosA_B(p)'])
end

python
# aggregated_CN_bond_frequency
# Sum of C-N bond frequencies at different topological distances.
# Usefulness: Combines connectivity insights across bond distances, reflecting molecule interactions prone to biodegradation.
df['aggregated_CN_bond_frequency'] = df['F02[C-N]'] + df['F03[C-N]'] + df['F04[C-N]']
end

python
# combined_functional_groups
# Sum of aromatic esters and nitro groups in the molecule.
# Usefulness: Functional groups like esters and nitro compounds are critical in determining reactivity and biodegradability.
df['combined_functional_groups'] = df['nArCOOR'] + df['nArNO2']
end

python
# spectral_connectivity_interaction
# Sum of spectral and connectivity indices, coupling Laplace and Burden matrix features.
# Usefulness: Reflects complex structural influence of molecular connectivity for predictive modeling.
df['spectral_connectivity_interaction'] = df['SpMax_L'] + df['SpMax_B(m)'] + df['Psi_i_A']
end

python
# oxygen_intensity_hbond_donor
# Product of sum of dO E-states and number of hydrogen bond donor atoms.
# Usefulness: Quantifies the interaction of oxygen states contributing to reactivity with H-bond donors.
df['oxygen_intensity_hbond_donor'] = df['SdO'] * df['nHDon']
end

python
# circuit_mass_interaction
# Product of number of circuits and spectral moment weighted by mass.
# Usefulness: Captures the interaction between molecular cycles and the mass-related structural properties.
df['circuit_mass_interaction'] = df['nCIR'] * df['SM6_B(m)']
end

python
# zscore_carbon_percentage
# Z-score normalization of carbon percentage.
# Usefulness: Standardized attribute that aids in meaningful comparisons across molecules.
df['zscore_carbon_percentage'] = (df['C%'] - df['C%'].mean()) / df['C%'].std()
end

python
# high_oxygen_indicator
# Binary indicator for molecules with high oxygen atom count.
# Usefulness: Highlights molecular patterns that strongly correlate with biodegradability driven by oxygen presence.
df['high_oxygen_indicator'] = (df['nO'] > 3).astype(int)
end

python
# high_oxygen_estate_indicator
# Binary indicator for molecules with high oxygen E-states.
# Usefulness: Identifies cases of high reactivity linked to oxygen functional contributions.
df['high_oxygen_estate_indicator'] = (df['SdO'] > df['SdO'].quantile(0.75)).astype(int)
end

python
# Drop redundant or less relevant columns
df.drop(columns=['F01[N-N]', 'SdssC', 'F03[C-N]', 'B01[C-Br]', 'B04[C-Br]', 'LOC'], inplace=True)
end
