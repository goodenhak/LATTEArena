# log_nO_nN_ratio_scaled
# Logarithmic and normalized ratio of oxygen to nitrogen atoms [log(nO_nN_ratio + 1)] scaled using min-max normalization.
# Usefulness: Combines the logarithmic transformation to handle skewness and min-max normalization to ensure the range is consistent for downstream tasks.
df['log_nO_nN_ratio_scaled'] = (df['log_nO_nN_ratio'] - df['log_nO_nN_ratio'].min()) / (df['log_nO_nN_ratio'].max() - df['log_nO_nN_ratio'].min())
end

python
# heteroatom_per_bond
# Ratio of heteroatom complexity to bond frequency sum (heteroatom_complexity / bond_frequency_sum). Represents how heterogeneous the molecule is concerning its bond density.
# Usefulness: Highlights the density of heteroatoms in relation to overall bonding, which is significant for structural complexity influencing biodegradability.
df['heteroatom_per_bond'] = df['heteroatom_complexity'] / (df['bond_frequency_sum'] + 1e-9)
end

