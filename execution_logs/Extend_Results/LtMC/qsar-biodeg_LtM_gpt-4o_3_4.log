# log_nO_nN_ratio
# Logarithm of the ratio of the number of oxygen to nitrogen atoms (log(nO_nN_ratio + 1)).
# Usefulness: Stabilizes the wide range of nO_nN_ratio values and highlights the logarithmic relationship often observed in chemical concentrations.
df['log_nO_nN_ratio'] = np.log1p(df['nO_nN_ratio'])
end

python
# ratio_O_N
# Ratio of the number of oxygen atoms to (number of nitrogen atoms + 1) (nO / (nN + 1)).
# Usefulness: Avoids division by zero and highlights the relative contribution of oxygen atoms, which play a critical role in biodegradability.
df['ratio_O_N'] = df['nO'] / (df['nN'] + 1)
end

python
# log_bond_frequency_sum
# Logarithm of the combined bond frequencies across all distances (log(bond_frequency_sum + 1)).
# Usefulness: Compresses the wide range of bond frequency sums and emphasizes their combined influence on molecular structure.
df['log_bond_frequency_sum'] = np.log1p(df['bond_frequency_sum'])
end

python
# norm_bond_interaction_sum
# Product of normalized bond interaction and total bond frequency sum (normalized_bond_interaction * bond_frequency_sum).
# Usefulness: Highlights interactions between normalized and cumulative bond frequencies, which are critical for understanding reactivity.
df['norm_bond_interaction_sum'] = df['normalized_bond_interaction'] * df['bond_frequency_sum']
end

python
# higher_to_lower_CN
# Ratio of higher-order C-N bonds to lower-order C-N bonds (F04[C-N] / (F03[C-N] + 1)).
# Usefulness: Captures the complexity of C-N bonding patterns, which can influence biodegradability.
df['higher_to_lower_CN'] = df['F04[C-N]'] / (df['F03[C-N]'] + 1)
end

python
# spectral_to_density
# Ratio of spectral complexity to structural density (spectral_complexity / structural_density).
# Usefulness: Measures the balance between structural complexity and density, influencing molecular breakdown pathways.
df['spectral_to_density'] = df['spectral_complexity'] / df['structural_density']
end

python
# combined_L_B
# Square root of the product of Laplace and Burden matrix leading eigenvalues (sqrt(SpMax_L * SpMax_B(m))).
# Usefulness: Combines key structural descriptors to emphasize their joint influence on molecular properties.
df['combined_L_B'] = np.sqrt(df['SpMax_L'] * df['SpMax_B(m)'])
end

python
# log_TI2_L
# Logarithm of the second Mohar index from the Laplace matrix (log(TI2_L + 1)).
# Usefulness: Normalizes and highlights the contribution of this structural indicator in relation to biodegradability.
df['log_TI2_L'] = np.log1p(df['TI2_L'])
end

python
# nitro_to_hetero
# Ratio of the number of aromatic nitro groups to (heteroatom complexity + 1) (nArNO2 / (heteroatom_complexity + 1)).
# Usefulness: Highlights the relative contribution of nitro groups compared to overall heteroatom complexity in the molecule.
df['nitro_to_hetero'] = df['nArNO2'] / (df['heteroatom_complexity'] + 1)
end

python
# donor_to_hetero
# Ratio of the number of donor atoms for H-bonds to total heteroatoms (nHDon / (nO + nN + 1)).
# Usefulness: Evaluates donor atoms in the context of the total heteroatom count, relevant for understanding hydrogen bonding potential.
df['donor_to_hetero'] = df['nHDon'] / (df['nO'] + df['nN'] + 1)
end

python
# functional_group_log
# Logarithm of aggregated functional group counts (log(1 + nArCOOR + nN-N + nCIR + nCrt)).
# Usefulness: Combines various functional groups into a single indicator to summarize their overall presence and impact.
df['functional_group_log'] = np.log1p(df['nArCOOR'] + df['nN-N'] + df['nCIR'] + df['nCrt'])
end

