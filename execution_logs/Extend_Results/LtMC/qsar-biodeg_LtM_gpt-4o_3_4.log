# log_spectral_complexity
# Logarithm transformation of spectral_complexity to reduce skewness and emphasize small values.
# Usefulness: Spectral complexity is a key descriptor of structural behavior; applying log reduces variance and captures subtle patterns.
df['log_spectral_complexity'] = df['spectral_complexity'].apply(lambda x: np.log(1 + x))
end

python
# ratio_heteroatom_bonds
# Ratio of heteroatom complexity to bond frequency sum (heteroatom_complexity / bond_frequency_sum).
# Usefulness: Highlights the relative contribution of heteroatoms to overall bonding complexity, essential for understanding chemical reactivity.
df['ratio_heteroatom_bonds'] = df['heteroatom_complexity'] / (df['bond_frequency_sum'] + 1e-6)
end

python
# spmax_complexity_interaction
# Interaction between spectral_complexity and spmax_c_percent_interaction (spectral_complexity * spmax_c_percent_interaction).
# Usefulness: Captures the interplay of structural complexity with the proportion of carbon-driven interactions, relevant for biodegradability.
df['spmax_complexity_interaction'] = df['spectral_complexity'] * df['spmax_c_percent_interaction']
end

python
# sqrt_spmax_l
# Square root transformation of SpMax_L to reduce skewness.
# Usefulness: SpMax_L reflects structural complexity, and square root scales down highly varying values for smoother patterns.
df['sqrt_spmax_l'] = df['SpMax_L'].apply(np.sqrt)
end

python
# log_nO_nN_ratio
# Log transformation of nO_nN_ratio (log(1 + nO_nN_ratio)).
# Usefulness: Reduces wide-scale variance in ratios of oxygen to nitrogen, which describe heteroatom effects.
df['log_nO_nN_ratio'] = df['nO_nN_ratio'].apply(lambda x: np.log(1 + x))
end

python
# normalized_carbon_interaction
# Ratio of spmax_c_percent_interaction to C% (spmax_c_percent_interaction / C%).
# Usefulness: Normalizes spmax_c_percent_interaction by carbon atom percentage, emphasizing relative impact on interactions.
df['normalized_carbon_interaction'] = df['spmax_c_percent_interaction'] / (df['C%'] + 1e-6)
end

python
# log_bond_frequency_sum
# Log transformation of bond_frequency_sum (log(1 + bond_frequency_sum)).
# Usefulness: Reduces variance in total bond frequencies, capturing subtle contributions of more frequent bonds.
df['log_bond_frequency_sum'] = df['bond_frequency_sum'].apply(lambda x: np.log(1 + x))
end

python
# heteroatoms_per_C
# Ratio of heteroatom complexity to percentage of carbon atoms (heteroatom_complexity / C%).
# Usefulness: Highlights the relative density of heteroatoms compared to carbon atoms, providing insights into molecular diversity.
df['heteroatoms_per_C'] = df['heteroatom_complexity'] / (df['C%'] + 1e-6)
end

python
# scaled_SdO
# Scaled version of SdO (min-max normalization).
# Usefulness: Normalizing SdO provides comparability across molecules, aiding in consistent biodegradability prediction.
df['scaled_SdO'] = (df['SdO'] - df['SdO'].min()) / (df['SdO'].max() - df['SdO'].min())
end

python
# log_SdO_bond_interaction
# Interaction between logarithmic SdO and bond_frequency_sum (log(1 + SdO) * bond_frequency_sum).
# Usefulness: Combines scaled heteroatom contributions with bond interactions to create a functional biodegradability indicator.
df['log_SdO_bond_interaction'] = df['SdO'].apply(lambda x: np.log(1 + x)) * df['bond_frequency_sum']
end

python
# Interactions_column summary(Simple Interaction drop 
df.drop(columns=['normalized_SdO'], inplace=True)
