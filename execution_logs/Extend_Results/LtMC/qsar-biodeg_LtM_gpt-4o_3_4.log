# nO_nN_ratio
# Ratio of number of oxygen atoms to nitrogen atoms (nO / nN)
# Usefulness: Indicates balance between oxygen and nitrogen atoms, which may influence reactivity and biodegradability.

df['nO_nN_ratio'] = df['nO'] / (df['nN'] + 1e-6)  # Adding small constant to prevent division by zero.
end

python
# spectral_complexity
# Product of leading eigenvalues from Laplace and adjacency matrices (SpMax_L * SpMax_A)
# Usefulness: Combines spectral connectivity measures to reflect molecular complexity affecting degradation potential.

df['spectral_complexity'] = df['SpMax_L'] * df['SpMax_A']
end

python
# heteroatom_complexity
# Sum of heteroatom counts (nO + nN + nX)
# Usefulness: Aggregates heteroatoms contributing to molecular reactivity and biodegradability.

df['heteroatom_complexity'] = df['nO'] + df['nN'] + df['nX']
end

python
# bond_frequency_sum
# Combined bond frequencies across all distances (F01[N-N] + F02[C-N] + F03[C-N] + F03[C-O] + F04[C-N])
# Usefulness: Reflects total bond interactions, significant for structural breakdown during biodegradation.

df['bond_frequency_sum'] = (df['F01[N-N]'] + df['F02[C-N]'] + df['F03[C-N]'] + df['F03[C-O]'] + df['F04[C-N]'])
end

python
# emission_normalized_spectral_moment
# Ratio of TI2_L to spectral moment from Burden matrix weighted by mass (TI2_L / SM6_B(m))
# Usefulness: Measures relative molecular complexity in relation to electronic and emission stability.

df['emission_normalized_spectral_moment'] = df['TI2_L'] / (df['SM6_B(m'] + 1e-6)
end

python
# structural_density
# Ratio of percentage of C atoms to lopping centric index (C% / LOC)
# Usefulness: Indicates density and structural compactness of the molecule, impacting biodegradation.

df['structural_density'] = df['C%'] / (df['LOC'] + 1e-6)
end

python
# log_SdO
# Logarithm of sum of dO E-states (log(SdO))
# Usefulness: Normalizes SdO values, reflecting contribution of O-related electronic states to molecular degradation.

df['log_SdO'] = np.log(df['SdO'] + 1e-6)
end

python
# normalized_bond_interaction
# Min-max normalization of F03[C-N] values.
# Usefulness: Highlights the relative importance of specific bond interactions at topological distance 3.

df['normalized_bond_interaction'] = (df['F03[C-N]'] - df['F03[C-N]'].min()) / (df['F03[C-N]'].max() - df['F03[C-N]'].min())
end

python
# spectral_interaction
# Interaction term between SpMax_B(m) and SdssC (SpMax_B(m) * SdssC)
# Usefulness: Detects interplay between spectral properties and structural complexity related to degradation.

df['spectral_interaction'] = df['SpMax_B(m'] * df['SdssC']
end

python
