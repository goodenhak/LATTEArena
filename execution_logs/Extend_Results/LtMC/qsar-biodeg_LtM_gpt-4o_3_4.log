df['bond_frequency_sum']", "# scale_SdO\n# Min-max normalization of SdO\n# Usefulness: Scales the SdO feature to a normalized range [0,1], making it comparable across other features and aiding in numerical stability.\n\ndf['scale_SdO'] = (df['SdO'] - df['SdO'].min()) / (df['SdO'].max() - df['SdO'].min())", "# total_complexity_index\n# Sum of heteroatom complexity, number of circuits (nCIR), and lopping centric index (LOC) (heteroatom_complexity + nCIR + LOC)\n# Usefulness: Aggregates various measures of molecular complexity which are relevant for assessing a compound's structure in relation to biodegradability.\n\ndf['total_complexity_index'] = df['heteroatom_complexity'] + df['nCIR'] + df['LOC']", "# square_Me\n# Square of mean atomic Sanderson electronegativity (Me  2)\n# Usefulness: Captures the potential nonlinear effects of electronegativity on biodegradability by emphasizing extreme values of Me.\n\ndf['square_Me'] = df['Me']  2", "# spmax_c_percent_interaction\n# Product of SpMax_B(m) and percentage of carbon atoms (C%) (SpMax_B(m) * C%)\n# Usefulness: Identifies interactions between the structural property of the molecule and the concentration of carbon atoms, which could influence degradability.\n\ndf['spmax_c_percent_interaction'] = df['SpMax_B(m)'] * df['C%']", "df.drop(columns=['nHM'], inplace=True)"]
