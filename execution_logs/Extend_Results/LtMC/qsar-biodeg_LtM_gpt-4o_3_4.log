e root of the product of Laplace and Burden matrix leading eigenvalues (sqrt(SpMax_L * SpMax_B(m))).\n# Usefulness: Combines key structural descriptors to emphasize their joint influence on molecular properties.\ndf['combined_L_B'] = np.sqrt(df['SpMax_L'] * df['SpMax_B(m)'])", "# log_TI2_L\n# Logarithm of the second Mohar index from the Laplace matrix (log(TI2_L + 1)).\n# Usefulness: Normalizes and highlights the contribution of this structural indicator in relation to biodegradability.\ndf['log_TI2_L'] = np.log1p(df['TI2_L'])", "# nitro_to_hetero\n# Ratio of the number of aromatic nitro groups to (heteroatom complexity + 1) (nArNO2 / (heteroatom_complexity + 1)).\n# Usefulness: Highlights the relative contribution of nitro groups compared to overall heteroatom complexity in the molecule.\ndf['nitro_to_hetero'] = df['nArNO2'] / (df['heteroatom_complexity'] + 1)", "# donor_to_hetero\n# Ratio of the number of donor atoms for H-bonds to total heteroatoms (nHDon / (nO + nN + 1)).\n# Usefulness: Evaluates donor atoms in the context of the total heteroatom count, relevant for understanding hydrogen bonding potential.\ndf['donor_to_hetero'] = df['nHDon'] / (df['nO'] + df['nN'] + 1)", "# functional_group_log\n# Logarithm of aggregated functional group counts (log(1 + nArCOOR + nN-N + nCIR + nCrt)).\n# Usefulness: Combines various functional groups into a single indicator to summarize their overall presence and impact.\ndf['functional_group_log'] = np.log1p(df['nArCOOR'] + df['nN-N'] + df['nCIR'] + df['nCrt'])", "df.drop(columns=['nO_nN_ratio', 'bond_frequency_sum'], inplace=True)"]
