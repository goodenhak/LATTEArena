# log_nO_nN_ratio_transformed
# Log transformation of log_nO_nN_ratio to normalize its high skewness.
# Usefulness: Helps reduce the influence of extreme values and better models the relationship between oxygen/nitrogen balance and biodegradability.
df['log_nO_nN_ratio_transformed'] = np.log1p(df['log_nO_nN_ratio'])
end

python
# ratio_oxygen_to_benzene
# Ratio of oxygen atoms to substituted benzene carbons (nO / nCb-).
# Usefulness: Highlights the relative contribution of oxygen atoms and structural variability to biodegradability.
df['ratio_oxygen_to_benzene'] = df['nO_nN_ratio'] / (df['nCb-'] + 1e-6)
end

python
# interaction_spmax_spectral
# Product of spectral descriptors SpMax_L and SM6_L.
# Usefulness: Captures complex spectral interactions that influence molecular structure stability and reactivity.
df['interaction_spmax_spectral'] = df['SpMax_L'] * df['SM6_L']
end

