# heteroatom_to_spectral_ratio
# Ratio of heteroatom complexity to spectral complexity (heteroatom_complexity / spectral_complexity)
# Usefulness: Captures the relationship between atom diversity and structural reactivity, key to predicting biodegradability.
df['heteroatom_to_spectral_ratio'] = df['heteroatom_complexity'] / df['spectral_complexity']
end

python
# log_bond_frequency_sum
# Logarithm of bond frequency sum (log(bond_frequency_sum + 1))
# Usefulness: Reduces skew in highly variable bond frequency data, aiding in identifying stable vs. reactive chemical groups.
df['log_bond_frequency_sum'] = np.log(df['bond_frequency_sum'] + 1)
end

python
# weighted_spectral_activity
# Product of SpMax_B(m) and Psi_i_A (SpMax_B(m) * Psi_i_A)
# Usefulness: Links molecular connectivity and intrinsic state properties, both critical for biodegradability analysis.
df['weighted_spectral_activity'] = df['SpMax_B(m)'] * df['Psi_i_A']
end

python
# normalized_carbon_interaction
# Ratio of spmax_c_percent_interaction to C% (spmax_c_percent_interaction / (C% + 0.1) to avoid division by zero)
# Usefulness: Highlights interactions influenced by carbon proportion, aiding in understanding structural impacts.
df['normalized_carbon_interaction'] = df['spmax_c_percent_interaction'] / (df['C%'] + 0.1)
end

python
# spectral_density_complexity
# Product of scale_structural_density and spectral_complexity (scale_structural_density * spectral_complexity)
# Usefulness: Combines density features with spectral properties, reflecting molecular compactness and reactivity.
df['spectral_density_complexity'] = df['scale_structural_density'] * df['spectral_complexity']
end

python
# sqrt_log_nO_nN_ratio
# Square root of logarithm of oxygen to nitrogen ratio (sqrt(log_nO_nN_ratio))
# Usefulness: Compresses extreme values for the oxygen-to-nitrogen ratio while preserving feature importance.
df['sqrt_log_nO_nN_ratio'] = np.sqrt(df['log_nO_nN_ratio'])
end

python
# aromatic_complexity_interaction
# Product of nCb- and nArNO2 (nCb- * nArNO2)
# Usefulness: Captures interaction between substituted benzene carbons and nitro groups, important for aromatic stability in biodegradation.
df['aromatic_complexity_interaction'] = df['nCb-'] * df['nArNO2']
end

python
# normalized_heteroatom_interaction
# Ratio of heteroatom_complexity to bond_frequency_sum (heteroatom_complexity / (bond_frequency_sum + 0.1) to avoid division by zero)
# Usefulness: Measures the relative heteroatom contribution to overall bonding, indicative of stability and reactivity.
df['normalized_heteroatom_interaction'] = df['heteroatom_complexity'] / (df['bond_frequency_sum'] + 0.1)
end

python
# scaled_heteroatom_spectral
# Min-max scaling of heteroatom_complexity multiplied by spectral_complexity
# Usefulness: Normalizes and combines structural complexity and atom diversity to enhance predictive capabilities.
max_val = (df['heteroatom_complexity'] * df['spectral_complexity']).max()
min_val = (df['heteroatom_complexity'] * df['spectral_complexity']).min()
df['scaled_heteroatom_spectral'] = (df['heteroatom_complexity'] * df['spectral_complexity'] - min_val) / (max_val - min_val)
end

python
# composite_reactivity_index
# Sum of SpMax_L, Psi_i_A, and spectral_complexity (SpMax_L + Psi_i_A + spectral_complexity)
# Usefulness: A holistic measure of molecular reactivity combining connectivity, pseudoconnectivity, and spectral properties.
df['composite_reactivity_index'] = df['SpMax_L'] + df['Psi_i_A'] + df['spectral_complexity']
end

python
df.drop(columns=['normalized_SdO', 'scale_SdO'], inplace=True)
end
