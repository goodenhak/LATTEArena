dO'] = np.log(df['SdO'] + 1e-6)", "# normalized_bond_interaction\n# Min-max normalization of F03[C-N] values.\n# Usefulness: Highlights the relative importance of specific bond interactions at topological distance 3.\n\ndf['normalized_bond_interaction'] = (df['F03[C-N]'] - df['F03[C-N]'].min()) / (df['F03[C-N]'].max() - df['F03[C-N]'].min())", "# spectral_interaction\n# Interaction term between SpMax_B(m) and SdssC (SpMax_B(m) * SdssC)\n# Usefulness: Detects interplay between spectral properties and structural complexity related to degradation.\n\ndf['spectral_interaction'] = df['SpMax_B(m'] * df['SdssC']", "# drop_columns\ndf.drop(columns=['Psi_i_1d', 'B04[C-Br]', 'N-073'], inplace=True)\n# Psi_i_1d: Intrinsic state pseudoconnectivity type with limited predictive use according to dataset description.\n# B04[C-Br]: Presence/absence of C-Br at topological distance 4 with minimal occurrences in the dataset.\n# N-073: Rare descriptor with limited contribution in biodegradability context."]
