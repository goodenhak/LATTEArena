# interaction_spmax_l_sqrt_spmax_l
# Interaction feature combining SpMax_L and its square root (SpMax_L × sqrt(SpMax_L)).
# Usefulness: Captures the interaction between SpMax_L values and their transformation to emphasize structural eigenvalue complexities.
df['interaction_spmax_l_sqrt_spmax_l'] = df['SpMax_L'] * df['sqrt_spmax_l']
end

