end

python
# hbond_hetero_ratio
# Ratio of hydrogen bond donors (nHDon) to heteroatom complexity (nO + nN + nX).
# Usefulness: Reflects the interplay between hydrogen-bonding capability and molecular heteroatom content. Useful for identifying active sites in biodegradation.
df['hbond_hetero_ratio'] = df['nHDon'] / (df['heteroatom_complexity'] + 1e-6)  # Avoid division by zero.
end

python
# spmax_c_percent_interaction
# Product of SpMax_B(m) (Burden eigenvalue) and the percentage of carbon atoms (C%).
# Usefulness: Combines molecular mass and carbon atom composition, relevant for assessing structural compactness and biodegradation likelihood.
df['spmax_c_percent_interaction'] = df['SpMax_B(m)'] * df['C%']
end

python
