# log_scaled_nO_nN_ratio
# Logarithmic scaling of oxygen-to-nitrogen ratio to reduce skewness.
# Usefulness: High skewness in nO_nN_ratio can affect models negatively. Taking the logarithm captures relative changes better and balances feature importance.
df[log_scaled_nO_nN_ratio] = df[nO_nN_ratio].apply(lambda x: np.log(x + 1))
end

python
# spectral_interaction_ratio
# Ratio of SpMax_L (Laplace matrix) to spectral_complexity, capturing interaction efficiency.
# Usefulness: Indicates how efficiently Laplace eigenvalues contribute to overall spectral complexity, highlighting structural differences.
df[spectral_interaction_ratio] = df[SpMax_L] / (df[spectral_complexity] + 1e-5)
end

python
# heteroatom_density
# Ratio of heteroatom_complexity to structural density (scaled).
# Usefulness: Highlights how concentrated heteroatoms are within the molecular structure, an important factor in biodegradability.
df[heteroatom_density] = df[heteroatom_complexity] / (df[scale_structural_density] + 1e-10)
end

python
# spmax_spectral_complexity_interaction
# Interaction between SpMax_B(m) and spectral_complexity.
# Usefulness: Models the combined effect of mass-weighted Burden matrix eigenvalues with structural complexity on biodegradability.
df[spmax_spectral_complexity_interaction] = df[SpMax_B(m)] * df[spectral_complexity]
end

python
# oxygen_bond_ratio
# Ratio of SdO values to bond_frequency_sum.
# Usefulness: Indicates the proportion of oxygen-related interactions compared to total bond frequencies, useful for predicting chemical behavior.
df[oxygen_bond_ratio] = df[SdO] / (df[bond_frequency_sum] + 1e-5)
end

python
# carbon_spectral_density
# Interaction of C% and spectral_complexity.
# Usefulness: Highlights how carbon percentage contributes to the spectral complexity, an essential factor in chemical biodegradability.
df[carbon_spectral_density] = df[C%] * df[spectral_complexity]
end

python
# rolling_mean_psi
# Rolling mean of Psi_i_A with a window size of 3.
# Usefulness: Captures local trends in pseudoconnectivity, which may correlate with biodegradability over similar compounds.
df[rolling_mean_psi] = df[Psi_i_A].rolling(window=3, min_periods=1).mean()
end

python
# normalized_heteroatom_complexity
# Min-max normalization of heteroatom_complexity.
# Usefulness: Scales heteroatom counts into a comparably normalized distribution for better feature importance.
df[normalized_heteroatom_complexity] = (df[heteroatom_complexity] - df[heteroatom_complexity].min()) / (df[heteroatom_complexity].max() - df[heteroatom_complexity].min())
end

python
# sqrt_spmax_bm
# Square root of SpMax_B(m).
# Usefulness: Captures nonlinear tendencies in Burden matrix eigenvalue for better relationship modeling.
df[sqrt_spmax_bm] = np.sqrt(df[SpMax_B(m)])
end

python
# zscore_cn_bond_ratio
# Z-score normalization of cn_bond_ratio.
# Usefulness: Scales bond ratios for better handling of outliers and ensures consistent contributions to downstream models.
df[zscore_cn_bond_ratio] = (df[cn_bond_ratio] - df[cn_bond_ratio].mean()) / df[cn_bond_ratio].std()
end

python
# structural_biodegradability_score
# Weighted sum of spectral_complexity, heteroatom_complexity, and spmax_c_percent_interaction.
# Usefulness: Combines key features associated with biodegradability into a single score for model simplicity.
df[structural_biodegradability_score] = 0.4 * df[spectral_complexity] + 0.4 * df[heteroatom_complexity] + 0.2 * df[spmax_c_percent_interaction]
end

python
# bond_density
# Ratio of bond_frequency_sum to heteroatom_complexity.
# Usefulness: Shows the density of bonds in relation to heteroatoms, a proxy for molecular stability and biodegradability.
df[bond_density] = df[bond_frequency_sum] / (df[heteroatom_complexity] + 1e-5)
end

python
df.drop(columns=[scale_SdO, log_nO_nN_ratio, scale_structural_density], inplace=True)
end
