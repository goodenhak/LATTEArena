# Usefulness: Captures interaction between substituted benzene carbons and nitro groups, important for aromatic stability in biodegradation.
df['aromatic_complexity_interaction'] = df['nCb-'] * df['nArNO2']
end

python
# normalized_heteroatom_interaction
# Ratio of heteroatom_complexity to bond_frequency_sum (heteroatom_complexity / (bond_frequency_sum + 0.1) to avoid division by zero)
# Usefulness: Measures the relative heteroatom contribution to overall bonding, indicative of stability and reactivity.
df['normalized_heteroatom_interaction'] = df['heteroatom_complexity'] / (df['bond_frequency_sum'] + 0.1)
end

python
# scaled_heteroatom_spectral
# Min-max scaling of heteroatom_complexity multiplied by spectral_complexity
# Usefulness: Normalizes and combines structural complexity and atom diversity to enhance predictive capabilities.
max_val = (df['heteroatom_complexity'] * df['spectral_complexity']).max()
min_val = (df['heteroatom_complexity'] * df['spectral_complexity']).min()
df['scaled_heteroatom_spectral'] = (df['heteroatom_complexity'] * df['spectral_complexity'] - min_val) / (max_val - min_val)
end

python
# composite_reactivity_index
# Sum of SpMax_L, Psi_i_A, and spectral_complexity (SpMax_L + Psi_i_A + spectral_complexity)
# Usefulness: A holistic measure of molecular reactivity combining connectivity, pseudoconnectivity, and spectral properties.
df['composite_reactivity_index'] = df['SpMax_L'] + df['Psi_i_A'] + df['spectral_complexity']
end

python
df.drop(columns=['normalized_SdO', 'scale_SdO'], inplace=True)
end
