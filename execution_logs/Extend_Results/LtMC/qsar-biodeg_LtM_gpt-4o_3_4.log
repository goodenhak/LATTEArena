# hbond_hetero_ratio
# Ratio of hydrogen bond donors to heteroatom complexity (nHDon / heteroatom_complexity)
# Usefulness: Measures the balance between donor atoms for hydrogen bonds and overall molecular heteroatom complexity, directly tied to biodegradability potential.

df['hbond_hetero_ratio'] = df['nHDon'] / df['heteroatom_complexity']
end

python
# cn_bond_ratio
# Ratio of C-N bond frequency to total bond frequency (F03[C-N] / bond_frequency_sum)
# Usefulness: Highlights the prominence of C-N bonds, which are critical for specific biochemical interactions affecting biodegradability.

df['cn_bond_ratio'] = df['F03[C-N]'] / df['bond_frequency_sum']
end

python
# spec_density_ratio
# Ratio of spectral complexity to structural density (spectral_complexity / structural_density)
# Usefulness: Links spectral properties to structural features, providing insights into the arrangement of molecular structures affecting degradability.

df['spec_density_ratio'] = df['spectral_complexity'] / df['structural_density']
end

python
# oxygen_nitrogen_interaction
# Multiply the number of oxygen atoms with nitrogen atoms (nO * nN)
# Usefulness: Represents interaction effects between oxygen and nitrogen atoms, key players in biodegradation pathways.

df['oxygen_nitrogen_interaction'] = df['nO'] * df['nN']
end

python
# log_nO_nN_ratio
# Logarithm of the ratio of the number of oxygen to nitrogen atoms [log(nO_nN_ratio + 1)]
# Usefulness: Reduces skewness in the nO_nN_ratio feature and captures nonlinear relationships indicative of oxygen-nitrogen interactions.

df['log_nO_nN_ratio'] = np.log(df['nO_nN_ratio'] + 1)
end

python
# spectral_bond_interaction
# Product of spectral complexity and total bond frequency (spectral_complexity * bond_frequency_sum)
# Usefulness: Encapsulates the combined effects of molecular topology and bond interactions, crucial for understanding chemical degradability.

df['spectral_bond_interaction'] = df['spectral_complexity'] * df['bond_frequency_sum']
end

python
# scale_SdO
# Min-max normalization of SdO
# Usefulness: Scales the SdO feature to a normalized range [0,1], making it comparable across other features and aiding in numerical stability.

df['scale_SdO'] = (df['SdO'] - df['SdO'].min()) / (df['SdO'].max() - df['SdO'].min())
end

python
# total_complexity_index
# Sum of heteroatom complexity, number of circuits (nCIR), and lopping centric index (LOC) (heteroatom_complexity + nCIR + LOC)
# Usefulness: Aggregates various measures of molecular complexity which are relevant for assessing a compound's structure in relation to biodegradability.

df['total_complexity_index'] = df['heteroatom_complexity'] + df['nCIR'] + df['LOC']
end

python
# square_Me
# Square of mean atomic Sanderson electronegativity (Me  2)
# Usefulness: Captures the potential nonlinear effects of electronegativity on biodegradability by emphasizing extreme values of Me.

df['square_Me'] = df['Me']  2
end

python
# spmax_c_percent_interaction
# Product of SpMax_B(m) and percentage of carbon atoms (C%) (SpMax_B(m) * C%)
# Usefulness: Identifies interactions between the structural property of the molecule and the concentration of carbon atoms, which could influence degradability.

df['spmax_c_percent_interaction'] = df['SpMax_B(m)'] * df['C%']
end

python
df.drop(columns=['nHM'], inplace=True)
end
