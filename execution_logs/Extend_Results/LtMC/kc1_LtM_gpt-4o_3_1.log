# log_defect_density_index
# Log transformation of defect_density_index to reduce skewness and stabilize scale.
# Usefulness: Defect density is highly skewed; transforming it better aligns with features like complexity and documentation density.
df['log_defect_density_index'] = np.log1p(df['defect_density_index'])
end

python
# normalized_vg
# Cyclomatic complexity normalized by loc to control for the impact of module size.
# Usefulness: Normalized complexity provides a comparative measure across modules of varying sizes, removing size bias.
df['normalized_vg'] = df['v(g)'] / df['loc']
end

python
# exp_effort_operand_uniqueness
# Exponential scaling of effort_operand_uniqueness to capture diminishing returns at high values.
# Usefulness: Exponential scaling reveals nonlinear relationships between coding effort and defect probability.
df['exp_effort_operand_uniqueness'] = np.exp(-df['effort_operand_uniqueness'])
end

python
# operand_operator_balance
# Ratio of total_Op to total_Opnd to capture the balance across operators and operands.
# Usefulness: Imbalanced operator-operand relationships might reveal suboptimal structures impacting defect likelihood.
df['operand_operator_balance'] = df['total_Op'] / (df['total_Opnd'] + 1e-10)  # Avoid division by zero.
end

python
# interaction_complexity_documentation
# Interaction feature combining effort_operand_uniqueness and comment_per_code_ratio.
# Usefulness: Highlights modules requiring high effort but lacking documentation, which could lead to defects.
df['interaction_complexity_documentation'] = df['effort_operand_uniqueness'] * df['comment_per_code_ratio']
end

python
# rolling_mean_design_gap_5
# Rolling mean of design_gap with a window size of 5 to identify trends in design variation.
# Usefulness: Highlights temporal trends in design issues that could correlate with defect introduction.
df['rolling_mean_design_gap_5'] = df['design_gap'].rolling(window=5).mean()
end

python
# relative_operator_uniqueness
# Ratio of unique operators to total operators to account for the relative uniqueness in operator usage.
# Usefulness: Uniqueness of operators could correlate with specialized or complex code likely prone to defects.
df['relative_operator_uniqueness'] = df['uniq_Op'] / (df['total_Op'] + 1e-10)  # Avoid division by zero.
end

python
# normalized_complexity_branch_interaction
# Complexity_branch_interaction normalized by loc to limit the effect of code size.
# Usefulness: Normalizing this interaction isolates complexity structure without size dependence.
df['normalized_complexity_branch_interaction'] = df['complexity_branch_interaction'] / (df['loc'] + 1e-10)  # Avoid division by zero.
end

python
# abs_operand_operator_imbalance
