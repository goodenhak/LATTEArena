# defect_interaction_score
# Interaction between cyclomatic complexity (v(g)), essential complexity (ev(g)), and effort_difficulty_ratio to emphasize modules with high complexity and effort.
# Usefulness: Amplifies defect-prone signals by combining core complexity and computational effort measures.
df['defect_interaction_score'] = df['v(g)'] * df['ev(g)'] * df['effort_difficulty_ratio']
end

python
# documentation_adequacy_score
# Interaction between comment_per_code_ratio and code_density to measure documentation adequacy relative to code density.
# Usefulness: Highlights modules with poor documentation despite dense code, aligning with defect patterns.
df['documentation_adequacy_score'] = df['comment_per_code_ratio'] * df['code_density']
end

python
# extreme_complexity_effort_interaction
# Binary flag indicating modules with both extreme complexity (branch_complexity_interaction_flag) and extreme effort (extreme_effort_flag).
# Usefulness: Captures risky modules with disproportionate complexity and effort, useful for defect detection.
df['extreme_complexity_effort_interaction'] = df['branch_complexity_interaction_flag'] & df['extreme_effort_flag']
end

python
# normalized_design_gap
# Z-score of design gap to normalize its distribution across modules.
# Usefulness: Facilitates comparison and highlights modules with extreme design complexity deviations.
df['normalized_design_gap'] = (df['design_gap'] - df['design_gap'].mean()) / df['design_gap'].std()
end

python
# relative_complexity_interaction
# Product of relative_complexity_ratio and v(g) to emphasize excessive complexity relative to essentials weighted by overall complexity.
# Usefulness: Targets modules prone to excessive, unnecessary complexity, a significant defect predictor.
df['relative_complexity_interaction'] = df['relative_complexity_ratio'] * df['v(g)']
end

python
# cumulative_design_gap
# Cumulative sum of design_gap to measure accumulated design complexity increases across modules.
# Usefulness: Tracks progressive design challenges over the dataset, identifying clusters of defect-prone modules.
df['cumulative_design_gap'] = df['design_gap'].cumsum()
end

python
# operand_complexity_score
# Interaction between operand_uniqueness_ratio and unique_operator_volume_interaction to measure operand and operator complexity combined.
# Usefulness: Reflects deeper code structural complexity, a proxy for defect-prone modules.
df['operand_complexity_score'] = df['operand_uniqueness_ratio'] * df['unique_operator_volume_interaction']
end

python
# normalized_complexity_interaction
# Min-max normalized product of complexity_branch_interaction and v(g).
# Usefulness: Highlights interdependent complexity measures while reducing scale variability.
df['normalized_complexity_interaction'] = (df['complexity_branch_interaction'] * df['v(g)'] - (df['complexity_branch_interaction'] * df['v(g)']).min()) / ((df['complexity_branch_interaction'] * df['v(g)']).max() - (df['complexity_branch_interaction'] * df['v(g)']).min())
end

python
# dropping_comment_ratio
# Removed comment_ratio due to redundancy with log_comment_lines and comment_per_code_ratio.
# Usefulness: Avoids multicollinearity and redundant features in the dataset.
df.drop(columns=['comment_ratio'], inplace=True)
end

