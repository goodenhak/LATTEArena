# relative_complexity_ratio
# Ratio of cyclomatic complexity (v(g)) to essential complexity (ev(g)) to highlight excessive complexity relative to essentials.
# Usefulness: Helps identify modules where cyclomatic complexity is disproportionately higher than essential complexity, signaling potential defect-prone areas.
df['relative_complexity_ratio'] = df['v(g)'] / (df['ev(g)'] + 1)
end

python
# code_density
# Ratio of Halstead's line count (lOCode) to McCabe's line count of code (loc) to measure code density.
# Usefulness: Indicates modules with unusually dense code, which may be harder to maintain and more defect-prone.
df['code_density'] = df['lOCode'] / (df['loc'] + 1)
end

python
# unique_operator_volume_interaction
# Interaction between Halstead volume (v) and unique operators (uniq_Op) to assess unique operator contributions to code complexity.
# Usefulness: Highlights unique operator contributions under high code volume, aiming to capture distinctive patterns in defect-prone modules.
df['unique_operator_volume_interaction'] = df['v'] * df['uniq_Op']
end

python
# effort_operand_uniqueness
# Product of effort-to-difficulty ratio (effort_difficulty_ratio) and operand uniqueness ratio (operand_uniqueness_ratio).
# Usefulness: Models impact of operand uniqueness in computationally intense modules, capturing defect-driving structure.
df['effort_operand_uniqueness'] = df['effort_difficulty_ratio'] * df['operand_uniqueness_ratio']
end

python
# log_comment_lines
# Log-transformed line count of comments (lOComment).
# Usefulness: Reduces skewness in comment distribution, aiding in understanding modules with varied documentation levels.
df['log_comment_lines'] = np.log(df['lOComment'] + 1)
end

python
# comment_per_code_ratio
# Ratio of comment ratio (comment_ratio) to McCabe line count of code (loc) for documentation density per code line.
# Usefulness: Provides insight into how well-documented a module is relative to its code base, affecting readability and maintainability.
df['comment_per_code_ratio'] = df['comment_ratio'] / (df['loc'] + 1)
end

python
# rolling_mean_complexity_gap_3
# Rolling mean of complexity gap (complexity_gap) with a window size of 3.
# Usefulness: Captures recent trends in complexity gap across sequential modules, aiding time-aware defect detection.
df['rolling_mean_complexity_gap_3'] = df['complexity_gap'].rolling(window=3).mean().fillna(0)
end

python
# extreme_effort_flag
# Binary flag indicating extreme effort-to-difficulty ratio using the z-score.
# Usefulness: Identifies modules with unusually high computational effort relative to difficulty, which may be defect-prone.
effort_zscore = (df['effort_difficulty_ratio'] - df['effort_difficulty_ratio'].mean()) / df['effort_difficulty_ratio'].std()
df['extreme_effort_flag'] = (effort_zscore > 2).astype(int)
end

python
