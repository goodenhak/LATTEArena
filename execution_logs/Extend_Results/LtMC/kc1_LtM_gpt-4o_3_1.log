# complexity_effort_interaction
# Interaction of cyclomatic complexity (v(g)) with effort_difficulty_ratio to highlight regions where logical complexity requires excessive effort.
# Usefulness: This helps identify modules that are not only complex structurally but also require disproportionately high effort, which could lead to defects.
df['complexity_effort_interaction'] = df['v(g)'] * df['effort_difficulty_ratio']
end

python
# documentation_to_code_token_ratio
# Ratio of comment_ratio over volume_token_ratio to reveal how well-documented the code is in relation to its token density.
# Usefulness: Highlights modules with poor token-to-documentation balance, potentially indicative of risky or under-documented code.
df['documentation_to_code_token_ratio'] = df['comment_ratio'] / (df['volume_token_ratio'] + 1e-9)
end

python
# operand_operator_imbalance
# Difference between total_Opnd (operands) and total_Op (operators).
# Usefulness: Captures the imbalance between operands and operators that could indicate overly complex or deficient programming logic.
df['operand_operator_imbalance'] = df['total_Opnd'] - df['total_Op']
end

python
# relative_efficiency_ratio
# Exponential combination of effort_difficulty_ratio and operand_uniqueness_ratio to identify nonlinear inefficiencies associated with operand variability.
# Usefulness: Helps detect modules where inefficiencies grow nonlinearly with operand uniqueness, indicating potential hotspots for defects.
df['relative_efficiency_ratio'] = np.exp(df['effort_difficulty_ratio'] * df['operand_uniqueness_ratio'])
end

python
# rolling_sum_branch_complexity
# Cumulative sum of branch_complexity_interaction to track sustained branching demands over consecutive modules.
# Usefulness: Highlights modules more likely impacted by consistently high branching complexities, which can lead to defects.
df['rolling_sum_branch_complexity'] = df['complexity_branch_interaction'].cumsum()
end

python
# log_scaled_code_volume
# Logarithmic transformation of Halstead volume (v).
# Usefulness: Reduces the influence of extreme outliers in code volume, making the signal more interpretable for downstream models.
df['log_scaled_code_volume'] = np.log1p(df['v'])
end

python
# rolling_adjusted_complexity_gap
# Rolling mean of design_gap with a window size of 5 to smooth out short-term fluctuations in complexity gaps.
# Usefulness: Provides a more stable and interpretable view of complexity gaps over recent modules, capturing longer-term trends.
df['rolling_adjusted_complexity_gap'] = df['design_gap'].rolling(window=5, min_periods=1).mean()
end

python
# defect_density_index
# Product of unique_operator_volume_interaction and comment_per_code_ratio to represent code interaction complexity correlated with documentation density.
# Usefulness: Helps to detect defects arising from the interplay of high operator uniqueness and insufficient documentation.
df['defect_density_index'] = df['unique_operator_volume_interaction'] * df['comment_per_code_ratio']
end

python
# lagged_complexity_ratio
# One-lagged value of relative_complexity_ratio.
# Usefulness: Captures trends or sudden changes in relative complexity, which could indicate defect-prone modules.
df['lagged_complexity_ratio'] = df['relative_complexity_ratio'].shift(1)
end

python
# extreme_effort_documentation_flag
# Binary flag indicating high effort-to-difficulty ratio and zero comment_ratio.
# Usefulness: Highlights modules with extreme effort demanded but without adequate documentation, a clear risk for hidden defects.
df['extreme_effort_documentation_flag'] = ((df['effort_difficulty_ratio'] > df['effort_difficulty_ratio'].mean() + 2 * df['effort_difficulty_ratio'].std()) & (df['comment_ratio'] == 0)).astype(int)
end

python
# Drop unusable or redundant columns for clarity
df.drop(columns=['extreme_effort_flag', 'log_comment_lines'], inplace=True)
end
