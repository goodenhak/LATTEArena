# operand_operator_balance
# Ratio of total_Op to total_Opnd to capture the balance across operators and operands.
# Usefulness: Highlights imbalance in operator-operand usage which is often linked to poor code structure and defects.
df['operand_operator_balance'] = df['total_Op'] / (df['total_Opnd'] + 1e-5)
end

python
# normalized_vg
# Cyclomatic complexity normalized by loc to control for the impact of module size.
# Usefulness: Accounts for the size of the code, offering a relative measure of cyclomatic complexity.
df['normalized_vg'] = df['v(g)'] / (df['loc'] + 1e-5)
end

python
# high_design_gap_flag
# Binary flag indicating if design_gap is greater than the third quartile.
# Usefulness: Captures modules with disproportionately large gaps between design and essential complexity, associated with higher defect rates.
df['high_design_gap_flag'] = (df['design_gap'] > df['design_gap'].quantile(0.75)).astype(int)
end

python
# log_defect_density_index
# Log transformation of defect_density_index to reduce skewness.
# Usefulness: Stabilizes the variance and spreads out a dense range, making it more interpretable for models while retaining defect information.
df['log_defect_density_index'] = np.log(df['defect_density_index'] + 1)
end

python
# rolling_mean_design_gap_5
# Rolling mean of design_gap with a window size of 5.
# Usefulness: Smooths out short-term fluctuations in design complexity gaps to reveal long-term trends in complexity changes.
df['rolling_mean_design_gap_5'] = df['design_gap'].rolling(window=5, min_periods=1).mean()
end

python
# interaction_complexity_documentation
# Interaction feature combining effort_operand_uniqueness and comment_per_code_ratio.
# Usefulness: Detects areas where high effort-to-operand variability coincides with low documentation density, often indicative of potential defects.
df['interaction_complexity_documentation'] = df['effort_operand_uniqueness'] * df['comment_per_code_ratio']
end

python
# exp_effort_operand_uniqueness
# Exponential scaling of effort_operand_uniqueness to capture diminishing returns at high values.
# Usefulness: Models non-linear growth in effort variability linked with operand uniqueness, relevant for defect prediction.
df['exp_effort_operand_uniqueness'] = np.exp(-df['effort_operand_uniqueness'])
end

python
# relative_operator_uniqueness
# Ratio of uniq_Op to total_Op to account for the relative uniqueness in operator usage.
# Usefulness: Emphasizes unique operator patterns, which may indicate overly complex or poorly standardized code leading to defects.
df['relative_operator_uniqueness'] = df['uniq_Op'] / (df['total_Op'] + 1e-5)
end

python
# log_relative_efficiency_ratio
# Log transformation of relative_efficiency_ratio to reduce extreme values and stabilize scale.
# Usefulness: Prevents extreme values from dominating the model, while still highlighting inefficiencies tied to operand variability.
df['log_relative_efficiency_ratio'] = np.log(df['relative_efficiency_ratio'] + 1e-5)
end

