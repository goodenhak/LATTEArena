2026-05-26 00:55:00,797 - INFO - ops_string = ["# log_v\n# Log-transformed Halstead volume to handle skewness and outliers.\n# Usefulness: Highlights diminishing marginal impacts of large volume values on defect-proneness.\ndf['log_v'] = np.log(df['v'] + 1)", "# log_effort_difficulty\n# Log-transformed effort-to-difficulty ratio.\n# Usefulness: Helps to identify extreme effort-related values and reduces the impact of outliers.\ndf['log_effort_difficulty'] = np.log(df['effort_difficulty_ratio'] + 1)", "# excess_complexity\n# Ratio of McCabe cyclomatic complexity to essential complexity.\n# Usefulness: Highlights code regions where complexity is excessive relative to what is necessary, often defect-prone.\ndf['excess_complexity'] = df['v(g)'] / (df['ev(g)'] + 1e-9)", "# effort_complexity_interaction\n# Product of effort-to-difficulty ratio and McCabe cyclomatic complexity.\n# Usefulness: Captures nonlinear interactions between effort and control flow complexity related to defect-prone modules.\ndf['effort_complexity_interaction'] = df['effort_difficulty_ratio'] * df['v(g)']", "# rolling_mean_effort_difficulty_3\n# Rolling mean of effort-to-difficulty ratio with a window size of 3.\n# Usefulness: Highlights local trends in effort anomalies, flagging defect-prone sections with increasing effort.\ndf['rolling_mean_effort_difficulty_3'] = df['effort_difficulty_ratio'].rolling(window=3).mean()", "# normalized_v\n# Z-score normalization of Halstead volume.\n# Usefulness: Standardizes volume to detect outliers or extreme values, aiding in identifying defect-prone code complexity.\ndf['normalized_v'] = (df['v'] - df['v'].mean()) / df['v'].std()", "# complexity_per_loc\n# Ratio of Halstead volume to McCabe's line count of code.\n# Usefulness: High values indicate compact but overly complex code, often prone to defects.\ndf['complexity_per_loc'] = df['v'] / (df['loc'] + 1e-9)", "# high_effort_flag\n# Binary flag for extreme effort-to-difficulty ratio using a high threshold.\n# Usefulness: Flags potential defect-prone modules with anomalously high effort requirements.\ndf['high_effort_flag'] = (df['effort_difficulty_ratio'] > 1000).astype(int)", "# unique_operator_effort\n# Product of unique operators and effort-to-difficulty ratio.\n# Usefulness: Captures the relationship between unique operator contributions and effort complexity.\ndf['unique_operator_effort'] = df['uniq_Op'] * df['effort_difficulty_ratio']", "# comment_density\n# Ratio of lines of comments to McCabe's line count of code.\n# Usefulness: Measures the adequacy of documentation; low values signal potential for maintainability issues and defects.\ndf['comment_density'] = df['lOComment'] / (df['loc'] + 1e-9)", "# normalized_effort_operand_uniqueness\n# Z-score normalization of effort-to-difficulty ratio multiplied by operand uniqueness ratio.\n# Usefulness: Standardizes effort-uniqueness interaction, identifying outliers linked to defect-prone code.\ndf['normalized_effort_operand_uniqueness'] = (df['effort_operand_uniqueness'] - df['effort_operand_uniqueness'].mean()) / df['effort_operand_uniqueness'].std()", "# branch_complexity_interaction_flag\n# Binary flag if branch complexity interaction exceeds a threshold of 100.\n# Usefulness: Flags modules where branch complexity interaction becomes excessive, potentially causing defects.\ndf['branch_complexity_interaction_flag'] = (df['complexity_branch_interaction'] > 100).astype(int)", "df.drop(columns=['comment_per_code_ratio'], inplace=True)", "df.drop(columns=['rolling_mean_complexity_gap_3'], inplace=True)"]
