# temporal_complexity_trend
# Rolling mean of v(g) (cyclomatic complexity) with a window size of 3 to capture temporal trends in complexity.
# Usefulness: Provides insights into how complexity evolves over time, helping link trends to potential defect introduction.
df['temporal_complexity_trend'] = df['v(g)'].rolling(window=3).mean()
end

python
# composite_risk_score
# Combined score of relative_complexity_ratio, effort_operand_uniqueness, and rolling_mean_complexity_gap_3 to assess overall risk.
# Usefulness: Consolidates key predictors of defects, combining complexity, effort inefficiencies, and temporal design gaps into a single metric.
df['composite_risk_score'] = (df['relative_complexity_ratio'] * df['effort_operand_uniqueness'] * df['rolling_mean_complexity_gap_3'])
end

python
# total_operand_operator_ratio
# Ratio of total_Opnd (operands) to total_Op (operators).
# Usefulness: Highlights uneven distributions between operands and operators, which can signal potential defect-prone patterns.
df['total_operand_operator_ratio'] = df['total_Opnd'] / (df['total_Op'] + 1)  # Add 1 to avoid division by zero.
end

python
# adjusted_defect_density_index
# Log-transformed defect_density_index for stabilization and normalization.
# Usefulness: Reduces the impact of extreme values in defect density, making the feature more robust for modeling.
df['adjusted_defect_density_index'] = np.log1p(df['defect_density_index'])
end

python
# abs_design_gap
# Absolute value of the design_gap feature.
# Usefulness: Reflects the magnitude of deviations in code design complexity, irrespective of positive or negative direction.
df['abs_design_gap'] = df['design_gap'].abs()
end

python
# operand_complexity_interaction
# Interaction between operand_uniqueness_ratio and operand_operator_imbalance.
# Usefulness: Captures how variability in operand uniqueness interacts with imbalances in operands and operators, highlighting modularity risks.
df['operand_complexity_interaction'] = df['operand_uniqueness_ratio'] * df['operand_operator_imbalance']
end

python
# relative_complexity_with_lagged
# Product of relative_complexity_ratio and lagged_complexity_ratio to assess overall complexity amplification.
# Usefulness: Captures compounding effects of consecutive complex modules, helping identify sustained complexity issues.
df['relative_complexity_with_lagged'] = df['relative_complexity_ratio'] * df['lagged_complexity_ratio']
end

python
# flag_extreme_effort_complexity
# Binary flag indicating if effort_operand_uniqueness exceeds 100 and relative_complexity_ratio exceeds 1.5.
# Usefulness: Marks regions with exceptionally high effort inefficiencies and complexity, strongly correlated with defect proneness.
df['flag_extreme_effort_complexity'] = ((df['effort_operand_uniqueness'] > 100) & (df['relative_complexity_ratio'] > 1.5)).astype(int)
end

python
# normalized_comment_ratio
# Z-score normalization of comment_ratio.
# Usefulness: Normalized metric to assess comment density in a standardized range, making it comparable across modules.
df['normalized_comment_ratio'] = (df['comment_ratio'] - df['comment_ratio'].mean()) / df['comment_ratio'].std()
end

python
# Drop unnecessary features
df.drop(columns=['relative_efficiency_ratio', 'extreme_effort_documentation_flag'], inplace=True)
end
