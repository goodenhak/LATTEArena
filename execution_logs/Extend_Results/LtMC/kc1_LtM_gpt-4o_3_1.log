# log_loc
# Log transformation of loc to address skewness and highlight smaller code bases prone to defects.
# Usefulness: Handles skewness and scales the feature, aligning with the dataset description that smaller modules can also be defect-prone.
df['log_loc'] = np.log1p(df['loc'])
end

python
# complexity_interaction
# Interaction between cyclomatic complexity (v(g)) and design_gap.
# Usefulness: Captures the combined impact of core complexity and design gap, which are directly correlated to defect-prone areas.
df['complexity_interaction'] = df['v(g)'] * df['design_gap']
end

python
# coding_effort_to_doc_ratio
# Ratio of effort_operand_uniqueness to comment_ratio.
# Usefulness: Highlights modules with high computational effort but inadequate documentation, which are more likely defect-prone.
df['coding_effort_to_doc_ratio'] = df['effort_operand_uniqueness'] / (df['comment_ratio'] + 1e-6)
end

python
# rolling_mean_effort_3
# Rolling mean of effort_operand_uniqueness with a window size of 3.
# Usefulness: Smooths fluctuations in effort over consecutive modules, aiding in capturing systematic patterns in computational effort.
df['rolling_mean_effort_3'] = df['effort_operand_uniqueness'].rolling(window=3).mean()
end

python
# rolling_variability_complexity
# Rolling standard deviation of relative_complexity_ratio with a window size of 3.
# Usefulness: Identifies regions with variable or inconsistent complexity, often correlated with unexpected defects.
df['rolling_variability_complexity'] = df['relative_complexity_ratio'].rolling(window=3).std()
end

python
# low_doc_high_complexity_flag
# Binary flag indicating zero documentation coverage (comment_ratio == 0) and above-median complexity (v(g) > median).
# Usefulness: Pinpoints modules that are both high in complexity and poorly documented, high-risk factors for defects.
df['low_doc_high_complexity_flag'] = ((df['comment_ratio'] == 0) & (df['v(g)'] > df['v(g)'].median())).astype(int)
end

python
# operand_operator_ratio
# Ratio of total operands to total operators (total_Opnd / total_Op).
# Usefulness: Normalizes the balance between operands and operators, emphasizing potential construct misuse.
df['operand_operator_ratio'] = df['total_Opnd'] / (df['total_Op'] + 1e-6)
end

python
# standardized_design_gap
# Z-score standardized version of design_gap.
# Usefulness: Normalizes design_gap for comparability, capturing its significance in defect prediction.
df['standardized_design_gap'] = (df['design_gap'] - df['design_gap'].mean()) / (df['design_gap'].std())
end

python
# defect_risk_interaction
# Combined interaction of branch_complexity_interaction_flag and extreme_effort_documentation_flag.
# Usefulness: Merges two high-risk indicators to further refine defect-prone regions.
df['defect_risk_interaction'] = df['branch_complexity_interaction_flag'] * df['extreme_effort_documentation_flag']
end

python
# log_defect_density_index
# Log transformation of defect_density_index.
# Usefulness: Handles skewness in defect_density_index and highlights subtle patterns linked to defect-prone modules.
df['log_defect_density_index'] = np.log1p(df['defect_density_index'])
end

python
# complex_doc_interaction
