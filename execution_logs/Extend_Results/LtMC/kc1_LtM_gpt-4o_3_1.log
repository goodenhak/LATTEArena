# Usefulness: Taking the absolute measure emphasizes significant mismatches impacting code quality without negative bias.
df['abs_operand_operator_imbalance'] = np.abs(df['operand_operator_imbalance'])
end

python
# high_design_gap_flag
# Binary flag indicating if design_gap is greater than the third quartile.
# Usefulness: Flags modules with excessive design gaps, which may indicate design debt leading to defects.
df['high_design_gap_flag'] = (df['design_gap'] > df['design_gap'].quantile(0.75)).astype(int)
end

python
# defect_ratio
# Ratio of defect density to loc for per-line defect density.
# Usefulness: Highlights localization of defects for modules of different sizes, especially those with high density.
df['defect_ratio'] = df['defect_density_index'] / (df['loc'] + 1e-10)  # Avoid division by zero.
end

python
# rolling_adjusted_complexity_gap
# Rolling mean of design_gap with a window size of 5 for smoothing short-term fluctuations.
# Usefulness: Captures temporal patterns of gaps between design and essential complexity.
df['rolling_adjusted_complexity_gap'] = df['design_gap'].rolling(window=5).mean()
end

python
