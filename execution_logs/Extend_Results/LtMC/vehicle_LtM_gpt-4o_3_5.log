python
# normalized_variance_gyration_ratio
# Ratio of distribution_mean_variance to normalized_gyration to analyze how variance interacts with gyration characteristics.
# Usefulness: Helps determine how internal distribution affects geometrical properties and compactness across vehicle types.
df['normalized_variance_gyration_ratio'] = df['distribution_mean_variance'] / df['normalized_gyration']
end

python
# hollow_aspect_interaction
# Interaction of hollow_per_aspect_ratio with MAX.LENGTH_ASPECT_RATIO to highlight combined elongation and hollow properties.
# Usefulness: Captures intricate relationships between aspect ratios and hollow features, useful for differentiating elongated vehicles.
df['hollow_aspect_interaction'] = df['hollow_per_aspect_ratio'] * df['MAX.LENGTH_ASPECT_RATIO']
end

python
# scatter_skewness_combination
# Interaction of SCATTER_RATIO with SKEWNESS_ABOUT_MAJOR_AXIS to represent combined effects of inertia and skewness.
# Usefulness: Captures symmetry and asymmetry interactions, aiding classification of silhouettes with varying shapes.
df['scatter_skewness_combination'] = df['SCATTER_RATIO'] * df['SKEWNESS_ABOUT_MAJOR_AXIS']
end

python
# scaled_var_gyration_diff
# Difference between SCALED_VARIANCE_ALONG_MAJOR_AXIS and normalized_gyration.
