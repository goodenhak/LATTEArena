# compactness_circularity_ratio
# Ratio of COMPACTNESS to CIRCULARITY to capture compactness relative to circularity.
# Usefulness: Helps distinguish more compact vs. rounder shapes, which may correlate with vehicle type.
df['compactness_circularity_ratio'] = df['COMPACTNESS'] / df['CIRCULARITY']
end

python
# distance_elongatedness_ratio
# Ratio of DISTANCE_CIRCULARITY to ELONGATEDNESS to capture central spread vs. elongation dynamics.
# Usefulness: Emphasizes the relationship between central shape spread and elongation, relevant for structural classification.
df['distance_elongatedness_ratio'] = df['DISTANCE_CIRCULARITY'] / df['ELONGATEDNESS']
end

python
# scatter_radius_ratio
# Ratio of SCATTER_RATIO to RADIUS_RATIO to quantify shape spread in relation to radial variations.
# Usefulness: Highlights the spread of shape characteristics across different sizes, aiding in type differentiation.
df['scatter_radius_ratio'] = df['SCATTER_RATIO'] / df['RADIUS_RATIO']
end

python
# axis_discrepancy
# Difference between PR.AXIS_ASPECT_RATIO and MAX.LENGTH_ASPECT_RATIO.
# Usefulness: Captures discrepancies in aspect ratios across axes, indicative of shape proportions.
df['axis_discrepancy'] = df['PR.AXIS_ASPECT_RATIO'] - df['MAX.LENGTH_ASPECT_RATIO']
end

python
# variance_balance
# Difference between SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCALED_VARIANCE_ALONG_MINOR_AXIS.
# Usefulness: Measures variance imbalance along major and minor axes, essential for capturing asymmetrical properties.
df['variance_balance'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# normalized_gyration
# Log transformation of SCALED_RADIUS_OF_GYRATION to normalize its scale.
# Usefulness: Reduces skew and generates a useful input scale for machine learning models.
df['normalized_gyration'] = np.log(df['SCALED_RADIUS_OF_GYRATION'])
end

python
# kurtosis_ratio
# Ratio of KURTOSIS_ABOUT_MAJOR_AXIS to KURTOSIS_ABOUT_MINOR_AXIS.
# Usefulness: Highlights asymmetry in shape peakedness, distinguishing vehicle body types.
df['kurtosis_ratio'] = df['KURTOSIS_ABOUT_MAJOR_AXIS'] / df['KURTOSIS_ABOUT_MINOR_AXIS']
end

python
# skewness_symmetry_sq
# Square of the difference between SKEWNESS_ABOUT_MAJOR_AXIS and SKEWNESS_ABOUT_MINOR_AXIS.
# Usefulness: Encodes symmetry deviations of skewness, useful for detecting asymmetrical shape properties.
df['skewness_symmetry_sq'] = (df['SKEWNESS_ABOUT_MAJOR_AXIS'] - df['SKEWNESS_ABOUT_MINOR_AXIS'])  2
end

python
# distribution_mean_variance
# Mean of SCALED_VARIANCE_ALONG_MAJOR_AXIS, SCALED_VARIANCE_ALONG_MINOR_AXIS, and SCALED_RADIUS_OF_GYRATION.
# Usefulness: Captures aggregated shape distribution variance, providing an overall measure of complexity.
df['distribution_mean_variance'] = df[['SCALED_VARIANCE_ALONG_MAJOR_AXIS', 'SCALED_VARIANCE_ALONG_MINOR_AXIS', 'SCALED_RADIUS_OF_GYRATION']].mean(axis=1)
end

python
# shape_compactness_indicator
# Product of COMPACTNESS and CIRCULARITY for joint compactness and shape roundness measure.
# Usefulness: Detects combined effects of compactness and roundness that are relevant to vehicle silhouettes.
df['shape_compactness_indicator'] = df['COMPACTNESS'] * df['CIRCULARITY']
end

python
# area_efficiency_metric
# Normalized structural complexity combining RADIUS_RATIO, ELONGATEDNESS, and SCATTER_RATIO.
# Usefulness: Measures overall structural efficiency and complexity by incorporating multiple geometry features.
df['area_efficiency_metric'] = (df['RADIUS_RATIO'] + df['ELONGATEDNESS']) / df['SCATTER_RATIO']
end

python
# hollow_per_aspect_ratio
# Ratio of HOLLOWS_RATIO to PR.AXIS_ASPECT_RATIO.
# Usefulness: Encodes efficiency of hollows relative to aspect ratio, indicative of vehicle interior structure balance.
df['hollow_per_aspect_ratio'] = df['HOLLOWS_RATIO'] / df['PR.AXIS_ASPECT_RATIO']
end

