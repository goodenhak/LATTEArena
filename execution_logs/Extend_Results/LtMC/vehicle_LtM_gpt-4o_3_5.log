# Z-score standardization of SCATTER_RATIO across its distribution.
# Usefulness: Standardizes the symmetry measure, better highlighting relative differences between vehicle types.
df['zscore_scatter_ratio'] = (df['SCATTER_RATIO'] - df['SCATTER_RATIO'].mean()) / df['SCATTER_RATIO'].std()
end

