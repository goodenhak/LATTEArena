df['log_distribution_mean_variance'] = np.log(df['distribution_mean_variance'])
end

python
# max_length_pr_interaction
# Interaction of MAX.LENGTH_ASPECT_RATIO with PR.AXIS_RECTANGULARITY to combine shape elongation and rectangularity.
