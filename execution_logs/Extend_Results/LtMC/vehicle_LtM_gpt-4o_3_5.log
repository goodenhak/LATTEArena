# log_distribution_mean_variance
# Log transformation of distribution_mean_variance to manage large numeric ranges and emphasize smaller differences.
# Usefulness: Enhances interpretability of spread and variance dynamics across vehicle types by reducing scale effects.
df['log_distribution_mean_variance'] = df['distribution_mean_variance'].apply(np.log)
end

python
# elongation_compactness_ratio
# Ratio of PR.AXIS_RECTANGULARITY to ELONGATEDNESS to capture compactness vs. proportional elongation.
# Usefulness: Differentiates between vehicle types based on how compact or elongated their silhouettes are.
df['elongation_compactness_ratio'] = df['PR.AXIS_RECTANGULARITY'] / df['ELONGATEDNESS']
end

python
# combined_shape_density
# Product of MAX.LENGTH_ASPECT_RATIO and PR.AXIS_RECTANGULARITY to represent combined geometric density.
# Usefulness: Highlights interplay between length proportions and compactness across silhouettes.
df['combined_shape_density'] = df['MAX.LENGTH_ASPECT_RATIO'] * df['PR.AXIS_RECTANGULARITY']
end

python
# local_spread_asymmetry
# Difference between SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCATTER_RATIO to highlight spread asymmetry.
# Usefulness: Differentiates vehicles with varying degrees of mass distribution and structure.
df['local_spread_asymmetry'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] - df['SCATTER_RATIO']
end

python
# cubic_kurtosis_ratio
# Cube of kurtosis_ratio to amplify subtle differences in higher-order shape dynamics.
# Usefulness: Captures extreme tail behavior in shape variation to distinguish certain vehicle types.
df['cubic_kurtosis_ratio'] = df['kurtosis_ratio']  3
end

python
# scaled_normalized_gyration
# Z-score normalization of normalized_gyration to center and scale its values.
# Usefulness: Standardizes gyration disparities related to the scale and distributions across vehicle types.
df['scaled_normalized_gyration'] = (df['normalized_gyration'] - df['normalized_gyration'].mean()) / df['normalized_gyration'].std()
end

python
