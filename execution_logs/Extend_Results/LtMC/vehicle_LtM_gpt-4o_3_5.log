df['product_pr_axis_rectangularity_hollows_ratio'] = df['PR.AXIS_RECTANGULARITY'] * df['HOLLOWS_RATIO']
end

python
# log_hollows_ratio
# Log-transform of the HOLLOWS_RATIO to reduce skewness and highlight differences.
# Usefulness: This transformation enhances sensitivity to smaller variations in hollow percentage, which might correlate with specific vehicle types.
df['log_hollows_ratio'] = np.log(df['HOLLOWS_RATIO'])
end

python
# log_scatter_ratio
# Log-transform of SCATTER_RATIO to reduce skewness and highlight differences.
# Usefulness: Makes the distribution of the ratio of inertias more linear and interpretable for classification.
df['log_scatter_ratio'] = np.log(df['SCATTER_RATIO'])
end

python
# exp_hollow_per_aspect_ratio
# Exponential transformation of hollow_per_aspect_ratio to emphasize larger ratios.
# Usefulness: This transformation gives greater weight to significant outlier ratios, which are more likely to reflect distinct differences in silhouette geometry.
df['exp_hollow_per_aspect_ratio'] = np.exp(df['hollow_per_aspect_ratio'])
end

python
# diff_normalized_gyration_distribution_mean_variance
# Difference between normalized_gyration and distribution_mean_variance.
# Usefulness: Highlights discrepancies between gyration and variance metrics to understand the distribution patterns further.
df['diff_normalized_gyration_distribution_mean_variance'] = df['normalized_gyration'] - df['distribution_mean_variance']
end

python
# sum_scaled_variance_features
# Sum of SCALED_VARIANCE_ALONG_MAJOR_AXIS, SCATTER_RATIO, and distribution_mean_variance.
# Usefulness: Provides a combined measure of variance-related properties of the silhouette, capturing overall shape variability.
df['sum_scaled_variance_features'] = (
    df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] +
    df['SCATTER_RATIO'] +
    df['distribution_mean_variance']
)
end

python
# max_scaled_variance_features
# Maximum of SCALED_VARIANCE_ALONG_MAJOR_AXIS, SCATTER_RATIO, and distribution_mean_variance.
# Usefulness: Identifies the dominant variance-related feature for each silhouette, emphasizing the most discriminative aspect of variability.
df['max_scaled_variance_features'] = df[['SCALED_VARIANCE_ALONG_MAJOR_AXIS', 'SCATTER_RATIO', 'distribution_mean_variance']].max(axis=1)
end

python
# zscore_skewness_major_axis
# Z-score normalization of SKEWNESS_ABOUT_MAJOR_AXIS.
# Usefulness: Standardizes the skewness metric for interpretability while accounting for outliers highlighting significant deviations in skewness.
df['zscore_skewness_major_axis'] = (df['SKEWNESS_ABOUT_MAJOR_AXIS'] - df['SKEWNESS_ABOUT_MAJOR_AXIS'].mean()) / df['SKEWNESS_ABOUT_MAJOR_AXIS'].std()
end

