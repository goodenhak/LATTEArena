# HOLLOWS_RATIO / ELONGATEDNESS
# Ratio between hollows and stretchiness of the silhouette.
# Usefulness: Differentiates silhouettes like buses (longer and stretched) from sedans or vans (compact with fewer hollows).
df['hollows_to_elongatedness'] = df['HOLLOWS_RATIO'] / df['ELONGATEDNESS']
end

python
# PR.AXIS_RECTANGULARITY / MAX.LENGTH_ASPECT_RATIO
# Compactness relative to the object's length-to-width proportions.
# Usefulness: Identifies differences in packing density, helping distinguish shapes like buses (compact) versus SAAB or OPEL.
df['rectangularity_to_aspect_ratio'] = df['PR.AXIS_RECTANGULARITY'] / df['MAX.LENGTH_ASPECT_RATIO']
end

python
# sqrt(SCALED_VARIANCE_ALONG_MAJOR_AXIS)
# Square root of scaled variance along the major axis.
# Usefulness: Smoothens the variance feature for a better representation across vehicle classes.
df['sqrt_variance_major_axis'] = np.sqrt(df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'])
end

python
# log(ELONGATEDNESS)
# Natural logarithm of elongation values.
# Usefulness: Highlights subtle differences in vehicle shapes with significant stretchiness, such as buses.
df['log_elongatedness'] = np.log(df['ELONGATEDNESS'] + 1)
end

python
# zscore(normalized_gyration)
# Z-score of normalized gyration.
# Usefulness: Standardizes spatial distribution-related features for robustness, making it less sensitive to scale differences.
df['zscore_normalized_gyration'] = (df['normalized_gyration'] - df['normalized_gyration'].mean()) / df['normalized_gyration'].std()
end

python
# SCATTER_RATIO / distribution_mean_variance
# Ratio between scatter and mean variance across dimensions.
# Usefulness: Captures shape distribution consistency, differentiating symmetrical silhouettes (VAN) from others.
df['scatter_to_variance'] = df['SCATTER_RATIO'] / df['distribution_mean_variance']
end

python
# HOLLOWS_RATIO * SCATTER_RATIO
# Product of hollow area ratio and distribution scatter ratio.
# Usefulness: Encodes combined effects of area distribution and symmetry, useful for distinguishing between hollow-heavy silhouettes like OPEL.
df['hollows_scatter_interaction'] = df['HOLLOWS_RATIO'] * df['SCATTER_RATIO']
end

python
# MAX.LENGTH_ASPECT_RATIO * SKEWNESS_ABOUT_MAJOR_AXIS
# Interaction between aspect ratio and silhouette asymmetry.
# Usefulness: Reflects how asymmetry along the major axis interacts with the shape's proportion, distinguishing asymmetrical forms like SAAB.
df['aspect_skew_interaction'] = df['MAX.LENGTH_ASPECT_RATIO'] * df['SKEWNESS_ABOUT_MAJOR_AXIS']
end

python
# rolling_mean(SKEWNESS_ABOUT_MAJOR_AXIS, window=3)
# Rolling mean of skewness about major axis with a window of 3.
# Usefulness: Detects local asymmetry patterns, helping isolate noise and identify common trends within classes.
df['rolling_skew_major'] = df['SKEWNESS_ABOUT_MAJOR_AXIS'].rolling(window=3).mean()
end

python
# bin(HOLLOWS_RATIO, thresholds=[190, 200])
# Binarized hollows ratio using thresholds.
# Usefulness: Separates critical hollow areas, distinguishing SAAB or van-like vehicles with hollows in the 190-200 range.
df['hollows_ratio_bin'] = pd.cut(df['HOLLOWS_RATIO'], bins=[0, 190, 200, np.inf], labels=[0, 1, 2])
end

python
# Drop uninformative columns to reduce redundancy.
df.drop(columns=['SCALED_VARIANCE_ALONG_MAJOR_AXIS', 'normalized_gyration'], inplace=True)
end
