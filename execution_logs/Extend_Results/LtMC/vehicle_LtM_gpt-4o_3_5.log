.\n# Usefulness: Enhances non-linear relationships in structural hollowness combined with aspect proportions.\ndf['hollow_per_aspect_ratio_squared'] = df['hollow_per_aspect_ratio']  2", "# neg_kurtosis_ratio\n# Negative of kurtosis_ratio.\n# Usefulness: Inverts the values to better capture high kurtosis dynamics in specific geometries.\ndf['neg_kurtosis_ratio'] = -df['kurtosis_ratio']", "# sqrt_ELONGATEDNESS\n# Square root of ELONGATEDNESS.\n# Usefulness: Reduces the effect of larger elongatedness values for better numerical stability.\ndf['sqrt_ELONGATEDNESS'] = np.sqrt(df['ELONGATEDNESS'])", "# cross_maxlength_scatter_ratio\n# Cross term of MAX.LENGTH_ASPECT_RATIO and SCATTER_RATIO.\n# Usefulness: Captures interactions between overall aspect ratio and inertia spread.\ndf['cross_maxlength_scatter_ratio'] = df['MAX.LENGTH_ASPECT_RATIO'] * df['SCATTER_RATIO']", "# zscore_distribution_mean_variance\n# Z-score normalization of distribution_mean_variance.\n# Usefulness: Standardizes variance distribution metrics for consistent comparison.\ndf['zscore_distribution_mean_variance'] = (df['distribution_mean_variance'] - df['distribution_mean_variance'].mean()) / df['distribution_mean_variance'].std()", "# reciprocal_distance_elongatedness_ratio\n# Reciprocal of distance_elongatedness_ratio.\n# Usefulness: Highlights inverse elongation and spread dynamics for distinguishing central-shaped structures.\ndf['reciprocal_distance_elongatedness_ratio'] = 1 / df['distance_elongatedness_ratio']"]
