# log_MAX.LENGTH_ASPECT_RATIO
# Log transformation of MAX.LENGTH_ASPECT_RATIO to reduce the impact of large outliers and normalize the distribution.
# Usefulness: Helps capture nuanced differences in aspect ratios without excessive weight on extreme values, enabling better shape-based separation.
df['log_MAX.LENGTH_ASPECT_RATIO'] = np.log(df['MAX.LENGTH_ASPECT_RATIO'])
end

python
# sqrt_ELONGATEDNESS
# Square root transformation of ELONGATEDNESS to normalize its scale and reduce skewness.
# Usefulness: Creates a more interpretable measure of elongation by smoothing the influence of larger values.
df['sqrt_ELONGATEDNESS'] = np.sqrt(df['ELONGATEDNESS'])
end

python
# ratio_MAX.LENGTH_ASPECT_ELONGATEDNESS
# Ratio of MAX.LENGTH_ASPECT_RATIO to ELONGATEDNESS.
# Usefulness: Extracts the relative interaction between length aspect and elongation, distinguishing vehicle types with similar individual measures but varied proportions.
df['ratio_MAX.LENGTH_ASPECT_ELONGATEDNESS'] = df['MAX.LENGTH_ASPECT_RATIO'] / df['ELONGATEDNESS']
end

python
# zscore_distribution_mean_variance
# Z-score normalization of distribution_mean_variance.
# Usefulness: Centers and scales the variance measure for better comparability across features and reducing the impact of scale on model decisions.
df['zscore_distribution_mean_variance'] = (df['distribution_mean_variance'] - df['distribution_mean_variance'].mean()) / df['distribution_mean_variance'].std()
end

python
# zscore_normalized_gyration
# Z-score normalization of normalized_gyration.
# Usefulness: Standardizes the spread measure, better highlighting differences between vehicle silhouettes along their gyration scales.
df['zscore_normalized_gyration'] = (df['normalized_gyration'] - df['normalized_gyration'].mean()) / df['normalized_gyration'].std()
end

python
# diff_distribution_gyration
# Difference between distribution_mean_variance and normalized_gyration.
# Usefulness: Identifies interplay between overall variance and gyrational spread, creating a composite feature highlighting their relationship.
df['diff_distribution_gyration'] = df['distribution_mean_variance'] - df['normalized_gyration']
end

python
# log_hollow_per_aspect_ratio
# Log transformation of hollow_per_aspect_ratio.
# Usefulness: Reduces the impact of extreme values while maintaining the interpretability of hollow-to-aspect-ratio comparisons for distinguishing silhouettes.
df['log_hollow_per_aspect_ratio'] = np.log(df['hollow_per_aspect_ratio'])
end

python
# log_SCATTER_RATIO
# Log transformation of SCATTER_RATIO.
# Usefulness: Smooths the distribution of scatter measures, better capturing nuanced variations across configurations.
df['log_SCATTER_RATIO'] = np.log(df['SCATTER_RATIO'])
end

python
# ratio_SCATTER_hollow
# Ratio of SCATTER_RATIO to hollow_per_aspect_ratio.
# Usefulness: Links scatter and hollow properties of the silhouette, creating a composite feature for multidimensional shape distinctions.
df['ratio_SCATTER_hollow'] = df['SCATTER_RATIO'] / df['hollow_per_aspect_ratio']
end

python
# diff_SCATTER_MAJOR_VARIANCE
# Difference between SCATTER_RATIO and SCALED_VARIANCE_ALONG_MAJOR_AXIS.
# Usefulness: Highlights how major-axis variance differs dynamically from scatter properties, capturing subtle shape variations.
df['diff_SCATTER_MAJOR_VARIANCE'] = df['SCATTER_RATIO'] - df['SCALED_VARIANCE_ALONG_MAJOR_AXIS']
end

python
# groupbythenmean_SCATTER_by_target
# Group mean of SCATTER_RATIO by target class.
# Usefulness: Encodes class-level trends in scatter properties, aiding in class discrimination at a higher aggregate level.
df['groupbythenmean_SCATTER_by_target'] = df.groupby('target')['SCATTER_RATIO'].transform('mean')
end

python
# groupbythenstd_ELONGATEDNESS_by_target
# Group standard deviation of ELONGATEDNESS by target class.
# Usefulness: Captures class-level variability in elongation, enhancing differentiation based on consistency or diversity within a class.
df['groupbythenstd_ELONGATEDNESS_by_target'] = df.groupby('target')['ELONGATEDNESS'].transform('std')
end

python
# drop_FEATURE_LESS_IMPACT
# Dropping HOLLOWS_RATIO since it overlaps significantly with hollow_per_aspect_ratio and derived interactions add more value.
# Usefulness: Simplifies the feature space by eliminating redundancy while retaining relevant derived information.
