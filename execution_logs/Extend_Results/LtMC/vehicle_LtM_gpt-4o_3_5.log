Highlights asymmetry in shape peakedness, distinguishing vehicle body types.\ndf['kurtosis_ratio'] = df['KURTOSIS_ABOUT_MAJOR_AXIS'] / df['KURTOSIS_ABOUT_MINOR_AXIS']", "# skewness_symmetry_sq\n# Square of the difference between SKEWNESS_ABOUT_MAJOR_AXIS and SKEWNESS_ABOUT_MINOR_AXIS.\n# Usefulness: Encodes symmetry deviations of skewness, useful for detecting asymmetrical shape properties.\ndf['skewness_symmetry_sq'] = (df['SKEWNESS_ABOUT_MAJOR_AXIS'] - df['SKEWNESS_ABOUT_MINOR_AXIS'])  2", "# distribution_mean_variance\n# Mean of SCALED_VARIANCE_ALONG_MAJOR_AXIS, SCALED_VARIANCE_ALONG_MINOR_AXIS, and SCALED_RADIUS_OF_GYRATION.\n# Usefulness: Captures aggregated shape distribution variance, providing an overall measure of complexity.\ndf['distribution_mean_variance'] = df[['SCALED_VARIANCE_ALONG_MAJOR_AXIS', 'SCALED_VARIANCE_ALONG_MINOR_AXIS', 'SCALED_RADIUS_OF_GYRATION']].mean(axis=1)", "# shape_compactness_indicator\n# Product of COMPACTNESS and CIRCULARITY for joint compactness and shape roundness measure.\n# Usefulness: Detects combined effects of compactness and roundness that are relevant to vehicle silhouettes.\ndf['shape_compactness_indicator'] = df['COMPACTNESS'] * df['CIRCULARITY']", "# area_efficiency_metric\n# Normalized structural complexity combining RADIUS_RATIO, ELONGATEDNESS, and SCATTER_RATIO.\n# Usefulness: Measures overall structural efficiency and complexity by incorporating multiple geometry features.\ndf['area_efficiency_metric'] = (df['RADIUS_RATIO'] + df['ELONGATEDNESS']) / df['SCATTER_RATIO']", "# hollow_per_aspect_ratio\n# Ratio of HOLLOWS_RATIO to PR.AXIS_ASPECT_RATIO.\n# Usefulness: Encodes efficiency of hollows relative to aspect ratio, indicative of vehicle interior structure balance.\ndf['hollow_per_aspect_ratio'] = df['HOLLOWS_RATIO'] / df['PR.AXIS_ASPECT_RATIO']", "df.drop(columns=[\n    'KURTOSIS_ABOUT_MINOR_AXIS', \n    'SKEWNESS_ABOUT_MINOR_AXIS'\n], inplace=True)"]
