# compactness_to_distance_circularity
# Ratio between COMPACTNESS and DISTANCE_CIRCULARITY to measure shape-density relationships.
# Usefulness: Highlights compactness in relation to silhouette's area-to-distance ratio, helping distinguish densely packed vehicle types.

df['compactness_to_distance_circularity'] = df['COMPACTNESS'] / df['DISTANCE_CIRCULARITY']
end

python
# pr_axis_aspect_to_max_length_aspect
# Ratio between PR.AXIS_ASPECT_RATIO and MAX.LENGTH_ASPECT_RATIO to assess proportional relationships between axes.
# Usefulness: Identifies variances in proportions along key structural axes within different vehicle silhouettes.

df['pr_axis_aspect_to_max_length_aspect'] = df['PR.AXIS_ASPECT_RATIO'] / df['MAX.LENGTH_ASPECT_RATIO']
end

python
# scaled_variance_minor_to_major
# Ratio of SCALED_VARIANCE_ALONG_MINOR_AXIS to SCALED_VARIANCE_ALONG_MAJOR_AXIS to highlight variance imbalance.
# Usefulness: Distinguishes variance distribution along principal axes, helping classify vehicles with asymmetric structural features.

df['scaled_variance_minor_to_major'] = df['SCALED_VARIANCE_ALONG_MINOR_AXIS'] / df['SCALED_VARIANCE_ALONG_MAJOR_AXIS']
end

python
# log_scaled_radius_of_gyration
# Log transformation of SCALED_RADIUS_OF_GYRATION to reduce skewness and emphasize smaller differences.
# Usefulness: Stabilizes feature distribution for improved handling of varying spread across vehicle types.

df['log_scaled_radius_of_gyration'] = np.log(df['SCALED_RADIUS_OF_GYRATION'])
end

python
# skewness_to_kurtosis_major
# Ratio of SKEWNESS_ABOUT_MAJOR_AXIS to KURTOSIS_ABOUT_MAJOR_AXIS to combine two higher-order moment descriptors.
# Usefulness: Captures shape distribution peculiarities combining skewness and peakedness, helping identify unique patterns.

df['skewness_to_kurtosis_major'] = df['SKEWNESS_ABOUT_MAJOR_AXIS'] / df['KURTOSIS_ABOUT_MAJOR_AXIS']
end

python
# sine_pr_axis_aspect
# Sine of PR.AXIS_ASPECT_RATIO to capture periodic relationships in proportional axes configurations.
# Usefulness: Emphasizes subtle proportional differences in the axis configurations, useful for angled vehicle views.

df['sine_pr_axis_aspect'] = np.sin(df['PR.AXIS_ASPECT_RATIO'])
end

python
# compactness_rank
# Rank transformation of COMPACTNESS within its distribution.
# Usefulness: Encodes relative compactness position, providing ordinal insights useful for distinguishing vehicle shapes.

df['compactness_rank'] = df['COMPACTNESS'].rank()
end

python
# scatter_ratio_zscore
# Z-score normalization of SCATTER_RATIO for scale-independent analysis.
# Usefulness: Reduces sensitivity to scatter range variations across different vehicles.

df['scatter_ratio_zscore'] = (df['SCATTER_RATIO'] - df['SCATTER_RATIO'].mean()) / df['SCATTER_RATIO'].std()
end

python
# elongatedness_squared
# Square transformation of ELONGATEDNESS to emphasize non-linear geometries.
# Usefulness: Highlights differences in elongated shapes that may be subtle otherwise.

df['elongatedness_squared'] = df['ELONGATEDNESS']  2
end

python
# skewness_minor_negated
# Negation of SKEWNESS_ABOUT_MINOR_AXIS to invert distribution for comparison.
# Usefulness: Allows analysis of inverse pattern skewness, improving feature interpretability.

df['skewness_minor_negated'] = -df['SKEWNESS_ABOUT_MINOR_AXIS']
end

python
df.drop(columns=['HOLLOWS_RATIO'], inplace=True)
end
