gated shapes.\n# Usefulness: Distinguishes wide elongated vehicles (BUS, VAN) from compact ones (OPEL).\ndf['DISTANCE_ELONGATEDNESS_RATIO'] = df['DISTANCE_CIRCULARITY'] / df['ELONGATEDNESS']", "# ZSCORE_SCALED_RADIUS_GYRATION\n# Z-score normalization of scaled radius of gyration to standardize mass distribution assessment.\n# Usefulness: Enables better comparability of radial compactness deviations across vehicles.\ndf['ZSCORE_SCALED_RADIUS_GYRATION'] = (df['SCALED_RADIUS_OF_GYRATION'] - df['SCALED_RADIUS_OF_GYRATION'].mean()) / df['SCALED_RADIUS_OF_GYRATION'].std()", "df.drop(columns=['AREA_AXIS_RATIO', 'HOLLOWS_MAJOR_AXIS_RATIO', 'ELONGATEDNESS'], inplace=True)"]
