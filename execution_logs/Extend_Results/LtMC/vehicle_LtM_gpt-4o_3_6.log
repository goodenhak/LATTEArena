# MAX_LENGTH_ASPECT_RATIO_DIV_PR_AXIS_ASPECT_RATIO
# Ratio of maximum length aspect ratio to principal axis aspect ratio to capture the relationship between elongation and axis proportions.
# Usefulness: Highlights vehicles with extreme elongation (e.g., BUS) compared to more symmetric ones (e.g., OPEL).
df['MAX_LENGTH_ASPECT_RATIO_DIV_PR_AXIS_ASPECT_RATIO'] = df['MAX.LENGTH_ASPECT_RATIO'] / df['PR.AXIS_ASPECT_RATIO']
end

python
# SCALED_RADIUS_VARIANCE_RATIO
# Ratio of scaled radius of gyration to scaled variance along the major axis to assess radial spread vs longitudinal spread.
# Usefulness: Differentiates vehicles with distributed vs concentrated mass features.
df['SCALED_RADIUS_VARIANCE_RATIO'] = df['SCALED_RADIUS_OF_GYRATION'] / df['SCALED_VARIANCE_ALONG_MAJOR_AXIS']
end

python
# COMPACT_CIRCULAR_RATIO_LOG_DIFF
# Difference of logarithmic compactness and circularity to enhance compactness-circularity differences.
# Usefulness: Enhances separation between compact (e.g., OPEL) and elongated types (e.g., BUS).
df['COMPACT_CIRCULAR_RATIO_LOG_DIFF'] = np.log(df['COMPACTNESS']) - np.log(df['CIRCULARITY'])
end

python
# SKWNESS_DIFF_KURTOSIS_RATIO
# Ratio of skewness difference across axes to kurtosis sum, capturing asymmetry relative to shape peakedness.
# Usefulness: Highlights asymmetry outliers and characterizes vehicle imbalance (e.g., asymmetric VAN vs balanced OPEL).
df['SKWNESS_DIFF_KURTOSIS_RATIO'] = (df['SKEWNESS_ABOUT_MAJOR_AXIS'] - df['SKEWNESS_ABOUT_MINOR_AXIS']) / df['KURTOSIS_SUM']
end

python
# HOLLOWS_RATIO_AXIS_BALANCE
# Ratio of hollows ratio to area-axis ratio to evaluate hollows proportionality relative to overall axis balance.
# Usefulness: Captures hollow tendencies in vehicles (e.g., hollow-heavy BUS vs hollow-light OPEL).
df['HOLLOWS_RATIO_AXIS_BALANCE'] = df['HOLLOWS_RATIO'] / df['AREA_AXIS_RATIO']
end

python
# DISTANCE_ELONGATEDNESS_RATIO
# Ratio of distance circularity to elongatedness to assess border spread in elongated shapes.
# Usefulness: Distinguishes wide elongated vehicles (BUS, VAN) from compact ones (OPEL).
df['DISTANCE_ELONGATEDNESS_RATIO'] = df['DISTANCE_CIRCULARITY'] / df['ELONGATEDNESS']
end

python
# ZSCORE_SCALED_RADIUS_GYRATION
# Z-score normalization of scaled radius of gyration to standardize mass distribution assessment.
# Usefulness: Enables better comparability of radial compactness deviations across vehicles.
df['ZSCORE_SCALED_RADIUS_GYRATION'] = (df['SCALED_RADIUS_OF_GYRATION'] - df['SCALED_RADIUS_OF_GYRATION'].mean()) / df['SCALED_RADIUS_OF_GYRATION'].std()
end

python
df.drop(columns=['AREA_AXIS_RATIO', 'HOLLOWS_MAJOR_AXIS_RATIO', 'ELONGATEDNESS'], inplace=True)
end
