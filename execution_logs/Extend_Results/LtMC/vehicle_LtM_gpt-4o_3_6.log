df['Z_SKEW_MAJOR'] = (df['SKEWNESS_ABOUT_MAJOR_AXIS'] - df['SKEWNESS_ABOUT_MAJOR_AXIS'].mean()) / df['SKEWNESS_ABOUT_MAJOR_AXIS'].std()
end

python
