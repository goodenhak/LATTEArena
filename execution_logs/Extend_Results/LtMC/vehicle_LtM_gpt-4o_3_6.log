2026-05-26 02:34:04,145 - INFO - ops_string = ["# CIRCULARITY_ELONGATEDNESS\n# Product of CIRCULARITY and ELONGATEDNESS to combine overall shape and elongation effects, helping to distinguish rounded (OPEL) vs elongated (BUS) vehicles.\n# Usefulness: Highlights joint properties of rounded vs elongation, a critical differentiator in silhouette distinctions.\ndf['CIRCULARITY_ELONGATEDNESS'] = df['CIRCULARITY'] * df['ELONGATEDNESS']", "# COMPACTNESS_LENGTH_RATIO\n# Ratio of COMPACTNESS to MAX.LENGTH_ASPECT_RATIO to emphasize compactness relative to silhouette length proportion.\n# Usefulness: Differentiates compact designs (e.g., OPEL) from elongated profiles (e.g., VAN), leveraging proportional compactness.\ndf['COMPACTNESS_LENGTH_RATIO'] = df['COMPACTNESS'] / df['MAX.LENGTH_ASPECT_RATIO']", "# SYMMETRY_SKEW_SUM\n# Sum of SKEWNESS_ABOUT_MAJOR_AXIS and SKEWNESS_ABOUT_MINOR_AXIS to capture total symmetry skewness.\n# Usefulness: Detects overall asymmetry, discriminating classes with less balanced designs (e.g., SAAB).\ndf['SYMMETRY_SKEW_SUM'] = df['SKEWNESS_ABOUT_MAJOR_AXIS'] + df['SKEWNESS_ABOUT_MINOR_AXIS']", "# SYMMETRY_SKEW_DIFF\n# Difference between SKEWNESS_ABOUT_MAJOR_AXIS and SKEWNESS_ABOUT_MINOR_AXIS to assess asymmetry balance across axes.\n# Usefulness: Improves differentiation for silhouettes with pronounced asymmetry, such as certain VAN or SAAB designs.\ndf['SYMMETRY_SKEW_DIFF'] = df['SKEWNESS_ABOUT_MAJOR_AXIS'] - df['SKEWNESS_ABOUT_MINOR_AXIS']", "# ASYMMETRY_PEAK_JOINT_EFFECT\n# Product of MAJOR_MINOR_SKEWNESS_DIFF and KURTOSIS_SUM to combine effects of asymmetry and peakedness.\n# Usefulness: Detects joint asymmetry-peakedness, relevant for distinguishing asymmetric designs like SAAB.\ndf['ASYMMETRY_PEAK_JOINT_EFFECT'] = df['MAJOR_MINOR_SKEWNESS_DIFF'] * df['KURTOSIS_SUM']", "# HOLLOWS_SPREAD_RATIO\n# Ratio of HOLLOWS_RATIO to SCALED_RADIUS_OF_GYRATION to evaluate hollows relative to how mass is distributed spatially.\n# Usefulness: Highlights how hollow areas interact with overall mass spread, key for BUS vs VAN differentiation.\ndf['HOLLOWS_SPREAD_RATIO'] = df['HOLLOWS_RATIO'] / df['SCALED_RADIUS_OF_GYRATION']", "# HOLLOWS_AXIS_ALIGNMENT\n# Ratio of HOLLOWS_MAJOR_AXIS_RATIO to PR.AXIS_ASPECT_RATIO to emphasize hollow alignment with aspect ratios.\n# Usefulness: Differentiates hollow configurations based on the aspect proportions, especially useful for BUS silhouettes.\ndf['HOLLOWS_AXIS_ALIGNMENT'] = df['HOLLOWS_MAJOR_AXIS_RATIO'] / df['PR.AXIS_ASPECT_RATIO']", "# RECTANGULARITY_COMBO\n# Product of RECTANGULARITY_RATIO and MAX.LENGTH_RECTANGULARITY for combined rectangular features.\n# Usefulness: Highlights combined rectangular properties to better distinguish VANs from other vehicle types.\ndf['RECTANGULARITY_COMBO'] = df['RECTANGULARITY_RATIO'] * df['MAX.LENGTH_RECTANGULARITY']", "# AREA_LENGTH_PROPORTIONALITY\n# Product of AREA_AXIS_RATIO and MAX.LENGTH_ASPECT_RATIO to integrate area proportionality with length-based dimensions.\n# Usefulness: Differentiates between vehicles based on the proportional relationships of length and area (e.g., VAN vs BUS).\ndf['AREA_LENGTH_PROPORTIONALITY'] = df['AREA_AXIS_RATIO'] * df['MAX.LENGTH_ASPECT_RATIO']", "# LOG_RADIUS_SPREAD\n# Logarithm of RADIUS_RATIO to reduce skewness and emphasize radial spread differences.\n# Usefulness: Highlights radial deviations which are key for classifying OPEL and other less elongated vehicles.\ndf['LOG_RADIUS_SPREAD'] = np.log(df['RADIUS_RATIO'])", "# LOG_GYRATION_SPREAD\n# Logarithm of SCALED_RADIUS_OF_GYRATION to normalize scale and focus on spatial distribution.\n# Usefulness: Captures proportional distribution differences, aiding in distinguishing elongated from rounded designs.\ndf['LOG_GYRATION_SPREAD'] = np.log(df['SCALED_RADIUS_OF_GYRATION'])", "# Z_KURTOSIS\n# Z-score normalized version of KURTOSIS_SUM for scale normalization across classes.\n# Usefulness: Normalizes kurtosis for fair comparison, capturing peakedness differences among vehicle prototypes.\ndf['Z_KURTOSIS'] = (df['KURTOSIS_SUM'] - df['KURTOSIS_SUM'].mean()) / df['KURTOSIS_SUM'].std()", "# Z_SKEW_MAJOR\n# Z-score normalization of SKEWNESS_ABOUT_MAJOR_AXIS for consistent scale across vehicle classes.\n# Usefulness: Allows direct comparison of skewness across vehicles to highlight major axis asymmetry patterns.\ndf['Z_SKEW_MAJOR'] = (df['SKEWNESS_ABOUT_MAJOR_AXIS'] - df['SKEWNESS_ABOUT_MAJOR_AXIS'].mean()) / df['SKEWNESS_ABOUT_MAJOR_AXIS'].std()", "# Z_SKEW_MINOR\n# Z-score normalization of SKEWNESS_ABOUT_MINOR_AXIS to maintain consistency in asymmetry feature scales.\n# Usefulness: Highlights minor axis asymmetry patterns without scale biases, improving classification accuracy.\ndf['Z_SKEW_MINOR'] = (df['SKEWNESS_ABOUT_MINOR_AXIS'] - df['SKEWNESS_ABOUT_MINOR_AXIS'].mean()) / df['SKEWNESS_ABOUT_MINOR_AXIS'].std()", "# Dropping potentially redundant features\ndf.drop(columns=['RADIUS_RATIO', 'SCALED_RADIUS_OF_GYRATION'], inplace=True)"]
