['CIRCULARITY_COMPACTNESS_RATIO'] = df['COMPACTNESS'] / df['CIRCULARITY']", "# MAJOR_MINOR_SCATTER_DIFFERENCE\n# Difference between SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCALED_VARIANCE_ALONG_MINOR_AXIS for dynamic scatter analysis.\n# Usefulness: Distinguishes vehicles based on variance contrasts in axis distributions, useful for separating SAAB and VAN.\ndf['MAJOR_MINOR_SCATTER_DIFFERENCE'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MINOR_AXIS']", "# NORMALIZED_HOLLOWS_RATIO\n# MinMax scaling of HOLLOWS_RATIO for uniform comparability.\n# Usefulness: Normalizes hollows-based features to study internal voids in vehicles with complex structures.\ndf['NORMALIZED_HOLLOWS_RATIO'] = (df['HOLLOWS_RATIO'] - 181) / (211 - 181)", "df.drop(columns=['SKEWNESS_ABOUT_MINOR_AXIS'], inplace=True)", "df.drop(columns=['KURTOSIS_ABOUT_MINOR_AXIS'], inplace=True)", "df.drop(columns=['PR.AXIS_RECTANGULARITY'], inplace=True)", "df.drop(columns=['CIRCULARITY'], inplace=True)"]
