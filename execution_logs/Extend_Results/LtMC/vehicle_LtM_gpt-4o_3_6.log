# compact_circularity_ratio
# Ratio of COMPACTNESS to CIRCULARITY. Highlights balance between overall outline shape and circular tendencies.
# Usefulness: Differentiates vehicles with more spread-out designs (e.g., Buses) from compact ones (e.g., Cars).
df['compact_circularity_ratio'] = df['COMPACTNESS'] / df['CIRCULARITY']
end

python
# elongation_distance_ratio
# Ratio of ELONGATEDNESS to DISTANCE_CIRCULARITY. Emphasizes how stretched a vehicle appears relative to boundary uniformity.
# Usefulness: Helps distinguish between elongated vehicles (Vans, Buses) and shorter, compact vehicles (Cars).
df['elongation_distance_ratio'] = df['ELONGATEDNESS'] / df['DISTANCE_CIRCULARITY']
end

python
# axis_ratio_interaction
# Ratio of PR.AXIS_ASPECT_RATIO to MAX.LENGTH_ASPECT_RATIO. Captures inter-axis proportional relationship.
# Usefulness: Differentiates vehicles based on axis symmetry and relative proportions, robust to angular viewpoint changes.
df['axis_ratio_interaction'] = df['PR.AXIS_ASPECT_RATIO'] / df['MAX.LENGTH_ASPECT_RATIO']
end

python
# hollow_log_scaled
# Log-transformed HOLLOWS_RATIO to reduce skewness and emphasize proportional differences.
# Usefulness: Makes hollow regions in vehicles (e.g., Windows) more discernible between types.
df['hollow_log_scaled'] = np.log(df['HOLLOWS_RATIO'])
end

python
# scaled_variance_minor_zscore
# Z-score transformation of SCALED_VARIANCE_ALONG_MINOR_AXIS. Highlights deviations in length-wise dispersion.
# Usefulness: Identifies vehicles with unusual dispersion characteristics, such as stretched or bulky designs.
df['scaled_variance_minor_zscore'] = (df['SCALED_VARIANCE_ALONG_MINOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MINOR_AXIS'].mean()) / df['SCALED_VARIANCE_ALONG_MINOR_AXIS'].std()
end

python
# scatter_radius_ratio
# Ratio of SCATTER_RATIO to SCALED_RADIUS_OF_GYRATION. Links inertia with overall spread of silhouette points.
# Usefulness: Differentiates vehicles with dense vs scattered shapes, useful for distinguishing compact cars from larger vehicles.
df['scatter_radius_ratio'] = df['SCATTER_RATIO'] / df['SCALED_RADIUS_OF_GYRATION']
end

python
# skewness_major_scaled
# Z-score transformation of SKEWNESS_ABOUT_MAJOR_AXIS. Captures major axis asymmetry relative to dataset distribution.
# Usefulness: Highlights irregular contours along vehicle length, helping to classify asymmetric designs.
df['skewness_major_scaled'] = (df['SKEWNESS_ABOUT_MAJOR_AXIS'] - df['SKEWNESS_ABOUT_MAJOR_AXIS'].mean()) / df['SKEWNESS_ABOUT_MAJOR_AXIS'].std()
end

python
# kurtosis_combined_diff
# Difference between KURTOSIS_ABOUT_MAJOR_AXIS and KURTOSIS_ABOUT_MINOR_AXIS. Compares peakedness on major vs minor axes.
# Usefulness: Distinguishes different surface distribution patterns between major and minor contours.
df['kurtosis_combined_diff'] = df['KURTOSIS_ABOUT_MAJOR_AXIS'] - df['KURTOSIS_ABOUT_MINOR_AXIS']
end

python
# compactness_binned
# Discretized bins of COMPACTNESS, separating values into predefined intervals.
