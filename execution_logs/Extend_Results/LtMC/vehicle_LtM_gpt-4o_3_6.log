# COMPACTNESS_CIRCULARITY_RATIO
# The ratio of Compactness to Circularity to highlight compactness differences as a function of circularity; useful for distinguishing rounded vehicles (OPEL) from elongated ones (BUS).
# Usefulness: Helps capture how compactness scales with circularity, highlighting geometric and proportional differences across vehicle types.
df['COMPACTNESS_CIRCULARITY_RATIO'] = df['COMPACTNESS'] / df['CIRCULARITY']
end

python
# RECTANGULARITY_RATIO
# The ratio of PR.AXIS_RECTANGULARITY to MAX.LENGTH_RECTANGULARITY to identify rectangular features across axis-related dimensions.
# Usefulness: Differentiates boxy features (VAN) from more compact vehicles (OPEL) and highlights dominant axis rectangularity differences.
df['RECTANGULARITY_RATIO'] = df['PR.AXIS_RECTANGULARITY'] / df['MAX.LENGTH_RECTANGULARITY']
end

python
# MAJOR_MINOR_SKEWNESS_DIFF
# Difference between skewness about major and minor axes to capture asymmetry imbalance along these axes.
# Usefulness: Differentiates asymmetrical vehicles like BUS from more symmetrical ones like OPEL and SAAB.
df['MAJOR_MINOR_SKEWNESS_DIFF'] = df['SKEWNESS_ABOUT_MAJOR_AXIS'] - df['SKEWNESS_ABOUT_MINOR_AXIS']
end

python
# HOLLOWS_MAJOR_AXIS_RATIO
# Ratio of hollows area to scaled variance along the major axis to examine hollow distributions relative to major axis spread.
# Usefulness: Differentiates structural shapes (e.g., SAAB vs. VAN) by capturing how hollows scale with major axis variation.
df['HOLLOWS_MAJOR_AXIS_RATIO'] = df['HOLLOWS_RATIO'] / df['SCALED_VARIANCE_ALONG_MAJOR_AXIS']
end

python
# ELONGATEDNESS_RADIUS_RATIO
# Ratio of Elongatedness to Scaled Radius of Gyration to capture relative area squareness compared to the radius of gyration.
# Usefulness: Highlights differences between compact vehicles (OPEL) and elongated ones (BUS or VAN).
df['ELONGATEDNESS_RADIUS_RATIO'] = df['ELONGATEDNESS'] / df['SCALED_RADIUS_OF_GYRATION']
end

python
# KURTOSIS_SUM
# Sum of kurtosis about major and minor axes to quantify the aggregate peakedness structure of a silhouette.
# Usefulness: Identifies sharp shape edges and protrusions, distinguishing OPEL from other classes like VAN.
df['KURTOSIS_SUM'] = df['KURTOSIS_ABOUT_MAJOR_AXIS'] + df['KURTOSIS_ABOUT_MINOR_AXIS']
end

python
# NORMALIZED_SCATTER_RATIO
# Z-score normalized Scatter Ratio to highlight consistent scale differences in inertia properties for identifying distinct vehicle types.
# Usefulness: Standardizes Scatter Ratio values for uniform comparison across varying vehicle sizes (e.g., BUS vs. SAAB).
df['NORMALIZED_SCATTER_RATIO'] = (df['SCATTER_RATIO'] - df['SCATTER_RATIO'].mean()) / df['SCATTER_RATIO'].std()
end

python
# LOG_VARIANCE_MINOR_AXIS
# Log-transformed Scaled Variance Along Minor Axis to reduce skewness for heavily dispersed distributions.
# Usefulness: Enhances interpretability for features like spatial inertia that vary significantly across vehicle classes.
df['LOG_VARIANCE_MINOR_AXIS'] = np.log1p(df['SCALED_VARIANCE_ALONG_MINOR_AXIS'])
end

python
# AREA_AXIS_RATIO
# Ratio of Elongatedness to PR.AXIS_ASPECT_RATIO to highlight the relationship between area and aspect ratio along principal axes.
# Usefulness: Useful for distinguishing elongated structures like BUS from compact shapes like SAAB.
df['AREA_AXIS_RATIO'] = df['ELONGATEDNESS'] / df['PR.AXIS_ASPECT_RATIO']
end

python
# Z_NORMALIZED_RADIUS_RATIO
# Z-score normalized Radius Ratio to highlight deviations in radial spread that distinguish silhouettes.
# Usefulness: Standardizes variations in max and min radii profiles, aiding classification between elongated (BUS) and compact vehicles (OPEL/SAAB).
df['Z_NORMALIZED_RADIUS_RATIO'] = (df['RADIUS_RATIO'] - df['RADIUS_RATIO'].mean()) / df['RADIUS_RATIO'].std()
end

