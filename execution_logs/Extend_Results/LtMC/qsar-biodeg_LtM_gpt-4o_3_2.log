# SdO_log
# Log transformation of SdO to compress large values and capture relative differences in higher ranges.
# Usefulness: Handles high variance and emphasizes smaller-scale variations in SdO for predicting biodegradability.
df['SdO_log'] = np.log1p(df['SdO'])
end

python
# nO_Me_ratio
# Ratio of number of oxygen atoms to mean atomic Sanderson electronegativity.
# Usefulness: Provides insights into the proportional impact of oxygen on reactivity patterns relative to electronegativity.
df['nO_Me_ratio'] = df['nO'] / (df['Me'] + 1e-8)
end

