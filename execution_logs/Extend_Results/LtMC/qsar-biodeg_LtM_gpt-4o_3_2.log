# SdO_log
# Log transformation of SdO to normalize its range and emphasize differences in its lower values.
# Usefulness: SdO, capturing E-state sums of oxygen, links to chemical reactivity and biodegradability.
df['SdO_log'] = np.log1p(df['SdO'])
end

python
# nO_nN_ratio
# Ratio of oxygen atoms (nO) to nitrogen atoms (nN) to understand the balance of electronegative atoms in the compound.
# Usefulness: Highlights chemical composition balance critical for biodegradability properties.
df['nO_nN_ratio'] = df['nO'] / (df['nN'] + 1e-9) # Prevent division by zero
end

python
# SpMax_L_C_per_ratio
# Ratio of SpMax_L to C% (percentage of carbon atoms) to incorporate structural connectivity normalized by carbon content.
# Usefulness: Links topological structure to the molecule's carbon-based content, impacting degradability.
df['SpMax_L_C_per_ratio'] = df['SpMax_L'] / (df['C%'] + 1e-9)
end

python
# nHDon_plus_nO
# Sum of donor atoms for H-bonds (nHDon) and number of oxygen atoms (nO).
# Usefulness: Highlights molecular features linked to hydrogen bonding and reactivity.
df['nHDon_plus_nO'] = df['nHDon'] + df['nO']
end

python
# J_Dz_e_Me_interaction
# Product of J_Dz(e) and Me to capture interactions between electronegativity indices and Barýsz matrix properties.
# Usefulness: Links electronic properties to overall biodegradability.
df['J_Dz_e_Me_interaction'] = df['J_Dz(e)'] * df['Me']
end

python
# SpPosA_B_p_zscore
# Z-score normalization of SpPosA_B(p), the normalized spectral positive sum.
# Usefulness: Standardizes this property for machine learning models and highlights outliers.
df['SpPosA_B_p_zscore'] = (df['SpPosA_B(p)'] - df['SpPosA_B(p)'].mean()) / df['SpPosA_B(p)'].std()
end

python
