# SdO_log
# Log transformation of SdO to compress large values and capture relative differences in higher ranges.
# Usefulness: Handles high variance and emphasizes smaller-scale variations in SdO for predicting biodegradability.
df['SdO_log'] = np.log1p(df['SdO'])
end

python
# nO_Me_ratio
# Ratio of number of oxygen atoms to mean atomic Sanderson electronegativity.
# Usefulness: Provides insights into the proportional impact of oxygen on reactivity patterns relative to electronegativity.
df['nO_Me_ratio'] = df['nO'] / (df['Me'] + 1e-8)
end

python
# nN_nHDon_product
# Interaction feature combining nitrogen atoms and hydrogen bond donors.
# Usefulness: Highlights molecules with the potential for strong hydrogen bonding or special structural roles.
df['nN_nHDon_product'] = df['nN'] * df['nHDon']
end

python
# Rare_Feature_Count_Normalized
# Functional group aggregation normalized by heavy atom count.
# Usefulness: Adjusts for molecule size when considering rare feature contributions affecting biodegradability.
df['Rare_Feature_Count_Normalized'] = df['Functional_Group_Sum'] / (df['nHM'] + 1e-8)
end

python
# Branching_Index
# Ratio of SpMax_B(m) to SpMax_L, capturing molecular branching or compactness.
# Usefulness: Differentiates between linear and branched molecules, which impact degradation pathways.
df['Branching_Index'] = df['SpMax_B(m)'] / (df['SpMax_L'] + 1e-8)
end

python
# F_N_CNO_Sum
# Cumulative sum of functional group counts involving nitrogen, oxygen, and carbon atoms.
# Usefulness: Models the overall density of reactive groups influencing biodegradability.
df['F_N_CNO_Sum'] = df[['F02[C-N]', 'F03[C-N]', 'F04[C-N]', 'F03[C-O]']].sum(axis=1)
end

python
# log_TI2_L
# Log transformation of TI2_L for compressing large values and balancing distribution skew.
# Usefulness: Focuses on smaller-range structural topology effects that drive biodegradability.
df['log_TI2_L'] = np.log1p(df['TI2_L'])
end

python
# Zscore_Sanderson_MI
# Z-score normalization of the Mean atomic Sanderson electronegativity and ionization potential product.
# Usefulness: Highlights deviations in combined electronic properties which might indicate unique degradation pathways.
sanderson_mi = df['Me'] * df['Mi']
df['Zscore_Sanderson_MI'] = (sanderson_mi - sanderson_mi.mean()) / (sanderson_mi.std() + 1e-8)
end

python
# nArNO2_scaled
# Min-max scaling of aromatic nitro groups.
# Usefulness: Allows models to evaluate nitro contributions in a comparable range, crucial for nitro-bearing compounds.
df['nArNO2_scaled'] = (df['nArNO2'] - df['nArNO2'].min()) / (df['nArNO2'].max() - df['nArNO2'].min() + 1e-8)
