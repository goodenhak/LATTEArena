# log_SdO_sqrt
# Log transformation of SdO_sqrt to handle its high variance and potential skewness.
# Usefulness: Compresses high values of SdO_sqrt, further refining the interpretability of oxygen-related properties.
df['log_SdO_sqrt'] = np.log1p(df['SdO_sqrt'])
end

python
# nHDon_to_nO_ratio
# Ratio of number of donor atoms for H-bonds to the number of oxygen atoms (nHDon/nO).
# Usefulness: Captures the efficiency of hydrogen bonds as a function of oxygen content, which can influence biodegradability.
df['nHDon_to_nO_ratio'] = df['nHDon'] / (df['nO'] + 1e-10)
end

python
# log_Functional_Group_Sum
# Log transformation of Functional_Group_Sum to manage its high variance.
# Usefulness: Highlights aggregate functional group contributions while mitigating effects of outliers.
df['log_Functional_Group_Sum'] = np.log1p(df['Functional_Group_Sum'])
end

python
# nO_Me_interaction_squared
# Square of nO_Me_interaction to emphasize higher-order effects of oxygen-electronegativity relationships.
# Usefulness: Amplifies the effect of larger values of oxygen-related interactions on biodegradability.
df['nO_Me_interaction_squared'] = df['nO_Me_interaction']  2
end

python
# C_ratio_nHM_ratio
# Ratio of carbon-heavy atom intensity (C_ratio) to the number of heavy atoms (nHM).
# Usefulness: Highlights how carbon content contributes proportionally to the makeup of heavy atoms.
df['C_ratio_nHM_ratio'] = df['C_ratio'] / (df['nHM'] + 1e-10)
end

python
# SdssC_abs
# Absolute value of SdssC for exploring extreme effects of dssC E-states.
# Usefulness: Removes negative effects, allowing a clearer comparison of structural similarities.
df['SdssC_abs'] = np.abs(df['SdssC'])
end

python
# SpMax_L_rolling_mean
# Rolling mean of SpMax_L with a window size of 3.
# Usefulness: Captures localized structural/topological variations in leading eigenvalue trends.
df['SpMax_L_rolling_mean'] = df['SpMax_L'].rolling(window=3, min_periods=1).mean()
end

python
# SpMax_L_TI2_L_log_ratio
# Logarithm of the ratio SpMax_L to TI2_L.
# Usefulness: Enhances interpretability by transforming ratios into log space to stabilize variance.
df['SpMax_L_TI2_L_log_ratio'] = np.log1p(df['SpMax_L_TI2_L_ratio'])
end

python
# C_percent_normalized
# Min-max normalization of C% to scale between 0 and 1.
# Usefulness: Standardizes C% for better integration with machine learning algorithms.
df['C_percent_normalized'] = (df['C%'] - df['C%'].min()) / (df['C%'].max() - df['C%'].min())
end

python
# Me_to_Mi_ratio
# Ratio of mean atomic Sanderson electronegativity (Me) to mean first ionization potential (Mi).
# Usefulness: Shows electronegativity properties in comparison to ionization potential.
df['Me_to_Mi_ratio'] = df['Me'] / (df['Mi'] + 1e-10)
end

python
# Rare_Feature_Presence_Category
# Conversion of binary Rare_Feature_Presence to a categorical one-hot encoding.
# Usefulness: Makes this binary indicator explicit for downstream classification tasks.
df = pd.concat([df, pd.get_dummies(df['Rare_Feature_Presence'], prefix='Rare_Feature')], axis=1)
end

python
# log_nArNO2_plus_one
# Log transformation of nArNO2 plus 1 to scale sparse aromatic nitro groups.
# Usefulness: Handles non-linearity in rare aromatic nitro groups while smoothing out the sparse distribution.
df['log_nArNO2_plus_one'] = np.log1p(df['nArNO2'])
end

python
# drop_SpMax_L_zscore
df.drop(columns=['SpMax_L_zscore'], inplace=True)
end

python
# drop_Psi_i_1d_abs
df.drop(columns=['Psi_i_1d_abs'], inplace=True)
end

python
# drop_C-026
df.drop(columns=['C-026'], inplace=True)
end

python
# drop_F01[N-N]
df.drop(columns=['F01[N-N]'], inplace=True)
end
