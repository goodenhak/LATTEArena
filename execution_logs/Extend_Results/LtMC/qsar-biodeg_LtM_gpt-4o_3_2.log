# SpMax_L_log
# Log transformation of SpMax_L to stabilize variance and potentially capture exponential relationships.
# Usefulness: SpMax_L is a leading eigenvalue from the Laplace matrix and might have exponential behavior related to molecular topology.
df['SpMax_L_log'] = np.log1p(df['SpMax_L'])
end

python
# C_ratio_O
# Ratio of carbon percentage to oxygen atoms (C_ratio / (nO + 1)) to measure carbon-to-oxygen balance.
# Usefulness: The ratio helps quantify molecular balance between carbon and oxygen, critical for assessing biodegradability.
df['C_ratio_O'] = df['C%'] / (df['nO'] + 1)
end

python
# nN_nO_interaction
# Interaction term between the number of nitrogen and oxygen atoms (nN * nO).
# Usefulness: Nitrogen and oxygen-rich compounds can influence biodegradability through various chemical pathways.
df['nN_nO_interaction'] = df['nN'] * df['nO']
end

python
# Functional_Group_Interaction
# Interaction between F04[C-N] and F02[C-N] to emphasize joint occurrence of functional groups.
# Usefulness: Interaction of C-N bonds at different topological distances could indicate complex molecular structures affecting biodegradability.
df['Functional_Group_Interaction'] = df['F04[C-N]'] * df['F02[C-N]']
end

python
# SM6_B_HyWi_ratio
# Ratio of Spectral Moment 6 (Burden matrix) to Hyper-Wiener index (SM6_B(m) / HyWi_B(m)).
# Usefulness: This ratio highlights relationships between spectral descriptors and molecular specificity.
df['SM6_B_HyWi_ratio'] = df['SM6_B(m)'] / df['HyWi_B(m)']
end

python
# Functional_Group_LogSum
# Log transformation of Functional_Group_Sum to stabilize high variance in counts of functional groups.
# Usefulness: Emphasizes the aggregate effect of functional group frequencies while reducing extreme variances.
df['Functional_Group_LogSum'] = np.log1p(df['Functional_Group_Sum'])
end

python
# Rare_Feature_Count
# Summation of rare feature occurrences for nArCOOR, nN-N, and nCRX3.
# Usefulness: Combines sparse features into one metric for detecting rare but relevant patterns in biodegradation.
df['Rare_Feature_Count'] = df['Rare_Feature_Presence'].sum(axis=1)
end

python
# Psi_i_1d_sqrt
# Square root transformation of Psi_i_1d_abs for extreme-value stability.
# Usefulness: Enhances edge cases and smoothens the distribution of intrinsic state pseudoconnectivity.
df['Psi_i_1d_sqrt'] = np.sqrt(df['Psi_i_1d_abs'])
end

python
# nCb-_group_mean
# Mean of substituted benzene carbons (nCb-) at a group level using target encoding.
# Usefulness: Group-level behavior of aromatic carbons may strongly correlate with biodegradability.
df['nCb_group_mean'] = df.groupby('Answer')['nCb-'].transform('mean')
end

python
# SM6_L_TI2_L_product
# Product of SM6_L and TI2_L to capture high-order relationships between spectral and topological descriptors.
# Usefulness: Combines spectral and topological impact on molecular biodegradability.
df['SM6_L_TI2_L_product'] = df['SM6_L'] * df['TI2_L']
end

python
df.drop(columns=['C_ratio'], inplace=True)
end

python
df.drop(columns=['Functional_Group_Sum'], inplace=True)
end
