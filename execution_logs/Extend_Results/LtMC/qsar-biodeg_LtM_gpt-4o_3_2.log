# SpMax_L_zscore
# Z-score normalization of the SpMax_L feature to normalize its scale.
# Usefulness: Allows the model to handle SpMax_L in a standardized scale, improving the interpretation and optimization process.
df['SpMax_L_zscore'] = (df['SpMax_L'] - df['SpMax_L'].mean()) / df['SpMax_L'].std()
end

python
# Functional_Group_Sum
# Aggregation of sparse functional group frequencies using cumulative sum: F01[N-N], F04[C-N], F03[C-N], F02[C-N].
# Usefulness: Helps summarize the overall presence of functional groups involved in nitrogen chemistry, correlated with biodegradability.
df['Functional_Group_Sum'] = df['F01[N-N]'] + df['F04[C-N]'] + df['F03[C-N]'] + df['F02[C-N]']
end

python
# SdO_sqrt
# Square root transformation of the SdO feature to handle its high variance.
# Usefulness: Reduces the variability of the descriptor while keeping the internal ordering of values intact.
df['SdO_sqrt'] = df['SdO'].apply(lambda x: np.sqrt(x))
end

python
# C_ratio
# Ratio of carbon percentage to the number of heavy atoms (C_ratio = C% / nHM).
# Usefulness: Highlights the carbon density in relation to molecular size, aiding in distinguishing structures relevant to biodegradability.
df['C_ratio'] = df['C%'] / (df['nHM'] + 1e-5)
end

python
# nO_Me_interaction
# Interaction between number of oxygen atoms and mean atomic Sanderson electronegativity.
# Usefulness: Captures the influence of oxygen-related electronegativity on molecular stability and biodegradability.
df['nO_Me_interaction'] = df['nO'] * df['Me']
end

python
# SpMax_L_TI2_L_ratio
# Ratio of SpMax_L to TI2_L (SpMax_L_TI2_L_ratio = SpMax_L / TI2_L).
