# SpMax_L_J_Dz_ratio
# Ratio of SpMax_L to J_Dz(e). Indicates how molecular connectivity scales with electronic and topological properties.
# Usefulness: Captures a relationship between molecular structure and electronegativity/topological features.
df['SpMax_L_J_Dz_ratio'] = df['SpMax_L'] / df['J_Dz(e)']
end

python
# Functional_N_O_H_ratio
# Ratio of functional groups to a combined count of oxygen atoms and hydrogen donors (Functional_Group_Sum / (nO + nHDon + 1)).
# Usefulness: Highlights the density of functional groups in relation to oxygen and H-bond donors affecting biodegradability.
df['Functional_N_O_H_ratio'] = df['Functional_Group_Sum'] / (df['nO'] + df['nHDon'] + 1)
end

python
# SdO_normalized
# Normalized SdO feature via z-score transformation to remove scale effects.
# Usefulness: Normalizing the distribution helps compare SdO values on a meaningful scale.
df['SdO_normalized'] = (df['SdO'] - df['SdO'].mean()) / df['SdO'].std()
end

python
# nHetero_ratio
# Ratio of heteroatoms (nO, nN, nX) to the count of heavy atoms (nHM).
# Usefulness: Heteroatom content relative to molecular bulk strongly influences chemical properties and biodegradability.
df['nHetero_ratio'] = (df['nO'] + df['nN'] + df['nX']) / (df['nHM'] + 1)
end

python
# SM6_L_TI2_L_diff
# Difference between SM6_L and TI2_L (SM6_L - TI2_L).
# Usefulness: Combines spectral moment and topological features to extract differentiating patterns in molecular structure.
df['SM6_L_TI2_L_diff'] = df['SM6_L'] - df['TI2_L']
end

python
# C_SdO_interaction
# Interaction between carbon percentage (C%) and oxygen E-states (SdO) (C% * SdO).
# Usefulness: Highlights oxygen-specific effects in carbon-rich chemical compounds.
df['C_SdO_interaction'] = df['C%'] * df['SdO']
end

python
# log_SM6_B
# Log transformation of SM6_B(m) to stabilize variance (log(SM6_B(m) + 1)).
# Usefulness: Smoothed spectral moment provides robust representation under high variance.
df['log_SM6_B'] = np.log(df['SM6_B(m)'] + 1)
end

python
# Rare_Feature_Functional_Interaction
# Interaction term for rare feature presence and functional group sum (Rare_Feature_Presence * Functional_Group_Sum).
# Usefulness: Amplifies sparse data contributions from rare features and functional groups.
df['Rare_Feature_Functional_Interaction'] = df['Rare_Feature_Presence'] * df['Functional_Group_Sum']
end

python
# SpMax_A_HyWi_B
# Interaction between SpMax_A and HyWi_B(m) (SpMax_A * HyWi_B(m)).
# Usefulness: Reflects joint molecular connectivity and mass distribution contributions to biodegradability.
df['SpMax_A_HyWi_B'] = df['SpMax_A'] * df['HyWi_B(m)']
end

python
# SM6_L_rolling_std
# Rolling standard deviation of SM6_L across a window size of 5.
# Usefulness: Captures local variance in spectral moment data over extended observation windows.
df['SM6_L_rolling_std'] = df['SM6_L'].rolling(window=5, min_periods=1).std()
end

