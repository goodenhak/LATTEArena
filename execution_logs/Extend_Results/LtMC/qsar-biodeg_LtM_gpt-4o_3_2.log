end

python
# Rare_Feature_Count_Normalized
# Functional group aggregation normalized by heavy atom count.
# Usefulness: Adjusts for molecule size when considering rare feature contributions affecting biodegradability.
df['Rare_Feature_Count_Normalized'] = df['Functional_Group_Sum'] / (df['nHM'] + 1e-8)
end

python
# Branching_Index
# Ratio of SpMax_B(m) to SpMax_L, capturing molecular branching or compactness.
# Usefulness: Differentiates between linear and branched molecules, which impact degradation pathways.
df['Branching_Index'] = df['SpMax_B(m)'] / (df['SpMax_L'] + 1e-8)
end

python
