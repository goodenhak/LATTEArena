# nO_log
# Logarithmic transformation of nO (Number of oxygen atoms) to reduce high variance and emphasize smaller values.
# Usefulness: Reduces skewness in nO and highlights its influence on biodegradability as oxygen is critical in biodegradation processes.
df['nO_log'] = np.log1p(df['nO'])
end

python
# SpMax_Bm_zscore
# Z-score normalization of SpMax_B(m) (Burden matrix leading eigenvalue) to normalize its scale.
# Usefulness: Normalizes this spectral feature derived from the molecule's mass-weighted structure, making it comparable across samples.
df['SpMax_Bm_zscore'] = (df['SpMax_B(m)'] - df['SpMax_B(m)'].mean()) / df['SpMax_B(m)'].std()
end

python
# nO_div_C_ratio
# Ratio of nO (Number of oxygen atoms) to C_ratio (Ratio of carbon percentage to heavy atoms).
# Usefulness: This feature captures oxygen's availability relative to carbon as a possible driver of biodegradability.
df['nO_div_C_ratio'] = df['nO'] / df['C_ratio']
end

python
# nHDon_Me_interaction
# Interaction between nHDon (Number of H-bond donors) and Me (Mean atomic Sanderson electronegativity).
# Usefulness: Highlights the role of hydrogen bonding and electronegativity in chemical biodegradation.
df['nHDon_Me_interaction'] = df['nHDon'] * df['Me']
end

python
# SdO_per_heavy_atom
# Ratio of SdO (Sum of dO E-states) to nHM (Number of heavy atoms).
# Usefulness: Indicates the oxidative functionalization per heavy atom in the chemical structure, relevant for degradation.
df['SdO_per_heavy_atom'] = df['SdO'] / (df['nHM'] + 1e-5)
end

python
# Functional_Group_RareFlag
# Binary indicator for the presence of Functional_Group_Sum > 5.
# Usefulness: Highlights higher functional groups contributing to biodegradability categorization.
df['Functional_Group_RareFlag'] = (df['Functional_Group_Sum'] > 5).astype(int)
end

python
# log_C_ratio
# Logarithmic transformation of the C_ratio feature to handle its wide range and skewness.
# Usefulness: Prepares C_ratio for better compatibility in machine learning models.
df['log_C_ratio'] = np.log1p(df['C_ratio'])
end

python
# F_C_N_density
# Combined density of all C-N frequencies (F02[C-N], F03[C-N], F04[C-N]).
# Usefulness: Aggregates all relevant C-N distance contributions, significant for identifying nitrogenous compounds in degradation.
df['F_C_N_density'] = df['F02[C-N]'] + df['F03[C-N]'] + df['F04[C-N]']
end

python
# SM6_Bm_to_SpMax_A_ratio
# Ratio of SM6_B(m) (Spectral moment of mass weighting) to SpMax_A (Adjacency matrix leading eigenvalue).
# Usefulness: Captures interplay between global spectral properties and adjacency in molecular structures.
df['SM6_Bm_to_SpMax_A_ratio'] = df['SM6_B(m)'] / df['SpMax_A']
end

python
df.drop(columns=['C_ratio'], inplace=True)
end

python
df.drop(columns=['Functional_Group_Sum'], inplace=True)
end

python
df.drop(columns=['TI2_L'], inplace=True)
end
