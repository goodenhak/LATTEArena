e learning models.\ndf['log_C_ratio'] = np.log1p(df['C_ratio'])", "# F_C_N_density\n# Combined density of all C-N frequencies (F02[C-N], F03[C-N], F04[C-N]).\n# Usefulness: Aggregates all relevant C-N distance contributions, significant for identifying nitrogenous compounds in degradation.\ndf['F_C_N_density'] = df['F02[C-N]'] + df['F03[C-N]'] + df['F04[C-N]']", "# SM6_Bm_to_SpMax_A_ratio\n# Ratio of SM6_B(m) (Spectral moment of mass weighting) to SpMax_A (Adjacency matrix leading eigenvalue).\n# Usefulness: Captures interplay between global spectral properties and adjacency in molecular structures.\ndf['SM6_Bm_to_SpMax_A_ratio'] = df['SM6_B(m)'] / df['SpMax_A']", "df.drop(columns=['C_ratio'], inplace=True)", "df.drop(columns=['Functional_Group_Sum'], inplace=True)", "df.drop(columns=['TI2_L'], inplace=True)"]
