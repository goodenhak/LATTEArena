# feature_log_debt
# Log transformation of Debt: Log(Debt + 1e-6) to reduce skewness and stabilize variance.
# Usefulness: Debt is skewed; log transformation ensures better representation of its magnitude in predictive models.
df['feature_log_debt'] = df['Debt'].apply(lambda x: np.log(x + 1e-6))
end

python
# feature_combined_financial_stress
# Combination of feature_debt_to_income_ratio and feature_relative_debt_burden: (feature_debt_to_income_ratio * feature_relative_debt_burden).
# Usefulness: Provides a compounded measure of financial stress, combining two critical metrics of debt and burden.
df['feature_combined_financial_stress'] = df['feature_debt_to_income_ratio'] * df['feature_relative_debt_burden']
end

python
# feature_industry_income_ratio
# Ratio of Income to Industry Average Income: Income / groupby_industry_avg_income.
# Usefulness: Highlights deviation in applicant's earning ability compared to peers in the same industry.
df['feature_industry_income_ratio'] = df['Income'] / (df['groupby_industry_avg_income'] + 1e-6)
end

python
# feature_zipcode_relative_debt
# Ratio of Debt to ZipCode Median Debt: Debt / (groupby_zipcode_median_debt + 1e-6).
# Usefulness: Contextualizes debt as relative to peers within the same locality (ZipCode group).
df['feature_zipcode_relative_debt'] = df['Debt'] / (df['groupby_zipcode_median_debt'] + 1e-6)
end

python
# feature_employment_credit_interaction
# Interaction of normalized_years_employed and credit_employment_interaction: normalized_years_employed * credit_employment_interaction.
# Usefulness: Captures the intertwined relationship between employment duration and credit behavior.
df['feature_employment_credit_interaction'] = df['normalized_years_employed'] * df['credit_employment_interaction']
end

python
# feature_binned_relative_debt_burden
# Binned version of feature_relative_debt_burden using quartiles.
# Usefulness: Allows model to capture nonlinear relationships in levels of debt burden more effectively.
df['feature_binned_relative_debt_burden'] = pd.qcut(df['feature_relative_debt_burden'], q=4, labels=False)
end

python
# feature_citizen_stability_interaction
# Interaction of citizen_Temporary and feature_stability_score: citizen_Temporary * feature_stability_score.
# Usefulness: Measures how temporary citizenship impacts composite stability and credit success.
df['feature_citizen_stability_interaction'] = df['citizen_Temporary'] * df['feature_stability_score']
end

python
# feature_adjusted_credit_score
# Adjusted Credit Score by interacting groupby_industry_avg_credit_score and feature_stability_score: groupby_industry_avg_credit_score * feature_stability_score.
# Usefulness: Combines industry-level credit averages with applicant stability signal to better assess credit risk.
df['feature_adjusted_credit_score'] = df['groupby_industry_avg_credit_score'] * df['feature_stability_score']
end

python
# feature_marital_stability
# Interaction of Married and feature_stability_score: Married * feature_stability_score.
# Usefulness: Captures potential boost in stability from marital status, enhancing stability-derived predictions.
df['feature_marital_stability'] = df['Married'] * df['feature_stability_score']
end

python
# feature_one_hot_industry
# One-hot encoding of Industry.
# Usefulness: Enables the model to understand categorical distinctions within Industry without imposing ordinal bias.
df = pd.get_dummies(df, columns=['Industry'], prefix='industry')
end

python
