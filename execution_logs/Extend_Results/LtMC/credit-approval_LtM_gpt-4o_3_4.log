end

python
# sqrt_credit_score
# Square root transformation of CreditScore to reduce skewness and normalize the feature.
# Usefulness: Reduces the impact of outliers in the CreditScore variable and highlights small differences in lower credit scores.
df['sqrt_credit_score'] = df['CreditScore'].apply(lambda x: np.sqrt(x))
end

python
# normalized_years_employed
# Z-Score normalization of YearsEmployed.
# Usefulness: Measures employment tenure in a standardized way for better comparability across applicants.
df['normalized_years_employed'] = (df['YearsEmployed'] - df['YearsEmployed'].mean()) / df['YearsEmployed'].std()
end

python
# reciprocal_prior_default
# Reciprocal transformation of PriorDefault (1 - PriorDefault).
