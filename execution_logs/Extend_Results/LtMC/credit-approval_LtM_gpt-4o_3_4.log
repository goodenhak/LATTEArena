2026-05-26 11:26:39,954 - INFO - ops_string = ["# log_feature_debt_to_income_ratio\n# Log transformation of feature_debt_to_income_ratio to handle high skewness and compress large values.\n# Usefulness: Compresses wide-ranging debt-to-income ratios for better model interpretation.\ndf['log_feature_debt_to_income_ratio'] = df['feature_debt_to_income_ratio'].apply(lambda x: np.log(x + 1e-6))", "# debt_stability_interaction\n# Interaction between feature_stability_score and Debt to represent how individual stability correlates with debt levels.\n# Usefulness: Captures the joint effect of personal stability and financial liabilities.\ndf['debt_stability_interaction'] = df['feature_stability_score'] * df['Debt']", "# relative_income_ethnicity_interaction\n# Interaction of feature_normalized_income with ethnicity_Asian to understand income dynamics controlled by demographics.\n# Usefulness: Highlights variations in financial behavior across ethnic groups.\ndf['relative_income_ethnicity_interaction'] = df['feature_normalized_income'] * df['ethnicity_Asian'].astype(int)", "# credit_stability_industry_composite\n# Interaction between groupby_industry_avg_credit_score and feature_stability_score for a composite credit stability measure.\n# Usefulness: Captures how personal stability interacts with industry-based credit norms.\ndf['credit_stability_industry_composite'] = df['groupby_industry_avg_credit_score'] * df['feature_stability_score']", "# employment_debt_zscore\n# Z-Score of normalized_years_employed grouped by Debt to capture relative employment stability relative to financial burden.\n# Usefulness: Identifies employment stability nuances among applicants with varying debt levels.\ndf['employment_debt_zscore'] = df.groupby('Debt')['normalized_years_employed'].transform(lambda x: (x - x.mean()) / x.std())", "# stability_gender_interaction\n# Interaction of feature_stability_score with Gender to capture behavioral differences in stability across genders.\n# Usefulness: Incorporates demographic stability variations into the model.\ndf['stability_gender_interaction'] = df['feature_stability_score'] * df['Gender']", "# debt_zipcode_normalized\n# Ratio of Debt to groupby_zipcode_median_debt for localized debt normalization.\n# Usefulness: Contextualizes financial liabilities based on debt patterns within the applicant's zipcode.\ndf['debt_zipcode_normalized'] = df['Debt'] / (df['groupby_zipcode_median_debt'] + 1e-6)", "# stability_employment_interaction\n# Multiplication of feature_stability_score and normalized_years_employed to capture combined stability.\n# Usefulness: Highlights individuals who are both personally and professionally stable.\ndf['stability_employment_interaction'] = df['feature_stability_score'] * df['normalized_years_employed']", "# feature_dropped_columns\n# Columns dropped for redundancy or reduced information gain.\ndf.drop(columns=['feature_ethnicity_income_interaction', 'feature_log_zipcode_median_debt'], inplace=True)"]
