# feature_debt_to_income_ratio
# Debt-to-Income Ratio: Ratio of an individual's debt to their income (Debt / (Income + 1e-6)).
# Usefulness: Helps measure financial reliability by comparing debt burden against income levels, critical for assessing repayment ability.
df['feature_debt_to_income_ratio'] = df['Debt'] / (df['Income'] + 1e-6)
end

python
# feature_relative_debt_burden
# Relative Debt Burden: Debt relative to the median debt of applicants in the same zipcode (Debt / groupby_zipcode_median_debt).
# Usefulness: Highlights whether an individual's debt is unusually high or low compared to regional norms, reflecting financial stress in geographical context.
df['feature_relative_debt_burden'] = df['Debt'] / (df['groupby_zipcode_median_debt'] + 1e-6)
end

python
# feature_stability_score
# Composite Stability Score: A combined score incorporating Married, DriversLicense, and BankCustomer (Married + DriversLicense + BankCustomer).
# Usefulness: A holistic signal of personal and financial stability, combining marital status, possession of a driver's license, and a bank account.
df['feature_stability_score'] = df['Married'] + df['DriversLicense'] + df['BankCustomer']
end

python
# feature_normalized_income
# Normalized Income: Applicant's income relative to their industry's average income (Income / groupby_industry_avg_income).
# Usefulness: Provides a standardized measure of income competitiveness within the same industry, identifying potential outliers or high earners.
df['feature_normalized_income'] = df['Income'] / (df['groupby_industry_avg_income'] + 1e-6)
end

python
# feature_credit_employment_years_interaction
# Credit-Employment-Years Interaction: Enhanced interaction of CreditScore, Employed, and normalized_years_employed (credit_employment_interaction * normalized_years_employed).
# Usefulness: Measures creditworthiness as a function of employment status and job tenure, capturing longer-term financial discipline.
df['feature_credit_employment_years_interaction'] = df['credit_employment_interaction'] * df['normalized_years_employed']
end

python
# feature_log_income
# Log of Income: Log transformation of Income (log(Income + 1e-6)).
# Usefulness: Reduces skewness in income distribution, improving the interpretability of high-income outliers.
df['feature_log_income'] = np.log(df['Income'] + 1e-6)
end

python
# feature_log_zipcode_median_debt
# Log of groupby_zipcode_median_debt: Log transformation of groupby_zipcode_median_debt (log(groupby_zipcode_median_debt + 1e-6)).
# Usefulness: Handles skewness and ensures a smoother distribution of regional debt medians.
df['feature_log_zipcode_median_debt'] = np.log(df['groupby_zipcode_median_debt'] + 1e-6)
end

python
# feature_stability_industry_zscore
# Stability Z-Score by Industry: Z-score normalization of normalized_years_employed grouped by Industry.
# Usefulness: Indicates an applicant’s job stability relative to others in the same industry, isolating outliers or particularly stable employees.
df['feature_stability_industry_zscore'] = df.groupby('Industry')['normalized_years_employed'].transform(lambda x: (x - x.mean()) / x.std(ddof=0))
end

python
# feature_ethnicity_income_interaction
# Ethnicity-Income Interaction: Interaction between ethnicity (ethnicity_Asian, ethnicity_Other, ethnicity_White) and Income.
# Usefulness: Captures specific ethnic group trends in income levels that might influence credit eligibility.
df['feature_ethnicity_income_interaction'] = (
    df['ethnicity_Asian'].astype(int) * df['Income'] +
    df['ethnicity_Other'].astype(int) * df['Income'] +
    df['ethnicity_White'].astype(int) * df['Income']
)
end

python
# Drop unnecessary reciprocal_prior_default column
df.drop(columns=['reciprocal_prior_default'], inplace=True)
end
