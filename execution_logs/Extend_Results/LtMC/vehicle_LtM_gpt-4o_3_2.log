# Usefulness: This interaction identifies vehicles with elongated silhouettes and prominent scatter symmetry differences.
df['SCATTER_RATIO_ELONGATEDNESS'] = df['SCATTER_RATIO'] / df['ELONGATEDNESS']
end

python
# LOG_ELONGATEDNESS
# Logarithm of ELONGATEDNESS captures nonlinear dynamics of silhouette elongation.
# Usefulness: Vehicles with highly elongated silhouettes benefit from scaled nonlinear representation for better separation.
