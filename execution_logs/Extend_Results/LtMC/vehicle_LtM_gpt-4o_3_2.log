# COMPACTNESS_ELONGATEDNESS_RATIO
# Ratio of COMPACTNESS to ELONGATEDNESS captures how compact the silhouette is compared to its elongation.
# Usefulness: Highlights the interaction between compactness and elongation, which can distinguish different vehicle shapes.
df['COMPACTNESS_ELONGATEDNESS_RATIO'] = df['COMPACTNESS'] / df['ELONGATEDNESS']
end

python
# RADIUS_SCATTER_RATIO
# Ratio of RADIUS_RATIO to SCATTER_RATIO highlights symmetry variations relative to scatter along axes.
# Usefulness: Integrates scatter symmetry with radius variation to expose symmetry-based silhouette characteristics.
df['RADIUS_SCATTER_RATIO'] = df['RADIUS_RATIO'] / df['SCATTER_RATIO']
end

python
# RATIO_MAJOR_MINOR_VARIANCE
# Ratio of SCALED_VARIANCE_ALONG_MAJOR_AXIS to SCALED_VARIANCE_ALONG_MINOR_AXIS, highlights variance dominance by axis.
# Usefulness: Measures spread asymmetry along axes for distinguishing vehicle type variance patterns.
df['RATIO_MAJOR_MINOR_VARIANCE'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] / df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# CROSS_COMPACTNESS_VARIANCE
# Product of COMPACTNESS and CROSS_SCATTER_VARIANCE_HOLLOWS links compactness with structural balance.
# Usefulness: Encodes compactness-driven effects on interdependencies between scatter and hollows.
df['CROSS_COMPACTNESS_VARIANCE'] = df['COMPACTNESS'] * df['CROSS_SCATTER_VARIANCE_HOLLOWS']
end

python
# LOG_SCATTER_RADIUS
# Logarithm of the product of SCATTER_RATIO and SCALED_RADIUS_OF_GYRATION, captures logarithmic variance trends between scatter and radius.
# Usefulness: Highlights scaling interactions between scatter ratio and radius variance, improving silhouette classification.
df['LOG_SCATTER_RADIUS'] = np.log(df['SCATTER_RATIO'] * df['SCALED_RADIUS_OF_GYRATION'])
end

python
# SQRT_SK_DEVIATION
# Square root of the absolute value of SKEWNESS_DIFF, emphasizes subtle directional imbalances.
# Usefulness: Enhances sensitivity to subtle shape imbalances, making skewness a more effective discriminator.
df['SQRT_SK_DEVIATION'] = np.sqrt(np.abs(df['SKEWNESS_DIFF']))
end

python
# EXP_ELONGATEDNESS
# Exponential scaling of ELONGATEDNESS divided by 10, models nonlinear elongation effects.
# Usefulness: Encodes exponential changes in elongation, important for detecting differences in elongated vehicle silhouettes.
df['EXP_ELONGATEDNESS'] = np.exp(df['ELONGATEDNESS'] / 10)
end

python
# CIRCULARITY_COMPACTNESS_SQRT_PRODUCT
# Product of the square root of CIRCULARITY and COMPACTNESS unifies edge-case differences in circular and compact features.
# Usefulness: Combines compactness and circularity into a unified metric for capturing nuanced shape differences.
df['CIRCULARITY_COMPACTNESS_SQRT_PRODUCT'] = np.sqrt(df['CIRCULARITY']) * df['COMPACTNESS']
end

python
# HOLLOWS_SCATTER_PRODUCT
# Product of HOLLOWS_RATIO and SCATTER_RATIO, integrates structural hollows and scatter balance.
# Usefulness: Links scatter-based distribution with structural hollows for wider area-distribution insights.
df['HOLLOWS_SCATTER_PRODUCT'] = df['HOLLOWS_RATIO'] * df['SCATTER_RATIO']
end

python
# VARIANCE_ASYMMETRY_DIFF
# Difference between SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCALED_VARIANCE_ALONG_MINOR_AXIS measures spread asymmetry.
# Usefulness: Encodes directional spread asymmetry for improved discrimination based on variance features.
df['VARIANCE_ASYMMETRY_DIFF'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
