end

python
# NORMALIZED_RADIUS_SCATTER_RATIO
# Minmax normalization of RADIUS_SCATTER_RATIO ensures all values are scaled between 0 and 1.
# Usefulness: Relative symmetry metrics need normalization for effective comparisons across vehicle types.
scaler = MinMaxScaler()
df['NORMALIZED_RADIUS_SCATTER_RATIO'] = scaler.fit_transform(df[['RADIUS_SCATTER_RATIO']])
end

python
# CROSS_LOG_SCATTER_HOLLOWS
