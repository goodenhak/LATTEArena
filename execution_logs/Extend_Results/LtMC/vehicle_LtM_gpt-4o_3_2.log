# RATIO_CIRCULARITY_COMPACTNESS
# Ratio of CIRCULARITY to COMPACTNESS, highlights balance between overall circular symmetry and compactness.
# Usefulness: Helps in differentiating shapes where circularity and compactness influence vehicle type.

df['RATIO_CIRCULARITY_COMPACTNESS'] = df['CIRCULARITY'] / df['COMPACTNESS']
end

python
# PRODUCT_CIRCULARITY_ELONGATION
# Product of CIRCULARITY and ELONGATEDNESS, integrates circularity symmetry and elongation.
# Usefulness: Useful for capturing how stretching influences symmetry variations, relevant to vehicle silhouettes.

df['PRODUCT_CIRCULARITY_ELONGATION'] = df['CIRCULARITY'] * df['ELONGATEDNESS']
end

python
# ASYMMETRY_INTENSITY
# Absolute value of VARIANCE_ASYMMETRY_DIFF, measures the magnitude of axis variance imbalance.
# Usefulness: Identifies how axis variance imbalances influence shape asymmetry in vehicles.

df['ASYMMETRY_INTENSITY'] = df['VARIANCE_ASYMMETRY_DIFF'].abs()
end

python
# RATIO_MAJOR_MINOR_VARIANCE
# Ratio of SCALED_VARIANCE_ALONG_MAJOR_AXIS to SCALED_VARIANCE_ALONG_MINOR_AXIS, highlights variance dominance by axis.
# Usefulness: Differentiates shapes with dominant variance along the major or minor axis.

df['RATIO_MAJOR_MINOR_VARIANCE'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] / df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# RATIO_SCATTER_RADIUS
# Ratio of SCATTER_RATIO to RADIUS_RATIO, refines the relationship between scatter symmetry and radius.
# Usefulness: Helps capture relative differences in scatter and radius symmetry variations.

df['RATIO_SCATTER_RADIUS'] = df['SCATTER_RATIO'] / df['RADIUS_RATIO']
end

python
# LOG_SCATTER_RADIUS
# Logarithm of the product of SCATTER_RATIO and SCALED_RADIUS_OF_GYRATION, captures logarithmic variance trends between scatter and radius.
# Usefulness: Useful for modeling high-dimensional interactions between scatter distribution and radius gyration effects.

df['LOG_SCATTER_RADIUS'] = np.log(df['SCATTER_RATIO'] * df['SCALED_RADIUS_OF_GYRATION'])
end

python
# HOLLOWS_SCATTER_PRODUCT
# Product of HOLLOWS_RATIO and SCATTER_RATIO, integrates structural hollows and scatter balance.
# Usefulness: Captures complex interactions between hollows and scatter, useful for structural shape understanding.

df['HOLLOWS_SCATTER_PRODUCT'] = df['HOLLOWS_RATIO'] * df['SCATTER_RATIO']
end

python
# SKEWNESS_VARIANCE_COUPLING
# Product of SKEWNESS_ABOUT_MAJOR_AXIS and VARIANCE_ASYMMETRY_DIFF, captures interactions between skewness and variance asymmetry.
# Usefulness: Highlights how directional imbalance relates to variance irregularities, aiding classification.

df['SKEWNESS_VARIANCE_COUPLING'] = df['SKEWNESS_ABOUT_MAJOR_AXIS'] * df['VARIANCE_ASYMMETRY_DIFF']
end

python
# SQRT_SK_DEVIATION
# Square root of the absolute value of SKEWNESS_DIFF, emphasizes subtle directional imbalances.
# Usefulness: Useful for capturing deviations in skewness for shapes exhibiting slight asymmetry.

df['SQRT_SK_DEVIATION'] = np.sqrt(df['SKEWNESS_DIFF'].abs())
end

