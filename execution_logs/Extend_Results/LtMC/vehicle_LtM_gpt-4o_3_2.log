# CROSS_COMPACTNESS_VARIANCE
# Product of COMPACTNESS and CROSS_SCATTER_VARIANCE_HOLLOWS.
# Usefulness: Links compactness with broader structural balance, capturing relationships critical for classification.
df['CROSS_COMPACTNESS_VARIANCE'] = df['COMPACTNESS'] * df['CROSS_SCATTER_VARIANCE_HOLLOWS']
end

