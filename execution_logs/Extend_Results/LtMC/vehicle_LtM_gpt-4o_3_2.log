# COMPACTNESS_ELONGATEDNESS_RATIO
# Ratio of COMPACTNESS to ELONGATEDNESS captures how compact the silhouette is compared to its elongation.
# Usefulness: Balances compactness against elongation to highlight structural compactness in elongated vehicles.
df['COMPACTNESS_ELONGATEDNESS_RATIO'] = df['COMPACTNESS'] / df['ELONGATEDNESS']
end

python
# RADIUS_SCATTER_RATIO
# Ratio of RADIUS_RATIO to SCATTER_RATIO highlights symmetry variations relative to scatter along axes.
# Usefulness: Measures the degree of symmetry variation correlated with scatter balance, reflecting stability of structure.
df['RADIUS_SCATTER_RATIO'] = df['RADIUS_RATIO'] / df['SCATTER_RATIO']
end

python
# RATIO_MAJOR_MINOR_VARIANCE
# Ratio of SCALED_VARIANCE_ALONG_MAJOR_AXIS to SCALED_VARIANCE_ALONG_MINOR_AXIS, highlights variance dominance by axis.
# Usefulness: Identifies how the primary and secondary axis variance relate, revealing vehicle shape asymmetry.
df['RATIO_MAJOR_MINOR_VARIANCE'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] / df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# CROSS_SCATTER_VARIANCE_HOLLOWS
# Interaction between SCATTER_RATIO, SCALED_VARIANCE_ALONG_MINOR_AXIS, and HOLLOWS_RATIO captures complex structural balance.
# Usefulness: Encodes interplay between scatter, minor axis variance, and hollows to model nuanced feature interactions.
df['CROSS_SCATTER_VARIANCE_HOLLOWS'] = df['SCATTER_RATIO'] * df['SCALED_VARIANCE_ALONG_MINOR_AXIS'] / df['HOLLOWS_RATIO']
end

python
# PRODUCT_CIRCULARITY_ELONGATION
# Product of CIRCULARITY and ELONGATEDNESS, integrates circularity symmetry and elongation.
# Usefulness: Combines edge symmetry and elongation to identify distinct profiles of vehicles like VAN vs. OPEL.
df['PRODUCT_CIRCULARITY_ELONGATION'] = df['CIRCULARITY'] * df['ELONGATEDNESS']
end

python
# VARIANCE_ASYMMETRY_DIFF
# Difference between SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCALED_VARIANCE_ALONG_MINOR_AXIS measures spread asymmetry.
# Usefulness: Identifies imbalance in variance between the axes, highlighting asymmetry important for classification.
df['VARIANCE_ASYMMETRY_DIFF'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# LOG_SCATTER_RADIUS
# Logarithm of the product of SCATTER_RATIO and SCALED_RADIUS_OF_GYRATION, captures logarithmic variance trends between scatter and radius.
# Usefulness: Unifies scatter and radius trends, amplifying logarithmic separation across class boundaries.
df['LOG_SCATTER_RADIUS'] = np.log(df['SCATTER_RATIO'] * df['SCALED_RADIUS_OF_GYRATION'])
end

python
# SKEWNESS_VARIANCE_COUPLING
# Product of SKEWNESS_ABOUT_MAJOR_AXIS and VARIANCE_ASYMMETRY_DIFF, captures interactions between skewness and variance asymmetry.
# Usefulness: Highlights the interplay of skewness and axis variance, emphasizing imbalance-driven shape characteristics.
df['SKEWNESS_VARIANCE_COUPLING'] = df['SKEWNESS_ABOUT_MAJOR_AXIS'] * df['VARIANCE_ASYMMETRY_DIFF']
end

python
# EXP_ELONGATEDNESS
# Exponential scaling of ELONGATEDNESS divided by 10, models nonlinear elongation effects.
# Usefulness: Encodes separation between compact and elongated silhouettes, relevant for class-specific analysis.
df['EXP_ELONGATEDNESS'] = np.exp(df['ELONGATEDNESS'] / 10)
end

python
# COMBINED_SCALE_VARIANCE
# Average of SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCALED_VARIANCE_ALONG_MINOR_AXIS, represents an aggregated variance measure.
# Usefulness: Provides a unifying variance descriptor for the vehicle scatter, combining minor and major axis components.
df['COMBINED_SCALE_VARIANCE'] = (df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] + df['SCALED_VARIANCE_ALONG_MINOR_AXIS']) / 2
end

python
# CIRCULARITY_COMPACTNESS_SQRT_PRODUCT
# Product of the square root of CIRCULARITY and COMPACTNESS unifies edge-case differences in circular and compact features.
# Usefulness: Highlights structural differences between circular and compact geometries, enhancing shape distinction.
df['CIRCULARITY_COMPACTNESS_SQRT_PRODUCT'] = np.sqrt(df['CIRCULARITY']) * df['COMPACTNESS']
end

python
