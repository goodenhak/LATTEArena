# COMPACTNESS_ELONGATEDNESS_RATIO
# Ratio of COMPACTNESS to ELONGATEDNESS captures how compact the silhouette is compared to its elongation.
# Usefulness: Helps distinguish between less compact and more elongated vehicles such as VANs and BUSES vs. compact vehicles like OPEL and SAAB.
df['COMPACTNESS_ELONGATEDNESS_RATIO'] = df['COMPACTNESS'] / df['ELONGATEDNESS']
end

python
# RADIUS_SCATTER_RATIO
# Ratio of RADIUS_RATIO to SCATTER_RATIO highlights symmetry variations relative to scatter along axes.
# Usefulness: Useful for capturing the balance of axis asymmetry, which could be key to differentiating vehicles like VANs (higher symmetry) from OPEL or SAAB (lower symmetry).
df['RADIUS_SCATTER_RATIO'] = df['RADIUS_RATIO'] / df['SCATTER_RATIO']
end

python
# PR_AXES_MAX_LENGTH_COMPARISON
# Product of PR.AXIS_ASPECT_RATIO and MAX.LENGTH_ASPECT_RATIO measures the relationship between principal axis ratio and overall width-length elongation.
# Usefulness: Differentiates vehicles in terms of structural layout, e.g., distinguishing elongated vehicles (BUS) from box-like shapes (VAN).
df['PR_AXES_MAX_LENGTH_COMPARISON'] = df['PR.AXIS_ASPECT_RATIO'] * df['MAX.LENGTH_ASPECT_RATIO']
end

python
# VARIANCE_ASYMMETRY_DIFF
# Difference between SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCALED_VARIANCE_ALONG_MINOR_AXIS measures spread asymmetry.
# Usefulness: Key to capturing variance differences in different shapes, important in distinguishing between type-specific spreads like OPEL vs SAAB.
df['VARIANCE_ASYMMETRY_DIFF'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# SKEWNESS_DIFF
# Difference between SKEWNESS_ABOUT_MAJOR_AXIS and SKEWNESS_ABOUT_MINOR_AXIS measures directional imbalance.
# Usefulness: Helps understand differences in directional skew, distinguishing asymmetrical vehicles such as OPEL or SAAB vs. geometrically balanced vehicles like BUSES or VANs.
df['SKEWNESS_DIFF'] = df['SKEWNESS_ABOUT_MAJOR_AXIS'] - df['SKEWNESS_ABOUT_MINOR_AXIS']
end

python
# KURTOSIS_HOLLOWS_SIGMOID
# Sigmoid of KURTOSIS_ABOUT_MAJOR_AXIS and HOLLOWS_RATIO to emphasize midrange variations in these features.
# Usefulness: Enhances midrange hollow and distribution characteristics to differentiate shapes with moderate hollow areas (e.g., BUSES) from those with minimal hollow areas (e.g., OPEL).
df['KURTOSIS_HOLLOWS_SIGMOID'] = 1 / (1 + np.exp(-(df['KURTOSIS_ABOUT_MAJOR_AXIS'] + df['HOLLOWS_RATIO'])))
end

python
# CIRCULARITY_COMPACTNESS_SQRT_PRODUCT
