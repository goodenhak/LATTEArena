# CIRCULARITY_COMPACTNESS_SQRT_PRODUCT
# Product of the square root of CIRCULARITY and COMPACTNESS unifies edge-case differences in circular and compact features.
# Usefulness: Captures distinct balance between circularity and compactness, useful to distinguish between silhouette shapes.
df['CIRCULARITY_COMPACTNESS_SQRT_PRODUCT'] = (df['CIRCULARITY']  0.5) * df['COMPACTNESS']
end

python
# HOLLOWS_SCATTER_PRODUCT
# Product of HOLLOWS_RATIO and SCATTER_RATIO integrates structural hollows and scatter balance.
# Usefulness: Highlights the interaction between hollows and scatter, useful for detecting structural balance differences.
df['HOLLOWS_SCATTER_PRODUCT'] = df['HOLLOWS_RATIO'] * df['SCATTER_RATIO']
end

python
# SKEWNESS_VARIANCE_COUPLING
# Product of SKEWNESS_ABOUT_MAJOR_AXIS and VARIANCE_ASYMMETRY_DIFF, measures coupling between skewness and variance asymmetry.
# Usefulness: Captures higher-order interaction between skewness and asymmetry for shape analysis.
df['SKEWNESS_VARIANCE_COUPLING'] = df['SKEWNESS_ABOUT_MAJOR_AXIS'] * df['VARIANCE_ASYMMETRY_DIFF']
end

python
# RATIO_CIRCULARITY_COMPACTNESS
# Ratio of CIRCULARITY to COMPACTNESS highlights balance between overall circular symmetry and compactness.
# Usefulness: Differentiates subtle circular and compactness trends for identifying vehicle types.
df['RATIO_CIRCULARITY_COMPACTNESS'] = df['CIRCULARITY'] / df['COMPACTNESS']
end

python
# RATIO_MAJOR_MINOR_VARIANCE
# Ratio of SCALED_VARIANCE_ALONG_MAJOR_AXIS to SCALED_VARIANCE_ALONG_MINOR_AXIS, highlights variance dominance by axis.
# Usefulness: Identifies the prominence of variance spread along major or minor axes, important for asymmetry detection.
df['RATIO_MAJOR_MINOR_VARIANCE'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] / df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

python
# LOG_RADIUS_VARIANCE
# Logarithm of the geometric average of RADIUS_RATIO and SCALED_RADIUS_OF_GYRATION.
# Usefulness: Models changes in radius-based scalability, capturing nonlinear radius-variance relationships.
df['LOG_RADIUS_VARIANCE'] = np.log((df['RADIUS_RATIO'] * df['SCALED_RADIUS_OF_GYRATION'])  0.5)
end

python
# LOG_SCATTER_RADIUS
# Logarithm of the product of SCATTER_RATIO and SCALED_RADIUS_OF_GYRATION.
# Usefulness: Highlights logarithmic trends in scatter-radius pairings for fine-grained analysis.
df['LOG_SCATTER_RADIUS'] = np.log(df['SCATTER_RATIO'] * df['SCALED_RADIUS_OF_GYRATION'])
end

python
# EXP_ELONGATEDNESS
# Exponential scaling of ELONGATEDNESS divided by 10, models nonlinear elongation effects.
# Usefulness: Amplifies differences in elongation properties, key for classifying elongated vehicles like buses or vans.
df['EXP_ELONGATEDNESS'] = np.exp(df['ELONGATEDNESS'] / 10)
end

python
# COMBINED_SCALE_VARIANCE
# Average of SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCALED_VARIANCE_ALONG_MINOR_AXIS, represents an aggregated variance measure.
# Usefulness: Combines variance descriptors into a single feature for simplicity while preserving critical information.
df['COMBINED_SCALE_VARIANCE'] = (df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] + df['SCALED_VARIANCE_ALONG_MINOR_AXIS']) / 2
end

python
# CROSS_COMPACTNESS_VARIANCE
# Product of COMPACTNESS and CROSS_SCATTER_VARIANCE_HOLLOWS.
# Usefulness: Links compactness with broader structural balance, capturing relationships critical for classification.
df['CROSS_COMPACTNESS_VARIANCE'] = df['COMPACTNESS'] * df['CROSS_SCATTER_VARIANCE_HOLLOWS']
end

