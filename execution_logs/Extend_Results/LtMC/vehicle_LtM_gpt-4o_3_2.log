# INTERACTION_CIRCULARITY_ELONGATEDNESS
# Interaction between CIRCULARITY and ELONGATEDNESS captures the combined symmetry and elongation properties of silhouettes.
# Usefulness: This amplifies the joint influence of circular symmetry and elongation in distinguishing among vehicle types with different shapes.
df['INTERACTION_CIRCULARITY_ELONGATEDNESS'] = df['CIRCULARITY'] * df['ELONGATEDNESS']
end

python
# RATIO_SCATTER_ELONGATION
# Ratio of SCATTER_RATIO to ELONGATEDNESS highlights the relationship between scatter-based symmetry and elongation.
# Usefulness: This helps in identifying vehicles with varying scatter-dominance relative to their elongated structure.
df['RATIO_SCATTER_ELONGATION'] = df['SCATTER_RATIO'] / df['ELONGATEDNESS']
end

python
# ABS_VARIANCE_DIFFERENCE
# Absolute difference between SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCALED_RADIUS_OF_GYRATION measures spatial asymmetry.
# Usefulness: This captures localized asymmetrical variance which may vary across different vehicle shapes.
df['ABS_VARIANCE_DIFFERENCE'] = abs(df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] - df['SCALED_RADIUS_OF_GYRATION'])
end

python
# LOG_CIRCULARITY_SCATTER
# Logarithm of the product of CIRCULARITY and SCATTER_RATIO to capture compound circular and scatter effects in a smoother scale.
# Usefulness: Enables alignment of the scales of high-variability features with smaller feature magnitudes.
df['LOG_CIRCULARITY_SCATTER'] = np.log(df['CIRCULARITY'] * df['SCATTER_RATIO'])
end

python
# MAX_ASYMMETRY_IMBALANCES
# Maximum value between VARIANCE_ASYMMETRY_DIFF and SKEWNESS_DIFF captures the stronger imbalance.
# Usefulness: This prioritizes the most significant asymmetry source for specific vehicle outlines.
df['MAX_ASYMMETRY_IMBALANCES'] = np.maximum(df['VARIANCE_ASYMMETRY_DIFF'], df['SKEWNESS_DIFF'])
end

python
# NORMALIZED_HOLLOWS_SCATTER
# Ratio of HOLLOWS_SCATTER_PRODUCT to the sum of HOLLOWS_RATIO and SCATTER_RATIO normalizes hollows and scatter interaction.
# Usefulness: This balances the combined effect of hollows and scatter characteristic differences in the structural balance.
df['NORMALIZED_HOLLOWS_SCATTER'] = df['HOLLOWS_SCATTER_PRODUCT'] / (df['HOLLOWS_RATIO'] + df['SCATTER_RATIO'])
end

python
# EXP_LOG_RADIUS_VARIANCE
# Exponential scaling of LOG_RADIUS_VARIANCE for nonlinear transformation of radius-based changes.
# Usefulness: Models subtle nonlinear variations of radius-based metrics across vehicle examples.
df['EXP_LOG_RADIUS_VARIANCE'] = np.exp(df['LOG_RADIUS_VARIANCE'])
end

python
# CROSS_ELONGATION_COMPACTNESS
# Product of ELONGATEDNESS and CROSS_COMPACTNESS_VARIANCE integrates effects of elongation and compactness-linked structural balance.
# Usefulness: Highlights how compactness interacts with enhancements in elongated structures for classification.
df['CROSS_ELONGATION_COMPACTNESS'] = df['ELONGATEDNESS'] * df['CROSS_COMPACTNESS_VARIANCE']
end

python
# SKEWNESS_COUPLING_RATIO
# Ratio of SKEWNESS_ABOUT_MAJOR_AXIS to SKEWNESS_VARIANCE_COUPLING measures directional coupling strength.
# Usefulness: Provides insight into the directional weight of skewness relative to variance coupling interactions.
df['SKEWNESS_COUPLING_RATIO'] = df['SKEWNESS_ABOUT_MAJOR_AXIS'] / df['SKEWNESS_VARIANCE_COUPLING']
end

python
# SCALED_COMPACTNESS_BALANCE
# COMPACTNESS scaled by the difference between ELONGATEDNESS and SCATTER_RATIO captures normalized compactness under elongation and scatter effects.
# Usefulness: This measures the balance of compactness under competing elongation and scatter influences.
df['SCALED_COMPACTNESS_BALANCE'] = df['COMPACTNESS'] * (df['ELONGATEDNESS'] - df['SCATTER_RATIO'])
end

