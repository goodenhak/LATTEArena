# Log_Debt
# Log transformation of Debt to stabilize scale and reduce skewness.
# Usefulness: Captures the wide range of Debt values, making them more interpretable for downstream tasks and aligned with skewed distributions like Debt.
df['Log_Debt'] = df['Debt'].apply(lambda x: np.log1p(x))
end

python
# PriorDefault_CreditScore_Interaction_Squared
# Square of the interaction term PriorDefault_CreditScore_Interaction to capture non-linear relationships.
# Usefulness: Represents the compounding effect of prior defaults and creditworthiness in non-linear patterns.
df['PriorDefault_CreditScore_Interaction_Squared'] = df['PriorDefault_CreditScore_Interaction']  2
end

python
# Income_Debt_Interaction
# Multiplicative interaction term between Income and Debt.
# Usefulness: Highlights financial solvency by amplifying the relationship between income and outstanding liabilities.
df['Income_Debt_Interaction'] = df['Income'] * df['Debt']
end

python
# Age_Group
# Binned age groups using quantiles to group applicants into age brackets.
# Usefulness: Simplifies the relationship between age and credit approval into meaningful categories.
df['Age_Group'] = pd.qcut(df['Age'], q=4, labels=[Young, Mid-Young, Mid-Old, Older])
end

python
# Weighted_CreditScore_by_Industry
# Product of CreditScore and CreditScore_by_Industry_mean to weigh individual credit scores by industry standards.
# Usefulness: Provides relative creditworthiness within the context of industry benchmarks.
df['Weighted_CreditScore_by_Industry'] = df['CreditScore'] * df['CreditScore_by_Industry_mean']
end

python
# ZScore_Income_to_EthnicityMean
# Z-scoring Income within each Ethnicity group.
# Usefulness: Identifies whether an individual's income significantly deviates from their Ethnicity group average, providing context for income disparities.
df['ZScore_Income_to_EthnicityMean'] = df.groupby('Ethnicity')['Income'].transform(lambda x: (x - x.mean()) / x.std())
end

python
# Married_Income_Solvency_Boost
# Interaction of Married and Income_to_Debt_Ratio to capture the compounding solvency effect of marital stability.
# Usefulness: Couples' combined financial stability often leads to better debt management, captured here in ratio terms.
df['Married_Income_Solvency_Boost'] = df['Married'] * df['Income_to_Debt_Ratio']
end

python
# Has_DriversLicense_and_HigherCredit
# Boolean feature indicating if applicant has both DriversLicense and above-median CreditScore.
# Usefulness: Highlights applicants more likely to succeed due to financial and social signaling behaviors.
df['Has_DriversLicense_and_HigherCredit'] = (df['CreditScore'] > df['CreditScore'].median()) & (df['Has_DriversLicense_and_Employed'] > 0)
end

python
# Normalized_YearsEmployed_to_Age_Ratio
# Min-max normalization of the YearsEmployed_to_Age_Ratio for scaling between 0 and 1.
# Usefulness: Ensures consistency in comparisons of work experience across ages by bringing data to a uniform scale.
df['Normalized_YearsEmployed_to_Age_Ratio'] = (df['YearsEmployed_to_Age_Ratio'] - df['YearsEmployed_to_Age_Ratio'].min()) / (df['YearsEmployed_to_Age_Ratio'].max() - df['YearsEmployed_to_Age_Ratio'].min())
end

python
# TargetEncoded_Citizen
# Target encoded Citizenship status based on historical success rates.
# Usefulness: Provides a statistically aggregated signal of success probability based on Citizenship categories.
citizen_success_rate = df.groupby('Citizen')['Answer'].mean()
df['TargetEncoded_Citizen'] = df['Citizen'].map(citizen_success_rate)
end

python
# Composite_Financial_Stability_Index
# Composite index combining Income_to_Debt_Ratio, Log_Income, and Debt_Difference_from_Mean.
# Usefulness: Aggregates key financial signals into a single metric to simplify solvency and risk evaluation.
df['Composite_Financial_Stability_Index'] = df['Income_to_Debt_Ratio'] * df['Log_Income'] / (1 + abs(df['Debt_Difference_from_Mean']))
end

python
df.drop(columns=['Has_DriversLicense_and_Employed'], inplace=True)
end

python
df.drop(columns=['YearsEmployed_to_Age_Ratio'], inplace=True)
end
