# Interaction of Married and Income_to_Debt_Ratio to capture the compounding solvency effect of marital stability.
# Usefulness: Couples' combined financial stability often leads to better debt management, captured here in ratio terms.
df['Married_Income_Solvency_Boost'] = df['Married'] * df['Income_to_Debt_Ratio']
end

python
# Has_DriversLicense_and_HigherCredit
# Boolean feature indicating if applicant has both DriversLicense and above-median CreditScore.
# Usefulness: Highlights applicants more likely to succeed due to financial and social signaling behaviors.
df['Has_DriversLicense_and_HigherCredit'] = (df['CreditScore'] > df['CreditScore'].median()) & (df['Has_DriversLicense_and_Employed'] > 0)
end

python
# Normalized_YearsEmployed_to_Age_Ratio
# Min-max normalization of the YearsEmployed_to_Age_Ratio for scaling between 0 and 1.
# Usefulness: Ensures consistency in comparisons of work experience across ages by bringing data to a uniform scale.
df['Normalized_YearsEmployed_to_Age_Ratio'] = (df['YearsEmployed_to_Age_Ratio'] - df['YearsEmployed_to_Age_Ratio'].min()) / (df['YearsEmployed_to_Age_Ratio'].max() - df['YearsEmployed_to_Age_Ratio'].min())
end

python
# TargetEncoded_Citizen
# Target encoded Citizenship status based on historical success rates.
# Usefulness: Provides a statistically aggregated signal of success probability based on Citizenship categories.
citizen_success_rate = df.groupby('Citizen')['Answer'].mean()
df['TargetEncoded_Citizen'] = df['Citizen'].map(citizen_success_rate)
end

python
# Composite_Financial_Stability_Index
# Composite index combining Income_to_Debt_Ratio, Log_Income, and Debt_Difference_from_Mean.
# Usefulness: Aggregates key financial signals into a single metric to simplify solvency and risk evaluation.
df['Composite_Financial_Stability_Index'] = df['Income_to_Debt_Ratio'] * df['Log_Income'] / (1 + abs(df['Debt_Difference_from_Mean']))
end

python
df.drop(columns=['Has_DriversLicense_and_Employed'], inplace=True)
end

python
df.drop(columns=['YearsEmployed_to_Age_Ratio'], inplace=True)
end
