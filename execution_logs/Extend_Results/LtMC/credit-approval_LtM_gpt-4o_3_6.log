# Debt_to_Income_Ratio
# Ratio of Debt to Income, to signify financial solvency.
# Usefulness: Captures relative financial burden and solvency potential, aligning with creditworthiness dynamics.
df['Debt_to_Income_Ratio'] = df['Debt'] / (df['Income'] + 1)
end

python
# CreditScore_Squared
# Square of CreditScore to capture potential non-linear effects.
# Usefulness: Amplifies the impact of higher credit scores, emphasizing stronger credit profiles.
df['CreditScore_Squared'] = df['CreditScore']  2
end

python
# Age_Log
# Log transformation of Age to compress higher ages and reduce skewness.
# Usefulness: Stabilizes variations in the impact of age, reflecting a more normalized relationship.
df['Age_Log'] = np.log(df['Age'] + 1)
end

python
# Log_Income_to_Debt_Ratio
# Log-transformed Income-to-Debt Ratio, improving scale consistency.
# Usefulness: Stabilizes the ratio, making it easier for models to detect solvency patterns.
df['Log_Income_to_Debt_Ratio'] = np.log(df['Income_to_Debt_Ratio'] + 1)
end

python
# PriorDefault_by_Citizen
# Interaction of PriorDefault and Citizen to capture credit behavior variation by citizenship.
# Usefulness: Highlights differences in credit defaults across citizen categories.
df['PriorDefault_by_Citizen'] = df['PriorDefault'].astype(str) + _ + df['Citizen'].astype(str)
end

python
# Married_Age_Interaction
# Interaction feature combining Married and Age.
# Usefulness: Represents marital stability and its maturation impact.
df['Married_Age_Interaction'] = df['Married'] * df['Age']
end

python
# Citizen_Ethnicity_Cross
# Cross of Citizen and Ethnicity to capture social-economic group patterns.
# Usefulness: Highlights demographic variations in prediction power.
df['Citizen_Ethnicity_Cross'] = df['Citizen'].astype(str) + _ + df['Ethnicity'].astype(str)
end

python
# Debt_Percentage_from_Median
# Difference between Debt and its dataset median value, scaled by the median.
# Usefulness: Reflects relative deviation from the central value of debt in the population.
df['Debt_Percentage_from_Median'] = (df['Debt'] - df['Debt'].median()) / (df['Debt'].median() + 1)
end

python
df.drop(columns=['Income_to_Debt_Ratio', 'PriorDefault_CreditScore_Interaction'], inplace=True)
end
