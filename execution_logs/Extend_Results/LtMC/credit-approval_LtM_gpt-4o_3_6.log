2026-05-26 11:36:49,481 - INFO - ops_string = ["# Log_Income_to_Debt_Ratio\n# Log transformation of Income_to_Debt_Ratio to stabilize scale and reduce skewness.\n# Usefulness: Captures financial solvency in a stabilized manner, making it comparable across individuals with varying debt-income ratios.\ndf['Log_Income_to_Debt_Ratio'] = np.log(df['Income_to_Debt_Ratio'] + 1)", "# PriorDefault_CreditScore_Ratio\n# Ratio of PriorDefault_CreditScore_Interaction to CreditScore for normalized risk contribution.\n# Usefulness: Highlights the relative impact of prior defaults on creditworthiness compared to raw credit scores.\ndf['PriorDefault_CreditScore_Ratio'] = df['PriorDefault_CreditScore_Interaction'] / (df['CreditScore'] + 1)", "# Debt_to_Age_Ratio\n# Ratio of Debt to (Age + 1) to measure debt burden relative to life stage.\n# Usefulness: Captures financial strain differences across age groups, aligning with debt dynamics over time.\ndf['Debt_to_Age_Ratio'] = df['Debt'] / (df['Age'] + 1)", "# CreditScore_x_Income\n# Interaction term between CreditScore and Income to capture combined impact on financial solvency.\n# Usefulness: Reflects how higher income moderates credit score effects on overall creditworthiness.\ndf['CreditScore_x_Income'] = df['CreditScore'] * df['Income']", "# Married_Employed_Interaction\n# Interaction term between Married and Employed to identify stability through household structure and employment.\n# Usefulness: Combines two stability indicators, providing deeper insights into solvency and financial reliability.\ndf['Married_Employed_Interaction'] = df['Married'] * df['Employed']", "# Gender_Employed_Interaction\n# Interaction term between Gender and Employed to account for gender-based employment trends affecting solvency.\n# Usefulness: Highlights gender disparities or trends in employment impacting financial stability and creditworthiness.\ndf['Gender_Employed_Interaction'] = df['Gender'] * df['Employed']", "# Income_Deviation\n# Difference between Log_Income and the mean of Log_Income for identifying over-/under-performance relative to peers.\n# Usefulness: Captures individual financial profile deviations to assess economic standing.\ndf['Income_Deviation'] = df['Log_Income'] - df['Log_Income'].mean()", "# Debt_x_PriorDefault\n# Interaction term between Debt and PriorDefault to emphasize the impact of outstanding debt combined with default history.\n# Usefulness: Highlights compounded risk from high debt levels and past financial misbehavior.\ndf['Debt_x_PriorDefault'] = df['Debt'] * df['PriorDefault']", "# Drop redundant columns\ndf.drop(columns=['Has_DriversLicense_and_Employed'], inplace=True)"]
