end

python
# Log_Debt
# Log transformation of Debt to stabilize scale and reduce skewness.
# Usefulness: Handles the large range of Debt while highlighting relative differences in scaled values.
df['Log_Debt'] = np.log1p(df['Debt'])
end

python
