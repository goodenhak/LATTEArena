# Debt_to_Income_Ratio
# Ratio of Debt to (Income + 1) to capture financial burden relative to earnings.
# Usefulness: Measures financial health and ability to manage debt; important given that high debt or low income can reduce success likelihood.
df['Debt_to_Income_Ratio'] = df['Debt'] / (df['Income'] + 1)
end

python
# Log_Income
# Log transformation of Income to reduce skewness in the Income feature.
# Usefulness: Ensures that high-income outliers do not dominate the model, capturing income's real impact.
df['Log_Income'] = np.log1p(df['Income'])
end

python
# Log_Debt
# Log transformation of Debt to reduce skewness in the Debt feature.
# Usefulness: Encodes debt in a way that mitigates the effect of extreme values while preserving its financial relevance.
df['Log_Debt'] = np.log1p(df['Debt'])
end

python
# Employed_Years_Product
# Product of Employed status and YearsEmployed.
# Usefulness: Highlights the importance of stability among currently employed individuals; unemployed individuals have a value of zero.
df['Employed_Years_Product'] = df['Employed'] * df['YearsEmployed']
end

python
# CreditScore_PriorDefault_Interaction
# Interaction of CreditScore and PriorDefault.
# Usefulness: Captures scenarios where prior defaults coexist with good credit scores, revealing complex credit histories.
df['CreditScore_PriorDefault_Interaction'] = df['CreditScore'] * df['PriorDefault']
end

python
# Credit_History_Indicator
# Binary indicator for any established credit history (CreditScore > 0).
# Usefulness: Differentiates between individuals with no credit history and those with some credit experience, even if low scores.
df['Credit_History_Indicator'] = (df['CreditScore'] > 0).astype(int)
end

python
# Target_Encoded_Industry
# Target encoding for Industry based on historical success rates.
# Usefulness: Provides a data-driven success rate for each industry, reflecting industry-level financial characteristics or approval biases.
industry_target_means = df.groupby('Industry')['Answer'].mean()
df['Target_Encoded_Industry'] = df['Industry'].map(industry_target_means)
end

python
# Target_Encoded_Ethnicity
# Target encoding for Ethnicity based on historical success rates.
# Usefulness: Encodes potential disparities or patterns in approvals related to ethnic groups, grounded in observed success data.
ethnicity_target_means = df.groupby('Ethnicity')['Answer'].mean()
df['Target_Encoded_Ethnicity'] = df['Ethnicity'].map(ethnicity_target_means)
end

python
# Target_Encoded_Citizen
# Target encoding for Citizen based on historical success rates.
# Usefulness: Accounts for approval likelihood differences based on citizenship categories, as observed from historical trends.
citizen_target_means = df.groupby('Citizen')['Answer'].mean()
df['Target_Encoded_Citizen'] = df['Citizen'].map(citizen_target_means)
end

python
# Income_Ratio
# Ratio of Income to (CreditScore + 1).
# Usefulness: Highlights financial strength per unit of credit score, quantifying how income supports their creditworthiness.
df['Income_Ratio'] = df['Income'] / (df['CreditScore'] + 1)
end

python
# Debt_Credit_Ratio
# Ratio of Debt to (CreditScore + 1).
# Usefulness: Quantifies how much of an individual's debt is burdensome relative to their credit score.
df['Debt_Credit_Ratio'] = df['Debt'] / (df['CreditScore'] + 1)
end

python
# Industry_Income_Cross
# Cross product of Industry and Income (as target encoded Industry × Income).
# Usefulness: Captures nonlinear interactions between occupation sector and financial standing.
df['Industry_Income_Cross'] = df['Target_Encoded_Industry'] * df['Income']
end

python
# Citizen_Employment_Interaction
# Cross product of Citizen and Employed status.
# Usefulness: Encodes how employment status conditions differ across citizenship categories, capturing systemic or legal effects.
df['Citizen_Employment_Interaction'] = df['Target_Encoded_Citizen'] * df['Employed']
end

python
