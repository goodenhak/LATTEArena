# CreditScore_to_Age_Ratio
# Ratio of CreditScore to Age, capturing age-adjusted credit trustworthiness.
# Usefulness: Identifies whether younger individuals with a high credit score are more likely to be successful in their credit card applications compared to older individuals with similar scores.

df[CreditScore_to_Age_Ratio] = df[CreditScore] / (df[Age] + 1)
end

python
# Debt_to_Log_Income
# Ratio of Debt to Log_Income, adjusting debt burden by skewness-corrected income.
# Usefulness: Provides a clearer measure of financial stress relative to stabilized income metrics.

df[Debt_to_Log_Income] = df[Debt] / (df[Log_Income] + 1)
end

python
# Married_and_Citizen_Interaction
# Interaction feature between Married and Citizen to capture household stability and citizenship effects jointly.
# Usefulness: Strong predictor of financial security and long-term solvency, combining marital status and residency stability.

df[Married_and_Citizen_Interaction] = df[Married].astype(str) + _ + df[Citizen]
end

python
# PriorDefault_with_CreditScore_by_Industry_std
# Multiplicative interaction between PriorDefault and the standard deviation of CreditScore aggregated by Industry.
# Usefulness: Highlights the risk relationship between prior defaults and cross-industry credit variability.

df[PriorDefault_with_CreditScore_by_Industry_std] = (
    df[PriorDefault] * df.groupby(Industry)[CreditScore].transform(std)
)
end

python
# Exp_Income_to_Debt_Ratio
# Exponential transformation of Income_to_Debt_Ratio to emphasize extreme solvency levels.
# Usefulness: Provides a nonlinear adjustment to solvency indicators, amplifying outlier financial stability.

df[Exp_Income_to_Debt_Ratio] = np.exp(df[Income_to_Debt_Ratio])
end

python
# Log_CreditScore
# Log transformation of CreditScore to reduce skewness and amplify its lower range impact.
# Usefulness: Stabilizes CreditScore scaling, improving correlation with approval outcomes for cases with low credit scores.

df[Log_CreditScore] = np.log(df[CreditScore] + 1)
end

python
# Employed_and_DriverLicense_Interaction
# Interaction feature for Has_DriversLicense_and_Employed showcasing dual reliability metrics.
# Usefulness: Combines basic civic responsibility (Driver's license possession) with employment, indicating applicant's stability.

df[Employed_and_DriverLicense_Interaction] = df[Employed] * df[Has_DriversLicense_and_Employed]
end

python
# PriorDefault_and_Age_Interaction
# Interaction between PriorDefault and Age to capture the effect of past defaults at various life stages.
# Usefulness: Highlights how prior financial behavior interacts with age-related creditworthiness.

df[PriorDefault_and_Age_Interaction] = df[PriorDefault] * df[Age]
end

python
# Target_encode_Ethnicity
# Target encoding for Ethnicity based on credit card approval rates within each category.
# Usefulness: Quantifies approval likelihood by ethnic groups, capturing latent socioeconomic trends.

ethnicity_approval_mapping = df.groupby(Ethnicity)[Success].mean()
df[Target_encode_Ethnicity] = df[Ethnicity].map(ethnicity_approval_mapping)
end

python
# Drop irrelevant columns
df.drop(columns=[Industry, Has_DriversLicense_and_Employed], inplace=True)
end
