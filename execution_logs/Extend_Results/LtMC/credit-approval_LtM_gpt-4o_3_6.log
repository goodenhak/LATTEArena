python
# Age_Bucket
# Binned age groups for easier analysis of age-related non-linearity effects.
# Usefulness: Simplifies age into categorical ranges, accounting for societal and policy structures.
df['Age_Bucket'] = pd.cut(df['Age'], bins=[0, 18, 25, 35, 45, 60, 100], labels=['Teen', '18-25', '26-35', '36-45', '46-60', '60+'])
end

python
# CreditScore_Cubed
# Cubing CreditScore to emphasize larger credit scores for non-linear impact on approvals.
# Usefulness: Increases the weight of high scores in credit approval predictions.
df['CreditScore_Cubed'] = df['CreditScore']  3
end

python
# YearsEmployed_Log
# Log-transformed YearsEmployed to manage skewness in employment analysis.
# Usefulness: Reflects diminishing returns of employment years on application success.
df['YearsEmployed_Log'] = np.log1p(df['YearsEmployed'])
end

python
# Employed_YearsEmployed_Interaction
# Interaction between employment status and years employed.
# Usefulness: Highlights the significance of being employed combined with experience length.
df['Employed_YearsEmployed_Interaction'] = df['Employed'] * df['YearsEmployed']
end

python
# One-hot encoding for Ethnicity
# Encodes Ethnicity into separate binary columns.
# Usefulness: Addresses categorical nature of ethnicity while preserving uniqueness of categories.
ethnicity_dummies = pd.get_dummies(df['Ethnicity'], prefix='Ethnicity')
df = pd.concat([df, ethnicity_dummies], axis=1)
df.drop(columns=['Ethnicity'], inplace=True)
end

python
# Target encoding for Industry
# Encodes Industry based on its relationship to application success.
# Usefulness: Encodes based on statistical correlation with the target, maintaining predictive power.
industry_target_mean = df.groupby('Industry')['Answer'].mean()
df['Industry_TargetEncoded'] = df['Industry'].map(industry_target_mean)
df.drop(columns=['Industry'], inplace=True)
end

python
# Credit_Marriage_Interaction
# Interaction between marriage status and credit score.
# Usefulness: Captures the combined effect of stable marital status and creditworthiness.
df['Credit_Marriage_Interaction'] = df['Married'] * df['CreditScore']
end

python
# Debt_Employment_Interaction
# Interaction between debt and employment status.
# Usefulness: Highlights debt behavior differences between those employed and unemployed.
df['Debt_Employment_Interaction'] = df['Debt'] * (df['Employed'] + 1e-5)
end

python
# Income_PriorDefault_Interaction
# Interaction between income and clean credit history.
# Usefulness: Connects financial capacity with reliability in prior credit behaviors.
df['Income_PriorDefault_Interaction'] = df['Income'] * (1 - df['PriorDefault'])
end

python
# Groupby ZipCode: Mean Income
# Average income by ZipCode to capture regional income variations.
# Usefulness: Reflects geographic socio-economic disparities.
df['ZipCode_Mean_Income'] = df.groupby('ZipCode')['Income'].transform('mean')
end

python
# Groupby ZipCode: Mean CreditScore
# Average CreditScore by ZipCode to capture regional credit distribution.
# Usefulness: Highlights collective credit behavior patterns geographically.
df['ZipCode_Mean_CreditScore'] = df.groupby('ZipCode')['CreditScore'].transform('mean')
end

python
