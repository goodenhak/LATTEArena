# Income_to_Debt_Ratio
# Computed ratio of Income to (Debt + 1) to capture financial solvency without division by zero.
# Usefulness: A higher ratio implies better financial stability, which is a strong indicator for creditworthiness.
df['Income_to_Debt_Ratio'] = df['Income'] / (df['Debt'] + 1)
end

python
# CreditScore_to_Age_Ratio
# Computed ratio of CreditScore to (Age + 1) to understand creditworthiness in the context of age.
# Usefulness: Considers maturity effects on credit history and successful application likelihood.
df['CreditScore_to_Age_Ratio'] = df['CreditScore'] / (df['Age'] + 1)
end

python
# YearsEmployed_to_Age_Ratio
# Computed ratio of YearsEmployed to Age to indicate work experience relative to age.
# Usefulness: Captures a person’s career stability compared to their stage of life, potentially connected to credit approval.
df['YearsEmployed_to_Age_Ratio'] = df['YearsEmployed'] / (df['Age'] + 1)
end

python
# Debt_Difference_from_Mean
# Difference between Debt and the dataset's mean Debt to standardize debt comparison.
# Usefulness: Indicates whether the applicant has above-average or below-average debt levels compared to the population.
df['Debt_Difference_from_Mean'] = df['Debt'] - df['Debt'].mean()
end

python
# Log_Income
# Log transformation of Income to stabilize scale and reduce skewness.
# Usefulness: Handles the large range of Income while highlighting relative differences in scaled values.
