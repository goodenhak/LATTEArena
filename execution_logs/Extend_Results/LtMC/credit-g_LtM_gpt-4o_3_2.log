# repayment_pressure_score
# A combined score derived from repayment_burden_duration_ratio and repayment_risk_interaction to capture overall repayment strain.
# Usefulness: This feature aggregates repayment-related measures into a single score, simplifying the identification of high-risk applicants.
df['repayment_pressure_score'] = df['repayment_burden_duration_ratio'] * df['repayment_risk_interaction']
end

python
# stability_score
# A combined stability score calculated as the product of stability_interaction and residence_since.
# Usefulness: This feature consolidates geographic and workforce stability into a singular stability measure, providing insight into an applicant’s reliability.
df['stability_score'] = df['stability_interaction'] * df['residence_since']
end

python
# credit_risk_score
# Interaction term between credit_amount and zscore_duration, representing credit risk adjusted for repayment timeline standardization.
# Usefulness: This feature captures the relationship between loan size and repayment duration, emphasizing repayment feasibility under credit risk scenarios.
df['credit_risk_score'] = df['credit_amount'] * df['zscore_duration']
end

python
# savings_checking_ratio
# Ratio of savings_status_encoding to checking_status (numerical encoding).
# Usefulness: Differentiates individuals based on both savings and checking account statuses, contributing to financial preparedness assessment.
df['savings_checking_ratio'] = (df['savings_status_encoding'] + 1) / (df['checking_status'].replace({'<0': 0, 'no checking': 0, '0<=X<200': 1, '>=200': 2}) + 1)
end

python
# employment_stability_score
# Weighted sum of employment features (employment_1<=X<4, employment_unemployed, employment_4<=X<7) to capture overall employment stability.
# Usefulness: Simplifies employment-related interactions by combining them into a single feature, aiding in evaluating workforce reliability.
df['employment_stability_score'] = (df['employment_1<=X<4'] * 0.5) + (df['employment_unemployed'] * 0.3) + (df['employment_4<=X<7'] * 0.2)
end

python
# personal_status_telephone_interaction
# Cross-product of personal_status categories and own_telephone to emphasize resource access influenced by personal and demographic factors.
# Usefulness: Highlights nuanced impacts of personal status and resource possession on credit decisions.
df['personal_status_telephone_interaction'] = df['personal_status'].replace({
    'male single': 1, 'female div/dep/mar': 2, 'male mar/wid': 3, 'male div/sep': 4
}) * df['own_telephone'].replace({'none': 0, 'yes': 1})
end

python
# drop_columns
# Removes less informative raw features after creating more meaningful interactions and aggregations.
df.drop(columns=['employment_1<=X<4', 'employment_unemployed', 'employment_4<=X<7', 'zscore_duration'], inplace=True)
end
