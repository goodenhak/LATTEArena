df['normalized_risk'] = df['repayment_risk_interaction'].apply(lambda x: log(x + 1))
end

python
# credit_risk_zscore
# Z-score of repayment_risk_interaction to standardize its impact across records.
# Usefulness: Standardizing repayment_risk_interaction ensures fair comparison and avoids bias due to large variance.
df['credit_risk_zscore'] = (df['repayment_risk_interaction'] - df['repayment_risk_interaction'].mean()) / df['repayment_risk_interaction'].std()
end

python
# adjusted_repayment_burden
# Refined repayment stress by multiplying repayment_burden_duration_ratio with zscore_duration.
# Usefulness: Captures repayment stress over standardized time for more accurate financial capacity assessment.
df['adjusted_repayment_burden'] = df['repayment_burden_duration_ratio'] * df['zscore_duration']
end

python
# employment_stability_ratio
# Ratio of employment_4<=X<7 to employment_unemployed, emphasizing longer employment tenure against unemployment.
# Usefulness: Indicates workforce stability with higher weight on prolonged employment compared to unemployment.
df['employment_stability_ratio'] = df['employment_4<=X<7'] / (df['employment_unemployed'] + 1)
end

python
# normalized_stability
# Ratio of stability_interaction to residence_since or workforce factors.
# Usefulness: Captures combined geographic and workforce stability for refined creditworthiness assessment.
df['normalized_stability'] = df['stability_interaction'] / df['residence_since']
end

python
# debt_to_income_ratio
# Ratio of credit_amount to repayment_burden_duration_ratio, indicating relative debt burden.
# Usefulness: Provides a clear picture of how much credit burden exists relative to repayment stress.
df['debt_to_income_ratio'] = df['credit_amount'] / (df['repayment_burden_duration_ratio'] + 1e-9)
end

python
# personal_payment_interaction
# Cross-product of personal_status with other_payment_plans for personal and financial context.
# Usefulness: Connects personal financial context to alternate repayment mechanisms, improving contextual predictions.
df['personal_payment_interaction'] = df['personal_status'].astype(str) + _ + df['other_payment_plans'].astype(str)
end

python
# residence_housing_interaction
# Cross-product of residence_since and housing, emphasizing stability by housing type and duration.
# Usefulness: Distinguishes approval likelihood by length of residence combined with housing type.
df['residence_housing_interaction'] = df['residence_since'].astype(str) + _ + df['housing'].astype(str)
end

python
# Drop redundant and less useful columns
df.drop(columns=['housing_rent', 'housing_for free'], inplace=True)
end
