2026-05-26 00:12:44,569 - INFO - ops_string = ["# repayment_burden_duration_ratio\n# Ratio of repayment burden (credit_to_income_ratio) to duration, capturing the stress of repayment over time.\n# Usefulness: Helps to assess how the repayment load scales with the loan duration, a critical factor in credit approval.\n\ndf['repayment_burden_duration_ratio'] = df['credit_to_income_ratio'] / df['duration']", "# stability_interaction\n# Interaction term between age_to_job_ratio and residence_stability to capture combined workforce stability and geographic stability.\n# Usefulness: Combines workforce experience with residential stability for a holistic measure of personal stability.\n\ndf['stability_interaction'] = df['age_to_job_ratio'] * df['residence_stability']", "# normalized_risk_score\n# Z-score normalized risk_score for better interpretability and standardized comparison.\n# Usefulness: Standardizes credit risk exposure to account for varying scales and enable fair comparison across loans.\n\ndf['normalized_risk_score'] = (df['risk_score'] - df['risk_score'].mean()) / df['risk_score'].std()", "# credit_history_encoded\n# Target encoding of credit_history based on average credit approval rates for each category.\n# Usefulness: Encodes historical credit performance into numerical values, reflecting real-world approval likelihood.\n\ncredit_approval_mean = df.groupby('credit_history')['credit_approval'].mean()\ndf['credit_history_encoded'] = df['credit_history'].map(credit_approval_mean)", "# repayment_risk_interaction\n# Cross-product of credit_to_income_ratio and risk_score to model the interaction between repayment burden and credit risk.\n# Usefulness: Captures the compounded effect of repayment difficulty and risk exposure, critical for evaluating creditworthiness.\n\ndf['repayment_risk_interaction'] = df['credit_to_income_ratio'] * df['risk_score']", "# categorical_housing_onehot\n# One-hot encoding for the housing category to separate approval likelihood based on housing types.\n# Usefulness: Differentiates between rent/own/free housing, as these have marked effects on financial stability.\n\nhousing_onehot = pd.get_dummies(df['housing'], prefix='housing')\ndf = pd.concat([df, housing_onehot], axis=1)", "# categorical_employment_interaction\n# Categorical cross interaction between employment status and age_to_job_ratio for workforce stability by employment type.\n# Usefulness: Reflects how employment duration interacts with age-to-job ratio for nuanced stability insights.\n\nemployment_onehot = pd.get_dummies(df['employment'], prefix='employment')\nemployment_interaction = employment_onehot.T * df['age_to_job_ratio']\ndf = pd.concat([df, employment_interaction.T], axis=1)", "# dropping_unused_columns\n# Drop columns that are either redundant, highly correlated to newly generated features, or not useful.\ndf.drop(columns=['duration', 'risk_score', 'credit_to_income_ratio', 'age_to_job_ratio', 'residence_stability'], inplace=True)"]
