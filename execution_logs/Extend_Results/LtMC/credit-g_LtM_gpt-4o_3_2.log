# repayment_burden_duration_log
# Log transformation of repayment_burden_duration_ratio for handling skewness and interpreting repayment stress impact.
# Usefulness: Adds interpretability by normalizing skewed repayment burden over time, a critical indicator of financial stress.
df['repayment_burden_duration_log'] = np.log1p(df['repayment_burden_duration_ratio'])
end

python
# repayment_risk_log
# Log transformation of repayment_risk_interaction to reduce skewness of repayment and credit risk interaction.
# Usefulness: Handles nonlinearity and large scale differences to emphasize manageable repayment risk levels.
df['repayment_risk_log'] = np.log1p(df['repayment_risk_interaction'])
end

python
# credit_amount_log
# Log transformation of credit_amount to normalize magnitude and smooth outliers.
# Usefulness: Essential for interpreting the requested credit's economic impact without overly large absolute values.
df['credit_amount_log'] = np.log1p(df['credit_amount'])
end

python
# residence_employment_interaction
# Interaction between residence_since and employment stability factors for combined stability index.
# Usefulness: Encodes geographic and workforce stability together, capturing historical consistency in applicants' profiles.
df['residence_employment_interaction'] = df['residence_since'] * (df['employment_1<=X<4'] + df['employment_unemployed'] + df['employment_4<=X<7'])
end

python
# savings_status_binary
# Binarization of savings_status_encoding into low (0) vs moderate/high (1+) savings levels.
# Usefulness: Encodes savings status into binary levels, simplifying the feature for basic savings sufficiency analysis.
df['savings_status_binary'] = (df['savings_status_encoding'] > 0).astype(int)
end

python
# repayment_burden_duration_bin
# Binning repayment_burden_duration_ratio into quartiles.
# Usefulness: Transforms continuous stress ratio into categorical bins for interpretable ranges of financial stress.
df['repayment_burden_duration_bin'] = pd.qcut(df['repayment_burden_duration_ratio'], q=4, labels=False)
end

python
# credit_to_income_stress_interaction
# Ratio of credit_amount to repayment_burden_duration_log for stress per duration normalized by credit size.
# Usefulness: Captures the magnitude of credit stress relative to both financial and temporal repayment burdens.
df['credit_to_income_stress_interaction'] = df['credit_amount'] / (df['repayment_burden_duration_log'] + 1e-6)
end

python
# personal_status_encoded
# One-hot encoding for personal_status to separate demographic and support system categories.
# Usefulness: Breaks down social demographics for feature contribution to credit risk.
df = pd.concat([df, pd.get_dummies(df['personal_status'], prefix='personal_status')], axis=1)
end

python
df.drop(columns=['personal_status'], inplace=True)
end

python
# telephone_flag
# Binary encoding own_telephone into possession (1) or none (0).
# Usefulness: Adds interpretability and simplification for applicants' access to communication as a credit factor.
df['telephone_flag'] = (df['own_telephone'] == 'yes').astype(int)
end

python
df.drop(columns=['own_telephone'], inplace=True)
end

python
# stability_zscore
# Z-score normalization of stability_interaction for standard analysis.
# Usefulness: Normalizes geographic and workforce stability interactions to remove scale dependency.
df['stability_zscore'] = (df['stability_interaction'] - df['stability_interaction'].mean()) / df['stability_interaction'].std()
end

python
# Checking status encoding
# One-hot encoded categories for checking_status to preserve distribution across applicants' financial transaction behavior.
# Usefulness: Highlights potential banking and liquidity issues using applicants' bank account activity categories.
df = pd.concat([df, pd.get_dummies(df['checking_status'], prefix='checking_status')], axis=1)
end

python
df.drop(columns=['checking_status'], inplace=True)
end
