'] = pd.qcut(df['repayment_burden_duration_ratio'], q=4, labels=False)", "# credit_to_income_stress_interaction\n# Ratio of credit_amount to repayment_burden_duration_log for stress per duration normalized by credit size.\n# Usefulness: Captures the magnitude of credit stress relative to both financial and temporal repayment burdens.\ndf['credit_to_income_stress_interaction'] = df['credit_amount'] / (df['repayment_burden_duration_log'] + 1e-6)", "# personal_status_encoded\n# One-hot encoding for personal_status to separate demographic and support system categories.\n# Usefulness: Breaks down social demographics for feature contribution to credit risk.\ndf = pd.concat([df, pd.get_dummies(df['personal_status'], prefix='personal_status')], axis=1)", "df.drop(columns=['personal_status'], inplace=True)", "# telephone_flag\n# Binary encoding own_telephone into possession (1) or none (0).\n# Usefulness: Adds interpretability and simplification for applicants' access to communication as a credit factor.\ndf['telephone_flag'] = (df['own_telephone'] == 'yes').astype(int)", "df.drop(columns=['own_telephone'], inplace=True)", "# stability_zscore\n# Z-score normalization of stability_interaction for standard analysis.\n# Usefulness: Normalizes geographic and workforce stability interactions to remove scale dependency.\ndf['stability_zscore'] = (df['stability_interaction'] - df['stability_interaction'].mean()) / df['stability_interaction'].std()", "# Checking status encoding\n# One-hot encoded categories for checking_status to preserve distribution across applicants' financial transaction behavior.\n# Usefulness: Highlights potential banking and liquidity issues using applicants' bank account activity categories.\ndf = pd.concat([df, pd.get_dummies(df['checking_status'], prefix='checking_status')], axis=1)", "df.drop(columns=['checking_status'], inplace=True)"]
