# credit_to_savings_ratio
# Ratio of credit amount to encoded savings status, quantifies liquidity versus debt burden.
# Usefulness: Adds real-world interpretability by measuring financial preparedness against credit obligations.

df['credit_to_savings_ratio'] = df['credit_amount'] / (df['savings_status_encoding'] + 1)
end

python
# risk_per_month
# Ratio of risk score to duration in months, represents monthly risk exposure.
# Usefulness: Helps quantify how credit risk spreads across the repayment timeline, adding temporal risk granularity.

df['risk_per_month'] = df['risk_score'] / df['duration']
end

python
# income_stability
# Product of age_to_job_ratio and employment category rank, represents workforce reliability and stability.
# Usefulness: Captures individual employment stability and workforce experience, improving prediction of repayment capacity.

employment_rank_map = {'<1': 1, '1<=X<4': 2, '4<=X<7': 3, '>=7': 4, 'unemployed': 0}
df['income_stability'] = df['age_to_job_ratio'] * df['employment'].map(employment_rank_map)
end

python
# zscore_credit_amount
# Z-score transformation of credit amount feature, standardizes loan size relative to the dataset.
# Usefulness: Ensures comparability of credit amounts across different data points, mitigating scale variability.

df['zscore_credit_amount'] = (df['credit_amount'] - df['credit_amount'].mean()) / df['credit_amount'].std()
end

python
# residence_duration_ratio
# Ratio of residence_since to duration, measures temporal consistency in residence relative to the repayment period.
# Usefulness: Evaluates geographic stability against credit repayment timelines, adding lifestyle stability insights.

df['residence_duration_ratio'] = df['residence_since'] / df['duration']
end

python
# combined_financial_stability
# Interaction between checking_status rank and housing rank, captures combined financial and asset stability.
# Usefulness: Links liquidity access with financial responsibility, reflecting risk stability.

checking_status_rank_map = {'<0': 1, 'no checking': 0, '0<=X<200': 2, '>=200': 3}
housing_rank_map = {'rent': 1, 'own': 3, 'for free': 0}
df['combined_financial_stability'] = df['checking_status'].map(checking_status_rank_map) * df['housing'].map(housing_rank_map)
end

python
# family_obligation_ratio
# Interaction between personal_status rank and num_dependents, represents family-related financial obligations.
# Usefulness: Reflects how personal and familial obligations impact financial capacity.

personal_status_rank_map = {'male single': 1, 'female div/dep/mar': 2, 'male mar/wid': 3, 'male div/sep': 2}
df['family_obligation_ratio'] = df['personal_status'].map(personal_status_rank_map) * df['num_dependents']
end

python
# normalized_credit_to_income_ratio
# Min-Max scaled transformation of credit_to_income_ratio, normalizes repayment burden representation.
# Usefulness: Enhances comparability and retains interpretability across diverse repayment burdens.

df['normalized_credit_to_income_ratio'] = (df['credit_to_income_ratio'] - df['credit_to_income_ratio'].min()) / (df['credit_to_income_ratio'].max() - df['credit_to_income_ratio'].min())
end

python
# net_stability_score
# Weighted sum of residence_stability, income_stability, and savings_status_encoding, approximates overall stability.
# Usefulness: Combines multiple indicators to provide a holistic stability score, improving prediction accuracy.

df['net_stability_score'] = (0.4 * df['residence_stability']) + (0.4 * df['income_stability']) + (0.2 * df['savings_status_encoding'])
end

python
df.drop(columns=['zscore_duration'], inplace=True)
end
