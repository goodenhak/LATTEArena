# credit_to_income_ratio
# Ratio of credit amount to the product of installment rate and duration, representing repayment burden.
# Usefulness: Highlights whether the applicant's credit consumption relative to disposable income is manageable.

df['credit_to_income_ratio'] = df['credit_amount'] / (df['installment_commitment'] * df['duration'])
end

python
# zscore_duration
# Z-score transformation for duration feature, standardizing the time frame for credit repayment.
# Usefulness: Standardizes the duration to easily compare time periods across applicants.

df['zscore_duration'] = (df['duration'] - df['duration'].mean()) / df['duration'].std()
end

python
# risk_score
# Risk exposure based on the product of credit amount and duration, approximating credit risk.
# Usefulness: Captures the total burden and length of repayment which correlates with credit risk.

df['risk_score'] = df['credit_amount'] * df['duration']
end

python
# age_to_job_ratio
# Ratio of age to employment duration, indicating stability and experience in the workforce.
# Usefulness: Provides insight into job persistence relative to age, a proxy for career stability.

df['age_to_job_ratio'] = df['age'] / (df['employment'].apply(lambda x: {'<1': 0.5, '1<=X<4': 2.5, '4<=X<7': 5.5, '>=7': 8, 'unemployed': 0}[x]) + 1)
end

python
# residence_stability
# Ratio of years at current residence to age, measuring geographic and lifestyle stability.
# Usefulness: Captures if applicants are rooted in their current locale, reflecting demographic stability.

df['residence_stability'] = df['residence_since'] / df['age']
end

python
# combined_housing_property
# Cross-feature combining housing type and property ownership magnitude.
# Usefulness: Highlights whether applicants own property and live in stable housing, aiding stability assessment.

df['combined_housing_property'] = df['housing'] + _ + df['property_magnitude']
end

python
# savings_status_encoding
# Label encode savings_status into numerical categories for interpretability and machine learning compatibility.
# Usefulness: Converts categorical savings status into numerical representation to capture savings behavior.

df['savings_status_encoding'] = df['savings_status'].apply(lambda x: {'<100': 0, '100<=X<500': 1, '500<=X<1000': 2, '>=1000': 3, 'no known savings': 4}[x])
end

python
# financial_stability
# Concatenation of savings_status_encoding and checking_status_encoding to represent overall financial standing.
# Usefulness: Combines two key indicators of financial resources into a single feature for clearer patterns.

df['financial_stability'] = df['savings_status_encoding'].astype(str) + _ + df['checking_status'].apply(lambda x: {'<0': '0', 'no checking': '1', '0<=X<200': '2', '>=200': '3'}[x])
end

python
# credit_to_income_ratio and installment_to_income_ratio capture repayment burden.
df.drop(columns=['installment_commitment'], inplace=True)
end
