# repayment_stress_score
# Feature description: Combines repayment_burden_duration_ratio and repayment_risk_interaction using a weighted ratio to model aggregated repayment stress.
# Usefulness: Captures combined repayment stress due to both time-bound burden and credit risk interaction, improving interpretability of stress metrics.
df['repayment_stress_score'] = df['repayment_burden_duration_ratio'] * (df['repayment_risk_interaction']  0.5)
end

python
# credit_per_stability
# Feature description: Ratio of credit_amount to stability_interaction, assessing how credit size relates to demographic and geographic stability.
# Usefulness: Adds real-world interpretability by modeling whether a person’s stability adequately supports their requested credit amount.
df['credit_per_stability'] = df['credit_amount'] / (df['stability_interaction'] + 1e-6)
end

python
# stability_aggregate_score
# Feature description: Weighted sum of residence_since, employment_1<=X<4, employment_4<=X<7, and stability_interaction.
# Usefulness: Reflects overall stability of the individual by aggregating key stability contributing factors into a comprehensive single feature.
df['stability_aggregate_score'] = df['residence_since'] + df['employment_1<=X<4'] + df['employment_4<=X<7'] + df['stability_interaction']
end

python
# normalized_credit_amount
# Feature description: Min-max normalization of credit_amount for scaling within the [0, 1] range.
# Usefulness: Standardizing the feature helps reduce variance and align credit amount with the scale of other features.
df['normalized_credit_amount'] = (df['credit_amount'] - df['credit_amount'].min()) / (df['credit_amount'].max() - df['credit_amount'].min())
end

python
# aged_stability_interaction
# Feature description: Interaction of age_to_job_ratio and employment_unemployed.
# Usefulness: Captures the combined effects of workforce dynamics for unemployed individuals and job-age correlation, offering insights into employment-driven stability.
df['aged_stability_interaction'] = df['employment_unemployed'] * df['age_to_job_ratio']
end

python
# drop unused raw categorical columns
df.drop(columns=['personal_status', 'own_telephone', 'checking_status'], inplace=True)
end
