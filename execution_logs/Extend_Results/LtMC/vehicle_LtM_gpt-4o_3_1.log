# SHAPE_RATIO
# Ratio of MAX.LENGTH_ASPECT_RATIO to PR.AXIS_ASPECT_RATIO to capture proportions of the silhouette's shape.
# Usefulness: Helps combine both length and axis proportions to better capture shape differences among vehicle types.
df['SHAPE_RATIO'] = df['MAX.LENGTH_ASPECT_RATIO'] / df['PR.AXIS_ASPECT_RATIO']
end

python
# CIRCULARITY_COMPACTNESS
# Ratio of DISTANCE_CIRCULARITY to SQRT_COMPACTNESS to quantify how compact a shape is compared to its circularity.
# Usefulness: Connects compactness and circularity metrics, especially relevant for differentiating compact vs. elongated silhouettes.
df['CIRCULARITY_COMPACTNESS'] = df['DISTANCE_CIRCULARITY'] / df['SQRT_COMPACTNESS']
end

python
# ELONG_SCATTER_INTERACTION
# Multiplication of ELONGATEDNESS and SCATTER_RATIO to amplify their joint effects.
# Usefulness: Highlights the relationship between elongation and scatter patterns to distinguish vehicle elongation characteristics.
df['ELONG_SCATTER_INTERACTION'] = df['ELONGATEDNESS'] * df['SCATTER_RATIO']
end

python
# SHAPE_VARIANCE_RATIO
# Ratio of SCALED_VARIANCE_ALONG_MINOR_AXIS to SCALED_VARIANCE_ALONG_MAJOR_AXIS.
# Usefulness: Captures the variance balance along the minor and major axes, critical for identifying shape asymmetries.
df['SHAPE_VARIANCE_RATIO'] = df['SCALED_VARIANCE_ALONG_MINOR_AXIS'] / df['SCALED_VARIANCE_ALONG_MAJOR_AXIS']
end

python
# ZSCALED_RADIUS_DIFF
# Z-score normalization of SCALED_RADIUS_MIN_VAR_DIFF.
# Usefulness: Normalizes radius variance differences to reveal outlier patterns across different scales of features.
df['ZSCALED_RADIUS_DIFF'] = (df['SCALED_RADIUS_MIN_VAR_DIFF'] - df['SCALED_RADIUS_MIN_VAR_DIFF'].mean()) / df['SCALED_RADIUS_MIN_VAR_DIFF'].std()
end

python
# LOG_ELONGATEDNESS
# Log transformation of ELONGATEDNESS to reduce skewness and amplify smaller elongation distinctions.
# Usefulness: Applies log scaling to adjust for skewed distributions while preserving relative elongation differences.
df['LOG_ELONGATEDNESS'] = np.log(df['ELONGATEDNESS'])
end

python
# NORMALIZED_RADIUS_RATIO
# Min-max normalization of RADIUS_RATIO.
# Usefulness: Scales RADIUS_RATIO into a comparable range for improved generalization in machine learning algorithms.
df['NORMALIZED_RADIUS_RATIO'] = (df['RADIUS_RATIO'] - df['RADIUS_RATIO'].min()) / (df['RADIUS_RATIO'].max() - df['RADIUS_RATIO'].min())
end

python
# VAR_TOTAL
# Sum of SCALED_VARIANCE_ALONG_MINOR_AXIS and SCALED_VARIANCE_ALONG_MAJOR_AXIS.
# Usefulness: Provides a combined measure of overall variance along both axes to emphasize total silhouette variance.
df['VAR_TOTAL'] = df['SCALED_VARIANCE_ALONG_MINOR_AXIS'] + df['SCALED_VARIANCE_ALONG_MAJOR_AXIS']
end

python
# PRSCATTER_NORMALIZED
# Interaction between PR.AXIS_ASPECT_RATIO and SCATTER_RATIO, normalized using z-score.
# Usefulness: Improves the interpretability of PR_SCATTER_RATIO_INTERACTION by scaling it with z-score normalization.
df['PRSCATTER_NORMALIZED'] = (df['PR_SCATTER_RATIO_INTERACTION'] - df['PR_SCATTER_RATIO_INTERACTION'].mean()) / df['PR_SCATTER_RATIO_INTERACTION'].std()
end

python
# HOLLOWS_RATIO_RESCALED
# Reciprocal transformation of HOLLOWS_RATIO to adjust scaling on bounding polygon and emphasize smaller values.
# Usefulness: Highlights differences in hollows for cases with significantly small bounding polygons.
df['HOLLOWS_RATIO_RESCALED'] = 1 / df['HOLLOWS_RATIO']
end

