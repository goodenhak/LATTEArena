# Interaction feature between PR.AXIS_ASPECT_RATIO and SCATTER_RATIO.
# Usefulness: Shows the relation between shape aspect ratio and mass distribution, helping in distinguishing shapes with different scatter patterns (e.g., compact cars vs. vans).
df['PR_SCATTER_RATIO_INTERACTION'] = df['PR.AXIS_ASPECT_RATIO'] * df['SCATTER_RATIO']
end

python
# DIST_CIRC_CIRCULARITY_RATIO
# Ratio of DISTANCE_CIRCULARITY to CIRCULARITY.
