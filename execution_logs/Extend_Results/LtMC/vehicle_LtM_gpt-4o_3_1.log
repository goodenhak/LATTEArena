2026-05-26 02:05:30,372 - INFO - ops_string = ["# ELONGATEDNESS_SCALED_VARIANCE_RATIO\n# Ratio of ELONGATEDNESS to SCALED_VARIANCE_ALONG_MINOR_AXIS to capture the relationship between elongation and variance along the minor axis.\n# Usefulness: Helps link elongation with minor axis variance, potentially distinguishing vehicle shapes with different elongation levels.\ndf['ELONGATEDNESS_SCALED_VARIANCE_RATIO'] = df['ELONGATEDNESS'] / df['SCALED_VARIANCE_ALONG_MINOR_AXIS']", "# PR_AX_MAX_LENGTH_INTERACTION\n# Interaction between PR.AXIS_ASPECT_RATIO and MAX.LENGTH_ASPECT_RATIO to capture joint effects of principal axis proportion and maximum length proportion.\n# Usefulness: Highlights combined relationships between axes proportions and elongation, improving silhouette type distinction.\ndf['PR_AX_MAX_LENGTH_INTERACTION'] = df['PR.AXIS_ASPECT_RATIO'] * df['MAX.LENGTH_ASPECT_RATIO']", "# VARIANCE_MOMENT_DIFFERENCE\n# Difference between SCALED_VARIANCE_ALONG_MAJOR_AXIS and SCALED_VARIANCE_ALONG_MINOR_AXIS.\n# Usefulness: Captures asymmetry in variance across major and minor axes, which may be important for distinguishing face-on versus side views of vehicles.\ndf['VARIANCE_MOMENT_DIFFERENCE'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MINOR_AXIS']", "# DIST_CIRC_ELONGATION_RATIO\n# Ratio of DISTANCE_CIRCULARITY to ELONGATEDNESS to capture the relationship between compactness and elongation.\n# Usefulness: Differentiates between vehicles with similar compactness but varying elongations, enhancing classifier sensitivity.\ndf['DIST_CIRC_ELONGATION_RATIO'] = df['DISTANCE_CIRCULARITY'] / df['ELONGATEDNESS']", "# RECTANGULARITY_RATIO\n# Ratio of MAX.LENGTH_RECTANGULARITY to PR.AXIS_RECTANGULARITY.\n# Usefulness: Measures rectangularity differences across dimensions, which may reflect unique configurations of vehicles like VANs or BUSES.\ndf['RECTANGULARITY_RATIO'] = df['MAX.LENGTH_RECTANGULARITY'] / df['PR.AXIS_RECTANGULARITY']", "# RADIUS_HOLLOW_INTERACTION\n# Interaction feature between RADIUS_RATIO and HOLLOWS_RATIO.\n# Usefulness: Captures how radius variation interacts with hollow areas to differentiate between vehicle categories, such as compact versus larger silhouettes.\ndf['RADIUS_HOLLOW_INTERACTION'] = df['RADIUS_RATIO'] * df['HOLLOWS_RATIO']", "# ELONG_SCATTER_PR_RATIO\n# Product of ELONG_SCATTER_RATIO and PR.AXIS_ASPECT_RATIO to analyze how scatter elongation connects to aspect ratio proportions.\n# Usefulness: Adds insight into the interaction of scatter effects with primary axis proportions, enhancing feature diversity for classification.\ndf['ELONG_SCATTER_PR_RATIO'] = df['ELONG_SCATTER_RATIO'] * df['PR.AXIS_ASPECT_RATIO']", "# ADDITIVE_RADIUS_FEATURE\n# Sum of SCALED_RADIUS_OF_GYRATION and SCALED_RADIUS_MIN_VAR_DIFF.\n# Usefulness: Combines radius-based attributes to better capture overall shape and size variability, useful for classification.\ndf['ADDITIVE_RADIUS_FEATURE'] = df['SCALED_RADIUS_OF_GYRATION'] + df['SCALED_RADIUS_MIN_VAR_DIFF']", "# DROP: SKEWNESS_ABOUT_MINOR_AXIS\ndf.drop(columns=['SKEWNESS_ABOUT_MINOR_AXIS'], inplace=True)", "# DROP: MAX_PR_RECT_DIFF\ndf.drop(columns=['MAX_PR_RECT_DIFF'], inplace=True)"]
