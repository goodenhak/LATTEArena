# LOG_DISTANCE_CIRCULARITY
# Log transformation of DISTANCE_CIRCULARITY to reduce skewness and highlight distinctions in area to distance relationships.
# Usefulness: Reduces skewness in DISTANCE_CIRCULARITY and better highlights how compactness varies among vehicle silhouettes.
df['LOG_DISTANCE_CIRCULARITY'] = df['DISTANCE_CIRCULARITY'].apply(np.log)
end

python
# RECIPROCAL_SCATTER_RATIO
# Reciprocal of SCATTER_RATIO to emphasize smaller scatter values more significantly in vehicle classification.
# Usefulness: Highlights differences between vehicles with highly compact silhouettes and those with dispersed variance.
df['RECIPROCAL_SCATTER_RATIO'] = 1 / df['SCATTER_RATIO']
end

python
# PR_LENGTH_SCATTER_RATIO
# Interaction feature combining PR.AXIS_ASPECT_RATIO and SCATTER_RATIO to capture relationships between proportions and scatter.
# Usefulness: Higher values may correspond to highly elongated silhouettes with specific axis proportions impacting classification.
df['PR_LENGTH_SCATTER_RATIO'] = df['PR.AXIS_ASPECT_RATIO'] * df['SCATTER_RATIO']
end

python
# ELONG_AREA_RATIO
# Ratio of ELONGATEDNESS to the area-based feature VAR_TOTAL.
# Usefulness: Differentiates vehicle types by accounting for how elongation relates to their total variance in area.
df['ELONG_AREA_RATIO'] = df['ELONGATEDNESS'] / df['VAR_TOTAL']
end

python
# VAR_MINOR_MAJOR_DIFF
# Difference between SCALED_VARIANCE_ALONG_MINOR_AXIS and SCALED_VARIANCE_ALONG_MAJOR_AXIS.
# Usefulness: Highlights contrasts between the variance along major and minor axes, useful in distinguishing shape irregularities.
df['VAR_MINOR_MAJOR_DIFF'] = df['SCALED_VARIANCE_ALONG_MINOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MAJOR_AXIS']
end

python
# MINMAX_SHAPE_RATIO
# Normalized version of SHAPE_RATIO using min-max scaling for consistent scaling.
# Usefulness: Preserves proportional differences between shapes while normalizing the range for better model learning.
df['MINMAX_SHAPE_RATIO'] = (df['SHAPE_RATIO'] - df['SHAPE_RATIO'].min()) / (df['SHAPE_RATIO'].max() - df['SHAPE_RATIO'].min())
end

python
# COMBINED_GEOMETRY
# Product of MAX.LENGTH_ASPECT_RATIO and PR.AXIS_ASPECT_RATIO as a combined geometric representation feature.
# Usefulness: Captures joint effects of major and minor axis proportions in a single variable to differentiate vehicles.
df['COMBINED_GEOMETRY'] = df['MAX.LENGTH_ASPECT_RATIO'] * df['PR.AXIS_ASPECT_RATIO']
end

python
# CIRCULARITY_VARIANCE_RATIO
# Ratio of DISTANCE_CIRCULARITY to VAR_TOTAL to account for circular tendencies relative to variance.
# Usefulness: Highlights how circularity is distributed across the overall shape variance, useful in distinguishing more circular classes.
df['CIRCULARITY_VARIANCE_RATIO'] = df['DISTANCE_CIRCULARITY'] / df['VAR_TOTAL']
end

