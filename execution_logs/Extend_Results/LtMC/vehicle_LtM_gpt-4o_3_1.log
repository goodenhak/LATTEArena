2026-05-26 02:07:12,389 - INFO - ops_string = ["# LOG_MAX_LENGTH_ASPECT_RATIO\n# Apply log transformation to MAX.LENGTH_ASPECT_RATIO to reduce skewness and enhance interpretability.\n# Usefulness: Captures proportional differences in maximum length by reducing the influence of extreme values.\ndf['LOG_MAX_LENGTH_ASPECT_RATIO'] = np.log(df['MAX.LENGTH_ASPECT_RATIO'])", "# MAX.PR_AXIS_RATIO_COMBINATION\n# Compute the ratio of MAX.LENGTH_ASPECT_RATIO to PR.AXIS_ASPECT_RATIO to amplify joint length and axis effects.\n# Usefulness: Highlights the comparative shape proportions and how length aligns with primary axes.\ndf['MAX.PR_AXIS_RATIO_COMBINATION'] = df['MAX.LENGTH_ASPECT_RATIO'] / df['PR.AXIS_ASPECT_RATIO']", "# SHAPE_CIRCULARITY_INTERACTION\n# Multiply SHAPE_RATIO and CIRCULARITY_COMPACTNESS as a cross-feature for capturing higher-order proportions.\n# Usefulness: Emphasizes combined effects of shape and circularity for differentiating between more rounded vs. elongated silhouettes.\ndf['SHAPE_CIRCULARITY_INTERACTION'] = df['SHAPE_RATIO'] * df['CIRCULARITY_COMPACTNESS']", "# LOG_DISTANCE_CIRCULARITY\n# Apply log transformation to DISTANCE_CIRCULARITY for handling skewness and amplifying subtle distinctions.\n# Usefulness: Highlights circularity-based differences in vehicle shapes, making compact vs. elongated easier to separate.\ndf['LOG_DISTANCE_CIRCULARITY'] = np.log(df['DISTANCE_CIRCULARITY'])", "# ELONGATEDNESS_SCATTER_RATIO\n# Calculate the ratio of ELONGATEDNESS to SCATTER_RATIO to capture elongation normalized by scatter influence.\n# Usefulness: Quantifies elongation considering scatter distribution, making it suitable for stretched vs. compact forms.\ndf['ELONGATEDNESS_SCATTER_RATIO'] = df['ELONGATEDNESS'] / df['SCATTER_RATIO']", "# SKEWNESS_MAJOR_MINMAX\n# Perform min-max normalization on SKEWNESS_ABOUT_MAJOR_AXIS to ensure values are scaled between 0 and 1.\n# Usefulness: Ensures all skewness data is normalized for comparability without dominance by larger values.\ndf['SKEWNESS_MAJOR_MINMAX'] = (df['SKEWNESS_ABOUT_MAJOR_AXIS'] - df['SKEWNESS_ABOUT_MAJOR_AXIS'].min()) / (df['SKEWNESS_ABOUT_MAJOR_AXIS'].max() - df['SKEWNESS_ABOUT_MAJOR_AXIS'].min())", "# VARIANCE_TOTAL_LOG\n# Log-transform VAR_TOTAL to reduce the influence of extreme variance-related effects.\n# Usefulness: Captures overall shape variance while down-weighting extremely high values for better feature separability.\ndf['VARIANCE_TOTAL_LOG'] = np.log(df['VAR_TOTAL'])", "# NORMALIZED_HOLLOW_RATIO\n# Normalize HOLLOWS_RATIO using min-max normalization for comparable scaling across range.\n# Usefulness: Highlights variations in hollowed areas relative to bounding polygons while removing scale effects.\ndf['NORMALIZED_HOLLOW_RATIO'] = (df['HOLLOWS_RATIO'] - df['HOLLOWS_RATIO'].min()) / (df['HOLLOWS_RATIO'].max() - df['HOLLOWS_RATIO'].min())", "# PR_AXIS_CIRCULARITY_COMBO\n# Combine PR.AXIS_ASPECT_RATIO and DIST_CIRC_CIRCULARITY_RATIO using multiplication for shape and circularity interaction.\n# Usefulness: Captures complementary effects between aspect ratio and circularity features for better separability.\ndf['PR_AXIS_CIRCULARITY_COMBO'] = df['PR.AXIS_ASPECT_RATIO'] * df['DIST_CIRC_CIRCULARITY_RATIO']", "# SHAPE_SCATTER_RATIO_ZSCORE\n# Z-score normalization of SHAPE_VARIANCE_RATIO for uniform scaling and reducing value disparities.\n# Usefulness: Balances variance contributions across shapes for better classification separability.\ndf['SHAPE_SCATTER_RATIO_ZSCORE'] = (df['SHAPE_VARIANCE_RATIO'] - df['SHAPE_VARIANCE_RATIO'].mean()) / df['SHAPE_VARIANCE_RATIO'].std()", "# DROP_SKEWNESS_ABOUT_MAJOR_AXIS_AND_COMPACTNESS\n# Dropping the columns that are now redundant due to added normalized or scaled counterparts.\ndf.drop(columns=['SKEWNESS_ABOUT_MAJOR_AXIS', 'SQRT_COMPACTNESS'], inplace=True)"]
