# compactness_zscore
# Z-score of the COMPACTNESS feature to standardize and highlight deviations from the mean.
# Usefulness: Helps normalize the scale of the compactness measure and emphasize outliers, aiding in better feature differentiation.
df['compactness_zscore'] = (df['COMPACTNESS'] - df['COMPACTNESS'].mean()) / df['COMPACTNESS'].std()
end

python
# radius_ratio_log
# Logarithm of the RADIUS_RATIO feature to reduce skewness and highlight smaller differences.
# Usefulness: Addresses the skewed distribution of RADIUS_RATIO and enables a more balanced contribution to models.
df['radius_ratio_log'] = np.log(df['RADIUS_RATIO'])
end

python
# compactness_circularity_ratio
# Ratio between COMPACTNESS and CIRCULARITY to capture overall shape efficiency.
# Usefulness: Highlights the relationship between perimeter-based and radius-based compactness measures, potentially useful for distinguishing shapes.
df['compactness_circularity_ratio'] = df['COMPACTNESS'] / df['CIRCULARITY']
end

python
# scatter_ratio_radius_ratio_interaction
# Interaction term between SCATTER_RATIO and RADIUS_RATIO to capture relationships between shape spread and radius variance.
# Usefulness: Provides insights into how spread and radius irregularity interact for different vehicle silhouettes.
df['scatter_ratio_radius_ratio_interaction'] = df['SCATTER_RATIO'] * df['RADIUS_RATIO']
end

python
# scaled_variance_minor_log
# Logarithm of SCALED_VARIANCE_ALONG_MINOR_AXIS to correct skewness and highlight smaller-scale changes.
# Usefulness: Allows for better representation of features with high variability, enhancing model performance.
df['scaled_variance_minor_log'] = np.log(df['SCALED_VARIANCE_ALONG_MINOR_AXIS'])
end

python
# skew_major_minor_ratio
# Ratio of SKEWNESS_ABOUT_MAJOR_AXIS to SKEWNESS_ABOUT_MINOR_AXIS to capture the balance of asymmetry along major and minor axes.
# Usefulness: Differentiates vehicles based on the symmetry of their silhouettes, relevant for classification.
df['skew_major_minor_ratio'] = df['SKEWNESS_ABOUT_MAJOR_AXIS'] / (df['SKEWNESS_ABOUT_MINOR_AXIS'] + 1)
end

python
# shape_complexity
# Composite measure calculated as (COMPACTNESS * RADIUS_RATIO / CIRCULARITY).
# Usefulness: Reflects the overall complexity of the silhouette by combining three key shape descriptors.
df['shape_complexity'] = (df['COMPACTNESS'] * df['RADIUS_RATIO']) / df['CIRCULARITY']
end

python
# elongatedness_pr_axis_ratio
# Interaction between ELONGATEDNESS and PR.AXIS_ASPECT_RATIO to indicate the combined impact of elongation and aspect proportions.
# Usefulness: Helps model elongated shapes typical for certain vehicles like buses or vans.
df['elongatedness_pr_axis_ratio'] = df['ELONGATEDNESS'] * df['PR.AXIS_ASPECT_RATIO']
end

python
# kurtosis_major_minor_diff
