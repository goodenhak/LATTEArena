# FEATURE: AREA_NORMALIZED_RADIUS
# Ratio of area (calculated from MAX.LENGTH_RECTANGULARITY * MAX.LENGTH_ASPECT_RATIO) to NORMALIZED_RADIUS_RATIO.
# Usefulness: Captures relationship between silhouette size and normalized radius variation, emphasizing shape variability for classification.
df['AREA_NORMALIZED_RADIUS'] = (df['MAX.LENGTH_RECTANGULARITY'] * df['MAX.LENGTH_ASPECT_RATIO']) / (df['NORMALIZED_RADIUS_RATIO'] + 1e-5)
end

python
# FEATURE: COMPACTNESS_VARIANCE_RATIO
# Ratio of SQRT_COMPACTNESS to SCALED_VARIANCE_ALONG_MINOR_AXIS for compactness relative to structural variance.
# Usefulness: Helps separate compact versus scattered silhouettes by quantifying compactness normalized by variance perpendicular to the major axis.
df['COMPACTNESS_VARIANCE_RATIO'] = df['SQRT_COMPACTNESS'] / (df['SCALED_VARIANCE_ALONG_MINOR_AXIS'] + 1e-5)
end

