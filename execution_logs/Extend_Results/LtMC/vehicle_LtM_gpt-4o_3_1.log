# LOG_PR.AXIS_ASPECT_RATIO
# Log transformation of PR.AXIS_ASPECT_RATIO, reducing skew and emphasizing smaller changes in proportions.
# Usefulness: Highlights proportional differences in the minor and major axes, which helps capture distinctions in vehicle types with varying shapes.
df['LOG_PR.AXIS_ASPECT_RATIO'] = np.log(df['PR.AXIS_ASPECT_RATIO'])
end

python
# MAX.LENGTH_TO_RADIUS_RATIO
# Ratio of MAX.LENGTH_ASPECT_RATIO to RADIUS_RATIO.
# Usefulness: Captures the proportional relationship between the maximum length aspect ratio and the radius ratio, which reflects shape elongation in relation to perimeter metrics.
df['MAX.LENGTH_TO_RADIUS_RATIO'] = df['MAX.LENGTH_ASPECT_RATIO'] / df['RADIUS_RATIO']
end

python
# DIST_CIRC_TO_COMPACTNESS_RATIO
# Ratio of DIST_CIRC_CIRCULARITY_RATIO to SQRT_COMPACTNESS.
# Usefulness: Balances the trade-off between how circular and compact a shape is, emphasizing deviations from symmetry.
df['DIST_CIRC_TO_COMPACTNESS_RATIO'] = df['DIST_CIRC_CIRCULARITY_RATIO'] / df['SQRT_COMPACTNESS']
end

python
# ZSCORE_CIRCULARITY_COMPACTNESS
# Z-score normalization of CIRCULARITY_COMPACTNESS.
# Usefulness: Standardized transformation enhances the significance of deviations in shape compactness relative to circularity for classification.
df['ZSCORE_CIRCULARITY_COMPACTNESS'] = (df['CIRCULARITY_COMPACTNESS'] - df['CIRCULARITY_COMPACTNESS'].mean()) / df['CIRCULARITY_COMPACTNESS'].std()
end

python
# NORM_SQRT_COMPACTNESS
# Min-max normalization of SQRT_COMPACTNESS.
# Usefulness: Scales circularity-related compactness to comparable ranges, improving the feature's contribution to models with varying scales.
df['NORM_SQRT_COMPACTNESS'] = (df['SQRT_COMPACTNESS'] - df['SQRT_COMPACTNESS'].min()) / (df['SQRT_COMPACTNESS'].max() - df['SQRT_COMPACTNESS'].min())
end

python
# ZSCALED_VARIANCE_MINOR
# Z-score normalization of SCALED_VARIANCE_ALONG_MINOR_AXIS.
# Usefulness: Captures relative rotational variance symmetry by centering and scaling minor axis variance, enhancing interpretability.
df['ZSCALED_VARIANCE_MINOR'] = (df['SCALED_VARIANCE_ALONG_MINOR_AXIS'] - df['SCALED_VARIANCE_ALONG_MINOR_AXIS'].mean()) / df['SCALED_VARIANCE_ALONG_MINOR_AXIS'].std()
end

python
# MINOR_TO_TOTAL_VARIANCE_RATIO
# Ratio of SCALED_VARIANCE_ALONG_MINOR_AXIS to VAR_TOTAL.
# Usefulness: Shows proportional importance of minor-axis variance in total variance, enhancing separability between silhouette orientations.
df['MINOR_TO_TOTAL_VARIANCE_RATIO'] = df['SCALED_VARIANCE_ALONG_MINOR_AXIS'] / df['VAR_TOTAL']
end

python
# ROTATIONAL_SHAPE_INTERACTION
# Multiplication of SHAPE_RATIO and SHAPE_VARIANCE_RATIO.
# Usefulness: Amplifies the joint effects of shape proportions and rotational variance, critical for distinguishing class-specific geometries.
df['ROTATIONAL_SHAPE_INTERACTION'] = df['SHAPE_RATIO'] * df['SHAPE_VARIANCE_RATIO']
end

python
# PROPORTION_CIRC_INTERACTION
# Interaction between NORMALIZED_RADIUS_RATIO and SQRT_COMPACTNESS.
# Usefulness: Combines radius proportions with compactness to explain the geometry of vehicles, improving class discrimination.
df['PROPORTION_CIRC_INTERACTION'] = df['NORMALIZED_RADIUS_RATIO'] * df['SQRT_COMPACTNESS']
end

python
# ORIENTATION_INVAR_RATIO
# Absolute difference between PR.AXIS_ASPECT_RATIO and SHAPE_RATIO.
# Usefulness: Measures orientation-independent disparity between axis proportions and overall shape ratio, aiding in classifying vehicles from different angles.
df['ORIENTATION_INVAR_RATIO'] = abs(df['PR.AXIS_ASPECT_RATIO'] - df['SHAPE_RATIO'])
end

python
# SCALED_RADIUS_DIFF_RATIO
# Ratio of SCALED_RADIUS_MIN_VAR_DIFF to SCALED_RADIUS_OF_GYRATION.
# Usefulness: Captures variations in silhouette dimensions, aiding in distinguishing shape complexity among vehicle types.
df['SCALED_RADIUS_DIFF_RATIO'] = df['SCALED_RADIUS_MIN_VAR_DIFF'] / df['SCALED_RADIUS_OF_GYRATION']
end

python
# LOG_HOLLOWS_RATIO
# Log transformation of HOLLOWS_RATIO.
# Usefulness: Reduces skew in hollowness proportions, emphasizing smaller hollows which may be indicative of class distinctions.
df['LOG_HOLLOWS_RATIO'] = np.log(df['HOLLOWS_RATIO'])
end

python
# ELONGATEDNESS_SCALED_RATIO
# Ratio of ELONGATEDNESS to SCALED_RADIUS_OF_GYRATION.
# Usefulness: Highlights contribution of elongation relative to the radius of gyration, aiding in shape-based classification.
df['ELONGATEDNESS_SCALED_RATIO'] = df['ELONGATEDNESS'] / df['SCALED_RADIUS_OF_GYRATION']
end

python
# Remove less relevant features
df.drop(columns=['ZSCALED_RADIUS_DIFF', 'PRSCATTER_NORMALIZED', 'HOLLOWS_RATIO_RESCALED'], inplace=True)
end
