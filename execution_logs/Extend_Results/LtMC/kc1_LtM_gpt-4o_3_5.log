# log_ev_per_loc
# Log transformed essential complexity per LOC (log_ev / loc). Highlights essential complexity in log scale, normalized for module size.
# Usefulness: Allows modeling of defect-proneness while accounting for both non-linear scaling of complexity and code size.
df['log_ev_per_loc'] = df['log_ev'] / df['loc']
end

python
# iv_n_ratio
# Ratio of design complexity to the count of operators/operands (iv(g) / n). Captures the balance between structural complexity and functional operations.
# Usefulness: This interaction provides insight into whether high complexity co-occurs with higher functionality.
df['iv_n_ratio'] = df['iv(g)'] / (df['n'] + 1e-5)
end

python
# cumulative_loc
# Cumulative sum of LOC per module (cumsum(loc)). Tracks size growth trends across modules.
# Usefulness: Identifies whether larger modules earlier or later in the pipeline correlate with defect trends.
df['cumulative_loc'] = df['loc'].cumsum()
end

python
# defect_density
# Defect density proxy: ratio of log_v (volume) to maint_readability. Higher ratios could imply less maintainable, defect-prone code.
# Usefulness: Highlights maintainability issues per volume of implementation in the code.
df['defect_density'] = df['log_v'] / (df['maint_readability'] + 1e-5)
end

python
# complexity_interaction
# Interaction term for ev(g) and iv(g) (ev(g) * iv(g)). Represents higher-order joint complexity.
# Usefulness: Captures the compounded impact of essential and design complexity, aiding in stronger defect predictions.
df['complexity_interaction'] = df['ev(g)'] * df['iv(g)']
end

python
# avg_branch_density_per_readability
# Average branch density per maintainability (loc_per_branch / maint_readability). Assesses how structural density scales with maintainability.
# Usefulness: Detects potential hotspots where high branching density overrides code readability.
df['avg_branch_density_per_readability'] = df['loc_per_branch'] / (df['maint_readability'] + 1e-5)
end

python
# normalized_uniq_op_and_opnd_ratio
# Min-max normalized unique operators to operands ratio (uniq_op_and_opnd_ratio).
# Usefulness: Keeps the feature within a linear range, avoiding potential distortions caused by extreme skewness.
df['normalized_uniq_op_and_opnd_ratio'] = (df['uniq_op_and_opnd_ratio'] - df['uniq_op_and_opnd_ratio'].min()) / (df['uniq_op_and_opnd_ratio'].max() - df['uniq_op_and_opnd_ratio'].min())
end

python
# halstead_per_complexity
# Ratio of Halstead n to total complexity (n / (ev(g) + iv(g))). A measure of operational effort relative to overall complexity.
# Usefulness: Highlights defect-prone modules where high function counts exist relative to structural/design complexity.
df['halstead_per_complexity'] = df['n'] / (df['ev(g)'] + df['iv(g)'] + 1e-5)
end

python
# log_rolling_mean_loc
# Log-transformed rolling mean of LOC (log(rolling_mean_loc)). Reduces skewness while capturing trends in LOC over modules.
# Usefulness: Ensures stability and patterns in LOC trends are more interpretable, aiding defect prediction.
df['log_rolling_mean_loc'] = np.log(df['rolling_mean_loc'] + 1e-5)
end

python
# maintainability_effectiveness
# Ratio of maint_readability to loc (maint_readability / loc). Captures how maintainability scales per unit size.
# Usefulness: Directly measures how well maintainability scales with module size, identifying low-efficiency code regions.
df['maintainability_effectiveness'] = df['maint_readability'] / (df['loc'] + 1e-5)
end

python
df.drop(columns=['reciprocal_uniq_op_and_opnd_ratio'], inplace=True)
end

python
df.drop(columns=['n_per_branch_density'], inplace=True)
end

