2026-05-26 01:23:08,725 - INFO - ops_string = ["# log_ev\n# Log transformation of McCabe essential complexity\n# Usefulness: Reduces skewness in ev(g) distribution, emphasizes relative differences in complexity that impact defect likelihood.\ndf['log_ev'] = np.log(df['ev(g)'] + 1)", "# log_iv\n# Log transformation of McCabe design complexity\n# Usefulness: Handles skewness in iv(g), capturing relative design intricacy differences associated with defect risks.\ndf['log_iv'] = np.log(df['iv(g)'] + 1)", "# ev_per_loc\n# Essential complexity per line of code\n# Usefulness: Normalizes ev(g) by size (loc) to signify complexity density, which can correlate with defects.\ndf['ev_per_loc'] = df['ev(g)'] / df['loc']", "# iv_per_loc\n# Design complexity per line of code\n# Usefulness: Indicates local complexity relative to size, illuminating regions needing better design.\ndf['iv_per_loc'] = df['iv(g)'] / df['loc']", "# logv_per_loc\n# Halstead volume per line of code\n# Usefulness: Highlights information density, critical in identifying overly complex or compact code.\ndf['logv_per_loc'] = df['log_v'] / df['loc']", "# maint_readability_per_loc\n# Maintainability per line of code\n# Usefulness: Normalizes readability to code size, pinpointing maintainable areas versus problematic density.\ndf['maint_readability_per_loc'] = df['maint_readability'] / df['loc']", "# iv_per_readability\n# Design complexity per maintainability\n# Usefulness: Indicates tradeoffs between logical design and code readability, relevant for balancing defect likelihood.\ndf['iv_per_readability'] = df['iv(g)'] / (df['maint_readability'] + 1e-6)", "# reciprocal_uniq_op_and_opnd_ratio\n# Reciprocal of unique operator to operand ratio\n# Usefulness: Emphasizes imbalance cases between operators and operands, useful for logical defect prediction.\ndf['reciprocal_uniq_op_and_opnd_ratio'] = 1 / (df['uniq_op_and_opnd_ratio'] + 1e-6)", "# n_per_branch_density\n# Halstead operators/operands density relative to branching\n# Usefulness: Indicates computational workload per branching unit, highlighting dense areas prone to errors.\ndf['n_per_branch_density'] = df['n'] / df['loc_per_branch']", "# branch_density_per_expressiveness\n# Interaction between logical density and expressiveness\n# Usefulness: Couples branch density with logical expressiveness, identifying parts with complex logic branches prone to defects.\ndf['branch_density_per_expressiveness'] = df['loc_per_branch'] * df['uniq_op_and_opnd_ratio']", "# rolling_mean_loc\n# Rolling mean of line count\n# Usefulness: Clarifies local trends in code size, aiding in detecting regions of abrupt complexity increases leading to defects.\ndf['rolling_mean_loc'] = df['loc'].rolling(window=3, min_periods=1).mean()", "# cumulative_ev\n# Cumulative sum of McCabe essential complexity\n# Usefulness: Provides historical build-up of essential complexity, reflecting rising defect risk with accumulating complexity.\ndf['cumulative_ev'] = df['ev(g)'].cumsum()", "# ratio_ev_to_logv\n# Ratio of essential complexity to Halstead volume\n# Usefulness: Gauges logical expressiveness by the relationship of complexity to volume, identifying areas with imbalanced logic.\ndf['ratio_ev_to_logv'] = df['ev(g)'] / (df['log_v'] + 1e-6)", "df.drop(columns=['blank_per_loc', 'zscore_n', 'max', 'min'], inplace=True)"]
