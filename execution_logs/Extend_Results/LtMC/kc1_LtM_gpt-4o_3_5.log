2026-05-26 01:20:57,954 - INFO - ops_string = ["# log_loc\n# Log transformation of lines of code (loc) to reduce skewness and stabilize variance.\n# Usefulness: Highlights relative code size with reduced scale distortions, aligning with the defect prediction task.\ndf['log_loc'] = np.log1p(df['loc'])", "# log_n\n# Log transformation of total operators and operands (n) to handle skewness and stabilize variance.\n# Usefulness: Captures relative complexity in operations, emphasizing dense and operationally complex modules prone to defects.\ndf['log_n'] = np.log1p(df['n'])", "# defect_density\n# Ratio of Halstead's line count (lOCode) to McCabe's lines of code (loc).\n# Usefulness: Indicates concentrated defect-prone areas by representing code density per line.\ndf['defect_density'] = df['lOCode'] / (df['loc'] + 1e-6)", "# complexity_ratio\n# Ratio of design complexity (iv(g)) to McCabe's lines of code (loc).\n# Usefulness: Highlights modules with disproportionately high complexity relative to code size, which may be more defect-prone.\ndf['complexity_ratio'] = df['iv(g)'] / (df['loc'] + 1e-6)", "# comments_ratio\n# Ratio of maintainability/readability (maint_readability) to McCabe's lines of code (loc).\n# Usefulness: Emphasizes maintainability characteristics relative to code size, which may influence defect rates.\ndf['comments_ratio'] = df['maint_readability'] / (df['loc'] + 1e-6)", "# interactions_complexity\n# Interaction term by multiplying essential complexity (ev(g)) and design complexity (iv(g)).\n# Usefulness: Highlights the joint structural complexity, capturing deeper defect-related complexity tendencies.\ndf['interactions_complexity'] = df['ev(g)'] * df['iv(g)']", "# combined_density_complexity\n# Combined measure of size and complexity by multiplying log volume (log_v) with log-transformed lines of code (log_loc).\n# Usefulness: Captures defect-prone areas where high volume and dense code overlap, a critical insight for defect hotspots.\ndf['combined_density_complexity'] = df['log_v'] * df['log_loc']", "# reciprocal_operator_ratio\n# Reciprocal transformation of unique operator-operand ratio (uniq_op_and_opnd_ratio).\n# Usefulness: Captures inverse relationships in code operational complexity, emphasizing high unique combinations associated with defects.\ndf['reciprocal_operator_ratio'] = 1.0 / (df['uniq_op_and_opnd_ratio'] + 1e-6)", "# normalized_uniq_op_and_opnd_ratio\n# Z-score normalization of uniq_op_and_opnd_ratio to standardize feature scale.\n# Usefulness: Ensures compatibility across features with different scales, making it more interpretable for downstream tasks.\ndf['normalized_uniq_op_and_opnd_ratio'] = (df['uniq_op_and_opnd_ratio'] - df['uniq_op_and_opnd_ratio'].mean()) / (df['uniq_op_and_opnd_ratio'].std() + 1e-6)", "# rolling_mean_log_v\n# Rolling mean of log volume (log_v) with a window size of 3 modules.\n# Usefulness: Captures local trends in information density, indicating potential cyclicity in defect-prone modules.\ndf['rolling_mean_log_v'] = df['log_v'].rolling(window=3, min_periods=1).mean()", "# lag_log_loc\n# Lag feature of log-transformed lines of code (log_loc) by one module.\n# Usefulness: Captures temporal relationships or progression in code size between adjacent modules, aiding in trend analysis.\ndf['lag_log_loc'] = df['log_loc'].shift(1)", "# cumsum_n\n# Cumulative sum of total operators and operands (n) across modules.\n# Usefulness: Tracks cumulative complexity, identifying gradual build-up of defect-prone characteristics over time.\ndf['cumsum_n'] = df['n'].cumsum()", "# dropping lOCode\n# lOCode is dropped because its information is encompassed by related features such as defect_density and log transformations.\ndf.drop(columns=['lOCode'], inplace=True)", "# dropping lOBlank\n# lOBlank is dropped as its signal is weak and covered by maint_readability and derived ratios (e.g., comments_ratio).\ndf.drop(columns=['lOBlank'], inplace=True)"]
