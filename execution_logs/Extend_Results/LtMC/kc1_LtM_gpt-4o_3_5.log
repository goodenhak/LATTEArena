# ev_iv_ratio
# Ratio of essential complexity to design complexity (ev(g) / iv(g))
# Usefulness: Helpful to understand the relative contribution of essential complexity compared to design complexity in defect-prone modules.
df['ev_iv_ratio'] = df['ev(g)'] / df['iv(g)']
end

python
# density_complexity_interaction
# Interaction between branch density and essential complexity (loc_per_branch * ev(g))
# Usefulness: Highlights the combined effect of branching density and essential complexity, which can indicate modules with higher potential defects.
df['density_complexity_interaction'] = df['loc_per_branch'] * df['ev(g)']
end

python
# log_maint_readability
# Log transformation of maintainability readability (log(maint_readability + 1))
# Usefulness: Mitigates skewness and emphasizes relative differences in maintainability.
df['log_maint_readability'] = np.log1p(df['maint_readability'])
end

python
# defect_density_metric
# Product of Halstead operators density and maintainability per line (n_per_branch_density * maint_readability_per_loc)
# Usefulness: Directly correlates logical operations with code maintainability, helpful to isolate defect indicators.
df['defect_density_metric'] = df['n_per_branch_density'] * df['maint_readability_per_loc']
end

python
# combined_complexity_readability_ratio
# Ratio of essential complexity to maintain readability (ev(g) / maint_readability)
# Usefulness: Balances how much complexity exists relative to how readable/maintainable the code is, a vital insight for defect analysis.
df['combined_complexity_readability_ratio'] = df['ev(g)'] / (df['maint_readability'] + 1)
end

python
# normalized_ev
# Z-score normalization of McCabe essential complexity (zscore(ev(g)))
# Usefulness: Standardized z-scores enable comparability of essential complexity across modules.
df['normalized_ev'] = (df['ev(g)'] - df['ev(g)'].mean()) / df['ev(g)'].std()
end

python
# halstead_branch_interaction
# Product of uniq_op_and_opnd_ratio and loc_per_branch (uniq_op_and_opnd_ratio * loc_per_branch)
# Usefulness: Captures logical branching with unique operator-operand patterns, valuable for defect localization.
df['halstead_branch_interaction'] = df['uniq_op_and_opnd_ratio'] * df['loc_per_branch']
end

python
# relative_cumulative_ev
