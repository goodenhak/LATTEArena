# ev_iv_interaction
# Interaction between essential complexity (ev(g)) and design complexity (iv(g)) to capture the combined impact of logical and architectural complexity.
# Usefulness: Helps measure the joint contribution of two critical McCabe metrics to defect propensity.
df['ev_iv_interaction'] = df['ev(g)'] * df['iv(g)']
end

python
# logv_n_interaction
# Interaction between log-transformed Halstead volume (log_v) and total operators + operands (n) to highlight patterns in larger modules.
# Usefulness: Captures relationships between information density and code size, which may indicate defect-prone modules.
df['logv_n_interaction'] = df['log_v'] * df['n']
end

python
# loc_branch_readability_interaction
# Interaction between average lines of code per branch (loc_per_branch) and maintainability readability (maint_readability).
# Usefulness: Links logical fragmentation with maintainability challenges, offering context on readability in complex modules.
df['loc_branch_readability_interaction'] = df['loc_per_branch'] * df['maint_readability']
end

python
# loc_to_readability_ratio
# Ratio of Halstead line count (lOCode) to maintainability readability (maint_readability) as a metric of code documentation and clarity.
# Usefulness: Indicates whether code size aligns with readability or if the code is under-documented relative to its complexity.
df['loc_to_readability_ratio'] = df['lOCode'] / (df['maint_readability'] + 1e-5)  # Prevent division by zero with a small offset.
end

python
# log_uniq_op_and_opnd_ratio
# Log transformation of the unique operator-to-operand ratio (uniq_op_and_opnd_ratio) to manage skewness and stabilize variance.
# Usefulness: Normalizes a highly skewed feature, improving its utility in identifying rational or extreme operator usage.
df['log_uniq_op_and_opnd_ratio'] = np.log(df['uniq_op_and_opnd_ratio'] + 1)
end

python
# normalized_ev
# Z-score normalization of essential complexity (ev(g)).
# Usefulness: Centers and scales the feature, improving interpretability and comparability across modules.
df['normalized_ev'] = (df['ev(g)'] - df['ev(g)'].mean()) / df['ev(g)'].std()
end

python
# ev_iv_difference
# Absolute difference between essential complexity (ev(g)) and design complexity (iv(g)).
# Usefulness: Quantifies the mismatch between logical and architectural complexity, which could signify potential design issues.
df['ev_iv_difference'] = abs(df['ev(g)'] - df['iv(g)'])
end

python
# density_per_loc
# Information density (log_v) divided by lines of code (loc), representing compactness or density across code lines.
# Usefulness: Helps identify compact, information-dense modules that might require closer inspection for defects.
df['density_per_loc'] = df['log_v'] / (df['loc'] + 1e-5)  # Prevent division by zero with a small offset.
end

python
# rolling_avg_logv
# Rolling mean of log-transformed Halstead volume (log_v) over a window of 3 modules.
# Usefulness: Detects local trends in information density over adjacent modules, capturing potential clusters of dense or sparse behavior.
df['rolling_avg_logv'] = df['log_v'].rolling(window=3, min_periods=1).mean()
end

python
# n_per_blank
# Ratio of total operators + operands (n) to number of blank lines (lOBlank).
# Usefulness: Highlights compactness or verbosity by normalizing code size by blank lines.
df['n_per_blank'] = df['n'] / (df['lOBlank'] + 1e-5)  # Prevent division by zero with a small offset.
end

python
df.drop(columns=['uniq_op_and_opnd_ratio'], inplace=True)
end
