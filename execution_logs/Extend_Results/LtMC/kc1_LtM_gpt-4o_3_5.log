2026-05-26 01:20:29,808 - INFO - ops_string = ["# log_lOCode\n# Log transformation of Halstead's line count (lOCode) to reduce skewness and highlight relative differences.\n# Usefulness: Handles skewed distribution and emphasizes impactful variations in line counts.\ndf['log_lOCode'] = df['lOCode'].apply(lambda x: np.log1p(x))", "# ev_by_iv_ratio\n# Ratio of essential complexity (ev(g)) to design complexity (iv(g)).\n# Usefulness: Provides a normalized measure of how the essential structure compares to design complexity, which may directly correlate with defect-prone areas.\ndf['ev_by_iv_ratio'] = df['ev(g)'] / (df['iv(g)'] + 1e-5)", "# loc_per_op_density\n# Derived as lines of code (loc) divided by the total operators and operands (n).\n# Usefulness: Highlights coding effort in terms of LOC relative to computational busyness, potentially identifying efficiency or complexity issues.\ndf['loc_per_op_density'] = df['loc'] / (df['n'] + 1e-5)", "# normalized_readability\n# Normalized ratio of maintenance readability adjusted for total LOC and blank lines.\n# Usefulness: Adjusted measure of maintainability that accounts for module size and blank lines, which impact readability and defect incidence.\ndf['normalized_readability'] = df['maint_readability'] / (df['loc'] + df['lOBlank'] + 1e-5)", "# operator_density_ratio\n# Ratio of unique operators and operands (uniq_op_and_opnd_ratio) to the log of Halstead volume (log_v).\n# Usefulness: Balances operand/operator variability with information density, indicating complex hotspots in code.\ndf['operator_density_ratio'] = df['uniq_op_and_opnd_ratio'] / (df['log_v'] + 1e-5)", "# adjusted_branch_loc\n# Derived by subtracting average LOC per branch (loc_per_branch) from total LOC (loc).\n# Usefulness: Shows deviation of total lines from average branch lines, flagging modules with unusual branch density.\ndf['adjusted_branch_loc'] = df['loc'] - df['loc_per_branch']", "# readability_effort_gap\n# Difference between total LOC and maintenance readability (loc - maint_readability).\n# Usefulness: Captures the mismatch between module size and readability effort, a potential defect indicator.\ndf['readability_effort_gap'] = df['loc'] - df['maint_readability']", "# scaled_complexity\n# Z-score normalization of essential complexity (ev(g)).\n# Usefulness: Converts essential complexity to a standardized scale, making it more comparable to other features for global patterns.\ndf['scaled_complexity'] = (df['ev(g)'] - df['ev(g)'].mean()) / df['ev(g)'].std()", "# branch_complexity_proxy\n# Estimated branch count derived by dividing total LOC by LOC per branch (loc / loc_per_branch).\n# Usefulness: Provides an approximate branch count, useful for understanding control structure complexity.\ndf['branch_complexity_proxy'] = df['loc'] / (df['loc_per_branch'] + 1e-5)", "df.drop(columns=['uniq_op_and_opnd_ratio'], inplace=True)"]
