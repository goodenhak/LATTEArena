# ev_per_loc
# McCabe essential complexity per line of code (ev(g) / loc)
# Usefulness: Highlights relative complexity to code size, identifying overly complex modules for defects.

df['ev_per_loc'] = df['ev(g)'] / df['loc']
end

python
# iv_per_loc
# McCabe design complexity per line of code (iv(g) / loc)
# Usefulness: Represents design complexity per unit size, aiding in detecting design issues correlated with defects.

df['iv_per_loc'] = df['iv(g)'] / df['loc']
end

python
# logv_per_loc
# Halstead volume per line of code (log_v / loc)
# Usefulness: Captures information density, indicating how much information is packed in the code, potentially linked to errors.

df['logv_per_loc'] = df['log_v'] / df['loc']
end

python
# maint_readability_per_loc
# Maintainability readability per line of code (maint_readability / loc)
# Usefulness: Measures the readability and maintainability normalized by code size, helping detect modules prone to issues.

df['maint_readability_per_loc'] = df['maint_readability'] / df['loc']
end

python
# blank_per_loc
# Blank lines per line of code (lOBlank / loc)
# Usefulness: Indicates documentation density, which can influence readability and defect propensity.

df['blank_per_loc'] = df['lOBlank'] / df['loc']
end

python
# iv_per_readability
# Design complexity per maintainability (iv(g) / maint_readability)
# Usefulness: Reflects the balance between design complexity and maintainability, aiding in isolating defect-prone modules.

df['iv_per_readability'] = df['iv(g)'] / (df['maint_readability'] + 1e-5)
end

python
# n_per_branch_density
# Halstead operators/operands density relative to branching (n / loc_per_branch)
# Usefulness: Captures code density relative to its logical branching, exposing modules with concentrated complexity.

df['n_per_branch_density'] = df['n'] / (df['loc_per_branch'] + 1e-5)
end

python
# branch_density_per_expressiveness
# Interaction between logical density and expressiveness (loc_per_branch * uniq_op_and_opnd_ratio)
# Usefulness: Highlights interplay between code density and the expressiveness of operators/operands in evaluating defects.

df['branch_density_per_expressiveness'] = df['loc_per_branch'] * df['uniq_op_and_opnd_ratio']
end

python
# log_ev
# Log transformation of McCabe essential complexity (log(ev(g)))
# Usefulness: Handles skewness and emphasizes proportional differences, especially for smaller complex modules.

df['log_ev'] = np.log(df['ev(g)'] + 1)
end

python
# log_iv
# Log transformation of McCabe design complexity (log(iv(g)))
# Usefulness: Provides better scaling for this interaction-heavy feature and enhances defect detection analysis.

df['log_iv'] = np.log(df['iv(g)'] + 1)
end

python
# zscore_n
# Z-score normalization of Halstead operators/operands (n)
# Usefulness: Standardizes this highly variable feature for better comparison across modules.

df['zscore_n'] = (df['n'] - df['n'].mean()) / df['n'].std()
end

python
# reciprocal_uniq_op_and_opnd_ratio
# Reciprocal transformation of unique operator to operand ratio (1 / uniq_op_and_opnd_ratio)
# Usefulness: Caps extreme ratios, improving the utility of this skewed feature in identifying errors.

df['reciprocal_uniq_op_and_opnd_ratio'] = 1 / (df['uniq_op_and_opnd_ratio'] + 1e-5)
end

python
# square_loc
# Squared line count (loc^2)
# Usefulness: Emphasizes non-linear size relationships in modules where size significantly impacts defect rate.

df['square_loc'] = df['loc']  2
end

python
# rolling_mean_loc
# Rolling mean of line count (rolling_mean(loc))
# Usefulness: Smoothens localized variations in feature values, improving stability in defect detection.

df['rolling_mean_loc'] = df['loc'].rolling(window=3, min_periods=1).mean()
end

python
# cumulative_ev
# Cumulative sum of McCabe essential complexity (cumsum(ev(g)))
# Usefulness: Reflects aggregate complexity over time, aiding in analyzing time-dependent defect trends.

df['cumulative_ev'] = df['ev(g)'].cumsum()
end

python
# ratio_ev_to_logv
# Ratio of essential complexity to Halstead volume (ev(g) / log_v)
# Usefulness: Links structural complexity to information density, exposing patterns tied to defect risks.

df['ratio_ev_to_logv'] = df['ev(g)'] / (df['log_v'] + 1e-5)
end

python
# mean_n_by_defect
# Mean value of Halstead operators/operands grouped by defect presence (groupbythenmean(n))
# Usefulness: Aggregates operator/operand patterns for modules with/without defects, highlighting divergent behavior.

df['mean_n_by_defect'] = df.groupby('Answer')['n'].transform('mean')
end

python
# drop lOCode
# Drop Halstead line count as loc already captures similar size information.
df.drop(columns=['lOCode'], inplace=True)
end

python
# drop lOBlank
# Drop Halstead blank lines as maint_readability incorporates this aspect comprehensively.
df.drop(columns=['lOBlank'], inplace=True)
end
