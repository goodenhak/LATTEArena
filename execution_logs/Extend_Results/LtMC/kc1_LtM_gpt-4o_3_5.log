df['uniq_op_and_opnd_ratio']", "# log_lOCode\n# Log transformation of Halstead's line count (lOCode).\n# Usefulness: Reduces skewness in lOCode while preserving proportional differences, aiding better modeling of codebase size effects.\ndf['log_lOCode'] = np.log1p(df['lOCode'])", "# log_maint_readability\n# Log transformation of code readability (maint_readability).\n# Usefulness: Balances the heavily skewed distribution of readability while bringing attention to smaller differences in maintainable modules.\ndf['log_maint_readability'] = np.log1p(df['maint_readability'])", "# zscore_ev\n# Z-score normalization of essential complexity (ev(g)).\n# Usefulness: Standardizes ev(g) to have zero mean and unit variance, aligning scales across features for better model convergence.\ndf['zscore_ev'] = (df['ev(g)'] - df['ev(g)'].mean()) / df['ev(g)'].std()", "# reciprocal_n\n# Reciprocal transformation of total operators + operands (n).\n# Usefulness: Gives weight to smaller n values, where fewer operators/operands might suggest less complexity or clarity issues.\ndf['reciprocal_n'] = 1 / (df['n'] + 1)", "df.drop(columns=['lOCode', 'uniq_op_and_opnd_ratio'], inplace=True)"]
