# log_v: Log transformation of Halstead 'volume' to handle skewness and highlight relative information density.
# Usefulness: Reduces the impact of outliers in the distribution of 'v' while maintaining its comparative information.
df['log_v'] = np.log1p(df['v'])
end

python
# log_e: Log transformation of Halstead 'effort'.
# Usefulness: Effort has a highly skewed distribution, so applying log helps represent its distribution more appropriately.
df['log_e'] = np.log1p(df['e'])
end

python
# loc_per_branch: loc divided by branchCount for average lines of code per branch.
# Usefulness: Reflects the density of code per branching point, which can indicate complexity and likelihood of defects.
df['loc_per_branch'] = df['loc'] / df['branchCount']
end

python
# complexity_density: Cyclomatic complexity (v(g)) divided by lines of code (loc).
# Usefulness: Provides a normalized measure of logic complexity relative to the length of code, which is linked to defects.
df['complexity_density'] = df['v(g)'] / df['loc']
end

python
# maint_readability: Combination of comments, blank lines, and code lines.
# Usefulness: Higher values indicate better-defined boundaries and comments, improving maintainability and reducing defects.
df['maint_readability'] = df['lOComment'] + df['lOBlank'] + df['lOCode']
end

python
# eff_density: Effort per unit volume (e/v).
# Usefulness: Represents the effort relative to the amount of information in the code, highlighting cognitive overload risks.
df['eff_density'] = df['e'] / df['v']
end

python
# branch_complexity: branchCount multiplied by design complexity (iv(g)).
# Usefulness: Captures compounding effects of branching with potential complexities in the module's design.
df['branch_complexity'] = df['branchCount'] * df['iv(g)']
end

python
# uniq_op_and_opnd_ratio: Ratio of unique operators to unique operands.
# Usefulness: Indicates balance between operators and operands, possibly reflecting code coherence and maintainability.
df['uniq_op_and_opnd_ratio'] = df['uniq_Op'] / (df['uniq_Opnd'] + 1e-6)
end

python
# cognitive_load: total_Op multiplied by total_Opnd (product of total operators and operands).
# Usefulness: Captures overall code size and complexity, which could influence defect likelihood.
df['cognitive_load'] = df['total_Op'] * df['total_Opnd']
end

python
# halstead_b_to_volume_ratio: Ratio of Halstead's 'b' to 'volume'.
# Usefulness: Reflects error proneness per unit of information volume in the code.
df['halstead_b_to_volume_ratio'] = df['b'] / (df['v'] + 1e-6)
end

python
# standardized_loc: Z-score normalization of loc.
# Usefulness: Normalizes line of code counts to make it comparable across different scales of other features.
df['standardized_loc'] = (df['loc'] - df['loc'].mean()) / df['loc'].std()
end

python
df.drop(columns=['locCodeAndComment'], inplace=True)
end
