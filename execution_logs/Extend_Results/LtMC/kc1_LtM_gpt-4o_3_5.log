# evg_ivg_ratio
# Ratio of essential complexity (ev(g)) to design complexity (iv(g)).
# Usefulness: This feature highlights the relative contribution of essential complexity to overall design, which may indicate areas of code heavily weighted towards complexity.
df['evg_ivg_ratio'] = df['ev(g)'] / (df['iv(g)'] + 1)
end

python
# loc_per_n
# Ratio of lines of code (loc) to total operators + operands (n).
# Usefulness: Indicates code density relative to operations, potentially identifying complicated or redundant code that may correlate with defects.
df['loc_per_n'] = df['loc'] / (df['n'] + 1)
end

python
# adjusted_density
# The sum of lines of code (loc) and readability (maint_readability) divided by n + 1.
# Usefulness: Balances size and readability against operations, offering a perspective on the overall maintainability and operational burden.
df['adjusted_density'] = (df['loc'] + df['maint_readability']) / (df['n'] + 1)
end

python
# design_minus_essential
# Difference between design complexity (iv(g)) and essential complexity (ev(g)).
# Usefulness: Highlights zones where design complexity deviates strongly from essential complexity, potentially signaling modularization issues or over-complicated designs.
df['design_minus_essential'] = df['iv(g)'] - df['ev(g)']
end

python
# complexity_volume_interaction
# Interaction between essential complexity (ev(g)) and log-transformed volume (log_v).
# Usefulness: Shows how complexity scales with information density, which could predict difficult-to-maintain problematic modules.
df['complexity_volume_interaction'] = df['ev(g)'] * df['log_v']
end

python
# branch_uniqueness
# Interaction between average lines of code per branch (loc_per_branch) and unique operator/operand ratio (uniq_op_and_opnd_ratio).
# Usefulness: Captures the relationship between structural branching and operator/operand uniqueness, indicating regions of lopsidedness or inefficiency.
df['branch_uniqueness'] = df['loc_per_branch'] * df['uniq_op_and_opnd_ratio']
end

python
# log_lOCode
# Log transformation of Halstead's line count (lOCode).
# Usefulness: Reduces skewness in lOCode while preserving proportional differences, aiding better modeling of codebase size effects.
df['log_lOCode'] = np.log1p(df['lOCode'])
end

python
# log_maint_readability
# Log transformation of code readability (maint_readability).
# Usefulness: Balances the heavily skewed distribution of readability while bringing attention to smaller differences in maintainable modules.
df['log_maint_readability'] = np.log1p(df['maint_readability'])
end

python
# zscore_ev
# Z-score normalization of essential complexity (ev(g)).
# Usefulness: Standardizes ev(g) to have zero mean and unit variance, aligning scales across features for better model convergence.
df['zscore_ev'] = (df['ev(g)'] - df['ev(g)'].mean()) / df['ev(g)'].std()
end

python
# reciprocal_n
# Reciprocal transformation of total operators + operands (n).
# Usefulness: Gives weight to smaller n values, where fewer operators/operands might suggest less complexity or clarity issues.
df['reciprocal_n'] = 1 / (df['n'] + 1)
end

python
df.drop(columns=['lOCode', 'uniq_op_and_opnd_ratio'], inplace=True)
end
