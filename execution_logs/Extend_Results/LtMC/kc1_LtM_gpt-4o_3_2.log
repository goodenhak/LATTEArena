# defect_proneness_score
# Composite score calculated as (normalized_cyclomatic_complexity + branch_density + log_effort + uniq_op_ratio + uniq_opnd_ratio). Higher score may indicate greater defect proneness.
# Usefulness: This captures a combination of complexity, branching density, effort, and modularity factors, providing a holistic indicator of defect likelihood.
df['defect_proneness_score'] = (
    df['normalized_cyclomatic_complexity'] + 
    df['branch_density'] + 
    df['log_effort'] + 
    df['uniq_op_ratio'] + 
    df['uniq_opnd_ratio']
)
end

python
# log_vd_interaction
# Logarithm of the interaction between Halstead volume and difficulty (log(v_d_interaction + 1)).
# Usefulness: Log transformation of v_d_interaction reduces skewness and better captures non-linear relationships with defect proneness.
df['log_vd_interaction'] = np.log(df['v_d_interaction'] + 1)
end

python
# branching_normalized_effort
# Normalized effort calculated by dividing branching_difficulty_interaction by Halstead effort (branching_difficulty_interaction / (e + 1)).
# Usefulness: Provides insight into how branching and difficulty contribute to effort compared to overall effort, highlighting modules with disproportionate complexity.
df['branching_normalized_effort'] = df['branching_difficulty_interaction'] / (df['e'] + 1)
end

python
# modularity_ratio_difference
# Difference between unique operator ratio and unique operand ratio (uniq_op_ratio - uniq_opnd_ratio).
# Usefulness: Highlights imbalances in the modularity of operators versus operands, which might reflect design quirks or complexity related to maintainability.
df['modularity_ratio_difference'] = df['uniq_op_ratio'] - df['uniq_opnd_ratio']
end

python
# sqrt_branching_density
# Square root of branch density (sqrt(branch_density)).
# Usefulness: Applies a non-linear transformation to branching density to reflect its incremental rather than linear impact on defect proneness.
df['sqrt_branching_density'] = np.sqrt(df['branch_density'])
end

python
# relative_complexity_ratio
# Ratio of essential complexity to cyclomatic complexity (ev(g) / (v(g) + 1)).
# Usefulness: Provides a measure of how much of the complexity is essential versus incidental, with higher values potentially indicating simpler designs.
df['relative_complexity_ratio'] = df['ev(g)'] / (df['v(g)'] + 1)
end

python
# normalized_loc_effort
# Normalized effort per line of code ((log_effort + 1) / (loc + 1)).
# Usefulness: Tracks the distribution of effort per unit code size, identifying heavily effort-concentrated modules.
df['normalized_loc_effort'] = (df['log_effort'] + 1) / (df['loc'] + 1)
end

python
# high_risk_indicator
# Binary feature indicating high-risk modules (1 if defect_proneness_score > threshold, else 0).
# Usefulness: Flags modules with a composite score exceeding a pre-determined risk threshold for focused defect management.
threshold = 3.0  # Example threshold, can be adapted based on domain insights.
df['high_risk_indicator'] = (df['defect_proneness_score'] > threshold).astype(int)
end

python
# cumulative_effort
# Cumulative effort within the dataset (cumsum of e).
# Usefulness: Tracks the cumulative computational effort across analyzed modules, assisting in resource allocation and prioritization.
df['cumulative_effort'] = df['e'].cumsum()
end

python
# rolling_mean_effort
# Rolling mean effort over a window of size 5 (rolling_mean(e)).
# Usefulness: Temporally smooths effort to capture localized trends in computational requirements, aiding in time-series analysis.
df['rolling_mean_effort'] = df['e'].rolling(window=5, min_periods=1).mean()
end

python
df.drop(columns=['b'], inplace=True)
end
