end

python
# branch_density_d_interaction
# Interaction between branch density and Halstead difficulty (branch_density × d).
# Usefulness: Represents the interaction of control flow complexity and difficulty, highlighting modules that may be more prone to defects due to intertwined complexities.
df['branch_density_d_interaction'] = df['branch_density'] * df['d']
end

python
# v_per_loc_to_branch_density_ratio
# Ratio of Halstead volume per line of code to branch density (v_per_loc / branch_density).
# Usefulness: Balances cognitive complexity against control flow complexity to identify areas with high cognitive load in dense branching contexts.
df['v_per_loc_to_branch_density_ratio'] = df['v_per_loc'] / df['branch_density']
end

python
# log_v_per_loc
# Logarithmic transformation of Halstead volume per line of code (log(v_per_loc)).
# Usefulness: Reduces skewness in v_per_loc distribution, making it easier to model relationships with defect-proneness.
df['log_v_per_loc'] = np.log1p(df['v_per_loc'])
end

python
# sqrt_branch_density
# Square root of branch density (sqrt(branch_density)).
# Usefulness: Normalizes the distribution of branch density and reduces the impact of extreme values.
df['sqrt_branch_density'] = np.sqrt(df['branch_density'])
end

python
# uniq_op_minus_d
# Difference between unique operators and Halstead difficulty (uniq_Op - d).
# Usefulness: Highlights modularity imbalances where more unique operators occur alongside low/high difficulty levels.
df['uniq_op_minus_d'] = df['uniq_Op'] - df['d']
end

python
# uniq_op_per_total_op
# Ratio of unique operators to total operators (uniq_Op / total_Op).
# Usefulness: Reflects operator uniqueness relative to overall operator usage, which can help assess code modularity.
df['uniq_op_per_total_op'] = df['uniq_Op'] / df['total_Op']
end

python
# risk_weighted_size
# Interaction between module size and high-risk indicator (n × high_risk_indicator).
# Usefulness: Emphasizes large, high-risk modules, which are critical to prioritize in defect-proneness prediction.
df['risk_weighted_size'] = df['n'] * df['high_risk_indicator']
end

python
# cumulative_branch_difficulty
# Cumulative sum of branching difficulty interaction across modules (cumsum(branching_difficulty_interaction)).
# Usefulness: Captures how branching difficulty accumulates in the system over modules, providing a summary trend for defect risk areas.
df['cumulative_branch_difficulty'] = df['branching_difficulty_interaction'].cumsum()
end

python
# rolling_mean_loc_code_structure
# Rolling mean of loc_code_structure with a window size of 3 (rolling_mean(loc_code_structure)).
# Usefulness: Smooths short-term fluctuations in code structure size over adjacent modules, highlighting local trends in defect-relevant metrics.
df['rolling_mean_loc_code_structure'] = df['loc_code_structure'].rolling(window=3).mean()
end

python
