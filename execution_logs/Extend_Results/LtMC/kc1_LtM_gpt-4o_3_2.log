# log_effort
# Natural logarithm of effort (e + 1).
# Usefulness: Reduces the skewness of effort distribution and highlights multiplicative relationships relevant to defect-proneness.
df['log_effort'] = np.log(df['e'] + 1)
end

python
# log_vd_interaction
# Natural logarithm of the interaction between volume (v) and difficulty (d + 1).
# Usefulness: Captures non-linear relationships between Halstead complexity features that indicate defect-proneness.
df['log_vd_interaction'] = np.log(df['v_d_interaction'] + 1)
end

python
# normalized_cyclomatic_complexity
# Cyclomatic complexity normalized by lines of code (v(g)/loc).
# Usefulness: Provides a scale-independent measure of control flow complexity, facilitating cross-module comparisons.
df['normalized_cyclomatic_complexity'] = df['v(g)'] / (df['loc'] + 1)
end

python
# branch_density
# The density of branching logic per line of code (branchCount/loc).
# Usefulness: Highlights hotspots of branching logic, which are prone to errors.
df['branch_density'] = df['branchCount'] / (df['loc'] + 1)
end

python
# v_per_loc
# Halstead volume per line of code (v/loc).
# Usefulness: Measures the cognitive load per line, useful for gauging code complexity in defect-prone modules.
df['v_per_loc'] = df['v'] / (df['loc'] + 1)
end

python
# uniq_op_ratio
# Ratio of unique operators to total operators (uniq_Op/total_Op).
# Usefulness: Highlights the diversity of operators used, which indirectly relates to code modularity.
df['uniq_op_ratio'] = df['uniq_Op'] / (df['total_Op'] + 1)
end

python
# uniq_opnd_ratio
# Ratio of unique operands to total operands (uniq_Opnd/total_Opnd).
# Usefulness: Reflects the modularity and reusability of operands, which can correspond to maintenance efforts.
df['uniq_opnd_ratio'] = df['uniq_Opnd'] / (df['total_Opnd'] + 1)
end

python
# minmax_scaled_difficulty
# Min-max scaling of Halstead difficulty (d).
# Usefulness: Standardizes difficulty for cross-feature comparisons while keeping interpretability intact.
df['minmax_scaled_difficulty'] = (df['d'] - df['d'].min()) / (df['d'].max() - df['d'].min())
end

python
# sqrt_branching_density
# Square root of branch density (sqrt(branch_density)).
# Usefulness: Reduces the influence of outlier modules with extremely high branching densities.
df['sqrt_branching_density'] = np.sqrt(df['branch_density'])
end

python
# defect_proneness_score
# Composite score calculated using normalized complexity, branch density, logarithmic effort, and modularity ratios.
# Usefulness: Aggregates important indicators into a single defect-proneness measure, emphasizing high-risk modules.
df['defect_proneness_score'] = (df['normalized_cyclomatic_complexity'] + df['branch_density'] + 
                                df['log_effort'] + df['uniq_op_ratio'] + df['uniq_opnd_ratio'])
end

python
# high_risk_indicator
# Binary feature indicating high-risk modules based on defect_proneness_score > threshold.
# Usefulness: Directly classifies modules into high-risk categories for actionable insights.
df['high_risk_indicator'] = (df['defect_proneness_score'] > 7).astype(int)
end

python
# branching_normalized_effort
# Normalized effort calculated by dividing branching difficulty interaction by (e + 1).
# Usefulness: Links branching complexity with cognitive effort, emphasizing areas requiring high cognitive loads.
df['branching_normalized_effort'] = df['branching_difficulty_interaction'] / (df['e'] + 1)
end

python
# modularity_ratio_difference
# Difference between unique operator ratio and unique operand ratio (uniq_op_ratio - uniq_opnd_ratio).
# Usefulness: Captures imbalances between operator and operand diversity, offering insights into the modularity.
df['modularity_ratio_difference'] = df['uniq_op_ratio'] - df['uniq_opnd_ratio']
end

python
# normalized_loc_effort
# Normalized effort per line of code ((log_effort + 1) / (loc + 1)).
# Usefulness: Links cognitive effort to module size, identifying outlier modules with disproportionate effort needs.
df['normalized_loc_effort'] = (df['log_effort'] + 1) / (df['loc'] + 1)
end

python
# cumsum_effort
# Running cumulative effort of the dataset (cumulative sum of e).
# Usefulness: Identifies long-term trends in effort accumulation across modules.
df['cumsum_effort'] = df['e'].cumsum()
end

python
# rolling_mean_effort
# Rolling mean of effort over a window size of 5.
# Usefulness: Smooths effort variations over time, identifying gradual changes in effort demands.
df['rolling_mean_effort'] = df['e'].rolling(window=5).mean()
end

python
# Dropping any obsolete or redundant columns
df.drop(columns=['XX'], inplace=True)
end
