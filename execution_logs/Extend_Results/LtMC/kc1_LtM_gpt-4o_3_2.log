2026-05-26 01:04:17,883 - INFO - ops_string = ["# log_v_per_loc_branch_density\n# Interaction between log-transformed Halstead volume per line and branch density to capture joint effects of complexity and branching.\n# Usefulness: Combines two critical aspects of code complexity and branching, emphasizing their compounded influence on defects.\ndf['log_v_per_loc_branch_density'] = df['log_v_per_loc'] * df['branch_density']", "# uniq_op_minus_d_ratio_log_v_per_loc\n# Ratio of unique operators minus difficulty to log-transformed Halstead volume per line, representing balance relative to complexity.\n# Usefulness: Balances operator uniqueness vs difficulty with the logarithmic complexity metric.\ndf['uniq_op_minus_d_ratio_log_v_per_loc'] = df['uniq_op_minus_d'] / (df['log_v_per_loc'] + 1e-6)", "# modularity_vs_branch_density_interaction\n# Difference between modularity ratio (scaled) and branch density to highlight structural modularity issues.\n# Usefulness: Captures misalignments in modularity and branching, which are likely indicative of defects.\ndf['modularity_vs_branch_density_interaction'] = df['modularity_ratio_scaled'] - df['branch_density']", "# rolling_mean_risk_weighted_size\n# Rolling mean of the risk-weighted size over a window of 5 to measure trends in defect-prone size metrics.\n# Usefulness: Captures temporal variations in risk-weighted size, highlighting modules with consistent risk over nearby instances.\ndf['rolling_mean_risk_weighted_size'] = df['risk_weighted_size'].rolling(window=5, min_periods=1).mean()", "# log_risk_weighted_size_normalized\n# Logarithmic transformation of risk-weighted size with z-score normalization to highlight relative deviations.\n# Usefulness: Emphasizes extreme risk-weighted size values that are likely defect-prone while reducing impact of skewness.\ndf['log_risk_weighted_size_normalized'] = (np.log1p(df['risk_weighted_size']) - np.log1p(df['risk_weighted_size']).mean()) / (np.log1p(df['risk_weighted_size']).std() + 1e-6)", "# branch_density_std_per_modularity_bin\n# Standard deviation of branch density grouped by modularity ratio quantiles (binned).\n# Usefulness: Highlights variability in branch density based on modularity, signaling uneven code structure more likely to contain defects.\ndf['modularity_bin'] = pd.qcut(df['modularity_ratio_scaled'], q=5, duplicates='drop', labels=False)\ndf['branch_density_std_per_modularity_bin'] = df.groupby('modularity_bin')['branch_density'].transform('std')", "# diff_v_per_loc_branching_interaction_rolling_mean\n# Difference between v_per_loc_branching_interaction and its rolling mean with a window of 3.\n# Usefulness: Captures sudden deviations in complexity and branching interaction, which may indicate outliers linked to defects.\ndf['rolling_mean_v_per_loc_branching_interaction'] = df['v_per_loc_branching_interaction'].rolling(window=3, min_periods=1).mean()\ndf['diff_v_per_loc_branching_interaction_rolling_mean'] = df['v_per_loc_branching_interaction'] - df['rolling_mean_v_per_loc_branching_interaction']", "# drop_modularity_bin\ndf.drop(columns=['modularity_bin'], inplace=True)"]
