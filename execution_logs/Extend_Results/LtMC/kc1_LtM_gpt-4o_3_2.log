python
# log_vd_interaction
# Logarithm of the interaction between Halstead volume and difficulty (log(v_d_interaction + 1)).
# Usefulness: Captures compounding effects of volume and complexity on defect likelihood while normalizing scale variance.
df['log_vd_interaction'] = np.log(df['v_d_interaction'] + 1)
end

python
# normalized_cyclomatic_complexity
# Cyclomatic complexity normalized by lines of code (v(g)/loc).
# Usefulness: Highlights modules with disproportionately high control flow complexity, often indicative of error-prone modules.
df['normalized_cyclomatic_complexity'] = df['v(g)'] / (df['loc'] + 1)
end

python
# defect_proneness_score
# Composite score combining normalized complexity, effort, and modularity metrics.
# Usefulness: Integrates multiple dimensions of defect likelihood into a single interpretable metric, strongly tied to defect prediction.
df['defect_proneness_score'] = (
    df['normalized_cyclomatic_complexity'] + 
    df['branch_density'] + 
    df['log_effort'] + 
    df['uniq_op_ratio'] +
    df['uniq_opnd_ratio']
)
end

python
# branching_normalized_effort
# Normalized effort calculated by dividing branching-difficulty interaction by Halstead effort (branching_difficulty_interaction / (e + 1)).
# Usefulness: Identifies modules where control flow complexity disproportionately contributes to overall effort, often indicative of faulty logic.
df['branching_normalized_effort'] = df['branching_difficulty_interaction'] / (df['e'] + 1)
end

python
# sqrt_branching_density
# Square root of branch density (sqrt(branch_density)).
# Usefulness: Highlights the concentration of branching statements per line, indicative of error-prone logic while smoothing extreme variations.
df['sqrt_branching_density'] = np.sqrt(df['branch_density'])
end

python
# relative_complexity_ratio
# Ratio of essential complexity to cyclomatic complexity (ev(g) / (v(g) + 1)).
# Usefulness: A theoretical measure of how well-structured a module is, with higher ratios pointing to modular and maintainable designs less prone to defects.
df['relative_complexity_ratio'] = df['ev(g)'] / (df['v(g)'] + 1)
end

python
# normalized_loc_effort
# Normalized effort per line of code ((log_effort + 1) / (loc + 1)).
# Usefulness: Tracks how effort is distributed per line of code, capturing modules with unbalanced workload and excessive complexity.
df['normalized_loc_effort'] = (df['log_effort'] + 1) / (df['loc'] + 1)
end

