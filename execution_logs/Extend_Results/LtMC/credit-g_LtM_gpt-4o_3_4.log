# repayment_pressure_score
# Combines debt-to-income ratio and repayment efficiency to reflect overall repayment pressure.
# Usefulness: Captures a holistic measure of financial strain which directly impacts creditworthiness.
df['repayment_pressure_score'] = df['debt_to_income_ratio'] * df['repayment_efficiency']
end

python
# credit_demand_relative_to_group
# Ratio of credit amount to group-based mean credit demand for the same purpose category.
# Usefulness: Identifies if the credit requested is higher or lower relative to group norms, providing context for outlier detection.
df['credit_demand_relative_to_group'] = df['credit_amount'] / df['credit_amount_group_mean']
end

python
# combined_financial_stability
# Aggregate indicator combining ordinal checking status, savings status, and housing ordinal.
# Usefulness: Encapsulates multiple dimensions of financial stability into a single comprehensive metric.
df['combined_financial_stability'] = df['ordinal_checking_status'] + df['ordinal_savings_status'] + df['housing_ordinal']
end

python
# zscore_repayment_efficiency
# Z-score of repayment efficiency relative to its distribution.
# Usefulness: Identifies extreme variations in repayment efficiency, which may indicate undue repayment burden or instability.
df['zscore_repayment_efficiency'] = (df['repayment_efficiency'] - df['repayment_efficiency'].mean()) / df['repayment_efficiency'].std()
end

python
# sigmoid_debt_to_income_ratio
# Applies sigmoid transformation to debt-to-income ratio.
# Usefulness: Smoothens repayment burden into a bounded metric to better handle non-linearity in model training.
df['sigmoid_debt_to_income_ratio'] = 1 / (1 + np.exp(-df['debt_to_income_ratio']))
end

python
# socioeconomic_credit_pattern
# Mean credit amount grouped by age group and personal status.
# Usefulness: Captures socio-demographic patterns in credit trends, introducing context-specific priors.
df['socioeconomic_credit_pattern'] = df.groupby(['age_group_bin', 'personal_status'])['credit_amount'].transform('mean')
end

python
# housing_asset_interaction
# Interaction term between housing status and asset ownership.
# Usefulness: Reflects joint effects of asset ownership and living situation, which are key for risk evaluation.
df['housing_asset_interaction'] = df['housing'].map({'for free': 0, 'rent': 1, 'own': 2}) * df['asset_owner']
end

python
# label_encoded_personal_status
# Converts the categorical personal status into numerical labels.
# Usefulness: Numerically represents socio-demographic differences related to risk and credit trends.
df['label_encoded_personal_status'] = df['personal_status'].map({
    'male single': 0, 'female div/dep/mar': 1, 'male mar/wid': 2, 'male div/sep': 3
})
end

python
# dropping unnecessary columns for redundancy or no added value
df.drop(columns=['checking_status', 'normalized_credit_amount', 'housing'], inplace=True)
end
