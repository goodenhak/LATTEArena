# disposable_income_after_installment
# Ratio of remaining available income after installment payment to emphasize repayment burden.
# Usefulness: Captures the individual's financial flexibility after accounting for installment obligations.
df['disposable_income_after_installment'] = df['credit_amount'] / df['installment_commitment']
end

python
# age_credit_interaction
# Interaction term between normalized_credit_amount and age_group_bin to capture life-stage-based credit demand.
# Usefulness: Reflects how credit demand varies across age groups and financial stages.
df['age_credit_interaction'] = df['normalized_credit_amount'] * df['age_group_bin'].apply(lambda x: {'young': 1, 'mid-age': 2, 'senior': 3}[x])
end

python
# repayment_feasibility
# Ratio of repayment_efficiency to debt_to_income_ratio to assess ease of repayment.
# Usefulness: Balances repayment potential over debt burden, improving credit capability assessment.
df['repayment_feasibility'] = df['repayment_efficiency'] / (df['debt_to_income_ratio'] + 1e-5)
end

python
# financial_stability_index
# Composite metric combining ordinal_checking_status, ordinal_savings_status, and asset_owner.
# Usefulness: Encodes holistic financial stability into a single interpretable feature.
df['financial_stability_index'] = (df['ordinal_checking_status'] + df['ordinal_savings_status'] + df['asset_owner']) / 3
end

python
# purpose_adjusted_credit_score
# Ratio of credit_amount to credit_amount_group_mean to normalize credit needs against purpose context.
# Usefulness: Identifies how the given credit amount deviates from the expected amount for its purpose.
df['purpose_adjusted_credit_score'] = df['credit_amount'] / (df['credit_amount_group_mean'] + 1e-5)
end

python
# housing_asset_interaction
# Product of housing_ordinal and asset_owner to encode stability based on housing and asset ownership.
# Usefulness: Highlights individuals with additional stability from owning both housing and assets.
df['housing_asset_interaction'] = df['housing_ordinal'] * df['asset_owner']
end

python
