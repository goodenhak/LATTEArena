# repayment_burden
# Feature description: Combined repayment pressure by multiplying debt_to_income_ratio and installment_commitment.
# Usefulness: Captures the compounded effect of income-to-debt ratio and installment size on financial strain.
df['repayment_burden'] = df['debt_to_income_ratio'] * df['installment_commitment']
end

python
# normalized_repayment_efficiency
# Feature description: Relative efficiency of repayment as repayment_efficiency divided by credit_amount_group_mean.
# Usefulness: Normalizes repayment efficiency by purpose-specific average loan size to adjust for context.
df['normalized_repayment_efficiency'] = df['repayment_efficiency'] / df['credit_amount_group_mean']
end

python
# installment_to_duration_ratio
# Feature description: Ratio of installment commitment to loan duration.
# Usefulness: Highlights affordability of the monthly repayment within the given loan term.
df['installment_to_duration_ratio'] = df['installment_commitment'] / df['duration']
end

python
# financial_stability_index
# Feature description: Weighted index combining ordinal_checking_status, ordinal_savings_status, and housing_ordinal.
# Usefulness: Encodes overall financial stability of the applicant by combining key indicators.
df['financial_stability_index'] = (df['ordinal_checking_status'] * 0.4 + df['ordinal_savings_status'] * 0.3 + df['housing_ordinal'] * 0.3)
end

python
# credit_to_asset_ratio
# Feature description: Ratio of credit amount to asset ownership, penalizing lack of assets.
# Usefulness: Evaluates credit risk relative to the presence (or absence) of asset-backed financial stability.
df['credit_to_asset_ratio'] = df['credit_amount'] / (df['asset_owner'] + 0.1)
end

python
# adjusted_debt_ratio
# Feature description: Net loan burden as debt_to_income_ratio minus repayment_efficiency.
# Usefulness: Differentiates between applicants with high income but increased loan servicing burden.
df['adjusted_debt_ratio'] = df['debt_to_income_ratio'] - (df['repayment_efficiency'] / 1000)
end

python
# weighted_age_credit
# Feature description: Life-stage adjusted credit demand by multiplying normalized_credit_amount with one-hot encoded age bin value.
# Usefulness: Captures the appropriateness of loan size relative to the applicant's life stage.
df = pd.concat([df, pd.get_dummies(df['age_group_bin'], prefix='age_bin')], axis=1)
df['weighted_age_credit'] = (df['normalized_credit_amount'] * 
                             (df['age_bin_young'] * 1 + df['age_bin_mid-age'] * 2 + df['age_bin_senior'] * 3))
end

python
# dependency_burden
# Feature description: Combined strain of dependents and installment commitment.
# Usefulness: Reflects the additional financial pressure due to dependents' maintenance.
df['dependency_burden'] = df['num_dependents'] * df['installment_commitment']
end

python
# length_of_residence_repayment_factor
# Feature description: Ratio of repayment efficiency to years of residence.
# Usefulness: Accounts for applicant's local stability and repayment performance over time.
df['length_of_residence_repayment_factor'] = df['repayment_efficiency'] / (df['residence_since'] + 0.1)
end

