# credit_amount_to_income_ratio
# The ratio of credit amount to debt-to-income ratio to understand relative financial pressure.
# Usefulness: Captures financial strain in relation to income (higher values could indicate over-leveraging).

df['credit_amount_to_income_ratio'] = df['credit_amount'] / df['debt_to_income_ratio']
end

python
# credit_amount_normalized_by_savings
# The ratio of credit amount to savings status ordinal to assess the relationship between savings stability and credit pressure.
# Usefulness: Reflects how credit pressure is related to savings levels, with lower ordinal savings potentially indicating higher risk when normalized credit exceeds savings.

df['credit_amount_normalized_by_savings'] = df['credit_amount'] / df['ordinal_savings_status']
end

python
# credit_amount_to_duration_ratio
# The ratio of credit amount to loan duration to measure repayment burden on a monthly basis.
# Usefulness: Indicates whether the monthly payment burden is realistic relative to credit amount and loan duration. Higher repayment efficiency suggests more manageable dynamics.

df['credit_amount_to_duration_ratio'] = df['credit_amount'] / df['duration']
end

python
# repayment_efficiency_normalized
# Z-score normalization of repayment efficiency to identify deviations from the average repayment performance.
# Usefulness: Highlights outliers in repayment efficiency, enabling differentiation between typical and exceptional repayment profiles.

df['repayment_efficiency_normalized'] = (df['repayment_efficiency'] - df['repayment_efficiency'].mean()) / df['repayment_efficiency'].std()
end

python
# purpose_credit_mean
# Average credit amount grouped by purpose category using group-level aggregation.
# Usefulness: Provides insights into category-specific priors for expected credit amounts, helping predict risk in alignment with intended purposes.

df['purpose_credit_mean'] = df.groupby('purpose')['credit_amount'].transform('mean')
end

python
# repayment_efficiency_std_by_purpose
# Standard deviation of repayment efficiency grouped by purpose to evaluate repayment uncertainty in specific categories.
# Usefulness: Indicates variability in repayment patterns across purposes, helping quantify risks associated with different loan objectives.

df['repayment_efficiency_std_by_purpose'] = df.groupby('purpose')['repayment_efficiency'].transform('std')
end

python
# debt_to_income_rank_by_age
# Rank of debt-to-income ratio within specific age group bins.
# Usefulness: Captures relative financial position and leverage of individuals within their life stage.

df['debt_to_income_rank_by_age'] = df.groupby('age_group_bin')['debt_to_income_ratio'].rank()
end

python
# Drop unnecessary features
df.drop(columns=['normalized_credit_amount'], inplace=True)
end
