# debt_to_income_ratio
# Ratio of installment commitment to the monthly repayment capacity (credit_amount / duration).
# Usefulness: Highlights repayment burden directly related to disposable income and requested credit amount.
df['debt_to_income_ratio'] = df['installment_commitment'] / (df['credit_amount'] / df['duration'])
end

python
# normalized_credit_amount
# Credit amount normalized by age to capture credit demand relative to life stage.
# Usefulness: Captures whether requested credit aligns with financial capacity at a given age.
df['normalized_credit_amount'] = df['credit_amount'] / df['age']
end

python
# binned_duration
# Categorized duration into short-term, medium-term, and long-term.
# Usefulness: Differentiates credit policies based on loan repayment timelines.
bins = [0, 12, 36, df['duration'].max()]  # Binning as short-term, medium-term, long-term
labels = ['short-term', 'medium-term', 'long-term']
df['binned_duration'] = pd.cut(df['duration'], bins=bins, labels=labels)
end

python
# ordinal_checking_status
# Encoded checking_status ordinally based on financial stability levels.
# Usefulness: Represents financial stability associated with available funds in checking accounts.
checking_status_map = {'<0': 1, '0<=X<200': 2, 'no checking': 3, '>=200': 4}
df['ordinal_checking_status'] = df['checking_status'].map(checking_status_map)
end

python
# ordinal_savings_status
# Encoded savings_status ordinally based on financial stability levels.
# Usefulness: Indicates financial discipline and capacity to save.
savings_status_map = {'<100': 1, 'no known savings': 2, '100<=X<500': 3, '500<=X<1000': 4, '>=1000': 5}
df['ordinal_savings_status'] = df['savings_status'].map(savings_status_map)
end

python
# employment_to_age_ratio
# Ratio of employment category to age.
# Usefulness: Provides a measure of job stability relative to life stage.
employment_map = {'unemployed': 0, '<1': 1, '1<=X<4': 2, '4<=X<7': 3, '>=7': 4}
df['employment_ordinal'] = df['employment'].map(employment_map)
df['employment_to_age_ratio'] = df['employment_ordinal'] / df['age']
end

python
# asset_owner
# Binary indicating whether an individual owns assets (real estate, car, or life insurance).
# Usefulness: Simplifies property analysis into presence or absence of assets.
df['asset_owner'] = df['property_magnitude'].apply(lambda x: 1 if x in ['car', 'real estate', 'life insurance'] else 0)
end

python
# target_encoded_credit_history
# Target-encoded values based on historical credit approval rates by credit_history category.
# Usefulness: Leverages historical trends in credit approval for credit history categories.
df['target_encoded_credit_history'] = df.groupby('credit_history')['credit_approved'].transform('mean')
end

python
# housing_property_interaction
# Interaction between housing status and property ownership (own * asset_owner).
# Usefulness: Captures the combined impact of housing and property ownership on credit eligibility.
housing_map = {'for free': 1, 'rent': 2, 'own': 3}
df['housing_ordinal'] = df['housing'].map(housing_map)
df['housing_property_interaction'] = df['housing_ordinal'] * df['asset_owner']
end

python
# savings_credit_history_interaction
# Interaction between savings status and credit history.
# Usefulness: Reflects financial discipline by linking savings with past credit behavior.
df['savings_credit_history_interaction'] = df['ordinal_savings_status'] * df['target_encoded_credit_history']
end

python
# credit_amount_group_mean
# Mean credit amount grouped by purpose category.
# Usefulness: Captures typical credit amount patterns specific to credit purpose.
df['credit_amount_group_mean'] = df.groupby('purpose')['credit_amount'].transform('mean')
end

python
# age_group_bin
# Binned age into categories: young, mid-age, senior.
# Usefulness: Reflects financial behavior patterns across age demographics.
age_bins = [0, 30, 50, df['age'].max()]
age_labels = ['young', 'mid-age', 'senior']
df['age_group_bin'] = pd.cut(df['age'], bins=age_bins, labels=age_labels)
end

python
# repayment_efficiency
# Ratio of credit amount to duration (credit_amount / duration).
# Usefulness: Highlights repayment potential by measuring the monetary load per month.
df['repayment_efficiency'] = df['credit_amount'] / df['duration']
end

python
# Drop redundant or less-informative columns to reduce noise.
df.drop(columns=['employment', 'property_magnitude', 'credit_history'], inplace=True)
end
