# log_credit_amount
# Log-transformed credit amount to reduce skewness and highlight relative credit scale.
# Usefulness: Captures spending habits and reduces skewed distribution of credit_amount.
df['log_credit_amount'] = np.log1p(df['credit_amount'])
end

python
# repayment_efficiency_by_purpose
# Repayment efficiency normalized by purpose-specific average credit amount.
# Usefulness: Provides contextual comparison of repayment habits based on loan purpose.
df['repayment_efficiency_by_purpose'] = df['repayment_efficiency'] / df['credit_amount_group_mean']
end

python
# overall_financial_health
# Interaction between ordinal_checking_status and ordinal_savings_status to measure financial stability.
# Usefulness: Combines account and savings stability for richer financial health insight.
df['overall_financial_health'] = df['ordinal_checking_status'] * df['ordinal_savings_status']
end

python
# normalized_debt_to_income_ratio
# Debt-to-income ratio normalized by its Z-score for standardization across samples.
# Usefulness: Enhances the comparability of financial capacity to handle repayment obligations.
df['normalized_debt_to_income_ratio'] = (df['debt_to_income_ratio'] - df['debt_to_income_ratio'].mean()) / df['debt_to_income_ratio'].std()
end

python
# age_stage_spend
# Interaction feature: Normalized credit amount multiplied by ordinal age group (binned).
# Usefulness: Reflects credit habits based on life stage and relative credit demand.
df['age_stage_spend'] = df['normalized_credit_amount'] * df['age_group_bin'].factorize()[0]
end

python
# purpose_spending_ratio
# Credit amount divided by group mean, capturing deviations in spending relative to purpose category.
# Usefulness: Highlights spending habits in context with purpose trends.
df['purpose_spending_ratio'] = df['credit_amount'] / df['credit_amount_group_mean']
end

python
# duration_credit_ratio
# Ratio of duration to credit amount (duration/credit_amount).
# Usefulness: Indicates repayment plan intensity and efficiency across different loans.
df['duration_credit_ratio'] = df['duration'] / df['credit_amount']
end

python
# housing_asset_interaction
# Interaction feature combining housing and asset owner status (housing_ordinal * asset_owner).
# Usefulness: Measures stability through asset ownership within housing context.
df['housing_asset_interaction'] = df['housing_ordinal'] * df['asset_owner']
end

python
# dependent_burden
# Ratio of normalized credit amount to the number of dependents (normalized_credit_amount / num_dependents).
# Usefulness: Captures financial strain per dependent, providing nuanced family responsibility insights.
df['dependent_burden'] = df['normalized_credit_amount'] / (df['num_dependents'] + 1e-9)
end

python
# installment_efficiency
# Ratio of repayment_efficiency to installment_commitment.
# Usefulness: Evaluates repayment efficiency per unit of installment commitment.
df['installment_efficiency'] = df['repayment_efficiency'] / (df['installment_commitment'] + 1e-9)
end

python
df.drop(columns=['other_parties', 'purpose', 'checking_status'], inplace=True)
end
