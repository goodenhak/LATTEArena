# Drop categorical columns with minimal variance or redundant information.
# Usefulness: Prevents data leakage and reduces feature dimensionality for better model efficiency.
df.drop(columns=['foreign_worker', 'housing', 'personal_status', 'other_payment_plans', 'other_parties'], inplace=True)
end
