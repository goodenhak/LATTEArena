nal'] = df['employment'].map(employment_map)\ndf['employment_to_age_ratio'] = df['employment_ordinal'] / df['age']", "# asset_owner\n# Binary indicating whether an individual owns assets (real estate, car, or life insurance).\n# Usefulness: Simplifies property analysis into presence or absence of assets.\ndf['asset_owner'] = df['property_magnitude'].apply(lambda x: 1 if x in ['car', 'real estate', 'life insurance'] else 0)", "# target_encoded_credit_history\n# Target-encoded values based on historical credit approval rates by credit_history category.\n# Usefulness: Leverages historical trends in credit approval for credit history categories.\ndf['target_encoded_credit_history'] = df.groupby('credit_history')['credit_approved'].transform('mean')", "# housing_property_interaction\n# Interaction between housing status and property ownership (own * asset_owner).\n# Usefulness: Captures the combined impact of housing and property ownership on credit eligibility.\nhousing_map = {'for free': 1, 'rent': 2, 'own': 3}\ndf['housing_ordinal'] = df['housing'].map(housing_map)\ndf['housing_property_interaction'] = df['housing_ordinal'] * df['asset_owner']", "# savings_credit_history_interaction\n# Interaction between savings status and credit history.\n# Usefulness: Reflects financial discipline by linking savings with past credit behavior.\ndf['savings_credit_history_interaction'] = df['ordinal_savings_status'] * df['target_encoded_credit_history']", "# credit_amount_group_mean\n# Mean credit amount grouped by purpose category.\n# Usefulness: Captures typical credit amount patterns specific to credit purpose.\ndf['credit_amount_group_mean'] = df.groupby('purpose')['credit_amount'].transform('mean')", "# age_group_bin\n# Binned age into categories: young, mid-age, senior.\n# Usefulness: Reflects financial behavior patterns across age demographics.\nage_bins = [0, 30, 50, df['age'].max()]\nage_labels = ['young', 'mid-age', 'senior']\ndf['age_group_bin'] = pd.cut(df['age'], bins=age_bins, labels=age_labels)", "# repayment_efficiency\n# Ratio of credit amount to duration (credit_amount / duration).\n# Usefulness: Highlights repayment potential by measuring the monetary load per month.\ndf['repayment_efficiency'] = df['credit_amount'] / df['duration']", "# Drop redundant or less-informative columns to reduce noise.\ndf.drop(columns=['employment', 'property_magnitude', 'credit_history'], inplace=True)"]
