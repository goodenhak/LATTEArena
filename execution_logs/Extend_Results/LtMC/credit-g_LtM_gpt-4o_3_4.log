2026-05-26 00:20:09,917 - INFO - ops_string = ["# financial_stability_score\n# Combines ordinal_checking_status, ordinal_savings_status, and housing_ordinal to create an overall financial stability score.\n# Usefulness: Models compound insights about financial security by combining banking, savings, and housing information.\ndf['financial_stability_score'] = df['ordinal_checking_status'] * 0.5 + df['ordinal_savings_status'] * 0.3 + df['housing_ordinal'] * 0.2", "# credit_to_group_mean_ratio\n# Ratio of credit_amount to credit_amount_group_mean to capture deviation from the average within the same purpose category.\n# Usefulness: Highlights applicants with unusually high or low credit demands relative to peers with similar credit purposes, reflecting risk or need.\ndf['credit_to_group_mean_ratio'] = df['credit_amount'] / df['credit_amount_group_mean']", "# age_dependents_ratio\n# Ratio of age to num_dependents, representing the dependency burden of an individual.\n# Usefulness: Encodes how much support a person is likely providing, crucial for assessing financial obligations in the prediction context.\ndf['age_dependents_ratio'] = df['age'] / df['num_dependents']", "# log_credit_amount\n# Log-transformed credit_amount to reduce positive skewness for improved predictive modeling.\n# Usefulness: Normalizes highly skewed credit_amount values for balancing levels across a diverse population.\ndf['log_credit_amount'] = df['credit_amount'].apply(lambda x: np.log(x + 1))", "# repayment_ability_zscore\n# Z-score normalization of repayment_efficiency to standardize ability to repay across applicants.\n# Usefulness: Helps compare repayment efficiency of applicants on the same scale to identify outliers.\ndf['repayment_ability_zscore'] = (df['repayment_efficiency'] - df['repayment_efficiency'].mean()) / df['repayment_efficiency'].std()", "# debt_to_income_categorical\n# Bins debt_to_income_ratio into low, moderate, and high categories.\n# Usefulness: Discretizes repayment burden for better interpretation and downstream classification performance.\ndf['debt_to_income_categorical'] = pd.cut(df['debt_to_income_ratio'], bins=[0, 0.01, 0.05, 0.15], labels=['low', 'moderate', 'high'])", "# housing_asset_interaction\n# Interaction term: housing_ordinal multiplied by asset_owner.\n# Usefulness: Strengthens housing status insights by considering both tangible (ownership) and qualitative (housing type) factors.\ndf['housing_asset_interaction'] = df['housing_ordinal'] * df['asset_owner']", "# tenure_index\n# Ratio of residence_since to duration, representing stability of residence relative to credit duration.\n# Usefulness: Encodes residential stability during the credit repayment period, indicative of reliability.\ndf['tenure_index'] = df['residence_since'] / df['duration']", "# purpose_risk_score\n# Group-based mean credit_amount divided by credit_amount_group_mean for purpose category.\n# Usefulness: Captures collective riskiness of specific credit purposes based on their typical amount size.\ndf['purpose_risk_score'] = df.groupby('purpose')['credit_amount'].transform('mean') / df['credit_amount_group_mean']", "# normalized_checking_to_savings\n# Ratio of ordinal_checking_status to ordinal_savings_status, capturing balance across financial accounts.\n# Usefulness: Highlights disproportionate banking and savings behaviors, indicative of risk.\ndf['normalized_checking_to_savings'] = df['ordinal_checking_status'] / (df['ordinal_savings_status'] + 1)", "# sigmoid_duration\n# Sigmoid-transformed duration to highlight non-linear sensitivity to credit duration.\n# Usefulness: Models diminishing impact of long credit duration on outcomes.\ndf['sigmoid_duration'] = 1 / (1 + np.exp(-df['duration']))", "df.drop(columns=['normalized_credit_amount'], inplace=True)", "df.drop(columns=['credit_amount_group_mean'], inplace=True)"]
