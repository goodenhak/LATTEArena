# repayment_burden
# Ratio of credit amount to duration, indicating the financial pressure of repayment per month.
# Usefulness: Captures repayment ability by evaluating the monthly burden of repaying the credit.
df['repayment_burden'] = df['credit_amount'] / df['duration']
end

python
# credit_to_group_mean_ratio
# Ratio of credit amount to credit_amount_group_mean, highlighting deviation from group norms.
# Usefulness: Identifies individuals seeking credit amounts significantly above or below their peer group average.
df['credit_to_group_mean_ratio'] = df['credit_amount'] / df['credit_amount_group_mean']
end

python
# financial_stability_interaction
# Product of ordinal_checking_status and ordinal_savings_status, combining two stability metrics.
# Usefulness: Reflects the combined financial security level, which can indicate reliable repayment ability.
df['financial_stability_interaction'] = df['ordinal_checking_status'] * df['ordinal_savings_status']
end

python
# normalized_installment_commitment
# Min-Max normalized version of installment_commitment to standardize its range.
# Usefulness: Ensures fair comparison of installment commitment levels across individuals.
df['normalized_installment_commitment'] = (df['installment_commitment'] - df['installment_commitment'].min()) / (df['installment_commitment'].max() - df['installment_commitment'].min())
end

python
# repayment_efficiency_zscore
# Z-score of repayment_efficiency to standardize and highlight extreme values.
# Usefulness: Identifies deviations in efficiency of credit repayment relative to duration.
df['repayment_efficiency_zscore'] = (df['repayment_efficiency'] - df['repayment_efficiency'].mean()) / df['repayment_efficiency'].std()
end

python
# asset_and_housing_combined
# Interaction between housing_ordinal and asset_owner, indicating combined asset and housing stability.
# Usefulness: Reflects asset and housing security comprehensively, which relates to credit risk.
df['asset_and_housing_combined'] = df['housing_ordinal'] * df['asset_owner']
end

python
# one_hot_purpose
# One-hot encoding for the purpose category.
# Usefulness: Captures distinct patterns for specific credit application purposes, important for context.
df = pd.get_dummies(df, columns=['purpose'], prefix='purpose')
end

python
# one_hot_personal_status
# One-hot encoding for personal_status category.
# Usefulness: Encodes demographic factors, such as marital status and gender, that provide borrower context.
df = pd.get_dummies(df, columns=['personal_status'], prefix='personal_status')
end

python
# one_hot_housing
# One-hot encoding for housing category.
# Usefulness: Encodes housing information to observe the impact of residence ownership or renting on creditworthiness.
df = pd.get_dummies(df, columns=['housing'], prefix='housing')
end

python
# drop_unnecessary_columns
# Columns dropped to avoid redundancy or lack of relevance post-transformation.
df.drop(columns=['credit_amount_group_mean', 'checking_status', 'other_payment_plans', 'other_parties', 'foreign_worker'], inplace=True)
end
