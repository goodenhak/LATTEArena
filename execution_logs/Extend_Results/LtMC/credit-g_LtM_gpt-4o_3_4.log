# Feature description: Ratio capturing repayment efficiency normalized by age-adjusted credit demand (repayment_efficiency / normalized_credit_amount).
# Usefulness: Reflects repayment ability adjusted for life stage and credit demand nuances.

df['normalized_repayment_efficiency'] = df['repayment_efficiency'] / df['normalized_credit_amount']
end

python
# asset_savings_interaction
# Feature description: Interaction between housing_ordinal and ordinal_savings_status.
# Usefulness: Captures combined effect of asset ownership and savings stability on financial security.

df['asset_savings_interaction'] = df['housing_ordinal'] * df['ordinal_savings_status']
end

python
# net_credit_load
# Feature description: Approximation of remaining credit burden after considering commitments (credit_amount - (installment_commitment * duration)).
# Usefulness: Represents the net credit burden factoring in installment commitments.

df['net_credit_load'] = df['credit_amount'] - (df['installment_commitment'] * df['duration'])
end

python
# purpose_credit_alignment
# Feature description: Ratio of individual credit amount to average credit amount for the purpose category (credit_amount / credit_amount_group_mean).
# Usefulness: Highlights alignment of credit request to typical levels for the given purpose.

df['purpose_credit_alignment'] = df['credit_amount'] / df['credit_amount_group_mean']
end

python
# installment_commitment_zscore
# Feature description: Z-score normalization of installment commitment values.
# Usefulness: Creates a comparable measure of installment burden across individuals enabling risk-ranking.

df['installment_commitment_zscore'] = (df['installment_commitment'] - df['installment_commitment'].mean()) / df['installment_commitment'].std()
end

python
df.drop(columns=['ordinal_checking_status'], inplace=True)
end

python
df.drop(columns=['ordinal_savings_status'], inplace=True)
end

python
df.drop(columns=['credit_amount_group_mean'], inplace=True)
end
