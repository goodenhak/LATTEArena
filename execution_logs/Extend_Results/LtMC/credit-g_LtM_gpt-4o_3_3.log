end

python
# credit_history_score
# Feature description: Maps credit_history categories to a numerical scale reflecting risk levels (no credits/all paid -> 5, existing paid -> 4, all paid -> 3, delayed previously -> 2, critical/other existing credit -> 1).
# Usefulness: Translates credit history into numerical values, enabling use in predictive models and reflecting past repayment behavior.
credit_history_mapping = {'no credits/all paid': 5, 'existing paid': 4, 'all paid': 3, 'delayed previously': 2, 'critical/other existing credit': 1}
df['credit_history_score'] = df['credit_history'].map(credit_history_mapping)
end

python
# savings_buffer_ratio
# Feature description: Calculates a financial stability ratio as credit_amount divided by savings_status encoded to approximate savings levels (<100 -> 1, 100<=X<500 -> 2, 500<=X<1000 -> 3, >=1000 -> 4, no known savings -> 0.5).
# Usefulness: Measures how much financial buffer (savings) a person has relative to the requested credit, which is vital for assessing financial stability.
savings_mapping = {'<100': 1, '100<=X<500': 2, '500<=X<1000': 3, '>=1000': 4, 'no known savings': 0.5}
df['savings_buffer_ratio'] = df['credit_amount'] / df['savings_status'].map(savings_mapping)
end

python
# age_residence_stability
# Feature description: Computes a stability indicator as the ratio of age to residence_since, representing the average years spent in one place relative to age.
