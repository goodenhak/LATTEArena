# liquidity_to_savings_ratio
# Ratio of checking_status (liquidity) to savings_status (savings). Highlights financial preparedness relative to liquid assets.
# Usefulness: Indicates financial stability by quantifying the balance between liquidity and savings.
df['liquidity_to_savings_ratio'] = df['checking_status'].apply(lambda x: {'no checking': 0, '<0': -1, '0<=X<200': 100, '>=200': 200}[x]) / df['savings_status'].apply(lambda x: {'no known savings': 0, '<100': 50, '100<=X<500': 300, '500<=X<1000': 750, '>=1000': 1000}[x])
end

python
# credit_burden
# Ratio of credit_amount to duration. Represents monthly repayment burden.
# Usefulness: Directly measures repayment capacity and affordability under the loan terms.
df['credit_burden'] = df['credit_amount'] / df['duration']
end

python
# installment_burden
# Ratio of installment_commitment to credit_burden. Measures monthly affordability of loan payments.
# Usefulness: Highlights repayment pressure by comparing installment commitment to calculated burden.
df['installment_burden'] = df['installment_commitment'] / df['credit_burden']
end

python
# credit_savings_gap
# Difference between credit_amount and savings_status. Shows gap between requested amount and available savings.
# Usefulness: Captures financial strain or preparedness for loan repayment.
df['credit_savings_gap'] = df['credit_amount'] - df['savings_status'].apply(lambda x: {'no known savings': 0, '<100': 50, '100<=X<500': 300, '500<=X<1000': 750, '>=1000': 1000}[x])
end

python
# age_zscore
# Z-score normalization for age.
# Usefulness: Enables fair comparison of applicants' age across varying ranges and highlights any outliers.
df['age_zscore'] = (df['age'] - 35.3067) / 11.2603
end

python
# age_credit_interaction
# Interaction between age and existing_credits.
# Usefulness: Highlights repayment pressure as older applicants might face challenges handling more loans.
df['age_credit_interaction'] = df['age'] * df['existing_credits']
end

python
# housing_job_concat
# Combined feature of housing and job.
# Usefulness: Captures joint context of job security and housing status for nuanced applicant evaluation.
df['housing_job_concat'] = df['housing'] + _ + df['job']
end

python
# normalized_duration
# Min-max normalization for duration.
# Usefulness: Normalizes loan duration to range between 0 and 1 for fair comparisons.
df['normalized_duration'] = (df['duration'] - 4) / (60 - 4)
end

python
# monthly_income_available
# Subtraction of credit_burden from installment_commitment.
# Usefulness: Indicates disposable income post-loan payments, reflecting financial flexibility.
df['monthly_income_available'] = df['installment_commitment'] - df['credit_burden']
end

python
# dropping_unused_columns
# Removing unnecessary or redundant columns for cleaner dataset and effective modeling.
df.drop(columns=['num_dependents', 'own_telephone'], inplace=True)
end
