# income_to_loan_ratio
# Represents credit_amount divided by (credit_amount + installment_commitment), estimating repayment capacity.
# Usefulness: Captures the applicant's ability to handle debt relative to income burden.

df['income_to_loan_ratio'] = df['credit_amount'] / (df['credit_amount'] + df['installment_commitment'])
end

python
# repayment_pressure_ratio
# Stores installment_commitment divided by duration, estimating repayment strain over the term.
# Usefulness: Indicates how aggressively the applicant must repay the loan, considering its duration.

df['repayment_pressure_ratio'] = df['installment_commitment'] / df['duration']
end

python
# credit_utilization_savings_ratio
# Combines credit_amount and savings_status for normalized financial stability.
# Usefulness: Represents how much the loan size challenges existing savings reserves.

df['credit_utilization_savings_ratio'] = df['credit_amount'] / (df['savings_status'].replace({'<100': 50, 'no known savings': 0, '100<=X<500': 250, '500<=X<1000': 750, '>=1000': 1000}))
end

python
# debt_burden_per_dependent
# Calculated as credit_amount divided by num_dependents.
# Usefulness: Indicates financial strain per dependent, essential for family contexts.

df['debt_burden_per_dependent'] = df['credit_amount'] / df['num_dependents']
end

python
# temporal_credit_exposure
# Computes duration multiplied by credit_amount to track total loan impact over time.
# Usefulness: Represents the applicant's long-term burden caused by the credit.

df['temporal_credit_exposure'] = df['duration'] * df['credit_amount']
end

python
# checking_status_encoded
# Encodes checking_status using one-hot encoding.
# Usefulness: Breaks down liquidity information into actionable categorical indicators.

df = pd.get_dummies(df, columns=['checking_status'])
end

python
# credit_history_target_encoded
# Applies target encoding to credit_history based on target association values.
# Usefulness: Provides category-specific risk signals directly integrated with output labels.

credit_history_mean_encoding = df.groupby('credit_history')['target'].mean()
df['credit_history_target_encoded'] = df['credit_history'].map(credit_history_mean_encoding)
end

python
# purpose_encoded
# Implements one-hot encoding for purpose.
# Usefulness: Enables specific risk profiling for loan purposes by separate binary columns.

df = pd.get_dummies(df, columns=['purpose'])
end

python
# employment_duration_level
# Label encodes employment into ordinal values.
# Usefulness: Orders employment levels to establish directional stability trends.

employment_mapping = {'<1': 0, '1<=X<4': 1, '4<=X<7': 2, '>=7': 3, 'unemployed': -1}
df['employment_duration_level'] = df['employment'].map(employment_mapping)
end

python
# normalized_credit_amount
# Applies z-score normalization to credit_amount.
# Usefulness: Standardizes loan size for consistent model sensitivity across numerical scales.

df['normalized_credit_amount'] = (df['credit_amount'] - df['credit_amount'].mean()) / df['credit_amount'].std()
end

python
# age_categories
# Bins age into categorical brackets using binning.
# Usefulness: Facilitates capture of nonlinear patterns due to age-related financial trends.

df['age_categories'] = pd.cut(df['age'], bins=[18, 30, 40, 50, 75], labels=['young', 'middle-age', 'senior', 'elderly'])
end

python
# bin_duration
# Categorizes duration into bins: short, medium, long.
# Usefulness: Captures effects of loan term on repayment feasibility.

df['duration_bin'] = pd.cut(df['duration'], bins=[4, 12, 24, 60], labels=['short', 'medium', 'long'])
end

python
# housing_cross_employment
# Generates cross-feature interaction between housing and employment_duration_level.
# Usefulness: Investigates interplay between housing status and stability of employment.

df['housing_employment_interaction'] = pd.factorize(df['housing'])[0] * df['employment_duration_level']
end

python
df.drop(columns=['num_dependents'], inplace=True)
end

python
