# ratio_CnHM
# Ratio of carbon percentage (C%) to the number of heavy atoms (nHM), highlighting proportional relationships in atom composition.
# Usefulness: Captures proportional carbon composition indicative of molecular size and complexity in biodegradability analysis.

df['ratio_CnHM'] = df['C%'] / df['nHM'].replace(0, 1)
end

python
# ratio_nO_nN
# Ratio of oxygen atoms (nO) to nitrogen atoms (nN), emphasizing oxygen's role relative to nitrogen in the molecular structure.
# Usefulness: Oxygen's electron-accepting role versus nitrogen's electron-donating nature strongly influences degradability.

df['ratio_nO_nN'] = df['nO'] / df['nN'].replace(0, 1)
end

python
# interaction_F03_F04
# Interaction effect between F03[C-N] and F04[C-N], capturing dependencies between topological C-N bonding at different distances.
# Usefulness: Captures synergistic effects between short-range and long-range bonding interactions in molecular biodegradability.

df['interaction_F03_F04'] = df['F03[C-N]'] * df['F04[C-N]']
end

python
# interaction_SpMax_TIL
# Product of leading eigenvalue from the adjacency matrix (SpMax_A) and second Mohar index (TI2_L).
# Usefulness: Highlights interplay between structural complexity (connectivity) and molecular adjacency influencing stability.

df['interaction_SpMax_TIL'] = df['SpMax_A'] * df['TI2_L']
end

python
# sqrt_SdO
# Square root transformation of the sum of dO E-states (SdO).
# Usefulness: Emphasizes non-linear relationships arising from electron richness of oxygen atoms critical for reactivity.

df['sqrt_SdO'] = np.sqrt(df['SdO'])
end

python
# log_F03_CO
# Logarithmic transformation of F03[C-O].
# Usefulness: Captures diminishing returns and non-linear effects in the frequency of C-O interactions, crucial for bond degradation.

df['log_F03_CO'] = np.log(df['F03[C-O]'].replace(0, 1))
end

python
# zscore_LOCSdO
# Z-score normalized product of LOC and SdO, combining connectivity indices and electron-state contributions.
# Usefulness: Highlights the interplay of molecular connectivity and electronic structural effects in degradability.

df['zscore_LOCSdO'] = (df['LOC'] * df['SdO'] - (df['LOC'] * df['SdO']).mean()) / (df['LOC'] * df['SdO']).std()
end

python
# diff_CminusX
# Difference between C% (percentage of carbon atoms) and nX (number of halogen atoms).
# Usefulness: Captures the effect of halogen substitution, which often resists biodegradation, relative to carbon content.

df['diff_CminusX'] = df['C%'] - df['nX']
end

python
# sigmoid_SpMax_Bm
# Sigmoid transformation of SpMax_B(m).
# Usefulness: Emphasizes extreme variations in mass-weighted eigenvalues, accounting for boundary effects in the molecular mass distribution.

df['sigmoid_SpMax_Bm'] = 1 / (1 + np.exp(-df['SpMax_B(m)']))
end

python
# rolling_mean_TIL
# Rolling mean of second Mohar index (TI2_L) with a window of 3.
# Usefulness: Aggregates local connectivity changes in molecular structure, offering dynamic insights into structural shifts.

df['rolling_mean_TIL'] = df['TI2_L'].rolling(window=3, min_periods=1).mean()
end

python
# cumsum_F04_CN
# Cumulative sum of F04[C-N] through the dataset.
# Usefulness: Aggregates the contributions of carbon-nitrogen functional groups, associated with degradability.

df['cumsum_F04_CN'] = df['F04[C-N]'].cumsum()
end

python
df.drop(columns=['XX'], inplace=True)
end
