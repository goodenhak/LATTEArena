# ratio_CnHM_squared
# Square the ratio of carbon percentage (C%) to the number of heavy atoms (nHM), highlighting the impact of carbon-heavy atom proportions in a non-linear manner.
# Usefulness: This transformation emphasizes significant variations in carbon dominance across the chemicals, which can influence biodegradability.
df['ratio_CnHM_squared'] = df['ratio_CnHM']  2
end

python
# inverse_SpMax_Bm
# Reciprocal transformation of the leading eigenvalue from Burden matrix weighted by mass.
# Usefulness: Highlights decreases in mass-related eigenvalues disproportionally, accentuating features with smaller values which may reflect critical structural properties.
df['inverse_SpMax_Bm'] = 1 / df['SpMax_B(m)']
end

python
# diff_SpMax_A_SpMax_L
# Difference between the leading eigenvalues from the adjacency and Laplace matrices.
# Usefulness: Highlights structural differences based on adjacency and connectivity in the molecular graphs, potentially capturing unique features relevant to decomposition.
df['diff_SpMax_A_SpMax_L'] = df['SpMax_L'] - df['SpMax_A']
end

python
# rolling_std_TI2_L
# Rolling standard deviation of the second Mohar index (TI2_L) with a window of 5.
# Usefulness: Captures localized variations in molecular connectivity, which could highlight regions with complex structural changes impacting biodegradability.
df['rolling_std_TI2_L'] = df['TI2_L'].rolling(window=5).std().fillna(0)
end

python
# interaction_nO_nHDon
# Interaction between the number of oxygen atoms (nO) and donor atoms for hydrogen bonds (nHDon).
# Usefulness: Explores the dependency between oxygen presence and hydrogen bonding, crucial for understanding biodegradability pathways involving oxygen and H-bonds.
df['interaction_nO_nHDon'] = df['nO'] * df['nHDon']
end

python
# log_ratio_nO_nN
# Logarithmic transformation of the ratio of oxygen atoms (nO) to nitrogen atoms (nN).
# Usefulness: Diminishes skewness and emphasizes oxygen’s role relative to nitrogen in the molecular structure, both of which are crucial for biodegradability.
df['log_ratio_nO_nN'] = np.log1p(df['ratio_nO_nN'])
end

python
# sqrt_diff_CminusX
# Square root of the difference between the carbon percentage (C%) and the number of halogen atoms (nX).
# Usefulness: Highlights the impact of carbon and halogen interplay on chemical interactions that determine biodegradability.
df['sqrt_diff_CminusX'] = np.sqrt(df['diff_CminusX'])
end

python
# interaction_F03_F04_scaled
# Scaled product of frequencies of C-N bonds at topological distances 3 and 4.
# Usefulness: Explores dependencies and cumulative effects of nearby bond frequencies, which may affect molecular stability.
df['interaction_F03_F04_scaled'] = df['interaction_F03_F04'] / (df['F03[C-N]'] + df['F04[C-N]'] + 1)
end

python
# sigmoid_HyWi_Bm
# Sigmoid transformation of the hyper-Wiener-like index weighted by mass.
# Usefulness: Captures boundary effects for mass-weighted molecular descriptors, refining their contribution to the model.
df['sigmoid_HyWi_Bm'] = 1 / (1 + np.exp(-df['HyWi_B(m)']))
end

python
