# ratio_CnHM
# Ratio of carbon percentage (C%) to the number of heavy atoms (nHM), highlighting proportional relationships in atom composition.
# Usefulness: This captures the relative contribution of carbon atoms to the molecular structure, which can impact biodegradability.
df['ratio_CnHM'] = df['C%'] / (df['nHM'] + 1e-6)
end

python
# ratio_nO_nN
# Ratio of oxygen atoms (nO) to nitrogen atoms (nN), emphasizing oxygen's role relative to nitrogen in molecular structure.
# Usefulness: The O/N ratio is significant in understanding chemical properties that affect biodegradability.
df['ratio_nO_nN'] = df['nO'] / (df['nN'] + 1e-6)
end

python
# interaction_F03_F04
# Interaction of F03[C-N] and F04[C-N], emphasizing dependencies between different C-N bonding distances.
# Usefulness: Enables the model to capture higher-level bonding patterns relevant to classification.
df['interaction_F03_F04'] = df['F03[C-N]'] * df['F04[C-N]']
end

python
# interaction_SpMax_TIL
# Product of the leading eigenvalue from the adjacency matrix (SpMax_A) and the second Mohar index (TIL).
# Usefulness: Encodes composite structural information key to understanding molecular complexity and connectivity.
df['interaction_SpMax_TIL'] = df['SpMax_A'] * df['TI2_L']
end

python
# sqrt_SdO
# Square root transformation of the sum of dO E-states (SdO).
# Usefulness: Reduces the skewness of SdO while preserving non-linear effects, making the feature more interpretable for the model.
df['sqrt_SdO'] = np.sqrt(df['SdO'])
end

python
# log_F03_CO
# Logarithm transformation of F03[C-O], capturing non-linear relationships in bonding patterns.
# Usefulness: Highlights variation in C-O bonding frequency at topological distance 3, which may impact biodegradability.
df['log_F03_CO'] = np.log(df['F03[C-O]'] + 1e-6)
end

python
# zscore_LOCSdO
# Z-score normalized product of LOC and SdO, combining connectivity and dO E-states contributions.
# Usefulness: Captures the structural role of connectivity with weighted atomic electronegativity in biodegradability prediction.
df['zscore_LOCSdO'] = (df['LOC'] * df['SdO'] - (df['LOC'] * df['SdO']).mean()) / ((df['LOC'] * df['SdO']).std() + 1e-6)
end

python
# diff_CminusX
# Difference between the percentage of carbon atoms (C%) and the number of halogen atoms (nX).
# Usefulness: Indicates the relative balance between carbon and halogens, crucial for understanding the structural influence on biodegradability.
df['diff_CminusX'] = df['C%'] - df['nX']
end

python
# sigmoid_SpMax_Bm
# Sigmoid transformation of SpMax_B(m), emphasizing boundary effects in mass-weighted eigenvalues.
# Usefulness: Normalizes values while highlighting critical thresholds in molecular eigenvalues related to structure.
df['sigmoid_SpMax_Bm'] = 1 / (1 + np.exp(-df['SpMax_B(m)']))
end

python
# rolling_mean_TIL
# Rolling mean of the second Mohar index (TI2_L) with a window of 3.
# Usefulness: Captures cumulative trends in the graph-based index, providing insights into how structure evolves locally.
df['rolling_mean_TIL'] = df['TI2_L'].rolling(window=3, min_periods=1).mean()
end

python
# cumsum_F04_CN
# Cumulative sum of F04[C-N] through the dataset.
# Usefulness: Tracks the accumulated frequency of C-N bonds at topological distance 4, offering a global perspective.
df['cumsum_F04_CN'] = df['F04[C-N]'].cumsum()
end

python
# drop_SdssC
# Drops SdssC column as it has limited range and high negative mean, which may contribute little unique value to prediction.
df.drop(columns=['SdssC'], inplace=True)
end

python
# drop_B01CBr_B04CBr
# Drops B01[C-Br] and B04[C-Br], as these infrequent indicators could lead to sparsity and overfitting.
df.drop(columns=['B01[C-Br]', 'B04[C-Br]'], inplace=True)
end
