2026-05-26 01:44:55,462 - INFO - ops_string = ["# ratio_CnHM\n# Ratio of carbon percentage (C%) to the number of heavy atoms (nHM), reflects proportional relationships in molecular composition.\n# Usefulness: Highlights the balance between two key molecular descriptors that impact the compound's size and organic composition.\ndf['ratio_CnHM'] = df['C%'] / (df['nHM'] + 1e-10)", "# ratio_nO_nN\n# Ratio of oxygen atoms (nO) to nitrogen atoms (nN), emphasizing the role of oxygen relative to nitrogen in the molecular structure.\n# Usefulness: Oxygen content is linked to environmental degradation, while nitrogen impacts chemical behavior. This feature balances their contributions.\ndf['ratio_nO_nN'] = df['nO'] / (df['nN'] + 1e-10)", "# interaction_F03_F04\n# Interaction of F03[C-N] and F04[C-N], emphasizing dependencies between different C-N bonding distances.\n# Usefulness: Reveals relationships and interactions between different bonding patterns, which may contribute to chemical property variations.\ndf['interaction_F03_F04'] = df['F03[C-N]'] * df['F04[C-N]']", "# interaction_SpMax_TIL\n# Product of the leading eigenvalue from the adjacency matrix (SpMax_A) and the second Mohar index (TI2_L).\n# Usefulness: Combines structural indices to give an overall sense of molecular connectivity and atomic interactions.\ndf['interaction_SpMax_TIL'] = df['SpMax_A'] * df['TI2_L']", "# sqrt_SdO\n# Square root transformation of the sum of dO E-states (SdO).\n# Usefulness: Stabilizes variance in a feature with a large range and ensures better representation of the sum of dO states.\ndf['sqrt_SdO'] = np.sqrt(df['SdO'])", "# log_F03_CO\n# Logarithm transformation of F03[C-O], capturing non-linear relationships in bonding patterns.\n# Usefulness: Addresses skewness in highly variable bonds related to molecular properties that influence biodegradability.\ndf['log_F03_CO'] = np.log(df['F03[C-O]'] + 1e-10)", "# zscore_LOCSdO\n# Z-score normalized product of LOC and SdO.\n# Usefulness: Combines molecular connectivity and weighted E-states to capture outliers or deviations more effectively.\ndf['zscore_LOCSdO'] = (df['LOC'] * df['SdO'] - (df['LOC'] * df['SdO']).mean()) / (df['LOC'] * df['SdO']).std()", "# diff_CminusX\n# Difference between the percentage of carbon atoms (C%) and the number of halogen atoms (nX).\n# Usefulness: Provides insights into how halogen content affects the organic composition and potential eco-friendliness.\ndf['diff_CminusX'] = df['C%'] - df['nX']", "# sigmoid_SpMax_Bm\n# Sigmoid transformation of SpMax_B(m).\n# Usefulness: Highlights boundary effects in mass-weighted eigenvalues while ensuring non-linear progression effects.\ndf['sigmoid_SpMax_Bm'] = 1 / (1 + np.exp(-df['SpMax_B(m)']))", "# rolling_mean_TIL\n# Rolling mean of the second Mohar index (TI2_L) with a window of 3.\n# Usefulness: Smoothens local variations in molecular connectivity, which could help reduce noise in feature representation.\ndf['rolling_mean_TIL'] = df['TI2_L'].rolling(window=3, min_periods=1).mean()", "# cumsum_F04_CN\n# Cumulative sum of F04[C-N] through the dataset.\n# Usefulness: Tracks cumulative trends in C-N bonding patterns over the data, aiding in understanding tendencies.\ndf['cumsum_F04_CN'] = df['F04[C-N]'].cumsum()", "df.drop(columns=['ratio_CnHM', 'ratio_nO_nN', 'interaction_F03_F04', 'interaction_SpMax_TIL', \n                 'sqrt_SdO', 'log_F03_CO', 'zscore_LOCSdO', 'diff_CminusX', \n                 'sigmoid_SpMax_Bm', 'rolling_mean_TIL', 'cumsum_F04_CN'], inplace=True)"]
