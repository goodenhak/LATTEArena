# ratio_SM6L_SM6Bm
# Ratio of SM6_L to SM6_B(m) captures variation in Laplace matrix versus mass-weighted spectrum, emphasizing spectral differences.
# Usefulness: Highlights differences in structural versus mass-based spectral information, relating to molecular stability.

df['ratio_SM6L_SM6Bm'] = df['SM6_L'] / df['SM6_B(m)']
end

python
# interaction_F02_F03
# Product of F02[C-N] and F03[C-N] emphasizes dependencies between C-N bonds at different distances.
# Usefulness: Incorporates bond interactions, potentially enhancing class separation between biodegradable and non-biodegradable chemicals.

df['interaction_F02_F03'] = df['F02[C-N]'] * df['F03[C-N]']
end

python
# ratio_nO_C
# Ratio of oxygen atoms (nO) to carbon percentage (C%), contextualizing oxygen's contribution against overall carbon content.
# Usefulness: Highlights the influence of oxygen atoms in oxygen-rich molecules relevant for biodegradability.

df['ratio_nO_C'] = df['nO'] / df['C%']
end

python
# ratio_SpMax_L_TIL
# Ratio of SpMax_L to TI2_L compares Laplacian connectivity and molecular stability indices.
# Usefulness: Provides structural insight into how molecular connectivity influences biodegradability.

df['ratio_SpMax_L_TIL'] = df['SpMax_L'] / df['TI2_L']
end

python
# comb_SdO_C%
# Sum of dO E-states multiplied by the carbon percentage (C%) to link electronic states with carbon-heavy structures.
# Usefulness: Captures combined effects of electronic states and carbon content impacting biodegradability criteria.

df['comb_SdO_C%'] = df['SdO'] * df['C%']
end

python
# diff_nCp_nCb
# Difference between the number of terminal primary carbons (nCp) and substituted benzene carbons (nCb-).
# Usefulness: Highlights structural variation between aliphatic and aromatic carbon structures in chemicals.

df['diff_nCp_nCb'] = df['nCp'] - df['nCb-']
end

python
# rolling_mean_SdO
# Rolling mean of SdO (sum of dO E-states) over a window size of 3.
# Usefulness: Tracks local trends in electronic states across neighboring molecules in the dataset.

df['rolling_mean_SdO'] = df['SdO'].rolling(window=3).mean()
end

python
# cumsum_F02_CN
# Cumulative sum of F02[C-N] through the dataset.
# Usefulness: Aggregates bonding patterns for C-N (at topological distance 2), capturing dataset-wide trends.

df['cumsum_F02_CN'] = df['F02[C-N]'].cumsum()
end

python
# log_F04_CN
# Log transformation of F04[C-N], highlighting non-linear relationships in C-N bonding frequency at distance 4.
# Usefulness: Accounts for exponential decay or sparsity in bonding patterns, relevant for modeling.

df['log_F04_CN'] = np.log(df['F04[C-N]'] + 1)
end

python
# interaction_F03_CO_F03_CN
# Product of F03[C-O] and F03[C-N], capturing dependencies across oxygen and nitrogen bonds.
# Usefulness: Linkages between O and N bonding reflect molecular behavior impacting biodegradability.

df['interaction_F03_CO_F03_CN'] = df['F03[C-O]'] * df['F03[C-N]']
end

python
# drop ratio_CnHM
df.drop(columns=['ratio_CnHM'], inplace=True)
end

python
# drop rolling_mean_TIL
df.drop(columns=['rolling_mean_TIL'], inplace=True)
end
