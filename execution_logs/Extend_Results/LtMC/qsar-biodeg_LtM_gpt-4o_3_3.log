end

python
# ratio_nO_nN
# Ratio of oxygen atoms (nO) to nitrogen atoms (nN), emphasizing the role of oxygen as donors versus nitrogen in molecular structure.
# Usefulness: Distinguishes the contribution of oxygen relative to nitrogen in biodegradation.
df['ratio_nO_nN'] = df['nO'] / (df['nN'] + 1)
end

python
# interaction_F03_F04
# Interaction of frequencies at topological distances: F03[C-N] * F04[C-N]
# Usefulness: Highlights bonding interactions between C-N bonds across different topological distances, which could impact degradability.
df['interaction_F03_F04'] = df['F03[C-N]'] * df['F04[C-N]']
end

python
# interaction_SpMax_TIL
# Product of SpMax_A (leading eigenvalue from adjacency matrix) and TI2_L (Second Mohar index).
# Usefulness: Captures the joint effect of molecular adjacency and topology on biodegradation.
df['interaction_SpMax_TIL'] = df['SpMax_A'] * df['TI2_L']
end

python
# log_F03_CO
# Log transformation of F03[C-O].
# Usefulness: Captures non-linear relationships in the frequency of C-O bonds, which could be essential in biodegradability.
df['log_F03_CO'] = np.log(df['F03[C-O]'] + 1)
end

python
# zscore_LOCSdO
# Z-score of the product of LOC (Looping centric index) and SdO (sum of dO E-states).
# Usefulness: Combines looping connectivity and electronic properties in a standardized format for dependency representation.
df['zscore_LOCSdO'] = (df['LOC'] * df['SdO'] - (df['LOC'] * df['SdO']).mean()) / (df['LOC'] * df['SdO']).std()
end

python
