# log_loc_squared
# The square of log-transformed lines of code. Helps capture non-linear relationships between code size and defect likelihood.
# Usefulness: Modules with very small or very large sizes may have higher defect rates, and squaring log_loc captures this effect.
df['log_loc_squared'] = df['log_loc']  2
end

python
# overall_complexity_per_branch
# Overall complexity per branch, indicating the complexity burden of each decision point.
# Usefulness: Modules with high complexity spread across fewer branch points are more prone to defects due to concentrated complexity.
df['overall_complexity_per_branch'] = df['overall_complexity'] / df['branchCount']
end

python
# effort_density_per_volume
# Effort density normalized by Halstead volume per decision point.
# Usefulness: Highlights how concentrated effort relates to logical decision complexity.
df['effort_density_per_volume'] = df['effort_density'] / df['volume_per_decision_point']
end

python
# log_loc_times_difficulty_per_complexity
# Log-transformed lines of code multiplied by difficulty per cyclomatic complexity.
# Usefulness: Integrates module size and difficulty, emphasizing size-scaled complexity's impact on defects.
df['log_loc_times_difficulty_per_complexity'] = df['log_loc'] * df['difficulty_per_complexity']
end

python
# branch_density_times_volume_per_decision_point
# Branching density multiplied by volume per decision point.
# Usefulness: Captures interaction between branching intensity and code volume per logical decision.
df['branch_density_times_volume_per_decision_point'] = df['branch_density'] * df['volume_per_decision_point']
end

python
# effort_per_complexity_times_v_g_per_loc
# Effort required per cyclomatic complexity point combined with cyclomatic complexity per line of code.
# Usefulness: Links module complexity effort to structural complexity per line, highlighting high-effort areas.
df['effort_per_complexity_times_v_g_per_loc'] = df['effort_per_complexity'] * df['v_g_per_loc']
end

python
# size_weighted_difficulty_times_effort_density
# Size-weighted difficulty multiplied by programming effort density.
# Usefulness: Combines module size, difficulty, and effort concentration to emphasize areas prone to defects.
df['size_weighted_difficulty_times_effort_density'] = df['size_weighted_difficulty'] * df['effort_density']
end

python
# log_e_divided_by_overall_complexity
# Log-transformed Halstead effort divided by overall complexity.
# Usefulness: Indicates how effectively effort scales with combined structural complexity, a potential indicator of defect proneness.
df['log_e_divided_by_overall_complexity'] = df['log_e'] / df['overall_complexity']
end

python
# effort_density_times_branch_density
# Effort density multiplied by branch density.
# Usefulness: Captures correlation between effort concentration and logical branching intensity.
df['effort_density_times_branch_density'] = df['effort_density'] * df['branch_density']
end

python
# reciprocal_loc
# Reciprocal of lines of code.
# Usefulness: Highlights disproportionately high defect rates in very small modules due to insufficient code for error handling.
df['reciprocal_loc'] = 1 / df['loc']
end

python
# Features dropped due to redundancy or low importance
df.drop(columns=['effort_density', 'volume_per_decision_point', 'difficulty_per_complexity', 'loc_to_comment_ratio', 'uniq_op_to_total_op_ratio'], inplace=True)
end
