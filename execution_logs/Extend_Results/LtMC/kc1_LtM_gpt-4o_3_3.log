# Sum of cyclomatic, essential, and design complexity to capture aggregate structural complexity.
# Usefulness: Individual complexities have additive effects on defect likelihood, and this captures their joint impact.
df['overall_complexity'] = df['v(g)'] + df['ev(g)'] + df['iv(g)']
end

python
# size_weighted_difficulty
