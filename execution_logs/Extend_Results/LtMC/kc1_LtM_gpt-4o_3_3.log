end

python
# weighted_difficulty_density
# Difficulty weighted by lines of code and normalized by Halstead effort.
# Usefulness: Measures how module difficulty manifests relative to its effort and size.
df['weighted_difficulty_density'] = (df['d'] * df['loc']) / (df['e'] + 1)
end

python
# volume_to_branch_ratio
# Ratio of Halstead volume to branch count.
# Usefulness: Indicates how much code logic must be processed relative to decision points.
df['volume_to_branch_ratio'] = df['v'] / (df['branchCount'] + 1)
end

python
# cumulative_complexity
# Cumulative sum of cyclomatic, essential, and design complexity across the dataset.
# Usefulness: Provides global context on module complexity trends across the software.
df['cumulative_complexity'] = df['v(g)'] + df['ev(g)'] + df['iv(g)']
end

python
# inverse_branch_density
# Reciprocal of branch density to capture sparsity of branching per line of code.
# Usefulness: Highlights modules with low branching relative to size, which may have better-maintainable structures.
df['inverse_branch_density'] = 1 / (df['branch_density'] + 1e-5)
end

python
