python
# v_g_per_loc
# Cyclomatic complexity per line of code, indicating relative structural complexity.
# Usefulness: Modules with high complexity per line are more defect-prone as they represent dense control structures.
df['v_g_per_loc'] = df['v(g)'] / df['loc']
end

python
# branch_density
# Branch count per line of code, measuring how densely decisions are distributed.
# Usefulness: Denser branching indicates more potential decision paths, linked to higher defect counts.
df['branch_density'] = df['branchCount'] / df['loc']
end

python
# effort_density
# Programming effort per line of code, capturing effort relative to module size.
# Usefulness: High relative effort often points to harder-to-maintain and defect-prone modules.
df['effort_density'] = df['e'] / df['loc']
end

python
# volume_per_decision_point
# Halstead volume per cyclomatic complexity, showing how much code needs to be understood per decision.
# Usefulness: Useful for pinpointing modules that are dense in logic but hard to understand.
df['volume_per_decision_point'] = df['v'] / df['v(g)']
end

python
# effort_per_complexity
# Effort required per cyclomatic complexity point.
# Usefulness: Highlights modules where decision complexity is disproportionately expensive.
df['effort_per_complexity'] = df['e'] / df['v(g)']
end

python
# difficulty_per_complexity
# Difficulty per cyclomatic complexity point.
# Usefulness: Useful for identifying modules with complex decisions that are harder to understand or maintain.
df['difficulty_per_complexity'] = df['d'] / df['v(g)']
end

python
# total_operators_operands
