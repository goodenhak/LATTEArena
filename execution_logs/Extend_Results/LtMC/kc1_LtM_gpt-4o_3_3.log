df['uniq_opnd_to_total_opnd_ratio'] = df['uniq_Opnd'] / (df['total_Opnd'] + 1e-5)
end

python
# overall_effort_density
# Overall effort normalized by size of the module. ((overall_complexity * e) / loc)
# Usefulness: Highlights modules that require disproportionately high effort relative to their size, often associated with defect-prone areas.
df['overall_effort_density'] = (df['overall_complexity'] * df['e']) / (df['loc'] + 1e-5)
end

python
