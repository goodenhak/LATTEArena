2026-05-26 01:09:57,496 - INFO - ops_string = ["# log_effort_density\n# Log-transformed effort density to address skewness in programming effort per LOC.\n# Usefulness: Helps normalize the effort density metric, reducing the impact of extreme outliers, and makes the feature more interpretable in capturing resource intensity for defect-rich modules.\ndf['log_effort_density'] = df['effort_density'].apply(lambda x: 0 if x <= 0 else np.log(x))", "# cyclomatic_complexity_interactions\n# Combined impact of cyclomatic complexity and effort_density.\n# Usefulness: Captures synergies between structural complexity and programming intensity, which may strongly contribute to defect patterns.\ndf['cyclomatic_complexity_interactions'] = df['v(g)'] * df['effort_density']", "# normalized_branch_interaction\n# Normalized branch complexity by branching frequency and loc.\n# Usefulness: Highlights modules with dense structural branching and high cyclomatic burden relative to size, where defects might be embedded.\ndf['normalized_branch_interaction'] = df['branch_and_complexity_interaction'] / (df['branchCount'] + df['loc'])", "# defect_prone_difficulty_indicator\n# Interaction of difficulty and cyclomatic complexity across size_weighted metrics.\n# Usefulness: Useful for emphasizing highly difficult, overly intricate paths that signal increased defect likelihood.\ndf['defect_prone_difficulty_indicator'] = df['difficulty_per_complexity'] * df['size_weighted_difficulty']", "# scaled_volume_intelligence\n# Ratio of volume to intelligence score to gauge inefficiencies in code comprehension demands.\n# Usefulness: Reflects inefficiencies in readability and maintenance, providing insights into modules with excessive complexity compared to intelligence gains.\ndf['scaled_volume_intelligence'] = df['v'] / (df['i'] + 1e-5)  # Adding epsilon to prevent division by zero.", "# weighted_cognitive_complexity\n# Halstead volume weighted by log of overall complexity for large code structures.\n# Usefulness: Amplifies combined cognitive load and overall added modular risks associated with defects.\ndf['weighted_cognitive_complexity'] = df['v'] * np.log(df['overall_complexity'] + 1)"]
