end

python
# loc_normalized_complexity
# Overall complexity (v(g) + ev(g) + iv(g)) divided by loc, capturing complexity intensity per line of code.
# Usefulness: Highlights modules with high structural complexity relative to their size, linked to defect proneness.
df['loc_normalized_complexity'] = df['overall_complexity'] / df['loc']
end

python
# complexity_effort_ratio
# Ratio of Halstead effort (e) to overall complexity, providing insight into coding effort per unit complexity.
# Usefulness: Identifies modules with disproportionate effort exerted on complexity, potentially indicating high cognitive demand.
df['complexity_effort_ratio'] = df['e'] / df['overall_complexity']
end

python
# branch_effort_interaction
# Multiplication of branch density and effort density, indicating effort intensity considering branch complexity.
# Usefulness: Reflects the impact of control flow decisions on required programming effort, a potential defect indicator.
df['branch_effort_interaction'] = df['branch_density'] * df['effort_density']
end

python
# decision_point_coding_density
# Ratio of total operators and operands to branch count, indicating average operations per decision point.
# Usefulness: Highlights modules with dense logic concentrated around control flow decisions, potentially increasing vulnerability.
df['decision_point_coding_density'] = df['total_operators_operands'] / df['branchCount']
end

python
# operator_operand_dominance
# Difference between total operators and operands, normalized by total operators + operands.
# Usefulness: Indicates balance or dominance between operators and operands, which can affect code readability and defect likelihood.
df['operator_operand_dominance'] = (df['total_Op'] - df['total_Opnd']) / df['total_operators_operands']
end

python
# uniq_op_to_uniq_opnd_ratio
# Ratio of unique operators to unique operands, capturing the diversity or balance of these entities in the code.
# Usefulness: Reflects code diversity, which can indicate either efficient or overly complex coding practices affecting defect rates.
df['uniq_op_to_uniq_opnd_ratio'] = df['uniq_Op'] / df['uniq_Opnd']
end

python
# log_effort_density
# Log-transformed effort density to reduce skewness from modules with high effort per line of code.
# Usefulness: Captures high-effort modules while mitigating the influence of extreme values and improving interpretability.
df['log_effort_density'] = np.log1p(df['effort_density'])
end

python
# weighted_complexity
# Sum of cyclomatic, essential, and design complexity weighted by Halstead difficulty.
# Usefulness: Adds nuanced granularity to complexity by considering the cognitive scale of understanding the code.
df['weighted_complexity'] = (df['v(g)'] + df['ev(g)'] + df['iv(g)']) * df['d']
end

python
# log_complexity_effort_interaction
# Log-transformed product of overall complexity and Halstead effort to capture their interaction while reducing skewness.
# Usefulness: Reflects the combined impact of effort and complexity on defect-proneness, normalized for extreme values.
df['log_complexity_effort_interaction'] = np.log1p(df['overall_complexity'] * df['e'])
end

