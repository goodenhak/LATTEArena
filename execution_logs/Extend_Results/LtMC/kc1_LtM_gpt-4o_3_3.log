2026-05-26 01:08:00,040 - INFO - ops_string = ["# complexity_interaction\n# Interaction between key complexity metrics to capture compounded effects of structural complexity.\n# Usefulness: Accounts for combined impact of cyclomatic, essential, and design complexity in predicting defects.\ndf['complexity_interaction'] = df['v(g)'] * df['ev(g)'] * df['iv(g)']", "# size_weighted_difficulty\n# Product of module size (loc) and Halstead difficulty (d), measuring size-normalized effort in complex modules.\n# Usefulness: Reflects scale-adjusted difficulty for defect-prone modules based on coding effort.\ndf['size_weighted_difficulty'] = df['loc'] * df['d']", "# effort_per_size\n# Programming effort normalized by module size to assess relative effort required per line of code.\n# Usefulness: Identifies modules where high effort is concentrated in limited code, often more error-prone.\ndf['effort_per_size'] = df['e'] / (df['loc'] + 1e-5)  # Prevent division by zero.", "# volume_to_size_ratio\n# Halstead volume per line of code, representing the density and cognitive load of a module.\n# Usefulness: Highlights modules that are dense and complex per size unit, potentially increasing defect chances.\ndf['volume_to_size_ratio'] = df['v'] / (df['loc'] + 1e-5)  # Prevent division by zero.", "# decision_density_ratio\n# Ratio of branch density to overall complexity, reflecting structural decision load against complexity.\n# Usefulness: Evaluates how well a module’s decision-making process aligns with its structural complexity.\ndf['decision_density_ratio'] = df['branch_density'] / (df['overall_complexity'] + 1e-5)  # Prevent division by zero.", "# uniq_operands_per_operator_ratio\n# Ratio of unique operands to unique operators, indicating operand diversity against operation complexity.\n# Usefulness: Measures the richness of operands per operator, which may affect code readability and defect propensity.\ndf['uniq_operands_per_operator_ratio'] = df['uniq_Opnd'] / (df['uniq_Op'] + 1e-5)  # Prevent division by zero.", "# log_volume\n# Log-transformed Halstead volume to mitigate outliers and normalize its distribution.\n# Usefulness: Reduces skewness in the volume feature, which captures information complexity.\ndf['log_volume'] = np.log(df['v'] + 1e-5)  # Adjust small constant for log stability.", "# log_effort\n# Log-transformed programming effort to reduce skewness and improve prediction efficacy.\n# Usefulness: Normalizes extreme variations in programming effort, a critical defect predictor.\ndf['log_effort'] = np.log(df['e'] + 1e-5)  # Adjust small constant for log stability.", "# cube_branch_density\n# Cube transformation of branch density to capture non-linear increases in decision-making intensity.\n# Usefulness: Allows capturing thresholds where heavily branched modules disproportionately affect defects.\ndf['cube_branch_density'] = df['branch_density']  3", "# squared_complexity\n# Square of overall complexity to model non-linear impact of high structural complexity.\n# Usefulness: Emphasizes modules with extreme complexity, which are likely to be more defect-prone.\ndf['squared_complexity'] = df['overall_complexity']  2", "# cumulative_branch_count\n# Cumulative sum of branch count, capturing module-wide decision accumulation trends.\n# Usefulness: Highlights modules with high aggregate decision complexity, likely to contribute to defects.\ndf['cumulative_branch_count'] = df['branchCount'].cumsum()", "# difficulty_effort_ratio\n# Ratio of difficulty to effort per module, showing how coding effort matches module complexity difficulty.\n# Usefulness: Identifies if effort allocations align efficiently with module complexity.\ndf['difficulty_effort_ratio'] = df['d'] / (df['e'] + 1e-5)  # Prevent division by zero.", "df.drop(columns=['b', 't', 'l', 'log_e', 'loc_to_comment_ratio', 'uniq_op_to_total_op_ratio'], inplace=True)"]
