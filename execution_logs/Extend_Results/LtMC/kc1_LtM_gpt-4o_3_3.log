# defect_density
# Defects per line of code calculated as 1/loc (since defect labels are binary and associated with loc).
# Usefulness: Normalizes defect probability by code length, providing insight into defect likelihood relative to module size.
df['defect_density'] = 1 / df['loc']

# branch_density
# Branching complexity per line of code calculated as branchCount / loc.
# Usefulness: Captures branching density as an indicator of higher logic complexity that may lead to defects.
df['branch_density'] = df['branchCount'] / df['loc']

# effort_per_complexity
# Effort per cyclomatic complexity calculated as e / (v(g) + 1).
# Usefulness: Highlights high effort areas that may incur defects, considering control flow complexity.
df['effort_per_complexity'] = df['e'] / (df['v(g)'] + 1)

# volume_per_line
# Halstead volume normalized by lines of code calculated as v / loc.
# Usefulness: Indicates information density per line of code and correlates with defect-proneness.
df['volume_per_line'] = df['v'] / df['loc']

# effort_per_line
# Halstead effort normalized by lines of code calculated as e / loc.
# Usefulness: Tracks computational effort concentration, a potential defect predictor.
df['effort_per_line'] = df['e'] / df['loc']

# normalized_branchCount
# z-score normalization of branchCount.
# Usefulness: Standardized score reveals extreme branching cases compared to average complexity.
df['normalized_branchCount'] = (df['branchCount'] - df['branchCount'].mean()) / df['branchCount'].std()

# code_to_comment_ratio
# Code lines divided by the number of comment lines calculated as lOCode / (lOComment + 1).
# Usefulness: Indicates code quality and documentation sufficiency, impacting maintainability.
df['code_to_comment_ratio'] = df['lOCode'] / (df['lOComment'] + 1)

# design_to_basic_complexity
# Design complexity proportion calculated as iv(g) / v(g).
# Usefulness: Highlights modules where design complexity dominates basic complexity, potentially leading to defects.
df['design_to_basic_complexity'] = df['iv(g)'] / (df['v(g)'] + 1)

# essential_to_basic_complexity
# Essential complexity proportion calculated as ev(g) / v(g).
# Usefulness: Measures minimal, testable, or irreducible complexity relative to overall control flow complexity.
df['essential_to_basic_complexity'] = df['ev(g)'] / (df['v(g)'] + 1)

# unique_operands_to_operators
# Unique operands to unique operators ratio calculated as uniq_Opnd / (uniq_Op + 1).
# Usefulness: Captures operand/operator balance, reflecting code simplicity vs. potential for error.
df['unique_operands_to_operators'] = df['uniq_Opnd'] / (df['uniq_Op'] + 1)

# total_complexity
# Aggregate complexity calculated as v(g) + ev(g) + iv(g).
# Usefulness: Provides a single metric summarizing overall module complexity for prediction.
df['total_complexity'] = df['v(g)'] + df['ev(g)'] + df['iv(g)']

# log_effort
# Natural logarithm of effort (e).
# Usefulness: Corrects for skewness in 'effort' and emphasizes distinctions in lower ranges effectively.
df['log_effort'] = np.log1p(df['e'])

# log_volume
# Natural logarithm of volume (v).
# Usefulness: Handles the skewness of 'volume', differentiating smaller modules better.
df['log_volume'] = np.log1p(df['v'])

