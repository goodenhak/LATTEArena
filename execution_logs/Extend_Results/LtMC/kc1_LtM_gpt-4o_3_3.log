# Usefulness: Measures how complexity is distributed across the codebase. High density of complexity relative to size is a well-known indicator of defect-prone modules.
df['overall_complexity_per_loc'] = df['overall_complexity'] / (df['loc'] + 1e-5)
end

python
# difficulty_per_size
# Difficulty (d) normalized by module size (loc). (d / loc)
# Usefulness: Captures how complex a module is to understand or maintain relative to its size, identifying areas of the codebase that might be harder to manage and error-prone.
df['difficulty_per_size'] = df['d'] / (df['loc'] + 1e-5)
end

python
# loc_to_branch_ratio
# Lines of code per branch point. (loc / branchCount)
# Usefulness: High values indicate low branching density, while low values may reveal heavily branched code which is harder to test and more prone to defects.
df['loc_to_branch_ratio'] = df['loc'] / (df['branchCount'] + 1e-5)
end

python
# uniq_opnd_to_total_opnd_ratio
# Ratio of unique operands to total operands. (uniq_Opnd / total_Opnd)
