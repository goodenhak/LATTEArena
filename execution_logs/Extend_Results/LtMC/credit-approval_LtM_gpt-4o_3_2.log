2026-05-26 11:22:54,814 - INFO - ops_string = ["# prior_default_log\n# Log-transformation of PriorDefault to reduce skewness and enhance interpretability\n# Usefulness: Emphasizes distinctions among prior default status, useful for distinguishing applicants with default issues.\ndf['prior_default_log'] = np.log(df['PriorDefault'] + 1)", "# debt_income_ratio\n# Debt-to-Income Ratio: ratio of Debt to Income\n# Usefulness: Measures financial balance and spending habits, a critical factor in creditworthiness.\ndf['debt_income_ratio'] = df['Debt'] / (df['Income'] + 1)", "# credit_utilization_ratio\n# Credit Utilization Ratio: ratio of CreditScore to Debt\n# Usefulness: Provides insights into credit usage efficiency, separating those who manage credit responsibly versus not.\ndf['credit_utilization_ratio'] = df['CreditScore'] / (df['Debt'] + 1)", "# log_married_income_interaction\n# Log transformation of Married-Income Interaction\n# Usefulness: Reduces the skew of extreme values in married_income_interaction, better representing its effect.\ndf['log_married_income_interaction'] = np.log(df['married_income_interaction'] + 1)", "# married_income_prior_default_interaction\n# Multiplication of Married-Income Interaction with Prior Default\n# Usefulness: Captures important dynamics between marital status, income level, and financial reliability.\ndf['married_income_prior_default_interaction'] = df['married_income_interaction'] * df['PriorDefault']", "# credit_score_employment_stability_interaction\n# Interaction between zscore(CreditScore) and zscore(Years Employed)\n# Usefulness: Highlights creditworthiness adjusted for employment stability, an essential factor for success prediction.\ndf['credit_score_employment_stability_interaction'] = (df['credit_score_zscore'] * df['years_employed_zscore'])", "# financial_risk_by_employment\n# Interaction between Debt-Employed Interaction and years_employed_age_ratio\n# Usefulness: Examines how the combination of debt and employment stability impacts financial risk assessment.\ndf['financial_risk_by_employment'] = df['debt_employed_interaction'] * df['years_employed_age_ratio']", "# years_employed_age_quadratic\n# Quadratic transformation of Years Employed to Age Ratio\n# Usefulness: Captures nonlinear relationships between employment and age for better capturing applicant stability.\ndf['years_employed_age_quadratic'] = df['years_employed_age_ratio']  2", "# credit_employed_sigmoid\n# Sigmoid transformation of Credit Score-Employed Interaction\n# Usefulness: Smooths the extreme values in the credit_employed_interaction to better capture patterns.\ndf['credit_employed_sigmoid'] = 1 / (1 + np.exp(-df['credit_employed_interaction']))", "# married_age_square\n# Square transformation of Married-Age Interaction\n# Usefulness: Adds nonlinear dimensionality to capture potential complex effects of marital age stability.\ndf['married_age_square'] = df['married_age_interaction']  2", "# ethnicity_debt_risk\n# Interaction between debt_mean_by_ethnicity and debt_employed_interaction\n# Usefulness: Captures the relationship between demographic debt distributions and financial risks among employed individuals.\ndf['ethnicity_debt_risk'] = df['debt_mean_by_ethnicity'] * df['debt_employed_interaction']", "# industry_income_mean\n# Mean of Income by Industry\n# Usefulness: Provides contextual information about the average income within an applicant’s industry, indicating overall economic standing.\ndf = df.merge(df.groupby('Industry')['Income'].mean().reset_index().rename(columns={'Income':'industry_income_mean'}), on='Industry', how='left')", "# citizenship_income_ratio\n# Mean income aggregated by Citizenship status\n# Usefulness: Captures differences in economic status based on citizenship type, which may impact credit success.\ndf = df.merge(df.groupby('Citizen')['Income'].mean().reset_index().rename(columns={'Income':'citizenship_income_ratio'}), on='Citizen', how='left')", "# standardized_married_age_interaction\n# Z-score of married_age_interaction\n# Usefulness: Standardizes data for better comparison, helping model interpretability and convergence.\ndf['standardized_married_age_interaction'] = (df['married_age_interaction'] - df['married_age_interaction'].mean()) / df['married_age_interaction'].std()", "df.drop(columns=['married_age_interaction'], inplace=True)", "df.drop(columns=['married_income_interaction'], inplace=True)", "df.drop(columns=['credit_employed_interaction'], inplace=True)"]
