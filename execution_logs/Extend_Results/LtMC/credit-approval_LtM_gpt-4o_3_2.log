# log_debt
# Log-transformed Debt: log(Debt + 1). Reduces skewness and diminishes the effect of outliers in debt.
# Usefulness: Provides better scaling for comparing applicants with highly divergent debt levels.

df['log_debt'] = np.log(df['Debt'] + 1)
end

python
# log_income
# Log-transformed Income: log(Income + 1). Reduces the skewness of income by mitigating extreme values.
# Usefulness: Emphasizes meaningful income variations for lower values while suppressing high extremes.

df['log_income'] = np.log(df['Income'] + 1)
end

python
# debt_income_interaction_log
# Log-transformed Debt-Income Interaction: log(debt_income_ratio + 1). Captures nonlinear scaling in financial burden relative to income.
# Usefulness: Highlights applicants with large debt-to-income ratios without skew from extreme values.

df['debt_income_interaction_log'] = np.log(df['debt_income_ratio'] + 1)
end

python
# age_income_ratio
# Age-to-Income Ratio: ratio(Age, Income). Represents financial maturity relative to earning capacity.
# Usefulness: Identifies individuals with weaker financial stability due to low income relative to their age.

df['age_income_ratio'] = df['Age'] / (df['Income'] + 1)
end

python
# married_age_interaction
# Married-Age Interaction: multiply(Married, Age). Correlates applicant maturity with marital stability.
# Usefulness: Highlights the potential stability factor contributed by married applicants as they age.

df['married_age_interaction'] = df['Married'] * df['Age']
end

python
# prior_default_credit_interaction
# Prior Default-Credit Score Interaction: multiply(PriorDefault, CreditScore). Tracks applicants with defaults and their creditworthiness.
# Usefulness: Combines past negative credit behavior with current credit score for a deeper risk profile.

df['prior_default_credit_interaction'] = df['PriorDefault'] * df['CreditScore']
end

python
# creditscore_mean_by_industry
# Credit Score Mean by Industry: groupbythenmean(Industry, CreditScore). Aggregates average credit scores for each industry sector.
# Usefulness: Provides industry-specific trends in creditworthiness that can influence predictions.

df['creditscore_mean_by_industry'] = df.groupby('Industry')['CreditScore'].transform('mean')
end

python
# debt_mean_by_ethnicity
# Debt Mean by Ethnicity: groupbythenmean(Ethnicity, Debt). Captures societal or institutional trends in debt distribution.
# Usefulness: Informs potential systemic trends that may impact credit eligibility.

df['debt_mean_by_ethnicity'] = df.groupby('Ethnicity')['Debt'].transform('mean')
end

python
# compressed_income_bins
# Compressed Income Bins: bin(Income, 5 bins). Segments income into discrete levels for easier modeling of nonlinear income trends.
# Usefulness: Simplifies income disparities for models to capture patterns more effectively.

df['compressed_income_bins'] = pd.cut(df['Income'], bins=5, labels=False)
end

python
# years_employed_zscore
# Z-score of Years Employed: zscore(YearsEmployed). Standardizes years employed for easier comparison across groups.
# Usefulness: Highlights relative differences in employment duration affecting credit application success.

df['years_employed_zscore'] = (df['YearsEmployed'] - df['YearsEmployed'].mean()) / df['YearsEmployed'].std()
end

python
# target_encoded_ethnicity
# Target Encoded Ethnicity: target_encoding(Ethnicity, Success). Encodes ethnicity with the success rate of each category.
# Usefulness: Captures nuanced success trends across different ethnic groups while managing categorical data effectively.

ethnicity_success_rate = df.groupby('Ethnicity')['Success'].mean()
df['target_encoded_ethnicity'] = df['Ethnicity'].map(ethnicity_success_rate)
end

python
df.drop(columns=['citizen_encoded'], inplace=True)
end

python
df.drop(columns=['DriversLicense'], inplace=True)
end

python
df.drop(columns=['age_income_interaction'], inplace=True)
end
