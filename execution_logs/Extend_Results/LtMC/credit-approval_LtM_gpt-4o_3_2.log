# prior_default_log_debt_interaction
# Prior Default-Log Debt Interaction: multiply(PriorDefault, log_debt).
# Usefulness: Captures the combined effect of past financial instability and current debt burden, addressing financial stability concerns.

df['prior_default_log_debt_interaction'] = df['PriorDefault'] * df['log_debt']
end

python
# credit_score_married_interaction
# Credit Score-Married Interaction: multiply(CreditScore, Married).
# Usefulness: Evaluates the relationship between creditworthiness and marital stability, highlighting dual-income effects among married applicants.

df['credit_score_married_interaction'] = df['CreditScore'] * df['Married']
end

python
# age_income_interaction
# Age-Income Interaction: multiply(Age, Income).
# Usefulness: Reflects the combined maturity and financial capability of the applicant, important for credit card approval.

df['age_income_interaction'] = df['Age'] * df['Income']
end

python
# exp_prior_default
# Exponential Transformation of Prior Default: exp(PriorDefault).
# Usefulness: Enhances signal detection for individuals with prior defaults by exaggerating the feature's impact proportionally.

df['exp_prior_default'] = np.exp(df['PriorDefault'])
end

python
# sqrt_age_income_interaction
# Square Root of Age-Income Interaction: sqrt(age_income_interaction).
# Usefulness: Reduces the effect of large outliers in age-income relationships, making the feature more robust for predictive modeling.

df['sqrt_age_income_interaction'] = np.sqrt(df['age_income_interaction'])
end

python
# credit_score_mean_by_citizen
# Credit Score Mean by Citizen: groupbythenmean(Citizen, CreditScore).
# Usefulness: Highlights differences in creditworthiness across citizenship statuses, useful for demographic trends analysis.

df['credit_score_mean_by_citizen'] = df.groupby('Citizen')['CreditScore'].transform('mean')
end

python
# log_debt_mean_by_ethnicity
# Log Debt Mean by Ethnicity: groupbythenmean(Ethnicity, log_debt).
# Usefulness: Captures societal or institutional trends in debt distribution among ethnic groups.

df['log_debt_mean_by_ethnicity'] = df.groupby('Ethnicity')['log_debt'].transform('mean')
end

python
# industry_target_encoding
# Industry Target Encoding: target_encoding(Industry).
# Usefulness: Provides conditional probabilities of approval for each industry sector, adding predictive power for categorical data.

from category_encoders import TargetEncoder
encoder = TargetEncoder(cols=['Industry'])
df['industry_target_encoding'] = encoder.fit_transform(df['Industry'], df['Success'])
end

python
# ethnicity_target_encoding
# Ethnicity Target Encoding: target_encoding(Ethnicity).
# Usefulness: Represents conditional approval probabilities based on ethnicity, helping capture demographic trends.

df['ethnicity_target_encoding'] = encoder.fit_transform(df['Ethnicity'], df['Success'])
end

python
# years_employed_age_bins
# Binned Years Employed to Age Ratio: bin(years_employed_age_ratio, bins=3).
# Usefulness: Segments the ratio into categorical bins to simplify modeling nonlinear relationships between employment stability and age.

df['years_employed_age_bins'] = pd.cut(df['years_employed_age_ratio'], bins=3, labels=['Low', 'Medium', 'High'])
end

python
# drop compressed_income_bins
