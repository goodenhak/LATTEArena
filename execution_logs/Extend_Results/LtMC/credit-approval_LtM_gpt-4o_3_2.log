# debt_income_ratio
# Debt-to-Income Ratio: ratio(Debt, Income). Measures financial burden relative to income, useful for creditworthiness assessment.
# Usefulness: Indicates how proportionate debt is to income, as higher ratios may correlate with lower application success.

df['debt_income_ratio'] = df['Debt'] / (df['Income'] + 1)
end

python
# debt_squared
# Debt Squared: square(Debt). Penalizes individuals with disproportionately high debt levels.
# Usefulness: Helps in highlighting extreme financial risk as higher debts could indicate instability.

df['debt_squared'] = df['Debt']  2
end

python
# credit_score_log
# Log-transformed Credit Score: log(CreditScore + 1). Reduces impact of outliers in credit score distribution.
# Usefulness: Allows better modeling of creditworthiness while handling disproportionately high scores.

df['credit_score_log'] = np.log(df['CreditScore'] + 1)
end

python
# years_employed_age_ratio
# Years Employed to Age Ratio: ratio(YearsEmployed, Age). Assesses stability of employment relative to applicant age.
# Usefulness: Higher ratios could imply consistent employment history, positively impacting success rates.

df['years_employed_age_ratio'] = df['YearsEmployed'] / df['Age']
end

python
# income_sigmoid
# Sigmoid Transformation of Income: sigmoid(Income). Captures diminishing returns for very high incomes.
# Usefulness: Provides a nuanced representation of income contribution to financial stability.

df['income_sigmoid'] = 1 / (1 + np.exp(-df['Income']))
end

python
# credit_score_zscore
# Credit Score Z-Score: zscore(CreditScore). Standardizes credit score data for better comparison.
# Usefulness: Enables direct and fair comparison of credit scores regardless of absolute values.

df['credit_score_zscore'] = (df['CreditScore'] - df['CreditScore'].mean()) / df['CreditScore'].std()
end

python
# age_income_interaction
# Age-Income Interaction: multiply(Age, Income). Combines age and income for holistic financial stability assessment.
# Usefulness: Older individuals with higher income might be more credible applicants.

df['age_income_interaction'] = df['Age'] * df['Income']
end

python
# married_income_interaction
# Married-Income Interaction: multiply(Married, Income). Evaluates impact of marital status with income on success rate.
# Usefulness: Married applicants with income may showcase shared financial responsibility.

df['married_income_interaction'] = df['Married'] * df['Income']
end

python
# credit_employed_interaction
# Credit Score-Employed Interaction: multiply(CreditScore, Employed). Highlights employed individuals with good credit scores.
# Usefulness: Credit reliability paired with current employment status is a strong success predictor.

df['credit_employed_interaction'] = df['CreditScore'] * df['Employed']
end

python
# debt_employed_interaction
# Debt-Employed Interaction: multiply(Debt, Employed). Assesses financial risk among employed individuals.
# Usefulness: Conveys debt implications for those with employment; higher interaction values may have negative correlation.

df['debt_employed_interaction'] = df['Debt'] * df['Employed']
end

python
# citizen_success_rate
# Grouped Citizen Aggregations: groupbythenmean(Citizen). Maps average success rate for each citizenship type.
# Usefulness: Encodes citizenship status impact on application success rates.

citizen_mean_success = df.groupby('Citizen')['Answer'].mean()
df['citizen_success_rate'] = df['Citizen'].map(citizen_mean_success)
end

python
# industry_variability
# Industry Success Variability: groupbythenstd(Industry). Standard deviation of success rate by industry type.
# Usefulness: Evaluates variability in success rates among industries, aiding in industry impact analysis.

industry_std_success = df.groupby('Industry')['Answer'].std()
df['industry_variability'] = df['Industry'].map(industry_std_success)
end

python
# industry_encoded
# Industry Target Encoding: target_encoding(Industry). Maps industries to their historical success rates.
# Usefulness: Captures historical industry-specific outcomes to aid prediction.

industry_mean_success = df.groupby('Industry')['Answer'].mean()
df['industry_encoded'] = df['Industry'].map(industry_mean_success)
end

python
# citizen_encoded
# Citizen Label Encoding: label_encode(Citizen). Converts categorical citizenship feature into numerical representation.
# Usefulness: Facilitates numerical operations, enabling models to process categorical citizenship data effectively.

citizen_labels = {'ByBirth': 0, 'ByOtherMeans': 1, 'Temporary': 2}
df['citizen_encoded'] = df['Citizen'].map(citizen_labels)
end

python
df.drop(columns=['ZipCode'], inplace=True)
end
