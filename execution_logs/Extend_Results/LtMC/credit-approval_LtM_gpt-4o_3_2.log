n# Usefulness: Captures societal or institutional trends in debt distribution among ethnic groups.\n\ndf['log_debt_mean_by_ethnicity'] = df.groupby('Ethnicity')['log_debt'].transform('mean')", "# industry_target_encoding\n# Industry Target Encoding: target_encoding(Industry).\n# Usefulness: Provides conditional probabilities of approval for each industry sector, adding predictive power for categorical data.\n\nfrom category_encoders import TargetEncoder\nencoder = TargetEncoder(cols=['Industry'])\ndf['industry_target_encoding'] = encoder.fit_transform(df['Industry'], df['Success'])", "# ethnicity_target_encoding\n# Ethnicity Target Encoding: target_encoding(Ethnicity).\n# Usefulness: Represents conditional approval probabilities based on ethnicity, helping capture demographic trends.\n\ndf['ethnicity_target_encoding'] = encoder.fit_transform(df['Ethnicity'], df['Success'])", "# years_employed_age_bins\n# Binned Years Employed to Age Ratio: bin(years_employed_age_ratio, bins=3).\n# Usefulness: Segments the ratio into categorical bins to simplify modeling nonlinear relationships between employment stability and age.\n\ndf['years_employed_age_bins'] = pd.cut(df['years_employed_age_ratio'], bins=3, labels=['Low', 'Medium', 'High'])", "# drop compressed_income_bins\n# Compressed Income Bins column is dropped as it provides limited unique information and overlaps with other income-based features.\n\ndf.drop(columns=['compressed_income_bins'], inplace=True)"]
