2026-05-26 11:22:00,733 - INFO - ops_string = ["# income_log\n# Log-transformed Income: log(Income + 1). Reduces impact of outliers in income distribution.\n# Usefulness: Since Income is highly skewed, this transformation reduces noise from extreme values, enhancing model stability.\ndf['income_log'] = np.log(df['Income'] + 1)", "# income_age_ratio\n# Income-to-Age Ratio: Income divided by Age. Normalizes the income by the applicant's age.\n# Usefulness: This helps gauge earning potential relative to life stage, offering insight into financial maturity.\ndf['income_age_ratio'] = df['Income'] / df['Age']", "# financial_surplus\n# Financial Surplus: Income minus Debt. Provides a measure of the financial buffer or surplus an applicant has.\n# Usefulness: Highlights financial security by showing whether the applicant earns more than they owe.\ndf['financial_surplus'] = df['Income'] - df['Debt']", "# financial_stress_index\n# Financial Stress Index: Debt multiplied by Debt-to-Income Ratio. Quantifies the strain of debt burdens.\n# Usefulness: Allows assessment of applicants under significant financial stress due to high debt levels compared to income.\ndf['financial_stress_index'] = df['Debt'] * df['debt_income_ratio']", "# credit_age_ratio\n# CreditScore-to-Age Ratio: CreditScore divided by Age. Reflects creditworthiness relative to the applicant's maturity.\n# Usefulness: Provides a normalized view of credit score for individuals across various age groups.\ndf['credit_age_ratio'] = df['CreditScore'] / df['Age']", "# employment_financial_score\n# Employment-Financial Score: Product of Employment Status and Years Employed. Emphasizes stability of income sources.\n# Usefulness: Captures both employment duration and current employment status to better measure economic stability.\ndf['employment_financial_score'] = df['Employed'] * df['YearsEmployed']", "# income_ethnicity_interaction\n# Income-Ethnicity Interaction: Cross of Income and Ethnicity through one-hot encoding and multiplication.\n# Usefulness: Identifies income disparities or unique patterns across ethnic groups to capture socio-economic variances.\nincome_ethnicity_dummies = pd.get_dummies(df['Ethnicity'], prefix='Ethnicity')\nfor col in income_ethnicity_dummies.columns:\n    df[f'income_{col}_interaction'] = df['Income'] * income_ethnicity_dummies[col]", "# debt_married_interaction\n# Debt-Married Interaction: Product of Debt and Marital status. Evaluates financial burden among married individuals.\n# Usefulness: Examines potential financial trade-offs that married individuals may face.\ndf['debt_married_interaction'] = df['Debt'] * df['Married']", "# industry_citizen_cross\n# Industry-Citizen Cross: Cross feature combining Industry and Citizen fields into unique categorical values.\n# Usefulness: Captures nuanced and domain-specific insights from the relationship between industry and citizenship.\ndf['industry_citizen_cross'] = df['Industry'] + _ + df['Citizen']", "# income_percentile_rank\n# Income Percentile Rank: Percentile rank of Income within the dataset.\n# Usefulness: Provides context about where an applicant's income stands relative to others, useful for comparisons.\ndf['income_percentile_rank'] = df['Income'].rank(pct=True)", "# debt_to_employment_ratio\n# Debt-to-Employment Ratio: Ratio of Debt to Years Employed. Measures financial burden relative to employment duration.\n# Usefulness: Evaluates debt repayment potential accounting for employment history.\ndf['debt_to_employment_ratio'] = df['Debt'] / (df['YearsEmployed'] + 1e-5) # adding small value to avoid division by zero", "# target_encoding_industry\n# Target Encoding of Industry: Replaces Industry categories with mean success rates.\n# Usefulness: Encodes categorical information using target variable relationships, capturing success rate variations by industry.\nindustry_success_means = df.groupby('Industry')['Target'].mean()\ndf['industry_target_enc'] = df['Industry'].map(industry_success_means)", "# target_encoding_ethnicity\n# Target Encoding of Ethnicity: Replaces Ethnicity with mean success rates for each category.\n# Usefulness: Encodes influence of ethnicity on success, integrating demographic-predicted trends directly into the model.\nethnicity_success_means = df.groupby('Ethnicity')['Target'].mean()\ndf['ethnicity_target_enc'] = df['Ethnicity'].map(ethnicity_success_means)", "# income_rolling_mean\n# Income Rolling Mean: Rolling average of Income over a window of 3 previous rows.\n# Usefulness: Smoothens fluctuations in income and helps identify trends in financial earnings.\ndf['income_rolling_mean'] = df['Income'].rolling(window=3).mean()", "# Drop unnecessary columns with negligible contribution\ndf.drop(columns=['Industry', 'Ethnicity', 'credit_employed_interaction', 'debt_employed_interaction', 'citizen_encoded'], inplace=True)"]
