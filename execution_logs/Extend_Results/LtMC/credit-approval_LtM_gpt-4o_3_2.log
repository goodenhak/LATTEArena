# log_income
# Log-transformed Income: log(Income + 1). Reduces skew and effect of extreme high incomes, making the Income feature more stable and comparable.
# Usefulness: Income is a key determinant of creditworthiness. Transforming high-skew data improves feature robustness and model performance.
df['log_income'] = np.log(df['Income'] + 1)
end

python
# income_debt_ratio
# Income-Debt Ratio: ratio(Income, Debt + 1). Evaluates financial balance relative to income.
# Usefulness: Higher ratios suggest better financial health, which is predictive of credit behavior.
df['income_debt_ratio'] = df['Income'] / (df['Debt'] + 1)
end

python
# married_log_income_interaction
# Married-Log-Income Interaction: multiply(Married, log_income). Couples financial capacity and social stability for better predictive power.
# Usefulness: Capturing income stability in tandem with marital status highlights applicants likely to succeed financially in their application.
df['married_log_income_interaction'] = df['Married'] * df['log_income']
end

python
# prior_default_income_ratio
# Prior Default-Income Ratio: ratio(PriorDefault, Income + 1). Evaluates risk behavior relative to income.
# Usefulness: Applicants with prior defaults but higher income may still pose risks but be financially capable of recovery, which models should factor in.
df['prior_default_income_ratio'] = df['PriorDefault'] / (df['Income'] + 1)
end

python
# credit_score_age_interaction
# Credit Score-Age Interaction: multiply(CreditScore, Age). Highlights seasoned individuals with strong credit profiles.
# Usefulness: This interaction balances maturity (age) with creditworthiness, surfacing patterns unique to financially responsible applicants.
df['credit_score_age_interaction'] = df['CreditScore'] * df['Age']
end

python
# log_years_employed
# Log-Years-Employed: log(YearsEmployed + 1). Reduces skewness and highlights steady employment history.
# Usefulness: Employment longevity is a core indicator of stability. Log transformation reduces disproportionate influences of outliers.
df['log_years_employed'] = np.log(df['YearsEmployed'] + 1)
end

python
# married_employment_stability
# Married-Employment-Stability: multiply(Married, years_employed_age_ratio). Couples social and employment stability for richer insights.
# Usefulness: Applicants with both stable jobs and marital status signal responsibility, improving the understanding of success factors.
df['married_employment_stability'] = df['Married'] * df['years_employed_age_ratio']
end

python
# citizen_target_encoding
# Citizen Target Encoding: Target-Encoding for Citizenship. Encodes probabilities of application success by citizenship status.
# Usefulness: Captures underlying variations in credit card approval rates across different citizenship groups directly tied to success trends.
citizen_target_map = df.groupby('Citizen')['Success'].mean()
df['citizen_target_encoding'] = df['Citizen'].map(citizen_target_map)
end

python
# ethnic_debt_zscore
# Ethnicity-Debt Z-Score: groupbythenzscore(Ethnicity, Debt). Standardizes debt by regional ethnicity variation.
# Usefulness: This feature normalizes debt relative to ethnicity-driven systemic trends, presenting unbiased indicators of financial behavior.
df['ethnic_debt_zscore'] = df.groupby('Ethnicity')['Debt'].transform(lambda x: (x - x.mean()) / x.std())
end

python
# drop compressed_income_bins
# Compressed income bins discarded due to limited representation of the nuanced income distribution covered more effectively by log_income.
df.drop(columns=['compressed_income_bins'], inplace=True)
end

python
# drop years_employed_zscore
# Years employed z-score discarded because log_years_employed provides a similar standardized feature while reducing skew effectively.
df.drop(columns=['years_employed_zscore'], inplace=True)
end
