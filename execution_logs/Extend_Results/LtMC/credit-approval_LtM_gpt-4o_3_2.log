# debt_income_weighted
# Weighted Debt-to-Income: debt_income_ratio * income_sigmoid. Combines debt-to-income ratio with diminishing returns of income for nuanced stability assessment.
# Usefulness: Helps evaluate financial burden while considering realistic income thresholds, capturing potential creditworthiness effectively.

df['debt_income_weighted'] = df['debt_income_ratio'] * df['income_sigmoid']
end

python
# debt_savings_ratio
# Debt-to-Savings Ratio: Debt divided by estimated savings (Income - Debt where Income > Debt). Highlights financial safety net and the applicant's ability to handle financial stress.
# Usefulness: Provides insight into the applicant's savings buffer and ability to repay debt, crucial for credit card approval.

df['estimated_savings'] = df['Income'] - df['Debt']
df['debt_savings_ratio'] = df['Debt'] / df['estimated_savings'].replace(0, np.nan).mask(df['Income'] <= df['Debt'])
end

python
# income_per_year
# Annualized Income: Income divided by YearsEmployed (using max(YearsEmployed, 1) to handle zeroes). Proxies income growth and financial stability over time.
# Usefulness: Differentiates applicants with comparable incomes by their employment duration to evaluate income reliability and growth.

df['income_per_year'] = df['Income'] / df['YearsEmployed'].replace(0, 1)
end

python
# credit_employed_interaction_normalized
# Normalized Credit Score-Employed Interaction: credit_employed_interaction divided by CreditScore range. Highlights credit-to-employment strength while removing scale dependence.
# Usefulness: Represents comparative credit reliability of employed individuals relative to employment-amplified credit standing.

credit_range = df['CreditScore'].max() - df['CreditScore'].min()
df['credit_employed_interaction_normalized'] = df['credit_employed_interaction'] / credit_range
end

python
# employment_stability_score
# Employment Stability Score: A ratio derived as years_employed_age_ratio * income_sigmoid to assess employment stability with age and income scaling.
# Usefulness: Combines employment history relative to age with sigmoid-transformed income for a holistic stability evaluation.

df['employment_stability_score'] = df['years_employed_age_ratio'] * df['income_sigmoid']
end

