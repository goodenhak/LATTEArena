# sqrt_log_debt
# Square-root-transformed Log Debt: sqrt(log_debt). Further normalizes debt distribution while mitigating skewness.
# Usefulness: Helps detect manageable levels of debt and moderates the impact of extreme outliers for interpretability.
df['sqrt_log_debt'] = df['log_debt'].apply(np.sqrt)
end

python
# sigmoid_prior_default_credit_interaction
# Sigmoid-transformed Prior Default-Credit Interaction: sigmoid(prior_default_credit_interaction). Compresses interaction values into a predictable 0–1 range.
# Usefulness: Highlights mid-range impact of prior defaults and credit scores without over-emphasizing extremes.
df['sigmoid_prior_default_credit_interaction'] = df['prior_default_credit_interaction'].apply(lambda x: 1 / (1 + np.exp(-x)))
end

python
# debt_ethnicity_interaction
# Debt-Ethnicity Interaction: multiply(debt_mean_by_ethnicity, log_debt). Links individual debt levels to debt trends across ethnic groups.
# Usefulness: Uncovers systemic trends or disparities in debt distribution that may affect credit decisions.
df['debt_ethnicity_interaction'] = df['debt_mean_by_ethnicity'] * df['log_debt']
end

python
# marital_stability_interaction
# Marital Stability Interaction: multiply(married_income_interaction, married_age_interaction). Combines income and marital age factors to assess stability.
# Usefulness: Captures holistic indicators of marital and financial stability, important for creditworthiness.
df['marital_stability_interaction'] = df['married_income_interaction'] * df['married_age_interaction']
end

python
# industry_debt_mean
# Industry Debt Mean: groupbythenmean(Industry, log_debt). Calculates average log-transformed debt for each industry category.
# Usefulness: Highlights industry-specific economic behaviors relevant to financial stability.
df['industry_debt_mean'] = df.groupby('Industry')['log_debt'].transform('mean')
end

python
# ethnicity_credit_variability
# Credit Variability by Ethnicity: groupbythenstd(Ethnicity, credit_score_zscore). Measures variability in credit scores across ethnicity groups.
# Usefulness: Identifies disparities in credit scoring standards, improving fairness in the model.
df['ethnicity_credit_variability'] = df.groupby('Ethnicity')['credit_score_zscore'].transform('std')
end

python
# citizen_target_encoding
# Target Encoded Citizenship: target_encoding(Citizen). Encodes average success rates for each citizenship category.
# Usefulness: Helps capture the influence of citizenship status on credit application outcomes.
citizen_target_mean = df.groupby('Citizen')['success'].mean()
df['citizen_target_encoding'] = df['Citizen'].map(citizen_target_mean)
end

python
# credit_employment_ratio
# Credit-Employment Ratio: divide(credit_score_zscore, years_employed_zscore). Relates credit scores to standardized employment tenure.
# Usefulness: Highlights employment instability in relation to creditworthiness.
df['credit_employment_ratio'] = df['credit_score_zscore'] / (df['years_employed_zscore'] + 1e-10)  # Adding epsilon to avoid division by zero
end

python
# zscored_marital_income
# Z-Scored Marital Income Interaction: zscore(married_income_interaction). Standardizes marital income data for fair comparisons.
# Usefulness: Simplifies comparisons of marital income impact on credit applications across all applicants.
df['zscored_marital_income'] = (df['married_income_interaction'] - df['married_income_interaction'].mean()) / df['married_income_interaction'].std()
end

python
# Drop less relevant columns
df.drop(columns=['compressed_income_bins', 'Gender'], inplace=True)
end
