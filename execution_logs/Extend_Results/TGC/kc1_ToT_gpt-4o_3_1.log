# Step 2: Feature 2: halstead_volume_per_complexity
# Ratio of Halstead 'volume' to McCabe 'cyclomatic complexity'
df['halstead_volume_per_complexity'] = df['v'] / (df['v(g)'] + 1)
# Usefulness: Measures the amount of information content (volume) relative to the code complexity (cyclomatic complexity). Modules with high volume and low complexity might indicate discrepancies and possibly reduced defect risk.

# Step 3: Feature 3: normalized_effort_by_length
