# Feature: defect_risk_score
# Feature description: Composite score combining cyclomatic complexity (v(g)), essential complexity (ev(g)), and design complexity (iv(g)), weighted equally: (v(g) + ev(g) + iv(g)) / 3.
# Usefulness: This aggregated measure captures various aspects of McCabe's complexity metrics, helping better estimate the risk of defects in modules with combined high cyclomatic, essential, and design complexity.
df['defect_risk_score'] = (df['v(g)'] + df['ev(g)'] + df['iv(g)']) / 3
end

python
# Feature: halstead_log_ratio
# Feature description: Log-transformed Halstead effort (log_e) divided by log-transformed Halstead volume (log_v): log_e / (log_v + 1e-5).
# Usefulness: This ratio helps normalize effort by volume, capturing cases where effort is disproportionately high/low compared to the actual programming volume, which may signal poor design or defect-prone modules.
df['halstead_log_ratio'] = df['log_e'] / (df['log_v'] + 1e-5)
end

