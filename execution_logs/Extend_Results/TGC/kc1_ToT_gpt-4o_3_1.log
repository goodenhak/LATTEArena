# Step 1: Create interaction features between loc (lines of code) and complexity metrics (v(g), ev(g), iv(g))
# Feature 1: loc_vg_interaction = loc * v(g)
# Feature 2: loc_evg_interaction = loc * ev(g)
# Feature 3: loc_ivg_interaction = loc * iv(g)
# Usefulness: High code complexity coupled with large code size (loc) can be strongly correlated with higher likelihood of defects. These interaction terms can capture such combined effects that may be missed by individual metrics alone.

df['loc_vg_interaction'] = df['loc'] * df['v(g)']
df['loc_evg_interaction'] = df['loc'] * df['ev(g)']
df['loc_ivg_interaction'] = df['loc'] * df['iv(g)']
end

python
# Step 2: Log-transform skewed features for better handling of outliers
# Log-transformed e (Halstead effort), v (Halstead volume), n (total operators + operands), and branchCount.
# Transformed features: log_e, log_v, log_n, log_branchCount
# Usefulness: Many features such as e, v and branchCount have large ranges and are highly skewed. Log transformations help to normalize the distribution, reduce the effect of extreme values, and improve model robustness.

df['log_e'] = np.log1p(df['e'])
df['log_v'] = np.log1p(df['v'])
df['log_n'] = np.log1p(df['n'])
df['log_branchCount'] = np.log1p(df['branchCount'])
end

python
# Step 3: Add code density metrics by producing ratios
# Feature 1: comment_density = lOComment / (loc + 1)
# Feature 2: blank_line_density = lOBlank / (loc + 1)
# Feature 3: code_and_comment_ratio = locCodeAndComment / (lOCode + lOComment + 1)
# Usefulness: Codebase density metrics provide an indicator of code quality, e.g., insufficient comments or excessive blank lines may correlate with more defects. Ratios normalize these counts relative to the size of code (loc).

df['comment_density'] = df['lOComment'] / (df['loc'] + 1)
df['blank_line_density'] = df['lOBlank'] / (df['loc'] + 1)
df['code_and_comment_ratio'] = df['locCodeAndComment'] / (df['lOCode'] + df['lOComment'] + 1)
end

python
