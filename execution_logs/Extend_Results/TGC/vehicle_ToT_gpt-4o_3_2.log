python
# radius_aspect_ratio
# This feature captures the ratio between the RADIUS_RATIO and PR.AXIS_ASPECT_RATIO.
# Usefulness: Helps encode shapes with pronounced radius variation relative to their axis aspect ratio. This might help differentiate vehicles with more eccentric shapes (e.g., SAAB vs. VAN).
df['radius_aspect_ratio'] = df['RADIUS_RATIO'] / df['PR.AXIS_ASPECT_RATIO']

# circumference_to_area_ratio
# This feature calculates the ratio of COMPACTNESS to CIRCULARITY, representing how efficiently the boundary encapsulates the area of the silhouette.
# Usefulness: As vehicles vary in edge compactness versus area (e.g., VANs would have squarer shapes, buses more rectangular), this emphasizes shape properties.
df['circumference_to_area_ratio'] = df['COMPACTNESS'] / df['CIRCULARITY']

# variance_ratio
# This feature creates a ratio of SCALED_VARIANCE_ALONG_MAJOR_AXIS to SCALED_VARIANCE_ALONG_MINOR_AXIS.
# Usefulness: Indicates how much the shape deviates along the major vs. minor axes, capturing elongatedness or skewness useful to distinguish between stretched or compact vehicles.
df['variance_ratio'] = df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] / df['SCALED_VARIANCE_ALONG_MINOR_AXIS']
end

