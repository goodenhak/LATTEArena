python
# log_transform_credit_amount
# Feature description: Apply logarithmic transformation to credit_amount to reduce the impact of extreme credit values and normalize the distribution.
# Usefulness: The original distribution of credit_amount seems highly skewed with large outliers. Log transformation often improves model stability and is particularly effective in handling skewness in numerical features.
df['log_credit_amount'] = df['credit_amount'].apply(lambda x: np.log1p(x))
end

---

python
# time_stability_score
# Feature description: Calculate a weighted stability score using employment_encoded, housing (label encoded), and duration. Formula: employment_encoded * label_encoded_housing / sqrt(duration).
# Usefulness: This feature would quantify the overall stability of the borrower based on employment duration, housing situation, and the loan duration. Borrowers with stable jobs and owned housing are generally more creditworthy.
df['label_encoded_housing'] = df['housing'].map({'rent': 0, 'own': 1, 'for free': 0.5}).fillna(0)
df['time_stability_score'] = df['employment_encoded'] * df['label_encoded_housing'] / np.sqrt(df['duration'])
end

