bins = [df['installment_commitment'].min(), df['installment_commitment'].quantile(0.25), df['installment_commitment'].quantile(0.75), df['installment_commitment'].max()]
labels = ['low', 'medium', 'high']
df['installment_commitment_category'] = pd.cut(df['installment_commitment'], bins=bins, labels=labels)
end

