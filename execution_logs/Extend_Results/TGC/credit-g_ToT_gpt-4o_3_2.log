# Feature name: interaction_checking_employment
# Feature description: This feature creates an interaction term between checking_status (label-encoded) and employment (label-encoded). Since checking_status represents the customer's financial liquidity and employment provides stability information, their interaction can give critical insight into the customer's creditworthiness (e.g., customers with low checking account balances but stable employment could be treated differently than those with unstable employment).
# Usefulness: Combines liquidity and employment stability as a joint feature, which can help downstream models discern risk patterns more effectively. Interaction features often help capture non-linear relationships that individual features may miss.

from sklearn.preprocessing import LabelEncoder
le = LabelEncoder()

df['checking_status_encoded'] = le.fit_transform(df['checking_status'])
df['employment_encoded'] = le.fit_transform(df['employment'])
df['interaction_checking_employment'] = df['checking_status_encoded'] * df['employment_encoded']
end

python
# Feature name: log_credit_to_income_ratio
# Feature description: Transform credit_to_income_ratio using a logarithmic scale. This helps control for the heavy-tailed nature of the feature (as seen in the large range and high standard deviation) by dampening the effect of extreme values.
# Usefulness: Reduces the impact of outliers in credit_to_income_ratio while preserving meaningful differences between values. This often improves model performance for skewed features.

df['log_credit_to_income_ratio'] = df['credit_to_income_ratio'].apply(lambda x: np.log(x + 1))  # Adding 1 to avoid log(0).
end

python
# Feature name: duration_savings_ratio
# Feature description: Calculate the ratio of duration to the label-encoded version of savings_status. This feature captures how long the credit is intended to last relative to the customer's reported savings, which indicates creditworthiness and repayment capacity over time.
# Usefulness: Combines credit term duration with savings details to better understand a customer’s ability to sustain financial obligations for the duration of the loan.

df['savings_status_encoded'] = le.fit_transform(df['savings_status'])
