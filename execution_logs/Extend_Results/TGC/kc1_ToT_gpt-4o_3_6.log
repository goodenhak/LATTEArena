# Step 1: Interaction feature 1 - loc_with_vg_ratio
# Feature description: Ratio of lines of code (loc) to cyclomatic complexity (v(g)). This captures the balance between code size and logical complexity.
# Usefulness: Modules with high lines of code relative to complexity may have repetitive or poorly modularized code, which could be associated with defects.
df['loc_with_vg_ratio'] = df['loc'] / (df['v(g)'] + 1)  # Add 1 to avoid division by zero.
end

python
# Step 2: Transform feature 1 - log_effort
# Feature description: Log-transformed version of Halstead's effort metric (e). The log transformation reduces the impact of extreme outliers.
# Usefulness: Effort values are highly skewed with extreme upper ranges. Log transformation normalizes the distribution, making it easier for models to learn relationships.
df['log_effort'] = np.log1p(df['e'])  # Apply log(1 + x) transformation to preserve zero values.
end

python
# Step 3: Composite feature 1 - complexity_density
# Feature description: Combines defect_density and cyclomatic complexity (v(g)) to represent how defects are distributed relative to logical complexity.
# Usefulness: Modules with higher complexity and accompanying defect density likely indicate fragile or error-prone regions.
df['complexity_density'] = df['defect_density'] * df['v(g)']
end

python
# Dropping an irrelevant column
# Explanation why the column branchCount is dropped
# The branchCount feature overlaps conceptually with v(g) (cyclomatic complexity), and evaluating them both may introduce redundancy into the model, reducing its generalization capacity.
df.drop(columns=['branchCount'], inplace=True)
end

python
# Normalizing important features within specified ranges
# Normalizing the Halstead metrics v, d, and i to prevent any single variable from having disproportionate influence.
# Normalization ensures that models treat all inputs with fair weighting.
df[['v', 'd', 'i']] = (df[['v', 'd', 'i']] - df[['v', 'd', 'i']].min()) / (df[['v', 'd', 'i']].max() - df[['v', 'd', 'i']].min())
end

python
# Creating binned categorical columns based on loc
# Feature description: Generate bins for lines of code (loc) to classify modules into low, medium, or high code lengths.
# Usefulness: Dividing loc into categories captures coarse-grain structural differences without overfitting to exact values.
df['loc_binned'] = pd.cut(df['loc'], bins=[0, 10, 50, df['loc'].max()], labels=['small', 'medium', 'large'])
end
