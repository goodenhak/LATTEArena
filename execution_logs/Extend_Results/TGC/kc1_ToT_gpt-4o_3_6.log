python
# Step 2: Log transformation for skewed features
# Feature name: log_v, log_e
# Feature description: Log-transformed v (Halstead Volume), e (Halstead Effort) to reduce the effect of outliers and make the features more normally distributed.
# Usefulness: Variables like v and e exhibit excessive skewness, which can adversely impact the performance of algorithms, especially distance-based or gradient-based ones. Applying logarithmic transformations can help stabilize variance and improve model stability.

df['log_v'] = df['v'].apply(lambda x: np.log(x + 1))  # Add 1 to avoid log(0)
df['log_e'] = df['e'].apply(lambda x: np.log(x + 1))
end

