# Usefulness: This ratio reflects the spatial distribution of mass relative to elongation. For example, a VAN could have higher elongation but more evenly distributed mass compared to a BUS, aiding in the vehicle type classification.

df['SCATTER_ELONG_RATIO'] = df['SCATTER_RATIO'] / (df['ELONGATEDNESS'] + 1e-8)  # Add small constant to avoid division by zero
