# zscore_O_C_ratio
# Z-score normalization of 'O_C_ratio' (ratio of oxygen to carbon).
# Usefulness: The 'O_C_ratio' feature covers a massive range ([0.0, 12,000,000.0]) which can overwhelm models and lead to numerical instability. Normalizing it makes it more comparable to other features.
df['zscore_O_C_ratio'] = (df['O_C_ratio'] - df['O_C_ratio'].mean()) / df['O_C_ratio'].std()
end

