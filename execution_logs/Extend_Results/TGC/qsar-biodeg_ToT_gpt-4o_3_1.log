# 1. log_O_C_ratio
# Taking the logarithm of O_C_ratio to reduce skewness and make variance more comparable across data.
# Usefulness: O_C_ratio has an extremely large range ([0.0, 12,000,000.0]) and a highly skewed distribution. Applying a logarithm transformation stabilizes variance and compresses large numbers, potentially making the feature more predictive for the downstream classification model.
df['log_O_C_ratio'] = df['O_C_ratio'].apply(lambda x: np.log1p(x))  # Use log1p to handle zero values gracefully.
end

python
# 2. Ratio_nO_nCp
# Computation of the ratio of the number of oxygen atoms (nO) to the number of terminal primary C(sp3) (nCp).
# Usefulness: The biodegradability of a chemical compound may depend on the balance of oxygen to carbon atoms, as oxygen-rich compounds might more readily break down (e.g., through oxidation). This feature could capture meaningful insights about chemical structure relevant to the classification.
df['Ratio_nO_nCp'] = df.apply(lambda row: row['nO'] / (row['nCp'] + 1e-8), axis=1)  # Adding epsilon to avoid division by zero.
end

python
# 3. Interaction_Biodegradability_Strength_Log_F03C_O
# Interaction term between the Biodegradability_strength and log_F03[C-O] features.
# Usefulness: Biodegradability_strength reflects chemical decomposition tendencies, and log_F03[C-O] characterizes the frequency of specific structural motifs. The interaction could highlight critical relationships between chemical structure and biodegradable potential.
df['Interaction_Biodegradability_Strength_Log_F03C_O'] = df['Biodegradability_strength'] * df['log_F03[C-O]']
end

python
# Explanation why the column O_C_ratio is dropped
# O_C_ratio has been heavily transformed (via log_O_C_ratio), which addresses its skewness. The raw feature can be dropped to avoid redundancy and reduce noise or overfitting.
df.drop(columns=['O_C_ratio'], inplace=True)
end

python
