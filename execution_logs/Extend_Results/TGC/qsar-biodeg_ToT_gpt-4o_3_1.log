# F03[C-O] has been transformed into log_F03[C-O] to reduce skewness, and its interaction is leveraged in a new feature. The original raw feature is no longer necessary and may be redundant.
df.drop(columns=['F03[C-O]'], inplace=True)
end

python
# Explanation why the column nCp is dropped
# nCp has been incorporated into the new Ratio_nO_nCp feature, making it redundant. By dropping it, we simplify the dataset while retaining the critical interaction between nO and nCp.
df.drop(columns=['nCp'], inplace=True)
end
