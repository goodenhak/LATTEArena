# Step 1: Interaction features between cyclomatic and design complexity
# Feature name: cyclomatic_design_interaction
# Feature description:
# This feature computes the product of cyclomatic complexity (v(g)) and design complexity (iv(g)).
# Usefulness:
# Interaction terms often capture underlying nonlinearities and relationships that are not apparent 
# in additive models. With this, we can check if modules with a high interplay between cyclomatic 
# and design complexities correlate with increased defects.
df['cyclomatic_design_interaction'] = df['v(g)'] * df['iv(g)']
end

python
# Step 2: Aggregating Halstead Metrics into a Complexity Indicator
# Feature name: halstead_complexity_index
# Feature description:
# Creates a single metric based on Halstead features such as difficulty (d), effort (e), and volume (v),
# combining them using a weighted sum. For simplicity, assume an equal weight for all (can be tuned).
# Usefulness:
# While each metric individually matters, aggregating them would capture the composite effect 
# of these different dimensions of cognitive complexity for measuring defect likelihood.
df['halstead_complexity_index'] = (df['v'] + df['d'] + df['e']) / 3
end

python
# Step 3: Normalizing and Rescaling Interaction of Lines of Code with Cyclomatic Complexity
# Feature name: normalized_loc_cyclomatic_interaction
# Feature description:
# Calculating the ratio of lines of code (loc) to cyclomatic complexity (v(g)), then normalizing it.
# This feature captures the relative density of code logic for modules, normalized for fair comparison.
# Usefulness:
# Such ratios can highlight modules where code is overly dense, which could indicate a higher potential 
# for defects or maintenance challenges.
df['normalized_loc_cyclomatic_interaction'] = (df['loc'] / df['v(g)']).fillna(0)
df['normalized_loc_cyclomatic_interaction'] = (df['normalized_loc_cyclomatic_interaction'] - 
                                                df['normalized_loc_cyclomatic_interaction'].mean()) / \
                                               df['normalized_loc_cyclomatic_interaction'].std()
end

