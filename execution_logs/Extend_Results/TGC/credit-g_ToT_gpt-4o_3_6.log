# 1. credit_to_duration_ratio
# Feature description: Creates a new feature by calculating the ratio of credit_amount to duration, indicating the average credit risk per month.
# Usefulness: This feature combines two important variables—credit_amount and duration—providing an intuitive measure of the intensity of credit usage per unit of time 
# and giving insight into repayment ability. Higher ratios may indicate higher credit risk.

df['credit_to_duration_ratio'] = df['credit_amount'] / df['duration']
end

python
# 2. savings_status_encoded
# Feature description: Performs label encoding of the savings_status column to assign numerical values to the ordinal categories.
# Usefulness: The savings_status column has ordinal relationships (>=1000 > 500<=X<1000 > 100<=X<500 > <100 > no known savings) that 
# aren't fully captured in the raw categorical format. Encoding this in a numerical format preserves the ordinal property 
# and allows the model to better utilize this information.

from sklearn.preprocessing import LabelEncoder
savings_label_encoder = LabelEncoder()
df['savings_status_encoded'] = savings_label_encoder.fit_transform(df['savings_status'])
end

python
# 3. employment_duration_years_transformed (Square root of employment years)
# Feature description: Applies the square root transformation to the label-encoded values of employment duration categories.
# Usefulness: Employment categories (which are ordinal) are related to financial stability. The square-root transformation
# smoothens extreme differences in duration and reduces the skewness of the distribution, making it more appropriate 
# for linear models while retaining predictive information for downstream tasks.

employment_mapping = {'<1': 0.5, '1<=X<4': 2.5, '4<=X<7': 5.5, '>=7': 7, 'unemployed': 0}
df['employment_duration_years'] = df['employment'].map(employment_mapping)
df['employment_duration_years_transformed'] = df['employment_duration_years']  0.5
end

