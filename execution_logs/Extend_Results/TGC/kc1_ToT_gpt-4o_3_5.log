# Step 1: Interaction Feature - 'loc_vg_branch_ratio'
# Feature name: loc_vg_branch_ratio
# Feature description: Create a feature that expresses the ratio of lines of code (loc) to the product of cyclomatic complexity (v(g)) and branch count. 
# This emphasizes code complexity relative to branching and module size.
# Usefulness: Combines three critical indicators of software complexity (size, control flow complexity, and branching). Helps identify modules with disproportionately high branching in small or simple codebases that could correlate with defects.
df['loc_vg_branch_ratio'] = df['loc'] / (df['v(g)'] * df['branchCount'] + 1e-9)  # Adding a small epsilon to avoid division by zero
end

python
# Step 2: Transform Feature - 'log_effort'
# Feature name: log_effort
# Feature description: Apply a logarithmic transformation to the Halstead effort ('e') feature to normalize its highly skewed distribution.
# Usefulness: The Halstead effort value spans an enormous range (from 0 to 234,743.54) and has a very high standard deviation. 
# Applying a log transformation normalizes the feature, reduces skewness, and mitigates the effect of extreme outliers on the model.
df['log_effort'] = df['e'].apply(lambda x: np.log1p(x))  # np.log1p handles log(0) since log(1+x) is safe for zero values.
end

python
# Step 3: Complexity Interaction Feature - 'combined_design_essential_complexity'
# Feature name: combined_design_essential_complexity
# Feature description: Create a feature that multiplies essential complexity (ev(g)) and design complexity (iv(g)), normalized by cyclomatic complexity (v(g)).
# Formula: combined_design_essential_complexity = (ev(g) * iv(g)) / (v(g) + 1)
# Usefulness: Captures the interplay between two important measures of structural complexity and contextualizes them with cyclomatic complexity. 
# High values may indicate design or architectural concerns that could lead to defects.
df['combined_design_essential_complexity'] = (df['ev(g)'] * df['iv(g)']) / (df['v(g)'] + 1e-9)
end

python
# Dropping columns - 't' and 'b'
# Explanation why the column 't' is dropped
# The Halstead time estimator ('t') is highly correlated with the Halstead effort ('e'). Retaining both may introduce multicollinearity. 
# Since effort ('e') has higher predictive utility (based on its broader range and direct relationship with code complexity), we drop 't'.
df.drop(columns=['t'], inplace=True)

# Explanation why the column 'b' is dropped
# Halstead 'b' (number of bugs expected) is computed indirectly based on volume, difficulty, and effort. 
# Including it alongside its components introduces redundancy, as it does not provide independent information.
df.drop(columns=['b'], inplace=True)
end

