# Explanation why the column 'Psi_i_A_x_SpMax_B_m' is dropped
# 'Psi_i_A_x_SpMax_B_m' represents the interaction of 'Psi_i_A' and 'SpMax_B(m)', but additional interactions (e.g., Psi_i_A_x_TI2_L) might supersede it due to redundancy and higher explanatory power.
df.drop(columns=['Psi_i_A_x_SpMax_B_m'], inplace=True)

