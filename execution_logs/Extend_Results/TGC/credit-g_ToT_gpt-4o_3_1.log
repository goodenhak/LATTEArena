# Feature name: interaction_checking_status_duration_ratio
# Feature description: Create a feature that combines checking_status and duration by assigning ordinal values to checking_status 
#                       (e.g., <0 = 1, no checking = 2, >=200 = 3, 0<=X<200 = 4) and computing the ratio with duration. 
#                       This captures the interplay between account status and credit period duration.
# Usefulness: Combining checking_status and duration could highlight relationships between account types and repayment timelines.
#              For example, a no checking account with a longer duration might pose more risk than a 0<=X<200 account with a shorter duration.
def map_checking_status(x):
    mapping = {'<0': 1, 'no checking': 2, '>=200': 3, '0<=X<200': 4}
    return mapping[x]

df['checking_status_ordinal'] = df['checking_status'].map(map_checking_status)
df['interaction_checking_status_duration_ratio'] = df['checking_status_ordinal'] / df['duration']
end

python
# Feature name: credit_history_delinquency_score
# Feature description: Create an ordinal score for credit_history based on severity of delinquency, such as:
#                      critical/other existing credit = 5, delayed previously = 4, existing paid = 3, all paid = 2, no credits/all paid = 1.
#                      Higher scores represent greater past credit risk.
# Usefulness: Encapsulates historical delinquency data into a numerical format to allow better downstream modeling of creditworthiness.
def map_credit_history(x):
    mapping = {
        'critical/other existing credit': 5, 
        'delayed previously': 4, 
        'existing paid': 3, 
        'all paid': 2, 
        'no credits/all paid': 1
    }
    return mapping[x]

df['credit_history_delinquency_score'] = df['credit_history'].map(map_credit_history)
end

python
# Feature name: income_to_credit_ratio_category
# Feature description: Bin income_to_credit_ratio into discrete categories like low, medium, high, and very high using quantile-based bucketing. 
#                      (e.g., bin edges could be [0, Q1, Median, Q3, Inf]).
# Usefulness: Helps segment borrowers into risk groups related to how much of their income is tied to the credit repayment, capturing non-linear dependencies.
df['income_to_credit_ratio_category'] = pd.cut(
    df['income_to_credit_ratio'], 
    bins=[-1, df['income_to_credit_ratio'].quantile(0.25), df['income_to_credit_ratio'].quantile(0.5), 
          df['income_to_credit_ratio'].quantile(0.75), float('inf')], 
    labels=['low', 'medium', 'high', 'very high']
)
end

