# Feature name: interaction_savings_status_duration_ratio
# Feature description: Create a feature that computes the interaction between savings_status and duration by assigning ordinal values to savings_status (e.g., <100=1, no known savings=2, 100<=X<500=3, 500<=X<1000=4, >=1000=5) and dividing it by the duration. This captures how the level of savings buffers the duration of credit.
# Usefulness: This feature adds realistic knowledge by emphasizing how an applicant's savings relative to the credit duration could influence their ability to repay the loan in a timely manner. For example, higher savings coupled with similar durations could infer stronger creditworthiness.

# Convert savings_status into ordinal values
savings_status_mapping = {'<100': 1, 'no known savings': 2, '100<=X<500': 3, '500<=X<1000': 4, '>=1000': 5}
df['savings_status_ordinal'] = df['savings_status'].map(savings_status_mapping)

# Calculate the interaction ratio feature
df['interaction_savings_status_duration_ratio'] = df['savings_status_ordinal'] / df['duration_bins'].replace({'short-term': 1, 'mid-term': 2, 'long-term': 3})
end

