# Step 2: Add derived features using mathematical transformations to capture nonlinear trends or domain knowledge.

# Log_SdO: Log-transformation of SdO for normalizing skewed distribution
df['Log_SdO'] = df['SdO'].apply(lambda x: np.log(x + 1))  # Adding 1 to avoid log(0)
# Usefulness: SdO measures E-states, and taking the log reduces the skew of extremely large values while preserving important trends, potentially improving model performance.

# Reciprocal_SM6_L: Reciprocal of SM6_L (Spectral moments from Laplace matrix)
df['Reciprocal_SM6_L'] = 1 / df['SM6_L']
# Usefulness: Captures the inverse relationship of sixth-order spectral moments, particularly beneficial when large values are inversely related to target biodegradability classes.

# Square_nHDon: Squaring the number of H-bond donor atoms
df['Square_nHDon'] = df['nHDon']  2
# Usefulness: Enhances the impact of larger numbers of donor atoms, as they are critical in explaining molecular interaction and biodegradability.
end

