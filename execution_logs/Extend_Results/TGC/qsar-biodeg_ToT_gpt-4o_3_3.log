# Feature name: Interaction_SpMax_JDz
# Feature description: Interaction term between SpMax_L and J_Dz(e) (SpMax_L * J_Dz(e)). Represents how the leading eigenvalue of the Laplace matrix interacts with the topology weighted by electronegativity.
# Usefulness: Combining SpMax_L and J_Dz(e) captures nonlinear effects between molecular structure and electronegativity that may influence biodegradability, particularly for chemicals with complex molecular topology.

df['Interaction_SpMax_JDz'] = df['SpMax_L'] * df['J_Dz(e)']
end

python
# Feature name: Ratio_Oxygen_to_Carbon
# Feature description: Ratio of the number of oxygen atoms (nO) to carbon atoms' percentage (C%). (nO / C%). A higher ratio may signify chemicals enriched with oxygen, impacting biodegradation capacity through hydrophilicity or reaction with water.
# Usefulness: Adds insight about chemical functional group composition, which often determines how quickly a molecule breaks down in the environment.

df['Ratio_Oxygen_to_Carbon'] = df['nO'] / (df['C%'] + 1e-5)  # Adding a small constant to prevent division by zero
end

python
# Feature name: Rolling_Mean_SpMax
# Feature description: Rolling mean (window = 3) of SpMax_L, representing a smoothed version of this important molecular descriptor.
# Usefulness: By smoothing the signal from neighboring rows, this feature could help identify general trends in SpMax_L, which may be useful for identifying molecules with consistent structural patterns conducive to biodegradation.

df['Rolling_Mean_SpMax'] = df['SpMax_L'].rolling(window=3, min_periods=1).mean()
end

