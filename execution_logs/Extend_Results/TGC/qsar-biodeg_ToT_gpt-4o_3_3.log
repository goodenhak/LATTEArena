df['Rolling_Mean_Topological_Feature'] = df['F03[C-O]'].rolling(window=3, min_periods=1).mean()
# Usefulness: Captures the localized trend in the frequency of C - O bonds within a molecular context (e.g., across adjacent rows), revealing possible influential patterns for biodegradability.

# ZScore_SpMax_L: Z-score normalization of SpMax_L
df['ZScore_SpMax_L'] = (df['SpMax_L'] - df['SpMax_L'].mean()) / df['SpMax_L'].std()
# Usefulness: Helps distinguish the outlier behavior or deviations in SpMax_L eigenvalues, which might indicate critical structural differences correlated to biodegradability.
end

