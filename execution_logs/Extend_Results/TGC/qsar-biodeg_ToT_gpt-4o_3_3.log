# Step 1: Create interaction features using 'multiply' operator to capture potential nonlinear relationships between key variables.

# Interaction_1: SpMax_L x J_Dz(e) (Interaction of molecular topological properties)
df['Interaction_1'] = df['SpMax_L'] * df['J_Dz(e)']
# Usefulness: Captures the joint impact of Laplace matrix eigenvalue and weighted Barysz matrix properties, providing a potential measure of how overall molecular behavior depends on these structural properties.

# Interaction_2: nCp x nO (Interaction of primary C with oxygen atoms)
df['Interaction_2'] = df['nCp'] * df['nO']
# Usefulness: Links the number of terminal C(sp3) atoms with oxygen atoms, which could serve as indicators of functional groups like alcohol or ethers that may influence biodegradability.

# Interaction_3: SpMax_L / C% (Normalized impact of eigenvalue by carbon percentage)
df['Interaction_3'] = df['SpMax_L'] / df['C%']
# Usefulness: Normalizes the contribution of SpMax_L by the carbon content, revealing how the molecular topology eigenvalue varies relative to carbon composition, which can impact biodegradability.
end

