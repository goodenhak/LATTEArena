# Step 1: Interaction_Term_SpMax_L_J_Dz_combined
# Feature description: Create a new feature by multiplying SpMax_L and J_Dz(e) to capture interaction effects of these two molecular descriptors.
# Usefulness: The two descriptors represent topological properties of the molecular structure. Their interaction might expose new latent information on how molecular topology affects biodegradability since SpMax_L describes eigenvalues of Laplace matrices and J_Dz(e) calculates electronegativity-based interactions. This could potentially enhance model predictions.
df['Interaction_SpMax_L_J_Dz(e)'] = df['SpMax_L'] * df['J_Dz(e)']
end

python
# Step 2: Ratio_C_O_Percentage
# Feature description: Compute a ratio between the percentage of carbon atoms (C%) and the frequency of C-O bonds at topological distances 3 (F03[C-O]).
# Usefulness: This feature combines information about molecular components (carbon percentage) and functional group bonding distances (C-O bond frequencies). It may help the model infer structural decomposition capacities of chemicals needed for biodegradability predictions.
df['Ratio_C_O_Percentage'] = df['C%'] / (df['F03[C-O]'] + 1e-6)  # Add a small term to avoid division by zero
end

python
# Step 3: ZScore_Psi_i_A
# Feature description: Apply z-score normalization to Psi_i_A, the intrinsic state pseudoconnectivity index, to scale it for better comparison across different rows.
# Usefulness: Standardizing this feature allows the model to assign equal importance compared to other standardized features while capturing the molecular pseudo-connectivity variations relative to other chemicals. This can improve gradient-based model performance by avoiding dominance from larger numerical magnitudes.
df['ZScore_Psi_i_A'] = (df['Psi_i_A'] - df['Psi_i_A'].mean()) / df['Psi_i_A'].std()
end

python
# Dropping columns with high sparsity or low variance
# Explanation why the column nN-N is dropped
# The column nN-N (Number of N hydrazines) has a very low mean (0.0111) and high sparsity (mostly 0 values). Such a feature might have a weak contribution to the model's predictions and could be removed to reduce data dimensionality.
df.drop(columns=['nN-N'], inplace=True)

# Explanation why the column Interaction_3 is dropped
# The column Interaction_3 includes invalid/null values like inf and NaN, which are not useful for model training without heavy imputation or engineering. Hence, it is dropped to avoid complications.
df.drop(columns=['Interaction_3'], inplace=True)

# Explanation why the column B04[C-Br] is dropped
# The column B04[C-Br] has minimum variance and sparsity (almost 0 for all rows). Such sparse binary features may not contribute significantly to downstream predictions.
df.drop(columns=['B04[C-Br]'], inplace=True)
end
