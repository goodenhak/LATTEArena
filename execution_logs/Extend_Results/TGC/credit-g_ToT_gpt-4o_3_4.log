# Feature 1
# Feature name: duration_bins
# Feature description: Bin the duration feature into categorical bins based on its quartiles (e.g., short-term, medium-term, long-term).
# Usefulness: This feature captures the intuition that the length of the credit term might influence creditworthiness. Longer terms might be associated with higher risk, or short-term credits might indicate better financial standing. Binning can help capture such non-linear relationships in the data.
df['duration_bins'] = pd.cut(df['duration'], bins=[0, 12, 24, 72], labels=['short', 'medium', 'long'])
end

python
# Feature 2
# Feature name: avg_installment_per_month
# Feature description: New feature calculated as credit_amount divided by duration, to represent an average installment amount per month.
# Usefulness: This provides an intuitive measure of financial burden or credit repayment capacity. High monthly installment amounts might indicate financial stress, while lower values might signal an ability to pay off credits more easily, reflecting creditworthiness.
df['avg_installment_per_month'] = df['credit_amount'] / df['duration']
end

python
# Feature 3
# Feature name: employment_label_encoded
# Feature description: Label Encoding of the employment feature to add numerical weight to years of employment categories.
# Usefulness: This feature converts the employment duration into a numeric scale. Longer employment duration often reflects financial stability and thus influences credit approval. Label encoding provides machine-learning models with an ordinal representation of this feature, making it more usable for downstream prediction tasks.
from sklearn.preprocessing import LabelEncoder
employment_encoder = LabelEncoder()
df['employment_label_encoded'] = employment_encoder.fit_transform(df['employment'])
end

