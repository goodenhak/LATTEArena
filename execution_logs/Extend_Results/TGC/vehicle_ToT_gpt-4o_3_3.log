# Step 1: Create a ratio feature between SCALED_RADIUS_OF_GYRATION and SCALED_VARIANCE_ALONG_MAJOR_AXIS
# Feature name: RADIUS_TO_MAJOR_VARIANCE_RATIO
# Feature description: Ratio of radius of gyration to scaled variance along the major axis. Indicates how spread out the mass within the silhouette is relative to its elongated distribution along the major axis.
# Usefulness: This feature may capture unique shape characteristics that correlate with specific vehicle types, such as differences in roundedness and elongation profiles.

df['RADIUS_TO_MAJOR_VARIANCE_RATIO'] = df['SCALED_RADIUS_OF_GYRATION'] / df['SCALED_VARIANCE_ALONG_MAJOR_AXIS']
end

python
# Step 2: Apply logarithmic transformation to COMPACTNESS
# Feature name: LOG_COMPACTNESS
# Feature description: Logarithm of compactness values. The transformation dampens non-linear variations, bringing extreme values closer together while preserving relative differences.
# Usefulness: Vehicle shapes likely differ in compactness complexity. Log compactness may enhance discriminative power by emphasizing subtle differences between classes.

df['LOG_COMPACTNESS'] = np.log(df['COMPACTNESS'])
end

python
# Step 3: Create a rolling mean using neighboring rows for HOLLOWS_RATIO
# Feature name: HOLLOWS_RATIO_ROLLING_MEAN
# Feature description: Smoothened average value of Hollows Ratio over a defined neighboring window (window=3).
# Usefulness: Reduces noise from raw HOLLOWS_RATIO values while retaining local shape patterns. Vehicle angles may correspond to smoother variations in hollowness that contribute to classification accuracy.

df['HOLLOWS_RATIO_ROLLING_MEAN'] = df['HOLLOWS_RATIO'].rolling(window=3, min_periods=1).mean()
end

