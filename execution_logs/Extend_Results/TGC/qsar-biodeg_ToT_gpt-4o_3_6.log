python
# Step 4: Create ratio feature between SpMax_L and SpMax_A
# Feature name: Ratio_SpMax_L_A
# Feature description: Calculate the ratio of the leading eigenvalues from Laplace matrix (SpMax_L) and adjacency matrix (SpMax_A).
# Usefulness: These eigenvalues represent structural properties of molecules. Their ratio could reveal critical information about topological contributions to molecular biodegradability.
df['Ratio_SpMax_L_A'] = df['SpMax_L'] / df['SpMax_A']
end

python
