# Usefulness: Normalizing this feature focuses solely on its relative position in the distribution, removing scale dependence and ensuring consistency during downstream classification, especially when mixing features with different scales.

df['ZSCALED_RADIUS_OF_GYRATION'] = (df['SCALED_RADIUS_OF_GYRATION'] - df['SCALED_RADIUS_OF_GYRATION'].mean()) / df['SCALED_RADIUS_OF_GYRATION'].std()
