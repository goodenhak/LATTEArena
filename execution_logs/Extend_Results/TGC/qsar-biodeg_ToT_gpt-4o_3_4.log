df['SdO_to_C_ratio'] = df['SdO'] / (df['C%'] + 1e-6)  # Adding a small constant to avoid division by zero
end

python
# Step 2: Apply z-score normalization to SM6_B(m) to capture deviations from the mean
# Feature name: SM6_Bm_zscore
# Feature description: A z-score normalized version of the SM6_B(m) feature, which represents how far a particular value is from the mean in terms of standard deviations. Standardizing this feature could assist certain models (e.g., SVM, Logistic Regression) in assigning greater significance to its distribution across samples.
# Usefulness: Large variability in SM6_B(m) could indicate its importance in differentiating classes. A standardized version can eliminate range effects, helping algorithms to better utilize its information.

df['SM6_Bm_zscore'] = (df['SM6_B(m)'] - df['SM6_B(m)'].mean()) / df['SM6_B(m)'].std()
end

python
