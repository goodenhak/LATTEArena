df['credit_amount_duration_ratio'] = df['credit_amount'] / df['duration']
end

python
# one_hot_encoded_checking_status
# Feature description: Converts checking_status categorical variable into multiple binary columns.
# Usefulness: Transforming this variable enables the model to better utilize the levels of the feature without assuming ordinal relationships.
df = pd.get_dummies(df, columns=['checking_status'], prefix='checking_status', drop_first=True)
