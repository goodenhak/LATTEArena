# Usefulness: Saving status is a crucial feature for determining financial security, which typically impacts creditworthiness. Assigning an ordinal encoding helps the model understand relative financial stability from least to most savings.
savings_order = {'<100': 0, 'no known savings': 1, '100<=X<500': 2, '500<=X<1000': 3, '>=1000': 4}
df['savings_status_encoded'] = df['savings_status'].map(savings_order)
end

