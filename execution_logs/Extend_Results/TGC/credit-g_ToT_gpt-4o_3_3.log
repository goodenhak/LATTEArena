python
# credit_amount_duration_ratio
# Feature description: Creates a ratio between credit_amount and duration to represent the monthly loan repayment expectation.
# Usefulness: This feature captures the financial burden of the loan on the applicant, which may highlight their ability to make repayments.
df['credit_amount_duration_ratio'] = df['credit_amount'] / df['duration']
end

python
# one_hot_encoded_checking_status
# Feature description: Converts checking_status categorical variable into multiple binary columns.
# Usefulness: Transforming this variable enables the model to better utilize the levels of the feature without assuming ordinal relationships.
df = pd.get_dummies(df, columns=['checking_status'], prefix='checking_status', drop_first=True)
end

python
# purpose_target_encoding
# Feature description: Encodes purpose using the mean of the target variable (credit approval rate) for each category.
# Usefulness: This allows better incorporation of historical information about the likelihood of credit approval based on the purpose of the loan.
# Assumption: There is sufficient historical data to calculate target encoding accurately and avoid overfitting.
target_mean = df.groupby('purpose')['Answer'].mean()
df['purpose_target_encoding'] = df['purpose'].map(target_mean)
end

---

### Column Dropping Justification:

python
# Explanation why the column purpose is dropped
# Purpose: After applying target encoding on 'purpose', the original column can be dropped as it has been re-represented in a more informative way.
df.drop(columns=['purpose'], inplace=True)
end

python
# Explanation why the column checking_status is dropped
