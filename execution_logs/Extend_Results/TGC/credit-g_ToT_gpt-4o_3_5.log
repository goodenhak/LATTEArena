# Feature name: savings_to_credit_ratio
# Feature description: Calculate the ratio of savings_status (encoded as numerical categories) to credit_amount. Since savings_status is categorical, assign numerical values (e.g., <100=1, 100<=X<500=2, 500<=X<1000=3, >=1000=4, no known savings=0) before performing the ratio.
# Usefulness: This feature captures the relative proportion of a person's savings to their requested credit amount. Low ratios might indicate financial strain, whereas higher ratios suggest strong financial backing, contributing significantly to the downstream decision-making process.
savings_mapping = {'<100': 1, '100<=X<500': 2, '500<=X<1000': 3, '>=1000': 4, 'no known savings': 0}
df['savings_mapped'] = df['savings_status'].map(savings_mapping)
df['savings_to_credit_ratio'] = df['savings_mapped'] / (df['credit_amount'] + 1e-8)
end

python
# Feature name: age_to_employment_ratio
# Feature description: Calculate the ratio of age to the midpoint of the employment category range (e.g., 4<=X<7 → 5.5, 1<=X<4 → 2.5, and so on). Assume ‘<1’=0.5, ‘unemployed’=0, and '>=7’=7. This feature provides a measure of how employment experience compares to the person's age. 
# Usefulness: A higher ratio might suggest financial maturity compared to work experience, while a lower ratio might indicate a younger applicant with significant work experience, useful for credit decisioning.
employment_mapping = {'4<=X<7': 5.5, '>=7': 7, '<1': 0.5, '1<=X<4': 2.5, 'unemployed': 0}
df['employment_mapped'] = df['employment'].map(employment_mapping)
df['age_to_employment_ratio'] = df['age'] / (df['employment_mapped'] + 1e-8)
end

