# duration_bin_installment_commitment_mean
# Calculate the mean installment_commitment (percentage of disposable income spent) for each duration_bin category.
# Usefulness: Understanding the average financial burden by duration_bin can be a good indicator of creditworthiness or repayment risk.
df['duration_bin_installment_commitment_mean'] = df.groupby('duration_bin')['installment_commitment'].transform('mean')
end

