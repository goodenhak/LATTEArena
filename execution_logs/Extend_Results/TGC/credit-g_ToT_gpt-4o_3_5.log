# Usefulness: This feature impacts credit decisioning by combining the repayment duration with risk perceptions tied to the credit purpose. For instance, riskier purposes like business would be weighted higher, and this score could indicate high-risk long-term credits.
purpose_weights = {
    'business': 1.5, 'retraining': 1.2, 'furniture/equipment': 1.1, 'new car': 1.0, 'used car': 1.0,
    'education': 1.1, 'radio/tv': 0.9, 'repairs': 1.0, 'domestic appliance': 0.8, 'other': 1.0
}
df['purpose_weight'] = df['purpose'].map(purpose_weights)
df['credit_duration_weighted_by_priority'] = df['duration'] * df['purpose_weight']
end
