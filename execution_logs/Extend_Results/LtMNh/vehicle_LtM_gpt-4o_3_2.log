      - ratio_compactness_circularity = COMPACTNESS / CIRCULARITY
      - ratio_scaled_variances = SCALED_VARIANCE_ALONG_MAJOR_AXIS / SCALED_VARIANCE_ALONG_MINOR_AXIS
