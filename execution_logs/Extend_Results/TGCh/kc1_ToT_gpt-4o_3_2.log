# Feature 1: complexity_per_loc
# Combines overall complexity (sum of v(g), ev(g), and iv(g)) per line of code (loc).
# Usefulness: Captures the density of decision points and complexity in the module relative to its size. Higher values may indicate tightly packed complex structures prone to defects.
df['complexity_per_loc'] = (df['v(g)'] + df['ev(g)'] + df['iv(g)']) / (df['loc'] + 1e-8)
end

python
# Feature 2: operand_operator_balance
# Ratio of total operands (total_Opnd) to total operators (total_Op).
# Usefulness: Reflects the balance between variables and operations in the code. An imbalanced ratio could indicate coding inefficiencies or unconventional logic, potentially linked to defect likelihood.
df['operand_operator_balance'] = df['total_Opnd'] / (df['total_Op'] + 1e-8)
end

python
# Feature 3: normalized_signal_to_noise
# Log-transformed signal-to-noise ratio for code (signal_to_noise_loc).
# Usefulness: Mitigates skewness in signal_to_noise_loc by using a logarithmic scale. This more normalized feature may improve model robustness when correlating clean, efficient modules with defect likelihood.
df['normalized_signal_to_noise'] = np.log(df['signal_to_noise_loc'] + 1e-5)
end

