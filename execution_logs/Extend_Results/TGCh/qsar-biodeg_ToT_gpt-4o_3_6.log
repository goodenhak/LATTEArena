python
# nO_SpMax_L_ratio
# Ratio between the number of oxygen atoms (nO) and the leading eigenvalue from Laplace matrix (SpMax_L).
# Usefulness: High oxygen content may interact with molecular topology (SpMax_L) to better capture the chemical's environmental reactivity and consequent biodegradability.
df['nO_SpMax_L_ratio'] = df['nO'] / (df['SpMax_L'] + 1e-10)

# C%_nCb-_interaction
# Interaction between percentage of carbon atoms (C%) and number of substituted benzene C(sp2) (nCb-).
# Usefulness: This helps model how the aromatic content (nCb-) correlates with the carbon composition, which may influence chemical complexity and readiness for biodegradation.
df['C%_nCb-_interaction'] = df['C%'] * df['nCb-']

# SpMax_L_Ti2L_diff
# Difference between the leading eigenvalue from Laplace matrix (SpMax_L) and the second Mohar index (Ti2_L).
# Usefulness: These molecular descriptors relate to the topology of the molecule, and their difference might represent specific structural variations linked to biodegradability.
df['SpMax_L_Ti2L_diff'] = df['SpMax_L'] - df['TI2_L']
end  

### Step 2: Non-linear Transformations
Applying non-linear transformations (e.g., square, log, and exponential) can help model non-linear relationships in the data.

python
# log_nN
# Log transformation of the number of Nitrogen atoms (nN).
# Usefulness: Nitrogen presence may influence biodegradability non-linearly; a log scale handles large variance effectively.
df['log_nN'] = np.log1p(df['nN'])

# sqrt_F03C-O
# Square root transformation of the frequency of C-O bonds at topological distance 3 (F03[C-O]).
# Usefulness: Reduces the impact of outliers in this feature while preserving its relative order and potential importance in interactions with condensation reactions.
df['sqrt_F03C-O'] = np.sqrt(df['F03[C-O]'])

# SpMax_B_cube
# Cube transformation of the leading eigenvalue from Burden matrix weighted by mass (SpMax_B(m)).
# Usefulness: Highlights extreme values of the structural feature for specific edge cases that may drive biodegradability.
df['SpMax_B_cube'] = df['SpMax_B(m)']  3
end  

### Step 3: Statistical Encoding and Dimensionality Reduction
Reduce noise or sparsity in features by encoding or mixing features into aggregate statistical representations.

python
# nC_H_ratio
# Ratio of number of heavy atoms (nHM) to the number of Hydrogen donor atoms (nHDon).
# Usefulness: Captures the balance of molecular density versus hydrogen donors affecting biodegradation likelihood.
df['nC_H_ratio'] = df['nHM'] / (df['nHDon'] + 1e-10)

# zscore_SdO
# Z-score normalization of the sum of dO E-states (SdO).
