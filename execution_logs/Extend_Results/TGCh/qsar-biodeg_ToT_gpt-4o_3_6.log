# Usefulness: Higher density of primary carbons might correlate with higher reactivity and thus impact biodegradability. This feature captures such relative density relationships.

df['nCp_to_C_ratio'] = df['nCp'] / (df['C%'] + 0.001)  # Adding 0.001 to avoid division by zero.
