python
# Feature name: GYRATION_RECTANGULARITY_RATIO
# Feature description: Ratio of SCALED_RADIUS_OF_GYRATION to MAX.LENGTH_RECTANGULARITY (SCALED_RADIUS_OF_GYRATION / MAX.LENGTH_RECTANGULARITY).
# Usefulness: This feature captures the relationship between mass distribution (gyration) and the rectangularity of the silhouette. Distinctive patterns in how mass is distributed across shapes can differentiate vehicle types like compact OPELs and elongated BUSES.
df['GYRATION_RECTANGULARITY_RATIO'] = df['SCALED_RADIUS_OF_GYRATION'] / df['MAX.LENGTH_RECTANGULARITY']
end

