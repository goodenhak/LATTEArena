provide distinguishing power.\nend\n\npython\n# Explanation why the column KURTOSIS_ABOUT_MAJOR_AXIS is dropped\ndf.drop(columns=['KURTOSIS_ABOUT_MAJOR_AXIS'], inplace=True)\n# KURTOSIS_ABOUT_MAJOR_AXIS has a small standard deviation (Std = 6.2098), which limits its discriminative usefulness across vehicle classes.\nend\n\npython\n# Explanation why the column SKEWNESS_ABOUT_MAJOR_AXIS is dropped\ndf.drop(columns=['SKEWNESS_ABOUT_MAJOR_AXIS'], inplace=True)\n# SKEWNESS_ABOUT_MAJOR_AXIS is less effective on its own. Other features like GYRATION_VARIANCE_RATIO better capture its effects in combination.\nend", "python\n# Feature name: LENGTH_WIDTH_RATIO\n# Feature description: Ratio of MAX.LENGTH_ASPECT_RATIO to PR.AXIS_ASPECT_RATIO (MAX.LENGTH_ASPECT_RATIO / PR.AXIS_ASPECT_RATIO).\n# Usefulness: This feature captures the relationship between the overall length and width of the silhouette. Vehicles like BUSES and VANS, which are typically longer and wider, are expected to have different ratios compared to smaller vehicles like OPEL or SAAB.\ndf['LENGTH_WIDTH_RATIO'] = df['MAX.LENGTH_ASPECT_RATIO'] / df['PR.AXIS_ASPECT_RATIO']\nend\n\npython\n# Feature name: RECTANGULARITY_CIRCULARITY_RATIO\n# Feature description: Ratio of MAX.LENGTH_RECTANGULARITY to COMPACTNESS_CIRCULARITY_RATIO (MAX.LENGTH_RECTANGULARITY / COMPACTNESS_CIRCULARITY_RATIO).\n# Usefulness: Creates a combined measure of rectangularity and compactness, which allows further distinguishing between silhouettes that are more rectangular (e.g., BUS or VAN) versus those that may be more circular or compact (e.g., SAAB or OPEL).\ndf['RECTANGULARITY_CIRCULARITY_RATIO'] = df['MAX.LENGTH_RECTANGULARITY'] / df['COMPACTNESS_CIRCULARITY_RATIO']\nend\n\npython\n# Feature name: NORMALIZED_RADIUS_GYRATION\n# Feature description: Z-score normalization of SCALED_RADIUS_OF_GYRATION ((SCALED_RADIUS_OF_GYRATION - Mean) / Std).\n# Usefulness: Standardizing features with a large range like SCALED_RADIUS_OF_GYRATION ensures they are on a comparable scale to others, which is particularly beneficial for machine learning models that rely on distance metrics or gradient descent optimization.\ndf['NORMALIZED_RADIUS_GYRATION'] = (df['SCALED_RADIUS_OF_GYRATION'] - df['SCALED_RADIUS_OF_GYRATION'].mean()) / df['SCALED_RADIUS_OF_GYRATION'].std()\nend\n\npython\n# Explanation why the column HOLLOWS_RATIO is dropped\ndf.drop(columns=['HOLLOWS_RATIO'], inplace=True)\n# HOLLOWS_RATIO has a very small range of variability (Std = 7.5056 and range = [181, 211]), making it less likely to provide meaningful insights into vehicle classification.\nend\n\npython\n# Explanation why the column KURTOSIS_ABOUT_MINOR_AXIS is dropped\ndf.drop(columns=['KURTOSIS_ABOUT_MINOR_AXIS'], inplace=True)\n# KURTOSIS_ABOUT_MINOR_AXIS has a small range of values (0–41) and low variability (Std = 8.9149), indicating a limited impact for distinguishing between vehicle classes.\nend\n\npython\n# Explanation why the column SKEWNESS_ABOUT_MAJOR_AXIS is dropped\ndf.drop(columns=['SKEWNESS_ABOUT_MAJOR_AXIS'], inplace=True)\n# SKEWNESS_ABOUT_MAJOR_AXIS has a narrow range (60–135) and similar values across samples. This might make it redundant when combined with other skewness-based features like SKEWNESS_PRODUCT or VARIANCE_RATIO_MAJOR_MINOR.\nend"]###,
