python
# Feature name: employment_duration_numeric
# Feature description: Converts the categorical 'employment' into ordinal values based on years of employment.
# Mapping: '<1': 0, '1<=X<4': 1, '4<=X<7': 2, '>=7': 3, 'unemployed': -1
# Usefulness: Employment duration directly impacts financial stability. Encoding it ordinally provides a numerical signal about the applicant's job consistency and reliability.

employment_mapping = {
    '<1': 0, 
    '1<=X<4': 1, 
    '4<=X<7': 2, 
    '>=7': 3, 
    'unemployed': -1
}
df['employment_duration_numeric'] = df['employment'].map(employment_mapping)
end

python
# Feature name: checking_savings_cross
# Feature description: Combines 'checking_status' and 'savings_status' into a new feature representing financial liquidity.
# Usefulness: This captures the interaction between immediate liquidity (checking_status) and saved wealth (savings_status), providing a more holistic view of financial stability.

df['checking_savings_cross'] = df['checking_status'] + '_' + df['savings_status']
end

python
# Feature name: normalized_credit_amount
# Feature description: Applies min-max normalization to the 'credit_amount' feature to scale its values between 0 and 1.
# Usefulness: Helps models that are sensitive to feature scales (e.g., logistic regression or neural networks) by normalizing the wide range of credit amounts.

df['normalized_credit_amount'] = (df['credit_amount'] - df['credit_amount'].min()) / (df['credit_amount'].max() - df['credit_amount'].min())
end

