employment_le = LabelEncoder()
df['employment_label_encoded'] = employment_le.fit_transform(df['employment'])
# Example: unemployed -> 0, <1 -> 1, 1<=X<4 -> 2, 4<=X<7 -> 3, and >=7 -> 4
end

