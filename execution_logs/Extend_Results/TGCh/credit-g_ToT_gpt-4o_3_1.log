# Add column: duration_bins
# Feature description: Bucketize the 'duration' column into categorical bins such as short-term, medium-term, and long-term based on percentiles (e.g., <12 months, 12-24 months, >24 months).
# Usefulness: This simplifies duration into an interpretable format, capturing different tiers of loan lengths and their potential impact on creditworthiness. For instance, longer durations often increase default risk.

def duration_bins(duration):
    if duration < 12:
        return 'short_term'
    elif 12 <= duration <= 24:
        return 'medium_term'
    else:
        return 'long_term'

df['duration_bins'] = df['duration'].apply(duration_bins)
end

python
