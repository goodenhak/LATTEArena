# Feature description: Ratio between 'credit_amount' and 'installment_commitment' (credit amount requested divided by installment percentage of disposable income).
# Usefulness: This feature measures the financial burden of the credit amount compared to disposable income—higher ratios may indicate higher financial strain and potential risk.

df['credit_amount_to_income_ratio'] = df['credit_amount'] / df['installment_commitment']
end

python
