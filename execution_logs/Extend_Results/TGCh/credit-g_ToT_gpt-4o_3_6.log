# Feature name: credit_age_ratio
# Feature description: Ratio of credit_amount to age, representing the borrowing scale relative to the individual's age.
# Usefulness: Captures whether an individual is requesting a disproportionately high loan amount given their age, which may correlate with financial maturity and stability.
df['credit_age_ratio'] = df['credit_amount'] / (df['age'] + 1e-9)
end

python
# Feature name: duration_bins
# Feature description: Bin duration into discrete groups (e.g., short, medium, long-term loans) based on quantiles (Q1, Q2, Q3).
# Usefulness: Helps in categorizing loan terms into distinct groups, capturing nonlinear relationships such as risk differing based on whether the loan is short or long-term.
df['duration_bins'] = pd.cut(df['duration'], bins=[3, 12, 24, 60], labels=['short', 'medium', 'long'])
end

python
# Feature name: savings_to_credit_ratio
# Feature description: Create a ratio feature combining savings_status (encoded) and credit_amount to understand liquidity relative to loan size.
# Usefulness: Captures how individuals' financial reserves (saving status) compare to the credit amount they are applying for, indicating potential repayment ability.
savings_map = {'>=1000': 1000, '500<=X<1000': 750, '100<=X<500': 300, '<100': 50, 'no known savings': 0}
df['savings_encoded'] = df['savings_status'].map(savings_map)
df['savings_to_credit_ratio'] = df['savings_encoded'] / (df['credit_amount'] + 1e-9)
end

python
# Explanation why the column housing is dropped
# The housing column ('own', 'rent', 'for free') overlaps with other variables like savings_status or checking_status, making it potentially redundant. Its low cardinality (3 values) and weaker correlation with risk make it less useful.
df.drop(columns=['housing'], inplace=True)
end

python
# Explanation why the column other_parties is dropped
# The other_parties column ('none', 'guarantor', 'co applicant') has low cardinality and often demonstrates weak predictive power due to its rare use or overlap with other financial responsibility indicators.
df.drop(columns=['other_parties'], inplace=True)
end

python
# Explanation why the column job is dropped
# The job column reflects socioeconomic factors already encoded in employment, savings_status, and checking_status. Removing job reduces redundancy and simplifies the model.
df.drop(columns=['job'], inplace=True)
end
