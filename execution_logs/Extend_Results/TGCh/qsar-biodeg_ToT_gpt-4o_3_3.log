df.drop(columns=['B01[C-Br]'], inplace=True)

# Explanation why the column nN-N is dropped
# nN-N (number of N hydrazines) has an extremely low mean (0.0111) and standard deviation (0.1188), indicating negligible variability and minimal utility.
df.drop(columns=['nN-N'], inplace=True)

# Explanation why the column N-073 is dropped
# N-073 (specific nitrogen-related descriptor) has a very low mean (0.0300) and standard deviation (0.1884), making it sparse and uninformative for classification tasks.
df.drop(columns=['N-073'], inplace=True)
end

