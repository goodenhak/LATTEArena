# Sparsity: F01[N-N] has a very low mean (0.0474) and extreme sparsity (Q3 = 0), making it uninformative for classification.  
end

python
# Explanation why the column nArCOOR is dropped  
df.drop(columns=['nArCOOR'], inplace=True)  
# Sparsity: nArCOOR (mean = 0.0632) is mostly zero, contributing limited value to biodegradability prediction.  
end

python
# Explanation why the column N-073 is dropped  
df.drop(columns=['N-073'], inplace=True)  
# Sparsity: N-073 (mean = 0.0363) is highly sparse and poorly correlated with biodegradability classification.  
end

