python
# Income-to-Debt Ratio
# This feature calculates the ratio of income to debt, which gives insight into the financial stability of an individual.
# Usefulness: A higher income-to-debt ratio suggests better financial health, which likely correlates with credit card eligibility. This helps the model better understand the relationship between income and debt.
df['income_debt_ratio'] = df['Income'] / (df['Debt'] + 1e-5)  # Adding a small value to avoid division by zero.
end

---

python
# Employment Stability: Years Employed / Age
# This feature computes the proportion of years employed relative to the age of the individual.
# Usefulness: A higher value indicates a longer work history compared to age, which could be a signal of financial responsibility and job stability—important factors for creditworthiness.
df['employment_stability'] = df['YearsEmployed'] / df['Age']
end

---

python
# Credit Utilization: Debt / (Income + Prior Default Adjustment)
# This feature measures debt relative to income while accounting for prior defaults.
# Usefulness: Low credit utilization (controlled by income and financial history) often indicates better repayment ability. Incorporating Prior Default adds more nuance to this calculation.
df['credit_utilization'] = df['Debt'] / (df['Income'] + 1e-5 + df['PriorDefault'])
end

---

