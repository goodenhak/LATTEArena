# Feature: Prior Default Impact Score
# Feature description: Combines PriorDefault, CreditScore, and Debt_Income_Ratio into a single feature to evaluate credit risk using the formula: Score = (1 - PriorDefault) * CreditScore / (Debt_Income_Ratio + 1e-5).
# Usefulness: This feature reflects the combined impact of no prior defaults, creditworthiness, and financial responsibility. A higher score signals better credit risk.
df['Prior_Default_Impact_Score'] = (1 - df['PriorDefault']) * df['CreditScore'] / (df['Debt_Income_Ratio'] + 1e-5)
end

---

python
# Feature: Employment to Age Ratio
# Feature description: Calculates the ratio of years employed to current age using the formula: Ratio = YearsEmployed / Age.
# Usefulness: A higher ratio indicates an individual's work experience relative to their age, which can signal financial stability and responsibility.
df['Employment_Age_Ratio'] = df['YearsEmployed'] / df['Age']
end

---

python
# Feature: Industry Risk Level
# Feature description: Categorizes industries into low, medium, and high-risk levels based on general job security and income stability (e.g., Financials = low risk, Hospitality = high risk).
# Usefulness: Job sectors play a role in creditworthiness due to differences in average income and job stability. Adding this feature provides industry-level insight into risk.
industry_risk_map = {
    'CommunicationServices': 'Medium',
    'ConsumerDiscretionary': 'High',
    'Energy': 'Medium',
    'InformationTechnology': 'Low',
    'Education': 'Medium',
    'Financials': 'Low',
    'Healthcare': 'Low',
    'Materials': 'Medium',
    'ConsumerStaples': 'Low',
    'Real Estate': 'Medium',
    'Industrials': 'High',
    'Research': 'Medium',
    'Utilities': 'Low',
    'Transport': 'High',
}
df['Industry_Risk_Level'] = df['Industry'].map(industry_risk_map)
df = pd.get_dummies(df, columns=['Industry_Risk_Level'], drop_first=True)
end

