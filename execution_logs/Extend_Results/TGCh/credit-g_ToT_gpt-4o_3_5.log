# Feature name: debt_to_income_ratio
# Feature description: Calculate the debt-to-income ratio as the credit_amount divided by (installment_commitment * 12), representing annual disposable income.
# Usefulness: This feature quantifies the proportion of an individual's loan relative to their estimated annual disposable income. A higher ratio implies higher financial strain, which can indicate greater credit risk.
df['debt_to_income_ratio'] = df['credit_amount'] / (df['installment_commitment'] * 12)
end

python
# Feature name: employment_stability
# Feature description: Map employment categories into ordinal stability scores: unemployed = 0, <1 year = 1, 1–4 years = 2, 4–7 years = 3, >=7 years = 4.
# Usefulness: Employment stability reflects job security and income reliability, which are critical factors in assessing an individual's ability to repay loans. By quantifying stability, this feature adds predictive power to the model.
employment_mapping = {
    'unemployed': 0,
    '<1': 1,
    '1<=X<4': 2,
    '4<=X<7': 3,
    '>=7': 4,
}
df['employment_stability'] = df['employment'].map(employment_mapping)
end

python
# Feature name: loan_to_age_ratio
# Feature description: Compute the ratio of credit_amount to age, representing the financial burden of the loan relative to the individual's age.
# Usefulness: Younger applicants may have less established financial situations or credit histories, so this feature captures the relative loan burden by accounting for age—a proxy for income or financial maturity.
df['loan_to_age_ratio'] = df['credit_amount'] / df['age']
end

python
# Explanation why the column 'employment' is dropped
# The employment column has been transformed into the employment_stability feature, which captures employment information in a numerical format suitable for modeling.
df.drop(columns=['employment'], inplace=True)
end
