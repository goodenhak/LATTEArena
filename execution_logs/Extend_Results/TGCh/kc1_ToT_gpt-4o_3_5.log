# Feature name: sqrt_loc
# Feature description: Square root transformation of the 'loc' feature (line count of code).
# Usefulness: Reduces skewness in the distribution of 'loc' and allows the model to better capture the relationship between smaller modules and defect likelihood. Smaller modules might have non-linear effects on defect prediction, which this transformation could capture.
df['sqrt_loc'] = np.sqrt(df['loc'])
end

python
# Feature name: intelligence_density
# Feature description: Halstead's intelligence measure (i) divided by Halstead's line count (lOCode).
# Usefulness: Captures the intelligence measure per line of code, indicating how efficiently a module conveys logic. Low values can indicate verbose or less intuitive code that could lead to potential defects.
df['intelligence_density'] = df['i'] / (df['lOCode'] + 1e-8)  # Adding small epsilon to avoid division by zero
end

