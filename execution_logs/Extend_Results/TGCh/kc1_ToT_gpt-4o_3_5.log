# Feature name: normalized_cyclomatic_complexity
# Feature description: Cyclomatic complexity (v(g)) divided by McCabe's line count of code (loc).
# Usefulness: Highlights logical complexity density in the code. Modules with high cyclomatic complexity relative to their size may be disproportionately defect-prone.
df['normalized_cyclomatic_complexity'] = df['iv(g)'] / (df['loc'] + 1e-8)  # Adding a small epsilon to avoid division by zero
end

python
# Feature name: intelligence_per_line
# Feature description: Halstead's intelligence measure (i) divided by the number of lines of code (loc).
# Usefulness: Captures the intelligence density, showing how efficiently the code conveys logic. Low intelligence per line could indicate verbose, less intuitive code that might be prone to errors.
df['intelligence_per_line'] = df['i'] / (df['loc'] + 1e-8)  # Adding small epsilon to avoid division by zero
end

python
# Feature name: operator_density
# Feature description: Ratio of unique operators (uniq_Op) to Halstead’s 'line count' (lOCode).
# Usefulness: This feature indicates how operators are distributed in the code. Higher density might suggest complex or overly compact code, both of which can be strong defect predictors.
df['operator_density'] = df['uniq_Op'] / (df['lOCode'] + 1e-8)  # Adding small epsilon to avoid division by zero
end

python
# Explanation why the column lOBlank is dropped
