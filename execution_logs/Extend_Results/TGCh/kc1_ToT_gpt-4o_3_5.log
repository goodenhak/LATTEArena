2026-05-23 18:17:32,684 - INFO - Selected state: ("python\n# Feature name: loc_squared\n# Feature description: Squared value of the 'loc' (line count of code) feature.\n# Usefulness: The squared value of 'loc' enhances the expressiveness of variation in code size, capturing higher-order effects of module size on defects. Large modules may have a disproportionately higher chance of defects, which this transformation can help capture.\ndf['loc_squared'] = df['loc']  2\nend\n\npython\n# Feature name: ratio_comments_code\n# Feature description: Ratio of lines of comments (lOComment) to lines of code (lOCode).\n# Usefulness: Useful for understanding the documentation-to-code ratio, which could relate to maintainability and defect likelihood. A poorly documented codebase might be more error-prone, while better comments can hint at better quality or design.\ndf['ratio_comments_code'] = df['lOComment'] / (df['lOCode'] + 1e-5)  # Adding small value to avoid division by zero\nend\n\npython\n# Feature name: cyclomatic_per_loc\n# Feature description: Cyclomatic complexity (v(g)) normalized by the number of lines of code (loc).\n# Usefulness: This feature helps measure how complex the logic is relative to the size of the module. High cyclomatic complexity per line of code could indicate overly intricate logic, which may increase the chance of defects.\ndf['cyclomatic_per_loc'] = df['v(g)'] / (df['loc'] + 1e-5)  # Adding small value to avoid division by zero\nend\n\npython\n# Explanation why the column locCodeAndComment is dropped\n# The column 'locCodeAndComment' has very limited variation in the dataset (mostly zeros with a mean close to zero and very low standard deviation). This lack of information makes it unlikely to be useful for prediction and it introduces unnecessary noise.\ndf.drop(columns=['locCodeAndComment'], inplace=True)\nend\n\npython\n# Explanation why the column l is dropped\n# The column 'l' (Halstead program length) has a very narrow range (0 to 2) and its implications for software defects are unclear or redundant when combined with other Halstead metrics like 'n' and 'v'. Dropping it reduces redundancy in the feature set.\ndf.drop(columns=['l'], inplace=True)\nend\n\npython\n# Explanation why the column b is dropped\n# The column 'b' (Halstead error estimate) has minimal variance in the dataset (mean ~0.089, std ~0.176), indicating it does not provide meaningful discriminative power for a binary classification task of defect prediction.\ndf.drop(columns=['b'], inplace=True)\nend", "python\n# Feature name: loc_log\n# Feature description: Logarithmic transformation of the 'loc' feature (line count of code).\n# Usefulness: Helps to reduce skewness in the data distribution for 'loc', which has a large range and high standard deviation. This feature transformation can improve model performance for imbalanced data by focusing on relative differences.\ndf['loc_log'] = np.log1p(df['loc'])\nend\n\npython\n# Feature name: uniq_Op_per_loc\n# Feature description: Ratio of unique operators (uniq_Op) to lines of code (loc).\n# Usefulness: Captures the density of unique operators used in the module. Higher values could indicate overly complex or dense logic, which may increase the likelihood of defects.\ndf['uniq_Op_per_loc'] = df['uniq_Op'] / (df['loc'] + 1e-5)\nend\n\npython\n# Feature name: evg_per_ivg\n# Feature description: Ratio of McCabe's essential complexity (ev(g)) to design complexity (iv(g)).\n# Usefulness: This ratio provides insights into how much of the complexity is essential versus incidental. Larger values suggest a higher proportion of essential complexity, which might lead to fewer defects, while lower values could indicate design flaws or unnecessary intricacy.\ndf['evg_per_ivg'] = df['ev(g)'] / (df['iv(g)'] + 1e-5)\nend\n\npython\n# Explanation why the column ratio_comments_code is dropped\n# The column 'ratio_comments_code' is mostly zeros, with a median of 0.0 and very low mean (0.0499) compared to its standard deviation.\n# It offers little discriminatory value and is unlikely to significantly influence defect prediction.\ndf.drop(columns=['ratio_comments_code'], inplace=True)\nend\n\npython\n# Explanation why the column lOBlank is dropped\n# The column 'lOBlank' has limited variability in the dataset (median = 0.0, Q3 = 2.0), indicating minimal impact on defect prediction.\n# In addition, its correlation with meaningful features like loc or lOCode can explain its contribution, making it redundant.\ndf.drop(columns=['lOBlank'], inplace=True)\nend\n\npython\n# Explanation why the column ev(g) is dropped\n# The column 'ev(g)' is indirectly represented in the newly engineered 'evg_per_ivg' feature, which normalizes it relative to design complexity (iv(g)).\n# Keeping 'ev(g)' as a standalone feature may introduce redundancy and collinearity with the new feature.\ndf.drop(columns=['ev(g)'], inplace=True)\nend", "python\n# Feature name: normalized_cyclomatic_complexity\n# Feature description: Cyclomatic complexity (v(g)) divided by McCabe's line count of code (loc).\n# Usefulness: Highlights logical complexity density in the code. Modules with high cyclomatic complexity relative to their size may be disproportionately defect-prone.\ndf['normalized_cyclomatic_complexity'] = df['iv(g)'] / (df['loc'] + 1e-8)  # Adding a small epsilon to avoid division by zero\nend\n\npython\n# Feature name: intelligence_per_line\n# Feature description: Halstead's intelligence measure (i) divided by the number of lines of code (loc).\n# Usefulness: Captures the intelligence density, showing how efficiently the code conveys logic. Low intelligence per line could indicate verbose, less intuitive code that might be prone to errors.\ndf['intelligence_per_line'] = df['i'] / (df['loc'] + 1e-8)  # Adding small epsilon to avoid division by zero\nend\n\npython\n# Feature name: operator_density\n# Feature description: Ratio of unique operators (uniq_Op) to Halstead’s 'line count' (lOCode).\n# Usefulness: T