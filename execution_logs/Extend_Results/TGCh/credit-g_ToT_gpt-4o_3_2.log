# Feature name: financial_stress_score
# Feature description: Combines employment_duration_stability, savings_score, and credit_amount_to_income_ratio into a single composite indicator.
# Usefulness: This weighted combination reflects the borrower's financial readiness. Higher employment stability and savings, paired with a lower relative loan burden, indicate reduced financial stress, while the opposite signals increased risk.
df['financial_stress_score'] = (
    df['employment_duration_stability'] * 0.4 + 
    df['savings_score'] * 0.3 - 
