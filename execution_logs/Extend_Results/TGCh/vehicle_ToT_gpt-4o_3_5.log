### Step 1: Create a new feature CIRCULARITY_COMPACTNESS_RATIO
python
# CIRCULARITY_COMPACTNESS_RATIO
# Ratio of CIRCULARITY to COMPACTNESS, providing insight into the balance between surface-to-area shape characteristics.
# Usefulness: This feature could help in distinguishing between vehicle types with differing proportions, such as a BUS with a larger surface area distribution versus a VAN which is more compact.
df['CIRCULARITY_COMPACTNESS_RATIO'] = df['CIRCULARITY'] / df['COMPACTNESS']
end

---

### Step 2: Create a new feature SCALED_RADIUS_DIFFERENCE
python
# SCALED_RADIUS_DIFFERENCE
# Difference between RADIUS_RATIO and SCALED_RADIUS_OF_GYRATION, normalized by the mean of both features.
# Usefulness: This highlights shape variability by combining variability in radial measurements (RADIUS_RATIO) with the spatial distribution of mass (SCALED_RADIUS_OF_GYRATION). Wide disparities between these values may correspond to specific vehicle types.
df['SCALED_RADIUS_DIFFERENCE'] = abs(df['RADIUS_RATIO'] - df['SCALED_RADIUS_OF_GYRATION']) / \
                                  (df['RADIUS_RATIO'].mean() + df['SCALED_RADIUS_OF_GYRATION'].mean())
end

---

### Step 3: Create a binned feature PR.AXIS_ASPECT_RATIO_BINS
python
# PR.AXIS_ASPECT_RATIO_BINS
# Discretize PR.AXIS_ASPECT_RATIO into bins based on the statistical quartiles (Q1, Median, Q3).
# Usefulness: Binned values capture general trends in the aspect ratio distribution without relying on exact values. This may group vehicles with similar proportions, aiding classification.
df['PR.AXIS_ASPECT_RATIO_BINS'] = pd.cut(df['PR.AXIS_ASPECT_RATIO'], 
                                         bins=[0, 57, 62, 66, df['PR.AXIS_ASPECT_RATIO'].max()], 
                                         labels=['Low', 'Below_Avg', 'Above_Avg', 'High'])
end

---

