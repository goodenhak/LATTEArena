### Step 1: Compute debt_to_asset_ratio  
python
# debt_to_asset_ratio
# Feature description: Ratio of credit amount to assets inferred from property_magnitude. Map property categories to estimated values and divide credit amount by this estimate.
# Usefulness: This feature indicates how leveraged an individual is relative to their assets. Higher ratios indicate higher financial risk.
property_asset_mapping = {
    'no known property': 1,   # Lowest asset value
    'car': 2,                # Moderate asset value
    'life insurance': 3,     # Significant asset value
    'real estate': 4         # Highest asset value
}
df['debt_to_asset_ratio'] = df['credit_amount'] / df['property_magnitude'].map(property_asset_mapping)
end

### Step 2: Generate dependency_ratio  
python
# dependency_ratio
# Feature description: Ratio of the number of dependents to employment duration score. Employment duration categories are mapped to numeric values to estimate financial support capability.
# Usefulness: Higher dependency ratios indicate financial strain since dependents rely on the individual’s income, which, when low or unstable, increases credit risk.
employment_duration_mapping = {
    'unemployed': 0.5,     # No stability
    '<1': 1,               # Low stability
    '1<=X<4': 2,           # Moderate stability
    '4<=X<7': 3,           # High stability
    '>=7': 4               # Highest stability
}
df['employment_duration_score'] = df['employment'].map(employment_duration_mapping)
df['dependency_ratio'] = df['num_dependents'] / df['employment_duration_score']
end

### Step 3: Encode installment_commitment_bins  
python
# installment_commitment_bins
# Feature description: Categorize the installment commitment into bins to better represent percentage of disposable income devoted to loan installments.
# Usefulness: Capturing installment burden in bins simplifies the modeling process and provides insight into high-risk (high installment rate) vs. low-risk (low installment rate) groups.
df['installment_commitment_bins'] = pd.cut(df['installment_commitment'], bins=[0, 2, 3, 4], labels=['low', 'medium', 'high'])
end

