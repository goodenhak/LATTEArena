employment_duration_mapping = {
    'unemployed': 0.5,     # No stability
    '<1': 1,               # Low stability
    '1<=X<4': 2,           # Moderate stability
    '4<=X<7': 3,           # High stability
    '>=7': 4               # Highest stability
}
df['employment_duration_score'] = df['employment'].map(employment_duration_mapping)
df['dependency_ratio'] = df['num_dependents'] / df['employment_duration_score']
end

### Step 3: Encode installment_commitment_bins  
python
# installment_commitment_bins
# Feature description: Categorize the installment commitment into bins to better represent percentage of disposable income devoted to loan installments.
# Usefulness: Capturing installment burden in bins simplifies the modeling process and provides insight into high-risk (high installment rate) vs. low-risk (low installment rate) groups.
df['installment_commitment_bins'] = pd.cut(df['installment_commitment'], bins=[0, 2, 3, 4], labels=['low', 'medium', 'high'])
end

