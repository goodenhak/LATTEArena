python
# log_nO
# Logarithm transformation of the number of oxygen atoms (nO)
# Usefulness: nO directly affects biodegradability, but the range of values ([0, 12], Std = 1.8144) indicates possible skewness. A log transformation stabilizes variance, reduces the impact of extreme values, and can better capture nonlinear relationships.
df['log_nO'] = df['nO'].apply(lambda x: np.log(x + 1))  # Adding 1 to avoid log(0)
end

---

python
# ratio_SdO_nC
# Ratio of the sum of dO E-states (SdO) to the number of heavy carbon atoms (nC)
# Usefulness: This ratio reflects the distribution of electronic states of oxygen relative to the molecule's carbon backbone. Oxygen and carbon interactions are critical to biodegradability, and this feature can help identify those relationships.
df['ratio_SdO_nC'] = df['SdO'] / (df['nC'] + 1e-9)  # Adding a small value to prevent division by zero
end

---

python
# binary_nHDon
# Binary indicator for the presence of donor atoms for H-bonds (nHDon)
# Usefulness: Molecules with donor atoms for hydrogen bonds often have higher reactivity and may influence biodegradability. Turning this into a binary feature simplifies its interpretability and highlights its presence or absence during classification.
df['binary_nHDon'] = df['nHDon'].apply(lambda x: 1 if x > 0 else 0)
end

