# Usefulness: This ratio highlights the relationship between oxygen (reactive element) and hydrogen-bond donors, which are crucial for molecular biodegradability. This interaction could capture latent chemical properties related to biodegradation.
df['ratio_nO_nHDon'] = df['nO'] / (df['nHDon'] + 1e-10)  # Small constant to prevent division by zero
end

python
# binary_oxygen_rich
# Binary indicator for oxygen-rich molecules (nO > 3)
# Usefulness: Molecules with a greater number of oxygen atoms are often more reactive and biodegradable. Creating a binary feature simplifies capturing this relationship, making it interpretable for the model.
df['binary_oxygen_rich'] = df['nO'].apply(lambda x: 1 if x > 3 else 0)
end

