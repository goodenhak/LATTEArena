# Feature name: cyclomatic_density
# Feature description: Measures the density of cyclomatic complexity ('v(g)') relative to the total lines of code ('loc').
# Usefulness: Highlights whether modules have disproportionately high logical complexity (v(g)) packed into relatively few lines of code. Dense complexity can intuitively indicate modules more prone to defects.
df['cyclomatic_density'] = df['v(g)'] / (df['loc'] + 1e-5)
end

python
# Feature name: branch_per_operator
# Feature description: Ratio of branch count ('branchCount') to Halstead's total operators + operands ('n').
# Usefulness: Assesses how frequently branches occur in relation to operations and operands in the code. Higher values may indicate excessive branching decisions, which adds complexity and defect risks.
df['branch_per_operator'] = df['branchCount'] / (df['n'] + 1e-5)
end

python
# Feature name: halstead_effort_to_time_ratio
# Feature description: Ratio of Halstead's effort ('e') to Halstead's time estimate ('t').
# Usefulness: Indicates whether the computational effort required for a task corresponds proportionally to the estimated time. Disproportionate values may signal inefficiencies or potential challenges in the implementation, which could lead to defects.
df['halstead_effort_to_time_ratio'] = df['e'] / (df['t'] + 1e-5)
end

python
# Explanation why the column 'l'
# The 'l' column (Halstead program length) is redundant as it is derived from other Halstead metrics (e.g., 'n', 'v') which are directly used in other engineered features. Removing 'l' reduces potential multicollinearity.
df.drop(columns=['l'], inplace=True)
end

python
# Explanation why the column 'lOComment'
# The 'lOComment' (lines of comments) column has low variability, with most values being zero or close to zero. Its relevance is better captured in derived features like 'comment_completeness', so it can be safely removed.
df.drop(columns=['lOComment'], inplace=True)
end

python
# Explanation why the column 'b'
# The 'b' column (Halstead number of delivered bugs) is a theoretical estimate not observed directly in the dataset. It may introduce noise, and the goal is to predict actual defect presence based on other quantifiable metrics.
df.drop(columns=['b'], inplace=True)
end
