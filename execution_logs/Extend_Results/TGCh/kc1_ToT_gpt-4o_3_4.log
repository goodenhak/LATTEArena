# Usefulness: Modules with many decision points per line of code are often more prone to defects, since branching increases complexity.
df['branch_loc_ratio'] = df['branchCount'] / (df['loc'] + 1e-5)
end

python
# unique_operator_to_operands_ratio
# The ratio of unique operators ('uniq_Op') to unique operands ('uniq_Opnd').
# Usefulness: A higher ratio indicates that operators dominate over operands, often corresponding to very formulaic or abstract code. This could highlight modules with unusual or error-prone coding styles.
df['unique_operator_to_operands_ratio'] = df['uniq_Op'] / (df['uniq_Opnd'] + 1e-5)
end

python
# loc_with_comments_ratio
# The ratio of lines of code with comments ('lOCode') to total code lines ('loc').
# Usefulness: Code with sufficient documentation can often be less defect-prone as it is easier to review and maintain.
df['loc_with_comments_ratio'] = df['lOCode'] / (df['loc'] + 1e-5)
end

