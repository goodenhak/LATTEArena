pply mathematical transformations to essential attributes for normalization or non-linear effects\n\npython\n# Feature name: sqrt_SM6_L\n# Feature description: Square root transformation of SM6_L (Spectral moment of order 6 from Laplace matrix).\n# Usefulness: Captures diminishing returns or non-linear contributions of larger SM6_L values toward biodegradability prediction.\ndf['sqrt_SM6_L'] = df['SM6_L']  0.5\nend\n\npython\n# Feature name: log_SdO\n# Feature description: Log transformation of SdO (Sum of dO E-states).\n# Usefulness: This transformation reduces the impact of extreme values for highly-skewed data such as SdO (mean = 9.03, std = 11.79) while retaining its relationship to biodegradability.\ndf['log_SdO'] = np.log1p(df['SdO'])  # Logarithm with +1 to avoid results of -inf for zero values.\nend\n\npython\n# Feature name: zscore_HyWi_B(m)\n# Feature description: Z-score normalization of HyWi_B(m) (Hyper-Wiener-like index weighted by mass).\n# Usefulness: Normalizing features with varying scales can improve model performance by ensuring consistent treatment of feature value ranges.\ndf['zscore_HyWi_B(m)'] = (df['HyWi_B(m)'] - df['HyWi_B(m)'].mean()) / df['HyWi_B(m)'].std()\nend\n\n---\n\n#### Step 3: Create categorical and binary features to simplify complex structures\n\npython\n# Feature name: binary_nN_presence\n# Feature description: Binary column indicating whether nN (number of Nitrogen atoms) is greater than zero.\n# Usefulness: Nitrogen presence or absence often correlates with chemical reactivity and biodegradability. Binary encoding simplifies this relationship.\ndf['binary_nN_presence'] = (df['nN'] > 0).astype(int)\nend\n\npython\n# Feature name: categorical_C_quartile\n# Feature description: Categorical column derived by binning the C% (percentage of Carbon atoms) into quartiles.\n# Usefulness: Assigns categories to chemicals based on their carbon content to detect any structural dependency with biodegradability.\ndf['categorical_C_quartile'] = pd.qcut(df['C%'], q=4, labels=['Low', 'Medium', 'High', 'Very High'])\nend\n\npython\n# Feature name: binary_high_nHM\n# Feature description: Binary column indicating whether nHM (number of heavy atoms) is greater than the dataset median.\n# Usefulness: Heavy atoms impact molecular complexity and may influence biodegradability. Binary encoding simplifies the contribution.\ndf['binary_high_nHM'] = (df['nHM'] > df['nHM'].median()).astype(int)\nend\n\n---\n\n#### Step 4: Drop irrelevant or low-variance columns\n\npython\n# Explanation why the column B04[C-Br] is dropped\n# B04[C-Br] (Presence/absence of C-Br at topological distance 4) is dropped due to its extremely low mean (0.0205) and sparse occurrence, adding negligible value to the model.\ndf.drop(columns=['B04[C-Br]'], inplace=True)\nend\n\npython\n# Explanation why the column nCRX3 is dropped\n# nCRX3 (Number of CRX3 chemical groups) is dropped as it has low variance (mean = 0.0253, median = 0) and sparse occurrences, making it irrelevant for biodegradability classification.\ndf.drop(columns=['nCRX3'], inplace=True)\nend\n\npython\n# Explanation why the column Psi_i_1d is dropped\n# Psi_i_1d (Intrinsic state pseudoconnectivity index - type 1d) is dropped due to its negligible mean (0.0) and very low standard deviation (0.1568), indicating limited variability.\ndf.drop(columns=['Psi_i_1d'], inplace=True)\nend", "python\n# Feature name: normalized_interaction_SpMax_L_J_Dz_e\n# Feature description: Interaction feature between SpMax_L and J_Dz(e), normalized by their individual scales.\n# Usefulness: Since SpMax_L and J_Dz(e) summarize structural and electronegativity properties, normalizing their interaction can ensure consistent scaling while capturing joint effects significant for biodegradability.\ndf['normalized_interaction_SpMax_L_J_Dz_e'] = (df['SpMax_L'] * df['J_Dz(e)']) / (df['SpMax_L'].std() * df['J_Dz(e)'].std())\nend\n\npython\n# Feature name: log_transformed_total_nitrogen_groups\n# Feature description: Applies a logarithmic transformation to the total nitrogen groups (nN, nN-N, nArNO2, N-073).\n# Usefulness: Nitrogen-related groups heavily influence biodegradability. Log transformation can reduce skewness from high-count nitrogen features and allow the model to focus on relative variations.\ndf['total_nitrogen_groups'] = df['nN'] + df['nN-N'] + df['nArNO2'] + df['N-073']\ndf['log_transformed_total_nitrogen_groups'] = np.log1p(df['total_nitrogen_groups'])\nend\n\npython\n# Feature name: ratio_nO_C_percent_sqrt\n# Feature description: Square root of the ratio between the number of oxygen atoms and the percentage of carbon atoms.\n# Usefulness: A strong interdependence between oxygen and carbon affects reactivity. Taking the square root balances the impact of extreme values and allows smaller variations to be captured better.\ndf['ratio_nO_C_percent_sqrt'] = np.sqrt(df['nO'] / (df['C%'] + 1e-6))  # Add small constant to avoid division by zero.\nend\n\npython\n# Explanation why the column B01[C-Br] is dropped\n# Reason: B01[C-Br] is highly sparse with a mean value of 0.03, and most entries are 0. Its contribution to explaining variability is limited.\ndf.drop(columns=['B01[C-Br]'], inplace=True)\nend\n\npython\n# Explanation why the column nCRX3 is dropped\n# Reason: nCRX3 has low variance with a mean near 0 and is unlikely to contribute to distinguishing biodegradability classes.\ndf.drop(columns=['nCRX3'], inplace=True)\nend\n\npython\n# Explanation why the column Psi_i_1d is dropped\n# Reason: Psi_i_1d has near-zero variance with a mean of 0 and an extremely small standard deviation, making it irrelevant for predictive modeling.\ndf.drop(columns=['Psi_i_1d'], inplace=True)\nend", "python\n# Step 1: Interaction Terms - Add square root-based interaction of SpMax_L and J_Dz(e)\n# Feature name: sqrt_interaction_SpMax_L_J_Dz_e\n# Feature description: Square root of the product of SpMax_L (Leading eigenvalue from Laplace matrix) and J_Dz(e) (Balaban-like index based on electronegativity).\n# Usefulness: Captures non-linear interactions between molecular descriptors SpMax_L and J_Dz(e). The square root balances extreme values while preserving the interpretability of their joint effect.\ndf['sqrt_interaction_SpMax_L_J_Dz_e'] = np.sqrt(df['SpMax_L'] * df['J_Dz(e)'])\nend\n\npython\n# Step 2: Ratio Features - Compare ratios between complementary features\n# Feature name: nHM_to_C_percent_ratio\n# Feature description: Ratio of the number of heavy atoms (nHM) to the percentage of Carbon atoms (C%).\n# Usefulness: Heavy atoms relative to carbon concentration could signify molecular size and composition complexity, essential for assessing biodegradability.\ndf['nHM_to_C_percent_ratio'] = df['nHM'] / (df['C%'] + 1e-6)  # Add a small constant to avoid division by zero.\nend\n\npython\n# Step 3: Categorization - Bin the number of halogen atoms into low, medium, and high\n# Feature name: halogen_category\n# Feature description: A categorical feature derived by binning nX (number of halogen atoms) into three categories: Low (0), Medium (1-10), and High (>10).\n# Usefulness: Simplifies interpretation and helps the model analyze halogen count as discrete chemical groups, which can influence molecular reactivity and degradation potential.\ndf['halogen_category'] = pd.cut(\n    df['nX'],\n    bins=[-1, 0, 10, float('inf')],\n    labels=['Low', 'Medium', 'High']\n)\nend\n\npython\n# Explanation why the column B01[C-Br] is dropped\n# Reason: B01[C-Br] (Presence/absence of C-Br at topological distance 1) is highly sparse (mean = 0.03) and provides minimal information to the model due to lack of variation.\ndf.drop(columns=['B01[C-Br]'], inplace=True)\nend\n\npython\n# Explanation why the column nCRX3 is dropped\n# Reason: nCRX3 (number of CRX3 chemical groups) has very low variance (mean = 0.0253, median = 0.0) and is unlikely to contribute significantly to classification.\ndf.drop(columns=['nCRX3'], inplace=True)\nend\n\npython\n# Explanation why the column Psi_i_1d is dropped\n# Reason: Psi_i_1d (Intrinsic state pseudoconnectivity index - type 1d) has near-zero variance (mean = 0, std = 0.1568), making it irrelevant for the model.\ndf.drop(columns=['Psi_i_1d'], inplace=True)\nend", "### Step 1: Create Interaction Features to Capture Relationships Between Key Attributes\n\npython\n# Feature name: interaction_C_nO\n# Feature description: Product of C% (percentage of Carbon atoms) and nO (number of oxygen atoms).\n# Usefulness: Carbon and oxygen contents are key contributors to molecular decomposition. This interaction may highlight structures conducive to biodegradability.\ndf['interaction_C_nO'] = df['C%'] * df['nO']\nend\n\npython\n# Feature name: interaction_SpMax_L_F03_C_N\n# Feature description: Product of SpMax_L (Leading eigenvalue from Laplace matrix) and F03[C-N] (frequency of C-N at topological distance 3).\n# Usefulness: Combines the molecular connectivity metric with bond frequencies, potentially offering insight into joint effects driving biodegradability.\ndf['interaction_SpMax_L_F03_C_N'] = df['SpMax_L'] * df['F03[C-N]']\nend\n\npython\n# Feature name: ratio_nO_nN\n# Feature description: Ratio of nO (number of oxygen atoms) to nN (number of nitrogen atoms).\n# Usefulness: The oxygen-to-nitrogen ratio may indicate how reactive and degradable the molecule is given the importance of oxygen and nitrogen in chemical breakdown.\ndf['ratio_nO_nN'] = df['nO'] / (df['nN'] + 1e-6)  # Add small constant to avoid division by zero\nend\n\n---\n\n### Step 2: Apply Mathematical Transformations to Handle Skewness and Non-linear Effects\n\npython\n# Feature name: log_SM6_L\n# Feature description: Log transformation of SM6_L (Spectral moment of order 6 from Laplace matrix).\n# Usefulness: Reduces skewed distribution in SM6_L, enabling the model to better capture relationships within its range.\ndf['log_SM6_L'] = np.log1p(df['SM6_L'])  # Use log1p to avoid issues with zero values\nend\n\npython\n# Feature name: sqrt_SdO\n# Feature description: Square root transformation of SdO (Sum of dO E-states).\n# Usefulness: Reduces the impact of extreme or outlier values in SdO while highlighting smaller variations that may be significant for biodegradability prediction.\ndf['sqrt_SdO'] = np.sqrt(df['SdO'])\nend\n\npython\n# Feature name: zscore_HyWi_B_m\n# Feature description: Z-score normalization of HyWi_B(m) (Hyper-Wiener-like index weighted by mass).\n# Usefulness: Normalizes the feature range, ensuring consistent treatment of features with varying scales in the downstream model.\ndf['zscore_HyWi_B_m'] = (df['HyWi_B(m)'] - df['HyWi_B(m)'].mean()) / df['HyWi_B(m)'].std()\nend\n\n---\n\n### Step 3: Create Binary and Categorical Features for Simplification\n\npython\n# Feature name: binary_nN_presence\n# Feature description: Binary feature indicating whether Nitrogen atoms (nN) are present.\n# Usefulness: Nitrogen atom presence can significantly affect biodegradability, making its presence/absence a useful simplified feature.\ndf['binary_nN_presence'] = (df['nN'] > 0).astype(int)\nend\n\npython\n# Feature name: categorical_C_percent\n# Feature description: Categorizes C% (percentage of Carbon atoms) into quartiles.\n# Usefulness: Groups chemicals based on carbon content, capturing structural dependencies related to biodegradability.\ndf['categorical_C_percent'] = pd.qcut(df['C%'], q=4, labels=['Low', 'Medium', 'High', 'Very High'])\nend\n\npython\n# Feature name: binary_high_nHM\n# Feature description: Binary column indicating whether the number of heavy atoms (nHM) exceeds the dataset's median.\n# Usefulness: Simplifies the relationship between heavy atom counts and biodegradability by categorizing it into high/low groups.\ndf['binary_high_nHM'] = (df['nHM'] > df['nHM'].median()).astype(int)\nend\n\n---\n\n### Step 4: Drop Irrelevant or Low-Variance Columns\n\npython\n# Explanation why the column B04[C-Br] is dropped\n# B04[C-Br] is highly sparse with a mean of 0.02, and most values are zero. It adds negligible value to distinguishing biodegradability classes.\ndf.drop(columns=['B04[C-Br]'], inplace=True)\nend\n\npython\n# Explanation why the column nCRX3 is dropped\n# nCRX3 has low variance (mean = 0.025, mostly zeros), making it irrelevant for predictive modeling.\ndf.drop(columns=['nCRX3'], inplace=True)\nend\n\npython\n# Explanation why the column Psi_i_1d is dropped\n# Psi_i_1d has near-zero variance (mean = 0.0, low standard deviation = 0.1568), offering limited contribution to the target task.\ndf.drop(columns=['Psi_i_1d'], inplace=True)\nend", "### Step 1: Generate Interaction Features to Capture Relationships Between Key Attributes\n\npython\n# Feature name: interaction_nO_C_percent\n# Feature description: Product of nO (number of oxygen atoms) and C% (percentage of Carbon atoms).\n# Usefulness: Oxygen plays a significant role in the biodegradability of chemical compounds, especially in organic compounds with high carbon content. This interaction helps capture the interplay between oxygen and carbon components in the molecular structure.\ndf['interaction_nO_C_percent'] = df['nO'] * df['C%']\nend\n\npython\n# Feature name: interaction_SpMax_L_J_Dz_e\n# Feature description: Product of SpMax_L (Leading eigenvalue from Laplace matrix) and J_Dz(e) (Balaban-like index based on electronegativity).\n# Usefulness: Captures the combined effects of molecular structure and electronegativity. SpMax_L and J_Dz(e) represent complementary descriptors of molecular shape and electronic distribution, and their interaction could highlight significance in biodegradability prediction.\ndf['interaction_SpMax_L_J_Dz_e'] = df['SpMax_L'] * df['J_Dz(e)']\nend\n\npython\n# Feature name: ratio_nO_total_N\n# Feature description: Ratio of nO (number of oxygen atoms) to total_nitrogen_groups (sum of nitrogen-related features such as nN, nN-N, nArNO2, N-073).\n# Usefulness: The oxygen-to-nitrogen ratio can provide insight into the balance of oxygen and nitrogen components in the chemical structure, which strongly impacts biodegradability.\ndf['total_nitrogen_groups'] = df['nN'] + df['nN-N'] + df['nArNO2'] + df['N-073']\ndf['ratio_nO_total_N'] = df['nO'] / (df['total_nitrogen_groups'] + 1)  # Adding 1 to avoid division by zero\nend\n\n---\n\n### Step 2: Apply Mathematical Transformations to Skewed Features for Normalization or Non-linear Relationships\n\npython\n# Feature name: log_SdO\n# Feature description: Logarithmic transformation of SdO (Sum of dO E-states).\n# Usefulness: SdO is skewed with a high mean and standard deviation. Log transformation reduces skewness, ensures stable predictions, and emphasizes variations in lower-valued ranges relevant to biodegradability.\ndf['log_SdO'] = np.log1p(df['SdO'])  # Using log1p to avoid -inf for zero values\nend\n\npython\n# Feature name: sqrt_SM6_L\n# Feature description: Square root transformation of SM6_L (Spectral moment of order 6 from Laplace matrix).\n# Usefulness: Reduces extreme values for larger SM6_L, allowing models to capture smaller but potentially significant variations in spectral moments affecting biodegradability.\ndf['sqrt_SM6_L'] = np.sqrt(df['SM6_L'])\nend\n\npython\n# Feature name: zscore_HyWi_B_m\n# Feature description: Z-score normalization of HyWi_B(m) (Hyper-Wiener-like index weighted by mass).\n# Usefulness: HyWi_B(m) is a scaled structural index that exhibits varying scales across the dataset. Standardizing this feature ensures consistent contribution across a predictive model.\ndf['zscore_HyWi_B_m'] = (df['HyWi_B(m)'] - df['HyWi_B(m)'].mean()) / df['HyWi_B(m)'].std()\nend\n\n---\n\n### Step 3: Drop Unnecessary or Low-Variance Columns\n\npython\n# Explanation why the column Psi_i_1d is dropped\n# Psi_i_1d (Intrinsic state pseudoconnectivity index - type 1d) has a negligible mean of 0.0 and an extremely low standard deviation (0.1568), indicating near-constant values with no significant variability.\ndf.drop(columns=['Psi_i_1d'], inplace=True)\nend\n\npython\n# Explanation why the column B04[C-Br] is dropped\n# B04[C-Br] (Presence/absence of C-Br at topological distance 4) is highly sparse, with a mean of 0.0205 and most values being zero. This adds negligible value in predicting biodegradability.\ndf.drop(columns=['B04[C-Br]'], inplace=True)\nend\n\npython\n# Explanation why the column nCRX3 is dropped\n# nCRX3 (Number of CRX3 chemical groups) has low variance with a mean of 0.0253 and a median of 0.0. Its sparse occurrence makes it irrelevant for the downstream biodegradability prediction tasks.\ndf.drop(columns=['nCRX3'], inplace=True)\nend", "python\n# Feature name: ratio_nO_C_percent\n# Feature description: Ratio of the number of oxygen atoms (nO) to the percentage of carbon atoms (C%).\n# Usefulness: Oxygen contributes to biodegradability, and its relationship to carbon content can signal the balance of organic and oxidized traits in chemical structures.\ndf['ratio_nO_C_percent'] = df['nO'] / (df['C%'] + 1e-6)  # Adding a small constant to prevent division by zero.\nend\n\npython\n# Feature name: interaction_SpMax_L_F04_C_N\n# Feature description: Product of SpMax_L (Leading eigenvalue from Laplace matrix) and F04[C-N] (Frequency of C-N at topological distance 4).\n# Usefulness: Captures the interaction between molecular connectivity and specific chemical bond frequency, which may highlight structures prone to biodegradability.\ndf['interaction_SpMax_L_F04_C_N'] = df['SpMax_L'] * df['F04[C-N]']\nend\n\npython\n# Feature name: log_SdO\n# Feature description: Logarithmic transformation of SdO (Sum of dO E-states).\n# Usefulness: Reduces the impact of extreme values, given that this feature is highly skewed (mean = 9.03, std = 11.79), while preserving smaller variations critical to biodegradability predictions.\ndf['log_SdO'] = np.log1p(df['SdO'])  # Use log1p to avoid issues with zero values.\nend\n\npython\n# Explanation why the column B04[C-Br] is dropped\n# Reason: B04[C-Br] (Presence/absence of C-Br at topo