# Step 1: Generate interaction features using ratios between key attributes
# Feature: nO_to_nC_ratio
# Feature description: Creates a ratio of the number of oxygen atoms (nO) to carbon percentage (C%) to capture the relative oxygen content in the chemical structure.
# Usefulness: This feature could help understand the oxygen contribution relative to carbon in biodegradability, as oxygen is often involved in chemical breakdown processes.
df['nO_to_nC_ratio'] = df['nO'] / (df['C%'] + 1e-6)  # Add a small constant to avoid division by zero.

# Feature: nHDon_to_nHM_ratio
# Feature description: Ratio of the number of H-bond donors (nHDon) to the number of heavy atoms (nHM).
# Usefulness: More active hydrogen donors relative to heavy atoms may indicate a higher propensity for certain chemical reactivity pathways associated with biodegradability.
df['nHDon_to_nHM_ratio'] = df['nHDon'] / (df['nHM'] + 1e-6)  # Add a small constant to avoid division by zero.

# Feature: SpMax_L_to_SdssC_ratio
# Feature description: Ratio of the leading eigenvalue from Laplace matrix (SpMax_L) to the sum of dssC E-states (SdssC).
# Usefulness: Captures the interaction of spectral properties with E-state properties, which could be linked to molecular stability or reactivity.
df['SpMax_L_to_SdssC_ratio'] = df['SpMax_L'] / (df['SdssC'].abs() + 1e-6)  # Use absolute value to handle negative SdssC values.
end

python
# Step 2: Apply mathematical transformations to specific columns to capture nonlinear relationships
# Feature: sqrt_SM6_L
# Feature description: Square root transformation of the spectral moment of order 6 from Laplace matrix (SM6_L).
# Usefulness: Helps model potential diminishing/nonlinear effects of larger SM6_L values on biodegradability.
df['sqrt_SM6_L'] = df['SM6_L'].apply(np.sqrt)

# Feature: log_HyWi_B(m)
# Feature description: Log transformation of Hyper-Wiener-like index (HyWi_B(m)).
# Usefulness: Reduces the skewness in this feature and might highlight significant relationships for certain feature ranges.
df['log_HyWi_B(m)'] = df['HyWi_B(m)'].apply(lambda x: np.log(x + 1e-6))  # Add a small constant to handle zero values.

# Feature: zscore_LOC
# Feature description: Z-score normalization of lopping centric index (LOC).
# Usefulness: Standardized features with highly varying ranges like LOC might help in downstream modeling, assisting models to treat different scales consistently.
df['zscore_LOC'] = (df['LOC'] - df['LOC'].mean()) / df['LOC'].std()
end

