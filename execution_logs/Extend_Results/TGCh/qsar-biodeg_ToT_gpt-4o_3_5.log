###'python
# Step 1: Interaction Terms - Multiply related features to capture joint effects
# Feature name: interaction_SpMax_L_J_Dz_e
# Feature description: Captures the interaction between SpMax_L (Leading eigenvalue from Laplace matrix) and J_Dz(e) (Balaban-like index based on electronegativity).
# Usefulness: These two molecular descriptors summarize different structural and electronegativity properties. Interaction terms often capture non-linear relationships that the model may not pick up directly.
df['interaction_SpMax_L_J_Dz_e'] = df['SpMax_L'] * df['J_Dz(e)']

# Feature name: interaction_nO_C_percent
# Feature description: Product of nO (number of oxygen atoms) and C% (percentage of Carbon atoms).
# Usefulness: Oxygen and carbon counts are molecular composition metrics. The combination can signal specific structural configurations (e.g., ratio of organic vs. oxidized components) that might impact biodegradability.
df['interaction_nO_C_percent'] = df['nO'] * df['C%']

# Step 2: Transformation of Features - Apply logarithmic scaling to skewed columns
# Feature name: log_F03_C_O
# Feature description: Logarithm of F03[C-O] (frequency of C-O at a topological distance 3).
# Usefulness: The original F03[C-O] feature has high skew (mean = 3.65, std = 4.43). Applying log transformation reduces the impact of extreme values and enhances the feature’s interpretability.
df['log_F03_C_O'] = np.log1p(df['F03[C-O]'])
end

python
# Step 3: Aggregations Based on Nitrogen-Groups - Summarize nitrogen chemical groups and their interactions
# Feature name: total_nitrogen_groups
# Feature description: Sum of all nitrogen-related descriptors: nN (number of nitrogen atoms), nN-N (number of hydrazines), nArNO2 (number of aromatic nitro groups), etc.
# Usefulness: This captures a holistic count of nitrogen-related properties in the molecule, which is significant because nitrogen groups affect how chemicals degrade in the environment.
df['total_nitrogen_groups'] = (
    df['nN'] + df['nN-N'] + df['nArNO2'] + df['N-073']
)

# Feature name: ratio_nO_total_N
# Feature description: Ratio of nO (number of oxygen atoms) to total_nitrogen_groups.
# Usefulness: The interplay between oxygen and nitrogen components influences the chemical's reactivity and potential for biodegradability.
df['ratio_nO_total_N'] = df['nO'] / (df['total_nitrogen_groups'] + 1)  # Adding 1 to avoid division by zero
end

python
# Drop unnecessary or less informative columns
# Explanation why the column F01[N-N] is dropped
# F01[N-N] (frequency of N-N at topological distance 1) is dropped because its mean is very close to 0 (mean = 0.0474), its median is also 0, and it shows very little variance, making it unlikely to contribute much to the model.
df.drop(columns=['F01[N-N]'], inplace=True)

# Explanation why the column B01[C-Br] is dropped
# B01[C-Br] (presence/absence of C-Br at topological distance 1) is dropped because the feature is highly sparse (mean = 0.03, most values = 0) and may not offer sufficient contribution toward biodegradability prediction.
df.drop(columns=['B01[C-Br]'], inplace=True)

# Explanation why the column nCRX3 is dropped
# nCRX3 (number of CRX3 chemical groups) is dropped because it is sparse (mean = 0.0253, median = 0), and its relevance to chemical degradation is unclear without additional evidence of significance from feature importance.
df.drop(columns=['nCRX3'], inplace=True)
end'###

