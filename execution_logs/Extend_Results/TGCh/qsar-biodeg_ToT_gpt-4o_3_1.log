# Step 1: Generate additional interaction features
# Interaction between nHDon (number of donor atoms for H-bonds) and nO (Number of oxygen atoms)
df['nHDon_nO_interaction'] = df['nHDon'] * df['nO']
# Feature description: Captures interaction between donor atoms for hydrogen bonds and the number of oxygen atoms, which are both critical in biochemical reactions.
