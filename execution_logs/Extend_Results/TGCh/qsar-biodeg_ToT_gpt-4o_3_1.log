# Step 2: Apply statistical transformations to improve feature distributions
# Z-score normalization on SM6_L (Spectral moment of order 6 from Laplace matrix)
df['zscore_SM6_L'] = (df['SM6_L'] - df['SM6_L'].mean()) / df['SM6_L'].std()
# Feature description: Z-score normalization centers and scales SM6_L, which may have domain-specific variations being a molecular connectivity index.
# Usefulness: Improves feature scaling and makes this feature more comparable with other descriptors, which can improve model efficiency.

# Log transformation on nCIR (Number of circuits)
df['log_nCIR'] = np.log1p(df['nCIR'])
# Feature description: Log transformation reduces skewness in the distribution of the number of circuits, which is likely highly right-skewed due to its range (0 to 147) and high variability.
# Usefulness: Improves feature usability by reducing outliers’ effect and ensuring all values contribute meaningfully to the model.

# Sine transformation on SpMax_A (Leading eigenvalue from adjacency matrix)
df['sine_SpMax_A'] = np.sin(df['SpMax_A'])
# Feature description: Applies sine transformation to capture periodicity or oscillatory patterns in SpMax_A values, which might relate to molecular symmetry.
# Usefulness: Such transformations can capture additional periodic patterns that may be related to molecular properties influencing biodegradability.
end

