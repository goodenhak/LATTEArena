python
# FEATURE 1: RATIO_OF_COMPACTNESS_TO_DISTANCE_CIRCULARITY
# Feature description: This feature computes the ratio between 'COMPACTNESS' and 'DISTANCE_CIRCULARITY'.
# Usefulness: COMPACTNESS and DISTANCE_CIRCULARITY are related to the object's geometry and border characteristics. Their ratio could reveal specific shape or proportional traits that are indicative of the type of vehicle (e.g., more compact shapes may relate to smaller vehicles like OPEL or SAAB, while less compact ones align closer with BUS or VAN).
df['RATIO_OF_COMPACTNESS_TO_DISTANCE_CIRCULARITY'] = df['COMPACTNESS'] / (df['DISTANCE_CIRCULARITY'] + 1e-5)
end

python
# FEATURE 2: SCALED_RADIUS_OF_GYRATION_NORMALIZED
# Feature description: Normalize 'SCALED_RADIUS_OF_GYRATION' by dividing it by the SCALED_VARIANCE_ALONG_MAJOR_AXIS.
# Usefulness: This will capture the relative spread of the shape in relation to its scaled major axis variance. Vehicles with different shape characteristics (e.g., elongated vs. compact) are expected to show variation in this ratio, providing insight into the overall structural symmetry or asymmetry of the vehicle's silhouette.
df['SCALED_RADIUS_OF_GYRATION_NORMALIZED'] = df['SCALED_RADIUS_OF_GYRATION'] / (df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] + 1e-5)
end

python
# FEATURE 3: LOG_SCALED_VARIANCE_RATIO
# Feature description: Compute the logarithm of the ratio between 'SCALED_VARIANCE_ALONG_MINOR_AXIS' and 'SCALED_VARIANCE_ALONG_MAJOR_AXIS'.
# Usefulness: By taking the log of this ratio, we can detect asymmetrical characteristics between the major and minor axes. For example, vehicles like BUS and VAN might have greater asymmetry compared to smaller cars like OPEL or SAAB. The log transformation reduces skewness and amplifies fine differences.
df['LOG_SCALED_VARIANCE_RATIO'] = np.log((df['SCALED_VARIANCE_ALONG_MINOR_AXIS'] + 1) / (df['SCALED_VARIANCE_ALONG_MAJOR_AXIS'] + 1e-5))
end

