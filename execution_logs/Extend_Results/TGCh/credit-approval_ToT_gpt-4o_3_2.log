python
# Feature 2: Employment Stability Group
# Feature description: Categorizes applicants into buckets based on YearsEmployed. Buckets: Unemployed (<1 year), ShortTerm (1-3 years), MediumTerm (3-10 years), LongTerm (>10 years).
# Usefulness: Employment duration is a critical signal for financial stability. Categorization makes it easier for the model to generalize patterns and identify trends relevant to creditworthiness.
def employment_stability_group(years):
    if years < 1:
        return 'Unemployed'
    elif years <= 3:
        return 'ShortTerm'
    elif years <= 10:
        return 'MediumTerm'
    else:
        return 'LongTerm'

df['Employment_Stability_Group'] = df['YearsEmployed'].apply(employment_stability_group)
end

python
