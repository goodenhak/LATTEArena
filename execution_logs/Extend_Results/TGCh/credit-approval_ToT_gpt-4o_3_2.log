df['Debt_to_Income'] = df['Debt'] / (df['Income'] + 1e-6)
end

python
# Age Group Buckets
# Feature description: Categorizes Age into buckets such as Teenager, YoungAdult, MidAge, and Senior based on thresholds (18, 30, 50, and 75, respectively).
# Usefulness: Age often affects financial behavior and credit approval likelihood. Bucketing Age simplifies the feature and makes it more interpretable for the model, enabling it to identify trends across different age groups.
def age_bucket(age):
    if age < 18:
        return 'Teenager'
    elif age < 30:
        return 'YoungAdult'
    elif age < 50:
        return 'MidAge'
    else:
        return 'Senior'

df['Age_Group'] = df['Age'].apply(age_bucket)
end

python
# Credit Risk Indicator
# Feature description: Interaction between PriorDefault and CreditScore. Captures if an applicant has a prior default and a CreditScore less than the dataset's median. Calculated as PriorDefault * (CreditScore < median(CreditScore)), where (CreditScore < median) is binary (0 or 1).
# Usefulness: Applicants with prior defaults and poor credit scores represent significant risk. This feature highlights key risk indicators explicitly for the model.
credit_score_median = df['CreditScore'].median()
df['Credit_Risk_Indicator'] = df['PriorDefault'] * (df['CreditScore'] < credit_score_median).astype(int)
end

