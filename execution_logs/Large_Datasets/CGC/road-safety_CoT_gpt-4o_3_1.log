# Usefulness: Certain regions may have distinct age demographics, and normalizing captures locality-specific patterns aiding prediction.

df['Driver_age_normalized_by_region'] = df.groupby('Local_Authority_(District)')['Age_of_Driver'].transform(lambda x: (x - x.mean()) / x.std())
end

python
# Feature name: Casualty_age_ratio
