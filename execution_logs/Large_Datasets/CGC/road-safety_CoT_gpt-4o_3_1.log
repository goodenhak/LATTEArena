# Feature: Vehicle_Type_binary
# Feature description: Bin the Vehicle_Type into a binary feature: 1 for Small_vehicle and 0 for others.
# Usefulness: Collapsing Vehicle_Type_extended_binning into a binary feature that segregates small vehicles from larger ones can help simplify and generalize the feature. Vehicle size/type might correlate with driver demographics and risk proclivity based on societal norms.
df['Vehicle_Type_binary'] = df['Vehicle_Type_extended_binning'].apply(lambda x: 1 if x == 'Small_vehicle' else 0)
end

