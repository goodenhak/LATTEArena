# Driver_age_vehicle_age_interaction
# Feature description: Captures the interaction between driver age and vehicle age by multiplying 'Age_of_Driver' and 'Age_of_Vehicle'. This emphasizes possible age-related preferences for older/newer vehicles.
# Usefulness: Provides a metric that examines how the driver's age correlates to vehicle age, which might indirectly relate to driving style and sex (e.g., older drivers may prefer older vehicles, and younger drivers newer vehicles).
df['Driver_age_vehicle_age_interaction'] = df['Age_of_Driver'] * df['Age_of_Vehicle']
end

python
# Vehicle_Type_casualty_interaction
# Feature description: Crosses 'Vehicle_Type_extended_binning' (categorical) with 'Sex_of_Casualty' to create unique bins dependent on vehicle type and casualty sex.
# Usefulness: Links the type of vehicle to casualty sex, offering insights into whether certain vehicle types are more likely associated with male/female casualties that could influence driver sex prediction.
df['Vehicle_Type_casualty_interaction'] = df['Vehicle_Type_extended_binning'].astype(str) + _ + df['Sex_of_Casualty'].astype(str)
end

python
# Driver_age_engine_capacity_ratio
# Feature description: Calculates the ratio of 'Age_of_Driver' to 'Engine_Capacity_(CC)'. This feature assesses whether older/younger drivers tend to operate vehicles with higher/lower engine capacities.
# Usefulness: Engine sizes might show correlations with driver demographics tied to sex (e.g., larger engines associated with different gender preferences).
df['Driver_age_engine_capacity_ratio'] = df['Age_of_Driver'] / df['Engine_Capacity_(CC)']
end

python
# Logistic_ratio_driver_to_casualty_age
# Feature description: Applies a sigmoid transformation to the ratio 'Casualty_age_ratio' (Age_of_Casualty divided by Age_of_Driver) to compress values into a probabilistic range (0,1).
# Usefulness: Helps understand how relative age differences between drivers and casualties skew towards specific ranges that may indirectly correlate with driver sex.
df['Logistic_ratio_driver_to_casualty_age'] = 1 / (1 + np.exp(-df['Casualty_age_ratio']))
end

python
# Severity_density_ratio_normalized
# Feature description: Combines 'Accident_density_ratio' with 'Severity_context_avg' using a weighted ratio and normalizes it.
# Usefulness: Provides an accident-by-region specific calculation that assesses whether severity differences by density correlate with driver sex. For instance, regions with denser traffic may yield skewed sex-based predictions.
df['Severity_density_ratio_normalized'] = (df['Accident_density_ratio'] / df['Severity_context_avg']) / df['Severity_context_avg'].mean()
end

python
# Driver_age_zscore_cross_normalized_region
# Feature description: Combines 'Driver_age_normalized_by_region' with 'Age_of_Driver_zscore' using a cross-product for normalization by region's mean age and z-score scale.
# Usefulness: Involves contextual-normalized metrics capturing both raw and standardized age values, exploring region-level influence on driver demographics and sex predictions.
df['Driver_age_zscore_cross_normalized_region'] = df['Driver_age_normalized_by_region'] * df['Age_of_Driver_zscore']
end

python
# Vehicle_manouvre_casualty_interaction
# Feature description: Crosses 'Vehicle_Manoeuvre' with 'Casualty_Type' to examine unique combinations of maneuver and casualty behavior patterns.
# Usefulness: Provides insights into interaction patterns of the vehicle involved and casualty behavior, which indirectly relates to driver profiles and sex predictions.
df['Vehicle_manouvre_casualty_interaction'] = df['Vehicle_Manoeuvre'].astype(str) + _ + df['Casualty_Type'].astype(str)
end

python
# Rural_urban_interaction_factor
# Feature description: Combines 'Urban_engine_capacity' and 'Vehicle_Type_extended_binning' with 'Accident_density_ratio' using a weighted formula.
# Usefulness: Focuses on rural vs. urban density for specific vehicle types to analyze their impact across locations, indirectly tied to driver sex patterns.
df['Rural_urban_interaction_factor'] = (df['Urban_engine_capacity'] * df['Accident_density_ratio']) / df['Urban_engine_capacity'].mean()
end

