# Driver_age_techsavviness
# Feature description: Computes the ratio between Age_of_Driver and the square root of Urban_engine_capacity.
# Usefulness: Younger drivers are more likely to use modern cars with higher engine capacity for urban environments. This feature captures potential differences in driver preferences related to gender.
df['Driver_age_techsavviness'] = df['Age_of_Driver'] / (df['Urban_engine_capacity']  0.5)
end

python
# High_engine_capacity_indicator
# Feature description: Binary indicator for whether Engine_Capacity_(CC) exceeds the upper third quartile (1968cc).
# Usefulness: Captures potential differences in preferences for powerful vehicles among genders.
df['High_engine_capacity_indicator'] = (df['Engine_Capacity_(CC)'] > 1968).astype(int)
end

python
# Vehicle_Manoeuvre_binned
# Feature description: Bins Vehicle_Manoeuvre into fewer categories such as stationary (1-4), maneuvering (5-10), and overtaking (11-18).
# Usefulness: Aggregates specific maneuvers into broader groups to identify behavioral trends that may be correlated with gender.
df['Vehicle_Manoeuvre_binned'] = pd.cut(df['Vehicle_Manoeuvre'], bins=[0, 4, 10, 18], labels=['Stationary', 'Maneuvering', 'Overtaking'])
end

python
# Driver_engagement_propensity
# Feature description: Normalizes Driver_vehicle_engagement_ratio within each Propulsion_Code using group-wise z-scoring.
# Usefulness: Quantifies how engaged a driver is with their vehicle on a relative basis across propulsion system types, potentially correlating with gender-related preferences.
df['Driver_engagement_propensity'] = df.groupby('Propulsion_Code')['Driver_vehicle_engagement_ratio'].transform(
    lambda x: (x - x.mean()) / x.std())
end

python
# Age_Driver_Casualty_match_ratio
# Feature description: Finds the ratio of Driver_age_to_vehicle_age_difference and Driver_age_casualty_age_diff.
# Usefulness: Discerns the relative differences in ages of drivers, the vehicles they drive, and the casualties—an indirect measure of interplay across those factors.
df['Age_Driver_Casualty_match_ratio'] = df['Driver_age_to_vehicle_age_difference'] / (df['Driver_age_casualty_age_diff'] + 1)
end

python
# Accident_severity_scaled
# Feature description: Log-transform the Accident_severity_factor for normalizing its distribution.
# Usefulness: Helps reduce the skewness of accident severity data, making it easier to identify potential relationships with driver gender.
df['Accident_severity_scaled'] = np.log1p(df['Accident_severity_factor'])
end

python
# Engine_Capacity_Factor
# Feature description: Calculates the ratio of Engine_Capacity_(CC) to Age_of_Vehicle to identify the influence of vehicle specifications with respect to their age.
# Usefulness: This feature captures preferences for more recent vehicles with larger or smaller engine capacities, which may correlate with gender-related tendencies.
df['Engine_Capacity_Factor'] = df['Engine_Capacity_(CC)'] / (df['Age_of_Vehicle'] + 1)
end

python
# Age_Driver_to_Casualty_Ratio_zscore
# Feature description: Z-score standardization of the Casualty_ratio_driver_age_band feature.
# Usefulness: Normalizes the relative age ratio to compare drivers and casualties across regions. May highlight differences in male vs. female drivers’ likelihood of injuring others.
df['Age_Driver_to_Casualty_Ratio_zscore'] = (df['Casualty_ratio_driver_age_band'] - df['Casualty_ratio_driver_age_band'].mean()) / df['Casualty_ratio_driver_age_band'].std()
end

python
# Male_engine_preference
# Feature description: Custom target encoding to normalize Engine_Capacity_(CC) against Sex_of_driver=1 (e.g., male).
# Usefulness: Adapts the Engine_sexual_norm by segmenting engine preferences within and across genders.
df['Male_engine_preference'] = (df['Engine_Capacity_(CC)'] - df[df['Sex_of_Casualty'] == 1]['Engine_Capacity_(CC)'].mean()) / (
                                df[df['Sex_of_Casualty'] == 1]['Engine_Capacity_(CC)'].std() + 1e-5)
end

