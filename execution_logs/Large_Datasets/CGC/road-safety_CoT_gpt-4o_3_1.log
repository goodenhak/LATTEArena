# Usefulness: Vehicle-Casualty interactions can capture relationships where certain vehicle choices might align with specific casualty trends, which may indirectly reflect drivers’ demographics.

df['Vehicle_Type_Casualty_Interaction'] = df['Vehicle_Type_extended_binning'].astype(str) + '_' + df['Casualty_Type'].astype(str)
end

python
# Age_Band_match_intensity
# Feature description: Multiplies 'Age_Band_match_casualty_driver' with 'Driver_age_casualty_age_diff' to weigh age band matches by the absolute difference in casualty age and driver age.
# Usefulness: Capturing intensity within matches provides insight beyond binary matches, incorporating age differences to refine sex prediction.

df['Age_Band_match_intensity'] = df['Age_Band_match_casualty_driver'] * df['Driver_age_casualty_age_diff']
end

python
# Casualty_age_norm_by_sex
# Feature description: Target-encodes 'Casualty_age_ratio' based on the mean of 'Sex_of_Casualty' to emphasize sex-specific casualty-driver age patterns.
# Usefulness: Normalizing casualty-driver age differences by sex could reflect behavioral or driving patterns that relate to the driver's sex.

df['Casualty_age_norm_by_sex'] = df.groupby('Sex_of_Casualty')['Casualty_age_ratio'].transform('mean')
end

python
# Engine_per_driver_age_zscore
# Feature description: Calculates the z-score normalization of the ratio between 'Engine_Capacity_(CC)' and 'Age_of_Driver' to capture scaled dynamics between driver age and engine capacity.
# Usefulness: Engine capacity relationships normalized by driver age may align with demographic trends reflective of driver preferences by sex.

df['Engine_per_driver_age_zscore'] = (
    (df['Engine_Capacity_(CC)'] / df['Age_of_Driver']) - 
    (df['Engine_Capacity_(CC)'] / df['Age_of_Driver']).mean()
) / (df['Engine_Capacity_(CC)'] / df['Age_of_Driver']).std()
end

python
# Accident_density_with_police
# Feature description: Multiplies 'Accident_density_ratio' by 'Police_Force' to generate an interaction feature emphasizing accident density contextualized by law enforcement.
# Usefulness: Centralizing accident characteristics alongside police presence may highlight patterns indirectly related to driver sex, such as enforcement trends.

df['Accident_density_with_police'] = df['Accident_density_ratio'] * df['Police_Force']
end

