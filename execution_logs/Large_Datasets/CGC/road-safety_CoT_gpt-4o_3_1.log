# Feature name: Accident_severity_factor
# Feature description: Combines multiple features such as 'Number_of_Casualties', 'Vehicle_Manoeuvre', and 'Hit_Object_off_Carriageway' using a weighted formula to assess overall accident severity.
# Usefulness: Integrated accident severity measure helps models focus on high-risk scenarios that correlate strongly with driver gender distinctions.

df['Accident_severity_factor'] = (0.4 * df['Number_of_Casualties']) + (0.3 * df['Vehicle_Manoeuvre']) + (0.3 * df['Hit_Object_off_Carriageway'])
