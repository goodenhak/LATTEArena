# Vehicle_Type_normalized
# Feature description: Normalizes 'Vehicle_Type' based on its z-score across the dataset to better represent its deviations from the mean.
# Usefulness: Provides a standardized scaling for 'Vehicle_Type', enhancing model interpretability and sensitivity to outlier vehicle types.
df['Vehicle_Type_normalized'] = (df['Vehicle_Type'] - df['Vehicle_Type'].mean()) / df['Vehicle_Type'].std()
end

python
# Driver_age_to_vehicle_age_interaction
# Feature description: Creates an interaction term between 'Age_of_Driver' and 'Age_of_Vehicle' via multiplication.
# Usefulness: This captures potential dependencies between driver age and vehicle age in relation to accident occurrences.
df['Driver_age_to_vehicle_age_interaction'] = df['Age_of_Driver'] * df['Age_of_Vehicle']
end

python
# Driver_vehicle_age_difference_squared
# Feature description: Squares 'Driver_age_to_vehicle_age_difference' to emphasize larger differences.
# Usefulness: Larger driver-vehicle age differences may have nonlinear correlations with driver behavior or accident dynamics.
df['Driver_vehicle_age_difference_squared'] = df['Driver_age_to_vehicle_age_difference']  2
end

python
# Accident_severity_normalized
# Feature description: Applies min-max normalization to 'Accident_severity_factor' to scale values between 0 and 1.
# Usefulness: Enhances comparability across accidents while keeping the relative context of severity intact.
df['Accident_severity_normalized'] = (df['Accident_severity_factor'] - df['Accident_severity_factor'].min()) / (df['Accident_severity_factor'].max() - df['Accident_severity_factor'].min())
end

python
# Engine_Capacity_by_Vehicle_Type
# Feature description: Calculates the average 'Engine_Capacity_(CC)' per 'Vehicle_Type' using groupbythenmean.
# Usefulness: Adds contextual understanding of typical engine capacities for specific vehicle types in the dataset.
df['Engine_Capacity_by_Vehicle_Type'] = df.groupby('Vehicle_Type')['Engine_Capacity_(CC)'].transform('mean')
end

python
# Casualty_driver_age_ratio_tangent
# Feature description: Applies tangent transformation to 'Casualty_age_ratio' to capture non-linear relationships.
# Usefulness: Age ratios between casualty and driver may have more complex effects on accident outcomes, which tangent can capture.
df['Casualty_driver_age_ratio_tangent'] = df['Casualty_age_ratio'].apply(np.tan)
end

python
# Engine_Capacity_to_severity_ratio
# Feature description: Generates a ratio between 'Engine_Capacity_(CC)' and 'Accident_severity_factor'.
# Usefulness: Larger or smaller engine capacities may interact differently with accident severity, providing predictive insights.
df['Engine_Capacity_to_severity_ratio'] = df['Engine_Capacity_(CC)'] / (df['Accident_severity_factor'] + 1)
end

python
# Normalized_local_authority_density
# Feature description: Calculates 'Accident_density_ratio' normalized by district-level 'Local_Authority_(District)'.
# Usefulness: Provides a contextual view of accident density variation across different regions to improve predictions.
df['Normalized_local_authority_density'] = df['Accident_density_ratio'] / df.groupby('Local_Authority_(District)')['Accident_density_ratio'].transform('mean')
end

python
# Driver_age_sex_interaction
# Feature description: Combines 'Age_of_Driver' and 'Sex_of_Casualty' to create interaction terms via multiplication.
# Usefulness: Captures possible dependencies of driver age and accident outcomes on the casualty's sex.
df['Driver_age_sex_interaction'] = df['Age_of_Driver'] * df['Sex_of_Casualty']
end

python
# Small_vehicle_accident_factor
# Feature description: Creates a binary feature indicating if the vehicle type falls under 'Small_vehicle' and accident severity exceeds the mean.
# Usefulness: Indicates patterns specific to small vehicles and more severe accidents.
df['Small_vehicle_accident_factor'] = np.where((df['Vehicle_Type_extended_binning'] == 'Small_vehicle') & (df['Accident_severity_factor'] > df['Accident_severity_factor'].mean()), 1, 0)
end

python
df.drop(columns=['Engine_Capacity_zscore', 'Age_of_Driver_zscore', 'Propulsion_Code'], inplace=True)
