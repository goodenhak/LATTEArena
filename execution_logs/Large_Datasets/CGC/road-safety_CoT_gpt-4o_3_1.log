python
# Age_of_Driver_zscore
# Feature description: Z-score standardization for 'Age_of_Driver' to normalize values across its range by mean and standard deviation.
# Usefulness: Helps downstream models better interpret driver age by mapping it to a standard scale. Variations in driver age may correlate strongly to driver sex prediction.
df['Age_of_Driver_zscore'] = (df['Age_of_Driver'] - df['Age_of_Driver'].mean()) / df['Age_of_Driver'].std()
end

python
# Engine_Capacity_zscore
# Feature description: Z-score standardization for 'Engine_Capacity_(CC)' to normalize engine size variability across its range.
# Usefulness: Larger engines might be correlated with male drivers (traditionally associated with purchasing higher performance vehicles), making it useful for prediction.
df['Engine_Capacity_zscore'] = (df['Engine_Capacity_(CC)'] - df['Engine_Capacity_(CC)'].mean()) / df['Engine_Capacity_(CC)'].std()
end

python
# Age_Driver_to_Vehicle
# Feature description: A ratio comparing 'Age_of_Driver' with 'Age_of_Vehicle', calculated as Age_of_Driver divided by Age_of_Vehicle.
# Usefulness: Drivers of younger vehicles might exhibit different preferences and behaviors compared to older vehicles. This may provide strong input features to differentiate driver sex.
df['Age_Driver_to_Vehicle'] = df['Age_of_Driver'] / (df['Age_of_Vehicle'] + 1)  # Adding 1 to avoid division by zero
end

python
# Latitude_Longitude_distance_from_mean
# Feature description: Calculates the Euclidean distance between the accident location and the mean location of accidents (based on latitude and longitude).
# Usefulness: Geographical locations may reveal strong demographic indicators. Sex of drivers might show regional variation due to cultural or socioeconomic factors.
mean_latitude = df['Latitude'].mean()
mean_longitude = df['Longitude'].mean()
df['Latitude_Longitude_distance_from_mean'] = ((df['Latitude'] - mean_latitude)  2 + (df['Longitude'] - mean_longitude)  2)  0.5
end

python
# Urban_rural_area_one_hot
# Feature description: Creates one-hot encoded columns for 'Urban_or_Rural_Area', splitting the binary categorical variable into separate features.
# Usefulness: Urban/rural driving environments may influence driver sex correlation due to differences in vehicle distribution or cultural variability.
df = pd.concat([df, pd.get_dummies(df['Urban_or_Rural_Area'], prefix='Urban_rural_area')], axis=1)
end

python
# Vehicle_Type_extended_binning
# Feature description: Bins 'Vehicle_Type' into categorical groups (e.g., small cars, trucks, motorcycles, buses) based on type range differences.
# Usefulness: Helps assign semantic understanding to vehicle types, as driver sex prediction might correlate strongly with preferred vehicle.
vehicle_bins = pd.cut(df['Vehicle_Type'], bins=[0, 9, 20, 50, 98], labels=['Small_vehicle', 'Truck_van', 'Motorcycle', 'Other'])
df['Vehicle_Type_extended_binning'] = vehicle_bins
end

python
# Police_Force_frequency_encoding
# Feature description: Encodes 'Police_Force' based on accident frequencies associated with each force. Creates a new column to capture weight for prediction.
# Usefulness: Reflects the regional law enforcement zone's accident patterns. Area differences might show variations in male vs. female drivers.
df['Police_Force_frequency_encoding'] = df['Police_Force'].map(df['Police_Force'].value_counts() / len(df))
end

python
# Engine_Capacity_binned_segment
# Feature description: Creates bins for 'Engine_Capacity_(CC)', dividing it into different segments (e.g., low, medium, high engine capacities).
# Usefulness: Allows segmentation based on engine capacity, with larger engines potentially associated with specific gender preferences.
df['Engine_Capacity_binned_segment'] = pd.cut(df['Engine_Capacity_(CC)'], bins=[0, 1500, 2000, 10000], labels=['Low', 'Medium', 'High'])
end

python
# Age_Band_match_casualty_driver
# Feature description: Binary variable indicating if the age bands of the driver and casualty match. If equal, assigns 1; else 0.
# Usefulness: Measures correlation between the driver's age demographic and the casualty's age demographic. Gender impact might emerge from relationship patterns.
df['Age_Band_match_casualty_driver'] = (df['Age_Band_of_Driver'] == df['Age_Band_of_Casualty']).astype(int)
end

python
# Sex_of_Casualty_encoding
# Feature description: Applies one-hot encoding for the 'Sex_of_Casualty' column.
# Usefulness: Casualty gender data might provide indirect clues about driver sex, particularly in accidents involving multiple individuals.
df = pd.concat([df, pd.get_dummies(df['Sex_of_Casualty'], prefix='Sex_of_Casualty')], axis=1)
end

