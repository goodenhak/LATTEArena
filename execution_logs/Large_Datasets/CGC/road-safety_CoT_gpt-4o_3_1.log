# Driver_vehicle_engagement_ratio
# Calculates the ratio between 'Driver_age_to_vehicle_age_difference' and 'Age_of_Vehicle' to assess how the driver's age difference with the vehicle age relates to the actual vehicle age.
# Usefulness: Represents the driver's age alignment with the age of the vehicle they operate, which might differ by sex, as younger drivers may operate newer or older vehicles based on availability or preference.
df['Driver_vehicle_engagement_ratio'] = df['Driver_age_to_vehicle_age_difference'] / (df['Age_of_Vehicle'] + 1e-5)
end

python
# Accident_density_ratio
# Combines 'Number_of_Casualties', 'Number_of_Vehicles', and 'Accident_severity_factor' to assess the relationship between accident density and its severity.
# Usefulness: Captures interactions between accident inertia variables, which may reflect behavior patterns related to driver sex during an incident.
df['Accident_density_ratio'] = df['Accident_severity_factor'] / (df['Number_of_Casualties'] * df['Number_of_Vehicles'])
end

python
# Driver_age_casualty_age_diff
# Calculates the absolute difference between the driver's age ('Age_of_Driver') and the casualty's age ('Age_of_Casualty').
# Usefulness: Indicates the generational gap that could influence behavioral dynamics between drivers and casualties, potentially related to sex of the driver.
df['Driver_age_casualty_age_diff'] = abs(df['Age_of_Driver'] - df['Age_of_Casualty'])
end

python
# Normalized_vehicles_per_region
# Normalizes 'Number_of_Vehicles' by the total mean vehicles in each 'Local_Authority_(District)' using groupbythenmean.
# Usefulness: Captures regional variance in vehicle counts per accident and how this might correlate with different driver demographics and their sex.
df['Normalized_vehicles_per_region'] = df['Number_of_Vehicles'] / df.groupby('Local_Authority_(District)')['Number_of_Vehicles'].transform('mean')
end

python
# Vehicle_manouvre_propulsion_interaction
# Crosses 'Vehicle_Manoeuvre' with 'Propulsion_Code' to create distinct patterns based on vehicle maneuverability and propulsion type.
# Usefulness: Different sex-based driving styles might correspond to specific propulsion-maneuver combinations.
df['Vehicle_manouvre_propulsion_interaction'] = df['Vehicle_Manoeuvre'].astype(str) + '_' + df['Propulsion_Code'].astype(str)
end

python
# Engine_sexual_norm
# Uses the mean 'Engine_Capacity_(CC)' per 'Sex_of_Casualty' to create a target-encoded feature.
# Usefulness: Reflects combinations of engine size preference based on casualty sex, which might correlate indirectly to the driver's sex.
engine_capacity_by_sex = df.groupby('Sex_of_Casualty')['Engine_Capacity_(CC)'].transform('mean')
df['Engine_sexual_norm'] = (df['Engine_Capacity_(CC)'] - engine_capacity_by_sex) / (engine_capacity_by_sex + 1e-5)
end

python
# Urban_engine_capacity
# Multiplies 'Urban_or_Rural_Area' and 'Engine_Capacity_density' to create a feature that emphasizes urban-rural differences in engine capacity.
# Usefulness: Highlights how rural vs. urban locations interact with vehicle attributes, which could differ by sex of the driver due to contextual driving preferences.
df['Urban_engine_capacity'] = df['Urban_or_Rural_Area'] * df['Engine_Capacity_density']
end

python
# Casualty_ratio_driver_age_band
# Combines 'Casualty_age_ratio' and 'Age_Band_match_casualty_driver' to generate a weighted factor measuring casualty-driver age relationships.
# Usefulness: Represents differences in interactions between casualties and drivers based on their age proximity, potentially varying by driver sex.
df['Casualty_ratio_driver_age_band'] = df['Casualty_age_ratio'] * (df['Age_Band_match_casualty_driver'] + 1)
end

python
# Severity_context_avg
# Computes rolling mean of 'Accident_severity_factor' by 'Local_Authority_(District)' as a proxy for district-level severity norms.
# Usefulness: Captures how accident severity within a region modifies driving behavior, potentially linking this to the driver's sex.
df['Severity_context_avg'] = df.groupby('Local_Authority_(District)')['Accident_severity_factor'].transform(lambda x: x.rolling(window=3, min_periods=1).mean())
end

python
# Driver_age_vehicle_age_relative
# Divides 'Age_of_Driver_zscore' by 'Age_of_Vehicle' to create a relative driver-to-vehicle age z-score.
# Usefulness: Measures whether older drivers (by z-score) tend to drive newer or older vehicles, potentially associated with sex-driven preferences.
df['Driver_age_vehicle_age_relative'] = df['Age_of_Driver_zscore'] / (df['Age_of_Vehicle'] + 1e-5)
end

