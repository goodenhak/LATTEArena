# Feature name: Engine_Capacity_per_Number_of_Vehicles
# Feature description: Calculates the average engine capacity per vehicle in the accident by dividing total engine capacity by the number of vehicles involved.
# Usefulness: Measures engine capacity relative to the density of vehicles in an accident which can impact dynamics or severity.

df['Engine_Capacity_per_Number_of_Vehicles'] = df['Engine_Capacity_(CC)'] / df['Number_of_Vehicles']
