# rank_deviation
# Feature description: Calculates the deviation of each card's rank from the median rank of the hand (absolute difference) and takes the mean deviation to represent consistency in rank distribution.
# Usefulness: This feature is useful for identifying hands with consistent ranks (e.g., straight, straight flush, royal flush) as they will have low rank deviation.

df['rank_deviation'] = df[['V2', 'V6', 'V10', 'max_card_rank']].apply(lambda row: abs(row - row.median()), axis=1).mean(axis=1)
end

python
# suit_consistency
# Feature description: Counts the number of unique suits within the hand. A flush (e.g., flush, straight flush, royal flush) will always have a suit consistency of 1.
# Usefulness: Detects consistency of suits within the hand, useful for identifying flush-related poker hands.

df['suit_consistency'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].nunique(axis=1)
end

python
# rank_diversity_ratio
# Feature description: Calculates the ratio of unique ranks to total cards in the hand (5 cards).
# Usefulness: Helps identify hands dominated by repeated ranks (e.g., pair, two pairs, three of a kind, four of a kind, full house).

df['rank_diversity_ratio'] = df[['V2', 'V6', 'V10']].nunique(axis=1) / 5
end

python
# straight_potential
# Feature description: Checks if the maximum rank in the hand minus the minimum rank equals 4 and if all ranks are unique, indicating a potential straight.
# Usefulness: Identifies hands that almost fulfill the requirements for a straight, even if the 'is_straight' feature evaluates to False (e.g., Ace can connect low or high scenarios).

df['straight_potential'] = (df['max_card_rank'] - df[['V2', 'V6', 'V10']].min(axis=1) == 4) & (df[['V2', 'V6', 'V10']].nunique(axis=1) == 5)
end

python
# rare_card_rank
# Feature description: Checks if the hand includes ranks >=12 (Queen or King).
# Usefulness: High-ranking cards (Queen, King, Ace) are important for identifying high-value poker hands like royal flush, straight, or full house.

df['rare_card_rank'] = df[['V2', 'V6', 'V10']].apply(lambda x: any(rank >= 12 for rank in x), axis=1)
end

python
# combined_suit_rank_consistency
# Feature description: Multiplies suit_consistency with rank_diversity_ratio to capture hands balancing suit uniformity and rank diversity.
# Usefulness: Provides additional context for hands like straight flush and royal flush which depend on both suit uniformity and rank positioning.

df['combined_suit_rank_consistency'] = df['suit_consistency'] * df['rank_diversity_ratio']
end

python
df.drop(columns=['has_two_pairs'], inplace=True)
end

python
# rank_pair_distinctiveness
# Feature description: Measures the distinctiveness of pairs within the hand by counting the occurrences of ranks with exactly 2 cards.
# Usefulness: Adds detailed information for detecting hands with specific pair configurations like one pair or two pairs.

df['rank_pair_distinctiveness'] = df[['V2', 'V6', 'V10']].apply(lambda x: sum(x.value_counts() == 2), axis=1)
end
