# Feature name: rank_differences
# Feature description: Calculate the absolute differences between card ranks for all adjacent pairs to understand sequential gaps.
# Usefulness: Helps detect whether ranks are sequential and aids in identifying Straight and Straight Flush hands more robustly for prediction models.

df['rank_diff_1_2'] = abs(df['V2'] - df['V6'])
df['rank_diff_2_3'] = abs(df['V6'] - df['V10'])
df['rank_diff_3_4'] = abs(df['V10'] - df['max_card_rank'])
df['rank_diff_4_5'] = abs(df['max_card_rank'] - df['V2'])
end

