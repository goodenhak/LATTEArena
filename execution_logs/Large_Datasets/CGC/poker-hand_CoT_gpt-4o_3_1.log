# mean_card_rank
# Feature description: Calculates the mean rank of the cards in the hand. This helps capture the general 'value' of the cards in the hand, which might be correlated with stronger combinations like a high card or higher-ranked hands.
# Usefulness: Quantifies the overall strength of the hand using ranks. It provides a statistical summary feature that can help the model learn from patterns involving average card strengths.
df['mean_card_rank'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].mean(axis=1)
end

python
# std_card_rank
# Feature description: Calculates the standard deviation of the card ranks in the hand. This feature helps understand the dispersion of card values and might relate to sequences (e.g., straights) or uniformity in ranks (e.g., pairs or full house).
# Usefulness: Provides variability information about card ranks. Lower std could indicate higher likelihood of pairs, three-of-a-kind, or other uniform combinations.
df['std_card_rank'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].std(axis=1)
end

python
# min_card_rank
# Feature description: Extracts the lowest card rank from the hand. This can be useful to detect low-ranked straights or hands with no high-value cards.
# Usefulness: Provides another measure of card strength and can help the model distinguish poker hands, especially for straights and high-card hands.
df['min_card_rank'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].min(axis=1)
end

python
# rank_range
# Feature description: Calculates the difference between the maximum rank and the minimum rank in a hand.
# Usefulness: Key feature for identifying straights and straight flushes. A rank difference of 4 with is_straight=True might indicate a straight/straight flush.
df['rank_range'] = df['max_card_rank'] - df['min_card_rank']
end

python
# same_suit_count
# Feature description: Calculates the number of cards that have the same suit in a hand.
# Usefulness: Extends the information provided by is_flush. Helps identify potential flushes (e.g., hands that are close to becoming a flush) and patterns not captured by is_flush alone.
df['same_suit_count'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(lambda x: x.value_counts().max(), axis=1)
end

python
# is_ace_high
# Feature description: Checks if the hand contains an Ace with a rank of 13. Usually, this is a strong card that could be indicative of strong hands, including Royal Flushes.
# Usefulness: Highlights the presence of a critical card (Ace), which plays an important role in high-value combinations like Royal Flush and is often a tiebreaker in other poker hands.
df['is_ace_high'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].eq(13).any(axis=1)
end

python
# sum_card_ranks
# Feature description: Sum of the ranks of all cards in the hand.
# Usefulness: Provides another way to summarize the overall strength of the hand in terms of card ranks and can help in differentiating high-value hands from random ones.
df['sum_card_ranks'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].sum(axis=1)
end

python
# has_high_card
# Feature description: Checks if the hand contains at least one card that has a rank 11 or higher (Jack, Queen, King, or Ace).
# Usefulness: Highlights the presence of face cards or an Ace, which are important for high-value hands or tiebreaking situations.
df['has_high_card'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: any(rank >= 11 for rank in x), axis=1)
end

python
# suit_spread
# Feature description: Calculates the number of unique suits present in the hand.
# Usefulness: Helps identify the likelihood of flushes since having more unique suits means a lower probability of a flush.
df['suit_spread'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(lambda x: len(set(x)), axis=1)
end

python
# diff_max_to_mean
# Feature description: Calculates the difference between the maximum card rank and the mean card rank for each hand.
# Usefulness: Helps differentiate high-value hands (where one card might stand out) from evenly spread or sequential hands.
df['diff_max_to_mean'] = df['max_card_rank'] - df['mean_card_rank']
end

python
# drop_multiple_suit_columns
df.drop(columns=['V1', 'V3', 'V5', 'V7', 'V9'], inplace=True)
end

python
# drop_redundant_categorical_features
df.drop(columns=['is_straight_flush'], inplace=True)
# Reason: Information in this feature is already captured by combining is_straight and is_flush.
end
