# Rank difference between highest and lowest card
# Feature description: Calculates the rank difference between the highest and lowest card. This feature provides insight into the spread of ranks in the hand, which is useful for identifying patterns like straights and evaluating tightness of rank distribution.
# Usefulness: Helps differentiate straight hands by considering the rank distribution's range. Larger gaps would indicate it's not a straight, while smaller gaps signal possible sequential ranks.
df['rank_diff'] = df['max_card_rank'] - df[['V2', 'V6', 'V10']].min(axis=1)
end

python
# Average rank of the cards
# Feature description: Calculates the average rank of the five cards in the hand. Provides a numerical summary of the rank distribution.
# Usefulness: Assists in identifying likely high-ranking combinations such as Royal Flush or Full House, as these would tend to have higher average rank values.
df['avg_card_rank'] = df[['V2', 'V6', 'V10']].mean(axis=1)
end

python
# Rank standard deviation
# Feature description: Calculates the standard deviation of the card ranks. Measures the spread of ranks in the hand.
# Usefulness: Helps differentiate hands like Full Houses (lower rank spread due to repeated ranks) from distributions like Nothing or Straights (higher spread for sequential hands).
df['rank_std_dev'] = df[['V2', 'V6', 'V10']].std(axis=1)
end

python
# Total suit diversity
# Feature description: Counts the number of unique suits in the hand.
# Usefulness: Differentiates Flush hands (all cards are the same suit, diversity = 1) from other hands with diverse suits (diversity > 1). Helps to identify potential Flush-related hands quickly.
df['suit_diversity'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].nunique(axis=1)
end

python
# Pair ratio
# Feature description: Calculates the ratio of total pairs in the hand to the total cards (5).
# Usefulness: Distinguishes hands with significant pair combinations like Two Pairs and Full House from less structured hands. Encourages signal discovery for rank-based patterns contributing directly to target predictions.
df['pair_ratio'] = (df['has_pair'].astype(int) + df['has_two_pairs'].astype(int)) / 5
end

python
# Adjusted max rank relative to mean rank
# Feature description: Computes the difference between the maximum rank of the hand and the average rank of its cards.
# Usefulness: Highlights cases where a single outstanding high card may contribute to advanced patterns like Royal Flush, Straight, or High Card.
df['max_rank_adj_mean'] = df['max_card_rank'] - df['avg_card_rank']
end

python
# Rank of card with the lowest suit value
# Feature description: Extracts the rank of the card that has the lowest suit value.
# Usefulness: Adds specific insights into card combinations by considering both rank and suit ordering, useful for hands like Flush or Straight Flush where suit consistency is critical.
df['lowest_suit_rank'] = df.loc[df[['V1', 'V3', 'V5', 'V7', 'V9']].idxmin(axis=1), ['V2', 'V6', 'V10']].values
end

