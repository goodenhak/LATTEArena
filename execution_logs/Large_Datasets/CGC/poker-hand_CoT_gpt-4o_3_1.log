# max_rank_minus_min_rank
# Feature description: Calculates the difference between the maximum and minimum rank in the hand, which provides information about the range of ranks in the hand. A small range indicates potential for a straight or a full house.
# Usefulness: This feature helps in identifying potential straights or tightly grouped hands, which are critical for predicting certain poker hands such as straights, straight flushes, or full houses.
df['max_rank_minus_min_rank'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].max(axis=1) - df[['V2', 'V4', 'V6', 'V8', 'V10']].min(axis=1)
end

python
# is_royal_flush
# Feature description: A binary feature that identifies if the hand is {10, Jack, Queen, King, Ace} + flush. Combines rank checking and suit matching for royal flush.
# Usefulness: Directly identifies royal flushes, which is the highest-ranked poker hand, and provides the model with information on this rare but significant category.
df['is_royal_flush'] = (
    df['is_straight_flush'] & 
    df['max_card_rank'].eq(13) & 
    df[['V2', 'V4', 'V6', 'V8', 'V10']].min(axis=1).eq(10)
)
end

python
# rank_range_zscore
# Feature description: Z-score normalization of max_rank_minus_min_rank to center and scale the range of ranks in the hand.
# Usefulness: Helps the model more effectively utilize the max_rank_minus_min_rank feature by normalizing it across potential values.
df['rank_range_zscore'] = (df['max_rank_minus_min_rank'] - df['max_rank_minus_min_rank'].mean()) / df['max_rank_minus_min_rank'].std()
end

python
# total_card_suit_variance
# Feature description: Calculates the variance of the suits of all cards in the hand. Lower variance suggests cards have a high likelihood of being the same suit.
# Usefulness: Provides a numerical indicator of whether the hand might form flush or straight flush combinations.
df['total_card_suit_variance'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].var(axis=1)
end

python
# is_low_card_straight
# Feature description: Determines if the hand is a low card straight {Ace, 2, 3, 4, 5} (Ace treated as 1).
# Usefulness: Specifically captures this unique straight pattern, which might not be identified solely by is_straight.
df['is_low_card_straight'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: set(x) == {1, 2, 3, 4, 5}, axis=1)
end

python
# harmonic_mean_rank
# Feature description: Calculates the harmonic mean of the card ranks within the hand. The harmonic mean emphasizes smaller values, which helps in distinguishing hands with tightly grouped lower ranks.
# Usefulness: Adds a nuanced perspective to the distribution of card ranks in the hand, particularly useful for detecting patterns in sequences.
df['harmonic_mean_rank'] = 5 / (1 / df['V2'] + 1 / df['V4'] + 1 / df['V6'] + 1 / df['V8'] + 1 / df['V10'])
end

python
# pair_to_fullhouse_ratio
# Feature description: Calculates the ratio of has_pair to is_full_house. If is_full_house is true, the ratio highlights the relationship between pairs and full houses.
# Usefulness: Provides additional information on the evolution from a pair pattern to a full house, which could improve separability of nearby categories.
df['pair_to_fullhouse_ratio'] = df['has_pair'].astype(int) / (df['is_full_house'].astype(int) + 1)
end

python
# scaled_max_card_rank
# Feature description: Min-max scales the max_card_rank between its observed range of 2-13 to normalize its distribution.
# Usefulness: Ensures the model can better use the maximum rank feature, as raw values may have outlier effects.
df['scaled_max_card_rank'] = (df['max_card_rank'] - 2) / (13 - 2)
end

python
df.drop(columns=['rank_range_zscore', 'pair_to_fullhouse_ratio'], inplace=True)
end
