# is_flush
# Feature description: Checks if all 5 cards have the same suit. A flush (including straight flush and royal flush) requires all cards to have identical suits.
# Usefulness: Useful for identifying flushes, straight flushes, and royal flushes. Adds domain knowledge by focusing on one of the key criteria for several poker hands.
df['is_flush'] = (df['V1'] == df['V3']) & (df['V3'] == df['V5']) & (df['V5'] == df['V7']) & (df['V7'] == df['V9'])
end

python
# card_rank_counts
# Feature description: Creates a dictionary of card ranks and their counts in each hand.
# Usefulness: Helps detect patterns such as pairs, two pairs, three of a kind, full house, or four of a kind by inspecting rank frequencies of the hand.
df['card_rank_counts'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda row: dict(row.value_counts()), axis=1)
end

python
# has_pair
# Feature description: Checks if the hand has at least one pair (a rank appears exactly twice).
# Usefulness: Directly helps identify hands with one pair, a fundamental building block for higher combinations like two pairs, full house, and four of a kind.
df['has_pair'] = df['card_rank_counts'].apply(lambda x: 2 in x.values())
end

python
# has_two_pairs
# Feature description: Checks if the hand has exactly two pairs (two ranks appear exactly twice).
# Usefulness: Indicates the presence of a two-pair hand, distinguishing between one pair and two pairs in poker evaluations.
df['has_two_pairs'] = df['card_rank_counts'].apply(lambda x: list(x.values()).count(2) == 2)
end

python
# has_three_of_a_kind
# Feature description: Checks if the hand has three cards of the same rank (a rank appears three times).
# Usefulness: Critical for identifying three of a kind and is also a component of higher combinations such as full house.
df['has_three_of_a_kind'] = df['card_rank_counts'].apply(lambda x: 3 in x.values())
end

python
# has_four_of_a_kind
# Feature description: Checks if the hand has four cards of the same rank.
# Usefulness: Helps identify four of a kind poker hands—a rare but critical category in the dataset's target labels.
df['has_four_of_a_kind'] = df['card_rank_counts'].apply(lambda x: 4 in x.values())
end

python
# is_full_house
# Feature description: Checks if a hand is a full house (one rank with three cards and another with two cards).
# Usefulness: Adds domain knowledge by detecting one of the complex poker hand types—a combination of three of a kind and one pair.
df['is_full_house'] = df['card_rank_counts'].apply(lambda x: sorted(x.values()) == [2, 3])
end

python
# is_straight
# Feature description: Checks if ranks of cards are sequential (Ace can be high or low). Assumes sorted ranks for simplicity.
# Usefulness: Critical for identifying straight, straight flush, and royal flush hands that rely on sequential ordering of ranks.
card_ranks_sorted = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(sorted, axis=1)
df['is_straight'] = card_ranks_sorted.apply(lambda x: all(x[i] + 1 == x[i + 1] for i in range(4)) or (x == [1, 10, 11, 12, 13]))  # Handles Ace-high/low cases.
end

python
# is_straight_flush
# Feature description: Checks if a hand is both a straight and a flush.
# Usefulness: Directly identifies straight flushes, a high-value poker hand type just below royal flush.
df['is_straight_flush'] = df['is_flush'] & df['is_straight']
end

python
# is_royal_flush
# Feature description: Checks if a hand is a royal flush—{Ace, King, Queen, Jack, Ten} all in the same suit.
# Usefulness: Directly detects royal flushes, the highest-ranking poker hand in the dataset. 
df['is_royal_flush'] = df['is_straight_flush'] & card_ranks_sorted.apply(lambda x: x == [1, 10, 11, 12, 13])
end

python
# max_card_rank
# Feature description: Extracts the highest card rank from the hand.
# Usefulness: Provides insight into the strength of the hand for cases like high card or tie-breaker situations.
df['max_card_rank'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].max(axis=1)
end

python
# drop_card_rank_counts
# Feature description: Drops the intermediate column used uniquely for creating combination features as it is no longer needed in the final dataset.
df.drop(columns=['card_rank_counts'], inplace=True)
end
