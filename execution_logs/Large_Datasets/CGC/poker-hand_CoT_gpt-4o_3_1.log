# Feature: rank_diff
# Feature description: Calculates the difference between the maximum card rank (max_card_rank) and the minimum rank of the cards in the hand (min(V2, V6, V8, V10)).
# Usefulness: This feature captures the spread of ranks in the hand, which is useful for identifying poker formations like straights (low difference) vs. random cards (high difference).
df['rank_diff'] = df['max_card_rank'] - df[['V2', 'V6', 'V8', 'V10']].min(axis=1)
end

python
# Feature: suit_count_mode
# Feature description: Calculates the mode of the suits in the hand (Hearts, Spades, Diamonds, Clubs). Represents the most frequent suit in the hand.
# Usefulness: Useful in detecting flush and its variations (e.g., straight flush, royal flush) since all cards in flush-type hands have the same suit.
df['suit_count_mode'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].mode(axis=1)[0]
end

python
# Feature: rank_std
# Feature description: Computes the standard deviation of the ranks of the cards in the hand (V2, V6, V8, V10).
# Usefulness: Helps measure the rank variability within the hand. Lower variability can indicate structured poker hands (like straights or sets), while higher variability suggests random cards.
df['rank_std'] = df[['V2', 'V6', 'V8', 'V10']].std(axis=1)
end

python
# Feature: suit_homogeneity
# Feature description: Checks how homogeneous the suits of the hand are (i.e., the number of unique suits divided by 5).
# Usefulness: Supports stronger feature generation for flush detection. A fully homogeneous hand (value = 0.2) could indicate flush-type hands; a higher value suggests a diverse suit deck.
df['suit_homogeneity'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].nunique(axis=1) / 5
end

python
# Feature: rank_sum
# Feature description: Calculates the total sum of the ranks of all 5 cards in the hand (V2, V6, V8, V10).
# Usefulness: Useful for capturing general score trends in the hand, especially for combinations like royal flush (which typically involves high-value cards).
df['rank_sum'] = df[['V2', 'V6', 'V8', 'V10']].sum(axis=1)
end

python
# Feature: rank_sine_sum
# Feature description: Calculates the sine transformation of ranks of each card in the hand and sums the resulting values.
# Usefulness: Non-linear transformations of ranked values help uncover hidden dependencies useful for encoding complex poker hand patterns.
df['rank_sine_sum'] = df[['V2', 'V6', 'V8', 'V10']].applymap(lambda x: np.sin(x)).sum(axis=1)
end

python
# Feature: special_rank_indicator
# Feature description: Checks if the hand consists of any of the special Royal Flush ranks (Ace = 1, King = 13, Queen = 12, Jack = 11, Ten = 10).
# Usefulness: Boost detection of royal flush configurations that have specific high-card ranks. Adds fine-grained feature extraction for mixed-scale datasets.
df['special_rank_indicator'] = df[['V2', 'V6', 'V8', 'V10']].applymap(lambda x: 1 if x in [1, 10, 11, 12, 13] else 0).sum(axis=1)
end

python
# Feature: rank_zscore_normalized
# Feature description: Normalizes each rank value by computing z-scores for V2, V6, V8, V10 across the dataset's rank distribution.
# Usefulness: Allows dataset-wide comparison of rank performance across varying scales, aiding model learning in rank-related poker hand distinctions.
for col in ['V2', 'V6', 'V8', 'V10']:
    df[f'{col}_zscore_normalized'] = (df[col] - df[col].mean()) / df[col].std()
end

python
# Dropping redundant columns (example)
# Description: Dropping columns not useful for predicting poker hand or are indirectly captured in engineered features.
df.drop(columns=['V1', 'V3'], inplace=True)  
end
