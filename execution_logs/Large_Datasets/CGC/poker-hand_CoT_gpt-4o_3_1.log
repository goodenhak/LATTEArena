# Feature name: rank_arithmetic_mean
# Feature description: Calculate the arithmetic mean of card ranks in the hand.
# Usefulness: Aggregates card rank information and can help identify patterns in rank distribution for different poker hands, assisting prediction of certain hands.

df['rank_arithmetic_mean'] = (df['V2'] + df['V6'] + df['V10'] + df['max_card_rank']) / 4
end

python
# Feature name: suit_distribution
# Feature description: Calculate the number of unique suits in the hand.
# Usefulness: Helps to determine flush-related hands and can be used as an additional feature to check suit homogeneity.

df['unique_suit_count'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].nunique(axis=1)
end

python
# Feature name: rank_standard_deviation
# Feature description: Calculates standard deviation of card ranks within each hand.
# Usefulness: Indicates rank variability and assists in differentiating between sequential vs non-sequential hands.

df['rank_standard_deviation'] = df[['V2', 'V6', 'V10', 'max_card_rank']].std(axis=1)
end

python
# Feature name: max_suit_count
# Feature description: Count the most frequent suit in a hand.
# Usefulness: Useful for aggregating suit information, assisting differentiation between Flush, Straight Flush, and Royal Flush hands.

df['max_suit_count'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(pd.Series.value_counts, axis=1).max(axis=1)
end

python
# Feature name: normalized_max_card_rank
# Feature description: Perform min-max normalization on the highest card rank in the hand.
# Usefulness: Useful for classification models that benefit from standardized feature scaling, making the models learn effectively.

df['normalized_max_card_rank'] = (df['max_card_rank'] - df['max_card_rank'].min()) / (df['max_card_rank'].max() - df['max_card_rank'].min())
end

python
# Feature name: flush_probability
# Feature description: Estimate the probability of a flush hand given suit distributions.
# Usefulness: Introduces probabilistic modeling to predict Flush hand types and supports downstream probabilistic classification tasks.

df['flush_probability'] = df['max_suit_count'] / 5
end

python
# Feature name: is_potential_royal_flush
# Feature description: Check if the hand meets the conditions for a potential Royal Flush (all ranks must be {10, Jack, Queen, King, Ace} and same suit).
# Usefulness: Directly targets the Royal Flush category and helps the model identify rare rows with high predictive value.

df['is_potential_royal_flush'] = (
    ((df['V2'] + df['V6'] + df['V10'] + df['max_card_rank']).isin([10, 11, 12, 13, 1])) & 
    (df['unique_suit_count'] == 1)
)
end

