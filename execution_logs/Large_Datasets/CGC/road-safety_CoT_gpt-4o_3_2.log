# Sex_of_Casualty_Binary
# Convert Sex_of_Casualty to binary (1 for male, 0 for female)
# Usefulness: Simplifies the categorical variable for better modeling, as our target variable is also binary.
df['Sex_of_Casualty_Binary'] = df['Sex_of_Casualty'].apply(lambda x: 1 if x == 2 else 0)
end

python
# Casualty_Age_Binned
# Bin Casualty_Age_to_Driver_Age_Ratio into categories: Low (<0.5), Medium (0.5-1.5) and High (>1.5) for interpretability.
# Usefulness: Helps segment the interactions between drivers and casualties in accidents into interpretable groups.
df['Casualty_Age_Binned'] = pd.cut(df['Casualty_Age_to_Driver_Age_Ratio'], bins=[0, 0.5, 1.5, float('inf')], labels=['Low', 'Medium', 'High'])
end

python
# Age_of_Driver_Categories
