# Usefulness: Captures nonlinear relationship between age and driver sex by grouping into meaningful ranges.
df['Age_of_Driver_Categories'] = pd.cut(df['Age_of_Driver'], bins=[0, 25, 45, 65, float('inf')], labels=['Young', 'Middle-aged', 'Senior', 'Elderly'])
end

python
# Vehicle_Type_Binned
# Group Vehicle_Type into broader categories: 'Cars', 'Motorcycles', 'Bicycles', and 'Heavy Vehicles'.
# Usefulness: Resolves potential noise due to high cardinality in Vehicle_Type by grouping related categories together.
df['Vehicle_Type_Binned'] = pd.cut(df['Vehicle_Type'], bins=[1, 10, 20, 50, 100], labels=['Cars', 'Motorcycles', 'Bicycles', 'Heavy Vehicles'])
end

python
# Engine_to_Age_ratio_scaled
# Normalize Engine_Per_Age_of_Vehicle using Min-Max scaling.
# Usefulness: Standardizes this ratio for machine learning models which are sensitive to varying scales.
df['Engine_to_Age_ratio_scaled'] = (df['Engine_Per_Age_of_Vehicle'] - df['Engine_Per_Age_of_Vehicle'].min()) / (df['Engine_Per_Age_of_Vehicle'].max() - df['Engine_Per_Age_of_Vehicle'].min())
end

python
# Log_Engine_Capacity
# Log transforming Engine_Capacity_(CC) to reduce skewness in its distribution.
# Usefulness: Enhances the modeling of linear models by reducing the effect of extreme engine capacity values.
df['Log_Engine_Capacity'] = df['Engine_Capacity_(CC)'].apply(lambda x: np.log(x + 1))
end

python
# Number_of_Casualties_Per_Driver
# Ratio of Number_of_Casualties to Number_of_Drivers/Vehicles involved.
# Usefulness: Provides context on how severe an accident was relative to the number of drivers involved.
df['Number_of_Casualties_Per_Driver'] = df['Number_of_Casualties'] / (df['Number_of_Vehicles'] + 1e-6)
end

python
# North_east_distance
# Calculate Euclidean distance combining Location_Northing_OSGR and Location_Easting_OSGR.
