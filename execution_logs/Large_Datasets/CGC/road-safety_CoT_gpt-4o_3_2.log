python
# Driver_Casualty_Age_Diff
# Description: Absolute difference between Age_of_Driver and Age_of_Casualty to represent the age gap between driver and casualty.
# Usefulness: Captures behavioral differences related to maturity, driving habits, and relational dynamics between drivers and casualties.
df['Driver_Casualty_Age_Diff'] = abs(df['Age_of_Driver'] - (df['Casualty_Age_to_Driver_Age_Ratio'] * df['Age_of_Driver']))
end

python
# Engine_Capacity_Per_Casualty
# Description: Ratio of Engine_Capacity_(CC) to Number_of_Casualties caused per vehicle.
# Usefulness: Higher engine power may translate to greater fatal impact potential, possibly correlating with driver behavior and their sex.
df['Engine_Capacity_Per_Casualty'] = df['Engine_Capacity_(CC)'] / df['Total_Casualties_Per_Vehicle']
end

python
# Driver_Senior_Strictness
# Description: Interaction term between Driver_Age_Category_Senior and Driver_Police_Strictness.
# Usefulness: Captures enforcement trends for senior drivers in high-strictness areas regarding age-based risk behaviors.
df['Driver_Senior_Strictness'] = df['Driver_Age_Category_Senior'] * df['Driver_Police_Strictness']
end

python
# Vehicle_is_Large_Maneuver_HighRisk
# Description: Boolean feature indicating if engine size is large and the driver performed high-risk maneuvers.
# Usefulness: Combines vehicle size and maneuver risk to encode aggressive driving patterns; may correlate with driver sex.
df['Vehicle_is_Large_Maneuver_HighRisk'] = df['Engine_Size_Category_Large'] & (df['Vehicle_Manoeuvre_Category'] == 'High')
end

python
# Middle_Age_Band_Ratio
# Description: Ratio of Age_Band_of_Driver to Driver_Age_Category_Middle-aged (numeric middle-aged category treatment).
# Usefulness: Encodes middle-aged driving categories and their proportional contribution.
df['Middle_Age_Band_Ratio'] = df['Age_Band_of_Driver'] * df['Driver_Age_Category_Middle-aged']
end

python
# Urban_Strictness_Normalized
# Description: Normalized measure of police strictness (Driver_Police_Strictness) in urban environments (Is_Urban).
# Usefulness: Highlights enforcement trends in urban areas, where accidents may involve male vs. female behavioral traits.
df['Urban_Strictness_Normalized'] = df['Driver_Police_Strictness'] * df['Is_Urban']
end

python
# Casualty_Engine_Interaction
# Description: Interaction term combining Casualty_Type and available vehicle engine capacity (Engine_Capacity_(CC)).
# Usefulness: Encodes vehicle choice, accident dynamics, and environment impact related to drivers and their sex distribution.
df['Casualty_Engine_Interaction'] = df['Casualty_Type'] * df['Engine_Capacity_(CC)']
end

python
# Z_Age_of_Casualty
# Description: Z-score normalization of the implied Age_of_Casualty using the Casualty_Age_to_Driver_Age_Ratio.
# Usefulness: Balances distribution for mandated models and highlights deviations in casualty age behaviors across accidents.
df['Z_Age_of_Casualty'] = (df['Casualty_Age_to_Driver_Age_Ratio'] * df['Age_of_Driver'] - df['Casualty_Type'].mean()) / df['Casualty_Type'].std()
end

python
# Senior_Age_Interaction
# Description: Encodes relationships between senior-aged drivers and senior casualties in given accidents.
# Usefulness: Captures inter-group dynamics in multi-age accident environments, emphasizing senior behavior patterns.
df['Senior_Age_Interaction'] = df['Driver_Age_Category_Senior'] * df['Senior_Driver_Casualty_Ratio']
end

python
# Proximity_to_Urban_Squared
# Description: Square of Proximity_to_Urban to amplify differences in urban accident clusters.
# Usefulness: Intuitively enhances variations closer to urban centers, which might relate to driver demographics and their sex.
df['Proximity_to_Urban_Squared'] = df['Proximity_to_Urban']  2
end

