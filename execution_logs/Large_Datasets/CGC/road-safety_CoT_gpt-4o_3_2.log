# Driver_Age_Category
# Categorizes drivers age into groups: young, middle-aged, and senior to better capture behavior patterns in driving and gender distribution.
# Usefulness: Capturing age-related behaviors and assigning them to categorical age groups. It helps in revealing insights into whether certain age groups correlate with the driver's sex.
df['Driver_Age_Category'] = pd.cut(df['Age_of_Driver'], bins=[0, 25, 45, 65, 100], labels=['Young', 'Middle-aged', 'Senior', 'Elderly'])
df = pd.get_dummies(df, columns=['Driver_Age_Category'], prefix='Driver_Age_Category')
end

python
# Casualty_Age_Group
# Maps Age_of_Casualty into age groups: child, teenager, adult, senior for more intuitive analysis outcomes.
# Usefulness: Helps understand how the ages of casualties correlate with the sex of the driver in complex accident situations.
df['Casualty_Age_Group'] = pd.cut(df['Sex_of_Casualty'], bins=[0, 16, 25, 60, 120], labels=['Child', 'Teenager', 'Adult', 'Senior'])
df = pd.get_dummies(df, columns=['Casualty_Age_Group'], prefix='Casualty_Age_Group')
end

python
# Is_Single_Casualty
# Whether the accident involves a single casualty.
# Usefulness: Single-casualty accidents might correlate with driver attention/behavior, which may differ along gender lines.
df['Is_Single_Casualty'] = (df['Number_of_Casualties'] == 1).astype(int)
end

python
# Engine_Size_Category
# Categorizes vehicles into small, medium, and large engine sizes.
# Usefulness: Larger or faster vehicles may attract drivers of one sex more often, which could prove a useful predictor for driver sex.
df['Engine_Size_Category'] = pd.cut(df['Engine_Capacity_(CC)'], bins=[0, 1200, 2500, np.inf], labels=['Small', 'Medium', 'Large'])
df = pd.get_dummies(df, columns=['Engine_Size_Category'], prefix='Engine_Size_Category')
end

python
# Is_Age_Driver_Youth
# Encodes 1 if driver's age is within the youth bracket (<25 years), and 0 otherwise.
# Usefulness: Young drivers could display different behavioral patterns and are often considered higher-risk drivers, which may correlate to gender patterns.
df['Is_Age_Driver_Youth'] = (df['Age_of_Driver'] < 25).astype(int)
end

python
# Is_Older_Casualty
# Encodes 1 if Age_of_Driver is considerably younger than the Age_of_Casualty (Casualty_Age_to_Driver_Age_Ratio > 1), indicating older casualties.
