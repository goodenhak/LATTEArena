# Driver_Police_Force_Age_Interaction
# Feature description: Combines Police_Force_Avg_Casualty_Age and Age_of_Driver to understand the interaction between average casualty age in the region governed by respective police force and the driver's age.
# Usefulness: This helps model enforcement correlation in accident locations while accounting for driver demographics.
df['Driver_Police_Force_Age_Interaction'] = df['Police_Force_Avg_Casualty_Age'] * df['Age_of_Driver']
end

python
# Vehicle_Type_Sex_Casualty_Interaction
# Feature description: Multiplies Vehicle_Type with Sex_of_Casualty to explore relationships between the type of vehicle involved and the gender of the casualty in determining driver sex often impacted by vehicle categories (e.g., larger vehicles being predominantly male-driven in the sample).
# Usefulness: Useful to link gender characteristics based on the type of vehicle involved in accidents.
df['Vehicle_Type_Sex_Casualty_Interaction'] = df['Vehicle_Type'] * df['Sex_of_Casualty']
end

python
# Urban_Casualty_Ratio
# Feature description: Ratio between Urban_or_Rural_Area and Casualty_Type. Shows how casualty types differ between urban and rural areas.
# Usefulness: Highlights behavioral or situational differences in accident locations impacting driver demographics.
df['Urban_Casualty_Ratio'] = df['Urban_or_Rural_Area'] / (df['Casualty_Type'] + 1)
end

python
# Driver_Risk_Factor
# Feature description: Uses Vehicle_Manoeuvre_Category in combination with driver-specific features (Driver_Age_Band_Interaction) to account for risky maneuvers by age bands.
# Usefulness: Provides model insight into risky behaviors across demographic segments by coupling dynamics with maneuvers.
df['Driver_Risk_Factor'] = df['Driver_Age_Band_Interaction'] * df['Vehicle_Manoeuvre_Category'].map({'Low': 1, 'Medium': 2, 'High': 3})
end

python
# Mileage_Per_Accident
# Feature description: Interaction between Engine_Per_Age_of_Vehicle, Age_of_Vehicle, and Accident Frequency. Represents vehicle usage intensity leading to accidents.
# Usefulness: Demonstrates accidents arising in well-used or older vehicles with high mileage or wear-and-tear factors.
df['Mileage_Per_Accident'] = (df['Engine_Per_Age_of_Vehicle'] / (df['Age_of_Vehicle'] + 1)) * df['Number_of_Casualties']
end

python
# Gender_Weighted_Accident_Location
# Feature description: Combines Location_North_to_East_Ratio, Sex_of_Casualty, and Age_Band_of_Driver for locational weighted demographic analysis.
# Usefulness: Highlights geographical and gender-specific accident trends with age and location ratios incorporated.
df['Gender_Weighted_Accident_Location'] = df['Location_North_to_East_Ratio'] * df['Sex_of_Casualty'] * df['Age_Band_of_Driver']
end

python
# Propulsion_Engine_Interaction
# Feature description: Interaction between Engine_Capacity_(CC) and Propulsion_Code to account for vehicle propulsion type dynamics.
# Usefulness: Identifies gender correlations between engine power and propulsion type in predicting driver behavior.
df['Propulsion_Engine_Interaction'] = df['Engine_Capacity_(CC)'] * df['Propulsion_Code']
end

python
# Drop columns not useful
# Feature description: Eliminate noisy or redundant attributes with little predictive value as described earlier, such as Vehicle_Location-Restricted_Lane or Casualty_Reference.
df.drop(columns=['Vehicle_Location-Restricted_Lane', 'Casualty_Reference'], inplace=True)
end
