# Driver_Age_Band_Interaction
# Interaction between Age_Band_of_Driver and Age_of_Driver to enhance understanding of driver behavior based on their age and age band. 
# Usefulness: Helps capture finer distinctions between drivers of similar age who fall into different age bands, adding more granularity to the data.
df['Driver_Age_Band_Interaction'] = df['Age_Band_of_Driver'] * df['Age_of_Driver']
end

python
# Engine_Per_Age_of_Vehicle
# Ratio of Engine_Capacity_(CC) to Age_of_Vehicle to represent wear-and-tear or usage specifics of heavier engine vehicles.
# Usefulness: Captures how vehicle engine size relates to the vehicle's age, which may correlate with driver characteristics or behavior.
df['Engine_Per_Age_of_Vehicle'] = df['Engine_Capacity_(CC)'] / (df['Age_of_Vehicle'] + 1)  # Adding +1 to avoid division by zero.
end

python
# Vehicle_Manoeuvre_Category
# Bin Vehicle_Manoeuvre values into three broad categories: low-risk, medium-risk, and high-risk maneuvers.
# Usefulness: Simplifies complex maneuver data into broader categories that can potentially relate to driver decision-making based on sex.
df['Vehicle_Manoeuvre_Category'] = pd.cut(df['Vehicle_Manoeuvre'], bins=[0, 6, 12, 18], labels=['Low', 'Medium', 'High'])
end

python
# Is_Urban
# Converts 'Urban_or_Rural_Area' into a binary feature indicating whether the area is urban.
# Usefulness: Helps capture environment-based differences in driver behavior or circumstances.
df['Is_Urban'] = (df['Urban_or_Rural_Area'] == 1).astype(int)
end

python
# Total_Casualties_Per_Vehicle
# Ratio of Number_of_Casualties to Number_of_Vehicles in the accident to relate casualties to vehicles.
# Usefulness: Indicates severity or crowdedness in an accident scenario, which could differ by sex of the driver.
df['Total_Casualties_Per_Vehicle'] = df['Number_of_Casualties'] / (df['Number_of_Vehicles'] + 1e-6)  # Adding small value to avoid division by zero.
end

python
# Driver_Police_Force_Interaction
# Interaction effect between Police_Force and Age_Band_of_Driver to understand enforcement correlation.
# Usefulness: Highlights localized police policies or tendencies that could affect drivers differently based on age and enforcement region.
df['Driver_Police_Force_Interaction'] = df['Police_Force'] * df['Age_Band_of_Driver']
end

python
# Casualty_Age_to_Driver_Age_Ratio
# Ratio of Age_of_Casualty to Age_of_Driver to understand relationships in multi-party accidents.
# Usefulness: Reflects whether the driver and casualty age connection has a pattern correlated to gender.
df['Casualty_Age_to_Driver_Age_Ratio'] = df['Age_of_Casualty'] / (df['Age_of_Driver'] + 1e-3)  # Adding a small value for numerical stability.
end

python
# Driver_Age_Squared
# Square of Age_of_Driver to represent non-linear effects of driver age.
# Usefulness: Captures non-linear relationships between age and behavior that might vary for different sexes.
df['Driver_Age_Squared'] = df['Age_of_Driver']  2
end

python
# Vehicle_Type_Hot_Encoded
# One-hot encoding of Vehicle_Type to represent vehicle type as a categorical variable.
# Usefulness: Cars, bikes, and buses might have distinct user demographics, influenced by gender.
vehicle_type_encoded = pd.get_dummies(df['Vehicle_Type'], prefix='Vehicle_Type')
df = pd.concat([df, vehicle_type_encoded], axis=1)
end 

python
# Distance_to_Lat_Long_Center
# Approximate distance of (Longitude, Latitude) from a fixed central point in Great Britain.
# Usefulness: Helps model regional effects or biases in the dataset that relate to geographic factors.
GB_LONG_LAT_CENTER = (-1.3423, 52.5663)  # Mean Longitude and Latitude as approximation of the center.
df['Distance_to_Lat_Long_Center'] = np.sqrt((df['Longitude'] - GB_LONG_LAT_CENTER[0])2 + (df['Latitude'] - GB_LONG_LAT_CENTER[1])2)
end

python
# Location_North_to_East_Ratio
# Ratio of Location_Northing_OSGR to Location_Easting_OSGR to describe accident location inclination.
# Usefulness: Captures biases in geographic distribution that could correlate with driver demographics.
df['Location_North_to_East_Ratio'] = df['Location_Northing_OSGR'] / (df['Location_Easting_OSGR'] + 1e-6)
end

python
# Drop less relevant columns
df.drop(columns=['1st_Road_Number', '2nd_Road_Number', 'Pedestrian_Location', 'Pedestrian_Movement'], inplace=True)
# Usefulness: These columns are either sparsely populated or less relevant to predicting the sex of the driver.
end

python
# Z-Score Standardized Driver Age
# Z-score normalization of Age_of_Driver to account for its distribution across the dataset.
# Usefulness: Ensures consistent comparisons across age as it varies significantly.
df['Z_Age_of_Driver'] = (df['Age_of_Driver'] - df['Age_of_Driver'].mean()) / df['Age_of_Driver'].std()
end

python
# Groupby-then-Average on Casualty Age by Police Force
# Groups data by Police_Force and aggregates the average Age_of_Casualty.
# Usefulness: Captures insight into casualty demographics by enforcement region.
df['Police_Force_Avg_Casualty_Age'] = df.groupby('Police_Force')['Age_of_Casualty'].transform('mean')
end
