its distribution.\n# Usefulness: Enhances the modeling of linear models by reducing the effect of extreme engine capacity values.\ndf['Log_Engine_Capacity'] = df['Engine_Capacity_(CC)'].apply(lambda x: np.log(x + 1))", "# Number_of_Casualties_Per_Driver\n# Ratio of Number_of_Casualties to Number_of_Drivers/Vehicles involved.\n# Usefulness: Provides context on how severe an accident was relative to the number of drivers involved.\ndf['Number_of_Casualties_Per_Driver'] = df['Number_of_Casualties'] / (df['Number_of_Vehicles'] + 1e-6)", "# North_east_distance\n# Calculate Euclidean distance combining Location_Northing_OSGR and Location_Easting_OSGR.\n# Usefulness: Aggregates geographical features into a single spatial dimension for better interpretation in urban/rural contexts.\ndf['North_east_distance'] = np.sqrt(df['Location_Northing_OSGR']2 + df['Location_Easting_OSGR']2)", "# Z_Engine_Capacity\n# Compute Z-scores of Engine_Capacity_(CC) for feature scale normalization.\n# Usefulness: Accounts for deviations from mean engine capacity and standardizes for scale-sensitive models.\ndf['Z_Engine_Capacity'] = (df['Engine_Capacity_(CC)'] - df['Engine_Capacity_(CC)'].mean()) / df['Engine_Capacity_(CC)'].std()", "# Interaction: Driver_Age_Vehicle_Age\n# Multiply Age_of_Driver by Age_of_Vehicle to capture interaction effects.\n# Usefulness: Represents how the combination of driver experience (age) and vehicle age affects predictions of driver sex.\ndf['Driver_Age_Vehicle_Age'] = df['Age_of_Driver'] * df['Age_of_Vehicle']", "# Driver_Manoeuvre_Risk\n# Combine Driver_Age_Band_Interaction with Vehicle_Manoeuvre_Category rank for proxy risk score.\n# Usefulness: Encodes risky maneuver interactions in conjunction with driver’s age band to enhance risk propensity modeling.\nrisk_map = {'Low': 1, 'Medium': 2, 'High': 3}\ndf['Driver_Manoeuvre_Risk'] = df['Driver_Age_Band_Interaction'] * df['Vehicle_Manoeuvre_Category'].map(risk_map)", "# Is_High_Engine\n# Binary column indicating vehicles with Engine_Capacity_(CC) > Q3 (1968 CC).\n# Usefulness: Identifies cars that may be associated with riskier driving behavior or different demographics of drivers.\ndf['Is_High_Engine'] = df['Engine_Capacity_(CC)'].apply(lambda x: 1 if x > 1968 else 0)", "# Drop less useful columns\ndf.drop(columns=['Vehicle_Reference_df_res', 'Location_Northing_OSGR', 'Location_Easting_OSGR'], inplace=True)\n# Rationale: These features may introduce noise or highly correlate with derived features (e.g., ratios or distances)."]
