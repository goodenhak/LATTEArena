2026-05-12 16:17:11,992 - INFO - ops_string = ["# Driver_Age_Casualty_Age_Interaction\n# Captures interaction between the driver's age and casualties' ages. This feature may reveal behavioral patterns in road safety incidents related to young, middle-aged, or senior drivers.\n# Usefulness: Helps identify if specific ages of drivers interact dangerously with certain age groups of casualties.\ndf['Driver_Age_Casualty_Age_Interaction'] = df['Age_of_Driver'] * df['Casualty_Age_to_Driver_Age_Ratio']", "# Is_Young_Driver\n# Binary indicator if the driver is young (based on globally accepted age bands for young drivers).\n# Usefulness: Young drivers often exhibit certain riskier driving behaviors that could correlate with the driver's sex.\ndf['Is_Young_Driver'] = (df['Age_Band_of_Driver'] <= 5).astype(int)", "# Vehicle_Risk_Manoeuvre_Weight\n# Multiplies Vehicle_Type by Vehicle_Manoeuvre importance to weigh potential risks.\n# Usefulness: Different vehicle types combined with maneuvers indicate varying difficulties and risks to control the vehicle. This could reveal gender-related driving patterns.\ndf['Vehicle_Risk_Manoeuvre_Weight'] = df['Vehicle_Type'] * df['Vehicle_Manoeuvre']", "# Urban_Engine_Intensity\n# Combining proximity to urban areas with engine size to identify potentially aggressive driving patterns in urban environments.\n# Usefulness: Helps identify drivers based on engine usage behaviors in high-density zones, which may uncover patterns by gender.\ndf['Urban_Engine_Intensity'] = df['Proximity_to_Urban'] * df['Engine_Capacity_(CC)']", "# Driver_Senior_Interaction_Behavior\n# Combines the Driver_Age_Category_Senior feature with Casualty_Type to highlight interactions in accidents involving senior drivers and specific casualty types.\n# Usefulness: Senior driver behavior could differ across sexes and vary based on type of casualty involved.\ndf['Driver_Senior_Interaction_Behavior'] = df['Driver_Age_Category_Senior'] * df['Casualty_Type']", "# Standardized_Engine_Per_Age_Vehicle\n# Z-score standardization of the engine-to-age-of-vehicle ratio.\n# Usefulness: Normalization helps capture outliers in engine usage for newer or older vehicles, useful to uncover behavior patterns by sex.\ndf['Standardized_Engine_Per_Age_Vehicle'] = (df['Engine_Per_Age_of_Vehicle'] - df['Engine_Per_Age_of_Vehicle'].mean()) / df['Engine_Per_Age_of_Vehicle'].std()", "# Risk_Per_Location\n# Calculate risk by multiplying total casualties per vehicle with the location north-to-east ratio.\n# Usefulness: Helps capture spatial factors influencing accident risks and enables clustering analysis on driver behavioral patterns.\ndf['Risk_Per_Location'] = df['Total_Casualties_Per_Vehicle'] * df['Location_North_to_East_Ratio']", "# Is_High_Casualty_Accident\n# Binary feature if the accident involves more than the median number of casualties, based on Number_of_Casualties.\n# Usefulness: High casualty accidents could highlight gender-specific driving patterns, especially in multi-party collisions.\ndf['Is_High_Casualty_Accident'] = (df['Number_of_Casualties'] > df['Number_of_Casualties'].median()).astype(int)", "# Adjusted_Driver_Police_Strictness\n# Divides Driver_Police_Strictness by Age_of_Driver to consider stricter enforcement normalized by the age of the driver.\n# Usefulness: Helps capture law enforcement trends and driver response, segmented by driver demographics and sex.\ndf['Adjusted_Driver_Police_Strictness'] = df['Driver_Police_Strictness'] / (df['Age_of_Driver'] + 1)", "# Vehicle_Complexity_Score\n# Combines Engine_Size_Category_Large, Engine_Size_Category_Medium, and Engine_Size_Category_Small into a single ordinal score.\n# Usefulness: This metric could help correlate driver complexity preferences with sex, especially in high-performance vehicles.\ndf['Vehicle_Complexity_Score'] = (\n    df['Engine_Size_Category_Large'].astype(int) * 3 +\n    df['Engine_Size_Category_Medium'].astype(int) * 2 +\n    df['Engine_Size_Category_Small'].astype(int) * 1\n)", "# Dropping columns that are redundant or minimally informative.\ndf.drop(columns=[\n    'Casualty_Age_Group_Child',  # Already covered by other age-related features like Casualty_Type.\n    'Casualty_Age_Group_Teenager',  # Minimal direct impact, overlaps with other casualty groups.\n    'Casualty_Age_Group_Adult',  # Covered by Senior-focused and interaction features.\n    'Casualty_Age_Group_Senior',  # Redundant due to Driver_Senior_Interaction_Behavior.\n    'Engine_Size_Category_Small',  # Encoded into Vehicle_Complexity_Score.\n    'Engine_Size_Category_Medium', \n    'Engine_Size_Category_Large'\n], inplace=True)", "# Dropping interaction terms that show low variance or are less impactful.\ndf.drop(columns=[\n    'Driver_Youth_Engine_Intensity',  # Low variance and already represented by Urban_Engine_Intensity.\n    'Urban_Casualty_Interaction',    # Redundant with Proximity_to_Urban and other spatial features.\n    'Driver_Age_Category_Young',     # Already expressed within Age_Band_of_Driver segmentation.\n    'Driver_Age_Category_Senior'     # Represented by Driver_Age_Casualty_Age_Interaction.\n], inplace=True)", "# Removing excessively ordinal or broad features with low direct impact on target.\ndf.drop(columns=[\n    'Propulsion_Code',               # Minimal correlation with other features.\n    'Vehicle_Reference_df_res',      # Vehicle reference may not directly correlate with gender.\n    'Local_Authority_(District)'     # Too many unique values to contribute meaningful clustering.\n], inplace=True)"]
