# Driver_Casualty_Sex_Match
# Feature description: Captures the relationship between Sex_of_Driver and Sex_of_Casualty by encoding whether they match (1) or differ (0).
# Usefulness: Helps establish behavioral patterns based on gender dynamics in accidents, as gender may influence risk-taking or driving behavior. 
df['Driver_Casualty_Sex_Match'] = (df['Sex_of_Casualty'] == df['Sex_of_Driver']).astype(int)
end

python
# Driver_Age_Band_Casualty_Age_Band_Interaction
# Feature description: Encodes the interaction between Age_Band_of_Driver and Casualty_Age_Group_* binary columns to uncover effects of age group interplay.
# Usefulness: Discover unique behavioral trends or accident dynamics between age groups contributing to predictive accuracy.
age_band_columns = ['Casualty_Age_Group_Senior', 'Casualty_Age_Group_Adult', 'Casualty_Age_Group_Teenager', 'Casualty_Age_Group_Child']
df['Driver_Age_Band_Casualty_Age_Band_Interaction'] = df['Age_Band_of_Driver'].astype(str) + _ + df[age_band_columns].idxmax(axis=1).str.replace(Casualty_Age_Group_, )
end

python
# Proximity_Interaction
# Feature description: Combines Location_North_to_East_Ratio and Proximity_to_Urban using multiplication.
# Usefulness: A combined feature to adjust accident area gradient and urban proximity in one metric.
df['Proximity_Interaction'] = df['Location_North_to_East_Ratio'] * df['Proximity_to_Urban']
end

python
# Log_Total_Casualties_Per_Vehicle
# Feature description: Applies a logarithmic transformation to Total_Casualties_Per_Vehicle for reducing skewness.
# Usefulness: Smoothed representation reduces the impact of extreme values in modeling casualty concentrations per vehicle.
df['Log_Total_Casualties_Per_Vehicle'] = df['Total_Casualties_Per_Vehicle'].apply(lambda x: np.log(x + 1))
end

python
# Vehicle_Manoeuvre_Risk_Interaction
# Feature description: Crosses Vehicle_Manoeuvre_Category with Vehicle_Location-Restricted_Lane. Provides insight into lane-based risk in maneuvers.
# Usefulness: Captures how specific maneuvers correlate with risky driving behaviors and confined space locations (restricted lanes).
df['Vehicle_Manoeuvre_Risk_Interaction'] = df['Vehicle_Manoeuvre_Category'].astype(str) + _ + df['Vehicle_Location-Restricted_Lane'].astype(str)
end

python
# Police_Force_Driver_Age_Risk_Std
# Feature description: Standard deviation of interaction effects between Driver_Police_Force_Interaction under police enforcement context.
# Usefulness: Quantifies the variability in enforcement and driver age interactions across accidents which could relate to policy impact.
df['Police_Force_Driver_Age_Risk_Std'] = df.groupby('Police_Force')['Driver_Police_Force_Interaction'].transform('std')
end

python
# Absolute_Hit_Object_Total
# Feature description: Takes the absolute value of Hit_Object_Total.
# Usefulness: Removes imbalances when analyzing whether objects involved in accidents influence driver gender tendencies (positive accidents vs. negative values).
df['Absolute_Hit_Object_Total'] = df['Hit_Object_Total'].apply(np.abs)
end

python
# Engine_Per_Youth_Ratio
# Feature description: Ratio of Engine_Capacity_(CC) to Is_Age_Driver_Youth, encoded to consider only youth drivers (replaced non-youth ratios with np.nan).
