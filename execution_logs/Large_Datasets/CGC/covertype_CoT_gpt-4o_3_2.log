2026-05-12 12:24:36,945 - INFO - ops_string = ["# Vertical_Hydrology_Elevation_Diff\n# Feature description: Computes the absolute difference between Vertical_Distance_To_Hydrology and Elevation_Vertical_Diff. Provides insight into how water features interact with elevation changes.\n# Usefulness: Captures the interplay between hydrology and vertical elevation changes, which may influence soil moisture and vegetation type considerably.\ndf['Vertical_Hydrology_Elevation_Diff'] = abs(df['Vertical_Distance_To_Hydrology'] - df['Elevation_Vertical_Diff'])", "# Hillshade_Ratio_To_Noontime\n# Feature description: Ratio of Hillshade_9am to Hillshade_Noon. Reveals the relative lighting conditions between early morning and noon, indicative of terrain and sunlight exposure patterns.\n# Usefulness: Helps understand shade dynamics, which directly influence vegetation and soil microclimates.\ndf['Hillshade_Ratio_To_Noontime'] = df['Hillshade_9am'] / (df['Hillshade_Noon'] + 1e-5)", "# Elevation_Roadway_Proximity\n# Feature description: Computes a ratio between elevation and Horizontal_Distance_To_Roadways. Useful for understanding how elevation affects access and proximity to transportation routes.\n# Usefulness: Provides an idea of human accessibility/connectivity, which may influence cover type and forest management activities.\ndf['Elevation_Roadway_Proximity'] = df['Elevation'] / (df['Horizontal_Distance_To_Roadways'] + 1e-5)", "# Combined_Fire_Roadways_Interaction\n# Feature description: Product of Horizontal_Distance_To_Fire_Points and Horizontal_Distance_To_Roadways. Indicates potential areas where road accessibility might intersect wildfire exposure risk.\n# Usefulness: Helps understand the combined influence of road/fire proximity on cover type, revealing potentially vulnerable zones.\ndf['Combined_Fire_Roadways_Interaction'] = df['Horizontal_Distance_To_Fire_Points'] * df['Horizontal_Distance_To_Roadways']", "# Soil_Type_Importance_Sum\n# Feature description: Aggregates all Soil_Type indicators into a single sum, reflecting the overall soil diversity.\n# Usefulness: Soil diversity can significantly correlate with different vegetation cover types and soil niches.\nsoil_columns = [col for col in df.columns if 'Soil_Type' in col]\ndf['Soil_Type_Importance_Sum'] = df[soil_columns].sum(axis=1)", "# Hillshade_Standardized\n# Feature description: Z-score normalized Combined_Hillshade_Mean to reflect relative shading in the terrain compared to the dataset mean.\n# Usefulness: Helps standardize shading influence across observations to reveal subtle patterns impacted by light exposure.\ndf['Hillshade_Standardized'] = (df['Combined_Hillshade_Mean'] - df['Combined_Hillshade_Mean'].mean()) / (df['Combined_Hillshade_Mean'].std() + 1e-5)", "# Soil_Type_Most_Common\n# Feature description: Flags the Soil_Type indicator corresponding to the most common soil type in the dataset, creates an indicator for that specific soil type.\n# Usefulness: Soil type distribution impacts cover type prediction, identifying the most common soil type simplifies analysis for dominant factors.\nmost_common_soil_type = df[soil_columns].mean().idxmax()\ndf['Soil_Type_Most_Common'] = df[most_common_soil_type]", "# Elevation_Gradient\n# Feature description: Difference between Elevation and Elevation_Vertical_Diff divided by Elevation to calculate scaled elevation gradient.\n# Usefulness: Elevation gradients impact microclimates and vegetation influence, particularly in mountainous regions.\ndf['Elevation_Gradient'] = (df['Elevation'] - df['Elevation_Vertical_Diff']) / (df['Elevation'] + 1e-5)", "# Aspect_Spectral_Combination\n# Feature description: Combines Aspect_Sine and Aspect_Cosine into a single feature (their product), emphasizing spectral circular directionality patterns.\n# Usefulness: Better captures cyclical impacts of the aspect feature in vegetation growth due to orientation toward sunlight.\ndf['Aspect_Spectral_Combination'] = df['Aspect_Sine'] * df['Aspect_Cosine']", "# Wilderness_Area_Specificity\n# Feature description: Calculates the sum of all Wilderness_Area indicators, helping signal areas intersecting different protected zones.\n# Usefulness: Elevates importance of wilderness interaction, which strongly correlates with environmental protection and cover type.\nwilderness_columns = [col for col in df.columns if 'Wilderness_Area' in col]\ndf['Wilderness_Area_Specificity'] = df[wilderness_columns].sum(axis=1)", "# Drop irrelevant features\n# Feature description: Removes duplicate, redundant, or uninformative columns based on statistical thresholds, e.g., low variance.\n# Usefulness: Ensures concise representation while avoiding noise or computational redundancy.\ndrop_columns = ['Fire_Roadways_Proximity_Ratio', 'Elevation_Fire_Ratio', 'Wilderness_Area_Binary', 'Soil_Type_Count']\ndf.drop(columns=drop_columns, inplace=True)"]
