# Road_Fire_Distance_Difference_Ratio
# Feature description: Ratio of the absolute difference between Horizontal_Distance_To_Roadways and Horizontal_Distance_To_Fire_Points to their sum: abs(Horizontal_Distance_To_Roadways - Horizontal_Distance_To_Fire_Points) / (Horizontal_Distance_To_Roadways + Horizontal_Distance_To_Fire_Points).
# Usefulness: Captures the relative proximity between fire ignition points and roadways, which may be correlated with specific forest cover types.

df['Road_Fire_Distance_Difference_Ratio'] = abs(df['Horizontal_Distance_To_Roadways'] - df['Horizontal_Distance_To_Fire_Points']) / (df['Horizontal_Distance_To_Roadways'] + df['Horizontal_Distance_To_Fire_Points'])
end

python
# Elevation_Ratio_Feature
# Feature description: Ratio of Elevation to Elevation_Vertical_Diff: Elevation / Elevation_Vertical_Diff.
# Usefulness: This provides a normalized elevation feature based on hydrology differences, which could differentiate terrain and vegetation characteristics.

df['Elevation_Ratio_Feature'] = df['Elevation'] / df['Elevation_Vertical_Diff']
end

python
# Hillshade_Ratio_Mean
# Feature description: Ratio of the mean hillshade values over the sum of hillshade values at different times: Combined_Hillshade_Mean / (Hillshade_9am + Hillshade_Noon + Hillshade_3pm).
# Usefulness: Normalizes hillshade variations by the total shade, which could yield better insight into lighting differences across cells.

df['Hillshade_Ratio_Mean'] = df['Combined_Hillshade_Mean'] / (df['Hillshade_9am'] + df['Hillshade_Noon'] + df['Hillshade_3pm'])
end

python
# Normalized_Aspect_Product
# Feature description: Product of Aspect_Sine and Aspect_Cosine divided by the sum of their absolute values: (Aspect_Sine * Aspect_Cosine) / (abs(Aspect_Sine) + abs(Aspect_Cosine)).
# Usefulness: Captures geometric aspect directionality while reducing magnitude effects, useful for differentiating terrain orientation.

df['Normalized_Aspect_Product'] = (df['Aspect_Sine'] * df['Aspect_Cosine']) / (abs(df['Aspect_Sine']) + abs(df['Aspect_Cosine']))
end

python
# Soil_Type_Indicator_Interaction
# Feature description: Encodes interactions between Wilderness areas and soil types: Soil_Type29 * Wilderness_Area1 + Soil_Type33 * Wilderness_Area3.
# Usefulness: Useful for understanding the interaction between soil type distribution and specific wilderness areas; may filter out cover types unique to combined criteria.

df['Soil_Type_Indicator_Interaction'] = (df['Soil_Type29'] * df['Wilderness_Area1']) + (df['Soil_Type33'] * df['Wilderness_Area3'])
end

python
# Roadway_Fire_Hydrology_Interaction
# Feature description: Combines proximity metrics across Roadways, Fire Points, and Hydrology into a single feature: Horizontal_Distance_To_Fire_Points / (Horizontal_Distance_To_Roadways + Horizontal_Distance_To_Hydrology).
# Usefulness: A composite measure that balances accessibility and proximity of key forest features.

df['Roadway_Fire_Hydrology_Interaction'] = df['Horizontal_Distance_To_Fire_Points'] / (df['Horizontal_Distance_To_Roadways'] + df['Horizontal_Distance_To_Hydrology'])
end

python
# Slope_Hydrology_Multiplication
# Feature description: Captures the interaction between slope and vertical distance to hydrology: Slope * Vertical_Distance_To_Hydrology.
# Usefulness: Enables differentiation based on steepness and proximity to water bodies.

df['Slope_Hydrology_Multiplication'] = df['Slope'] * df['Vertical_Distance_To_Hydrology']
end

python
# Soil_Type_Frequency
# Feature description: Calculates the frequency of soil type presence per row using sum of all Soil_Type indicators.
# Usefulness: A summarized feature for grouping soil diversity per cell.

df['Soil_Type_Frequency'] = df.filter(like='Soil_Type').sum(axis=1)
end

