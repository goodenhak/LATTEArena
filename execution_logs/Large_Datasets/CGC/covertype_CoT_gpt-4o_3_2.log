2026-05-12 11:44:35,707 - INFO - ops_string = ["# Feature: Elevation_ZScore\n# Feature description: Calculates the z-score of the Elevation feature (z = (x - mean) / std).\n# Usefulness: Normalizing Elevation into a standardized scale allows models to better understand variability while removing effects of scale, particularly important for continuous variables with large ranges.\ndf['Elevation_ZScore'] = ((df['Elevation'] - 3024.4121) / 201.9785)", "# Feature: Aspect_Sine\n# Feature description: Transforms the Aspect feature to sin(Aspect) to capture cyclical patterns of directional orientation.\n# Usefulness: Aspect is azimuthal angle; sine captures directional cyclical effects, useful for understanding sunlight exposure impacts on vegetation cover.\ndf['Aspect_Sine'] = np.sin(np.radians(df['Aspect']))", "# Feature: Aspect_Cosine\n# Feature description: Transforms the Aspect feature to cos(Aspect) to capture cyclical patterns of directional orientation.\n# Usefulness: Like sine, cosine further refines directional analysis in combination, ensuring better representation of sunlight exposure and terrain attributes.\ndf['Aspect_Cosine'] = np.cos(np.radians(df['Aspect']))", "# Feature: Hydrology_Elevation_Ratio\n# Feature description: Ratio of Vertical_Distance_To_Hydrology to Elevation.\n# Usefulness: Represents terrain steepness or proximity to water as a proportion of elevation, helpful in understanding water impact on forest cover.\ndf['Hydrology_Elevation_Ratio'] = df['Vertical_Distance_To_Hydrology'] / df['Elevation']", "# Feature: Roadways_Hydrology_Distance_Ratio\n# Feature description: Ratio of Horizontal_Distance_To_Roadways to Horizontal_Distance_To_Hydrology.\n# Usefulness: Indicates accessibility to infrastructure relative to terrain-based hydrology, useful for understanding anthropogenic influences.\ndf['Roadways_Hydrology_Distance_Ratio'] = df['Horizontal_Distance_To_Roadways'] / df['Horizontal_Distance_To_Hydrology']", "# Feature: Fire_Proximity_Hydrology_Ratio\n# Feature description: Ratio of Horizontal_Distance_To_Fire_Points to Horizontal_Distance_To_Hydrology.\n# Usefulness: Measures proximity of wildfire ignition points versus water sources, with direct significance for vegetation susceptibility to fires.\ndf['Fire_Proximity_Hydrology_Ratio'] = df['Horizontal_Distance_To_Fire_Points'] / df['Horizontal_Distance_To_Hydrology']", "# Feature: Elevation_Vertical_Diff\n# Feature description: Difference between Elevation and Vertical_Distance_To_Hydrology.\n# Usefulness: Indicates terrain steepness relative to water features, affecting drainage patterns and soil properties linked to forest cover.\ndf['Elevation_Vertical_Diff'] = df['Elevation'] - df['Vertical_Distance_To_Hydrology']", "# Feature: Combined_Hillshade_Mean\n# Feature description: Mean of Hillshade_9am, Hillshade_Noon, and Hillshade_3pm.\n# Usefulness: Aggregates sunlight exposure across different time periods, providing an overall measure of solar impact on vegetation.\ndf['Combined_Hillshade_Mean'] = df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].mean(axis=1)", "# Feature: Wilderness_Area_Sum\n# Feature description: Sum of all wilderness area indicators.\n# Usefulness: Consolidates wilderness information into one feature representing overall wilderness coverage affecting forest type.\ndf['Wilderness_Area_Sum'] = df[['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3', 'Wilderness_Area4']].sum(axis=1)", "# Feature: Soil_Type_Sum\n# Feature description: Sum of all Soil_Type indicators.\n# Usefulness: Combines soil type information to provide count of distinct soil types for vegetation management correlations.\ndf['Soil_Type_Sum'] = df[['Soil_Type1', 'Soil_Type2', 'Soil_Type3', 'Soil_Type4', 'Soil_Type5', 'Soil_Type6', \n                          'Soil_Type7', 'Soil_Type8', 'Soil_Type9', 'Soil_Type10', 'Soil_Type11', 'Soil_Type12',\n                          'Soil_Type13', 'Soil_Type14', 'Soil_Type15', 'Soil_Type16', 'Soil_Type17', 'Soil_Type18',\n                          'Soil_Type19', 'Soil_Type20', 'Soil_Type21', 'Soil_Type22', 'Soil_Type23', 'Soil_Type24',\n                          'Soil_Type25', 'Soil_Type26', 'Soil_Type27', 'Soil_Type28', 'Soil_Type29', 'Soil_Type30',\n                          'Soil_Type31', 'Soil_Type32', 'Soil_Type33', 'Soil_Type34', 'Soil_Type35', 'Soil_Type36',\n                          'Soil_Type37', 'Soil_Type38', 'Soil_Type39', 'Soil_Type40']].sum(axis=1)", "# Feature: Soil_Type_Binary\n# Feature description: Convert individual Soil_Type indicators into a single binary Has Soil feature.\n# Usefulness: Simplifies soil data representations into presence or absence values, reducing dimensionality while retaining soil-related features.\ndf['Soil_Type_Binary'] = (df['Soil_Type_Sum'] > 0).astype(int)", "# Drop columns with near-constant values\ndf.drop(columns=['Soil_Type1', 'Soil_Type5', 'Soil_Type14', 'Soil_Type15', 'Soil_Type37'], inplace=True)"]
