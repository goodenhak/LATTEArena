# Distance_To_Hydrology_Ratio
# This feature represents the ratio of Horizontal_Distance_To_Hydrology to Vertical_Distance_To_Hydrology.
# Usefulness: This feature captures the spatial relationship between horizontal and vertical proximity to hydrological features — which could indicate terrain steepness or flatness. Certain forest cover types may correlate with flatter or steeper terrains near water bodies.
df['Distance_To_Hydrology_Ratio'] = df['Horizontal_Distance_To_Hydrology'] / (df['Vertical_Distance_To_Hydrology'] + 1e-6)
end

python
# Road_Fire_Difference 
# Feature description: Absolute difference between Horizontal_Distance_To_Roadways and Horizontal_Distance_To_Fire_Points.
# Usefulness: Highlights proximity differences between roads and fire ignition points, which can help to understand relationships between human-induced activities and fire-prone areas, particularly important for forest cover type 2.
df['Road_Fire_Difference'] = abs(df['Horizontal_Distance_To_Roadways'] - df['Horizontal_Distance_To_Fire_Points'])
end

python
# Hillshade_Variation
# Feature description: Standard deviation of all hillshade measures: Hillshade_9am, Hillshade_Noon, and Hillshade_3pm.
# Usefulness: This feature indicates variability in sunlight across the day; forest cover types may be sensitive to the amount and distribution of sunlight across various times of the day.
df['Hillshade_Variation'] = df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].std(axis=1)
end

python
# Hydrology_Hillshade_Product
# Feature description: Product of Combined_Hillshade_Mean and Horizontal_Distance_To_Hydrology.
# Usefulness: Indicates combined influence of sunlight and water proximity, factors that influence vegetation growth and modify forest cover types.
df['Hydrology_Hillshade_Product'] = df['Combined_Hillshade_Mean'] * df['Horizontal_Distance_To_Hydrology']
end

python
# Normalized_Hillshade_Diff
# Feature description: Normalized difference between Hillshade_9am and Hillshade_3pm: (Hillshade_9am - Hillshade_3pm) / (Hillshade_9am + Hillshade_3pm).
# Usefulness: Quantifies the relative difference in sunlight on slopes facing east vs west, which may relate to specific vegetation growth patterns.
df['Normalized_Hillshade_Diff'] = (df['Hillshade_9am'] - df['Hillshade_3pm']) / (df['Hillshade_9am'] + df['Hillshade_3pm'] + 1e-6)
end

python
# Elevation_Difference_Slope
# Feature description: Difference between Elevation and Elevation_Vertical_Diff normalized by Slope.
# Usefulness: Elevation, hydrological vertical distance, and slope collectively influence soil conditions and therefore vegetation distribution.
df['Elevation_Difference_Slope'] = (df['Elevation'] - df['Elevation_Vertical_Diff']) / (df['Slope'] + 1e-6)
end

python
# Fire_Hydrology_Proximity_Sum
# Feature description: Sum of distances to hydrology and fire points.
# Usefulness: Proximity to water and fire origin strongly influences forest cover types, and summing these distances captures overall environmental exposure.
df['Fire_Hydrology_Proximity_Sum'] = df['Horizontal_Distance_To_Fire_Points'] + df['Horizontal_Distance_To_Hydrology']
end

python
# Soil_Type_Diversity_Index
# Feature description: Combines Soil_Type indicators into a single feature.
# Usefulness: Captures diversity or combination of soil types for a given cell, which can influence the type of forest cover present.
df['Soil_Type_Diversity_Index'] = df[['Soil_Type29', 'Soil_Type32', 'Soil_Type22', 'Soil_Type23', 'Soil_Type31', 
                                      'Soil_Type24', 'Soil_Type12', 'Soil_Type30', 'Soil_Type20', 'Soil_Type13', 
