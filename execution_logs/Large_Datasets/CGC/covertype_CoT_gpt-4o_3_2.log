Aspect_Cosine']", "# Elevation_Fire_Ratio\n# Ratio of Elevation to Horizontal_Distance_To_Fire_Points\n# Usefulness: Highlights areas significantly elevated compared to fire proximity, which might play biomechanical roles in preventing or facilitating certain forest types and ignition patterns.\ndf['Elevation_Fire_Ratio'] = df['Elevation'] / (df['Horizontal_Distance_To_Fire_Points'] + 1e-6)", "# Wilderness_Area_Binary\n# Converts Wilderness_Area indicators into a binary feature (1 if any area is present, else 0).\n# Usefulness: Simplifies wilderness area representation while retaining the key information of presence, which might correlate strongly with specific forest types.\ndf['Wilderness_Area_Binary'] = (df[['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3', 'Wilderness_Area4']].sum(axis=1) > 0).astype(int)", "# Soil_Type_Count\n# Counts the number of different Soil_Type indicators present for each data point.\n# Usefulness: Aggregates soil type information in a concise numeric representation, correlating with more complex soil compositions potentially favoring particular forest cover types.\ndf['Soil_Type_Count'] = df[[col for col in df.columns if col.startswith('Soil_Type')]].sum(axis=1)", "# Hillshade_Time_Difference\n# Difference between Hillshade at 9am and Hillshade at 3pm\n# Usefulness: Captures light variation throughout the day, which might influence forest cover as certain species thrive in specific diurnal exposure patterns.\ndf['Hillshade_Time_Difference'] = df['Hillshade_3pm'] - df['Hillshade_9am']", "df.drop(columns=['Roadways_Hydrology_Distance_Ratio', 'Fire_Proximity_Hydrology_Ratio', 'Wilderness_Area_Sum', 'Soil_Type_Sum', 'Soil_Type_Binary'], inplace=True)", "# Horizontal_Distance_Squared_Ratio\n# Ratio of squared Horizontal_Distance_To_Roadways to squared Horizontal_Distance_To_Fire_Points.\n# Usefulness: Emphasizes the squared proximity dynamics between two key geographic distances, which might strongly influence forest cover.\ndf['Horizontal_Distance_Squared_Ratio'] = (df['Horizontal_Distance_To_Roadways']  2) / ((df['Horizontal_Distance_To_Fire_Points']  2) + 1e-6)"]
