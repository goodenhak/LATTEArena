2026-05-12 13:24:34,063 - INFO - ops_string = ["# Log_Normalized_Hydrology_Distance\n# Feature description: Log transformation of Horizontal_Distance_To_Hydrology normalized by its range.\n# Usefulness: Transforms the distance metric into a smaller and more compressed scale, capturing proportional differences effectively.\n\ndf['Log_Normalized_Hydrology_Distance'] = np.log(df['Horizontal_Distance_To_Hydrology'] + 1) / (np.max(df['Horizontal_Distance_To_Hydrology']) + 1)", "# Slope_Cosine_Interaction\n# Feature description: Interaction between the slope steepness and cosine of aspect direction: cos(Aspect) * Slope.\n# Usefulness: Captures the relationship between slope and directional orientation, meaningful for forest cover analysis.\n\ndf['Slope_Cosine_Interaction'] = np.cos(df['Aspect_Cosine']) * df['Slope']", "# Hydrology_Normalized_Ratio\n# Feature description: Ratio of Hydrology_Elevation_Ratio to Fire_Hydrology_Proximity_Sum normalized by its range.\n# Usefulness: Combines hydrology elevation details with proximity metrics in a normalized ratio to improve prediction robustness.\n\ndf['Hydrology_Normalized_Ratio'] = df['Hydrology_Elevation_Ratio'] / (df['Fire_Hydrology_Proximity_Sum'] + 1)", "# Hillshade_Mean_Interaction\n# Feature description: Interaction of Combined_Hillshade_Mean with Normalized_Hillshade_Diff.\n# Usefulness: Captures combined influence of terrain shading and directional lighting differences which affect vegetation and soil type.\n\ndf['Hillshade_Mean_Interaction'] = df['Combined_Hillshade_Mean'] * df['Normalized_Hillshade_Diff']", "# Soil_Type_Wilderness_Interaction_Normalized\n# Feature description: Combines soil type frequency and wilderness interactions normalized by Soil_Wilderness_Combined_Interaction.\n# Usefulness: Measures how biodiversity and geography influence forest cover type normalized for interaction effects.\n\ndf['Soil_Type_Wilderness_Interaction_Normalized'] = df['Soil_Type_Frequency'] / (df['Soil_Wilderness_Combined_Interaction'] + 1)", "# Slope_Impact_Factor\n# Feature description: Product of Slope and Elevation_ZScore to identify areas of steep terrain and their elevation.\n# Usefulness: Highlights how elevation changes impact the forest type in steep terrains.\n\ndf['Slope_Impact_Factor'] = df['Slope'] * df['Elevation_ZScore']", "# Roadway_Fire_Binary_Proximity\n# Feature description: Binary indicator of Roadway proximity interaction (<mean) with Fire distance interaction (<mean).\n# Usefulness: Helps identify areas of forest close to human interaction points and potential wildfire ignition.\n\ndf['Roadway_Fire_Binary_Proximity'] = ((df['Horizontal_Distance_To_Roadways'] < df['Horizontal_Distance_To_Roadways'].mean()) & \n                                       (df['Horizontal_Distance_To_Fire_Points'] < df['Horizontal_Distance_To_Fire_Points'].mean())).astype(int)", "# Normalized_Aspect_Time\n# Feature description: Ratio of Aspect_Sine over the square root of Hillshade_Time_Difference normalized by its range.\n# Usefulness: Captures interplay between terrain orientation and shadowing differences across time.\n\ndf['Normalized_Aspect_Time'] = df['Aspect_Sine'] / (np.sqrt(np.abs(df['Hillshade_Time_Difference']) + 1))", "# Wilderness_Binary_Sum\n# Feature description: Binary sum of all Wilderness Area indicators (Wilderness_Area1 + Wilderness_Area2 + Wilderness_Area3).\n# Usefulness: Encodes whether the cell belongs to any wilderness area of interest.\n\ndf['Wilderness_Binary_Sum'] = (df['Wilderness_Area1'] + df['Wilderness_Area2'] + df['Wilderness_Area3']).astype(int)", "# Hillshade_Terrain_Avg\n# Feature description: Average of Hillshade_9am, Hillshade_Noon, and Hillshade_3pm weighted by slope.\n# Usefulness: Averages terrain shading influences adjusted for steep terrain areas for vegetation impact modeling.\n\ndf['Hillshade_Terrain_Avg'] = (df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].mean(axis=1) * df['Slope'])", "# Drop Aspect_Directionality_Cross\n# Usefulness: Aspect_Directionality_Cross overlaps conceptually with Normalized_Aspect_Product, making it redundant.\n\ndf.drop(columns=['Aspect_Directionality_Cross'], inplace=True)", "# Drop Combined_Hillshade_Mean_Sqrt\n# Usefulness: While the square root transformation is useful mathematically, the raw Combined_Hillshade_Mean is more interpretable.\n\ndf.drop(columns=['Combined_Hillshade_Mean_Sqrt'], inplace=True)"]
