                                      'Soil_Type26', 'Soil_Type35', 'Soil_Type18', 'Soil_Type6', 'Soil_Type7', 
                                      'Soil_Type3', 'Soil_Type28']].sum(axis=1)
end

python
# High_Fire_Hazard_Index
# Feature description: Binary indicator if the cell is close to both a fire point and roadway (both distances < 500).
# Usefulness: Highlights high-risk regions where proximity to roads and fire points could lead to specific vegetation differences or fire management zones.
df['High_Fire_Hazard_Index'] = ((df['Horizontal_Distance_To_Fire_Points'] < 500) & 
                                (df['Horizontal_Distance_To_Roadways'] < 500)).astype(int)
end

