# Horizontal_Distance_To_Roadways_Square
# Square of Horizontal_Distance_To_Roadways
# Usefulness: Captures the exponential effect of distance to roadways on forest cover type as proximity might have nonlinear impact on human activities and ecological dynamics.
df['Horizontal_Distance_To_Roadways_Square'] = df['Horizontal_Distance_To_Roadways']  2
end

python
# Elevation_Vertical_Diff_Cube
# Cube of Elevation_Vertical_Diff
# Usefulness: Allows capturing extreme variations in elevation difference that might influence forest type significantly due to geological or hydrological factors.
df['Elevation_Vertical_Diff_Cube'] = df['Elevation_Vertical_Diff']  3
end

python
# Fire_Roadways_Proximity_Ratio
# Ratio of Horizontal_Distance_To_Fire_Points to Horizontal_Distance_To_Roadways
# Usefulness: Helps analyze cells where fire proximity is high relative to roadways, potentially indicating areas more prone to wildfires due to accessibility for human activity.
df['Fire_Roadways_Proximity_Ratio'] = df['Horizontal_Distance_To_Fire_Points'] / (df['Horizontal_Distance_To_Roadways'] + 1e-6)
end

python
