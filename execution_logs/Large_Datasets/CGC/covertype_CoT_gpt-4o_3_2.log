# Square root of Combined_Hillshade_Mean
# Usefulness: Helps contain extreme values and emphasize medium hillshade values that might better correlate with forest type due to light exposure.
df['Combined_Hillshade_Mean_Sqrt'] = np.sqrt(df['Combined_Hillshade_Mean'])
end

python
# Aspect_Directionality_Cross
# Product of Aspect_Sine and Aspect_Cosine
# Usefulness: Combines both sine and cosine aspects to enhance the cyclic nature of directional orientation and its combined impact on forest cover.
df['Aspect_Directionality_Cross'] = df['Aspect_Sine'] * df['Aspect_Cosine']
end

python
# Elevation_Fire_Ratio
# Ratio of Elevation to Horizontal_Distance_To_Fire_Points
# Usefulness: Highlights areas significantly elevated compared to fire proximity, which might play biomechanical roles in preventing or facilitating certain forest types and ignition patterns.
df['Elevation_Fire_Ratio'] = df['Elevation'] / (df['Horizontal_Distance_To_Fire_Points'] + 1e-6)
end

python
# Wilderness_Area_Binary
# Converts Wilderness_Area indicators into a binary feature (1 if any area is present, else 0).
# Usefulness: Simplifies wilderness area representation while retaining the key information of presence, which might correlate strongly with specific forest types.
df['Wilderness_Area_Binary'] = (df[['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3', 'Wilderness_Area4']].sum(axis=1) > 0).astype(int)
end

python
