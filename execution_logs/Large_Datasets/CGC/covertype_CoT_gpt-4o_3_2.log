 'Soil_Type26', 'Soil_Type35', 'Soil_Type18', 'Soil_Type6', 'Soil_Type7', \n                                      'Soil_Type3', 'Soil_Type28']].sum(axis=1)", "# High_Fire_Hazard_Index\n# Feature description: Binary indicator if the cell is close to both a fire point and roadway (both distances < 500).\n# Usefulness: Highlights high-risk regions where proximity to roads and fire points could lead to specific vegetation differences or fire management zones.\ndf['High_Fire_Hazard_Index'] = ((df['Horizontal_Distance_To_Fire_Points'] < 500) & \n                                (df['Horizontal_Distance_To_Roadways'] < 500)).astype(int)", "# Drop less informative columns\ndf.drop(columns=['Soil_Type36', 'Soil_Type35', 'Soil_Type26', 'Soil_Type27', 'Soil_Type25', 'Soil_Type28',\n                 'Soil_Type18', 'Soil_Type6', 'Soil_Type40', 'Soil_Type7', 'Soil_Type3', 'Soil_Type21',\n                 'Soil_Type9', 'Soil_Type19', 'Wilderness_Area_Binary'], inplace=True)", "# Hillshade_Diff_9am_Noon\n# Feature description: Difference between Hillshade_9am and Hillshade_Noon.\n# Usefulness: Captures the directional exposure to sunlight during the morning and noon, which can affect vegetation growth rates.\ndf['Hillshade_Diff_9am_Noon'] = df['Hillshade_9am'] - df['Hillshade_Noon']", "# Hydrology_Roadways_Proximity_Ratio\n# Feature description: Ratio of Horizontal_Distance_To_Hydrology to Horizontal_Distance_To_Roadways.\n# Usefulness: Forest cover types may vary based on the proportional distance to water and nearby roadways, indicating the impact of human development relative to natural water sources.\ndf['Hydrology_Roadways_Proximity_Ratio'] = df['Horizontal_Distance_To_Hydrology'] / (df['Horizontal_Distance_To_Roadways'] + 1e-6)"]
