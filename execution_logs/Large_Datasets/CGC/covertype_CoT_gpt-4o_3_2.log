# Lag_Slope_Adjusted_Hydrology
# Feature description: Introduces lag values of Slope_Adjusted_Hydrology for temporal dependencies (assuming data has a sequential structure).
# Usefulness: Temporal analysis helps track hydrology adjustment over consecutive measurements, potentially indicating water flow patterns across elevations.
df['Lag_Slope_Adjusted_Hydrology'] = df['Slope_Adjusted_Hydrology'].shift(1)
end

python
# Combined_Hillshade_Avg_Diff
# Feature description: Difference between Combined_Hillshade_Mean and the average of Hillshade_9am, noon, and 3pm values.
# Usefulness: Provides a variability measure between high and low points of solar radiation exposure, which influences vegetation growth.
df['Combined_Hillshade_Avg_Diff'] = df['Combined_Hillshade_Mean'] - (df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].mean(axis=1))
end

python
# Reciprocal_Horizontal_Distance_To_Roadways
# Feature description: Reciprocal of Horizontal_Distance_To_Roadways to emphasize closer roadways.
# Usefulness: Highlights areas near roadways which might undergo transformation in soil or forest cover due to human activities.
df['Reciprocal_Horizontal_Distance_To_Roadways'] = 1 / (df['Horizontal_Distance_To_Roadways'] + 1e-5)
end

python
# Vertical_Distance_Hydrology_Directionality
# Feature description: Interaction between Vertical_Distance_To_Hydrology and Aspect_Sine to capture directional elevation changes relative to hydrology.
# Usefulness: Slope combined with hydrology’s directionality gives spatial alignment insight, which could help predict vegetation.
df['Vertical_Distance_Hydrology_Directionality'] = df['Vertical_Distance_To_Hydrology'] * df['Aspect_Sine']
end

python
# Soil_Wilderness_Ratio
# Feature description: Ratio between Soil_Type_Indicator_Interaction and Wilderness_Area flags.
# Usefulness: Measures combined influence of wilderness zones and specific soil types on forest cover. Useful for understanding interaction effects.
df['Soil_Wilderness_Ratio'] = (df['Soil_Type_Indicator_Interaction'] + 1e-5) / (df[['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3']].sum(axis=1) + 1e-5)
end

python
# Drop Soil_Type indicators (22, 23, etc.)
# Reason: Individual indicators may not provide enough insight; interactions or counts of soil features are captured through separate aggregated metrics.
df.drop(columns=['Soil_Type10', 'Soil_Type11', 'Soil_Type12', 'Soil_Type13', 'Soil_Type16', 'Soil_Type20', 'Soil_Type22', 'Soil_Type23', 
                 'Soil_Type24', 'Soil_Type29', 'Soil_Type30', 'Soil_Type31', 'Soil_Type32', 'Soil_Type33', 'Soil_Type38', 'Soil_Type39'], 
       inplace=True)
end

python
# Drop Wilderness Area indicators 
# Reason: Combine all Wilderness Area indicators into a single interaction or aggregate feature for simplicity and modeling efficiency.
df.drop(columns=['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3'], inplace=True)
end
