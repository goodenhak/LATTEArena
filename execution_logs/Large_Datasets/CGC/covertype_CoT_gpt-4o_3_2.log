# Horizontal_Distance_To_Roadways_Sq
# Feature description: Square of Horizontal_Distance_To_Roadways. Represents the impact of extreme distances to roadways in predicting forest cover type.
# Usefulness: Helps capture non-linear relationships where proximity to roadways may have diminishing or amplifying effects on cover type classification and wildlife behavior.
df['Horizontal_Distance_To_Roadways_Sq'] = df['Horizontal_Distance_To_Roadways']  2
end

python
# Elevation_Vertical_Diff_ZScore
# Feature description: Z-score normalization for Elevation_Vertical_Diff to standardize the feature.
# Usefulness: Ensures consistent evaluation of this variable across different magnitudes, reducing sensitivity to variation and allowing models to focus on relative differences.
df['Elevation_Vertical_Diff_ZScore'] = (df['Elevation_Vertical_Diff'] - df['Elevation_Vertical_Diff'].mean()) / df['Elevation_Vertical_Diff'].std()
end

python
# Combined_Hillshade_Sum
# Feature description: Sum of Hillshade_9am, Hillshade_Noon, and Hillshade_3pm.
# Usefulness: Captures overall hillshade exposure throughout the day which may correlate to vegetation density or soil moisture.
df['Combined_Hillshade_Sum'] = (
    df['Hillshade_9am'] + df['Hillshade_Noon'] + df['Hillshade_3pm']
)
end

python
# Soil_Type_Majority
# Feature description: Indicator aggregation that detects whether the soil type is among the majority contributing types (frequently occurring Soil_Type indicators).
# Usefulness: Combines sparsely distributed soil types into high-frequency bins for better correlation analysis.
majority_soil_types = ['Soil_Type29', 'Soil_Type23', 'Soil_Type32']
df['Soil_Type_Majority'] = df[majority_soil_types].sum(axis=1) > 0
end

python
# Elevation_Slope_Product
# Feature description: Product of Elevation and Slope.
# Usefulness: Captures interactions between steep terrain and elevation likely to impact forest distribution and soil composition.
df['Elevation_Slope_Product'] = df['Elevation'] * df['Slope']
end

python
# Wilderness_Mixed_Ratio
# Feature description: Ratio of Wilderness_Area variables normalized by sum of entries in Wilderness_Area_Sum.
# Usefulness: Balances multi-presence factor effects to wilderness zones within a biome-based region.
wilderness_features = ['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3', 'Wilderness_Area4']
df['Wilderness_Mixed_Ratio'] = df[wilderness_features].sum(axis=1) / df['Wilderness_Area_Sum']
end

python
# Aspect_Transformed_Tangent
# Feature description: Applies tangent transformation to Aspect feature to amplify critical slope directional shifts.
# Usefulness: Highlights minor angular variances that may disproportionately impact vegetation distribution patterns.
df['Aspect_Transformed_Tangent'] = df['Aspect'].apply(lambda x: np.tan(np.radians(x)))
end

