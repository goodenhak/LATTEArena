# Feature name: Road_Fire_Hydrology_Median_Ratio
# Feature description: Calculates the median proximity ratio between roadways, fire points, and hydrology: median([Horizontal_Distance_To_Roadways, Horizontal_Distance_To_Fire_Points, Horizontal_Distance_To_Hydrology]) / sum([Horizontal_Distance_To_Roadways + Horizontal_Distance_To_Fire_Points + Horizontal_Distance_To_Hydrology]).
# Usefulness: This feature captures the central tendency of proximity ratios across the three geographic features for better understanding the coverage zone proximity.
df['Road_Fire_Hydrology_Median_Ratio'] = (df[['Horizontal_Distance_To_Roadways', 'Horizontal_Distance_To_Fire_Points', 'Horizontal_Distance_To_Hydrology']].median(axis=1)) / (df['Horizontal_Distance_To_Roadways'] + df['Horizontal_Distance_To_Fire_Points'] + df['Horizontal_Distance_To_Hydrology'])
end

python
# Feature name: Elevation_Slope_Adjusted
# Feature description: Combines Elevation and Slope into a single feature representing adjusted elevation based on the slope steepness: Elevation * log(Slope + 1).
# Usefulness: This helps assess terrain difficulty which can affect forest cover type, as steep regions may limit certain types of vegetation growth.
df['Elevation_Slope_Adjusted'] = df['Elevation'] * np.log(df['Slope'] + 1)
end

python
# Feature name: Soil_Type_Binary_Sum
# Feature description: Counts the binary presence of all Soil_Type indicators per observation (sum of Soil_Type columns).
# Usefulness: Simplifies soil analysis by creating a composite feature that represents the diversity of soil types in an area. This affects vegetation and thus forest cover types.
df['Soil_Type_Binary_Sum'] = df.filter(like='Soil_Type').sum(axis=1)
end

python
# Feature name: Hydrology_Impact_Index
# Feature description: Combines vertical distance and horizontal distance to hydrology into a single index: sqrt((Vertical_Distance_To_Hydrology  2) + (Horizontal_Distance_To_Hydrology  2)).
# Usefulness: Integrates water feature proximity metrics to measure the direct spatial impact of hydrology on vegetation and forest cover.
df['Hydrology_Impact_Index'] = np.sqrt((df['Vertical_Distance_To_Hydrology']  2) + (df['Horizontal_Distance_To_Hydrology']  2))
end

python
# Feature name: Normalized_Hillshade_Variance
# Feature description: Computes the variance of hillshade measurements normalized by the sum of those values: var([Hillshade_9am, Hillshade_Noon, Hillshade_3pm]) / sum([Hillshade_9am, Hillshade_Noon, Hillshade_3pm]).
# Usefulness: Captures terrain shadow variation which influences forest growth dynamics and sunlight availability.
df['Normalized_Hillshade_Variance'] = df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].var(axis=1) / df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].sum(axis=1)
end

python
# Feature name: Soil_Wilderness_Combined_Interaction
# Feature description: Interaction between wilderness areas and aggregated soil types: Wilderness_Area1 + Wilderness_Area2 + Wilderness_Area3 + Soil_Type_Binary_Sum.
# Usefulness: Measures the combined ecological interaction between soil richness and wilderness presence which strongly impacts forest growth patterns.
df['Soil_Wilderness_Combined_Interaction'] = df[['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3']].sum(axis=1) + df['Soil_Type_Binary_Sum']
end

python
