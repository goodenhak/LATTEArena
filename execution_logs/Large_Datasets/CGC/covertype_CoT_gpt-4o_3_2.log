# Interaction_Soil_Type_23_Wilderness_Area1
# Feature description: Encodes interaction between Soil_Type23 and Wilderness_Area1 to capture potential spatial dependencies.
# Usefulness: Certain soil types combined with wilderness areas might influence forest cover type. This feature combines such spatial information.
df['Interaction_Soil_Type_23_Wilderness_Area1'] = df['Soil_Type23'] * df['Wilderness_Area1']
end

python
# Combined_Hydrology_Fire_Ratio
# Feature description: Ratio of Horizontal_Distance_To_Hydrology to Horizontal_Distance_To_Fire_Points.
# Usefulness: Provides relative proximity measure between hydrology and fire points, which might impact nearby forest cover types.
df['Combined_Hydrology_Fire_Ratio'] = df['Horizontal_Distance_To_Hydrology'] / (df['Horizontal_Distance_To_Fire_Points'] + 1e-5)
end

python
# Elevation_Hydrology_Fire_Interaction
# Feature description: Ratio combining Elevation, Horizontal_Distance_To_Hydrology, and Horizontal_Distance_To_Fire_Points.
# Usefulness: Elevation’s interplay with hydrology and fire points could be a critical determinant of specific forest cover types.
df['Elevation_Hydrology_Fire_Interaction'] = df['Elevation'] / (df['Horizontal_Distance_To_Hydrology'] + df['Horizontal_Distance_To_Fire_Points'] + 1e-5)
end

python
# Fire_Roadways_Hydrology_Distance_Sum
# Feature description: Sum of distances to fire points, roadways, and hydrology.
# Usefulness: Aggregating proximity measures provides an overall density metric for distances to key geographic features.
df['Fire_Roadways_Hydrology_Distance_Sum'] = df['Horizontal_Distance_To_Fire_Points'] + df['Horizontal_Distance_To_Roadways'] + df['Horizontal_Distance_To_Hydrology']
end

python
# Soil_Type_Coverage_Normalized
# Feature description: Normalized count of non-zero soil type indicators to account for the variability in soil coverage gapped by normalization.
# Usefulness: Normalizing soil type coverage could highlight areas with more diverse soil types, influencing forest growth.
df['Soil_Type_Coverage_Normalized'] = (df['Soil_Type_Coverage'] - df['Soil_Type_Coverage'].min()) / (df['Soil_Type_Coverage'].max() - df['Soil_Type_Coverage'].min())
end

