2026-05-12 13:40:25,226 - INFO - ops_string = ["# Add new features for the dataset using feature engineering\n\n# 1. Hillshade_Sum\n# Feature description: Sum of all hillshade features (9am, Noon, 3pm) to create an overall illumination feature.\n# Usefulness: Summing different hillshade values gives an overall quantification of how exposed the area is to sunlight.\ndf['Hillshade_Sum'] = df['Hillshade_9am'] + df['Hillshade_Noon'] + df['Hillshade_3pm']", "# 2. Hillshade_Mean\n# Feature description: Calculates the mean value of hillshades at 9am, Noon, and 3pm.\n# Usefulness: Provides a general illumination index and reduces variability among the three individual hillshade features.\ndf['Hillshade_Mean'] = df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].mean(axis=1)", "# 3. Hillshade_Std\n# Feature description: Standard deviation of all three hillshades to measure illumination variability.\n# Usefulness: High variation across hillshades could indicate terrain irregularity in terms of exposure to light at different times.\ndf['Hillshade_Std'] = df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].std(axis=1)", "# 4. Elevation_Feature_Diff\n# Feature description: Difference between Elevation and Elevation_Vertical_Diff, representing the discrepancy between the main elevation and adjusted distances.\n# Usefulness: Can help determine if elevation data is aligning with hydrographical features and vertical distances.\ndf['Elevation_Feature_Diff'] = df['Elevation'] - df['Elevation_Vertical_Diff']", "# 5. Roadways_Fire_Interaction\n# Feature description: Product of Horizontal_Distance_To_Roadways and Horizontal_Distance_to_Fire_Points.\n# Usefulness: Multiplies two metrics related to critical human and environmental proximity to assess their combined influence.\ndf['Roadways_Fire_Interaction'] = df['Horizontal_Distance_To_Roadways'] * df['Horizontal_Distance_To_Fire_Points']", "# 6. Slope_Adjusted_Hydrology\n# Feature description: Combines slope and hydrology to provide an adjusted hydrology measure: Vertical_Distance_To_Hydrology / max(Slope, 1)\n# Usefulness: Accounts for how slope steepness interacts with proximity to water, which can influence forest cover type.\ndf['Slope_Adjusted_Hydrology'] = df['Vertical_Distance_To_Hydrology'] / (df['Slope'].replace(0, 1))", "# 7. Hydrology_Fire_Density\n# Feature description: Ratio of Hydrology_Fire_Product_Distance to Fire_Hydrology_Proximity_Sum.\n# Usefulness: Combines the distance metrics between hydrology and fire points to derive a density-like measure.\ndf['Hydrology_Fire_Density'] = df['Hydrology_Fire_Product_Distance'] / df['Fire_Hydrology_Proximity_Sum']", "# 8. Normalized_Distance_To_Roadways\n# Feature description: Normalizes the Horizontal_Distance_To_Roadways using min-max normalization.\n# Usefulness: Helps compare distances to roadways on a uniform scale, which is useful for downstream tasks.\ndf['Normalized_Distance_To_Roadways'] = (df['Horizontal_Distance_To_Roadways'] - df['Horizontal_Distance_To_Roadways'].min()) / (\n                                         df['Horizontal_Distance_To_Roadways'].max() - df['Horizontal_Distance_To_Roadways'].min())", "# 9. Soil_Type_Coverage\n# Feature description: Count of soil type indicators that are non-zero per row.\n# Usefulness: Capable of assessing biodiversity or range of soil-types associated with specific cover type and hydrological features.\ndf['Soil_Type_Coverage'] = (df.filter(like='Soil_Type').sum(axis=1))", "# 10. Roadways_Water_Adjacency_Sum\n# Feature description: Sum of proximity measures related to roadways, hydrology, and fire points (distances combined).\n# Usefulness: Captures the total sum of proximity across critical landscape features to the observation point.\ndf['Roadways_Water_Adjacency_Sum'] = df['Horizontal_Distance_To_Roadways'] + df['Horizontal_Distance_To_Hydrology'] + df['Horizontal_Distance_To_Fire_Points']", "# 11. Relative_Hydrology_Distance\n# Feature description: Ratio of Horizontal_Distance_To_Hydrology to Fire_Roadways_Proximity_Ratio.\n# Usefulness: Normalizes the distance-to-water feature by its relationship to distance from roadways and fire proximity.\ndf['Relative_Hydrology_Distance'] = df['Horizontal_Distance_To_Hydrology'] / (df['Fire_Roadways_Proximity_Ratio'] + 1e-10)", "# 12. Elevation_Normalized_Slope_Interaction\n# Feature description: Combines elevation and slope using a multiplicative interaction and normalizes the result.\n# Usefulness: Creates a feature capturing terrain steepness adjusted by the elevation.\ndf['Elevation_Normalized_Slope_Interaction'] = (df['Elevation'] * df['Slope']) / (df['Slope'].max() * df['Elevation'].max())", "# Drop redundant or highly correlated columns based on feature description\ndf.drop(columns=[\n    'Slope_Hydrology_Multiplication',  # Redundant given that Slope_Adjusted_Hydrology is computed.\n    'Combined_Hillshade_Mean',  # Redundant due to Hillshade_Mean being computed directly.\n    'Soil_Type_Frequency',  # Redundant as Soil_Type_Coverage addresses the same information.\n    'Normalized_Hillshade_Variance',  # Redundant as Hillshade Std can capture variability in a less complex way.\n    'Soil_Type_Binary_Sum'  # Similar information as Soil_Type_Coverage but less refined.\n], inplace=True)"]
