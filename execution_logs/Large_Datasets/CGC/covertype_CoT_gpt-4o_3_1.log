python
# Elevation_Mean_Wilderness_Z
# Z-score normalization of Elevation grouped by Wilderness Area, capturing localized elevation variation for classification.
# Usefulness: This feature emphasizes how much a cell's elevation deviates from the mean elevation of its wilderness area, aiding terrain-specific classification.
df['Elevation_Mean_Wilderness_Z'] = (df['Elevation_Relative_To_Mean_Wilderness'] - df['Elevation_Relative_To_Mean_Wilderness'].mean()) / df['Elevation_Relative_To_Mean_Wilderness'].std()
end

python
# Fire_Road_Weighted_Interaction
# Interaction feature combining Fire_Road_Proximity_Ratio and Roadways_Normalized_Hillshade_Impact.
# Usefulness: Highlights relative roadway and fire proximity against terrain lighting, which can impact forest cover type prediction.
df['Fire_Road_Weighted_Interaction'] = df['Fire_Road_Proximity_Ratio'] * df['Roadways_Normalized_Hillshade_Impact']
end

python
# Hydrology_Ratio_Elevation_Adjusted
# Ratio of Elevation_Normalized_Hydrology_Ratio to Elevation, adjusted for topography and water distance.
# Usefulness: Captures the relative impact of hydrology against the backdrop of elevation variance, useful for understanding land cover changes.
df['Hydrology_Ratio_Elevation_Adjusted'] = df['Elevation_Normalized_Hydrology_Ratio'] / df['Elevation']
end

python
# Wilderness_Area_Main_Impact_ZScore
# Z-score normalization of Wilderness_Area_Main_Impact relative to terrain factors like slope or elevation.
# Usefulness: Emphasizes the variability of wilderness importance across major areas, giving context to historical prioritization.
df['Wilderness_Area_Main_Impact_ZScore'] = (df['Wilderness_Area_Main_Impact'] - df['Wilderness_Area_Main_Impact'].mean()) / df['Wilderness_Area_Main_Impact'].std()
end

python
# Adjusted_Elevated_Road_Fire_Ratio
# Ratio of Elevated_Road_Fire_Proximity to Hydrology_Distance_Ratio, capturing proximity impacts in higher terrain zones.
# Usefulness: Adds value by combining terrain elevation, road-fire proximity, and hydrology proximity, which can influence cover types.
df['Adjusted_Elevated_Road_Fire_Ratio'] = df['Elevated_Road_Fire_Proximity'] / (df['Hydrology_Distance_Ratio'] + 0.0001)
end

python
# Slope_Hillshade_Cosine_Interaction
# Product of cosine of Aspect and Slope adjusted by Hillshade_Mean.
# Usefulness: Combines slope directionality and lighting effects, which affect vegetation growth and forest cover types.
df['Slope_Hillshade_Cosine_Interaction'] = df['Aspect_Cosine'] * df['Slope'] * df['Hillshade_Mean']
end

python
# Wilderness_Density_Normalized
# Normalize Wilderness_Density_Depth by Slope to capture accessibility in dense wilderness zones.
# Usefulness: Identifies accessibility difficulties in regions of higher wilderness density, influencing forest cover predictions.
df['Wilderness_Density_Normalized'] = df['Wilderness_Density_Depth'] / (df['Slope'] + 1)
end

python
# Hydrology_Fire_Road_Impact_Percentage
# Percentage impact of Hydrology_Fire_Road_Weighted_Sum relative to the mean.
# Usefulness: Simplifies understanding of water-road-fire interactions by expressing their weighted effect as a percentage.
df['Hydrology_Fire_Road_Impact_Percentage'] = (df['Hydrology_Fire_Road_Weighted_Sum'] / df['Hydrology_Fire_Road_Weighted_Sum'].mean()) * 100
end

python
# Wilderness_Hydrology_Impact_Density
# Product of Wilderness_Hydrology_Connectivity and Wilderness_Density_Depth, emphasizing dense regions with hydrology connectivity.
# Usefulness: Captures interplay between hydrology connectivity and wilderness density zones, measuring forest ecosystems.
df['Wilderness_Hydrology_Impact_Density'] = df['Wilderness_Hydrology_Connectivity'] * df['Wilderness_Density_Depth']
end

python
# Roadway_Hydrology_Normalized_Proximity
# Normalize Roadways_Proximity_ZScore with Hydrology_Proximity_Impact for combined accessibility adjustment.
# Usefulness: Represents combined influences of proximity to roads and water sources on forest cover predictions.
df['Roadway_Hydrology_Normalized_Proximity'] = df['Roadways_Proximity_ZScore'] / (df['Hydrology_Proximity_Impact'] + 0.0001)
end

