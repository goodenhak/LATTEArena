# Adjusted_Hillshade_Impact_Slope_Normalized
# Feature description: Ratio of Hillshade_Brightness_Weighted_Slope with Slope_Normalized_Hydrology_Distance.
# Usefulness: Reflects the combined effect of illumination and terrain slope characteristics adjusted for hydrology proximity, emphasizing areas with favorable conditions for forest growth.

df['Adjusted_Hillshade_Impact_Slope_Normalized'] = df['Hillshade_Brightness_Weighted_Slope'] / (df['Slope_Normalized_Hydrology_Distance'] + 1)
end

python
# Road_Forest_Cover_Impact
# Feature description: Interaction between Roadways_Normalized_Hillshade_Impact and Soil_Type_Main_Presence, highlighting the influence of human accessibility on forest cover.
# Usefulness: Accessibility through roads may influence cover types via human interaction or disturbance, which could help distinguish between forest types.

df['Road_Forest_Cover_Impact'] = df['Roadways_Normalized_Hillshade_Impact'] * (df['Soil_Type_Main_Presence'])
end

python
# Wilderness_Hydrology_Ratio
# Feature description: Ratio of Wilderness_Density_Depth and Hydrology_Fire_Road_Weighted_Sum.
# Usefulness: Captures density within wilderness zones relative to proximity to hydrology and road impacts, emphasizing patterns of forest cover within areas less affected by infrastructure.

df['Wilderness_Hydrology_Ratio'] = df['Wilderness_Density_Depth'] / (df['Hydrology_Fire_Road_Weighted_Sum'] + 1)
end

python
# Soil_Type_Proximity_Intensity
# Feature description: Product of Fire_Road_Weighted_Proximity and Soil_Type_Sum.
# Usefulness: Highlights the impact of road and fire proximity on cells with varied soil types, which can significantly influence forest cover characteristics.

df['Soil_Type_Proximity_Intensity'] = df['Fire_Road_Weighted_Proximity'] * df['Soil_Type_Sum']
end

python
# Normalized_Forest_Hillshade
# Feature description: Z-score normalization of Hillshade_Mean across all wilderness zones.
# Usefulness: Enables better comparison of terrain lighting characteristics across zones, important for vegetation grown in shaded versus sunny areas.

df['Normalized_Forest_Hillshade'] = (df['Hillshade_Mean'] - df['Hillshade_Mean'].mean()) / df['Hillshade_Mean'].std()
end

python
# Soil_Type_Hydrology_Directionality
# Feature description: Ratio of Adjusted_Elevated_Road_Fire_Ratio to Soil_Type_Specific_Impact.
# Usefulness: Captures directional hydrology and proximity impact adjusted for specific soil presence, which is crucial for forest survival under mixed terrain conditions.

df['Soil_Type_Hydrology_Directionality'] = df['Adjusted_Elevated_Road_Fire_Ratio'] / (df['Soil_Type_Specific_Impact'] + 1)
end

python
# Elevation_Forest_Shade_Interaction
# Feature description: Product of Elevation_ZScore and Hillshade_Range.
# Usefulness: Highlights the influence of elevation changes combined with lighting variability on forest cover distribution.

df['Elevation_Forest_Shade_Interaction'] = df['Elevation_ZScore'] * df['Hillshade_Range']
end

python
# Proximity_Road_Wilderness_Impact
