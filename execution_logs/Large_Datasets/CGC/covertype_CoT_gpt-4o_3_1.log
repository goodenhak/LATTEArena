2026-05-12 07:10:18,737 - INFO - ops_string = ["# Interaction_Terrain_Slope_Forest - Cross interaction between Slope and Soil_Type_Sum\n# Feature description: This feature captures impact of slope variation in relation to the presence of specific soil types, which can affect water retention and forest cover distribution.\n# Usefulness: Slope influences water runoff, and higher soil type diversity might indicate better water retention and absorption. This combination directly impacts vegetation survival and forest types.\n\ndf['Interaction_Terrain_Slope_Forest'] = df['Slope'] * df['Soil_Type_Sum']", "# Hydrology_Slope_Percentage_Impact\n# Feature description: Percent interaction between Slope and Hydrology_Distance_Ratio.\n# Usefulness: Helps capture how slope and proximity to hydrology features influence soil and water accumulation, which are key determinants of forest cover types.\n\ndf['Hydrology_Slope_Percentage_Impact'] = 100 * (df['Slope_Hydrology_Impact'] / (df['Horizontal_Distance_To_Hydrology'] + 1))", "# Adjusted_Hillshade_Impact_Slope_Normalized\n# Feature description: Ratio of Hillshade_Brightness_Weighted_Slope with Slope_Normalized_Hydrology_Distance.\n# Usefulness: Reflects the combined effect of illumination and terrain slope characteristics adjusted for hydrology proximity, emphasizing areas with favorable conditions for forest growth.\n\ndf['Adjusted_Hillshade_Impact_Slope_Normalized'] = df['Hillshade_Brightness_Weighted_Slope'] / (df['Slope_Normalized_Hydrology_Distance'] + 1)", "# Road_Forest_Cover_Impact\n# Feature description: Interaction between Roadways_Normalized_Hillshade_Impact and Soil_Type_Main_Presence, highlighting the influence of human accessibility on forest cover.\n# Usefulness: Accessibility through roads may influence cover types via human interaction or disturbance, which could help distinguish between forest types.\n\ndf['Road_Forest_Cover_Impact'] = df['Roadways_Normalized_Hillshade_Impact'] * (df['Soil_Type_Main_Presence'])", "# Wilderness_Hydrology_Ratio\n# Feature description: Ratio of Wilderness_Density_Depth and Hydrology_Fire_Road_Weighted_Sum.\n# Usefulness: Captures density within wilderness zones relative to proximity to hydrology and road impacts, emphasizing patterns of forest cover within areas less affected by infrastructure.\n\ndf['Wilderness_Hydrology_Ratio'] = df['Wilderness_Density_Depth'] / (df['Hydrology_Fire_Road_Weighted_Sum'] + 1)", "# Soil_Type_Proximity_Intensity\n# Feature description: Product of Fire_Road_Weighted_Proximity and Soil_Type_Sum.\n# Usefulness: Highlights the impact of road and fire proximity on cells with varied soil types, which can significantly influence forest cover characteristics.\n\ndf['Soil_Type_Proximity_Intensity'] = df['Fire_Road_Weighted_Proximity'] * df['Soil_Type_Sum']", "# Normalized_Forest_Hillshade\n# Feature description: Z-score normalization of Hillshade_Mean across all wilderness zones.\n# Usefulness: Enables better comparison of terrain lighting characteristics across zones, important for vegetation grown in shaded versus sunny areas.\n\ndf['Normalized_Forest_Hillshade'] = (df['Hillshade_Mean'] - df['Hillshade_Mean'].mean()) / df['Hillshade_Mean'].std()", "# Soil_Type_Hydrology_Directionality\n# Feature description: Ratio of Adjusted_Elevated_Road_Fire_Ratio to Soil_Type_Specific_Impact.\n# Usefulness: Captures directional hydrology and proximity impact adjusted for specific soil presence, which is crucial for forest survival under mixed terrain conditions.\n\ndf['Soil_Type_Hydrology_Directionality'] = df['Adjusted_Elevated_Road_Fire_Ratio'] / (df['Soil_Type_Specific_Impact'] + 1)", "# Elevation_Forest_Shade_Interaction\n# Feature description: Product of Elevation_ZScore and Hillshade_Range.\n# Usefulness: Highlights the influence of elevation changes combined with lighting variability on forest cover distribution.\n\ndf['Elevation_Forest_Shade_Interaction'] = df['Elevation_ZScore'] * df['Hillshade_Range']", "# Proximity_Road_Wilderness_Impact\n# Feature description: Ratio of Horizontal_Distance_To_Roadways and Wilderness_Hydrology_Impact_Density.\n# Usefulness: Captures accessibility impacts relative to wilderness density, emphasizing human intervention on forest areas.\n\ndf['Proximity_Road_Wilderness_Impact'] = df['Horizontal_Distance_To_Roadways'] / (df['Wilderness_Hydrology_Impact_Density'] + 1)", "# Dense_Wilderness_Slope_Directionality\n# Feature description: Combination of Wilderness_Density_Normalized and Slope_Hillshade_Cosine_Interaction.\n# Usefulness: Captures the combined effect of wilderness density and slope directionality on hillshade, important for understanding forest type and growth patterns.\n\ndf['Dense_Wilderness_Slope_Directionality'] = df['Wilderness_Density_Normalized'] * df['Slope_Hillshade_Cosine_Interaction']", "# Dropping redundant or overly complex features\n# Reason: These columns introduce high variance with limited interpretability, diminish model efficacy, or overlap with existing features.\n\ndf.drop(columns=['Elevated_Road_Fire_Proximity', \n                 'Adjusted_Elevated_Road_Fire_Ratio', \n                 'Aspect_Hillshade_Cosine_Impact', \n                 'Hydrology_Ratio_Gradient', \n                 'Aspect_Sine'], inplace=True)"]
