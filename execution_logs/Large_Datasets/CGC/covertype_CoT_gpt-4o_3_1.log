# Usefulness: Integrating directional terrain alignment and shade intensity captures critical factors influencing vegetation cover in forestry environments.

df['Aspect_Hillshade_Cosine_Impact'] = df['Aspect_Cosine'] * df['Hillshade_Mean']
end

python
# Hydrology_Ratio_Gradient
# Feature description: Interaction between Hydrology_Distance_Ratio and Vertical_Slope_To_Hydrology. Captures the relationship between vertical and horizontal water distances and slopes.
# Usefulness: This feature reflects hydrology-connected terrain gradients crucial for understanding vegetation and forest types supported by localized water availability.

df['Hydrology_Ratio_Gradient'] = df['Hydrology_Distance_Ratio'] * df['Vertical_Slope_To_Hydrology']
