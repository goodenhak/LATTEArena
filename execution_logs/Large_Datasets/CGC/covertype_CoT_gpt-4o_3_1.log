# Elevation_squared
# Feature description: Square of Elevation. Captures the nonlinear impact elevation may have on the forest cover type.
# Usefulness: Forest types may exhibit nonlinear relationships with elevation due to animal behavior, tree species adaptability, and climatic zones.

df['Elevation_squared'] = df['Elevation']  2
end

python
# Aspect_sin
# Feature description: Sine transformation of Aspect. Represents orientation of terrain (e.g., north-facing vs. south-facing slopes).
# Usefulness: North-facing slopes may retain more moisture and have different vegetation composition compared to south-facing slopes.

df['Aspect_sin'] = np.sin(np.radians(df['Aspect']))
end

python
# Vertical_Hydrology_ratio
# Feature description: Ratio of Vertical Distance to Horizontal Distance to Hydrology.
# Usefulness: Indicates steepness of terrain relative to water features, which may influence moisture levels and vegetation type.

df['Vertical_Hydrology_ratio'] = df['Vertical_Distance_To_Hydrology'] / (df['Horizontal_Distance_To_Hydrology'] + 1e-6)
end

python
# Combined_Hillshade
# Feature description: Average hillshade across 9am, noon, and 3pm.
# Usefulness: Provides an aggregate measure of sunlight exposure throughout the day, which impacts vegetation types.

df['Combined_Hillshade'] = (df['Hillshade_9am'] + df['Hillshade_Noon'] + df['Hillshade_3pm']) / 3
end

python
# Distance_to_Hydrology_Rank
# Feature description: Rank transformation of Horizontal_Distance_To_Hydrology.
# Usefulness: Identifies relative positioning to hydrology across instances. Proximity to water is a strong predictor of vegetation density and type.

df['Distance_to_Hydrology_Rank'] = df['Horizontal_Distance_To_Hydrology'].rank()
end

python
# Road_Fire_ratio
# Feature description: Ratio of Horizontal_Distance_To_Roadways to Horizontal_Distance_To_Fire_Points.
# Usefulness: Areas closer to roads but farther from fire points may indicate human-modified landscapes, influencing vegetation patterns.

df['Road_Fire_ratio'] = df['Horizontal_Distance_To_Roadways'] / (df['Horizontal_Distance_To_Fire_Points'] + 1e-6)
end

python
# Wilderness_Area_combined
# Feature description: Combined indicator for Wilderness_Area presence (sum of all four wilderness area columns).
# Usefulness: Creates a single variable to measure wilderness coverage. Presence or absence of wilderness directly influences forest cover type.

df['Wilderness_Area_combined'] = df[['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3', 'Wilderness_Area4']].sum(axis=1)
end

python
# Soil_Type_count
# Feature description: Counts the total number of soil type indicators that are active (value = 1).
# Usefulness: Indicates soil diversity in a given plot. Soil characteristics strongly influence vegetation types.

df['Soil_Type_count'] = df.iloc[:, 15:55].sum(axis=1)
end

python
# Road_hydrology_diff
# Feature description: Difference between Horizontal_Distance_To_Roadways and Horizontal_Distance_To_Hydrology.
# Usefulness: Captures relative distance to roads and water features, which may signal human activity or accessibility.

df['Road_hydrology_diff'] = df['Horizontal_Distance_To_Roadways'] - df['Horizontal_Distance_To_Hydrology']
end

python
# Slope_exp
# Feature description: Exponential transformation of slope.
# Usefulness: Captures the nonlinear impact steepness may have on vegetation type and terrain characteristics.

df['Slope_exp'] = np.exp(df['Slope'])
end

python
# Elevation_zscore
# Feature description: Z-score normalization of Elevation.
# Usefulness: Provides a standardized way of capturing relative elevation values across the dataset.

df['Elevation_zscore'] = (df['Elevation'] - df['Elevation'].mean()) / df['Elevation'].std()
end

python
df.drop(columns=['Soil_Type1', 'Soil_Type14', 'Soil_Type15', 'Soil_Type37'], inplace=True)
end
