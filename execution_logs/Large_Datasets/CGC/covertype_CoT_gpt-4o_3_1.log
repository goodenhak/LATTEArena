2026-05-12 04:47:30,085 - INFO - ops_string = ["# Feature: Elevation_Hydrology_Ratio\n# Feature description: Ratio of Elevation to Horizontal_Distance_To_Hydrology. This captures the relative height of the cell above the nearest hydrology feature.\n# Usefulness: This feature adds insight into the terrain slope or steepness relative to water sources, which can influence vegetation patterns and forest cover type.\n\ndf['Elevation_Hydrology_Ratio'] = df['Elevation'] / (df['Horizontal_Distance_To_Hydrology'] + 1)", "# Feature: Fire_Road_Proximity_Ratio\n# Feature description: Ratio of Horizontal_Distance_To_Roadways to Horizontal_Distance_To_Fire_Points.\n# Usefulness: This emphasizes the proximity relationship between roadways and fire points, potentially linked to human intervention or risk in forest management.\n\ndf['Fire_Road_Proximity_Ratio'] = df['Horizontal_Distance_To_Roadways'] / (df['Horizontal_Distance_To_Fire_Points'] + 1)", "# Feature: Wilderness_Mean_Elevation_Impact\n# Feature description: Elevation minus the mean elevation of cells belonging to the same wilderness area.\n# Usefulness: Captures localized terrain variations within each wilderness area, which could be indicative of habitat zones for specific forest cover types.\n\ndf['Wilderness_Mean_Elevation_Impact'] = df['Elevation'] - df.groupby('Wilderness_Area1')['Elevation'].transform('mean')", "# Feature: Hydrology_Fire_Road_Weighted_Sum\n# Feature description: Weighted sum of Horizontal_Distance_To_Hydrology, Horizontal_Distance_To_Fire_Points, and Horizontal_Distance_To_Roadways.\n# Usefulness: Combines proximity to critical features (hydrology, fire points, roadways) to derive a composite proximity score, aiding classification.\n\ndf['Hydrology_Fire_Road_Weighted_Sum'] = (\n    0.4 * df['Horizontal_Distance_To_Hydrology'] + \n    0.3 * df['Horizontal_Distance_To_Fire_Points'] + \n    0.3 * df['Horizontal_Distance_To_Roadways']\n)", "# Feature: Hillshade_Time_Weighted_Impact\n# Feature description: Weighted average of Hillshade indices (9am, noon, 3pm) weighted by time (morning = 0.4, noon = 0.3, evening = 0.3).\n# Usefulness: Accounts for sunlight exposure across times of the day, which impacts terrain vegetation and cover type.\n\ndf['Hillshade_Time_Weighted_Impact'] = (\n    0.4 * df['Hillshade_9am'] + \n    0.3 * df['Hillshade_Noon'] + \n    0.3 * df['Hillshade_3pm']\n)", "# Feature: Slope_Hydrology_Impact\n# Feature description: Product of Slope and Vertical_Distance_To_Hydrology.\n# Usefulness: Reflects how slope interacts with elevation changes near water sources, potentially driving forest cover differences.\n\ndf['Slope_Hydrology_Impact'] = df['Slope'] * df['Vertical_Distance_To_Hydrology']", "# Feature: Wilderness_Area_Soil_Type\n# Feature description: Combination of Wilderness Area presence and major Soil Type indicators into one categorical value.\n# Usefulness: Encodes combined interaction between soil type and wilderness zones, enabling grouping by ecological characteristics.\n\ndf['Wilderness_Area_Soil_Type'] = df[['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3']].idxmax(axis=1) + (\n    _ + df[['Soil_Type29', 'Soil_Type33', 'Soil_Type23']].idxmax(axis=1)\n)", "# Dropping redundant and uninformative columns\n# Reason: Soil_Type indicators with frequencies close to zero offer negligible predictive value and introduce potential model noise.\n\ndf.drop(columns=['Soil_Type36', 'Soil_Type7', 'Soil_Type8', 'Soil_Type25', 'Soil_Type21'], inplace=True)", "# Feature: Adjusted_Slope_Impact\n# Feature description: Interaction between Slope and Elevation, normalized by the Vertical_Distance_To_Hydrology.\n# Usefulness: Captures terrain's inclination relative to height changes and hydrology proximity, enhancing classification.\n\ndf['Adjusted_Slope_Impact'] = df['Slope'] * df['Elevation'] / (df['Vertical_Distance_To_Hydrology'] + 1)", "# Feature: Wilderness_Hydrology_Connectivity\n# Feature description: Product of Wilderness_Priority and Hydrology_Proximity_Impact.\n# Usefulness: Combined factor indicates strategic wilderness importance influenced by hydrology proximity, useful for cover prediction.\n\ndf['Wilderness_Hydrology_Connectivity'] = df['Wilderness_Priority'] * df['Hydrology_Proximity_Impact']", "# Feature: Soil_Type_Specific_Elevation_Mean\n# Feature description: Mean elevation grouped by Soil_Type_Main_Presence.\n# Usefulness: Measures elevation differences across regions dominated by specific soil types to reflect their influence on cover types.\n\ndf['Soil_Type_Specific_Elevation_Mean'] = df.groupby('Soil_Type_Main_Presence')['Elevation'].transform('mean')"]
