2026-05-12 06:15:54,576 - INFO - ops_string = ["# Wilderness_Slope_Gradient\n# Feature description: Product of Slope and Is_Wilderness_1_Or_2. Combining slope with the wilderness area can capture terrain difficulty within historically important regions.\n# Usefulness: This emphasizes the impact of slope variation specifically for wilderness areas 1 and 2, where cover type prediction may highly depend on slope.\n\ndf['Wilderness_Slope_Gradient'] = df['Slope'] * df['Is_Wilderness_1_Or_2']", "# Elevated_Fire_Road_Ratio\n# Feature description: Ratio of Elevated_Road_Fire_Proximity to Elevation_Relative_To_Mean_Wilderness.\n# Usefulness: This feature adjusts road-fire proximity scores by localized elevation differences, emphasizing contextual terrain influence.\n\ndf['Elevated_Fire_Road_Ratio'] = df['Elevated_Road_Fire_Proximity'] / (df['Elevation_Relative_To_Mean_Wilderness'] + 1e-8)", "# Soil_Type_Major_Importance\n# Feature description: Interaction between Soil_Type_Main_Presence and Roadways_Proximity_ZScore. Captures major soil type importance with respect to proximity to roads influencing forest cover types.\n# Usefulness: This combines environmental and proximity factors to highlight the influence of dominant soil types in areas accessible by roadways.\n\ndf['Soil_Type_Major_Importance'] = df['Soil_Type_Main_Presence'] * df['Roadways_Proximity_ZScore']", "# Aspect_Hillshade_Cosine_Impact\n# Feature description: Product of Aspect_Cosine and Hillshade_Mean, emphasizing terrain alignment with daily shade impacts.\n# Usefulness: Integrating directional terrain alignment and shade intensity captures critical factors influencing vegetation cover in forestry environments.\n\ndf['Aspect_Hillshade_Cosine_Impact'] = df['Aspect_Cosine'] * df['Hillshade_Mean']", "# Hydrology_Ratio_Gradient\n# Feature description: Interaction between Hydrology_Distance_Ratio and Vertical_Slope_To_Hydrology. Captures the relationship between vertical and horizontal water distances and slopes.\n# Usefulness: This feature reflects hydrology-connected terrain gradients crucial for understanding vegetation and forest types supported by localized water availability.\n\ndf['Hydrology_Ratio_Gradient'] = df['Hydrology_Distance_Ratio'] * df['Vertical_Slope_To_Hydrology']", "# Fire_Road_Relative_Density\n# Feature description: Ratio of Fire_Road_Proximity_Ratio to Wilderness_Density_Depth.\n# Usefulness: Adjusts fire-road proximity by wilderness density, emphasizing the importance of open versus dense wilderness areas in determining cover types.\n\ndf['Fire_Road_Relative_Density'] = df['Fire_Road_Proximity_Ratio'] / (df['Wilderness_Density_Depth'] + 1e-8)", "# Roadways_Normalized_Hillshade_Impact\n# Feature description: Product of Roadways_Proximity_ZScore and Hillshade_Time_Weighted_Impact.\n# Usefulness: Combines road accessibility with diurnal shade impacts to predict forest cover responses across varied time-based lighting conditions.\n\ndf['Roadways_Normalized_Hillshade_Impact'] = df['Roadways_Proximity_ZScore'] * df['Hillshade_Time_Weighted_Impact']", "# Wilderness_Elevation_Cover_Impact\n# Feature description: Product of Wilderness_Elevation_Factor and Elevation_Hydrology_Ratio to capture combined elevation and water accessibility in wilderness zones.\n# Usefulness: Emphasizes elevation-water dynamics within wilderness areas for predicting forest cover types.\n\ndf['Wilderness_Elevation_Cover_Impact'] = df['Wilderness_Elevation_Factor'] * df['Elevation_Hydrology_Ratio']", "# Hillshade_Wilderness_Contrast\n# Feature description: Interaction between Hillshade_Contrast and Wilderness_Area_Main_Impact.\n# Usefulness: Focuses on the contrast in lighting across major wilderness areas, which could influence vegetation patterns and forest diversity.\n\ndf['Hillshade_Wilderness_Contrast'] = df['Hillshade_Contrast'] * df['Wilderness_Area_Main_Impact']", "# Soil_Type_Weighted_Hydrology_Slope\n# Feature description: Product of Soil_Type_Sum, Hydrology_As_Slope, and Slope_Hydrology_Impact.\n# Usefulness: Combines soil type quantity, hydrology ratios, and slope impacts to account for terrain-soil combinations driving forest characteristics.\n\ndf['Soil_Type_Weighted_Hydrology_Slope'] = df['Soil_Type_Sum'] * df['Hydrology_As_Slope'] * df['Slope_Hydrology_Impact']", "# Soil_Type_Impact_Dense_Areas\n# Feature description: Product of Soil_Type_Specific_Impact and Wilderness_Density_Depth, emphasizing soil-specific impacts in densely forested wilderness zones.\n# Usefulness: Highlighting soil interactions in dense areas enhances prediction accuracy for cover types supported by specific soil compositions.\n\ndf['Soil_Type_Impact_Dense_Areas'] = df['Soil_Type_Specific_Impact'] * df['Wilderness_Density_Depth']", "# Drop columns with NaN values\n# Feature description: Dropping improperly calculated columns with non-numeric or missing values.\ndf.drop(columns=['Adjusted_Slope_Aspect_Cosine'], inplace=True)\ndf.drop(columns=['Wilderness_Elevation_Factor'], inplace=True)", "# Drop redundant soil type columns\n# Feature description: Remove columns with very sparsely populated soil types that contribute little to prediction accuracy.\ndf.drop(columns=['Soil_Type9', 'Soil_Type17', 'Soil_Type27', 'Soil_Type28', 'Soil_Type34'], inplace=True)"]
