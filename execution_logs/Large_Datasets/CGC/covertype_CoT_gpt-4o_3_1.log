# Usefulness: Focuses on the contrast in lighting across major wilderness areas, which could influence vegetation patterns and forest diversity.

df['Hillshade_Wilderness_Contrast'] = df['Hillshade_Contrast'] * df['Wilderness_Area_Main_Impact']
end

python
# Soil_Type_Weighted_Hydrology_Slope
# Feature description: Product of Soil_Type_Sum, Hydrology_As_Slope, and Slope_Hydrology_Impact.
# Usefulness: Combines soil type quantity, hydrology ratios, and slope impacts to account for terrain-soil combinations driving forest characteristics.

df['Soil_Type_Weighted_Hydrology_Slope'] = df['Soil_Type_Sum'] * df['Hydrology_As_Slope'] * df['Slope_Hydrology_Impact']
end

