# Usefulness: Adjusts fire-road proximity by wilderness density, emphasizing the importance of open versus dense wilderness areas in determining cover types.

df['Fire_Road_Relative_Density'] = df['Fire_Road_Proximity_Ratio'] / (df['Wilderness_Density_Depth'] + 1e-8)
end

python
# Roadways_Normalized_Hillshade_Impact
# Feature description: Product of Roadways_Proximity_ZScore and Hillshade_Time_Weighted_Impact.
# Usefulness: Combines road accessibility with diurnal shade impacts to predict forest cover responses across varied time-based lighting conditions.

df['Roadways_Normalized_Hillshade_Impact'] = df['Roadways_Proximity_ZScore'] * df['Hillshade_Time_Weighted_Impact']
end

python
# Wilderness_Elevation_Cover_Impact
# Feature description: Product of Wilderness_Elevation_Factor and Elevation_Hydrology_Ratio to capture combined elevation and water accessibility in wilderness zones.
# Usefulness: Emphasizes elevation-water dynamics within wilderness areas for predicting forest cover types.

df['Wilderness_Elevation_Cover_Impact'] = df['Wilderness_Elevation_Factor'] * df['Elevation_Hydrology_Ratio']
end

python
# Hillshade_Wilderness_Contrast
