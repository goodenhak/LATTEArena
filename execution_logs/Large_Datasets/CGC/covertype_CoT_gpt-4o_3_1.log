python
# Aspect_Sine
# The sine transformation of Aspect captures the northern/eastern-facing slopes, as Aspect is an angular measure (0-360 degrees).
# Usefulness: Northern-facing slopes might retain moisture differently compared to southern-facing slopes, affecting vegetation.
df['Aspect_Sine'] = np.sin(np.radians(df['Aspect']))
end

python
# Aspect_Cosine
# The cosine transformation of Aspect captures the eastern-western-facing slopes, complementing Aspect_Sine.
# Usefulness: This provides a way to understand the directional effects of light/water retention on forest cover type.
df['Aspect_Cosine'] = np.cos(np.radians(df['Aspect']))
end

python
# Hydrology_Distance_Ratio
# The ratio of Vertical_Distance_To_Hydrology to Horizontal_Distance_To_Hydrology.
# Usefulness: This provides a normalized measure of the proximity to water sources, which can strongly influence vegetation type.
df['Hydrology_Distance_Ratio'] = df['Vertical_Distance_To_Hydrology'] / (df['Horizontal_Distance_To_Hydrology'] + 1e-6)
end

python
# Hillshade_Mean
# Average hillshade value calculated from the three hillshade readings (9am, noon, 3pm).
# Usefulness: Provides a single representative metric for overall shading in a location, which affects sunlight exposure and vegetation types.
df['Hillshade_Mean'] = df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].mean(axis=1)
end

python
# Hillshade_Range
# Difference between maximum and minimum hillshade values across times of the day (9am, noon, 3pm).
# Usefulness: Highlights variability in sunlight exposure throughout the day, which may correlate to vegetation patterns.
df['Hillshade_Range'] = df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].max(axis=1) - df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].min(axis=1)
end

python
# Road_Fire_Proximity
# Ratio of Horizontal_Distance_To_Roadways to Horizontal_Distance_To_Fire_Points.
# Usefulness: This represents how urban proximity compares to wildfire proximity, which may provide insight into human vs natural influences.
df['Road_Fire_Proximity'] = df['Horizontal_Distance_To_Roadways'] / (df['Horizontal_Distance_To_Fire_Points'] + 1e-6)
end

python
# Elevation_ZScore
# Z-score normalization of Elevation feature using the mean and standard deviation.
# Usefulness: Highlights how elevation of each cell compares to the overall terrain, providing a relative elevation metric.
df['Elevation_ZScore'] = (df['Elevation'] - df['Elevation'].mean()) / df['Elevation'].std()
end

python
# Is_Wilderness_1_Or_2
# Binary feature indicating whether the cell belongs to Wilderness_Area1 or Wilderness_Area2.
# Usefulness: Combines Wilderness_Area1 and Wilderness_Area2 since the presence of these wilderness areas may have similar ecological factors affecting forest cover.
df['Is_Wilderness_1_Or_2'] = (df['Wilderness_Area1'] | df['Wilderness_Area2']).astype(int)
end

python
# Soil_Type_Sum
# Sum of all binary Soil_Type indicators.
# Usefulness: Represents how many soil types exist in a given sample, which can help differentiate diversity in soil composition.
df['Soil_Type_Sum'] = df.loc[:, 'Soil_Type1':'Soil_Type40'].sum(axis=1)
end

python
# Vertical_Slope_To_Hydrology
# Ratio of the Vertical_Distance_To_Hydrology to Slope.
# Usefulness: Combines slope and distance-to-hydrology metrics to represent steepness toward water sources, impacting vegetation growth.
df['Vertical_Slope_To_Hydrology'] = df['Vertical_Distance_To_Hydrology'] / (df['Slope'] + 1e-6)
end

