# Elevation_Normalized_Hydrology_Ratio
# Feature description: Ratio of Elevation to log-transformed Horizontal_Distance_To_Hydrology. This reduces the amplification of large distances while emphasizing relative elevation above water sources.
# Usefulness: Helps capture terrain characteristics that influence hydrology features more effectively, considering smaller hydrology distances are likely critical for forest cover type identification.

df['Elevation_Normalized_Hydrology_Ratio'] = df['Elevation'] / (1 + df['Horizontal_Distance_To_Hydrology'].apply(lambda x: max(np.log(x), 0)))
end

python
# Road_Fire_Hillshade_Weighted_Interaction
# Feature description: Weighted interaction between Road_Fire_Proximity, Hillshade_Mean, and Wilderness_Elevation_Factor. Focuses on how proximity to roads and fires interacts with shade in wilderness areas.
# Usefulness: Adds real-world understanding of how human infrastructure (roads/fires) combined with lighting and elevation factors might influence forest cover type changes.

df['Road_Fire_Hillshade_Weighted_Interaction'] = (df['Road_Fire_Proximity'] * df['Hillshade_Mean'] / (df['Wilderness_Elevation_Factor'] + 1))
end

python
# Adjusted_Slope_Aspect_Cosine
# Feature description: Product of Slope and Aspect_Cosine, weighted by Vertical_Distance_To_Hydrology. Emphasizes terrain inclination along directional sloping areas influenced by hydrology.
# Usefulness: Captures how slope direction and terrain steepness impact cover type due to water availability.

df['Adjusted_Slope_Aspect_Cosine'] = (df['Slope'] * df['Aspect_Cosine']) / (df['Vertical_Distance_To_Hydrology'] + 1)
end

python
# Soil_Type_Specific_Impact
# Feature description: Cumulative presence of major soil types weighted by Elevation_Relative_To_Mean_Wilderness. Adds a localized adjustment to soil type impact relative to wilderness elevation changes.
# Usefulness: Enhances soil-related contribution considering elevation variations in wilderness zones critical to forest classification.

df['Soil_Type_Specific_Impact'] = df[['Soil_Type23', 'Soil_Type29', 'Soil_Type33']].sum(axis=1) * df['Elevation_Relative_To_Mean_Wilderness']
end

python
# Fire_Hydrology_Ratio_Squared
# Feature description: Square of the ratio between Vertical_Distance_To_Hydrology and Horizontal_Distance_To_Fire_Points. Amplifies the interaction between vertical terrain and fire proximity influence.
# Usefulness: Highlights areas where hydrology and fire proximities become critical in predicting cover type due to terrain complexities.

df['Fire_Hydrology_Ratio_Squared'] = (df['Vertical_Distance_To_Hydrology'] / df['Horizontal_Distance_To_Fire_Points'])  2
end

python
# Hillshade_Range_Elevation_Scaled
# Feature description: Hillshade_Range adjusted by Elevation_ZScore. Adds a dynamic illumination-terrain feature emphasizing elevation variation impacts on lighting patterns.
# Usefulness: Integrates elevation into light variability measurement, which can influence growth patterns related to cover type classification.

df['Hillshade_Range_Elevation_Scaled'] = df['Hillshade_Range'] * (1 + df['Elevation_ZScore'])
end

python
# Wilderness_Area_Main_Impact
# Feature description: Binary impact of major wilderness areas (Wilderness_Area1 and Wilderness_Area3) weighted by slope average.
# Usefulness: Focuses on priority wilderness zones and their terrain steepness impact for forest cover classification.

df['Wilderness_Area_Main_Impact'] = (df['Wilderness_Area1'] + df['Wilderness_Area3']) * (df['Slope'] / df['Slope'].mean())
end

python
# Hydrology_Accessibility_Sqrt
# Feature description: Square root transformation of Hydrology_Fire_Road_Weighted_Sum to smooth large accessibility scores, emphasizing smaller accessibility impacts.
# Usefulness: Helps understand how hydrology, roads, and fire proximity affect terrain in manageable units for modeling.

df['Hydrology_Accessibility_Sqrt'] = np.sqrt(df['Hydrology_Fire_Road_Weighted_Sum'])
end

python
# Wilderness_Forest_Connectivity
# Feature description: Interaction between Wilderness_Hydrology_Connectivity and Soil_Type_Main_Presence, weighted by Hillshade_Mean.
# Usefulness: Integrates hydrology-soil connectivity within wilderness zones with illumination conditions for more nuanced classification.

df['Wilderness_Forest_Connectivity'] = df['Wilderness_Hydrology_Connectivity'] * df['Soil_Type_Main_Presence'] * df['Hillshade_Mean']
end

python
df.drop(columns=['Adjusted_Slope_Impact', 'Elevation_Terrain_Ratio'], inplace=True)

# Dropped columns rationale:
# Adjusted_Slope_Impact and Elevation_Terrain_Ratio were removed because they introduced extreme values (infinity and NaN), which destabilize models. Transformation complexity doesn't justify their computational impact or real-world interpretability.
end
