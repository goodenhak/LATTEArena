# Elevation_Relative_To_Mean_Wilderness
# Elevation minus the mean Elevation for each Wilderness Area, capturing localized terrain differences for classification.
# Usefulness: Elevation is a critical variable affecting vegetation and terrain preferences for forest cover types. By normalizing it relative to Wilderness Areas, we account for local geographic contexts, improving predictions.

df['Elevation_Relative_To_Mean_Wilderness'] = df['Elevation'] - df.groupby(['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3', 'Wilderness_Area4']).transform('mean')['Elevation']
end

python
# Wilderness_Density_Depth
# Product of Horizontal_Distance_To_Roadways and Horizontal_Distance_To_Fire_Points, emphasizing proximity-based wilderness density.
# Usefulness: This highlights interactions between human infrastructure (roads, fire points) and wilderness regions, which directly correlate with forest cover types.

df['Wilderness_Density_Depth'] = df['Horizontal_Distance_To_Roadways'] * df['Horizontal_Distance_To_Fire_Points']
end

python
# Adjusted_Aspect_Slope_Interaction
# Interaction feature combining sine of Aspect and Slope to represent terrain inclination with directionality.
# Usefulness: Vegetation cover is sensitive to slope and sunlight exposure (Aspect). Combining these provides insight into growth conditions.

df['Adjusted_Aspect_Slope_Interaction'] = df['Aspect_Sine'] * df['Slope']
end

python
# Normalized_Soil_Type_Count
# Z-score normalization of Soil_Type_Sum, representing diversity in soil types.
# Usefulness: Soil diversity influences vegetation density and types. Normalizing this makes it more interpretable for prediction models.

df['Normalized_Soil_Type_Count'] = (df['Soil_Type_Sum'] - df['Soil_Type_Sum'].mean()) / df['Soil_Type_Sum'].std()
end

python
# Hydrology_Proximity_Impact
# Log-transformation of Vertical_Distance_To_Hydrology divided by Horizontal_Distance_To_Hydrology to capture hydrology proximity.
# Usefulness: This provides a more nuanced measure of terrain hydrology impact on vegetation, as both vertical and horizontal distances are important.

df['Hydrology_Proximity_Impact'] = np.log1p(df['Vertical_Distance_To_Hydrology'] / (df['Horizontal_Distance_To_Hydrology'] + 1e-9))
end

python
# Hillshade_Contrast
# Difference between Hillshade_9am and Hillshade_3pm to measure lighting contrast across the terrain.
# Usefulness: Forests in regions with high lighting contrasts may favor specific cover types, influenced by sunlight accessibility.

df['Hillshade_Contrast'] = df['Hillshade_9am'] - df['Hillshade_3pm']
end

python
# Soil_Type_Main_Presence
# Binary feature indicating presence of Soil_Type23, Soil_Type29, or Soil_Type33 (major types) in a given cell.
# Usefulness: Presence of dominant soil types influences predictions as these types are indicative of specific vegetation patterns.

df['Soil_Type_Main_Presence'] = ((df['Soil_Type23'] == 1) | (df['Soil_Type29'] == 1) | (df['Soil_Type33'] == 1)).astype(int)
end

python
# Slope_Normalized_Hydrology_Distance
# Horizontal_Distance_To_Hydrology normalized by Slope (divide by Slope + 1 to avoid zero division).
# Usefulness: Flat terrains with hydrology proximity might have different cover types compared to steep slopes. Normalization emphasizes this.

df['Slope_Normalized_Hydrology_Distance'] = df['Horizontal_Distance_To_Hydrology'] / (df['Slope'] + 1)
end

python
# Wilderness_Priority
# Weighted sum of Wilderness_Area1 and Wilderness_Area3 to emphasize historically important areas.
# Usefulness: Certain Wilderness Areas are more critical for predicting vegetation due to ecological priorities in National Forests.

df['Wilderness_Priority'] = df['Wilderness_Area1'] * 0.6 + df['Wilderness_Area3'] * 0.4
end

python
# Elevated_Road_Fire_Proximity
# Road_Fire_Proximity normalized with Elevation, to adjust proximity scores based on altitude.
# Usefulness: Vegetation preferences vary with altitude. Adding this feature adjusts human influence proxies (Road and Fire proximity) for elevation.

df['Elevated_Road_Fire_Proximity'] = df['Road_Fire_Proximity'] / (df['Elevation_ZScore'] + 1e-9)
end

python
# Drop redundant columns
# Dropping Soil_Type_Sum because its information is already captured in Normalized_Soil_Type_Count and Soil_Type_Main_Presence.
# Usefulness: Soil_Type_Sum is redundant when normalized and complemented by binary classifications.

df.drop(columns=['Soil_Type_Sum'], inplace=True)
end

python
# Drop unused wilderness area
# Dropping Wilderness_Area4 because it has a very low presence (Q1, Median, Q3 are all 0) making it irrelevant for predictions.
# Usefulness: Removing features with minimal variance increases model efficiency without sacrificing predictive power.

df.drop(columns=['Wilderness_Area4'], inplace=True)
end
