2026-05-12 04:18:59,137 - INFO - ops_string = ["# Elevation_Terrain_Ratio\n# Ratio of Elevation to the sum of Slope and Vertical_Distance_To_Hydrology. This combines height and its nearby terrain changes to help classify complex terrains.\n# Usefulness: Captures the rate of elevation change relative to vertical terrain and slope, potentially useful in distinguishing between cover types in uneven landscapes.\ndf['Elevation_Terrain_Ratio'] = df['Elevation'] / (df['Slope'] + df['Vertical_Distance_To_Hydrology'] + 1)", "# Fire_Road_Weighted_Proximity\n# Product of Horizontal_Distance_To_Roadways and Horizontal_Distance_To_Fire_Points normalized by sum of the two distances.\n# Usefulness: Highlights areas with combined accessibility to fire ignition points and roadways, emphasizing exposure to human activity and fire risk.\ndf['Fire_Road_Weighted_Proximity'] = (df['Horizontal_Distance_To_Roadways'] * df['Horizontal_Distance_To_Fire_Points']) / (df['Horizontal_Distance_To_Roadways'] + df['Horizontal_Distance_To_Fire_Points'] + 1)", "# Elevation_Diversity\n# Standard deviation of Elevation within each Wilderness_Area to measure terrain diversity in each wilderness zone.\n# Usefulness: Regions with high or low terrain variability often influence vegetation distribution and cover types.\ndf['Elevation_Diversity'] = df.groupby('Wilderness_Area1')['Elevation'].transform('std')", "# Soil_Type_Sum\n# The sum of all binary soil type indicators for each cell.\n# Usefulness: Provides an overview of soil diversity at a location, which can strongly influence vegetation patterns and forest cover types.\ndf['Soil_Type_Sum'] = df.filter(regex='^Soil_Type').sum(axis=1)", "# Hydrology_Interaction_Impact\n# Product of Vertical_Distance_To_Hydrology and Horizontal_Distance_To_Hydrology normalized by Slope.\n# Usefulness: Combines proximity to and depth of hydrological features with slope, capturing water accessibility and drainage effects.\ndf['Hydrology_Interaction_Impact'] = (df['Vertical_Distance_To_Hydrology'] * df['Horizontal_Distance_To_Hydrology']) / (df['Slope'] + 1)", "# Adjusted_Hillshade_Spread\n# Difference between Hillshade_Range and average of Hillshade indexes (9am, noon, 3pm).\n# Usefulness: Captures differential lighting conditions, which may suggest terrain orientation and vegetation patterns.\ndf['Adjusted_Hillshade_Spread'] = df['Hillshade_Range'] - df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].mean(axis=1)", "# Roadways_Proximity_ZScore\n# Z-score normalization of Horizontal_Distance_To_Roadways.\n# Usefulness: Emphasizes deviations in road proximity across features, scaling accessibility differences across terrains.\ndf['Roadways_Proximity_ZScore'] = (df['Horizontal_Distance_To_Roadways'] - df['Horizontal_Distance_To_Roadways'].mean()) / df['Horizontal_Distance_To_Roadways'].std(ddof=0)", "# Hydrology_As_Slope\n# Vertical_Distance_To_Hydrology divided by Horizontal_Distance_To_Hydrology.\n# Usefulness: Represents the hydrological grade or steepness near water features, which can vary across forest cover types.\ndf['Hydrology_As_Slope'] = df['Vertical_Distance_To_Hydrology'] / (df['Horizontal_Distance_To_Hydrology'] + 1)", "# Wilderness_Elevation_Factor\n# The mean Elevation in each Wilderness Area multiplied by Wilderness_Priority.\n# Usefulness: Combines wilderness-specific elevation characteristics with historical importance, emphasizing localized altitude significance.\ndf['Wilderness_Elevation_Factor'] = df.groupby('Is_Wilderness_1_Or_2')['Elevation'].transform('mean') * df['Wilderness_Priority']", "# Hillshade_Brightness_Weighted_Slope\n# Weighted average of all Hillshade indices relative to Slope.\n# Usefulness: Incorporates the sun exposure of the terrain while factoring in slope, highlighting microclimatic effects influencing vegetation.\ndf['Hillshade_Brightness_Weighted_Slope'] = (df['Hillshade_9am'] + df['Hillshade_Noon'] + df['Hillshade_3pm']) / (df['Slope'] + 1)", "df.drop(columns=['Normalized_Soil_Type_Count'], inplace=True)\n# This column primarily comprised NaN values and does not contribute meaningful predictive power."]
