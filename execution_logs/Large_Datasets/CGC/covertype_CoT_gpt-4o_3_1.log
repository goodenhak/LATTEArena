2026-05-12 06:42:08,618 - INFO - ops_string = ["# Elevation_Mean_Wilderness_Z\n# Z-score normalization of Elevation grouped by Wilderness Area, capturing localized elevation variation for classification.\n# Usefulness: This feature emphasizes how much a cell's elevation deviates from the mean elevation of its wilderness area, aiding terrain-specific classification.\ndf['Elevation_Mean_Wilderness_Z'] = (df['Elevation_Relative_To_Mean_Wilderness'] - df['Elevation_Relative_To_Mean_Wilderness'].mean()) / df['Elevation_Relative_To_Mean_Wilderness'].std()", "# Fire_Road_Weighted_Interaction\n# Interaction feature combining Fire_Road_Proximity_Ratio and Roadways_Normalized_Hillshade_Impact.\n# Usefulness: Highlights relative roadway and fire proximity against terrain lighting, which can impact forest cover type prediction.\ndf['Fire_Road_Weighted_Interaction'] = df['Fire_Road_Proximity_Ratio'] * df['Roadways_Normalized_Hillshade_Impact']", "# Hydrology_Ratio_Elevation_Adjusted\n# Ratio of Elevation_Normalized_Hydrology_Ratio to Elevation, adjusted for topography and water distance.\n# Usefulness: Captures the relative impact of hydrology against the backdrop of elevation variance, useful for understanding land cover changes.\ndf['Hydrology_Ratio_Elevation_Adjusted'] = df['Elevation_Normalized_Hydrology_Ratio'] / df['Elevation']", "# Wilderness_Area_Main_Impact_ZScore\n# Z-score normalization of Wilderness_Area_Main_Impact relative to terrain factors like slope or elevation.\n# Usefulness: Emphasizes the variability of wilderness importance across major areas, giving context to historical prioritization.\ndf['Wilderness_Area_Main_Impact_ZScore'] = (df['Wilderness_Area_Main_Impact'] - df['Wilderness_Area_Main_Impact'].mean()) / df['Wilderness_Area_Main_Impact'].std()", "# Adjusted_Elevated_Road_Fire_Ratio\n# Ratio of Elevated_Road_Fire_Proximity to Hydrology_Distance_Ratio, capturing proximity impacts in higher terrain zones.\n# Usefulness: Adds value by combining terrain elevation, road-fire proximity, and hydrology proximity, which can influence cover types.\ndf['Adjusted_Elevated_Road_Fire_Ratio'] = df['Elevated_Road_Fire_Proximity'] / (df['Hydrology_Distance_Ratio'] + 0.0001)", "# Slope_Hillshade_Cosine_Interaction\n# Product of cosine of Aspect and Slope adjusted by Hillshade_Mean.\n# Usefulness: Combines slope directionality and lighting effects, which affect vegetation growth and forest cover types.\ndf['Slope_Hillshade_Cosine_Interaction'] = df['Aspect_Cosine'] * df['Slope'] * df['Hillshade_Mean']", "# Wilderness_Density_Normalized\n# Normalize Wilderness_Density_Depth by Slope to capture accessibility in dense wilderness zones.\n# Usefulness: Identifies accessibility difficulties in regions of higher wilderness density, influencing forest cover predictions.\ndf['Wilderness_Density_Normalized'] = df['Wilderness_Density_Depth'] / (df['Slope'] + 1)", "# Hydrology_Fire_Road_Impact_Percentage\n# Percentage impact of Hydrology_Fire_Road_Weighted_Sum relative to the mean.\n# Usefulness: Simplifies understanding of water-road-fire interactions by expressing their weighted effect as a percentage.\ndf['Hydrology_Fire_Road_Impact_Percentage'] = (df['Hydrology_Fire_Road_Weighted_Sum'] / df['Hydrology_Fire_Road_Weighted_Sum'].mean()) * 100", "# Wilderness_Hydrology_Impact_Density\n# Product of Wilderness_Hydrology_Connectivity and Wilderness_Density_Depth, emphasizing dense regions with hydrology connectivity.\n# Usefulness: Captures interplay between hydrology connectivity and wilderness density zones, measuring forest ecosystems.\ndf['Wilderness_Hydrology_Impact_Density'] = df['Wilderness_Hydrology_Connectivity'] * df['Wilderness_Density_Depth']", "# Roadway_Hydrology_Normalized_Proximity\n# Normalize Roadways_Proximity_ZScore with Hydrology_Proximity_Impact for combined accessibility adjustment.\n# Usefulness: Represents combined influences of proximity to roads and water sources on forest cover predictions.\ndf['Roadway_Hydrology_Normalized_Proximity'] = df['Roadways_Proximity_ZScore'] / (df['Hydrology_Proximity_Impact'] + 0.0001)", "df.drop(columns=['Aspect'], inplace=True)\n# Dropped Aspect since cosine and sine transformations (Aspect_Cosine, Aspect_Sine) are already extracted and they hold richer direction-related information relevant for modeling.", "df.drop(columns=['Hydrology_As_Slope'], inplace=True)\n# Dropped Hydrology_As_Slope because Hydrology_Distance_Ratio achieves the same purpose but with richer transformation (e.g., ratio rather than a simple division).", "df.drop(columns=['Adjusted_Hillshade_Spread'], inplace=True)\n# Dropped Adjusted_Hillshade_Spread as it redundantly provides illumination information already encoded in Hillshade_Range_Elevation_Scaled and Hillshade_Contrast.", "df.drop(columns=['Road_Fire_Proximity'], inplace=True)\n# Dropped Road_Fire_Proximity since Elevated_Road_Fire_Proximity goes beyond this feature by incorporating elevation considerations for proximity adjustment.", "df.drop(columns=['Fire_Road_Relative_Density'], inplace=True)\n# Dropped Fire_Road_Relative_Density because its variance is excessively high, making it less useful for model prediction compared to other interaction features.", "df.drop(columns=['Soil_Type_Specific_Elevation_Mean'], inplace=True)\n# Dropped Soil_Type_Specific_Elevation_Mean because its value is almost constant across all entries (variance is too low), making it redundant.", "df.drop(columns=['Hydrology_Proximity_Impact'], inplace=True)\n# Dropped Hydrology_Proximity_Impact because it is redundant with other hydrology features like Hydrology_Distance_Ratio that are more versatile for modeling."]
