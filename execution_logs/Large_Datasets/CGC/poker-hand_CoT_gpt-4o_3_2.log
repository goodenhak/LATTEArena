df['square_rank_diff_max_min'] = df['rank_diff_max_min']  2
end

python
# flush_and_straight_interaction
# Feature description: Combines the is_flush and is_straight features to identify hands that could satisfy higher-ranked categories like Straight Flush (8) or Royal Flush (9).
# Usefulness: This interaction ensures both flush and straight are simultaneously considered which is critical to spotting Straight Flushes and Royal Flushes.

df['flush_and_straight_interaction'] = (df['is_flush'].astype(int) & df['is_straight'].astype(int))
end

python
# rank_diff_normalized
# Feature description: Normalizes rank_diff_max_min using min-max scaling to range [0, 1].
# Usefulness: Provides a standardized representation of rank differences, useful for downstream ML models that perform better with normalized input. Keeps the relative importance of this numerical feature within a bounded range.

rank_diff_min = df['rank_diff_max_min'].min()
rank_diff_max = df['rank_diff_max_min'].max()
df['rank_diff_normalized'] = (df['rank_diff_max_min'] - rank_diff_min) / (rank_diff_max - rank_diff_min)
end

