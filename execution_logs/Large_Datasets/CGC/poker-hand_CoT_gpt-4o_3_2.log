# rank_diff_norm
# Feature description: Normalizes the range of the rank_diff_max_min feature using min-max scaling so that values lie between 0 and 1.
# Usefulness: Normalized features improve model convergence during training, especially for algorithms sensitive to the scale of input features such as gradient-based optimizers.
df['rank_diff_norm'] = (df['rank_diff_max_min'] - df['rank_diff_max_min'].min()) / (df['rank_diff_max_min'].max() - df['rank_diff_max_min'].min())
end

python
# possible_straight_flush
# Feature description: Checks whether the hand qualifies for a straight flush by intersecting two preconditions: is_straight and is_flush.
# Usefulness: Straight flush (8) is a combination of both straight and flush; this additional combined feature helps identify those hands faster.
df['possible_straight_flush'] = df['is_straight_int'] & df['is_flush_int']
end

python
# rank_diff_to_median_diff
# Feature description: Computes the absolute deviation of rank_diff_max_min from its median.
# Usefulness: High deviations from the median could signify rare hands or outlier patterns affecting the sequentiality of ranks.
rank_diff_median = df['rank_diff_max_min'].median()
df['rank_diff_to_median_diff'] = abs(df['rank_diff_max_min'] - rank_diff_median)
end

python
# rank_diff_outlier_indicator
# Feature description: Identifies outlier hands by flagging instances where rank_diff_max_min falls outside 1.5 times the interquartile range (IQR).
# Usefulness: Helps downstream systems recognize hands with unusual rank distributions (e.g., hands far from typical straight-like patterns).
iqr = df['rank_diff_max_min'].quantile(0.75) - df['rank_diff_max_min'].quantile(0.25)
upper_bound = df['rank_diff_max_min'].quantile(0.75) + 1.5 * iqr
lower_bound = df['rank_diff_max_min'].quantile(0.25) - 1.5 * iqr
df['rank_diff_outlier_indicator'] = ((df['rank_diff_max_min'] > upper_bound) | (df['rank_diff_max_min'] < lower_bound)).astype(int)
end

python
# high_rank_pair
# Feature description: Checks if the hand has a high-value pair (e.g., pair of Ace, King, Queen, or Jack).
# Usefulness: High-value pairs are more impactful in poker; this feature can assist models in acknowledging and prioritizing these cases.
high_ranks = ['11', '12', '13', '14']  # Assuming rank 11=Jack, 12=Queen, 13=King, 14=Ace
df['high_rank_pair'] = df['rank_counts_encoded'].apply(lambda x: 1 if any([int(rank) in high_ranks for rank in x.split(,) if rank]) else 0)
end

python
