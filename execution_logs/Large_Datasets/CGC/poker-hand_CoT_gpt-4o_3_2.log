# is_straight_flush
# Feature description: Combines the conditions for a straight and a flush. It checks if the hand is both a straight and a flush simultaneously.
# Usefulness: Helps disambiguate between general flushes and high-value straight flush hands, which are ranked higher in poker. This is particularly useful for identifying Target=8 (Straight Flush).
df['is_straight_flush'] = df['is_straight'] & df['is_flush']
end

python
# rank_counts_mode
# Feature description: Extracts the mode (most frequent occurrence) of rank counts from rank_counts_encoded. If multiple modes exist, choose the smallest numeric value.
# Usefulness: Helps interpret the dominance of high-value cards in the hand and differentiates between patterns like full house or one pair. Specifically useful for targets like Target=1 (One Pair) and Target=6 (Full House).
df['rank_counts_mode'] = df['rank_counts_encoded'].apply(lambda x: max(set(x), key=x.count) if isinstance(x, list) else x)
end

python
# rank_counts_std
# Feature description: Computes the standard deviation of rank occurrences encoded in rank_counts_encoded, which quantifies variation in rank distribution.
# Usefulness: Helps detect hands with diverse card patterns (e.g., Target=0 — Nothing or Target=3 — Three of a Kind) compared to closely grouped hands (e.g., Target=6 — Full House).
df['rank_counts_std'] = df['rank_counts_encoded'].apply(lambda x: np.std(x) if isinstance(x, list) else 0)
end

python
# rank_gap_avg
# Feature description: Computes the average gap between ranks by dividing rank_diff_max_min by the number of gaps (4 for a five-card hand).
# Usefulness: Offers a normalized measure of rank spacing that helps in identifying straight-related hands (e.g., Target=4 — Straight) and in detecting hands that do not satisfy straight criteria due to gaps.
df['rank_gap_avg'] = df['rank_diff_max_min'] / 4
end

python
# is_tight_pattern
# Feature description: Indicator feature that checks if rank_diff_max_min is less than or equal to 5, signifying a tight rank spacing.
# Usefulness: Helps differentiate between hands likely to lead to consecutive ranks (e.g., Target=4 — Straight or Target=8 — Straight Flush) vs. those spread widely across ranks.
df['is_tight_pattern'] = df['rank_diff_max_min'].apply(lambda x: int(x <= 5))
end

python
# combined_royal_flush_candidate
# Feature description: Combines is_royal_flush and rank_diff_max_min features to refine identification. Specifically checks for hands having rank_diff_max_min=4 and is_royal_flush=True.
# Usefulness: Provides high confidence in detecting Target=9 — Royal Flush scenarios where both rank placements ({Ace, King, Queen, Jack, Ten}) and suit conditions are satisfied.
df['combined_royal_flush_candidate'] = df.apply(lambda row: int(row['is_royal_flush'] and row['rank_diff_max_min'] == 4), axis=1)
end

python
# suit_count
# Feature description: Counts the number of unique suits in the hand.
# Usefulness: Adds subtle yet critical information to check flush-related conditions (e.g., Target=5 — Flush or Target=8 — Straight Flush). A single unique suit implies flush potential. 
df['suit_count'] = df[['suit1', 'suit2', 'suit3', 'suit4', 'suit5']].nunique(axis=1)
end

python
# dropping suit_count intermediate column (if not needed after additional engineering steps)
