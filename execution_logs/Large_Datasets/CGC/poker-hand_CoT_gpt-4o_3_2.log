# rank_count_sum
# Feature description: Summation of rank_counts_encoded. Helps to understand the total count of ranks in hand, which can improve differentiation between different types of poker hands (like pairs vs. full house vs. four of a kind, etc.).
# Usefulness: This adds useful real-world knowledge by making it easier to distinguish between poker hands based on the number of each rank present. For example, higher sums would suggest hands like Four of a Kind or Full House.

df['rank_count_sum'] = df['rank_counts_encoded'].apply(lambda x: sum(eval(str(x))))
end

python
# rank_diff_normalized
# Feature description: Normalizes rank_diff_max_min by dividing it by the maximum possible rank difference (12). Helps comparisons across hands of varying rank spread.
# Usefulness: Encourages numerical stability and makes rank_diff_max_min comparable in models with non-scaled inputs.

df['rank_diff_normalized'] = df['rank_diff_max_min'] / 12
end

python
# is_high_card
# Feature description: Checks if the hand contains one of the highest-ranked cards: Ace, King, or Queen.
# Usefulness: Adds real-world knowledge by identifying hands likely associated with stronger poker values, such as Royal Flush possibilities or high-value cards.

df['is_high_card'] = df.apply(lambda row: max(row.loc[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']]) >= 10, axis=1)
end

python
# straight_flush_check
# Feature description: Combines is_straight and is_flush to explicitly indicate if the hand satisfies both conditions needed for a Straight Flush.
# Usefulness: Saves downstream efforts in separately combining straight and flush conditions while making the detection of Straight Flush simpler.

df['straight_flush_check'] = df['is_straight'] & df['is_flush']
end

python
# rank_counts_distribution
# Feature description: Encodes rank_counts_encoded into a one-hot vector for machine learning models. This captures detailed data about rank frequencies numerically while being directly usable by algorithms.
# Usefulness: One-hot encoding allows ML models to learn rules associated with different rank distributions directly, facilitating better predictions for categories like pairs, full houses, etc.

df = pd.get_dummies(df, columns=['rank_counts_encoded'], prefix='rank_count_distribution')
end

python
# drop_unnecessary_encoded_columns
# Feature description: Drops categorical columns after one-hot encoding or feature engineering (e.g., rank_counts_encoded) to maintain dataset cleanliness.
df.drop(columns=['rank_counts_encoded'], inplace=True)
end

python
# rank_diff_squared
# Feature description: Computes the squared value of rank_diff_max_min to amplify distinctions between hands with small and large rank spreads.
# Usefulness: Squaring penalizes smaller rank spreads more heavily and emphasizes hands with greater spreads, helping decision-making algorithms focus on rank patterns such as straights.

df['rank_diff_squared'] = df['rank_diff_max_min']  2
end

python
# royal_flush_possible
# Feature description: Checks if the hand has both is_flush and contains Ace, King, Queen, Jack, and Ten.
# Usefulness: This makes predicting Royal Flush more direct, as it combines multiple conditions into one check.

royal_cards = {10, 11, 12, 13, 1}  # Representing Ten, Jack, Queen, King, Ace
df['royal_flush_possible'] = df.apply(lambda row: royal_cards.issubset(set([row['rank1'], row['rank2'], row['rank3'], row['rank4'], row['rank5']])) and row['is_flush'], axis=1)
end

python
# normalized_rank_range
# Feature description: Computes rank_diff_max_min and normalizes it considering mean and standard deviation.
# Usefulness: Useful for ML tuning when numerical scaling aligns better to models' expectations and reduces bias towards raw values with large range.

df['normalized_rank_range'] = (df['rank_diff_max_min'] - 8.7714) / 2.2107
end
