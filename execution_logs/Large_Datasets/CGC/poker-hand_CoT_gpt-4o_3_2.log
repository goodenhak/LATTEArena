# straight_and_flush
# Feature description: Combines the is_straight and is_flush attributes to identify if a hand is a Straight Flush. Computed as the logical AND of is_straight and is_flush.
# Usefulness: While is_straight and is_flush are independent features, combining them helps directly check for Straight Flush hands (target = 8). This is especially useful since it requires both conditions to be true for accurate classification.
df['straight_and_flush'] = df['is_straight'] & df['is_flush']
end

python
# rank_max_min_ratio
# Feature description: The ratio of the maximum rank to the minimum rank in a hand. Calculated as rank_max_min_ratio = rank_diff_max_min / (max_rank + 1), where max_rank = 13 (King).
# Usefulness: This feature helps normalize rank_diff_max_min by scaling it relative to the maximum possible rank. It may help identify rare edge cases such as a Full House with ranks that appear very distant.
df['rank_max_min_ratio'] = df['rank_diff_max_min'] / 13
end

python
# is_straight_royal
# Feature description: Checks if a hand is both a Straight and contains all ranks needed for a Royal Flush. Computed as the logical AND of is_straight and is_royal_flush.
# Usefulness: Identifies the strongest hand types (e.g., Royal Flush) by checking both their rank sequencing (straight structure) and specific rank constraints. Helps disambiguate between weaker straights and true Royal Flush patterns.
df['is_straight_royal'] = df['is_straight'] & df['is_royal_flush']
end

python
# rank_counts_complexity_score
# Feature description: Encodes the complexity or rarity of rank arrangements using the rank_counts_encoded feature. Score computed as complexity_score = rank_counts_encoded.map({(1, 1, 1, 1, 1): 1, (1, 2, 2): 2, (1, 1, 1, 2): 3, (1, 1, 3): 4, (2, 3): 5, (1, 4): 6}).
# Usefulness: By encoding rank frequency patterns into ordered scores, this feature helps classifiers differentiate between common and rare card combinations, aiding in the prediction of higher probability hands (e.g., Four of a Kind, Full House).
rank_complexity_mapping = {(1, 1, 1, 1, 1): 1, (1, 2, 2): 2, (1, 1, 1, 2): 3, (1, 1, 3): 4, (2, 3): 5, (1, 4): 6}
df['rank_counts_complexity_score'] = df['rank_counts_encoded'].map(rank_complexity_mapping)
end

python
# full_house_validator
# Feature description: Validates is_full_house by ensuring the hand has exactly one pair and one triplet. Computed using a conditional check of rank_counts_encoded == (2, 3).
# Usefulness: This addresses potential errors or inconsistencies in the is_full_house feature and provides a feature directly based on the raw data structure. Useful for improving prediction accuracy of Full House hands.
df['full_house_validator'] = (df['rank_counts_encoded'] == (2, 3))
end

python
# drop_is_full_house
df.drop(columns=['is_full_house'], inplace=True)
end

python
# zscore_rank_diff
# Feature description: Standardized score (z-score) of the rank_diff_max_min feature based on its mean and standard deviation in the dataset.
# Usefulness: Standardizing the numerical value of rank_diff_max_min ensures that models can correctly interpret the scale when training. This is especially helpful when using distance-based models like KNN or algorithms sensitive to feature scales.
rank_diff_mean = 8.7714
rank_diff_std = 2.2107
df['zscore_rank_diff'] = (df['rank_diff_max_min'] - rank_diff_mean) / rank_diff_std
end

python
# rank_evenness
# Feature description: Checks if all five cards in the hand have even ranks. Uses a modulo operation and aggregation: (sum(rank % 2 == 0 for rank in hand) == 5).
# Usefulness: This feature complements rank-based analysis by identifying whether a hand contains only even ranks. Can help in identifying specific poker hands (e.g., hands with only even-numbered cards are unlikely to form a Royal Flush or Straight).
df['rank_is_even'] = df['rank_counts_encoded'].apply(lambda counts: (
    all(rank % 2 == 0 for rank in counts if type(rank)==int))
 end
