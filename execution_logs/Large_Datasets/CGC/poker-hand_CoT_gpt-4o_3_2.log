# is_flush
# Feature description: Checks if all suits are the same for the hand. A flush requires all cards to have the same suit.
# Usefulness: This feature directly helps identify hands like Flush (5), Straight Flush (8), and Royal Flush (9), as these hands depend on uniform card suits.
df['is_flush'] = (df['V1'] == df['V3']) & (df['V3'] == df['V5']) & (df['V5'] == df['V7']) & (df['V7'] == df['V9'])
end

python
# rank_diff_max_min
# Feature description: Computes the difference between the maximum and minimum ranks in the hand. Helps identify straight-related hands.
# Usefulness: Straight (4), Straight Flush (8), and Royal Flush (9) all require sequential ranks, meaning the maximum rank minus the minimum rank should equal 4.
df['rank_diff_max_min'] = df[[f'V{i}' for i in range(2, 11, 2)]].max(axis=1) - df[[f'V{i}' for i in range(2, 11, 2)]].min(axis=1)
end

python
# is_straight (non-suited)
# Feature description: Checks if all ranks in the hand form a sequence without gaps. Does not consider suit.
# Usefulness: Helps identify hands like Straight (4). Combined with is_flush to detect Straight Flush (8) and Royal Flush (9).
df['is_straight'] = df['rank_diff_max_min'] == 4
end

python
# rank_counts_encoded
# Feature description: Encodes the number of occurrences of each rank in the hand, bucketed into bins. For example: [2, 1, 2] would represent two pairs.
# Usefulness: Helps identify pair-related hands such as One Pair (1), Two Pairs (2), Three of a Kind (3), Full House (6), and Four of a Kind (7).
from collections import Counter
rank_cols = [f'V{i}' for i in range(2, 11, 2)]
df['rank_counts_encoded'] = df[rank_cols].apply(lambda row: tuple(sorted([v for v in Counter(row).values()])), axis=1)
end

python
# is_royal_flush
# Feature description: Checks if the hand contains the specific {Ace, King, Queen, Jack, Ten} combination and has the same suit.
# Usefulness: Directly identifies a Royal Flush (9), one of the most important hands in poker.
royal_ranks = set([1, 10, 11, 12, 13])
df['is_royal_flush'] = df.apply(lambda row: (set(row[[f'V{i}' for i in range(2, 11, 2)]]) == royal_ranks) & row['is_flush'], axis=1)
end

python
# suit_counts
# Feature description: Number of each suit present in the hand. For example, Hearts: 2, Spades: 3.
# Usefulness: Helps identify hands that require suit uniformity like Flush (5), Straight Flush (8), and Royal Flush (9).
df['suit_counts'] = df[[f'V{i}' for i in range(1, 11, 2)]].apply(lambda row: Counter(row), axis=1)
end

python
# suit_mode
# Feature description: Mode of suit (most frequent suit in hand) if the hand does not have a flush.
# Usefulness: Provides statistical insight into suit distribution for hands where suit uniformity is not required.
df['suit_mode'] = df[[f'V{i}' for i in range(1, 11, 2)]].apply(lambda row: Counter(row).most_common(1)[0][0], axis=1)
end

python
# one_hot_ranks
# Feature description: Creates one-hot encoded features for ranks across all five cards.
# Usefulness: Allows modeling of rank patterns efficiently, which aids in identifying any rank-based poker hands like pairs, straights, etc.
rank_cols = [f'V{i}' for i in range(2, 11, 2)]
df = pd.get_dummies(df, columns=rank_cols, prefix='Rank')
end

python
# is_full_house
# Feature description: Checks if the hand satisfies Full House condition (pair + three of a kind).
# Usefulness: Directly identifies Full House (6) hands, one of the recognized poker hand categories.
df['is_full_house'] = df['rank_counts_encoded'].apply(lambda x: x == (2, 3))
end

python
# drop_suit_rank_individual_columns
# Drops the raw suit and rank columns as engineered features replace their significance.
df.drop(columns=[f'V{i}' for i in range(1, 11)], inplace=True)
end
