# rank_diff_normalized
# Feature description: Normalizes the rank_diff_max_min feature using min-max scaling to compress its range between [0, 1]. This helps normalize the impact of rank differences for models sensitive to varying scales.
# Usefulness: Since rank_diff_max_min determines the range of ranks, scaling this feature makes it comparable to other features and better suited for algorithms sensitive to scale.
df['rank_diff_normalized'] = (df['rank_diff_max_min'] - df['rank_diff_max_min'].min()) / (df['rank_diff_max_min'].max() - df['rank_diff_max_min'].min())
end

python
# is_straight_and_flush
# Feature description: Combines the is_straight and is_flush features to create a flag for whether the hand satisfies both conditions (Straight + Flush).
# Usefulness: This feature directly targets the Straight Flush category and helps isolate hands likely to fall into this high-ranking group, which is crucial for accurate predictions of high-value hands.
df['is_straight_and_flush'] = df['is_straight'] & df['is_flush']
end

python
# squared_rank_diff
# Feature description: The squared value of the rank_diff_max_min feature provides a stronger emphasis on larger differences in rank.
# Usefulness: Amplifies the impact of larger rank differences, which could be useful for differentiating between hands that just barely meet or exceed straight-related conditions.
df['squared_rank_diff'] = df['rank_diff_max_min']  2
end

python
# sin_rank_diff
# Feature description: Applies the sine function to the rank_diff_max_min feature. This is a transformation that may help capture non-linear relationships in rank differences.
# Usefulness: Useful for detecting potential non-linear patterns between rank differences and their contribution to poker hand classification.
df['sin_rank_diff'] = np.sin(df['rank_diff_max_min'])
end

python
# rank_counts_one_hot
# Feature description: Applies one-hot encoding to the rank_counts_encoded feature (e.g., encoding each categorical value into a separate column with binary flags).
# Usefulness: Converts categorical data into a format suitable for input to many machine learning models, ensuring better interpretability and performance.
rank_counts_dummies = pd.get_dummies(df['rank_counts_encoded'], prefix='rank_counts')
df = pd.concat([df, rank_counts_dummies], axis=1)
end

python
# rank_diff_bin
# Feature description: Bins the rank_diff_max_min feature into discrete intervals (e.g., low, medium, high range).
# Usefulness: Captures the categorical nature of rank difference. For example, a small difference may correspond to a high probability of Straight or Royal Flush, while large differences might indicate no combination at all.
df['rank_diff_bin'] = pd.cut(df['rank_diff_max_min'], bins=[1, 5, 10, 12], labels=['low', 'medium', 'high'])
end

python
# paired_ranks_indicator
# Feature description: Indicates the number of unique paired ranks in the hand. For instance, a Two Pair will have a value of 2, One Pair will have a value of 1, etc. Derived from rank_counts_encoded.
# Usefulness: Provides a numerical summary of paired ranks, which is particularly valuable for distinguishing between One Pair, Two Pairs, or Full House.
df['paired_ranks_indicator'] = df['rank_counts_encoded'].apply(lambda x: x.count(2) + x.count(3) + x.count(4))
end

python
# potential_royal_flush_candidate
# Feature description: Checks if the hand contains any combination of cards from {Ace, King, Queen, Jack, Ten}, regardless of suit.
# Usefulness: Helps isolate hands that could potentially become a Royal Flush if they are all of the same suit.
royal_set = {10, 11, 12, 13, 14}  # Replace numerical ranks with corresponding card ranks
df['potential_royal_flush_candidate'] = df['rank_diff_max_min'].apply(lambda x: set(x).issubset(royal_set))
end

python
# drop_rank_diff_normalized
df.drop(columns=['rank_diff_normalized'], inplace=True)
end
