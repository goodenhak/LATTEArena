# Feature description: Entropy of suit counts (V1, V3, V5, V7, V9) to measure the diversity of suits within the hand based on their frequency.
# Usefulness: This feature can distinguish Flush (all cards in the same suit) from hands with diverse suits. Low entropy indicates higher similarity in suits, helping model predict Flush, Straight Flush, Royal Flush, etc.

suit_counts = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(pd.Series.value_counts, axis=1).fillna(0)
prob_suits = suit_counts.divide(suit_counts.sum(axis=1), axis=0)
df['suit_count_entropy'] = (prob_suits * np.log(prob_suits)).sum(axis=1) * -1
end

