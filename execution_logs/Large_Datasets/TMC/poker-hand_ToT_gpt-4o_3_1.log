# Feature name: Is_Same_Suit
# Feature description: A Boolean feature indicating if all 5 cards belong to the same suit. Computed using V1, V3, V5, V7, V9 (suit columns).
df['Is_Same_Suit'] = (df['V1'] == df['V3']) & (df['V1'] == df['V5']) & (df['V1'] == df['V7']) & (df['V1'] == df['V9'])

# Usefulness: This directly helps predict Flush, Straight Flush, and Royal Flush poker hands where all cards must have the same suit. For example, if Is_Same_Suit = 1, it is highly likely that the hand is one of these poker hands.
end

---

python
# Feature name: Rank_Differences_Mean
# Feature description: The mean of absolute rank differences between consecutive cards (V2 to V4, etc.). Measures how sequential the hand is.
df['Rank_Differences_Mean'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].diff(axis=1).abs().mean(axis=1)

# Usefulness: This feature helps identify Straight, Straight Flush, or Royal Flush hands, which consist of sequential ranks. Lower values indicate higher sequentiality.
end

---

python
# Feature name: Rank_Counts_Max
# Feature description: The maximum count of a single rank in the hand (e.g., max occurrences of the same rank). Computed using groupbythenmax.
max_rank_counts = df.groupby(df[['V2', 'V4', 'V6', 'V8', 'V10']].stack().reset_index(drop=True))[['V2', 'V4', 'V6', 'V8', 'V10']].transform(lambda x: x.value_counts()).max()
df['Rank_Counts_Max'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(max_rank_counts)

# Usefulness: This feature is crucial for identifying pairs, two pairs, three of a kind, four of a kind, and Full House hands where ranks repeat. Higher values suggest hands with repeated ranks.
end

