python
# Feature: Rank_Difference_Max_Min
# Feature description: Calculates the difference between the maximum rank and minimum rank in the hand.
# Usefulness: This feature captures the range of ranks. Large values might indicate the possibility of a Straight, while very small values might indicate the potential for hands like Four of a Kind or Full House. This additional information can enhance model performance in identifying specific patterns.
df['Rank_Difference_Max_Min'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].max(axis=1) - df[['V2', 'V4', 'V6', 'V8', 'V10']].min(axis=1)
end

python
# Feature: High_Card_Flag
# Feature description: Binary flag indicating if any card in the hand is an Ace (rank 1), King (rank 13), Queen (rank 12), or Jack (rank 11).
# Usefulness: High-ranking cards are generally critical for detecting high-value hands like Royal Flush or even assessing hands like One Pair or Two Pairs. Introducing this binary feature can help the model focus on these hands.
df['High_Card_Flag'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda row: any(card in [1, 11, 12, 13] for card in row), axis=1).astype(int)
end

python
# Feature: Is_Straight_Wrapped
# Feature description: Binary feature indicating whether the ranks form a wrapped straight (e.g., {Ace, 2, 3, 4, 5} or {10, Jack, Queen, King, Ace}).
# Usefulness: Wrapped straights are important in poker since Ace can act as high or low in specific hands. This feature ensures the model can identify these special patterns without confusion.
def is_wrapped_straight(ranks):
    sorted_ranks = sorted(ranks)
    # Check for {Ace, 2, 3, 4, 5}
    if sorted_ranks == [1, 2, 3, 4, 5]:
        return 1
    # Check for {10, Jack, Queen, King, Ace}
    if sorted_ranks == [1, 10, 11, 12, 13]:
        return 1
    return 0
df['Is_Straight_Wrapped'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda row: is_wrapped_straight(row), axis=1)
end

