# Creating new features using feature engineering methods

# Step 1: Age_Band_of_Driver_bin
# Feature description: Group drivers into predefined age bins (e.g., 18-25, 26-35, 36-50, 51-65, etc.).
df['Age_Band_of_Driver_bin'] = pd.cut(df['Age_of_Driver'], bins=[0, 17, 25, 35, 50, 65, 100], labels=['Under 18', '18-25', '26-35', '36-50', '51-65', '66+'])
# Usefulness: Grouping drivers into age bands could help identify relationships between driver age categories and driving behaviors. Younger or older drivers might display different tendencies, which could influence the likelihood of predicting the driver's sex.

# Step 2: Speed_Risk_Feature
# Feature description: Create a feature combining Vehicle Type and Vehicle Manoeuvre, reflecting a risk profile potentially tied to driver behavior.
df['Speed_Risk_Feature'] = df['Vehicle_Type'] * df['Vehicle_Manoeuvre']
# Usefulness: Vehicle types and maneuvers indicate driving patterns. This combination could help identify specific correlations with driver risk-taking behavior, and potentially the sex of the driver.

# Step 3: Engine_Age_Ratio
# Feature description: Ratio of Engine_Capacity_(CC) to Age_of_Vehicle.
df['Engine_Age_Ratio'] = df['Engine_Capacity_(CC)'] / (df['Age_of_Vehicle'] + 1e-6)  # Adding a small value to avoid division by zero.
# Usefulness: This feature captures whether more experienced drivers tend to drive vehicles with smaller or larger engine capacity than newer drivers. It might be an indicator that is correlated with the driver's sex.
end

