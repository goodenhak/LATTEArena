python
# unique_rank_count
# Feature description: The number of unique ranks among the five cards.
# Usefulness: A lower count of unique ranks can indicate pairs, three/four of a kind, or a full house. For example, if there are only two unique ranks, it could signal a full house or four of a kind.
df['unique_rank_count'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].nunique(axis=1)
end

