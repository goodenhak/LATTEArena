# Usefulness: A hand consisting of only one suit (unique suit count = 1) is essential for flushes, straight flushes, or royal flushes, while higher diversity can rule out those hands.
df['unique_suit_count'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].nunique(axis=1)
end

