# Feature name: is_flush
# Feature description: A binary feature (0 or 1) indicating whether all five cards have the same suit.
df['is_flush'] = (df['V1'] == df['V3']) & (df['V3'] == df['V5']) & (df['V5'] == df['V7']) & (df['V7'] == df['V9']).astype(int)
# Usefulness: In poker, the flush hands (Target = 5, 8, or 9) are entirely dependent on all five cards having the same suit. This feature reduces complexity and enhances predictions by directly highlighting potential flush conditions.
end

---

#### Step 2: Create a is_straight feature
python
# Feature name: is_straight
# Feature description: A binary feature (0 or 1) indicating whether the ranks of the cards are sequential.
card_ranks = df[['V2', 'V4', 'V6', 'V8', 'V10']].values
card_ranks_sorted = np.sort(card_ranks, axis=1)
rank_diff = np.diff(card_ranks_sorted, axis=1)
df['is_straight'] = (rank_diff == 1).all(axis=1).astype(int)
# Usefulness: In poker, straights (Target = 4 or 8) require a sequence in card ranks. This feature directly identifies sequences, simplifying prediction of these hands.
end

---

#### Step 3: Create rank_count features using a group-by operation
python
# Feature name: rank_count_{k}
# Feature description: New columns for rank counts, where {k}=number of cards sharing the same rank (e.g., pair, three of a kind, etc.).
df['rank_count'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda ranks: pd.Series(ranks).value_counts(), axis=1)
df['rank_count_2'] = df['rank_count'].apply(lambda x: x.iloc[0:].eq(2).sum()) # Count pairs
df['rank_count_3'] = df['rank_count'].apply(lambda x: x.iloc[0:].eq(3).sum()) # Count three of a kind
df['rank_count_4'] = df['rank_count'].apply(lambda x: x.iloc[0:].eq(4).sum()) # Count four of a kind
del df['rank_dict']  
 

