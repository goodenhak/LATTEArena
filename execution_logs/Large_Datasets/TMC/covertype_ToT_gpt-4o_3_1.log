### Step 1: Directional Hydrology Gradient
python
# Directional_Hydrology_Gradient
# Feature description: Represents the directional gradient towards the hydrology.
# Calculated as the arctangent of (Vertical_Distance_To_Hydrology / Horizontal_Distance_To_Hydrology).
# Usefulness: This feature captures the physical slope of the land relative to nearby hydrology and may help differentiate terrain types (e.g., steep slopes near streams vs. flat terrain).
import numpy as np
df['Directional_Hydrology_Gradient'] = np.arctan(df['Vertical_Distance_To_Hydrology'] / (df['Horizontal_Distance_To_Hydrology'] + 1e-6))
end

### Step 2: Combined Soil Type Indicator
python
# Combined_Soil_Type
# Feature description: Aggregates all soil type indicators into a single integer-encoded feature.
# Useful for models that work better with compact representations or for facilitating feature interactions.
# Usefulness: The soil types provide very sparse individual indicators, which may reduce interpretability or model utility. A single aggregated column allows the model to use soil types more effectively.
soil_type_cols = [col for col in df.columns if col.startswith('Soil_Type')]
df['Combined_Soil_Type'] = df[soil_type_cols].idxmax(axis=1).str.replace('Soil_Type', '').astype(int)
end

### Step 3: Terrain Accessibility Index
python
# Terrain_Accessibility_Index
# Feature description: Combines the distances to hydrology, roadways, and fire points using a harmonic mean.
# Harmonic mean is computed because it prioritizes smaller distances, which might indicate accessibility hotspots.
# Usefulness: Intuitively measures how accessible a cell is based on proximity to key landmarks, potentially identifying areas more traversable or prone to human/nature interaction.
from scipy.stats import hmean
df['Terrain_Accessibility_Index'] = 3 / (1/(df['Horizontal_Distance_To_Hydrology'] + 1e-6) 
                                         + 1/(df['Horizontal_Distance_To_Roadways'] + 1e-6) 
                                         + 1/(df['Horizontal_Distance_To_Fire_Points'] + 1e-6))
end

