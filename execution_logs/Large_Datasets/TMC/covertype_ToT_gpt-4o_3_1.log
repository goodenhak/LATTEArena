# Step 1: Elevation_to_Slope_Ratio
# Feature description: Ratio of Elevation to Slope. Represents how changes in elevation correlate with terrain inclination.
# Usefulness: This feature could help capture the steepness of the terrain in relation to elevation, which may influence forest cover distribution.
df['Elevation_to_Slope_Ratio'] = df['Elevation'] / (df['Slope'] + 1)  # Adding 1 to avoid division by zero
end

python
# Step 2: Distance_Composite
# Feature description: A combined measure of proximity to hydrology, roadways, and wildfire points using their geometric mean.
# Usefulness: This feature condenses multiple distance metrics into one aggregate feature, potentially capturing the net geographical isolation of a cell.
from scipy.stats import gmean
df['Distance_Composite'] = gmean(
    df[['Horizontal_Distance_To_Hydrology', 
        'Horizontal_Distance_To_Roadways', 
        'Horizontal_Distance_To_Fire_Points']].values + 1, 
    axis=1
)
end

python
# Step 3: Hillshade_Diff_Moment
# Feature description: Difference between max and min hillshade values to capture the variability of lighting conditions throughout the day.
# Usefulness: Quantifying hillshade variability may highlight micro-environments with unique sun/shade patterns influencing vegetation types.
df['Hillshade_Diff_Moment'] = df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].max(axis=1) - df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].min(axis=1)
end

python
# Drop low-information columns: Soil_Type5, Soil_Type14, Soil_Type15, Soil_Type37
# Explanation: These columns contain either zero values or negligible variance across all rows, contributing very little information to the model.
df.drop(columns=['Soil_Type5', 'Soil_Type14', 'Soil_Type15', 'Soil_Type37'], inplace=True)
end
