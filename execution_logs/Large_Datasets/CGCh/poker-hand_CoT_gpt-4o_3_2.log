# Feature name: card_rank_match_count_squared
# Feature description: The square of the card_rank_match_count feature.
# Usefulness: Enhances the importance of rank matches for hands involving multiple identical ranks. Expanding this feature
# with a quadratic form better captures hands with strong rank matches, such as Full House (Target=6) and Four of a Kind (Target=7).
df['card_rank_match_count_squared'] = df['card_rank_match_count']  2
end

python
# Feature name: rank_difference_std_log
# Feature description: The logarithm of the rank_difference_std feature.
# Usefulness: Compresses the scale of rank difference variation, lending sensitivity to smaller rank_std values while reducing the effect 
# of larger differences. This helps in refining classification for hands where sequential rank patterns are important, like Straight (Target=4), 
# Straight Flush (Target=8), and Royal Flush (Target=9).
df['rank_difference_std_log'] = np.log1p(df['rank_difference_std'])
end

python
# Feature name: straight_high_card_indicator
# Feature description: Boolean flag indicating whether the lowest card in a straight hand is at least 10.
# Usefulness: Differentiates high-value Straight hands (e.g., {10, Jack, Queen, King, Ace}) from other lower-ranked Straights. 
# This is particularly useful for identifying Royal Flush (Target=9) candidates from weaker combinations.
df['straight_high_card_indicator'] = df.apply(
    lambda row: row['is_straight'] and min([row['V2'], row['V4'], row['V6'], row['V8'], row['V10']]) >= 10,
    axis=1
)
end

python
# Feature name: normalized_suit_rank_ratio
# Feature description: The ratio of card_suit_match_count to rank_sum_normalized.
# Usefulness: Balances suit similarity and average rank strength in a hand, helping to differentiate between Flushes 
# (suit-dominant) and hands with strong rank matches (like Full House, Target=6, or Four of a Kind, Target=7).
df['normalized_suit_rank_ratio'] = df['card_suit_match_count'] / (df['rank_sum_normalized'] + 1e-6)
end

python
# Feature name: royal_flush_candidate_and_flush
# Feature description: A Boolean feature indicating whether the hand is both a Royal Flush candidate and a Flush.
# Usefulness: Simplifies identifying the strongest hand (Royal Flush, Target=9) by precomputing the confluence of being a 
# Royal Flush candidate and having matching suits, reducing noise and enhancing classification accuracy.
df['royal_flush_candidate_and_flush'] = df.apply(
    lambda row: row['royal_flush_candidate'] and row['is_flush'],
    axis=1
)
end

python
# Feature name: rank_sum_squared
# Feature description: The square of the rank_sum feature.
# Usefulness: Amplifies the differences between hands with lower total rank sums and higher total rank sums, making combinations 
# like Royal Flush (Target=9) and Straight Flush (Target=8) more distinguishable in the feature space.
df['rank_sum_squared'] = df['rank_sum']  2
end

python
# Feature name: suit_and_rank_flatness
# Feature description: The normalized card_suit_match_count divided by the normalized card_rank_match_count feature.
# Usefulness: Indicates the relative preference for suit similarity over rank similarity. It is helpful in distinguishing 
# hands like Flush (Target=5) from combinations dominated by rank similarity like Full House (Target=6) or Four of a Kind (Target=7).
df['suit_and_rank_flatness'] = df['normalized_card_suit_match_count'] / (
    df['card_rank_match_count'] / 5 + 1e-6
)
end

python
# Feature name: sqrt_rank_difference_std
# Feature description: The square root of the rank_difference_std feature.
# Usefulness: Reduces the influence of extreme differences in rank variations while highlighting intermediate changes. 
# This is useful for detecting sequential rank patterns like Straight (Target=4), Straight Flush (Target=8), and Royal Flush (Target=9).
df['sqrt_rank_difference_std'] = np.sqrt(df['rank_difference_std'])
end

python
# Feature name: high_card_ratio
# Feature description: The proportion of cards with rank >= 10 in a hand.
# Usefulness: Highlights the presence of high-value cards (Ten, Jack, Queen, King, Ace) that are crucial for identifying 
# strong hands like Royal Flush (Target=9) and other high-value Flush (Target=5) combinations.
df['high_card_ratio'] = df.apply(
    lambda row: sum(rank >= 10 for rank in [row['V2'], row['V4'], row['V6'], row['V8'], row['V10']]) / 5,
    axis=1
)
end

python
# Feature name: combined_feature_ratio
# Feature description: The product of card_suit_match_count and card_rank_match_count divided by rank_sum.
# Usefulness: Combines suit similarity, rank similarity, and overall rank strength into one balanced feature. This composite 
# feature helps distinguish hands that rely on overlapping characteristics, such as Flush (Target=5), Full House (Target=6), 
# and Straight Flush (Target=8).
df['combined_feature_ratio'] = (
    df['card_suit_match_count'] * df['card_rank_match_count']
) / (df['rank_sum'] + 1e-6)
end
