# Feature name: normalized_card_suit_match_count
# Feature description: The card_suit_match_count feature divided by the maximum possible value in its range (4). This normalized version puts the feature into a [0, 1] range.
# Usefulness: Helps the model compare the suit similarity scale across different hands in a standardized way, making it easier for the model to interpret this feature regardless of its raw magnitude. Useful for identifying Flush (Target=5), Straight Flush (Target=8), and Royal Flush (Target=9).
df['normalized_card_suit_match_count'] = df['card_suit_match_count'] / 4
end

python
# Feature name: sqrt_rank_difference_std
# Feature description: The square root of the rank_difference_std feature.
# Usefulness: Reduces the sensitivity of extreme values in rank difference variation. May help to better characterize intermediate differences for hands like Straight (Target=4), Straight Flush (Target=8), and Royal Flush (Target=9).
df['sqrt_rank_difference_std'] = np.sqrt(df['rank_difference_std'])
end

python
# Feature name: rank_difference_std_log
# Feature description: The logarithm of the rank_difference_std feature.
# Usefulness: Compresses the scale of rank difference variation in hands, lending sensitivity to smaller rank_std values while diminishing the effect of larger ones. Helps to better refine classification for hands with sequential ranks like Straight (Target=4), Straight Flush (Target=8), and Royal Flush (Target=9).
df['rank_difference_std_log'] = np.log1p(df['rank_difference_std'])
end

python
# Feature name: high_card_ratio
# Feature description: The proportion of cards with rank >= 10 in a hand.
# Usefulness: Highlights how many high cards (Ten, Jack, Queen, King, Ace) are present, which can be critical for distinguishing Royal Flush (Target=9) and high-ranking Flush hands (Target=5).
df['high_card_ratio'] = df.apply(
    lambda row: sum(rank >= 10 for rank in [row['V2'], row['V4'], row['V6'], row['V8'], row['V10']]) / 5,
    axis=1
)
end

python
# Feature name: rank_sum_squared
# Feature description: The square of the rank_sum feature.
# Usefulness: Amplifies the differences between hands with lower and higher total rank sums, making high-rank hands like Royal Flush (Target=9) more distinguishable in the feature space.
df['rank_sum_squared'] = df['rank_sum']  2
end

python
# Feature name: combined_feature_ratio
# Feature description: The product of card_suit_match_count and card_rank_match_count divided by rank_sum.
# Usefulness: Combines suit similarity, rank similarity, and overall rank strength into a single feature. Helps differentiate between hands that rely on overlapping characteristics of suits and ranks, such as Flush (Target=5), Full House (Target=6), and Straight Flush (Target=8).
df['combined_feature_ratio'] = (df['card_suit_match_count'] * df['card_rank_match_count']) / (df['rank_sum'] + 1e-6)  # Avoid division by zero
end

python
# Feature name: straight_high_card_indicator
# Feature description: Boolean flag indicating whether the lowest card in a Straight hand is at least 10.
# Usefulness: Distinguishes high-value Straight hands (e.g., Target=4 with {10, Jack, Queen, King, Ace}) from other lower-ranked Straights. Useful for identifying high-ranking patterns.
df['straight_high_card_indicator'] = df.apply(
    lambda row: row['is_straight'] and min([row['V2'], row['V4'], row['V6'], row['V8'], row['V10']]) >= 10,
    axis=1
)
end

python
# Feature name: modulated_card_matches
# Feature description: The card_suit_match_count multiplied by card_rank_match_count, then modulated by 10.
# Usefulness: A composite feature that captures interactions between rank matches and suit matches, introducing a structured non-linearity that may aid in distinguishing complex hands like Flush (Target=5) versus Four of a Kind (Target=7).
df['modulated_card_matches'] = (df['card_suit_match_count'] * df['card_rank_match_count']) % 10
end

python
# Feature name: suit_and_rank_flatness
# Feature description: The normalized card_suit_match_count feature divided by the normalized card_rank_match_count feature.
# Usefulness: Provides insight into the relative balance between suit similarity and rank similarity, helping to classify hands like Flush (Target=5) versus rank-based hands like Full House (Target=6) or Four of a Kind (Target=7).
df['suit_and_rank_flatness'] = df['normalized_card_suit_match_count'] / (df['card_rank_match_count'] / 5 + 1e-6)  # Normalize card_rank_match_count by max(5) to match scaling
end
