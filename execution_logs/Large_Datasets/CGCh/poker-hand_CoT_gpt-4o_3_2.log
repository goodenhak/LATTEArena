python
# Feature name: card_suit_match_count
# Feature description: The number of suits that are the same across the five cards.
# Usefulness: Helps identify hands like Flush (five cards with the same suit) and contributes to detecting Straight Flush and Royal Flush. Additionally, it may help differentiate other combinations like nothing (Target=0).
df['card_suit_match_count'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(lambda x: len(set(x)), axis=1)
end

python
# Feature name: card_rank_match_count
# Feature description: The number of ranks that are the same across the five cards.
# Usefulness: Directly contributes to better predictive power for combinations requiring rank matches (Target=1, 2, 3, 6, 7).
df['card_rank_match_count'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: len(set(x)), axis=1)
end

python
# Feature name: rank_difference_std
# Feature description: The standard deviation of consecutive rank differences across the five cards.
# Usefulness: Essential for detecting Target=4 (Straight), Target=8 (Straight Flush), and Target=9 (Royal Flush).
df['rank_difference_std'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: np.std(np.diff(sorted(x))), axis=1)
end

python
# Feature name: is_flush
# Feature description: Boolean feature indicating whether all suits are the same across the five cards.
# Usefulness: Directly identifies Flush (Target=5) and contributes to detecting Straight Flush (Target=8) and Royal Flush (Target=9).
df['is_flush'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(lambda x: len(set(x)) == 1, axis=1)
end

python
# Feature name: is_straight
# Feature description: Boolean feature indicating whether ranks are sequential across the five cards. Allows wrap-around handling for Ace (1) being higher than King (13).
# Usefulness: Directly identifies Target=4 (Straight) and contributes to detecting Straight Flush and Royal Flush patterns.
df['is_straight'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda x: sorted(x) == list(range(min(x), min(x) + 5)) or sorted(x) == [1, 10, 11, 12, 13],
    axis=1
)
end

python
# Feature name: rank_sum
# Feature description: The sum of all ranks across the five cards.
# Usefulness: Helps detect Royal Flush (Target=9) since {Ace, King, Queen, Jack, Ten} has a fixed sum (54) when ranks are sequential. May work as a secondary confirmation for certain combinations.
df['rank_sum'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].sum(axis=1)
end

python
# Feature name: royal_flush_candidate
# Feature description: Boolean flag indicating whether the hand is a potential Royal Flush ({Ace, King, Queen, Jack, Ten}) based on ranks alone, ignoring suits.
# Usefulness: Narrows down potential Royal Flush candidates (Target=9), reducing noise for classification.
df['royal_flush_candidate'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda x: set(x) == {1, 10, 11, 12, 13}, 
    axis=1
)
end

python
# Feature name: is_high_card_flush
# Feature description: Boolean flag indicating whether the combination is a Flush (is_flush=True) with all ranks higher than or equal to 10.
# Usefulness: Filters for strong Flush combinations where all cards have high ranks, helping to better distinguish Royal Flush (Target=9) and strong Flushes (Target=5) from weaker ones.
df['is_high_card_flush'] = df.apply(lambda row: row['is_flush'] and row['rank_sum'] >= 54, axis=1)
end

python
# Feature name: rank_difference_std_inverse
# Feature description: The reciprocal of the rank_difference_std feature.
# Usefulness: Highlighting the inverse of the rank difference's standard deviation focuses on hands where rank_std differences are very small, such as Straights (Target=4), Straight Flushes (Target=8), or Royal Flushes (Target=9).
df['rank_difference_std_inverse'] = 1 / (df['rank_difference_std'] + 1e-6)  # Adding epsilon to avoid division by zero
end

python
# Feature name: straight_flush_indicator
# Feature description: Boolean flag indicating whether the hand is both a Straight (is_straight=True) and a Flush (is_flush=True).
# Usefulness: Directly detects Straight Flush (Target=8) hands, simplifying classification of one of the strongest poker hands.
df['straight_flush_indicator'] = df['is_straight'] & df['is_flush']
end

python
# Feature name: royal_flush_vs_straight_flush
# Feature description: Numeric flag indicating if the hand is a Royal Flush candidate (royal_flush_candidate=True) that also satisfies Straight Flush conditions.
# Usefulness: Helps pinpoint Royal Flush (Target=9) from other Straight Flushes (Target=8) by combining these two key indicators.
df['royal_flush_vs_straight_flush'] = df.apply(lambda row: row['royal_flush_candidate'] and row['straight_flush_indicator'], axis=1)
end

python
# Feature name: rank_sum_normalized
# Feature description: The rank sum divided by the number of cards in the hand (fixed at 5).
