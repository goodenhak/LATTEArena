end

python
# Feature name: card_suit_match_to_std_ratio
# Feature description: The ratio of card_suit_match_count to rank_difference_std.
# Usefulness: Combines information about suit similarity and rank difference variability into a single feature, which can help differentiate combinations involving both suit and rank patterns like Flush or Straight-related hands.
df['card_suit_match_to_std_ratio'] = df['card_suit_match_count'] / (df['rank_difference_std'] + 1e-6)
end

python
# Feature name: exp_card_rank_match_count
# Feature description: The exponential of the card_rank_match_count feature.
# Usefulness: Emphasizes the importance of rank matches exponentially. This could improve the separability for hands with extreme matches, such as Full House and Four of a Kind.
df['exp_card_rank_match_count'] = np.exp(df['card_rank_match_count'])
end

python
# Feature name: royal_flush_candidate_and_flush
# Feature description: Boolean feature indicating whether a hand is both a Royal Flush candidate and a Flush.
# Usefulness: A direct indicator for detecting the highest-ranking hand, Royal Flush (Target=9). Reduces complexity for the model by precomputing this condition.
df['royal_flush_candidate_and_flush'] = df.apply(lambda row: row['royal_flush_candidate'] and row['is_flush'], axis=1)
end

python
# Feature name: tanh_rank_difference_std
# Feature description: The hyperbolic tangent of the rank_difference_std feature.
# Usefulness: Rescales the rank_difference_std to a smaller range, potentially highlighting significant contrasts without being overly sensitive to extreme values. Useful for recognizing patterns like Straights, Straight Flushes, or Royal Flushes.
df['tanh_rank_difference_std'] = np.tanh(df['rank_difference_std'])
end

python
# Feature name: combined_suit_rank_ratio
# Feature description: Computes the ratio of suit-matched cards multiplied by the rank sum, over card_rank_match_count.
# Usefulness: This composite feature embeds information about both suit similarity and rank strength. It can differentiate hands like Flushes (suit-heavy) from Four of a Kind or Full Houses (rank-heavy).
df['combined_suit_rank_ratio'] = (df['card_suit_match_count'] * df['rank_sum']) / (df['card_rank_match_count'] + 1e-6)
end

python
# Feature name: high_card_presence_flag
# Feature description: Boolean flag indicating whether the hand contains at least one card of rank 10 or higher.
# Usefulness: Detects the presence of high cards such as Ten, Jack, Queen, King, and Ace. These cards are crucial for identifying Royal Flushes (Target=9) and high-value hands.
df['high_card_presence_flag'] = df.apply(lambda row: any(rank >= 10 for rank in [row['V2'], row['V4'], row['V6'], row['V8'], row['V10']]), axis=1)
end

python
# Feature name: rank_std_dev_norm_ratio
# Feature description: Ratio of rank_difference_std to the normalized rank sum (rank_sum_normalized).
# Usefulness: Highlights the contrast between the rank distribution variability and the normalized average rank for potential high-value hands like Straights or Straight Flushes.
df['rank_std_dev_norm_ratio'] = df['rank_difference_std'] / (df['rank_sum_normalized'] + 1e-6)
end

python
# Feature name: sigmoid_rank_sum
# Feature description: The sigmoid transformation of the rank sum feature.
# Usefulness: Introduces a bounded transformation that scales rank_sum into a [0, 1] range, useful for models that might be sensitive to raw magnitude differences in rank sums. 
df['sigmoid_rank_sum'] = 1 / (1 + np.exp(-df['rank_sum']))
end

python
# Feature name: flush_rank_spread
# Feature description: Difference between the highest and lowest ranks in a hand, calculated only if the hand is a Flush (is_flush=True).
# Usefulness: Helps further distinguish between simple Flush (Target=5) hands and Straight Flush (Target=8) or Royal Flush (Target=9), as the latter will have more specific rank distributions.
df['flush_rank_spread'] = df.apply(lambda row: max([row['V2'], row['V4'], row['V6'], row['V8'], row['V10']]) - min([row['V2'], row['V4'], row['V6'], row['V8'], row['V10']]) if row['is_flush'] else 0, axis=1)
end
