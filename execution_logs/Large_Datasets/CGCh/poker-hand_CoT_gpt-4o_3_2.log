# Feature name: royal_flush_candidate_and_flush
# Feature description: A Boolean feature indicating whether the hand is both a Royal Flush candidate and a Flush.
# Usefulness: This feature serves as a direct indicator for detecting the highest-ranking hand, Royal Flush (Target=9). 
# By combining the conditions of being a Royal Flush candidate and having all suits match, 
# it simplifies the model's task of identifying this specific hand, ensuring improved precision in classification.

df['royal_flush_candidate_and_flush'] = df.apply(
    lambda row: row['royal_flush_candidate'] and row['is_flush'], 
    axis=1
)
end

python
# Feature name: normalized_card_suit_match_count
# Feature description: The card_suit_match_count feature divided by the maximum possible value in its range (4). 
# This normalized version standardizes card_suit_match_count to a [0, 1] range.
# Usefulness: Normalization allows the model to compare the suit similarity scale across different hands in a standardized manner, 
# making it easier to interpret this feature globally. This aids in identifying Flush (Target=5), Straight Flush (Target=8), 
# and Royal Flush (Target=9), as higher normalized values suggest higher concentrations of matching suits.

df['normalized_card_suit_match_count'] = df['card_suit_match_count'] / 4
end

python
# Feature name: sqrt_rank_difference_std
# Feature description: The square root of the rank_difference_std feature.
# Usefulness: By applying the square root, the sensitivity to extreme values in rank difference variation is reduced, 
# allowing the model to focus on intermediate differences. This may help better distinguish complex ranks in hands like 
# Straights (Target=4), Straight Flushes (Target=8), and Royal Flushes (Target=9).

df['sqrt_rank_difference_std'] = np.sqrt(df['rank_difference_std'])
end

python
# Feature name: high_card_ratio
# Feature description: The proportion of cards with rank >= 10 in a hand.
# Usefulness: This feature focuses on how many high-value cards (Ten, Jack, Queen, King, Ace) are present in a hand. 
# It is particularly important for distinguishing high-value Flush hands (Target=5) and Royal Flush (Target=9), 
# and helps identify general hand strength when used in conjunction with other features.

df['high_card_ratio'] = df.apply(
    lambda row: sum(rank >= 10 for rank in [row['V2'], row['V4'], row['V6'], row['V8'], row['V10']]) / 5,
    axis=1
)
end

python
# Feature name: rank_difference_std_log
# Feature description: The logarithm of the rank_difference_std feature.
# Usefulness: Taking the logarithm of rank_difference_std compresses the scale, enhancing sensitivity 
# to smaller rank_std values while reducing the impact of large differences. This transformation 
# facilitates better classification of ranks in sequential hands like Straights (Target=4), 
# Straight Flushes (Target=8), and Royal Flushes (Target=9).

df['rank_difference_std_log'] = np.log1p(df['rank_difference_std'])
end

python
# Feature name: suit_and_rank_flatness
# Feature description: The normalized card_suit_match_count feature divided by the normalized card_rank_match_count feature.
# Usefulness: This ratio provides insight into the balance between suit similarity and rank similarity by standardizing their scales. 
# It is especially helpful in classifying hands like Flush (Target=5), which are more suit-dependent, versus 
# rank-dominant hands like Full House (Target=6) and Four of a Kind (Target=7).

df['suit_and_rank_flatness'] = df['normalized_card_suit_match_count'] / (
    (df['card_rank_match_count'] / 5) + 1e-6  # Normalizing card_rank_match_count by its maximum
)
end

python
# Feature name: combined_feature_ratio
# Feature description: The product of card_suit_match_count and card_rank_match_count divided by rank_sum.
# Usefulness: This composite feature integrates suit similarity, rank similarity, and overall rank strength into one feature.
# It helps differentiate cards reliant on overlapping characteristics, such as Flush (Target=5), Full House (Target=6), 
# and Straight Flush (Target=8). This interaction adds deeper feature complexity without adding many columns.

df['combined_feature_ratio'] = (
    (df['card_suit_match_count'] * df['card_rank_match_count']) /
    (df['rank_sum'] + 1e-6)  # Avoid division by zero
)
end
