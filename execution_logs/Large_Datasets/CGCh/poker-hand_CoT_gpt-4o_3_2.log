# is_flush
# Feature description: Boolean feature indicating whether all suits are the same across the five cards.
# Usefulness: Directly identifies Flush (Target=5) and contributes to detecting Straight Flush (Target=8) and Royal Flush (Target=9).

df['is_flush'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(lambda x: len(set(x)) == 1, axis=1)
end

python
# is_straight
# Feature description: Boolean feature indicating whether ranks are sequential across the five cards. Allows wrap-around handling for Ace (1) being higher than King (13).
# Usefulness: Directly identifies Target=4 (Straight) and contributes to detecting Straight Flush and Royal Flush patterns.

df['is_straight'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda x: sorted(x) == list(range(min(x), min(x) + 5)) or sorted(x) == [1, 10, 11, 12, 13],
    axis=1
)
end

python
# rank_sum
# Feature description: The sum of all ranks across the five cards.
# Usefulness: Helps detect Royal Flush (Target=9) since {Ace, King, Queen, Jack, Ten} has a fixed sum (54) when ranks are sequential. May work as a secondary confirmation for certain combinations.

df['rank_sum'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].sum(axis=1)
end

python
# royal_flush_candidate
# Feature description: Boolean flag indicating whether the hand is a potential Royal Flush ({Ace, King, Queen, Jack, Ten}) based on ranks alone, ignoring suits.
# Usefulness: Narrows down potential Royal Flush candidates (Target=9), reducing noise for classification.

df['royal_flush_candidate'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda x: set(x) == {1, 10, 11, 12, 13}, 
    axis=1
)
end

