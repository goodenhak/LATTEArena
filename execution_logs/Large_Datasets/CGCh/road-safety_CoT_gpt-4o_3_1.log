# Vehicle_Type_Engine_Normalized_Ratio
# Feature description: Calculates the ratio of Vehicle_Type to Engine_Capacity_Normalized to represent the relationship between vehicle type and engine size.
# Usefulness: This ratio helps to understand how the type of vehicle operated by a driver scales with normalized engine capacity, potentially revealing trends in vehicle preferences by sex.
df['Vehicle_Type_Engine_Normalized_Ratio'] = df['Vehicle_Type'] / (df['Engine_Capacity_Normalized'] + 1e-5)  # Avoid division by zero
end

python
# Driver_Casualty_Age_Band_Difference
# Feature description: Difference between Age_Band_of_Driver and Age_Band_of_Casualty.
# Usefulness: Capturing the difference between age bands can highlight broader generational patterns in accidents, offering insight correlated to driver sex.
df['Driver_Casualty_Age_Band_Difference'] = df['Age_Band_of_Driver'] - df['Age_Band_of_Casualty']
end

python
# Driver_Economic_Area_Impact
# Feature description: Ratio of Casualty_IMD_Decile to Local_Authority_(District) to represent the economic and district-level impact profile per accident.
# Usefulness: Encodes socioeconomic dynamics and regional differences which might indirectly correlate with driver demographics based on accident locations or types.
df['Driver_Economic_Area_Impact'] = df['Casualty_IMD_Decile'] / (df['Local_Authority_(District)'] + 1e-5)  # Protect against division by zero
end

python
# Vehicle_Manoeuvre_Categorized_Location_Interaction
# Feature description: Combines Vehicle_Manoeuvre_Categorized and Vehicle_Location-Restricted_Lane using label encoding to capture dynamics of maneuver behavior and location restrictions in accidents.
# Usefulness: Using an interaction term between maneuver categorization and location restriction could reveal behavioral differences in driving patterns, potentially correlated with driver sex.
df['Vehicle_Manoeuvre_Categorized_Location_Interaction'] = df['Vehicle_Manoeuvre_Categorized'].astype('category').cat.codes * df['Vehicle_Location-Restricted_Lane']
end

python
# Area_Casualty_Single_Flag
# Feature description: Interaction feature between Area_1, Area_2, and Is_Single_Casualty to encode a combined flag representing location and casualty count dynamics.
# Usefulness: This interaction feature highlights urban/rural accident dynamics and distinguishes between single casualty accidents, potentially correlated with driver behavior.
df['Area_Casualty_Single_Flag'] = df['Area_1'] * df['Is_Single_Casualty']
end

python
# One_Vehicle_Accident_Flag
# Feature description: Binary flag to indicate if the Number_of_Vehicles in the accident is 1.
# Usefulness: Simplifies accident data by identifying single-vehicle accidents which may correlate with driver sex through distinct behaviors in single-vehicle scenarios.
df['One_Vehicle_Accident_Flag'] = (df['Number_of_Vehicles'] == 1).astype(int)
end

python
# Driver_Vehicle_Type_Average_District
# Feature description: Grouped average of Vehicle_Type within each Local_Authority_(District).
# Usefulness: Encodes regional trends in vehicle types, which could indirectly correlate with driver demographics and behaviors.
df['Driver_Vehicle_Type_Average_District'] = df.groupby('Local_Authority_(District)')['Vehicle_Type'].transform('mean')
end

