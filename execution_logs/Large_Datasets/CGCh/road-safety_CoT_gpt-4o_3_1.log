# Is_Adult_Driver
# Feature description: A binary feature indicating if the driver is considered an adult (defined as Age_of_Driver >= 18).
# Usefulness: Adds real-world knowledge as adult drivers represent the majority of drivers and may have different behavior compared to younger drivers.
df['Is_Adult_Driver'] = (df['Age_of_Driver'] >= 18).astype(int)
end

python
# Driver_Age_Category
# Feature description: Categorizes the driver's age into bins (e.g., Young, Middle-Aged, Senior) based on Age_of_Driver.
# Usefulness: Encodes age in meaningful ranges to identify patterns in driver behavior based on age group.
df['Driver_Age_Category'] = pd.cut(df['Age_of_Driver'], bins=[0, 18, 35, 60, 100], labels=['Young', 'Middle-Aged', 'Senior', 'Elderly'])
end

python
# Engine_Capacity_Normalized
# Feature description: Normalizes Engine_Capacity_(CC) using min-max normalization.
# Usefulness: Makes the feature scale-independent, enabling better algorithm performance when comparing engine sizes.
df['Engine_Capacity_Normalized'] = (df['Engine_Capacity_(CC)'] - df['Engine_Capacity_(CC)'].min()) / (
    df['Engine_Capacity_(CC)'].max() - df['Engine_Capacity_(CC)'].min())
end

python
# Vehicle_Manoeuvre_Categorized
# Feature description: Converts Vehicle_Manoeuvre into bins representing driver behavior during accidents (e.g., stationary, moving, executing a turn).
# Usefulness: Categorizing behavior simplifies analysis and may reveal patterns linking maneuver type to driver sex.
df['Vehicle_Manoeuvre_Categorized'] = pd.cut(df['Vehicle_Manoeuvre'], bins=[0, 5, 10, 15, 18], labels=['Stationary', 'Moving', 'Turning', 'Other'])
end

python
# Urban_Rural_One_Hot
# Feature description: One-hot encodes Urban_or_Rural_Area to create separate columns for urban and rural locations.
# Usefulness: Enables better modeling of location types and their impact on driver behavior or accident circumstances.
df = pd.get_dummies(df, columns=['Urban_or_Rural_Area'], prefix='Area')
end

python
# Is_Single_Casualty
# Feature description: Binary feature indicating if there was only one casualty in the accident (Number_of_Casualties == 1).
# Usefulness: Simplifies analysis by distinguishing cases with potentially fewer accident dynamics, which may correlate with driver sex.
df['Is_Single_Casualty'] = (df['Number_of_Casualties'] == 1).astype(int)
end

python
# Driver_Age_Sex_Interaction
# Feature description: Interaction term combining Age_of_Driver and Sex_of_Casualty (using multiplication).
# Usefulness: Captures potential correlations between driver age and sex of individuals involved in accidents.
df['Driver_Age_Sex_Interaction'] = df['Age_of_Driver'] * df['Sex_of_Casualty']
end

python
# Casualty_Age_Mean_Difference
# Feature description: Difference between Age_of_Driver and Age_of_Casualty.
# Usefulness: Highlights intergenerational dynamics in accidents that may correlate with driver sex.
df['Casualty_Age_Mean_Difference'] = df['Age_of_Driver'] - df['Age_of_Casualty']
end

python
# Vehicle_Engine_Power_Ratio
# Feature description: Ratio of Engine_Capacity_(CC) to Age_of_Vehicle.
# Usefulness: Provides an indicator of the relationship between the vehicle's power and age, which may indirectly link to driver demographics.
df['Vehicle_Engine_Power_Ratio'] = df['Engine_Capacity_(CC)'] / (df['Age_of_Vehicle'] + 1e-5)  # Add small epsilon to avoid division by zero.
end

python
# Casualty_Severity_by_District
# Feature description: Target encoding of Casualty_IMD_Decile using Local_Authority_(District) as the group key.
# Usefulness: Encodes socioeconomic status and accident rates within districts, which could influence driver types and behaviors.
df['Casualty_Severity_by_District'] = df.groupby('Local_Authority_(District)')['Casualty_IMD_Decile'].transform('mean')
end

