2026-05-12 18:49:32,707 - INFO - ops_string = ["# Vehicle_Type_Age_Ratio\n# Feature description: Calculates the ratio of Vehicle_Type to Age_of_Vehicle to capture the relationship between vehicle type and vehicle age.\n# Usefulness: Represents how the type of vehicle scales with its age, providing insights into vehicle preferences that may differ by driver sex.\ndf['Vehicle_Type_Age_Ratio'] = df['Vehicle_Type'] / (df['Age_of_Vehicle'] + 1e-5)  # Add small epsilon to avoid division by zero.\n\n# Driver_Casualty_Age_Interaction_Normalized\n# Feature description: Normalizes the interaction term combining Age_of_Driver and Age_of_Casualty by dividing by the sum of their standard deviations.\n# Usefulness: Provides a scale-independent representation of the interaction between driver and casualty ages, helping identify patterns linked to demographics.\ndf['Driver_Casualty_Age_Interaction_Normalized'] = (df['Age_of_Driver'] * df['Age_of_Casualty']) / (df['Age_of_Driver'].std() + df['Age_of_Casualty'].std() + 1e-5)\n\n# Is_Elderly_Driver\n# Feature description: Binary indicator for elderly drivers (Age_of_Driver >= 70).\n# Usefulness: Encodes distinct driving patterns and accident circumstances associated with older drivers, which may correlate with demographics like sex.\ndf['Is_Elderly_Driver'] = (df['Age_of_Driver'] >= 70).astype(int)\n\n# Vehicle_Age_Type_Interaction\n# Feature description: Interaction term combining Age_of_Vehicle and Vehicle_Type to represent their combined impact on accident dynamics.\n# Usefulness: Encodes patterns where certain vehicle age and types are predisposed to specific accident outcomes, potentially linked to driver sex.\ndf['Vehicle_Age_Type_Interaction'] = df['Age_of_Vehicle'] * df['Vehicle_Type']\n\n# High_Risk_Casualty_Age\n# Feature description: Binary flag highlighting casualties in the higher-risk age band (Age_of_Casualty > 60).\n# Usefulness: Represents vulnerable age groups in accidents, potentially impacting accident dynamics related to driver demographics.\ndf['High_Risk_Casualty_Age'] = (df['Age_of_Casualty'] > 60).astype(int)\n\n# Area_Accident_Density_Normalized\n# Feature description: Normalizes Local_Authority_(District) using min-max scaling to represent urban or rural accident density.\n# Usefulness: Encodes spatial factors influencing accident dynamics, potentially linked to driver behaviors and sex.\ndf['Area_Accident_Density_Normalized'] = (df['Local_Authority_(District)'] - df['Local_Authority_(District)'].min()) / (df['Local_Authority_(District)'].max() - df['Local_Authority_(District)'].min())\n\n# One_Vehicle_Casualty_Ratio\n# Feature description: Ratio between Number_of_Casualties and Number_of_Vehicles in single-vehicle accidents to analyze casualty impact.\n# Usefulness: Encodes accident severity for single-vehicle scenarios, providing insights potentially correlated with driver demographics.\ndf['One_Vehicle_Casualty_Ratio'] = df['Number_of_Casualties'] / (df['Number_of_Vehicles'] + 1e-5)  # Add small epsilon to avoid division by zero.\n\n# Engine_Capacity_Accident_Scale\n# Feature description: Interaction term combining Engine_Capacity_(CC) with Number_of_Casualties to assess accident scale based on engine power.\n# Usefulness: Encodes accident dynamics where engine capacity directly scales with casualty count, potentially linked to driver sex through vehicle preferences.\ndf['Engine_Capacity_Accident_Scale'] = df['Engine_Capacity_(CC)'] * df['Number_of_Casualties']\n\n# Vehicle_Age_Normalized\n# Feature description: Normalizes Age_of_Vehicle using z-score standardization for consistent scale representation.\n# Usefulness: Allows analyzing vehicle age differences independently of absolute values, helping uncover trends tied to driver sex.\ndf['Vehicle_Age_Normalized'] = (df['Age_of_Vehicle'] - df['Age_of_Vehicle'].mean()) / df['Age_of_Vehicle'].std()\n\n# Drop Less Relevant Columns\n# Removes columns unlikely to contribute significantly to driver sex prediction based on dataset attributes and prior inspection.\ndf.drop(columns=['Pedestrian_Location', 'Pedestrian_Movement', 'Hit_Object_in_Carriageway', \n                 'Hit_Object_off_Carriageway', 'Casualty_Type'], inplace=True)"]
