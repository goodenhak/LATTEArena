df.drop(columns=['Pedestrian_Location', 'Pedestrian_Movement', 'Hit_Object_in_Carriageway', 
                 'Hit_Object_off_Carriageway', 'Casualty_Type', 'Vehicle_Location-Restricted_Lane'], inplace=True)
end
