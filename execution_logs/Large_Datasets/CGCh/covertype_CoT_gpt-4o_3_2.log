[{'["# Elevation_Normalized\\n# Feature description: Normalize the Elevation feature using z-score normalization.\\n# Usefulness: Z-score normalization centers the elevation data and scales it to unit variance. This avoids any dominance of elevation in models while retaining its importance as a predictor of vegetation types.\\ndf[\'Elevation_Normalized\'] = (df[\'Elevation\'] - df[\'Elevation\'].mean()) / df[\'Elevation\'].std()", "# Hydrology_Euclidean_Distance\\n# Feature description: Calculate the Euclidean distance to hydrology using both Horizontal_Distance_To_Hydrology and Vertical_Distance_To_Hydrology.\\n# Usefulness: Euclidean distance combines both horizontal and vertical proximity to water sources, which is highly relevant to vegetation distribution and soil moisture.\\ndf[\'Hydrology_Euclidean_Distance\'] = np.sqrt(df[\'Horizontal_Distance_To_Hydrology\']  2 + df[\'Vertical_Distance_To_Hydrology\']  2)", "# Hillshade_Average\\n# Feature description: Calculate the average of Hillshade values across 9am, noon, and 3pm.\\n# Usefulness: This feature summarizes terrain illumination during different times of the day. Areas with higher average illumination might support distinct vegetation based on light availability.\\ndf[\'Hillshade_Average\'] = (df[\'Hillshade_9am\'] + df[\'Hillshade_Noon\'] + df[\'Hillshade_3pm\']) / 3", "# Aspect_Sine\\n# Feature description: Transform the Aspect angle into its sine value.\\n# Usefulness: Sine transformation captures directional influences, such as exposure to sunlight or wind, while respecting the cyclical nature of angle data.\\ndf[\'Aspect_Sine\'] = np.sin(np.radians(df[\'Aspect\']))", "# Aspect_Cosine\\n# Feature description: Transform the Aspect angle into its cosine value.\\n# Usefulness: Complementary to Aspect_Sine, cosine transformation captures additional directional influence, completing the representation of cyclic angle data.\\ndf[\'Aspect_Cosine\'] = np.cos(np.radians(df[\'Aspect\']))", "# Road_Fire_Distance_Ratio\\n# Feature description: Calculate the ratio between Horizontal_Distance_To_Roadways and Horizontal_Distance_To_Fire_Points.\\n# Usefulness: This ratio highlights the spatial relationship between human infrastructure and fire points, potentially linking forest management practices to cover type.\\ndf[\'Road_Fire_Distance_Ratio\'] = df[\'Horizontal_Distance_To_Roadways\'] / (df[\'Horizontal_Distance_To_Fire_Points\'] + 1e-6)", "# Hydrology_Road_Distance_Ratio\\n# Feature description: Calculate the ratio between Horizontal_Distance_To_Hydrology and Horizontal_Distance_To_Roadways.\\n# Usefulness: This metric provides insight into the relative proximity of water features and roadways, which may influence accessibility and forest type.\\ndf[\'Hydrology_Road_Distance_Ratio\'] = df[\'Horizontal_Distance_To_Hydrology\'] / (df[\'Horizontal_Distance_To_Roadways\'] + 1e-6)", "# Soil_Type_Sum\\n# Feature description: Sum all Soil_Type indicators to represent the diversity of soil types at a given location.\\n# Usefulness: A higher number of soil types may indicate greater ecological diversity, which could influence forest cover.\\ndf[\'Soil_Type_Sum\'] = df[[f\'Soil_Type{i}\' for i in range(1, 41)]].sum(axis=1)", "# Vertical_Hydrology_Relief\\n# Feature description: Difference between Vertical_Distance_To_Hydrology and Slope.\\n# Usefulness: This captures the elevation-driven hydrological relief by accounting for drainage effects due to terrain steepness.\\ndf[\'Vertical_Hydrology_Relief\'] = df[\'Vertical_Distance_To_Hydrology\'] - df[\'Slope\']", "# Combined_Distance_Sum\\n# Feature description: Sum of Horizontal_Distance_To_Hydrology, Horizontal_Distance_To_Roadways, and Horizontal_Distance_To_Fire_Points.\\n# Usefulness: This aggregate metric captures overall proximity to important physical features, emphasizing their combined influence on forest cover.\\ndf[\'Combined_Distance_Sum\'] = df[\'Horizontal_Distance_To_Hydrology\'] + df[\'Horizontal_Distance_To_Roadways\'] + df[\'Horizontal_Distance_To_Fire_Points\']"]': 0.009405683534743137}, {'["# Wilderness_Area_Combination\\n# Feature description: Combine Wilderness area indicators into a feature that represents the specific wilderness type (one-hot encoding).\\n# Usefulness: Forest cover type is influenced by ecological characteristics of specific wilderness areas, which have distinct vegetation, soil types, and human impact. This feature simplifies analysis by transforming binary indicators into a categorical variable.\\ndf[\'Wilderness_Area_Combination\'] = (\\n    df[[\'Wilderness_Area1\', \'Wilderness_Area2\', \'Wilderness_Area3\', \'Wilderness_Area4\']]\\n    .dot([1, 2, 3, 4])\\n)", "# Soil_Type_Binary_Sum\\n# Feature description: Count the number of binary soil types present (non-zero indicators) at a given location.\\n# Usefulness: Instead of summarizing soil diversity with raw counts, this feature explicitly captures soil presence diversity by summing binary indicators, emphasizing ecological complexity and possible vegetation influences.\\ndf[\'Soil_Type_Binary_Sum\'] = df[[f\'Soil_Type{i}\' for i in range(1, 41)]].sum(axis=1)", "# Horizontal_Distance_Rank\\n# Feature description: Rank Horizontal_Distance_To_Hydrology, Horizontal_Distance_To_Roadways, and Horizontal_Distance_To_Fire_Points at each location.\\n# Usefulness: Ranking distances provides relative proximity, enabling the model to focus on the closest influential feature rather than absolute distances.\\ndf[\'Horizontal_Distance_Rank\'] = (\\n    df[[\'Horizontal_Distance_To_Hydrology\', \'Horizontal_Distance_To_Roadways\', \'Horizontal_Distance_To_Fire_Points\']]\\n    .rank(axis=1, method=\'dense\')\\n)", "# Terrain_Slope_Relief\\n# Feature description: Create a feature combining Vertical_Distance_To_Hydrology and Slope using a ratio.\\n# Usefulness: This feature measures elevation-driven hydrological relief adjusted for terrain steepness, capturing geographic variation affecting forest cover type.\\ndf[\'Terrain_Slope_Relief\'] = df[\'Vertical_Distance_To_Hydrology\'] / (df[\'Slope\'] + 1e-6)", "# Light_Exposure_Std\\n# Feature description: Calculate the standard deviation of the three Hillshade indices to measure terrain light variability.\\n# Usefulness: Light variability can affect vegetation growth, as uneven illumination impacts soil moisture and microclimates. This feature provides insight into terrain ruggedness.\\ndf[\'Light_Exposure_Std\'] = df[[\'Hillshade_9am\', \'Hillshade_Noon\', \'Hillshade_3pm\']].std(axis=1)", "# Combined_Distance_Std\\n# Feature description: Calculate the standard deviation of distances (to hydrology, roadways, and fire points) to assess spatial spread.\\n# Usefulness: Variability in distances represents accessibility divergence, which may relate to forest management practices and ecological impacts on vegetation.\\ndf[\'Combined_Distance_Std\'] = df[[\'Horizontal_Distance_To_Hydrology\', \'Horizontal_Distance_To_Roadways\', \'Horizontal_Distance_To_Fire_Points\']].std(axis=1)", "# Combined_Elevation_Ratio\\n# Feature description: Compute the ratio of Elevation to Combined_Distance_Sum.\\n# Usefulness: High elevation relative to proximal distances may highlight areas with unique vegetation or soil characteristics driven by altitude proximity effects.\\ndf[\'Combined_Elevation_Ratio\'] = df[\'Elevation\'] / (df[\'Combined_Distance_Sum\'] + 1e-6)", "# Hydrology_Aspect_Interaction\\n# Feature description: Multiply Hydrology_Euclidean_Distance with Aspect_Sine and Aspect_Cosine.\\n# Usefulness: This interaction captures directional hydrological proximity, combining spatial water accessibility and exposure due to terrain orientation.\\ndf[\'Hydrology_Aspect_Interaction\'] = (\\n    df[\'Hydrology_Euclidean_Distance\']\\n    * (df[\'Aspect_Sine\'] + df[\'Aspect_Cosine\'])\\n)", "# Distance_Feature_Binning\\n# Feature description: Bin Horizontal_Distance_To_Hydrology, Horizontal_Distance_To_Roadways, and Vertical_Distance_To_Hydrology into categories (near, medium, far).\\n# Usefulness: Categorizing distances reduces variance and simplifies downstream model learning processes, enabling decision boundaries that align with real-world classifications.\\ndf[\'Horizontal_Hydrology_Binned\'] = pd.cut(df[\'Horizontal_Distance_To_Hydrology\'], bins=3, labels=[\'Near\', \'Medium\', \'Far\'])\\ndf[\'Horizontal_Roadways_Binned\'] = pd.cut(df[\'Horizontal_Distance_To_Roadways\'], bins=3, labels=[\'Near\', \'Medium\', \'Far\'])\\ndf[\'Vertical_Hydrology_Binned\'] = pd.cut(df[\'Vertical_Distance_To_Hydrology\'], bins=3, labels=[\'Near\', \'Medium\', \'Far\'])"]': 0.005452228096676781}]
