# Elevation_Binned
# Feature description: Binning the elevation values into equal-sized quantile bins (low, medium, high).
# This helps categorize elevation into discrete classes that might correlate with specific vegetation types or soil types, simplifying decision boundaries for classifiers.
# Usefulness: Forest cover type is likely to be heavily influenced by elevation since different tree species thrive at different altitudes.
df['Elevation_Binned'] = pd.cut(df['Elevation'], bins=3, labels=[Low, Medium, High])  
end

python
# Aspect_Sine
# Feature description: Transforming the 'Aspect' angle into its sine value.
# Usefulness: The sine function allows the model to account for orientation and exposure effects (e.g., sun exposure or wind patterns) without assuming a simple linear relationship between aspect and target variable, which respects the periodicity of angle data.
df['Aspect_Sine'] = np.sin(np.radians(df['Aspect']))  
end

python
# Aspect_Cosine
# Feature description: Transforming the 'Aspect' angle into its cosine value.
# Usefulness: Complements the sine transformation by capturing additional orientation information. Both sine and cosine together can fully encode the angular relationship of the aspect.
df['Aspect_Cosine'] = np.cos(np.radians(df['Aspect']))  
end

python
# Hydrology_Distance
# Feature description: Combined feature of horizontal and vertical distance to hydrology using Euclidean distance.
# Usefulness: Combining horizontal and vertical distances captures the absolute proximity to water features, which may be more representative of hydrological influences on soil and vegetation.
df['Hydrology_Distance'] = np.sqrt(df['Horizontal_Distance_To_Hydrology']2 + df['Vertical_Distance_To_Hydrology']2)  
end

python
# Combined_Hillshade_Mean
# Feature description: The average of the three hillshade values.
# Usefulness: Ensures a unified view of the terrain's average exposure to light, which directly impacts soil moisture and vegetation growth.
df['Combined_Hillshade_Mean'] = (df['Hillshade_9am'] + df['Hillshade_Noon'] + df['Hillshade_3pm']) / 3  
end

python
# Roadways_Fire_Distance_Ratio
# Feature description: Ratio between Horizontal_Distance_To_Roadways and Horizontal_Distance_To_Fire_Points.
# Usefulness: This ratio captures the relative proximity of roads to fire points, which can influence forest management practices or emergency response measures that affect forest types.
df['Roadways_Fire_Distance_Ratio'] = df['Horizontal_Distance_To_Roadways'] / (df['Horizontal_Distance_To_Fire_Points'] + 1e-6)  
end

python
# Hillshade_Std
# Feature description: Standard deviation of the three hillshade values.
# Usefulness: Measures light variability over the three terrains time points, which may correspond to ruggedness of terrain or differences in sun exposure patterns.
df['Hillshade_Std'] = df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].std(axis=1)  
end

python
# Horizontal_Distance_Binned
# Feature description: Binning the 'Horizontal_Distance_To_Hydrology', 'Horizontal_Distance_To_Roadways', and 'Horizontal_Distance_To_Fire_Points' into categories.
# Usefulness: Converting distances into low, medium, and high proximity buckets may simplify learning for tree-based models and accommodate non-linear relationships.
df['Hydrology_Distance_Binned'] = pd.cut(df['Horizontal_Distance_To_Hydrology'], bins=3, labels=[Near, Moderate, Far])  
df['Roadways_Distance_Binned'] = pd.cut(df['Horizontal_Distance_To_Roadways'], bins=3, labels=[Near, Moderate, Far])  
df['Fire_Points_Distance_Binned'] = pd.cut(df['Horizontal_Distance_To_Fire_Points'], bins=3, labels=[Near, Moderate, Far])  
end

python
