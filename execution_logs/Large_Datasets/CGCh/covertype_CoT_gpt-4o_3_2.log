# Combined_Hillshade_Avg_And_Variance
# Feature description: Calculate the average and variance of the three Hillshade features to summarize terrain illumination.
# Usefulness: Encapsulates terrain exposure in the morning, noon, and afternoon into meaningful metrics that aid in understanding vegetation growth patterns.
df['Hillshade_Average'] = (df['Hillshade_9am'] + df['Hillshade_Noon'] + df['Hillshade_3pm']) / 3
df['Hillshade_Variance'] = df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].var(axis=1)
end 

