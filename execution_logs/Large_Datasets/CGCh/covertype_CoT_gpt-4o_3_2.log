# Aspect_Trigonometric_Transformation
# Feature description: Apply sinusoidal transformations to Aspect: sine and cosine values.
# Usefulness: Aspect is an angular feature, so modeling it as both sine and cosine preserves periodicity and provides full circular representation. This captures exposure to sunlight or wind direction.
df['Aspect_Sine'] = np.sin(np.radians(df['Aspect']))
df['Aspect_Cosine'] = np.cos(np.radians(df['Aspect']))
