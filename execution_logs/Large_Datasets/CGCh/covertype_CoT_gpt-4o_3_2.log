# Hydrology_Euclidean_Distance
# Feature description: Compute the Euclidean distance to the nearest hydrological feature using horizontal and vertical distances.
# Usefulness: This feature represents the shortest physical distance to water sources, which is critical in determining soil moisture and vegetation patterns, influencing forest cover type.
df['Hydrology_Euclidean_Distance'] = np.sqrt(df['Horizontal_Distance_To_Hydrology']2 + df['Vertical_Distance_To_Hydrology']2)

# Hillshade_Amplitude
# Feature description: Calculate the amplitude (max - min) across all three Hillshade values: 9am, noon, and 3pm.
# Usefulness: The amplitude measures variations in light exposure due to terrain shape during the day, reflecting differences in microclimates that influence vegetation types.
df['Hillshade_Amplitude'] = df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].max(axis=1) - df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].min(axis=1)

# Road_Hydrology_Distance_Difference
# Feature description: Calculate the difference between Horizontal_Distance_To_Roadways and Horizontal_Distance_To_Hydrology.
# Usefulness: This feature captures the spatial difference between roadways and water sources, which could indicate human impact on regions near water. Proximity to water relative to roads might affect forest types.
df['Road_Hydrology_Distance_Difference'] = df['Horizontal_Distance_To_Roadways'] - df['Horizontal_Distance_To_Hydrology']

# Slope_Angle_Tangent
# Feature description: Compute the tangent of the slope angle, using the trigonometric tan function.
# Usefulness: Slope influences water runoff and soil stability. The tangent of the slope provides a direct measure of steepness, which is crucial for understanding terrain impact on forest distribution.
df['Slope_Angle_Tangent'] = np.tan(np.radians(df['Slope']))

# Wilderness_Type_OneHot
# Feature description: One-hot encode the Wilderness area indicators to create separate binary columns for each wilderness type.
# Usefulness: Transforming these indicators into separate columns allows models to explicitly learn from each wilderness's unique ecological and management characteristics.
wilderness_columns = ['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3', 'Wilderness_Area4']
df = pd.get_dummies(df, columns=wilderness_columns, prefix='Wilderness_Type')

# Distance_Feature_Mean
# Feature description: Compute the mean of distances to Hydrology, Roadways, and Fire Points.
# Usefulness: This feature captures the average proximity of each cell to key physical features, offering a general sense of overall accessibility or remoteness.
df['Distance_Feature_Mean'] = df[['Horizontal_Distance_To_Hydrology', 'Horizontal_Distance_To_Roadways', 'Horizontal_Distance_To_Fire_Points']].mean(axis=1)

# Vertical_Hydrology_To_Total_Elevation_Ratio
# Feature description: Compute the ratio between Vertical_Distance_To_Hydrology and Elevation.
# Usefulness: Tracks the relative position of water sources along the elevation gradient, which may affect vegetation types due to differences in water availability and runoff.
df['Vertical_Hydrology_To_Total_Elevation_Ratio'] = df['Vertical_Distance_To_Hydrology'] / (df['Elevation'] + 1e-6)

# Fire_Roadway_Elevation_Interaction
# Feature description: Multiply Horizontal_Distance_To_Fire_Points, Horizontal_Distance_To_Roadways, and Elevation to create an interaction term.
# Usefulness: This interaction captures complex relationships between proximity to fire points, roadways, and elevation. These factors combined can reflect areas more likely impacted by fires or human infrastructure.
df['Fire_Roadway_Elevation_Interaction'] = df['Horizontal_Distance_To_Fire_Points'] * df['Horizontal_Distance_To_Roadways'] * df['Elevation']
end
