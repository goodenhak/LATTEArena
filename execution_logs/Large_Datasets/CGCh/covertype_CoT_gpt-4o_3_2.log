# Elevation_Normalized
# Feature description: Normalize the Elevation feature using z-score normalization.
# Usefulness: Z-score normalization centers the elevation data and scales it to unit variance. This avoids any dominance of elevation in models while retaining its importance as a predictor of vegetation types and forest cover types.
df['Elevation_Normalized'] = (df['Elevation'] - df['Elevation'].mean()) / df['Elevation'].std()
end

python
# Hydrology_Euclidean_Distance
# Feature description: Calculate the Euclidean distance to hydrology using both Horizontal_Distance_To_Hydrology and Vertical_Distance_To_Hydrology.
# Usefulness: Combining horizontal and vertical distances provides an absolute proximity measure to hydrology, which is highly relevant to vegetation distribution and soil moisture influence.
df['Hydrology_Euclidean_Distance'] = np.sqrt(df['Horizontal_Distance_To_Hydrology']2 + df['Vertical_Distance_To_Hydrology']2)
end

python
# Hillshade_Average
# Feature description: Calculate the average of Hillshade values across 9am, noon, and 3pm.
# Usefulness: This feature summarizes terrain illumination during different times of the day. Areas with higher average illumination might support distinct vegetation based on light availability and microclimate factors.
df['Hillshade_Average'] = (df['Hillshade_9am'] + df['Hillshade_Noon'] + df['Hillshade_3pm']) / 3
end

python
# Aspect_Sine
# Feature description: Transform the Aspect angle into its sine value.
# Usefulness: The sine transformation represents the angular orientation of the slope and captures exposure to sunlight or wind. This transformation helps respect the periodic nature of angular data.
df['Aspect_Sine'] = np.sin(np.radians(df['Aspect']))
end

python
# Aspect_Cosine
# Feature description: Transform the Aspect angle into its cosine value.
# Usefulness: Similar to the sine transformation, the cosine transformation completes the representation of the angular data, providing additional information for the model to detect directional effects.
df['Aspect_Cosine'] = np.cos(np.radians(df['Aspect']))
end

python
# Road_Fire_Distance_Ratio
# Feature description: Calculate the ratio between Horizontal_Distance_To_Roadways and Horizontal_Distance_To_Fire_Points.
# Usefulness: This ratio quantifies the spatial relationship between roadways and fire points, which may provide insight into areas affected by human activity and wildfire risk, influencing forest cover.
df['Road_Fire_Distance_Ratio'] = df['Horizontal_Distance_To_Roadways'] / (df['Horizontal_Distance_To_Fire_Points'] + 1e-6)
end

python
# Hydrology_Road_Distance_Ratio
# Feature description: Calculate the ratio between Horizontal_Distance_To_Hydrology and Horizontal_Distance_To_Roadways.
# Usefulness: This feature highlights the relative proximity of hydrological features and roadways. This is useful for understanding accessibility and potential ecological impacts of road presence near hydrology.
df['Hydrology_Road_Distance_Ratio'] = df['Horizontal_Distance_To_Hydrology'] / (df['Horizontal_Distance_To_Roadways'] + 1e-6)
end

python
# Soil_Type_Sum
# Feature description: Sum all Soil_Type indicators to represent the diversity of soil types present at a given location.
# Usefulness: Different soil types support distinct vegetation. The number of soil types at a location may be an indicator of ecological diversity and influence forest cover changes.
df['Soil_Type_Sum'] = df[[f'Soil_Type{i}' for i in range(1, 41)]].sum(axis=1)
end

python
# Vertical_Hydrology_Relief
# Feature description: Difference between Vertical_Distance_To_Hydrology and Slope.
# Usefulness: This represents hydrological relief adjusted by terrain steepness. Higher values may indicate the potential for water accumulation or drainage impacts on vegetation.
df['Vertical_Hydrology_Relief'] = df['Vertical_Distance_To_Hydrology'] - df['Slope']
end

python
# Combined_Distance_Sum
# Feature description: Sum of Horizontal_Distance_To_Hydrology, Horizontal_Distance_To_Roadways, and Horizontal_Distance_To_Fire_Points.
# Usefulness: This aggregated metric captures overall proximity to important physical features, which are critical determinants of forest type due to access and environmental factors.
df['Combined_Distance_Sum'] = df['Horizontal_Distance_To_Hydrology'] + df['Horizontal_Distance_To_Roadways'] + df['Horizontal_Distance_To_Fire_Points']
end

python
# Terrain_Slope_Relief
# Feature description: Create a feature combining Vertical_Distance_To_Hydrology and Slope using a ratio.
# Usefulness: This feature indicates hydrological relief (i.e., the vertical distance to hydrology) normalized by the terrain’s slope, highlighting areas with possible greater vegetation due to water accessibility on steep terrain.
df['Terrain_Slope_Relief'] = df['Vertical_Distance_To_Hydrology'] / (df['Slope'] + 1e-6)
end

python
# Light_Exposure_Std
# Feature description: Calculate the standard deviation of the three Hillshade indices to measure terrain light variability.
# Usefulness: Variability in light exposure can affect vegetation growth, microclimates, and soil properties, making it a powerful factor for forest cover prediction.
df['Light_Exposure_Std'] = df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].std(axis=1)
end

python
# Combined_Distance_Std
# Feature description: Calculate the standard deviation of distances (to hydrology, roadways, and fire points) to assess spatial spread.
# Usefulness: High variability in distances to these features may indicate diverse environmental conditions, helping distinguish varying forest types.
df['Combined_Distance_Std'] = df[['Horizontal_Distance_To_Hydrology', 'Horizontal_Distance_To_Roadways', 'Horizontal_Distance_To_Fire_Points']].std(axis=1)
end

python
# Combined_Elevation_Ratio
# Feature description: Compute the ratio of Elevation to Combined_Distance_Sum.
# Usefulness: This ratio highlights areas where high elevation is inversely correlated with proximity to key features, which may indicate uniqueness in vegetation.
df['Combined_Elevation_Ratio'] = df['Elevation'] / (df['Combined_Distance_Sum'] + 1e-6)
end

python
# Distance_Feature_Binning
# Feature description: Bin Horizontal_Distance_To_Hydrology, Horizontal_Distance_To_Roadways, and Vertical_Distance_To_Hydrology into categories (near, medium, far).
# Usefulness: Binning continuous distance metrics reduces variance and adds interpretability. It provides categorical insights into the spatial accessibility value for modeling.
df['Horizontal_Hydrology_Binned'] = pd.cut(df['Horizontal_Distance_To_Hydrology'], bins=3, labels=['Near', 'Medium', 'Far'])
df['Horizontal_Roadways_Binned'] = pd.cut(df['Horizontal_Distance_To_Roadways'], bins=3, labels=['Near', 'Medium', 'Far'])
df['Vertical_Hydrology_Binned'] = pd.cut(df['Vertical_Distance_To_Hydrology'], bins=3, labels=['Near', 'Medium', 'Far'])
end
