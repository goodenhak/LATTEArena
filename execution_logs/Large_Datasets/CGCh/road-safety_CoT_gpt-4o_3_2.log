# Feature name: Driver_and_Casualty_Combined_Score
# Feature description: Computes a feature that aggregates Driver_Age_Performance_Score, Driver_Age_ZScore, and Driver_Casualty_Proximity into a single metric weighted by their impact on casualty outcomes.
# Usefulness: This multi-factor aggregation captures driver behavior, age specificity, and proximity to casualties, combining them into a single feature for better downstream prediction.

df['Driver_and_Casualty_Combined_Score'] = (
    df['Driver_Age_Performance_Score'] * 0.4 +
    df['Driver_Age_ZScore'] * 0.3 +
    df['Driver_Casualty_Proximity'] * 0.3
)
end

