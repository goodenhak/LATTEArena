# Feature name: Vehicle_Impact_Severity_Score
# Feature description: Interaction term derived from Hit_Object_Sum and Engine_Capacity_Performance_Band (encoded numerically) to reflect the severity and potential impact of the vehicle in accidents.
# Usefulness: A combination of the number of objects hit and the engine capacity performance band can provide insights into accident severity and driver risk profiles, potentially correlating with sex of the driver.
engine_band_mapping = {'Low': 1, 'Medium-Low': 2, 'Medium': 3, 'High': 4, 'Very-High': 5}
df['Engine_Capacity_Performance_Band_Num'] = df['Engine_Capacity_Performance_Band'].map(engine_band_mapping)
df['Vehicle_Impact_Severity_Score'] = df['Hit_Object_Sum'] * df['Engine_Capacity_Performance_Band_Num']
df.drop(columns=['Engine_Capacity_Performance_Band_Num'], inplace=True)
end

