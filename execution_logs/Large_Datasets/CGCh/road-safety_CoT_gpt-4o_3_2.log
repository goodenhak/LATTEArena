# Feature name: Driver_Age_Binned
# Feature description: Age_of_Driver is binned into discrete age groups to represent broad age categories.
# Usefulness: This gives a coarse-grained aggregation of the age of the driver, potentially surfacing patterns like younger or older drivers being associated with certain behaviors or accident involvement. Helps remove noise in individual age values while preserving meaningful distinctions relevant to prediction.
df['Driver_Age_Binned'] = pd.cut(df['Age_of_Driver'], bins=[0, 18, 30, 50, 70, 100], labels=['<18', '18-30', '30-50', '50-70', '>70'])
end

python
# Feature name: Driver_Sex_and_Casualty_Sex_Match
# Feature description: A binary feature indicating whether the driver's sex matches the casualty's sex.
# Usefulness: This feature could uncover social driving dynamics, such as whether drivers are more likely to be involved in accidents with casualties of the same sex, providing potential insight into corresponding patterns.
df['Driver_Sex_and_Casualty_Sex_Match'] = (df['Sex_of_Casualty'] == df['Sex_of_Driver']).astype(int)
end

python
# Feature name: Urban_Rural_Ratio
# Feature description: Ratio calculated from Urban_or_Rural_Area and Number_of_Vehicles to represent density of vehicles relative to the urban or rural road classification.
# Usefulness: Urban and rural areas may have vastly different traffic characteristics; combining this with the number of vehicles provides insight into the traffic density and road type, which could impact driver behavior and accident circumstances.
df['Urban_Rural_Ratio'] = df['Number_of_Vehicles'] / df['Urban_or_Rural_Area']
end

python
# Feature name: Driver_Age_ZScore
# Feature description: Z-score of driver age derived from Age_of_Driver to normalize and standardize this feature.
# Usefulness: Standardizing driver age helps identify deviations from the mean age across the dataset, enabling the prediction model to capture patterns among younger or older drivers relative to the overall driver population.
df['Driver_Age_ZScore'] = (df['Age_of_Driver'] - df['Age_of_Driver'].mean()) / df['Age_of_Driver'].std()
end

python
# Feature name: Engine_Capacity_Performance_Band
# Feature description: Binning vehicles into performance categories based on Engine_Capacity_(CC).
# Usefulness: Provides a sense of the type of vehicle and potential driving behavior associated with engine capacity. Larger, high-performance engines may correspond to different driving patterns or accident circumstances compared to smaller engines.
df['Engine_Capacity_Performance_Band'] = pd.cut(
    df['Engine_Capacity_(CC)'], 
    bins=[0, 1000, 1600, 2500, 5000, 17000], 
    labels=['Low', 'Medium-Low', 'Medium', 'High', 'Very-High']
)
end

python
# Feature name: Hit_Object_Sum
# Feature description: Total number of objects hit by the vehicle in and off the carriageway.
# Usefulness: Aggregating both Hit_Object_in_Carriageway and Hit_Object_off_Carriageway provides a combined measure of impact behavior, which could reflect driver awareness or accident severity.
df['Hit_Object_Sum'] = df['Hit_Object_in_Carriageway'] + df['Hit_Object_off_Carriageway']
end

python
# Feature name: Police_Force_Normalized
# Feature description: Normalize Police_Force values by applying Z-score normalization.
# Usefulness: Since Police_Force might have patterns strongly associated with regional differences in enforcement or reporting, normalization ensures the data characteristics are comparable across the dataset and highlights outliers.
df['Police_Force_Normalized'] = (df['Police_Force'] - df['Police_Force'].mean()) / df['Police_Force'].std()
end

python
# Feature name: Urban_Vehicle_Location_Group
# Feature description: Performs a groupby operation on Urban_or_Rural_Area to compute the mean value of Vehicle_Location-Restricted_Lane for urban/rural classification.
# Usefulness: Helps understand the average tendency of vehicles in restricted lanes depending on whether the area is urban or rural, potentially influencing driver behavior in different areas.
df['Urban_Vehicle_Location_Group'] = df.groupby('Urban_or_Rural_Area')['Vehicle_Location-Restricted_Lane'].transform('mean')
end

python
# Dropping columns with weak correlations or redundancy
# Column: Casualty_Reference
# Reason: This column directly tracks casualties numerically without providing additional predictive insight about driver sex.
df.drop(columns=['Casualty_Reference'], inplace=True)
end

python
# Dropping columns with weak correlations or redundancy
# Column: Location_Northing_OSGR and Location_Easting_OSGR
# Reason: These absolute location values do not add direct predictive insight for the driver's sex, and are better converted into a derived feature (e.g., region clustering).
df.drop(columns=['Location_Northing_OSGR', 'Location_Easting_OSGR'], inplace=True)
end
