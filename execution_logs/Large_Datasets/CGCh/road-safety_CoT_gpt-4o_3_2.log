# Feature name: Latitude_and_Longitude_Interaction
# Feature description: Creates an interaction feature by multiplying normalized Latitude and Longitude values.
# Usefulness: This combines geographic data into a single value to capture spatial gradients and patterns associated with accidents, which might indirectly relate to driver demographics or accident tendencies in certain regions.

latitude_norm = (df['Latitude'] - df['Latitude'].min()) / (df['Latitude'].max() - df['Latitude'].min())
longitude_norm = (df['Longitude'] - df['Longitude'].min()) / (df['Longitude'].max() - df['Longitude'].min())
df['Latitude_and_Longitude_Interaction'] = latitude_norm * longitude_norm
end

