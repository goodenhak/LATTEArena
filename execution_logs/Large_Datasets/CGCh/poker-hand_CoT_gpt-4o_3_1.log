2026-05-13 03:48:26,404 - INFO - ops_string = ["# rank_sum_is_even\n# Feature description: Boolean flag indicating if the total sum of ranks is even.\n# Usefulness: Total rank parity can be a quick flag for specific rank placements and can indicate the likelihood of certain hands in the dataset's structural details.\ndf['rank_sum_is_even'] = (df['total_rank_sum'] % 2 == 0).astype(int)", "# rank_median\n# Feature description: Median of the ranks in the hand.\n# Usefulness: Median rank provides insight into the central tendency, which can be useful for categorizing the spread of values within a hand.\ndf['rank_median'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].median(axis=1)", "# rank_range\n# Feature description: Calculates the range (max - min) of ranks in the hand.\n# Usefulness: Provides a measure of the spread of ranks which, when used with is_sequential, can be indicative of a straight.\ndf['rank_range'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].max(axis=1) - df[['V2', 'V4', 'V6', 'V8', 'V10']].min(axis=1)", "# is_two_high_cards\n# Feature description: Boolean flag indicating whether there are at least two cards with high ranks (≥11).\n# Usefulness: High-ranking cards significantly contribute to high-value poker hands like Royal Flush or standout setups.\ndf['is_two_high_cards'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda row: sum(rank >= 11 for rank in row) >= 2, axis=1).astype(int)", "# rank_count_mode\n# Feature description: Number of times the most frequent rank appears in the hand.\n# Usefulness: Highlights repeated occurrences of ranks, directly aiding in identifying pairs, three of a kind, and other clustered rank patterns.\ndf['rank_count_mode'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: x.value_counts().max(), axis=1)", "# suit_median\n# Feature description: Median suit value in the hand.\n# Usefulness: Provides insight into central suit patterns, which can complement other features for predicting flush-type distributions.\ndf['suit_median'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].median(axis=1)", "# adjacent_pair_proximity\n# Feature description: Sum of absolute differences for adjacent ranks when sorted, modulated for pair analysis.\n# Usefulness: Helps detect patterns where pairs or clusters dominate, emphasizing tight groupings alongside sequentiality.\ndf['adjacent_pair_proximity'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda row: sum(abs(a - b) for a, b in zip(sorted(row[:-1]), sorted(row)[1:])), axis=1)", "# low_card_count\n# Feature description: Counts the number of cards with ranks ≤5.\n# Usefulness: Highlights low-ranking patterns, useful when differentiating between high-value versus low-value cards in hands.\ndf['low_card_count'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda row: sum(rank <= 5 for rank in row), axis=1)", "# high_card_ratio\n# Feature description: Computes the ratio of ranks ≥10 to total ranks in the hand.\n# Usefulness: High card ratios enhance the ability to separate stronger hands from weaker ones.\ndf['high_card_ratio'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda row: sum(rank >= 10 for rank in row) / len(row), axis=1)", "# max_consecutive_ranks\n# Feature description: Maximum number of consecutive ranks in the sorted hand.\n# Usefulness: Directly identifies sequentiality in hands, favoring straights and straight flushes.\ndf['max_consecutive_ranks'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda row: max(sum(1 for _ in group) for key, group in itertools.groupby(\n    [sorted(row)[i] - sorted(row)[i - 1] == 1 \n     for i in range(1, len(sorted(row)))] if key)), axis=1)"]
