# Usefulness: Directly identifies Royal Flush hands using explicit rank patterns and suit uniformity.
df['royal_flush_flag'] = ((df[['V2', 'V4', 'V6', 'V8', 'V10']].isin([10, 11, 12, 13, 1]).all(axis=1)) & (df['suit_is_uniform'] == 1)).astype(int)
end

