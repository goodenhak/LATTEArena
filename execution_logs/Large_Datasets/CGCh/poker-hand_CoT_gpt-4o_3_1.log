# rank_mode
# Most frequent rank in the hand
# Usefulness: Identifying the predominant rank can give insights into hands with pairs, three of a kind, four of a kind, and full houses. It helps simplify rank-based groupings.
df['rank_mode'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].mode(axis=1)[0]

# rank_std_dev
# Standard deviation of ranks across the hand
# Usefulness: A lower standard deviation may indicate clustering of ranks, which is useful for identifying pairs, three of a kind, and full house. A higher standard deviation may point toward straights.
df['rank_std_dev'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].std(axis=1)

# suit_std_dev
# Standard deviation of suits across the hand
# Usefulness: A higher standard deviation indicates a variety in suits, which reduces the likelihood of flushes or straight flushes. Conversely, a low standard deviation can be used to predict suit-dominated hands.
df['suit_std_dev'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].std(axis=1)

# rank_max_diff
# Maximum difference between the ranks in the hand
# Usefulness: Captures the range of ranks within the hand, which highlights sequential patterns for straights and straight flushes or the absence of such patterns for other hands.
df['rank_max_diff'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].max(axis=1) - df[['V2', 'V4', 'V6', 'V8', 'V10']].min(axis=1)

# rank_variance
# Variance of ranks across the hand
# Usefulness: Variance complements the standard deviation metric by emphasizing differences in the rank distribution. It is helpful for classifying hands with clustered ranks versus widely spread ranks.
df['rank_variance'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].var(axis=1)

# suit_match_count
# Count of matching suits in the hand
# Usefulness: Helps quantify suit similarities across the cards, providing direct insight into flushes and straight flushes. This is a complementary feature to max_suit_count.
df['suit_match_count'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(pd.Series.value_counts, axis=1).sum(axis=1).fillna(0).astype(int)

# rank_pair_count
# Number of ranks that appear in pairs
# Usefulness: Captures the frequency of paired ranks in the hand, crucial for distinguishing pairs, two pairs, and full house categories.
df['rank_pair_count'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: (x.value_counts() == 2).sum(), axis=1)

# rank_marks_fullhouse
# Boolean flag indicating a full house
# Usefulness: Directly checks for the specific pattern of ranks indicative of a full house (one pair and a three of a kind). Simplifies prediction for this distinct hand type.
