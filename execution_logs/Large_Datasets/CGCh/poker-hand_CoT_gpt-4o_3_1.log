# rank_total_strength_ratio
# Feature description: Computes the ratio of total rank sum to the maximum possible rank sum (65 for five cards). 
# Usefulness: Normalizes the total rank strength of the hand, allowing for relative comparison of rank strength across hands. Useful in identifying strong hands like high-card combinations or Royal Flush.
df['rank_total_strength_ratio'] = df['total_rank_sum'] / 65

# rank_diversity_index
# Feature description: Calculates the Shannon diversity index for ranks, which accounts for the relative frequency of rank occurrences.
# Usefulness: A low diversity index is indicative of clustering in ranks (pairs, three of a kind, etc.), while a higher value suggests a more distributed rank structure, aiding in distinguishing different hand categories.
import numpy as np
def shannon_diversity(series):
    value_counts = series.value_counts()
    proportions = value_counts / value_counts.sum()
    return -np.sum(proportions * np.log2(proportions))
df['rank_diversity_index'] = df[[‘V2’, ‘V4’, ‘V6’, ‘V8’, ‘V10’]].apply(shannon_diversity, axis=1)

# even_rank_count
# Feature description: Counts the number of cards in the hand with even ranks.
# Usefulness: Highlights patterns in the rank parity distribution, which may contribute to certain hands such as pairs or balanced combinations.
df['even_rank_count'] = df[[‘V2’, ‘V4’, ‘V6’, ‘V8’, ‘V10’]].apply(lambda row: sum(rank % 2 == 0 for rank in row), axis=1)

# odd_rank_count
# Feature description: Counts the number of cards in the hand with odd ranks.
# Usefulness: Similar to even_rank_count, but specifically focuses on detecting odd rank distributions, which again could signal notable hand patterns.
df['odd_rank_count'] = df[[‘V2’, ‘V4’, ‘V6’, ‘V8’, ‘V10’]].apply(lambda row: sum(rank % 2 != 0 for rank in row), axis=1)

# sequential_rank_gaps
# Feature description: Calculates the difference between the highest and lowest rank in the hand, adjusted for the number of unique ranks.
# Usefulness: Helps detect hands that are evenly spaced or highly gapped, providing additional differentiation in straight-like patterns or dispersed hands.
df['sequential_rank_gaps'] = (df[[‘V2’, ‘V4’, ‘V6’, ‘V8’, ‘V10’]].max(axis=1) - df[[‘V2’, ‘V4’, ‘V6’, ‘V8’, ‘V10’]].min(axis=1)) / df['unique_ranks_count']

# suit_entropy
# Feature description: Computes the entropy of the suits in the hand.
# Usefulness: Measures the randomness or uniformity of suit distribution across the hand. Lower values indicate uniform suit distribution (flush potential), while higher values suggest heterogeneous suits.
def entropy(series):
    value_counts = series.value_counts()
    probabilities = value_counts / value_counts.sum()
    return -np.sum(probabilities * np.log2(probabilities))
df['suit_entropy'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(entropy, axis=1)

# high_ace_presence
# Feature description: Boolean flag indicating whether the hand contains an Ace.
# Usefulness: Aces are pivotal for high-value hands like Royal Flush, straight combinations, and high-card hands. This feature helps identify such scenarios.
df['high_ace_presence'] = df[[‘V2’, ‘V4’, ‘V6’, ‘V8’, ‘V10’]].apply(lambda row: 1 if 1 in row else 0, axis=1)
end
