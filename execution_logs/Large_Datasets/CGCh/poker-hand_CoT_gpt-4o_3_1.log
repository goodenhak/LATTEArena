# suit_pairwise_difference
# Feature description: Computes the pairwise differences of suits across all combinations of cards.
# Usefulness: Highlights variability in suits, aiding the detection of flush patterns or mixed suits that disrupt flush classification.
from itertools import combinations
suit_diffs = []
for combo in combinations(['V1', 'V3', 'V5', 'V7', 'V9'], 2):
    suit_diffs.append(abs(df[combo[0]] - df[combo[1]]))
df['suit_pairwise_difference'] = sum(suit_diffs) / len(suit_diffs)
end

python
# rank_sequential_difference_flag
# Feature description: Boolean flag indicating if the rank sequential difference is exactly 4, which implies sequential ranks for a straight.
# Usefulness: Directly targets straights, simplifying their detection based on sequence difference thresholds.
df['rank_sequential_difference_flag'] = (df['rank_sequential_difference'] == 4).astype(int)
end

python
# suit_rank_sum_interaction
# Feature description: Multiplies the rank sum with the maximum suit count, emphasizing strong rank-suit combinations.
# Usefulness: Supports the detection of flushes and high-ranking hands by combining rank and suit importance.
df['suit_rank_sum_interaction'] = df['total_rank_sum'] * df['max_suit_count']
end

python
# fullhouse_probability_score
# Feature description: Creates a probability score based on ranks using rank pair count and three-of-a-kind presence.
# Usefulness: Simplifies identification of full houses by combining metrics critical for their classification.
df['fullhouse_probability_score'] = df['rank_pair_count'] + (3 * df['rank_std_dev'])
end

python
