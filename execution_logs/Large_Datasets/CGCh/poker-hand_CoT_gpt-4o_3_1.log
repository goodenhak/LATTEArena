# is_two_high_cards
# Feature description: Boolean flag indicating whether there are at least two cards with high ranks (≥11).
# Usefulness: High-ranking cards significantly contribute to high-value poker hands like Royal Flush or standout setups.
df['is_two_high_cards'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda row: sum(rank >= 11 for rank in row) >= 2, axis=1).astype(int)
end

python
# rank_count_mode
# Feature description: Number of times the most frequent rank appears in the hand.
# Usefulness: Highlights repeated occurrences of ranks, directly aiding in identifying pairs, three of a kind, and other clustered rank patterns.
df['rank_count_mode'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: x.value_counts().max(), axis=1)
end

python
# suit_median
# Feature description: Median suit value in the hand.
# Usefulness: Provides insight into central suit patterns, which can complement other features for predicting flush-type distributions.
df['suit_median'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].median(axis=1)
end

python
# adjacent_pair_proximity
# Feature description: Sum of absolute differences for adjacent ranks when sorted, modulated for pair analysis.
# Usefulness: Helps detect patterns where pairs or clusters dominate, emphasizing tight groupings alongside sequentiality.
df['adjacent_pair_proximity'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda row: sum(abs(a - b) for a, b in zip(sorted(row[:-1]), sorted(row)[1:])), axis=1)
end

