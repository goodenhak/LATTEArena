# high_rank_ratio
# Feature description: Calculates the proportion of cards with ranks greater than or equal to 11 (Jack, Queen, King, Ace).
# Usefulness: High-ranking cards are critical for identifying hands like Royal Flush, high card combinations, or standout ranks. This feature focuses on the proportion of valuable cards within the hand.
df['high_rank_ratio'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda row: sum(rank >= 11 for rank in row) / 5, axis=1)
end

python
# rank_total_strength_ratio
# Feature description: Computes the ratio of total rank sum to the maximum possible rank sum (i.e., 65 for five cards).
# Usefulness: Normalizes the total rank strength of the hand. A higher ratio indicates stronger hands involving higher-ranking cards, simplifying the identification of hands like Royal Flush and high-card combinations.
df['rank_total_strength_ratio'] = df['total_rank_sum'] / 65
end

python
# rank_diversity_index
# Feature description: Calculates the Shannon diversity index for card ranks, measuring the distribution of rank frequencies within the hand.
# Usefulness: Low diversity suggests clustering of ranks (e.g., pairs, three of a kind, etc.), while high diversity suggests spread ranks (e.g., straights). Enhances pattern differentiation across hands.
import numpy as np
def shannon_diversity(series):
    value_counts = series.value_counts()
    proportions = value_counts / value_counts.sum()
    return -np.sum(proportions * np.log2(proportions))
df['rank_diversity_index'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(shannon_diversity, axis=1)
end

python
# sequential_rank_gaps
# Feature description: Calculates the difference between the highest and lowest rank in the hand, normalized by the number of unique ranks.
# Usefulness: Helps identify evenly spaced or highly gapped hands. A low value indicates straights, while higher values suggest dispersed ranks like pairs and full houses.
df['sequential_rank_gaps'] = (df[['V2', 'V4', 'V6', 'V8', 'V10']].max(axis=1) - df[['V2', 'V4', 'V6', 'V8', 'V10']].min(axis=1)) / df['unique_ranks_count']
end

python
# suit_entropy
# Feature description: Computes the entropy of the suits in the hand, indicating the randomness or uniformity in suit distributions.
# Usefulness: Lower entropy values (closer to 0) suggest uniform suit distribution, hinting at flushes or straight flushes. Higher entropy values indicate diverse suits, which rule out flushes.
def entropy(series):
    value_counts = series.value_counts()
    probabilities = value_counts / value_counts.sum()
    return -np.sum(probabilities * np.log2(probabilities))
df['suit_entropy'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(entropy, axis=1)
end

