# pairwise_rank_difference
# Feature description: Computes pairwise rank differences for all combinations of cards.
# Usefulness: Highlights changes in ranks between cards, which is critical for detecting sequential patterns in straights or variations in rank distributions for pairs, two pairs, etc.
from itertools import combinations
diffs = []
for combo in combinations(['V2', 'V4', 'V6', 'V8', 'V10'], 2):
    diffs.append(abs(df[combo[0]] - df[combo[1]]))
df['pairwise_rank_difference'] = sum(diffs) / len(diffs)
end

