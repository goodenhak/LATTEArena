# Feature name: Distance_To_Hydrology_Magnitude
# Feature description: Calculates the Euclidean distance to the nearest hydrology feature using both horizontal and vertical distances.
# Usefulness: Combining horizontal and vertical distances to hydrology provides a better understanding of proximity to water sources in 3D space, which can significantly influence forest cover type. Areas closer to water sources may have a different vegetation profile due to moisture availability.
df['Distance_To_Hydrology_Magnitude'] = np.sqrt(df['Horizontal_Distance_To_Hydrology']2 + df['Vertical_Distance_To_Hydrology']2)
end

python
# Feature name: Hydrology_Elevation_Ratio
# Feature description: Calculates the ratio of Hydrology Effective Elevation to Distance_To_Hydrology_Magnitude, representing elevation gradient relative to water proximity.
# Usefulness: This feature highlights how elevation above the nearest hydrology feature interacts with the Euclidean water proximity, critical for vegetation and moisture retention dynamics.
df['Hydrology_Elevation_Ratio'] = df['Hydrology_Effective_Elevation'] / (df['Distance_To_Hydrology_Magnitude'] + 1e-6)
end

python
# Feature name: Road_Fire_Ratio_Normalized
# Feature description: Normalizes the Horizontal_Fire_Road_Ratio feature using min-max scaling, ensuring that the ratio values are bounded between 0 and 1.
# Usefulness: By normalizing fire-road proximity interactions, this feature improves interpretability and stability in model training while preserving the key proximity interplay information.
df['Road_Fire_Ratio_Normalized'] = (df['Horizontal_Fire_Road_Ratio'] - df['Horizontal_Fire_Road_Ratio'].min()) / (df['Horizontal_Fire_Road_Ratio'].max() - df['Horizontal_Fire_Road_Ratio'].min())
end

python
# Feature name: Soil_Water_Proximity_Interaction
# Feature description: Calculates the interaction between Soil_Type_Count and Distance_To_Hydrology_Magnitude.
# Usefulness: This feature combines soil richness and proximity to hydrology, both of which influence forest growth patterns. Rich soil near water sources could indicate denser vegetation or more resilient forest cover types.
df['Soil_Water_Proximity_Interaction'] = df['Soil_Type_Count'] * df['Distance_To_Hydrology_Magnitude']
end

python
# Feature name: Sunlight_Slope_Interaction
# Feature description: Combines Hillshade_Mean with slope steepness to assess the combined impact of sunlight exposure and terrain steepness on vegetation.
# Usefulness: Sunlight exposure and slope are critical factors influencing forest cover types. This feature will capture ecological gradients shaped by steep areas with high or low sunlight.
df['Sunlight_Slope_Interaction'] = df['Hillshade_Mean'] * df['Slope']
end

python
# Feature name: Terrain_Complexity_Index
# Feature description: Calculates the product of Slope, Aspect_sine, and Aspect_cosine, combining slope steepness and directional terrain variation.
# Usefulness: This feature provides a holistic measure of terrain irregularity, crucial for predicting forest cover type variation by incorporating directional and steepness effects.
df['Terrain_Complexity_Index'] = df['Slope'] * df['Aspect_sine'] * df['Aspect_cosine']
end

python
# Feature name: Vertical_Hillshade_Interaction
# Feature description: Computes the product of Vertical_Distance_To_Hydrology and Hillshade_Mean to capture how elevation differences near water sources interact with sunlight exposure.
# Usefulness: This feature is particularly useful for understanding vegetation profiles where the interaction between vertical hydrology distance and sunlight greatly impacts the forest cover.
df['Vertical_Hillshade_Interaction'] = df['Vertical_Distance_To_Hydrology'] * df['Hillshade_Mean']
end

