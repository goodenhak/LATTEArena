# Feature name: Hydrology_Slope_Interaction
# Feature description: Combines hydrology vertical distance and slope to capture terrain interactions near water sources.
# Usefulness: This feature encapsulates the influence of slope steepness on water interaction. Areas with steep slopes near water sources can significantly affect forest type via runoff, soil erosion, and access to water.
df['Hydrology_Slope_Interaction'] = df['Vertical_Distance_To_Hydrology'] * df['Slope']
end

python
# Feature name: Proximity_Weighted_By_Elevation
# Feature description: Calculates the weighted sum of road, fire, and hydrology distances scaled by elevation.
# Usefulness: This feature accounts for elevation gradients while aggregating distances to key ecological factors. Combining these metrics provides a holistic view of accessibility and terrain elevation's influence on forest properties.
df['Proximity_Weighted_By_Elevation'] = (
    df['Horizontal_Distance_To_Hydrology']
    + df['Horizontal_Distance_To_Fire_Points']
    + df['Horizontal_Distance_To_Roadways']
) * df['Elevation']
end

python
# Feature name: Sunny_Area_Density
# Feature description: Calculates the product of Hillshade_Mean (sunlight exposure) and slope steepness, offering insight into terrain's ecological density.
# Usefulness: This is helpful in capturing areas that are sunny and steep where specific types of vegetation thrive due to increased sunlight and slope effects.
df['Sunny_Area_Density'] = df['Hillshade_Mean'] * df['Slope']
end

python
# Feature name: Soil_Scaled_Elevation
# Feature description: Combines Elevation with Soil_Type_Count by calculating their ratio to scale elevation by soil richness.
# Usefulness: Helps understand how soil type diversity interacts with elevation. Areas with richer soils at specific elevations may favor particular forest cover types.
df['Soil_Scaled_Elevation'] = df['Elevation'] / (df['Soil_Type_Count'] + 1e-6)
end

python
# Feature name: Hydrology_Elevation_Slope_Ratio
# Feature description: Calculates the ratio of Hydrology Effective Elevation to Slope, capturing the interplay of water-related elevation impact on sloped terrains.
# Usefulness: This feature highlights the interaction between elevation above water sources and slope steepness, both of which are critical for vegetation distribution and water flow dynamics.
df['Hydrology_Elevation_Slope_Ratio'] = df['Hydrology_Effective_Elevation'] / (df['Slope'] + 1e-6)
end

python
# Feature name: Compactness_Index
# Feature description: Ratio of Horizontal_Distance_To_Hydrology to Vertical_Distance_To_Hydrology, capturing the steepness factor and hydrological proximity.
# Usefulness: This feature captures the compactness of the hydrological interaction, offering clues about water drainage patterns that significantly correlate with forest cover types.
df['Compactness_Index'] = df['Horizontal_Distance_To_Hydrology'] / (abs(df['Vertical_Distance_To_Hydrology']) + 1e-6)
end

python
# Feature name: Sunlight_Exposure_Std
# Feature description: Standard deviation of sunlight exposure at 9am, noon, and 3pm across the terrain.
# Usefulness: A high standard deviation indicates more varied sunlight exposure throughout the day, which can impact temperature and vegetation growth patterns.
df['Sunlight_Exposure_Std'] = df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].std(axis=1)
end

python
# Feature name: Aspect_Terrain_Index
# Feature description: Combines slope with directional data from Aspect_sine and Aspect_cosine to capture terrain profile variations.
# Usefulness: This feature emphasizes the influence of terrain orientation in combination with steepness, vital for understanding microclimatic effects on forest types.
df['Aspect_Terrain_Index'] = df['Slope'] * (df['Aspect_sine'] + df['Aspect_cosine'])
end

python
# Feature name: Fire_Hillshade_Ratio
# Feature description: Ratio of Horizontal_Distance_To_Fire_Points to Hillshade_Mean to reflect the interaction of fire proximity with sunlight exposure.
# Usefulness: This feature captures fire risk conditions, as areas closer to fire ignition points with high sunlight exposure tend to have higher susceptibility to forest type changes.
df['Fire_Hillshade_Ratio'] = df['Horizontal_Distance_To_Fire_Points'] / (df['Hillshade_Mean'] + 1e-6)
end
