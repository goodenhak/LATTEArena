python
# Feature name: Elevation_Binned
# Feature description: Bins the Elevation into discrete categories based on quartiles (Q1, Median, Q3).
df['Elevation_Binned'] = pd.cut(df['Elevation'], bins=[2142, 2898, 3037, 3178, 3679], labels=['Low', 'Medium-Low', 'Medium-High', 'High'])
# Usefulness: Forest cover types can vary across elevation bands. Binning Elevation allows the model to learn patterns in discrete categories, which may align better with ecological thresholds or vegetation zones than raw numerical values.
end

python
# Feature name: Distance_To_Hydrology_Ratio
# Feature description: Calculates the ratio of Horizontal_Distance_To_Hydrology to Vertical_Distance_To_Hydrology.
df['Distance_To_Hydrology_Ratio'] = df['Horizontal_Distance_To_Hydrology'] / (df['Vertical_Distance_To_Hydrology'] + 1)  # Adding 1 to prevent division by zero
# Usefulness: This feature captures the relative importance of horizontal vs. vertical proximity to hydrology, revealing terrain-water interactions that impact forest cover patterns, such as slope-driven water flow to lower elevations.
end

python
# Feature name: Wilderness_Area_Encoded
# Feature description: Encodes the four Wilderness_Area indicators as a single categorical feature.
df['Wilderness_Area_Encoded'] = (df[['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3', 'Wilderness_Area4']]
                                 .idxmax(axis=1)
                                 .str.extract('(\d+)').astype(int).replace(0, np.nan).fillna(0).astype(int))
# Usefulness: Encoding Wilderness Areas into a single categorical variable reduces sparsity and consolidates information, allowing models to better utilize wilderness area distinctions in relation to the target variable.
end

