# Explanation why the column Aspect is dropped
df.drop(columns=['Aspect'], inplace=True)
# Raw aspect values may be challenging for the model to use directly due to their non-linear nature (e.g., 0 degrees is close to 360 degrees). Aspect can be replaced by engineered features like cosine and sine transformations, which better capture circular relationships.
end
python
# Feature name: Relative_Elevation_By_Hydrology
# Feature description: Calculates the ratio of Vertical_Distance_To_Hydrology to Elevation.
# Usefulness: This feature captures how the elevation difference relative to hydrology influences vegetation patterns, as areas near or far from water sources at different elevations may exhibit distinct forest cover types.
df['Relative_Elevation_By_Hydrology'] = df['Vertical_Distance_To_Hydrology'] / (df['Elevation'] + 1)  # Adding 1 to avoid division by zero
end

python
# Feature name: Combined_Horizontal_Distance
# Feature description: Sums the Horizontal_Distance_To_Roadways, Horizontal_Distance_To_Hydrology, and Horizontal_Distance_To_Fire_Points.
# Usefulness: This consolidated feature captures the overall remoteness or centrality of a cell, which could be a significant factor in determining vegetation patterns and forest cover.
df['Combined_Horizontal_Distance'] = (
    df['Horizontal_Distance_To_Roadways'] + 
    df['Horizontal_Distance_To_Hydrology'] + 
    df['Horizontal_Distance_To_Fire_Points']
)
end

python
# Feature name: Sine_of_Aspect
# Feature description: Applies a sine transformation on Aspect (not listed here, but generally required for terrain data).
# Usefulness: Aspect values are directional and circular (e.g., 0 and 360 represent the same direction). The sine transformation captures terrain exposure relative to the sun position, which influences sunlight and vegetation growth.
df['Sine_of_Aspect'] = np.sin(np.radians(df['Aspect']))
end

