# Feature name: Age_Category_Accident_Severity_Interaction
# Feature description: Multiply Driver_Age_Category (numeric encoded as {young: 1, middle-aged: 2, senior: 3}) and Accident_Severity_Factor.
# Usefulness: This feature captures the interaction between driver age group and accident severity. Different age groups may exhibit distinct driving behaviors, risk tolerances, and accident outcomes, potentially revealing gender-related patterns.
age_category_mapping = {'young': 1, 'middle-aged': 2, 'senior': 3}
df['Age_Category_Encoded'] = df['Driver_Age_Category'].map(age_category_mapping)
df['Age_Category_Accident_Severity_Interaction'] = df['Age_Category_Encoded'] * df['Accident_Severity_Factor']
df.drop(columns=['Age_Category_Encoded'], inplace=True)
end  

Step 2: Standardize Engine Capacity  
python
# Feature name: Standardized_Engine_Capacity
# Feature description: Z-score normalization of Engine_Capacity_(CC).
# Usefulness: Normalizing engine capacity ensures that models focus on relative differences rather than absolute values, reducing sensitivity to extreme outliers. It simplifies learning patterns about vehicle preferences among genders.
mean_engine_capacity = df['Engine_Capacity_(CC)'].mean()
std_engine_capacity = df['Engine_Capacity_(CC)'].std()
df['Standardized_Engine_Capacity'] = (df['Engine_Capacity_(CC)'] - mean_engine_capacity) / std_engine_capacity
end  

Step 3: Create Driver Age and Urban/Rural Area Interaction  
python
# Feature name: Driver_Age_Urban_Rural_Interaction
# Feature description: Multiply Age_of_Driver by Urban_or_Rural_Area.
