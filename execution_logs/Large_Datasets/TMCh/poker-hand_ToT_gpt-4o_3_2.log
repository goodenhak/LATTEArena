# Feature name
df['consecutive_rank_count'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda row: len([i for i in range(min(row), max(row)) if i in row]),
    axis=1
)

# Feature description
# Measures the number of consecutive ranks present in the hand.

# Usefulness:
# Key for detecting hands like Straight, Straight Flush, and Royal Flush, which require consecutively ranked cards. A high consecutive rank count directly correlates with the likelihood of these hands.
end


