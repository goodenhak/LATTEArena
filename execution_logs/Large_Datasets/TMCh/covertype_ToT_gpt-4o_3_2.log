python
# Step 1: Hillshade_Mean
# Feature description: Calculate the mean of the three Hillshade features (Hillshade_9am, Hillshade_Noon, Hillshade_3pm)
# Usefulness: This provides a single summary feature representing the general amount of sunlight received throughout the day. Certain forest cover types may thrive under specific lighting conditions.

df['Hillshade_Mean'] = (df['Hillshade_9am'] + df['Hillshade_Noon'] + df['Hillshade_3pm']) / 3
end

python
# Step 2: Slope_To_Hydrology
# Feature description: Calculate the tangent of the slope between the point and the nearest water body using Vertical_Distance_To_Hydrology and Horizontal_Distance_To_Hydrology.
# Usefulness: This feature captures the terrain's steepness relative to water, which might indicate how water drains or collects in the area, influencing forest type.

df['Slope_To_Hydrology'] = np.arctan(df['Vertical_Distance_To_Hydrology'] / (df['Horizontal_Distance_To_Hydrology'] + 1e-6))
end

python
# Step 3: Road_Fire_Dist_Ratio
