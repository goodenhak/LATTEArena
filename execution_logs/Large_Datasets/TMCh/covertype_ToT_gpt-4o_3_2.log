df.drop(columns=['Soil_Type14'], inplace=True)
end

python
# Explanation why the column 'Soil_Type37' is dropped
# Reason: Similar to 'Soil_Type5' and 'Soil_Type14', 'Soil_Type37' contains no variation (all zero values). Removing such features reduces noise in the dataset.
df.drop(columns=['Soil_Type37'], inplace=True)
end
python
# Elevation_To_Road_Dist_Ratio
# Feature description: Calculate the ratio of Elevation to Horizontal_Distance_To_Roadways. This measures how elevation compares to the proximity to roads, which could relate to human activity and accessibility.
# Usefulness: Certain forest cover types may be associated with higher or lower elevations relative to roads, as roads might influence forest management or favor certain vegetation types.
df['Elevation_To_Road_Dist_Ratio'] = df['Elevation'] / (df['Horizontal_Distance_To_Roadways'] + 1e-6)
end

python
# Fire_Water_Dist_Ratio
# Feature description: Calculate the ratio of Horizontal_Distance_To_Fire_Points to Horizontal_Distance_To_Hydrology. This measures how close a cell is to potential wildfire activity relative to water sources.
# Usefulness: Proximity to water can reduce fire susceptibility or influence post-fire recovery, which in turn might affect forest cover type distribution.
df['Fire_Water_Dist_Ratio'] = df['Horizontal_Distance_To_Fire_Points'] / (df['Horizontal_Distance_To_Hydrology'] + 1e-6)
end

python
# Hillshade_Std
# Feature description: Calculate the standard deviation of Hillshade_9am, Hillshade_Noon, and Hillshade_3pm to reflect variability in sunlight exposure throughout the day.
# Usefulness: Forest cover types may thrive in areas with consistent or variable light exposure, making this a meaningful feature to distinguish between cover types.
df['Hillshade_Std'] = df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].std(axis=1)
end

