# Usefulness: This feature reflects the relative positioning of terrain elevation compared to nearby water sources. It highlights terrain moisture availability and microclimates affecting forest types.
df['Elevation_Hydrology_Diff_Ratio'] = abs(df['Vertical_Distance_To_Hydrology']) / (df['Elevation_diff_Hydrology'] + 1e-6)  # Add small value to avoid division by zero
end

### Step 2: Road_Hydrology_Proximity_Ratio
python
# Road_Hydrology_Proximity_Ratio
# Feature description: Calculate the ratio of Horizontal_Distance_To_Roadways to Horizontal_Distance_To_Hydrology.
# Usefulness: This captures the trade-off between proximity to human infrastructure (roads) and natural water sources. Areas closer to one versus the other may indicate different forest management or natural conditions.
df['Road_Hydrology_Proximity_Ratio'] = df['Horizontal_Distance_To_Roadways'] / (df['Horizontal_Distance_To_Hydrology'] + 1e-6)  # Add small value to avoid division by zero
end

### Step 3: Total_Hillshade_Variation
python
# Total_Hillshade_Variation
# Feature description: Calculate the total variation in sunlight exposure as the sum of absolute differences between Hillshade_9am, Hillshade_Noon, and Hillshade_3pm.
# Usefulness: This feature provides a measure of sunlight variability throughout the day, which influences vegetation patterns and forest types adapted to different light conditions.
df['Total_Hillshade_Variation'] = abs(df['Hillshade_9am'] - df['Hillshade_Noon']) + abs(df['Hillshade_Noon'] - df['Hillshade_3pm']) + abs(df['Hillshade_9am'] - df['Hillshade_3pm'])
end

