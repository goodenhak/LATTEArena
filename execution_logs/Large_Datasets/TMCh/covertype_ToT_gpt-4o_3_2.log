### Step 3: Combined_Hillshade_Average
python
# Combined_Hillshade_Average
# Feature description: Calculates the average of Hillshade_9am, Hillshade_Noon, and Hillshade_3pm to capture overall sunlight exposure throughout the day.
# Usefulness: Forest types are influenced by daily sunlight exposure. This feature simplifies the representation of light intensity while retaining its predictive power for vegetation growth and microclimate conditions.
df['Combined_Hillshade_Average'] = (df['Hillshade_9am'] + df['Hillshade_Noon'] + df['Hillshade_3pm']) / 3
end

