# Elevation_To_Hydrology_Combined_Ratio
# Feature description: Compute the ratio of Elevation to the Euclidean distance to the nearest hydrology feature.
# Usefulness: This combines elevation and proximity to water sources to quantify how elevation interacts with both horizontal and vertical distances to hydrology, which impacts soil moisture and vegetation growth.
df['Elevation_To_Hydrology_Combined_Ratio'] = df['Elevation'] / (np.sqrt(df['Horizontal_Distance_To_Hydrology']2 + df['Vertical_Distance_To_Hydrology']2) + 1e-6)
end

