# Usefulness: This feature captures the relationship between human activity (roads) and wildfire proximity, which might provide insights into forest cover based on fire susceptibility and human influence.

df['Road_Fire_Dist_Ratio'] = df['Horizontal_Distance_To_Roadways'] / (df['Horizontal_Distance_To_Fire_Points'] + 1e-6)
end

