2026-05-14 06:41:15,200 - INFO - ops_string = ["# Age_Difference_Driver_vs_Casualty\n# The absolute difference between the driver's age and the casualty's age.\n# Usefulness: This captures potential relationships between the driver and casualty, such as similarities in age, which could correlate with their sex based on shared activities or environment.\ndf['Age_Difference_Driver_vs_Casualty'] = abs(df['Age_of_Driver'] - df['Age_of_Casualty'])", "# Vehicle_Type_Squared\n# Squared value of the Vehicle_Type feature.\n# Usefulness: Nonlinear transformations like squaring often capture relationships that are otherwise missed in models.\ndf['Vehicle_Type_Squared'] = df['Vehicle_Type']  2", "# Engine_Capacity_Ratio\n# Ratio of Engine_Capacity_(CC) to Vehicle_Type.\n# Usefulness: This provides an informative feature about the vehicle's engine relative to its type, and may influence driver demographics.\ndf['Engine_Capacity_Ratio'] = df['Engine_Capacity_(CC)'] / df['Vehicle_Type']", "# Age_of_Driver_Binned\n# Discretized bins for Age_of_Driver into 5 categories.\n# Usefulness: Binning the age can make the model more robust to small variations and potentially find significant age group patterns for sex prediction.\ndf['Age_of_Driver_Binned'] = pd.cut(df['Age_of_Driver'], bins=[0, 20, 40, 60, 80, 100], labels=['0-20', '21-40', '41-60', '61-80', '81-100'])", "# Urban_and_EngineCapacity\n# Cross feature between Urban_or_Rural_Area and Engine_Capacity_(CC).\n# Usefulness: Certain engine types might be more common in urban or rural areas, and this could influence the distributions of male vs female drivers.\ndf['Urban_and_EngineCapacity'] = df['Urban_or_Rural_Area'].astype(str) + _ + pd.qcut(df['Engine_Capacity_(CC)'], q=4).astype(str)", "# Driver_to_Casualty_Ratio\n# Ratio of Age_of_Driver to Age_of_Casualty.\n# Usefulness: This captures the relative ages of the driver and casualty, potentially highlighting relationships or risk factors.\ndf['Driver_to_Casualty_Ratio'] = df['Age_of_Driver'] / (df['Age_of_Casualty'] + 1)  # Add 1 to avoid division by zero", "# Interaction_Sex_of_Casualty_and_Casualty_Type\n# Interaction feature between Sex_of_Casualty and Casualty_Type.\n# Usefulness: Casualty types (e.g., pedestrian vs vehicle passenger) could interact with the sex of the casualty to infer patterns that help predict the driver's sex.\ndf['Interaction_Sex_of_Casualty_and_Casualty_Type'] = df['Sex_of_Casualty'].astype(str) + _ + df['Casualty_Type'].astype(str)", "# Police_Force_Frequency\n# Frequency encoding of Police_Force based on the dataset distribution.\n# Usefulness: Certain police forces or jurisdictions could correlate with the sex distribution of drivers based on cultural or demographic factors.\npolice_force_freq = df['Police_Force'].value_counts(normalize=True)\ndf['Police_Force_Frequency'] = df['Police_Force'].map(police_force_freq)", "# Vehicle_Manoeuvre_OneHot\n# One-hot encoding for Vehicle_Manoeuvre.\n# Usefulness: Strategy of vehicle maneuvers (e.g., turning, stopping) may systematically vary between male and female drivers based on driving style.\ndf = pd.get_dummies(df, columns=['Vehicle_Manoeuvre'], prefix='Manoeuvre')", "# Vehicle_Age_Group\n# Binned Age_of_Vehicle into categorical age groups.\n# Usefulness: Vehicle age might be a proxy for socioeconomic status, which can correlate with driver sex.\ndf['Vehicle_Age_Group'] = pd.cut(df['Age_of_Vehicle'], bins=[-1, 5, 10, 20, 100], labels=['0-5', '6-10', '11-20', '21+'])", "# Injury_Severity_Proxy\n# Multiply Number_of_Casualties by Casualty_IMD_Decile.\n# Usefulness: Accidents involving multiple casualties and lower socioeconomic deciles may correlate with particular driving behaviors linked to driver sex.\ndf['Injury_Severity_Proxy'] = df['Number_of_Casualties'] * df['Casualty_IMD_Decile']", "# Age_Normalized_Per_Region\n# Z-score normalization of Age_of_Driver within each Local_Authority_(District).\n# Usefulness: By normalizing age within regions, we can account for regional age distributions that might confound sex predictions.\ndf['Age_Normalized_Per_Region'] = df.groupby('Local_Authority_(District)')['Age_of_Driver'].transform(lambda x: (x - x.mean()) / x.std())", "# Remove redundant features\n# Dropping columns unlikely to add unique predictive value given feature engineering or due to being near-zero variance.\ndf.drop(columns=['Vehicle_Reference_df_res', 'Vehicle_Location-Restricted_Lane', \n                 'Hit_Object_in_Carriageway', 'Hit_Object_off_Carriageway', \n                 'Pedestrian_Location', 'Pedestrian_Movement'], inplace=True)"]
