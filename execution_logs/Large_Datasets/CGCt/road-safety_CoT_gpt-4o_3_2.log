# Added Features

# 1. Vehicle_Type_Squared
# The squared value of Vehicle_Type feature.
# Usefulness: Nonlinear transformations like squaring often capture complex relationships that may influence the target variable not visible from the initial feature alone.
df['Vehicle_Type_Squared'] = df['Vehicle_Type']  2

# 2. Urban_and_EngineCapacity
# Cross feature between Urban_or_Rural_Area and binned Engine_Capacity_(CC) into quartiles.
# Usefulness: Certain engine types might be more common in urban or rural areas, potentially influencing distributions of male versus female drivers.
df['Urban_and_EngineCapacity'] = df['Urban_or_Rural_Area'].astype(str) + _ + pd.qcut(df['Engine_Capacity_(CC)'], q=4).astype(str)

# 3. Interaction_Sex_of_Casualty_and_Casualty_Type
# Interaction feature between Sex_of_Casualty and Casualty_Type.
# Usefulness: Some casualty types (e.g., pedestrian or passenger) might associate differently with driver sex.
df['Interaction_Sex_of_Casualty_and_Casualty_Type'] = df['Sex_of_Casualty'].astype(str) + _ + df['Casualty_Type'].astype(str)

# 4. Police_Force_Frequency
# Frequency encoding of Police_Force based on the dataset distribution.
# Usefulness: Regional differences in driver demographics can influence the sex distributions through cultural norms and demographics.
police_force_freq = df['Police_Force'].value_counts(normalize=True)
df['Police_Force_Frequency'] = df['Police_Force'].map(police_force_freq)

# 5. Vehicle_Manoeuvre_OneHot
# One-hot encoding of Maneuvre columns into single vectorized indicators.
# Usefulness: Specific vehicle maneuvers (e.g., turning left, driving forward, etc.) may vary between male and female drivers based on distinct driving behaviors.
df = pd.get_dummies(df, columns=['Vehicle_Manoeuvre'], prefix='Manoeuvre')

# 6. Age_of_Driver_Binned
# Discretized bins for Age_of_Driver into defined categories.
# Usefulness: Simplifies the feature into broad categories to highlight distinct age-based behavioral trends potentially correlating with the driver’s sex.
df['Age_of_Driver_Binned'] = pd.cut(df['Age_of_Driver'], bins=[0, 20, 40, 60, 80, 100], labels=['0-20', '21-40', '41-60', '61-80', '81-100'])

# 7. Injury_Severity_Proxy
# Multiply Number_of_Casualties by Casualty_IMD_Decile.
# Usefulness: Captures accident severity, highlighting correlations with likely driver behaviors, strongly tied to demographics like gender.
df['Injury_Severity_Proxy'] = df['Number_of_Casualties'] * df['Casualty_IMD_Decile']

# 8. Age_Normalized_Per_Region
# Z-score normalization of Age_of_Driver within each Local_Authority_(District).
# Usefulness: Accounts for regional variations in age distributions that could confound predictions.
df['Age_Normalized_Per_Region'] = df.groupby('Local_Authority_(District)')['Age_of_Driver'].transform(lambda x: (x - x.mean()) / x.std())

# 9. Driver_to_Casualty_Ratio_Normalized
# Normalized ratio of driver and casualty ages for greater robustness.
# Usefulness: The relative age relationship between driver and casualty might impact driving behaviors and choices, linked with sex.
df['Driver_to_Casualty_Ratio_Normalized'] = df['Age_of_Driver'] / (df['Age_of_Casualty'] + 1)

# Dropping Redundant Features
# Dropping columns unlikely to add unique predictive value (low variance, redundancy, irrelevant).
df.drop(columns=[
    'Casualty_Reference', 
    'Vehicle_Reference_df', 
    'Police_Force', 
    '2nd_Road_Number', 
    'Sex_of_Casualty'
], inplace=True)
end
