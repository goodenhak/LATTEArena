# Age_Difference_Driver_vs_Casualty
# The absolute difference between the driver's age and the casualty's age. 
# Usefulness: This captures potential relationships between the driver and casualty, such as similarities in age, which could correlate with their sex based on shared activities or environment.
df['Age_Difference_Driver_vs_Casualty'] = abs(df['Age_of_Driver'] - df['Age_of_Casualty'])
end

python
# Vehicle_Type_Squared
# Squared value of the Vehicle_Type feature.
# Usefulness: Nonlinear transformations like squaring often capture relationships that are otherwise missed in models.
df['Vehicle_Type_Squared'] = df['Vehicle_Type']  2
end

python
# Engine_Capacity_Ratio
# Ratio of Engine_Capacity_(CC) to Vehicle_Type.
# Usefulness: This provides an informative feature about the vehicle's engine relative to its type, which may influence driver demographics.
df['Engine_Capacity_Ratio'] = df['Engine_Capacity_(CC)'] / df['Vehicle_Type']
end

python
# Age_of_Driver_Binned
# Discretized bins for Age_of_Driver into 5 categories.
# Usefulness: Binning the age can make the model more robust to small variations and potentially find significant age group patterns for sex prediction.
df['Age_of_Driver_Binned'] = pd.cut(df['Age_of_Driver'], bins=[0, 20, 40, 60, 80, 100], labels=['0-20', '21-40', '41-60', '61-80', '81-100'])
end

python
# Urban_and_EngineCapacity
# Cross feature between Urban_or_Rural_Area and Engine_Capacity_(CC).
# Usefulness: Certain engine types might be more common in urban or rural areas, influencing distribution of male vs female drivers. 
df['Urban_and_EngineCapacity'] = df['Urban_or_Rural_Area'].astype(str) + '_' + pd.qcut(df['Engine_Capacity_(CC)'], q=4, labels=['Low', 'Medium', 'High', 'Very High']).astype(str)
end

python
# Driver_to_Casualty_Ratio
# Ratio of Age_of_Driver to Age_of_Casualty.
# Usefulness: This captures the relative ages of the driver and casualty, highlighting patterns or risk factors in prediction.
df['Driver_to_Casualty_Ratio'] = df['Age_of_Driver'] / (df['Age_of_Casualty'] + 1)  # Add 1 to avoid division by zero
end

python
# Interaction_Sex_of_Casualty_and_Casualty_Type
# Interaction feature between Sex_of_Casualty and Casualty_Type.
# Usefulness: Casualty types (e.g., pedestrian vs vehicle passenger) may interact with the casualty's sex, offering insights on driver prediction.
df['Interaction_Sex_of_Casualty_and_Casualty_Type'] = df['Sex_of_Casualty'].astype(str) + '_' + df['Casualty_Type'].astype(str)
end

python
# Police_Force_Frequency
# Frequency encoding of Police_Force based on dataset distribution.
# Usefulness: Certain police forces/jurisdictions correlate with sex distribution of drivers due to cultural or demographic factors.
police_force_freq = df['Police_Force'].value_counts(normalize=True)
df['Police_Force_Frequency'] = df['Police_Force'].map(police_force_freq)
end

python
# Vehicle_Manoeuvre_OneHot
# One-hot encoding for Vehicle_Manoeuvre.
# Usefulness: Driving maneuvers may vary systematically between male and female drivers due to behavioral differences.
df = pd.get_dummies(df, columns=['Vehicle_Manoeuvre'], prefix='Manoeuvre')
end

python
# Vehicle_Age_Group
# Binned Age_of_Vehicle into categorical age groups.
# Usefulness: Vehicle age might be a proxy for socioeconomic status, influencing driver sex distribution.
df['Vehicle_Age_Group'] = pd.cut(df['Age_of_Vehicle'], bins=[-1, 5, 10, 20, 100], labels=['0-5', '6-10', '11-20', '21+'])
end

python
# Injury_Severity_Proxy
# Multiply Number_of_Casualties by Casualty_IMD_Decile.
# Usefulness: Accidents involving multiple casualties and low socioeconomic deciles may correlate to driving behavior linked to driver sex.
df['Injury_Severity_Proxy'] = df['Number_of_Casualties'] * df['Casualty_IMD_Decile']
end

python
# Age_Normalized_Per_Region
# Z-score normalization of Age_of_Driver within each Local_Authority_(District).
# Usefulness: Normalizing age within regions accounts for regional differences in demographics tied to sex prediction.
df['Age_Normalized_Per_Region'] = df.groupby('Local_Authority_(District)')['Age_of_Driver'].transform(lambda x: (x - x.mean()) / x.std())
end

python
# Remove redundant features
# Dropping columns unlikely to add unique predictive value or are near-zero variance features.
df.drop(columns=[
