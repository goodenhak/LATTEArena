# Usefulness: Highlights interactions between the bio-demographic factors of the casualty and casualty type, which may indirectly inform about the driver.
df['Age_Sex_Casualty_Interaction'] = df['Age_Band_of_Casualty'].astype(str) + _ + df['Sex_of_Casualty'].astype(str) + _ + df['Casualty_Type'].astype(str)
end

python
# Manoeuvre_Action_Group
# Combination of one-hot encoded vehicle maneuvers into a single categorical feature.
# Usefulness: A summarized feature for maneuvers to avoid high-cardinality from one-hot encoding while retaining movement-related predictive signals.
manoeuvre_cols = [col for col in df if col.startswith('Manoeuvre_')]
df['Manoeuvre_Action_Group'] = df[manoeuvre_cols].idxmax(axis=1).str.replace('Manoeuvre_', '')
df.drop(columns=manoeuvre_cols, inplace=True)
end

python
# Simplified_Longitude_Latitude
# Simplified geographic region based on median categorization of longitude and latitude.
# Usefulness: Helps divide geographic areas into quadrants or regions, potentially correlating with driver demographics.
df['Simplified_Longitude_Latitude'] = pd.cut(df['Longitude'], bins=2, labels=[West, East]).astype(str) + _ + pd.cut(df['Latitude'], bins=2, labels=[South, North]).astype(str)
end

python
# Driver_Centric_Injury_Proxy
# Product of Injury_Severity_Proxy and Driver_to_Casualty_Ratio.
# Usefulness: Emphasizes injuries where the driver-to-casualty age ratio impacts the severity, indicating indirect but complex behavior or demographics.
df['Driver_Centric_Injury_Proxy'] = df['Injury_Severity_Proxy'] * df['Driver_to_Casualty_Ratio']
end

python
# Propulsion_Code_Grouped
# Binning of Propulsion_Code into categorical ranges.
# Usefulness: Reduces the granularity of Propulsion_Code, grouping them into broader categories for generalized predictive insights.
df['Propulsion_Category'] = pd.cut(df['Propulsion_Code'], bins=[0, 2, 5, 12], labels=['Low', 'Medium', 'High'])
end

python
# Simplified_Regional_Sex_Ratio
# Proxy based on combining Police_Force and Urban_or_Rural_Area interactions for demographic inferences.
# Usefulness: Merges jurisdiction and area type to understand macro patterns in male vs female driver distributions.
df['Simplified_Regional_Sex_Ratio'] = df['Police_Force_Frequency'] * df['Urban_or_Rural_Area']
end

python
# Removing redundant or noisy features
# Dropping features based on near-zero variance, redundancy, or irrelevant detail for prediction after adding engineered features.
df.drop(columns=['Vehicle_Reference_df', 'Casualty_Reference', '1st_Road_Number', '2nd_Road_Number', 
                 'Longitude', 'Latitude'], inplace=True)
end
