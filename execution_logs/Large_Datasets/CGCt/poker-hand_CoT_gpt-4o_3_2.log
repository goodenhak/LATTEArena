# Checks if all suits in the hand are the same (1 if they are the same, 0 otherwise)
# Usefulness: Useful for identifying a Flush, Straight Flush, or Royal Flush hands where all cards must share the same suit.
df['suit_same'] = (df['V1'] == df['V3']) & (df['V1'] == df['V5']) & (df['V1'] == df['V7']) & (df['V1'] == df['V9']).astype(int)
end

python
# rank_diff_max_min
# Difference between the maximum and minimum card ranks
# Usefulness: Helps detect ordered sequences like Straights, Straight Flushes, and Royal Flushes. A rank difference of 4 implies a straight in the absence of gaps.
df['rank_diff_max_min'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].max(axis=1) - df[['V2', 'V4', 'V6', 'V8', 'V10']].min(axis=1)
end

python
# rank_count
# Number of unique ranks in the hand
# Usefulness: Essential for identifying Full Houses, Four of a Kind, Three of a Kind, and Two Pairs, as these involve rank repetitions.
df['rank_count'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].nunique(axis=1)
end

python
# suit_count
# Number of unique suits in the hand
# Usefulness: Helps determine if a hand can potentially qualify as a Flush, Straight Flush, or Royal Flush, as these require all cards sharing the same suit.
df['suit_count'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].nunique(axis=1)
end

python
# rank_mode
# Mode of the rank values (the most frequently occurring rank)
# Usefulness: Detects hands involving repeated ranks like One Pair, Two Pairs, Three of a Kind, Four of a Kind, and Full House.
df['rank_mode'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: x.value_counts().idxmax(), axis=1)
end

python
# rank_mode_count
# Count of the most frequently occurring rank
# Usefulness: Complements rank_mode to determine the exact type of repetition, e.g., distinguishing between Three of a Kind and Four of a Kind.
df['rank_mode_count'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: x.value_counts().max(), axis=1)
end

python
# is_straight
# Checks if the hand is a Straight (sequence of five distinct ranks with no gaps)
# Usefulness: Directly identifies Straight, Straight Flush, and potentially Royal Flush hands.
sorted_ranks = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(sorted, axis=1)
df['is_straight'] = sorted_ranks.apply(lambda x: (x[4] - x[0] == 4) and len(set(x)) == 5).astype(int)
end

python
# is_royal_flush
# Checks if the hand is a Royal Flush (A, K, Q, J, 10 of the same suit)
# Usefulness: Directly identifies the Royal Flush, the highest-ranking poker hand.
df['is_royal_flush'] = df.apply(lambda row: set([row['V2'], row['V4'], row['V6'], row['V8'], row['V10']]) == {1, 10, 11, 12, 13} and row['suit_same'] == 1, axis=1).astype(int)
end

python
# rank_frequency_encoded
# Encodes the frequency of each rank across all ranks into a normalized set of values
# Usefulness: Captures the overall structure of rank repetitions within hands for classification tasks.
rank_cols = ['V2', 'V4', 'V6', 'V8', 'V10']
rank_freq = df[rank_cols].apply(pd.Series.value_counts).fillna(0)
rank_freq = (rank_freq.T / rank_freq.sum(axis=1)).T
for i, col in enumerate(rank_cols):
    df[f'rank_frequency_encoded_{i+1}'] = rank_freq.lookup(df[col], [i]*len(df[col]))
end

python
# remove_duplicate_suits_ranks
# Removes suit and rank columns with duplicate and redundant information
# Usefulness: Ensures that unnecessary duplication does not add noise to the model, thus optimizing model complexity.
df.drop(columns=['V1', 'V3', 'V5', 'V7', 'V9', 'V2', 'V4', 'V6', 'V8', 'V10'], inplace=True)
end
