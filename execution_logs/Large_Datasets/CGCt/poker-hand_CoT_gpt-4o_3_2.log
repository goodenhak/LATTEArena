# royal_flush_indicator
# Feature description: Indicates whether the hand qualifies as a Royal Flush.
# Usefulness: Directly helps identify the highest-ranking poker hand (Royal Flush), incorporating conditions for both sequential rank and uniform suit.
sorted_ranks = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(sorted, axis=1)
df['royal_flush_indicator'] = (
    sorted_ranks.apply(lambda x: x == [1, 10, 11, 12, 13]) &
    df['suit_same'] == 1
).astype(int)
end

python
# full_house_indicator
# Feature description: Indicates whether the hand qualifies as a Full House (three cards of one rank and two cards of another rank).
# Usefulness: Simplifies identification of Full House hands from rank distribution.
df['full_house_indicator'] = (
    df['rank_mode_count'] == 3 &
    df['rank_count'] == 2
).astype(int)
end

python
# four_of_a_kind_indicator
# Feature description: Indicates the presence of four cards of the same rank.
# Usefulness: Directly flags Four of a Kind hands, reducing processing requirements for downstream tasks.
df['four_of_a_kind_indicator'] = (
    df['rank_mode_count'] == 4
).astype(int)
end

python
# flush_and_straight_combined
# Feature description: Combines the flush and straight features to check if the hand is either a Straight Flush or Royal Flush.
# Usefulness: Reduces the complexity of evaluating these high-ranking hands by combining their defining attributes.
df['flush_and_straight_combined'] = (
    df['suit_same'] == 1 &
    df['is_straight'] == 1
).astype(int)
end

python
# two_pairs_indicator
# Feature description: Indicates the presence of Two Pairs (two distinct pairs of ranks among five cards).
# Usefulness: Simplifies detection of Two Pairs by leveraging unique rank count and mode frequency.
df['two_pairs_indicator'] = (
    df['rank_count'] == 3 &
    df['rank_mode_count'] == 2
).astype(int)
end

python
# rank_gaps_encoded
# Feature description: Encodes the pairwise gaps between card ranks into a fixed-length vector.
# Usefulness: Captures the spread and spacing between card ranks for tasks that may benefit from complex ordering information.
rank_cols_sorted = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(sorted, axis=1)
df['rank_gaps'] = rank_cols_sorted.apply(lambda x: [x[i+1] - x[i] for i in range(len(x)-1)], axis=1)
rank_gap_cols = ['rank_gap_1', 'rank_gap_2', 'rank_gap_3', 'rank_gap_4']
df[rank_gap_cols] = pd.DataFrame(df['rank_gaps'].tolist(), index=df.index)
df.drop(columns=['rank_gaps'], inplace=True)
end

python
# normalized_rank_diff
# Feature description: Normalizes the rank difference between the highest and lowest-ranked cards using Min-Max scaling.
# Usefulness: Places rank difference on a standardized scale to improve interpretability in models sensitive to feature scale.
rank_diff_min = 1
rank_diff_max = 12
df['normalized_rank_diff'] = (
    (df['rank_diff_max_min'] - rank_diff_min) / (rank_diff_max - rank_diff_min)
)
end

python
# zscore_rank_mode
# Feature description: Calculates the Z-score of the most frequent rank in each hand relative to its distribution.
# Usefulness: Standardizes rank mode for improved predictive performance with model algorithms sensitive to feature magnitude.
df['zscore_rank_mode'] = (
    df['rank_mode'] - 6.9949
) / 3.7417
end

python
# straight_flush_indicator
# Feature description: Indicates whether the hand qualifies as a Straight Flush (a sequence of ranks all in the same suit).
# Usefulness: Directly flags this high-ranking hand to facilitate downstream classification tasks.
df['straight_flush_indicator'] = (
    df['flush_and_straight_combined'] &
    (df['rank_diff_max_min'] == 4)
).astype(int)
end

python
# rank_count_normalized
# Feature description: Normalizes the rank count to a scale between 0 and 1.
# Usefulness: Provides standardized rank count values for models that perform better with normalized inputs.
rank_count_min = 2
rank_count_max = 5
df['rank_count_normalized'] = (
    (df['rank_count'] - rank_count_min) / (rank_count_max - rank_count_min)
)
end
