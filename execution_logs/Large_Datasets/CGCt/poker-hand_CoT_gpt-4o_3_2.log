da x: x.value_counts().max(), axis=1)", "# is_straight\\n# Checks if the hand is a Straight (sequence of five distinct ranks with no gaps)\\n# Usefulness: Directly identifies Straight, Straight Flush, and potentially Royal Flush hands.\\nsorted_ranks = df[[\'V2\', \'V4\', \'V6\', \'V8\', \'V10\']].apply(sorted, axis=1)\\ndf[\'is_straight\'] = sorted_ranks.apply(lambda x: (x[4] - x[0] == 4) and len(set(x)) == 5).astype(int)", "# is_royal_flush\\n# Checks if the hand is a Royal Flush (A, K, Q, J, 10 of the same suit)\\n# Usefulness: Directly identifies the Royal Flush, the highest-ranking poker hand.\\ndf[\'is_royal_flush\'] = df.apply(lambda row: set([row[\'V2\'], row[\'V4\'], row[\'V6\'], row[\'V8\'], row[\'V10\']]) == {1, 10, 11, 12, 13} and row[\'suit_same\'] == 1, axis=1).astype(int)", "# rank_frequency_encoded\\n# Encodes the frequency of each rank across all ranks into a normalized set of values\\n# Usefulness: Captures the overall structure of rank repetitions within hands for classification tasks.\\nrank_cols = [\'V2\', \'V4\', \'V6\', \'V8\', \'V10\']\\nrank_freq = df[rank_cols].apply(pd.Series.value_counts).fillna(0)\\nrank_freq = (rank_freq.T / rank_freq.sum(axis=1)).T\\nfor i, col in enumerate(rank_cols):\\n    df[f\'rank_frequency_encoded_{i+1}\'] = rank_freq.lookup(df[col], [i]*len(df[col]))", "# remove_duplicate_suits_ranks\\n# Removes suit and rank columns with duplicate and redundant information\\n# Usefulness: Ensures that unnecessary duplication does not add noise to the model, thus optimizing model complexity.\\ndf.drop(columns=[\'V1\', \'V3\', \'V5\', \'V7\', \'V9\', \'V2\', \'V4\', \'V6\', \'V8\', \'V10\'], inplace=True)"]'], score = 0.27162661827689494

