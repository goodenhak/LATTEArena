python
# rank_sum
# Sum of the ranks in the hand
# Usefulness: Helps distinguish hands with repeated ranks (e.g., Four of a Kind, Full House) versus sequential ranks (e.g., Straights), or unique ranks.
df['rank_sum'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].sum(axis=1)
end

python
# rank_squared_diff
# Sum of squared differences of ranks from their mode
# Usefulness: Captures the spread or dispersion of ranks relative to the mode, enabling identification of near-sequential or highly clustered ranks.
rank_mode_col = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: x.value_counts().idxmax(), axis=1)
df['rank_squared_diff'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda x: sum([(rank - rank_mode_col.iloc[x.name])  2 for rank in x]), axis=1
)
end

python
# suit_variance
# Variance of suit values in the hand
# Usefulness: Determines whether suits are homogeneous (variance = 0 in Flush, Royal Flush, Straight Flush) or heterogeneous across cards.
df['suit_variance'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(np.var, axis=1)
end

python
# high_card_presence
# Presence of high-ranking cards (Ace, King, Queen, Jack, Ten) in the hand (binary indicator, 1 if present, 0 otherwise)
# Usefulness: Identifies hands containing crucial high cards required for Royal Flush or hands with higher likelihood of success.
df['high_card_presence'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda x: int(any(card_rank in [1, 10, 11, 12, 13] for card_rank in x)), axis=1
)
end

python
# rank_gaps
# Sum of gaps between consecutive rank values sorted
# Usefulness: Detects hands with possible gaps (indicating non-straight patterns) or defines sequential rank behavior for straights.
sorted_ranks = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(sorted, axis=1)
df['rank_gaps'] = sorted_ranks.apply(
    lambda x: sum([x[i+1] - x[i] - 1 for i in range(len(x)-1)]), axis=1
)
end

python
# flush_strength
# Calculates the product of unique suits and ranks (rank_count * suit_count)
# Usefulness: Provides an aggregate measure of the hand strength in terms of suit and rank variety.
df['flush_strength'] = df['rank_count'] * df['suit_count']
end

python
# normalized_rank_mode_count
# Normalized count of the mode rank (rank_mode_count / rank_count)
# Usefulness: Differentiates hands based on the concentration of ranks without being skewed by the number of ranks.
df['normalized_rank_mode_count'] = df['rank_mode_count'] / df['rank_count']
end

python
# rank_product
# Product of all rank values in the hand
# Usefulness: Useful for identifying sequences, straights, and repeated ranks as such hands would have distinct rank-product patterns.
df['rank_product'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(np.prod, axis=1)
end

python
# alternating_color_pattern
# Checks for alternating suit colors (red-black pattern) in the hand (1 if pattern exists, 0 otherwise)
# Usefulness: Identifies hands that might exhibit structured suit color patterns relevant in specific Flush or non-Flush combinations.
RED_SUITS = [1, 2]  # Represent Hearts and Diamonds
BLACK_SUITS = [3, 4]  # Represent Clubs and Spades
df['alternating_color_pattern'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(
    lambda suits: int(
        all((suits[i] in RED_SUITS and suits[i+1] in BLACK_SUITS) or
            (suits[i] in BLACK_SUITS and suits[i+1] in RED_SUITS)
            for i in range(len(suits)-1))
    ), axis=1
)
end

python
df.drop(columns=['V1', 'V3', 'V5', 'V7', 'V9', 'V2', 'V4', 'V6', 'V8', 'V10'], inplace=True)
end

