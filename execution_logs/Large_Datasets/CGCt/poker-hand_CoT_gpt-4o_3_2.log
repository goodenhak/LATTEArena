python
# Feature: rank_mode_ratio
# Feature description: The proportion of the most frequent rank's occurrence out of the total number of cards in the hand.
# Usefulness: This helps to identify how dominant a rank is in the hand, which can support identifying combinations like Four of a Kind, Full House, or Three of a Kind.
df['rank_mode_ratio'] = df['rank_mode_count'] / 5
end

python
# Feature: is_four_of_a_kind
# Feature description: Checks if the hand includes four cards of the same rank.
# Usefulness: Directly identifies the Four of a Kind poker hand.
df['is_four_of_a_kind'] = (df['rank_mode_count'] == 4).astype(int)
end

python
# Feature: is_full_house
# Feature description: Checks if the hand includes three cards of one rank and two cards of another rank.
# Usefulness: Detects a Full House hand by ensuring rank_mode_count equals 3 and rank_count equals 2.
df['is_full_house'] = ((df['rank_mode_count'] == 3) & (df['rank_count'] == 2)).astype(int)
end

python
# Feature: is_three_of_a_kind
# Feature description: Checks if the hand includes three cards of the same rank and no full house exists.
# Usefulness: Directly identifies the Three of a Kind hand, excluding the possibility of a Full House.
df['is_three_of_a_kind'] = ((df['rank_mode_count'] == 3) & (df['rank_count'] > 2)).astype(int)
end

python
# Feature: is_two_pair
# Feature description: Checks if there are exactly two pairs of ranks in the hand.
# Usefulness: Directly identifies the Two Pairs hand where two pairs of identical ranks exist.
df['is_two_pair'] = ((df['rank_count'] == 3) & (df['rank_mode_count'] == 2)).astype(int)
end

python
# Feature: is_one_pair
# Feature description: Checks if there is exactly one pair of ranks in the hand.
# Usefulness: Directly identifies One Pair hands based on two identical ranks.
df['is_one_pair'] = ((df['rank_count'] == 4) & (df['rank_mode_count'] == 2)).astype(int)
end

python
# Feature: is_flush_but_not_straight
# Feature description: Checks if all suits are the same, but ranks are not sequential (not a straight).
# Usefulness: Helps distinguish a regular Flush hand from Straight Flush and Royal Flush.
df['is_flush_but_not_straight'] = ((df['suit_same'] == 1) & (df['is_straight'] == 0) & (df['rank_diff_max_min'] != 4)).astype(int)
end

python
# Feature: high_card_rank
# Feature description: The rank of the highest card in the hand.
# Usefulness: Useful as a fallback feature to identify the strongest card in High Card hands when no other pattern exists.
df['high_card_rank'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].max(axis=1)
end

python
# Feature: rank_gap_sum
# Feature description: The sum of differences between consecutive cards, when ranks are sorted.
# Usefulness: A low sum suggests an ordered hand (e.g., Straight, Straight Flush, Royal Flush) while higher sums indicate scattered ranks.
sorted_ranks = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(sorted, axis=1)
df['rank_gap_sum'] = sorted_ranks.apply(lambda x: sum([abs(x[i+1] - x[i]) for i in range(len(x) - 1)]))
end

python
# Feature: rank_cluster_count
# Feature description: This feature computes the number of clusters of ranks in a hand.
# Usefulness: Provides additional information about patterns within ranks, useful for identifying hands with grouped ranks (e.g., Full House, Three of a Kind).
def count_clusters(x):
    sorted_ranks = sorted(x)
    clusters = 1
    for i in range(1, len(sorted_ranks)):
        if sorted_ranks[i] != sorted_ranks[i-1]:
            clusters += 1
    return clusters

df['rank_cluster_count'] = df.apply(lambda row: count_clusters([row['V2'], row['V4'], row['V6'], row['V8'], row['V10']]), axis=1)
end

python
# Dropping redundant raw columns
# Removes the original card suit and rank columns, as the added features already summarize their properties.
# Usefulness: Prevents information leakage, reduces dimensionality, and eliminates unneeded data.
df.drop(columns=['V1', 'V2', 'V3', 'V4', 'V5', 'V6', 'V7', 'V8', 'V9', 'V10'], inplace=True)
end

