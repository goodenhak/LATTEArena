# suit_diff_sum
# Feature description: Calculate the total differences between suits in the hand.
# Usefulness: Useful to detect hands that are less likely to be a Flush, Straight Flush, or Royal Flush by quantifying suit diversity.
df['suit_diff_sum'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(lambda row: len(set(row)), axis=1)
end

python
# rank_diff_sum
# Feature description: Sum of absolute differences between consecutive ranks in a sorted hand.
# Usefulness: Helps capture the gap structure, aiding in identifying hands with sequential (or near-sequential) ranks, e.g., Straights and Straight Flushes.
sorted_ranks = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(sorted, axis=1)
df['rank_diff_sum'] = sorted_ranks.apply(lambda x: sum(abs(x[i] - x[i-1]) for i in range(1, len(x))))
end

python
# normalized_rank_diff_max_min
# Feature description: Normalize the rank difference (rank_diff_max_min) by the maximum card rank (13).
# Usefulness: Helps standardize comparisons by putting rank differences into a consistent 0-1 range, aiding downstream models.
df['normalized_rank_diff_max_min'] = df['rank_diff_max_min'] / 13
end

python
# is_smallest_straight
# Feature description: Checks if the ranks form the specific straight {A, 2, 3, 4, 5}.
# Usefulness: Captures a special case of Straights that skips the ordinal sequence due to Ace's dual role (1 and 14).
df['is_smallest_straight'] = df.apply(
    lambda row: set([row['V2'], row['V4'], row['V6'], row['V8'], row['V10']]) == {1, 2, 3, 4, 5}, axis=1
).astype(int)
end

python
# suit_rank_cross
# Feature description: Combine suit and rank information as a single unit.
# Usefulness: Captures the coupling of suit and rank, crucial for downstream tasks like identifying unique or special poker hands.
df['suit_rank_cross'] = df.apply(
    lambda row: '_'.join(f{row[f'V{i}']}_{row[f'V{i+1}']} for i in range(1, 10, 2)), axis=1
)
end

python
# suit_rank_ratio
# Feature description: Ratio of unique suits to unique ranks.
# Usefulness: Helps to differentiate between hands that balance diversity in suits and ranks, aiding in categorizing special hands.
df['suit_rank_ratio'] = df['suit_count'] / df['rank_count']
end

python
# rank_mode_zscore
# Feature description: Z-score normalization of the rank_mode feature.
# Usefulness: Standardizes the rank_mode value, enabling the model to meaningfully compare rank commonalities across hands.
df['rank_mode_zscore'] = (df['rank_mode'] - df['rank_mode'].mean()) / df['rank_mode'].std()
end

python
# is_potential_full_house
# Feature description: Checks if a hand might potentially form a Full House by having exactly 2 unique ranks and proper repetition frequency.
# Usefulness: Directly flags candidates for Full House classification, a critical step for simplifying downstream tasks.
df['is_potential_full_house'] = ((df['rank_count'] == 2) & ((df['rank_mode_count'] == 3) | (df['rank_mode_count'] == 2))).astype(int)
end

python
# pair_count
# Feature description: Number of pairs in the hand.
# Usefulness: Essential for classifying One Pair (1 pair), Two Pairs (2 pairs), or other combinations involving pairs.
df['pair_count'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda row: sum(val == 2 for val in row.value_counts().values), axis=1
)
end

python
# is_high_card
# Feature description: Checks if the hand is categorized as a High Card (no pairs, no sequential ranks, and not of the same suit).
# Usefulness: Flags hands with the lowest rank in Poker, helping the model understand baseline class probabilities.
df['is_high_card'] = ((df['rank_count'] == 5) & (df['suit_count'] > 1) & (df['rank_diff_max_min'] > 4)).astype(int)
end

python
df.drop(columns=['V1', 'V3', 'V5', 'V7', 'V9', 'V2', 'V4', 'V6', 'V8', 'V10'], inplace=True)
end
