df['rank_pair_count'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: sum(x.value_counts() == 2), axis=1)
end

python
# Feature: rank_triplet_count
# Feature description: Counts the number of rank triplets in the hand.
# Usefulness: Improves identification for Three of a Kind, Full House, and Four of a Kind by tallying groups of three identical ranks.
