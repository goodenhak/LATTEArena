# log_Engine_Capacity
# Log transformation of Engine_Capacity_(CC). Reduces skewness of engine capacity, making the feature more suitable for downstream predictive tasks.
# Usefulness: Large differences in Engine_Capacity can significantly affect driver decisions and might indirectly correlate with sex of the driver. Log transform helps scale this feature appropriately.
df['log_Engine_Capacity'] = df['Engine_Capacity_(CC)'].apply(lambda x: np.log(x + 1))
end

python
# Age_of_Driver_Binned
# Binning Age_of_Driver into categorical buckets (e.g., young, mid-age, senior) based on quartiles.
# Usefulness: Simplifies driver age variations and captures trends like younger or senior drivers potentially correlating with sex of driver.
df['Age_of_Driver_Binned'] = pd.cut(df['Age_of_Driver'], bins=[0, 27, 38, 51, 100], labels=['Young', 'Mid-Young', 'Mid-Old', 'Senior'], right=False)
end

python
# Vehicle_Manoeuvre_Simplified
# Grouping Vehicle_Manoeuvre into simplified categories (e.g., straight driving, turning, stationary).
# Usefulness: Simplifies the complex maneuver codes into meaningful groupings that can reveal broader behavioral differences.
df['Vehicle_Manoeuvre_Simplified'] = df['Vehicle_Manoeuvre'].replace({
    1: 'Stationary', 2: 'Stationary', 3: 'Turning', 4: 'Turning', 5: 'Straight Driving',
    6: 'Straight Driving', 7: 'Straight Driving', 8: 'Parking', 9: 'Parking',
    10: 'Avoiding', 11: 'Avoiding', 12: 'Other', 13: 'Other', 14: 'Other',
    15: 'Reversing', 16: 'U-Turn', 17: 'Changing Lanes', 18: 'Other'
})
end

python
# Speed_Engagement_Ratio
# Feature created as the ratio of Engine_Capacity_(CC) to Age_of_Vehicle.
# Usefulness: This captures the degree of vehicle performance relative to its age and maintenance history, which may be indirectly linked with a driver’s preferences or demographics.
df['Speed_Engagement_Ratio'] = df['Engine_Capacity_(CC)'] / (df['Age_of_Vehicle'] + 1)  # Adding 1 to avoid division by zero.
end

python
# Sex_of_Casualty_as_Driver_Proxy
# Use Sex_of_Casualty as a potential proxy or feature towards predicting Sex_of_Driver.
# Usefulness: There may be social or cultural correlations between the sex of a driver and casualties, making this a potentially useful feature.
df['Sex_of_Casualty_as_Driver_Proxy'] = df['Sex_of_Casualty']
end

python
# Urban_Area_Flag
# Binary flag feature indicating if the area is urban (1 for urban, 0 for rural).
# Usefulness: Differences in traffic behavior between urban and rural areas could indirectly correlate with driver demographics, including sex.
df['Urban_Area_Flag'] = df['Urban_or_Rural_Area'].apply(lambda x: 1 if x == 1 else 0)
end

python
# Age_and_Experience
# Interaction effect between Age_of_Driver and Age_of_Vehicle as Age_of_Driver / (Age_of_Vehicle + 1).
# Usefulness: Estimates the level of vehicle driving experience relative to the driver’s age, which may have useful gender-specific driving behavior implications.
df['Age_and_Experience'] = df['Age_of_Driver'] / (df['Age_of_Vehicle'] + 1)
end

python
# Latitude_Longitude_Interaction
# Feature representing an interaction between Latitude and Longitude (multiply).
# Usefulness: Captures location-related factors in terms of geography, which may affect region-specific driver demographics.
df['Latitude_Longitude_Interaction'] = df['Latitude'] * df['Longitude']
end

python
# Target_Encoded_Police_Force
# Target encoding applied to Police_Force with respect to Sex_of_Driver.
# Usefulness: Encodes region-dependent police forces as a possible indicator related to driver demographics.
df['Target_Encoded_Police_Force'] = df.groupby('Police_Force')['Sex_of_Driver'].transform('mean')
end

python
# Dropping redundant or highly correlated features
# These columns have limited contribution or are unnecessary after feature engineering and might introduce multicollinearity.
df.drop(columns=[
    'Vehicle_Reference_df',          # Already using derived Vehicle_Reference_df_res.
    'Casualty_Reference',            # Redundant, mostly ID-like.
    'Sex_of_Casualty',               # Captured already with Sex_of_Casualty_as_Driver_Proxy feature above.
    'Location_Easting_OSGR',         # Correlated with Longitude/Latitude features.
    'Location_Northing_OSGR',        # Correlated with Longitude/Latitude features.
    'Urban_or_Rural_Area',           # Replaced by Urban_Area_Flag.
], inplace=True)
end
