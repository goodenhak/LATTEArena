# log_Engine_Capacity
# Log transformation of Engine_Capacity_(CC). Reduces skewness of engine capacity, making the feature more suitable for downstream predictive tasks.
# Usefulness: Large differences in Engine_Capacity can significantly affect driver decisions and might indirectly correlate with the sex of the driver. Log helps scale this feature.
df['log_Engine_Capacity'] = df['Engine_Capacity_(CC)'].apply(lambda x: np.log(x + 1))
end

python
# Age_of_Driver_Binned
# Binning Age_of_Driver into categorical buckets (e.g., young, mid-age, senior) based on quartiles.
# Usefulness: Simplifies driver age variations and captures trends like younger or senior drivers potentially correlating with the sex of the driver.
df['Age_of_Driver_Binned'] = pd.cut(df['Age_of_Driver'], bins=[0, 27, 38, 51, 100], labels=['Young', 'Mid-Young', 'Mid-Old', 'Senior'], right=False)
end

python
# Vehicle_Manoeuvre_Simplified
# Grouping Vehicle_Manoeuvre into simplified categories (e.g., straight driving, turning, stationary).
# Usefulness: Simplifies the complex maneuver codes into meaningful groupings that can reveal behavioral differences by sex of the driver.
df['Vehicle_Manoeuvre_Simplified'] = df['Vehicle_Manoeuvre'].replace({
    1: 'Stationary', 2: 'Stationary', 
    3: 'Turning', 4: 'Turning', 
    5: 'Straight Driving', 6: 'Straight Driving', 7: 'Straight Driving', 
    8: 'Parking', 9: 'Parking', 
    10: 'Avoiding', 11: 'Avoiding', 
    12: 'Other', 13: 'Other', 14: 'Other', 
    15: 'Reversing', 16: 'U-Turn', 
    17: 'Changing Lanes', 18: 'Other'
})
end

python
# Speed_Engagement_Ratio
# Feature created as the ratio of Engine_Capacity_(CC) to (Age_of_Vehicle + 1) to account for vehicle age.
# Usefulness: This captures the vehicle's performance relative to its age and maintenance history, which may indirectly link with the driver's preferences or demographics.
df['Speed_Engagement_Ratio'] = df['Engine_Capacity_(CC)'] / (df['Age_of_Vehicle'] + 1)
end

python
# Sex_of_Casualty_as_Driver_Proxy
# Use Sex_of_Casualty as a potential proxy towards predicting Sex_of_Driver.
# Usefulness: Social or cultural correlations between a driver's gender and that of casualties in the accident could be a predictive signal.
df['Sex_of_Casualty_as_Driver_Proxy'] = df['Sex_of_Casualty']
end

python
# Urban_Area_Flag
# Binary flag feature indicating if the area is urban (1 for urban, 0 for rural).
# Usefulness: Urban vs rural driving conditions could correlate with driver demographics, such as sex.
df['Urban_Area_Flag'] = df['Urban_or_Rural_Area'].apply(lambda x: 1 if x == 1 else 0)
end

python
# Age_and_Experience
# Interaction effect between Age_of_Driver and Age_of_Vehicle calculated as Age_of_Driver / (Age_of_Vehicle + 1).
# Usefulness: Estimates driving experience relative to vehicle age, which could indicate gender-specific driving decisions or patterns.
df['Age_and_Experience'] = df['Age_of_Driver'] / (df['Age_of_Vehicle'] + 1)
end

python
# Latitude_Longitude_Interaction
# Feature generated by multiplying Latitude and Longitude values.
# Usefulness: Captures location-based features that might correlate with driver demographics, including sex differences across regions.
df['Latitude_Longitude_Interaction'] = df['Latitude'] * df['Longitude']
end

python
# Target_Encoded_Police_Force
# Target encoding applied to Police_Force with respect to Sex_of_Driver (target column).
# Usefulness: Encodes region-specific variations in demographics and potential cultural aspects related to gender differences in driving patterns.
df['Target_Encoded_Police_Force'] = df.groupby('Police_Force')['Sex_of_Driver'].transform('mean')
end

python
# Dropping redundant or highly correlated features
# These columns have limited contribution or introduce multicollinearity after feature engineering.
df.drop(columns=[
    'Vehicle_Reference_df_res',         # Redundant because we already derive features from it.
    'Sex_of_Casualty',                  # Already captured with Sex_of_Casualty_as_Driver_Proxy.
    'Urban_or_Rural_Area',              # Replaced by Urban_Area_Flag.
    'Location_Easting_OSGR',            # Correlated with Longitude/Latitude.
    'Location_Northing_OSGR',           # Correlated with Longitude/Latitude.
    'Casualty_Reference'                # Redundant ID-like column with no predictive value. 
], inplace=True)
