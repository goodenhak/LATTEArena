# Elevation_zscore
# Standardized elevation feature using z-score normalization.
# Usefulness: Allows features with differing scales to be comparable and better interpreted by machine learning models, especially linear ones.
df['Elevation_zscore'] = (df['Elevation'] - 3024.4121) / 201.9785
end

python
# Vertical_Distance_Abs
# Absolute vertical distance to hydrology.
# Usefulness: Some ML algorithms might struggle with negative values for vertical distance. This feature captures the magnitude, which is important for terrain-related influences.
df['Vertical_Distance_Abs'] = df['Vertical_Distance_To_Hydrology'].abs()
end

python
# Horizontal_Distance_To_Hydrology_Roadways_Ratio
# Ratio of horizontal distance to hydrology over distance to roadways.
# Usefulness: Relationships between different types of distances can provide insights into the relative position to important geographical features.
df['Horizontal_Distance_Hydro_Road_Ratio'] = df['Horizontal_Distance_To_Hydrology'] / (df['Horizontal_Distance_To_Roadways'] + 1e-5)
end

python
# Aspect_Cosine
# Cosine of the aspect angle, which captures whether the slope faces north/south.
# Usefulness: The direction a slope faces significantly impacts its sunlight exposure, which can affect vegetation growth.
df['Aspect_Cosine'] = np.cos(np.radians(df['Aspect']))
end

python
# Aspect_Sine
# Sine of the aspect angle, which captures whether the slope faces east/west.
# Usefulness: Complementary to Aspect_Cosine, this feature captures directionality related to sunlight exposure more effectively than raw angle.
df['Aspect_Sine'] = np.sin(np.radians(df['Aspect']))
end

python
# Hillshade_mean
# Average of hillshade values at 9am, noon, and 3pm.
# Usefulness: Provides an overall measure of terrain shade exposure, which can influence vegetation growth and soil composition. 
df['Hillshade_mean'] = (df['Hillshade_9am'] + df['Hillshade_Noon'] + df['Hillshade_3pm']) / 3
end

python
# Hillshade_std
# Standard deviation of hillshade values at 9am, noon, and 3pm.
# Usefulness: Captures the variability in sunlight exposure throughout the day, potentially important for understanding microclimates.
df['Hillshade_std'] = df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].std(axis=1)
end

python
# Total_Horizontal_Distance
# Sum of horizontal distances to hydrology, roadways, and fire points.
# Usefulness: Combined distances to geographic features may provide insights into accessibility or environmental influences.
df['Total_Horizontal_Distance'] = (
    df['Horizontal_Distance_To_Hydrology'] +
    df['Horizontal_Distance_To_Roadways'] +
    df['Horizontal_Distance_To_Fire_Points']
)
end

python
# Fire_Roadways_Ratio
# Ratio of horizontal distance to fire points over distance to roadways.
# Usefulness: Measuring proximity to fire and roadways combined may highlight geographical dependencies for forest cover type prediction.
df['Fire_Roadways_Ratio'] = df['Horizontal_Distance_To_Fire_Points'] / (df['Horizontal_Distance_To_Roadways'] + 1e-5)
end

python
# Elevation_binned
# Elevation grouped into bins based on Q1, Q2, Q3, and range.
# Usefulness: Binning elevation simplifies the relationship between altitude and forest cover, capturing broader trends.
df['Elevation_binned'] = pd.cut(
    df['Elevation'],
    bins=[2142, 2898, 3037, 3179, 3686],
    labels=['Low', 'Lower-Mid', 'Upper-Mid', 'High']
)
end

python
# Soil_Type_Count
# Count of soil types present for each observation.
# Usefulness: Provides information about the diversity of soil types in the area which might influence vegetation and forest cover.
df['Soil_Type_Count'] = df[[f'Soil_Type{i}' for i in range(1, 41)]].sum(axis=1)
end

python
# Wilderness_Combined
# Concatenation of all wilderness area indicators.
# Usefulness: Consolidates wilderness categories into a single feature for more manageable modeling.
df['Wilderness_Combined'] = (
    df['Wilderness_Area1'].astype(str) +
    df['Wilderness_Area2'].astype(str) +
    df['Wilderness_Area3'].astype(str) +
    df['Wilderness_Area4'].astype(str)
)
end

python
# Spatial_Distance_From_Hydrology
# Euclidean distance to nearest water source.
# Usefulness: Determines the actual spatial proximity to water rather than just one-dimensional distances.
df['Spatial_Distance_From_Hydrology'] = np.sqrt(
    df['Horizontal_Distance_To_Hydrology']2 + df['Vertical_Distance_To_Hydrology']2
)
end

python
# Drop irrelevant attributes
# Some soil types provide no predictive information due to having only zero values.
df.drop(columns=['Soil_Type1', 'Soil_Type5', 'Soil_Type14', 'Soil_Type15', 'Soil_Type37'], inplace=True)
end

python
# Roadways_Hydrology_Minmax
# Min-Max scaled horizontal distance to roadways and hydrology.
# Usefulness: Normalizing these values reduces sensitivity to feature scaling, which may improve the model's performance.
df['Horizontal_Distance_To_Hydrology_minmax'] = (
    (df['Horizontal_Distance_To_Hydrology'] - df['Horizontal_Distance_To_Hydrology'].min()) /
    (df['Horizontal_Distance_To_Hydrology'].max() - df['Horizontal_Distance_To_Hydrology'].min())
)
df['Horizontal_Distance_To_Roadways_minmax'] = (
    (df['Horizontal_Distance_To_Roadways'] - df['Horizontal_Distance_To_Roadways'].min()) /
    (df['Horizontal_Distance_To_Roadways'].max() - df['Horizontal_Distance_To_Roadways'].min())
)
end

python
# Interaction_Terms
# Interaction between elevation and slope; distance from fire points and roadways.
# Usefulness: Interaction terms often uncover hidden relationships between features that are important in predicting outputs.
df['Elevation_Slope_Interaction'] = df['Elevation'] * df['Slope']
df['Fire_Roadways_Interaction'] = df['Horizontal_Distance_To_Fire_Points'] * df['Horizontal_Distance_To_Roadways']
end
