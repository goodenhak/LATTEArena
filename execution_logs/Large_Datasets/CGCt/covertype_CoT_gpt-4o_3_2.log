2026-05-14 04:49:15,132 - INFO - ops_string = ["# New feature: Elevation_zscore\n# Feature description: Standardized elevation feature using z-score normalization.\n# Usefulness: Allows features with differing scales to be comparable and better interpreted by machine learning models, especially linear ones.\ndf['Elevation_zscore'] = (df['Elevation'] - 3024.4121) / 201.9785", "# New feature: Vertical_Distance_Abs\n# Feature description: Absolute vertical distance to hydrology.\n# Usefulness: Some ML algorithms might struggle with negative values for vertical distance. This feature captures the magnitude, important for terrain-related influences.\ndf['Vertical_Distance_Abs'] = df['Vertical_Distance_To_Hydrology'].abs()", "# New feature: Horizontal_Distance_Hydro_Road_Ratio\n# Feature description: Ratio of horizontal distance to hydrology over distance to roadways.\n# Usefulness: Relationships between different types of distances can provide insights into the position relative to important geographical features.\ndf['Horizontal_Distance_Hydro_Road_Ratio'] = df['Horizontal_Distance_To_Hydrology'] / (df['Horizontal_Distance_To_Roadways'] + 1e-5)", "# New feature: Aspect_Cosine\n# Feature description: Cosine of the aspect angle, which captures whether the slope faces north/south.\n# Usefulness: The direction a slope faces significantly impacts its sunlight exposure, which can affect vegetation growth.\ndf['Aspect_Cosine'] = np.cos(np.radians(df['Aspect']))", "# New feature: Aspect_Sine\n# Feature description: Sine of the aspect angle, which captures whether the slope faces east/west.\n# Usefulness: Complementary to Aspect_Cosine, this feature also captures directionality related to sunlight exposure more effectively than raw angle.\ndf['Aspect_Sine'] = np.sin(np.radians(df['Aspect']))", "# New feature: Hillshade_mean\n# Feature description: Average of hillshade values at 9am, noon, and 3pm.\n# Usefulness: Provides an overall measure of terrain shade exposure, which can influence vegetation growth and soil composition.\ndf['Hillshade_mean'] = (\n    (df['Hillshade_9am'] + df['Hillshade_Noon'] + df['Hillshade_3pm']) / 3\n)", "# New feature: Hillshade_std\n# Feature description: Standard deviation of hillshade values at 9am, noon, and 3pm.\n# Usefulness: Captures the variability in sunlight exposure throughout the day, potentially important for understanding microclimates.\ndf['Hillshade_std'] = df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].std(axis=1)", "# New feature: Total_Horizontal_Distance\n# Feature description: Sum of horizontal distances to hydrology, roadways, and fire points.\n# Usefulness: Combined distances to geographic features may provide insights into accessibility or environmental influences.\ndf['Total_Horizontal_Distance'] = (\n    df['Horizontal_Distance_To_Hydrology'] +\n    df['Horizontal_Distance_To_Roadways'] +\n    df['Horizontal_Distance_To_Fire_Points']\n)", "# New feature: Fire_Roadways_Ratio\n# Feature description: Ratio of horizontal distance to fire points over distance to roadways.\n# Usefulness: Measuring proximity to fire and roadways combined may highlight geographical dependencies for forest cover type prediction.\ndf['Fire_Roadways_Ratio'] = df['Horizontal_Distance_To_Fire_Points'] / (df['Horizontal_Distance_To_Roadways'] + 1e-5)", "# New feature: Elevation_binned\n# Feature description: Elevation grouped into bins based on Q1, Q2, Q3, and range.\n# Usefulness: Binning elevation simplifies the relationship between altitude and forest cover, capturing broader trends.\ndf['Elevation_binned'] = pd.cut(\n    df['Elevation'],\n    bins=[2142, 2898, 3037, 3179, 3686],\n    labels=['Low', 'Lower-Mid', 'Upper-Mid', 'High']\n)", "# New feature: Soil_Type_Count\n# Feature description: Count of soil types present for each observation.\n# Usefulness: Provides information about the diversity of soil types in the area which might influence vegetation and forest cover.\ndf['Soil_Type_Count'] = df[[f'Soil_Type{i}' for i in range(1, 41)]].sum(axis=1)", "# New feature: Wilderness_Combined\n# Feature description: Concatenation of all wilderness area indicators.\n# Usefulness: Consolidates wilderness categories into a single feature for more manageable modeling.\ndf['Wilderness_Combined'] = (\n    df['Wilderness_Area1'].astype(str) + \n    df['Wilderness_Area2'].astype(str) + \n    df['Wilderness_Area3'].astype(str) + \n    df['Wilderness_Area4'].astype(str)\n)", "# New feature: Spatial_Distance_From_Hydrology\n# Feature description: Euclidean distance to nearest water source.\n# Usefulness: Determines the actual spatial proximity to water rather than just one-dimensional distances.\ndf['Spatial_Distance_From_Hydrology'] = np.sqrt(\n    df['Horizontal_Distance_To_Hydrology']2 + df['Vertical_Distance_To_Hydrology']2\n)", "# Drop irrelevant attributes\n# Some soil types and wilderness categories only consist of zeros and provide no predictive information.\ndf.drop(columns=['Soil_Type1', 'Soil_Type5', 'Soil_Type14', 'Soil_Type15', 'Soil_Type37'], inplace=True)", "# New feature: Horizontal_Distance_To_Hydrology_minmax\n# Feature description: Min-Max scaled horizontal distance to hydrology.\n# Usefulness: Normalizing this value reduces sensitivity to feature scaling, which may improve the model's performance.\ndf['Horizontal_Distance_To_Hydrology_minmax'] = (\n    (df['Horizontal_Distance_To_Hydrology'] - df['Horizontal_Distance_To_Hydrology'].min()) / \n    (df['Horizontal_Distance_To_Hydrology'].max() - df['Horizontal_Distance_To_Hydrology'].min())\n)\n\n# New feature: Horizontal_Distance_To_Roadways_minmax\n# Feature description: Min-Max scaled horizontal distance to roadways.\n# Usefulness: Similarly, normalizing roadways distance reduces feature scaling sensitivity and facilitates reliable modeling.\ndf['Horizontal_Distance_To_Roadways_minmax'] = (\n    (df['Horizontal_Distance_To_Roadways'] - df['Horizontal_Distance_To_Roadways'].min()) / \n    (df['Horizontal_Distance_To_Roadways'].max() - df['Horizontal_Distance_To_Roadways'].min())\n)", "# Interaction terms: Elevation_Slope_Interaction and Fire_Roadways_Interaction\n# Feature description: Interaction between elevation and slope; distance from fire points and roadways.\n# Usefulness: Interaction terms often uncover hidden relationships between features that are important in predicting outputs.\ndf['Elevation_Slope_Interaction'] = df['Elevation'] * df['Slope']\ndf['Fire_Roadways_Interaction'] = df['Horizontal_Distance_To_Fire_Points'] * df['Horizontal_Distance_To_Roadways']"]
