python
# Elevation_Difference_To_Hydrology
# This feature represents the difference between the Elevation and the Vertical distance to Hydrology.
# Usefulness: Captures the relative height of the cell compared to the nearest water source, which is important for vegetation and forest types.
df['Elevation_Difference_To_Hydrology'] = df['Elevation'] - df['Vertical_Distance_To_Hydrology']
end

python
# Mean_Hillshade
# This feature is the mean value of the 9am, noon, and 3pm hillshade indices.
# Usefulness: Aggregates the lighting conditions over the day, which can significantly influence vegetation and forest type.
df['Mean_Hillshade'] = (df['Hillshade_9am'] + df['Hillshade_Noon'] + df['Hillshade_3pm']) / 3
end

python
# Hydrology_Ratio
# Ratio between Horizontal_Distance_To_Hydrology and Vertical_Distance_To_Hydrology.
# Usefulness: Indicates the steepness of the slope leading to the hydrology, which directly impacts water flow and vegetation patterns.
df['Hydrology_Ratio'] = df['Horizontal_Distance_To_Hydrology'] / (df['Vertical_Distance_To_Hydrology'] + 1e-6)
end

python
# Road_Fire_Distance_Ratio
# Ratio between Horizontal_Distance_To_Roadways and Horizontal_Distance_To_Fire_Points.
# Usefulness: Helps capture how accessibility (roads) and proximity to fire ignition points are related, which could reveal insights into forest type susceptibility.
df['Road_Fire_Distance_Ratio'] = df['Horizontal_Distance_To_Roadways'] / (df['Horizontal_Distance_To_Fire_Points'] + 1e-6)
end

python
# Cosine_Aspect
# Cosine transformation of the Aspect feature.
# Usefulness: Aspect represents the orientation of the slope; converting it to cosine captures the north/south component, significant for sunlight exposure and vegetation.
df['Cosine_Aspect'] = np.cos(np.radians(df['Aspect']))
end

python
# Sine_Aspect
# Sine transformation of the Aspect feature.
# Usefulness: Captures the east/west component of slope orientation, accounting for directional differences in vegetation and forest cover.
df['Sine_Aspect'] = np.sin(np.radians(df['Aspect']))
end

python
# Slope_Hydrology_Distance
# Multiplies Slope with Horizontal_Distance_To_Hydrology.
# Usefulness: Combines terrain steepness with hydrology proximity to further understand water flow and vegetation growth.
df['Slope_Hydrology_Distance'] = df['Slope'] * df['Horizontal_Distance_To_Hydrology']
end

python
# Areal_Illumination
# Product of Mean_Hillshade and Elevation.
# Usefulness: Combines hillshade and elevation, capturing the overall light exposure for vegetation growth relative to terrain.
df['Areal_Illumination'] = df['Mean_Hillshade'] * df['Elevation']
end

python
# Vertical_Distance_Normalized
# Z-score normalization of Vertical_Distance_To_Hydrology.
# Usefulness: Scales the feature to have a mean of 0 and standard deviation of 1, improving the comparability during model training.
df['Vertical_Distance_Normalized'] = (df['Vertical_Distance_To_Hydrology'] - df['Vertical_Distance_To_Hydrology'].mean()) / df['Vertical_Distance_To_Hydrology'].std()
end

python
# Wilderness_Area_Binary
# Encodes the four Wilderness_Area binary columns into a single categorical feature.
# Usefulness: Simplifies handling these features while retaining all unique area distinctions, supporting tree-based models to understand its importance.
df['Wilderness_Area_Binary'] = (df[['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3', 'Wilderness_Area4']] 
                                 .idxmax(axis=1)
                                 .str.extract('(\d+)')
                                 .astype(int))
end

python
# Soil_Type_Is_Frequent
# Combines all Soil_Type into a binary feature indicating if it occurs in more than 5% of the dataset.
# Usefulness: Simplifies the impact of rare soil types by grouping them into a single binary indicator for rare versus frequent.
df['Soil_Type_Is_Frequent'] = (df[['Soil_Type' + str(i) for i in range(1, 41)]]
                                .sum(axis=1) > 0) * 1
end

python
# Sum_Wilderness_Soils
# Computes the sum of all Wilderness Areas and Soil Type indicators.
# Usefulness: Provides a summary measure combining wilderness presence and soil richness, which may correlate with forest cover.
df['Sum_Wilderness_Soils'] = df[['Wilderness_Area1', 'Wilderness_Area2',
                                  'Wilderness_Area3', 'Wilderness_Area4'] 
                                 + ['Soil_Type' + str(i) for i in range(1, 41)]].sum(axis=1)
end

python
df.drop(columns=['Soil_Type1', 'Soil_Type5', 'Soil_Type14', 'Soil_Type15', 'Soil_Type37'], inplace=True)
end
