# suit_match_count
# Feature description: Counts the number of cards in the hand that share the same suit.
# Usefulness: Helps determine if there is a potential flush (key for identifying hands like Flush, Straight Flush, or Royal Flush).
df['suit_match_count'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(lambda x: x.value_counts().max(), axis=1)
end

python
# rank_match_count
# Feature description: Counts the frequency of ranks for each card in the hand.
# Usefulness: Useful for identifying hands such as One Pair, Two Pairs, Three of a Kind, Four of a Kind, or Full House.
df['rank_match_count'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: x.value_counts().max(), axis=1)
end

python
# is_flush
# Feature description: Binary feature indicating whether all cards in the hand have the same suit.
# Usefulness: Identifies Flush hands and is a prerequisite for identifying Royal Flush and Straight Flush hands.
df['is_flush'] = (df[['V1', 'V3', 'V5', 'V7', 'V9']].nunique(axis=1) == 1).astype(int)
end

python
# sorted_ranks
# Feature description: A concatenated string of the sorted card ranks in ascending order.
# Usefulness: Captures the sequential nature of cards necessary for identifying Straights, Straight Flush, or Royal Flush.
df['sorted_ranks'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: ''.join(map(str, sorted(x))), axis=1)
end

python
# is_sequential
# Feature description: Binary feature indicating whether the card ranks are sequential with no gaps.
# Usefulness: Essential for identifying Straight, Straight Flush, and Royal Flush hands.
df['is_sequential'] = df['sorted_ranks'].apply(lambda x: all(int(x[i+1]) - int(x[i]) == 1 for i in range(len(x) - 1))).astype(int)
end

python
# is_royal_flush
# Feature description: Binary feature indicating whether the hand is a Royal Flush ({Ace, King, Queen, Jack, Ten} + Flush).
# Usefulness: Directly identifies the highest-ranking poker hand.
df['is_royal_flush'] = ((df['is_flush'] == 1) & (df['sorted_ranks'] == '1011121314')).astype(int)
end

python
# max_rank_frequency
# Feature description: The maximum count of any rank appearing in the hand.
# Usefulness: Identifies frequency-heavy hands like Four of a Kind, Full House, and Three of a Kind.
df['max_rank_frequency'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: x.value_counts().max(), axis=1)
end

python
# rank_pair_count
# Feature description: Count of rank pairs (groups of two cards with the same rank).
# Usefulness: Helps identify One Pair or Two Pairs hands.
df['rank_pair_count'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: sum(x.value_counts() == 2), axis=1)
end

python
# straight_gap_count
# Feature description: Counts the number of gaps in the card ranks when sorted.
# Usefulness: Helps identify whether the hand is close to being a Straight or completely non-sequential.
df['straight_gap_count'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: sum((sorted(x)[i+1] - sorted(x)[i]) != 1 for i in range(4)), axis=1)
end

python
# is_high_card
# Feature description: Binary feature indicating if the hand qualifies only as Nothing in hand (0 points poker hand).
# Usefulness: Differentiates hands with no significant patterns from others.
df['is_high_card'] = ((df['rank_pair_count'] == 0) & (df['is_flush'] == 0) & (df['is_sequential'] == 0)).astype(int)
end

python
# relative_suit_frequency
# Feature description: The relative frequency of the most frequent suit in a hand.
# Usefulness: Helps determine the strength of suited combinations towards a possible Flush.
df['relative_suit_frequency'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(lambda x: x.value_counts().max() / 5, axis=1)
end

python
# rank_standard_deviation
# Feature description: Standard deviation of card ranks.
# Usefulness: Measures the dispersion of ranks, helping to distinguish between evenly spaced hands (e.g., Straights) and clustered ranks (e.g., Four of a Kind or Full House).
df['rank_standard_deviation'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].std(axis=1)
end

python
# Drop unused feature sorted_ranks
df.drop(columns=['sorted_ranks'], inplace=True)
end
