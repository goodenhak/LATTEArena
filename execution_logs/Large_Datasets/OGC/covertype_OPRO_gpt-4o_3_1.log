# Feature Engineering: Normalized_Fire_Road_Distance
# Feature description: Computes the ratio of horizontal distance to fire points and roadways, normalized by the mean and standard deviation.
# Usefulness: Highlights the relative proximity of fire points in comparison to roadways, impacting vegetation differently depending on the proximity to roads and fire.
df['Normalized_Fire_Road_Distance'] = zscore(df['Horizontal_Distance_To_Fire_Points'] / (df['Horizontal_Distance_To_Roadways'] + 1))

# Feature Engineering: Weighted_Hydrology_Slope
# Feature description: Combines Vertical_Horizontal_Distance_Ratio_Hydrology and Slope using their weighted average.
# Usefulness: Emphasizes terrain slope and hydrological aspects for understanding water flow and its contributions to vegetation coverage.
df['Weighted_Hydrology_Slope'] = 0.7 * df['Vertical_Horizontal_Distance_Ratio_Hydrology'] + 0.3 * zscore(df['Slope'])

# Feature Engineering: Terrain_Ruggedness_Index
# Feature description: Combines slope and hillshade variance to create a terrain ruggedness index.
# Usefulness: Measures landscape texture, which is associated with water flow dynamics, soil formation, and vegetation growth patterns.
df['Terrain_Ruggedness_Index'] = np.sqrt(df['Slope']2 + (df['Hillshade_Variance'] / 1000)2)

# Feature Engineering: Fire_Hydrology_Index
# Feature description: Combines normalized values of fire and hydrology distances to highlight areas impacted simultaneously by fires and water sources.
# Usefulness: Captures areas where the proximity to both fire and water could have contrasting or compounding impacts on vegetation.
df['Fire_Hydrology_Index'] = zscore(df['Horizontal_Distance_To_Fire_Points']) * zscore((df['Horizontal_Distance_To_Hydrology'] + 1))

# Feature Engineering: Soil_Terrain_Interaction
# Feature description: Interaction term between Soil_Type_Dominance and Terrain_Ruggedness_Index.
# Usefulness: Highlights how soil dominance interacts with terrain ruggedness, potentially informing how different soil types cope with varying elevations and terrain.
df['Soil_Terrain_Interaction'] = zscore(df['Soil_Type_Dominance']) * zscore(df['Terrain_Ruggedness_Index'])

# Feature Engineering: Elevation_Weighted_Fire_Proximity
# Feature description: Combines Elevation_Above_Q3 and normalized Fire_Proximity_Road_Weighted using a weighted average.
# Usefulness: Models how elevation acts along with fire proximity to influence forest cover type.
df['Elevation_Weighted_Fire_Proximity'] = 0.6 * zscore(df['Elevation_Above_Q3']) + 0.4 * zscore(df['Fire_Proximity_Road_Weighted'])

# Feature Engineering: Wilderness_Frequency_Weighted_Soil_Dominance
# Feature description: Combines Wilderness presence indicators weighted by Soil_Type_Dominance.
# Usefulness: Emphasizes the interaction between wilderness areas and dominant soil properties, potentially indicative of certain forest cover types.
df['Wilderness_Frequency_Weighted_Soil_Dominance'] = (df['Wilderness_Area1'] + df['Wilderness_Area2'] + df['Wilderness_Area3']) * zscore(df['Soil_Type_Dominance'])

# Feature Engineering: Hillshade_Contrast
# Feature description: Calculates the difference between Hillshade_Noon and the average of Hillshade_9am and Hillshade_3pm.
# Usefulness: Identifies areas with unusual hillshade patterns, which could indicate irregular topographical or environmental conditions affecting forest cover.
df['Hillshade_Contrast'] = df['Hillshade_Noon'] - ((df['Hillshade_9am'] + df['Hillshade_3pm']) / 2)

# Feature Engineering: Elevated_Scarcity_Index
# Feature description: Combines Elevation_Above_Q3 with Soil_Type_Scarcity through multiplication.
# Usefulness: Highlights how rare soil types interact with high altitudes, potentially influencing specific vegetation patterns.
df['Elevated_Scarcity_Index'] = zscore(df['Elevation_Above_Q3']) * zscore(np.log1p(df['Soil_Type_Scarcity']))

# Feature Engineering: Hydrology_Fire_Energy
# Feature description: Combines the Road_Fire_Hydrology_Composite and Fire_Hydrology_Interaction_Log into an energy-like feature.
# Usefulness: Represents the interactions between roads, fire, and hydrology, which can significantly determine changes in vegetation cover.
df['Hydrology_Fire_Energy'] = np.log1p(df['Road_Fire_Hydrology_Composite'] + df['Fire_Hydrology_Interaction_Log'])

# Feature Engineering: Hydrology_Road_Stress_Combined
# Feature description: Combines Horizontal_Distance_To_Hydrology with Horizontal_Distance_To_Roadways to depict combined stress factors.
# Usefulness: Indicates proximity to water and roads, which together can represent accessibility and environmental stress.
df['Hydrology_Road_Stress_Combined'] = zscore(df['Horizontal_Distance_To_Hydrology']) * zscore(df['Horizontal_Distance_To_Roadways'])

# Feature Engineering: Elevation_Hydrology_Effectiveness
