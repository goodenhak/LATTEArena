# Usefulness: Detects dominance of hydrology versus fire proximity in a smoother, log-transformed manner.
df['Hydrology_Fire_Distance_Ratio_Log'] = np.log1p(df['Horizontal_Distance_To_Hydrology'] / (df['Horizontal_Distance_To_Fire_Points'] + 1))

# Elevation_Soil_Interaction
