python
# Hydrology_Fire_Proximity_Ratio
# Ratio of Horizontal distance to hydrology divided by Horizontal distance to fire points.
# Usefulness: Helps capture the relative influence of water and fire proximity in determining vegetation/forest cover type.
df['Hydrology_Fire_Proximity_Ratio'] = df['Horizontal_Distance_To_Hydrology'] / (df['Horizontal_Distance_To_Fire_Points'] + 1e-6)
end

python
# Wilderness_Area_Sum
