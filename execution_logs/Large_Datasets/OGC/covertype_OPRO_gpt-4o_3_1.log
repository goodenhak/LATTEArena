end

python
# Hydrology_Road_Distance_Interaction
# Computes an interaction between horizontal distance to hydrology and distance to roadways using multiplication.
# Usefulness: Captures the combined influence of road access and proximity to water on vegetation/forest conditions.
df['Hydrology_Road_Distance_Interaction'] = (
    df['Horizontal_Distance_To_Hydrology'] * df['Horizontal_Distance_To_Roadways']
)
end

python
# Distance_Ratio
# Combined ratio of all distance metrics (roadways, fire points, hydrology), normalized using min-max scaling.
# Usefulness: Provides a single feature that summarizes relative proximity to these environmental features.
df['Distance_Ratio'] = (
    (df['Horizontal_Distance_To_Hydrology'] + df['Horizontal_Distance_To_Roadways'] + df['Horizontal_Distance_To_Fire_Points']) /
    (df['Horizontal_Distance_To_Hydrology'].max() + df['Horizontal_Distance_To_Roadways'].max() + df['Horizontal_Distance_To_Fire_Points'].max())
)
end

python
# Dominant_Soil_Scaled
# Applies min-max scaling to Soil_Type_Dominance.
# Usefulness: Simplifies Soil_Type_Dominance into a normalized range for better numerical modeling.
df['Dominant_Soil_Scaled'] = (df['Soil_Type_Dominance'] - df['Soil_Type_Dominance'].min()) / (df['Soil_Type_Dominance'].max() - df['Soil_Type_Dominance'].min())
end

python
