# Usefulness: Highlights areas where steep slopes interact with hydrology, influencing water flow, soil erosion, and vegetation patterns.
df['Hydrology_Slope_Interaction'] = df['Hydrology_Proximity_Index'] * df['Slope']
end

python
# Soil_Type_Rareness_Weighted
