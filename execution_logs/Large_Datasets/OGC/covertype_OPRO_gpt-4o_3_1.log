python
# Dominant_Soil_Type_Grouped
# Categories of soil types grouped into bins based on Soil_Type_Dominance values.
# Usefulness: Groups dominant soil categories to reduce sparsity and capture broader trends in soil types and their relationship with forest cover.
bins = [0, 10, 20, 30, 40]
labels = [1, 2, 3, 4]
df['Dominant_Soil_Type_Grouped'] = pd.cut(df['Soil_Type_Dominance'], bins=bins, labels=labels)
end

python
# Elevation_Scaled
# Z-score normalization of Elevation.
# Usefulness: Helps normalize elevation values to aid downstream algorithms in accounting for differences in scale.
df['Elevation_Scaled'] = (df['Elevation'] - df['Elevation'].mean()) / df['Elevation'].std()
end

python
