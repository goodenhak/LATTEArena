# Usefulness: Helps capture interaction effects between elevation and stratified water movement, influencing vegetation.
df['Elevation_Hydrology_Effectiveness'] = (df['Elevation'] - df['Vertical_Distance_To_Hydrology']) / (df['Hydrology_Slope_Factor'] + 1)

# Dropping redundant features
