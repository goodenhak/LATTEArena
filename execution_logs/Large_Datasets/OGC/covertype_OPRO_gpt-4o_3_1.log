# Usefulness: Identifies areas where wilderness overlaps with varying degrees of accessibility.
df['Wilderness_Road_Accessibility'] = df[['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3']].sum(axis=1) / (df['Horizontal_Distance_To_Roadways'] + 1)

