# Usefulness: Represents east-west shadow contrasts, important for microclimatic differences influencing cover types.
df['Hillshade_Directional_Difference'] = df['Hillshade_9am'] - df['Hillshade_3pm']

# Slope_Fire_Distance_Interaction
# Log-transformed interaction of slope and fire distance, highlighting steep areas influenced by fire proximity.
# Usefulness: Encodes terrain inclination effects on vegetation in fire-prone areas.
df['Slope_Fire_Distance_Interaction'] = np.log1p(df['Slope'] * df['Horizontal_Distance_To_Fire_Points'])

# Dominant_Rare_Soil_Condition
# Combines soil dominance and rare soil conditions to represent overlap between rarity and dominance.
# Usefulness: Encodes areas where dominant soils might also be rare, impacting vegetation distribution.
df['Dominant_Rare_Soil_Condition'] = df['Soil_Type_Dominance'] * df['Rare_Soil_Conditions']

# Elevation_Fire_Distance_Log_Combined
# Combines elevation and log-transformed fire distance into a single feature, capturing integrated effects.
# Usefulness: Highlights interaction of altitude and fire proximity, particularly relevant to cover susceptibility.
df['Elevation_Fire_Distance_Log_Combined'] = df['Elevation'] * np.log1p(df['Horizontal_Distance_To_Fire_Points'])

# Hydrology_Road_Fire_Weighted_Interaction
