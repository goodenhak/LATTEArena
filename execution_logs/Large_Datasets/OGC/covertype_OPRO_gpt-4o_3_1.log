hillshade_cols = ['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']
df['Hillshade_Normalized_Composite'] = df[hillshade_cols].sub(df[hillshade_cols].mean(axis=0), axis=1).div(df[hillshade_cols].std(axis=0), axis=1).mean(axis=1)

