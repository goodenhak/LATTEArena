# Feature: Elevation_Normalized_Squared
# Description: Normalize elevation using min-max scaling and square it to emphasize impact of extreme elevations.
# Usefulness: Captures the effect of extreme high or low elevation zones on vegetation patterns, especially since forest cover types are heavily influenced by elevation extremes.
elevation_min, elevation_max = 2142, 3679
df['Elevation_Normalized_Squared'] = ((df['Elevation'] - elevation_min) / (elevation_max - elevation_min))  2
end

python
# Feature: Hydrology_Weighted_Proximity
# Description: Compute a weighted proximity index of horizontal and vertical distances to hydrology.
# Usefulness: Integrates the horizontal and vertical proximity for a combined hydrology influence metric, which is meaningful for forest cover near water bodies.
df['Hydrology_Weighted_Proximity'] = (df['Horizontal_Distance_To_Hydrology'] + 2 * np.abs(df['Vertical_Distance_To_Hydrology']))
end

python
# Feature: Combined_Sunlight_Hydrology_Index
# Description: Combines average sunlight exposure and hydrology distance into a single environmental index.
# Usefulness: Captures the joint effect of sunlight and proximity to water, which are key factors for vegetation growth and forest ecosystems.
df['Combined_Sunlight_Hydrology_Index'] = (
    (df['Hillshade_9am'] + df['Hillshade_Noon'] + df['Hillshade_3pm']) / 3
) / (df['Hydrology_Combined_Index'] + 1e-6)
end

python
# Feature: Soil_Type_Indicators_Summed_Log
# Description: Log-transformed sum of all soil type indicators.
# Usefulness: Captures the overall presence of various soil types in a log-scaled manner to emphasize rare and diverse soil patterns that influence vegetation.
soil_indicator_columns = [col for col in df.columns if col.startswith('Soil_Type')]
df['Soil_Type_Indicators_Summed_Log'] = np.log1p(df[soil_indicator_columns].sum(axis=1))
end

python
# Feature: Extreme_Terrain_Index
# Description: Combines elevation, slope, and vertical distance to hydrology to form an index for ruggedness.
# Usefulness: Identifies the influence of rugged or extreme terrain on forest cover type, which might affect vegetation inherently.
df['Extreme_Terrain_Index'] = (
    (df['Elevation'] / 1000) * (df['Slope'] + 1) * np.abs(df['Vertical_Distance_To_Hydrology'])
)
end

python
# Feature: Highways_Fire_Hydrology_Interaction
# Description: Compute a balance of proximity to roadways, fire points, and hydrology using a weighted ratio.
# Usefulness: Captures the interaction of infrastructure, fire risk, and water sources, which together influence vegetation and forest growth.
df['Highways_Fire_Hydrology_Interaction'] = (
    (df['Horizontal_Distance_To_Fire_Points'] + 1) /
    (df['Horizontal_Distance_To_Roadways'] + df['Horizontal_Distance_To_Hydrology'] + 1)
)
end

python
# Feature: Slope_Ratio_Encoded
# Description: Categorizes the ratio of Vertical_Distance_To_Hydrology to Horizontal_Distance_To_Hydrology into bins.
# Usefulness: Encodes the terrain steepness ratio in an interpretable manner to model terrain effects on forest dynamics.
df['Slope_Ratio_Encoded'] = pd.cut(
    df['Vertical_Horizontal_Distance_Ratio_Hydrology'],
    bins=[-np.inf, 0, 0.1, 0.3, 0.5, np.inf],
    labels=['flat_negative', 'very_gentle', 'gentle', 'moderate', 'steep']
).astype(str)
end

python
# Feature: Distance_Anisotropy
# Description: Captures anisotropy (directional dependence) in the horizontal distances to hydrology, fire points, and roadways.
# Usefulness: Identifies spatial directional effects that may explain forest type differentiation.
df['Distance_Anisotropy'] = (
    (df['Horizontal_Distance_To_Hydrology'] - df['Horizontal_Distance_To_Fire_Points']) /
