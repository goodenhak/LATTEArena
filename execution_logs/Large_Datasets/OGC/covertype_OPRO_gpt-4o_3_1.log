# Usefulness: Smoothed representation of fire proximity that takes into account both horizontal and vertical distances.
df['Fire_Proximity_Effect'] = df['Log_Horizontal_Distance_To_Fire_Points'] + np.log1p(df['Vertical_Distance_To_Hydrology'])
end

python
