# Usefulness: Captures the combined effect of all three distances to represent multifactorial influences on forest cover.
df['Hydrology_Road_Fire_Weighted_Interaction'] = 3 / (1/(df['Horizontal_Distance_To_Hydrology'] + 1) + 1/(df['Horizontal_Distance_To_Fire_Points'] + 1) + 1/(df['Horizontal_Distance_To_Roadways'] + 1))

