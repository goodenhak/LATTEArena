python
# Feature: Sunlight_Aspect_Proximity
# Description: Combines weighted sunlight exposure with hydrology and road proximity to capture microclimatic variation.
# Usefulness: This feature emphasizes the interplay of sunlight, hydrology, and road access for vegetation growth and forest type distribution.
df['Sunlight_Aspect_Proximity'] = (
