df['Normalized_Sunlight_Slope'] = (
    (df['Hillshade_9am'] + df['Hillshade_Noоn'] + df['Hillshade_3pm']) *
    (df['Slope'] + 1)
)
df['Normalized_Sunlight_Slope'] = (df['Normalized_Sunlight_Slope'] - df['Normalized_Sunlight_Slope'].min()) / (
    df['Normalized_Sunlight_Slope'].max() - df['Normalized_Sunlight_Slope'].min())
end

