# Usefulness: This provides an adjusted measure of aggressiveness relative to the driver's age, which might correlate with accident outcomes.
df['Driver_Aggressiveness_Scaled'] = (
    df['Aggressive_Impact_Score'] / (df['Age_of_Driver'] + 1)
)

# Vehicle_Latitude_Longitude_Cluster
# Combines Latitude and Longitude to categorize accidents into geographical clusters.
# Usefulness: Geographical clusters might reveal trends in accident occurrence related to environmental conditions or road infrastructure.
from sklearn.cluster import KMeans
kmeans = KMeans(n_clusters=5, random_state=42)  # Example: 5 clusters based on spatial data.
df['Vehicle_Latitude_Longitude_Cluster'] = kmeans.fit_predict(df[['Latitude', 'Longitude']])

# Engine_Age_Weighted_Interaction
# Creates a weighted interaction between Engine_Age_Reliability and Age_of_Vehicle.
# Usefulness: Captures how vehicle reliability changes with age, which could influence accident circumstances.
df['Engine_Age_Weighted_Interaction'] = (
    df['Engine_Age_Reliability'] * df['Age_of_Vehicle']
)

# Urban_Casualty_Adjusted_Index
# Combines Urban_or_Rural_Area with Spatial_Casualty_Density for an adjusted urban/rural density index.
# Usefulness: Helps differentiate accident severity in urban vs. rural areas based on density.
df['Urban_Casualty_Adjusted_Index'] = (
    df['Spatial_Casualty_Density'] / (df['Urban_or_Rural_Area'] + 1)
)

# Driver_Preference_Index
# Combines Vehicle_Type_Category and Propulsion_Code to create a score reflecting driver preferences of vehicle type and fuel type.
# Usefulness: Vehicle preferences can indicate correlations with driver demographics, behavior, or accident likelihood.
vehicle_preference_mapping = {
    ('Light Vehicle', 1): 3.0,
    ('Light Vehicle', 2): 3.2,
    ('Medium Vehicle', 1): 2.5,
    ('Medium Vehicle', 2): 2.7,
    ('Heavy Vehicle', 1): 1.0,
    ('Heavy Vehicle', 2): 1.2
}
df['Driver_Preference_Index'] = df.apply(
    lambda row: vehicle_preference_mapping.get(
        (row['Vehicle_Type_Category'], row['Propulsion_Code']), 0
    ),
    axis=1
)

# Driver_Age_Group_Banding
# Converts Driver_Age_Group into numerical grades for simplified analysis.
# Usefulness: Numerical formats make the feature directly interpretable for machine learning models.
age_group_mapping = {
    'Youth': 1,
    'Adult': 2,
    'Mature Adult': 3,
    'Senior': 4
}
df['Driver_Age_Group_Banding'] = df['Driver_Age_Group'].map(age_group_mapping)

# Socioeconomic_Region_Normalized_Score
# Combines Socioeconomic_Police_Score and Region_Socioeconomic_Variability using z-score normalization.
# Usefulness: Provides a normalized socioeconomic score for combining local and regional effects on accident likelihood.
df['Socioeconomic_Region_Normalized_Score'] = (
    (df['Socioeconomic_Police_Score'] - df['Socioeconomic_Police_Score'].mean()) / df['Socioeconomic_Police_Score'].std()
) + (
    (df['Region_Socioeconomic_Variability'] - df['Region_Socioeconomic_Variability'].mean()) / df['Region_Socioeconomic_Variability'].std()
)

# Vehicle_Categories_Performance_Index
# Computes an index combining Vehicle_Type_Category, Engine_Capacity_(CC), and Aggressive_Impact_Score.
# Usefulness: Categorizes vehicle dynamics and performance relative to accident severity factors.
df['Vehicle_Categories_Performance_Index'] = (
    df['Engine_Capacity_(CC)'] * df['Aggressive_Impact_Score'] / (df['Vehicle_Type_Category'].nunique() + 1)
)

# Driver_Age_by_Manoeuvre
# Division of Age_of_Driver by Vehicle_Manoeuvre, adjusted for log transformation to prevent skewness.
# Usefulness: Combines driver age with maneuver complexity as an indicator of age-related driving patterns.
df['Driver_Age_by_Manoeuvre'] = np.log10(df['Age_of_Driver'] / (df['Vehicle_Manoeuvre'] + 1))

# Same_Socioeconomic_Age_Interaction
# Binary feature indicating whether Driver_Socioeconomic_Adjusted_Age falls within a specific socioeconomic age range.
# Usefulness: Simplifies interactions involving age and socioeconomic conditions.
df['Same_Socioeconomic_Age_Interaction'] = (
    (df['Driver_Socioeconomic_Adjusted_Age'] > 50) & (df['Driver_Socioeconomic_Adjusted_Age'] < 500)
).astype(int)

# Engine_Capacity_Bucket
# Groups Engine_Capacity_(CC) into buckets representing small, medium, large, and extra-large engines.
# Usefulness: Simplifies engine capacity complexity while retaining meaningful segmentation.
engine_bins = [0, 1200, 2000, 4000, 18000]
engine_labels = ['Small', 'Medium', 'Large', 'Extra-Large']
df['Engine_Capacity_Bucket'] = pd.cut(df['Engine_Capacity_(CC)'], bins=engine_bins, labels=engine_labels, right=False)

# Driver_Reliability_Adjusted_Score
# Adjusts Driver_Reliability_Score with Aggressiveness_Per_Casualty to capture aggressive behavior effects on reliability.
# Usefulness: Combines reliability and aggressiveness to differentiate drivers with more stable driving patterns.
df['Driver_Reliability_Adjusted_Score'] = (
