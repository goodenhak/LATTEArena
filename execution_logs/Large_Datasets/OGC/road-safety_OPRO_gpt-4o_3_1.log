# Vehicle_Age_Group
# Feature Description: This column categorizes Age_of_Vehicle into manageable bins based on ranges (e.g., Very New, Moderately Used, Old, Very Old).
# Usefulness: Binning Age_of_Vehicle into logical buckets allows categorical comparison across similar vehicles and reduces noise for predicting the sex of drivers.
df['Vehicle_Age_Group'] = pd.cut(df['Age_of_Vehicle'], 
                                 bins=[0, 5, 10, 20, 100], 
                                 labels=['Very New', 'Moderately Used', 'Old', 'Very Old'])

# Experience_Per_Casualty
# Feature Description: Divides Driver_Experience_Index by the number of casualties.
# Usefulness: Captures how a driver's experience is distributed among the number of people affected, providing a proxy of driver skill during incident handling.
df['Experience_Per_Casualty'] = df['Driver_Experience_Index'] / (df['Number_of_Casualties'].replace(0, 1))

# Vehicle_Type_Engine_Ratio
# Feature Description: Combines Vehicle_Type and Engine_Capacity_(CC) into a multiplicative ratio for specific vehicle types.
# Usefulness: Indicates the type of vehicle and its associated engine capacity, which might indirectly correlate with driver preferences and hence sex.
df['Vehicle_Type_Engine_Ratio'] = df['Engine_Capacity_(CC)'] / (df['Vehicle_Type'].replace(0, 1))

# Driver_Socioeconomic_Aggregated_Age
# Feature Description: Interaction between Driver_Socioeconomic_Adjusted_Age and Age_of_Driver.
# Usefulness: Captures how socioeconomic skew influences the driver's effective age profile adjusted for their real age.
df['Driver_Socioeconomic_Aggregated_Age'] = df['Driver_Socioeconomic_Adjusted_Age'] * df['Age_of_Driver']

# Aggressiveness_Per_Mean_Socioeconomic_Score
# Feature Description: Captures Aggressive_Impact_Score normalized by the mean socioeconomic police score of the region.
# Usefulness: Provides a dynamic aggressiveness measure influenced by regional socioeconomic variability, possibly revealing behavioral patterns linked to sex.
df['Aggressiveness_Per_Mean_Socioeconomic_Score'] = (
    df['Aggressive_Impact_Score'] / (df['Socioeconomic_Police_Score'].replace(0, 1))
)

# Driver_Spatial_Socioeconomic_Impact
# Feature Description: Combines Spatial_Socioeconomic_Impact with Aggressive_Impact_Score.
# Usefulness: Captures the regional impact of socioeconomic conditions on driver aggressiveness.
df['Driver_Spatial_Socioeconomic_Impact'] = (
    df['Spatial_Socioeconomic_Impact'] * df['Aggressive_Impact_Score']
)

# Driver_Age_Bin
# Feature Description: Buckets Age_of_Driver into broad demographic groups based on meaningful categories.
# Usefulness: Simplifies the feature to directly compare age groups that might correspond to behavioral or experiential differences.
df['Driver_Age_Bin'] = pd.cut(df['Age_of_Driver'], bins=[0, 18, 25, 35, 50, 100],
                              labels=['Teenage', 'Young Adult', 'Adult', 'Middle Aged', 'Senior'])

# Normalized_Casualty_Density
# Feature Description: Min-max scales the Spatial_Casualty_Density to standardize its range.
# Usefulness: Ensures fair comparison and reduces the influence of extreme outliers.
df['Normalized_Casualty_Density'] = (df['Spatial_Casualty_Density'] - df['Spatial_Casualty_Density'].min()) / (
    df['Spatial_Casualty_Density'].max() - df['Spatial_Casualty_Density'].min())

# Combined_Driver_Vehicle_Age_Index
# Feature Description: Calculates a weighted average of Age_of_Driver and Age_of_Vehicle.
# Usefulness: Reveals patterns that show how the combination of a driver and vehicle's age relates to sex.
df['Combined_Driver_Vehicle_Age_Index'] = (0.7 * df['Age_of_Driver'] + 0.3 * df['Age_of_Vehicle'])

# Road_Aggressiveness_Index
# Feature Description: Interaction between Aggressiveness_Per_Casualty and Road_Type_Effectiveness.
# Usefulness: Captures location-specific aggressive behavior in relation to how road types influence accidents.
df['Road_Aggressiveness_Index'] = df['Aggressiveness_Per_Casualty'] * df['Road_Type_Effectiveness']

# Driver_Experience_Per_Engine_Reliability
# Feature Description: Ratio of Driver_Experience_Index to Engine_Age_Reliability for assessing experience in handling a reliable vehicle.
# Usefulness: Ensures that vehicles with higher reliability do not distort driver experience ratings, which might correlate with sex.
df['Driver_Experience_Per_Engine_Reliability'] = (
    df['Driver_Experience_Index'] / (df['Engine_Age_Reliability'].replace(0, 1))
)

# Gender_Age_Class_Interaction
# Feature Description: Interaction between Driver_Age_Bin and Sex_of_Casualty.
# Usefulness: Investigates if specific age groups combined with the casualty's gender provide a signal to predict the driver's sex.
df['Gender_Age_Class_Interaction'] = df['Sex_of_Casualty'].astype(str) + '_' + df['Driver_Age_Bin'].astype(str)

# Vehicle_Age_Impact
# Feature Description: Ratio of Vehicle_Reliability_Index to Age_of_Vehicle.
# Usefulness: Indicates whether vehicle reliability, normalized by age, reveals patterns indirectly tied to driver sex.
df['Vehicle_Age_Impact'] = df['Vehicle_Reliability_Index'] / (df['Age_of_Vehicle'].replace(0, 1))
end

