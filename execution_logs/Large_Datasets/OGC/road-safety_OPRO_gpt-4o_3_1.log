    df['Aggressiveness_Per_Casualty'] / (df['Number_of_Casualties'] + 1)
)

# Driver_Familiarity_Score
# Combines Driver_Experience_Index and Driver_Socioeconomic_Adjusted_Age into a familiarity score.
