df['Driver_Latitude_Normalized'] = (df['Latitude'] - df['Latitude'].min()) / (df['Latitude'].max() - df['Latitude'].min())

# Engine_to_IMD_Weighting
# Feature description: Weighted combination of engine capacity and IMD decile to capture socioeconomic and vehicle power influence.
# Usefulness: Weights engine power usage relative to socioeconomic deprivation scores, which might differ by gender preferences.
df['Engine_to_IMD_Weighting'] = (df['Engine_Capacity_(CC)'] * df['Casualty_IMD_Decile']) / (df['Age_of_Driver'] + 1)

