# A boolean feature that determines whether the ranks can form a straight. Handles edge cases like 10, Jack, Queen, King, Ace.
# Usefulness: Corrects edge cases for certain Straight and Royal Flush hands, improving data coverage.
def is_straight(row):
    sorted_ranks = sorted(row)
    # Handle regular straight (e.g., 1, 2, 3, 4, 5)
    if sorted_ranks == list(range(sorted_ranks[0], sorted_ranks[0] + 5)):
        return 1
    # Handle Ace-low straight (e.g., Ace, 2, 3, 4, 5)
    if sorted_ranks == [1, 10, 11, 12, 13]:
        return 1
    return 0
