# Feature: Suit-Pair Interaction Count
# Counts the number of pairs that also share the same suit in the hand.
# Usefulness: Helps refine predictions for Flush and Straight Flush patterns.
def count_suit_pair_interactions(df, suit_cols, rank_cols):
    count = 0
    for i in range(len(suit_cols) - 1):
        for j in range(i + 1, len(suit_cols)):
            if df[suit_cols[i]] == df[suit_cols[j]] and df[rank_cols[i]] == df[rank_cols[j]]:
                count += 1
    return count

df['suit_pair_interaction_count'] = df.apply(
    lambda row: count_suit_pair_interactions(row, suit_columns, rank_columns), axis=1
)
end

