# Feature: Standard Deviation of Suit Distribution
# Computes the standard deviation of the frequency distribution of suits.
# Usefulness: Differentiates between hands with balanced suit distributions and those dominated by a single suit (e.g., Flush hands).
def suit_std(row):
    suit_counts = list(Counter(row).values())
    return np.std(suit_counts)
df['suit_std'] = df[suit_columns].apply(suit_std, axis=1)
end

