# Feature: Rank Consecutive Gaps
# Computes the list of gaps (differences) between consecutive ranks in sorted order.
# Usefulness: Captures detailed sequential patterns in ranks, crucial for detecting Straights and gaps between cards.
def rank_consecutive_gaps(row):
    sorted_ranks = sorted(row)
    return [sorted_ranks[i+1] - sorted_ranks[i] for i in range(len(sorted_ranks) - 1)]
df['rank_consecutive_gaps'] = df[rank_columns].apply(rank_consecutive_gaps, axis=1)
