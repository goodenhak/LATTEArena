# min_rank_gap
# Calculates the smallest gap (absolute difference) between any two ranks in the hand.
# Usefulness: A small rank gap in a hand could be indicative of hands that are closer to forming Straights or other rank-centric patterns.
def min_rank_gap(card_ranks):
    sorted_ranks = sorted(card_ranks)
    return min([sorted_ranks[i+1] - sorted_ranks[i] for i in range(len(sorted_ranks) - 1)])
df['min_rank_gap'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: min_rank_gap(x), axis=1)
