# Feature: Suit Rank Interaction Entropy
# Computes the entropy of the joint distribution of suits and ranks.
# Usefulness: Captures interaction patterns between suits and ranks, helping to distinguish between hands like Straight Flush and unrelated hands.
def suit_rank_entropy(row):
    suit_rank_pairs = list(zip(row[suit_columns], row[rank_columns]))
    suit_rank_counts = Counter(suit_rank_pairs)
    probabilities = np.array(list(suit_rank_counts.values())) / len(suit_rank_pairs)
    return entropy(probabilities)
df['suit_rank_entropy'] = df.apply(suit_rank_entropy, axis=1)
end

