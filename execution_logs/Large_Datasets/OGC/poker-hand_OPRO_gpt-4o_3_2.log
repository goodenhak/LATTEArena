# Feature: Rank Frequency Encoding
# Encodes the frequency of each rank into a summary vector that captures the distribution of ranks in the hand.
# Usefulness: Helps in identifying key hand types such as One Pair, Two Pairs, Three of a Kind, Full House, and Four of a Kind.
def rank_freq(row):
    counts = [0] * 13  # Initialize frequency for ranks (Ace to King)
    for r in row:
        counts[r - 1] += 1
    return counts

df['rank_freq_vector'] = df[rank_columns].apply(rank_freq, axis=1)
end

