# suit_skewness
# Calculates the skewness of the suit distribution.
# Usefulness: Captures asymmetry in the suit distribution, which aids in identifying hands moving toward Flushes versus more balanced suit combinations.
from scipy.stats import skew
df['suit_skewness'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(lambda x: skew(pd.Series(x).value_counts().values), axis=1)
end

