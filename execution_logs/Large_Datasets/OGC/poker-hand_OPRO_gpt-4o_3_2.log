# max_consecutive_rank_count
# The maximum number of consecutive ranks in the hand.
# Usefulness: Helps detect potential Straights or subsets of a Straight Flush. The maximum consecutive count of ranks determines if the hand is close to forming a sequence.
def consecutive_count(card_ranks):
    sorted_ranks = sorted(card_ranks)
    count = max_consecutive = 1
    for i in range(1, len(sorted_ranks)):
        if sorted_ranks[i] - sorted_ranks[i - 1] == 1:
            count += 1
            max_consecutive = max(max_consecutive, count)
        else:
            count = 1
    return max_consecutive
df['max_consecutive_rank_count'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: consecutive_count(x), axis=1)
end

python
# rank_variance
# The variance of card ranks in the hand.
# Usefulness: Lower rank variance captures proximity in ranks, essential for identifying patterns in potential Straights, Flush-based hands, or groups of ranks.
df['rank_variance'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].var(axis=1)
end

