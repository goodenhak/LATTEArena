# suit_rank_fraction
# Determines the fraction of cards belonging to the majority suit that also have ranks greater than or equal to 10.
# Usefulness: Highlights patterns in high-value cards for Flush-related or Royal Flush hands.
def suit_rank_fraction(row):
    suits = row[['V1', 'V3', 'V5', 'V7', 'V9']]
    ranks = row[['V2', 'V4', 'V6', 'V8', 'V10']]
    majority_suit = suits.mode().iloc[0]
    high_ranks_in_majority_suit = sum(
        1 for i in range(len(suits)) if suits.iloc[i] == majority_suit and ranks.iloc[i] >= 10
    )
    return high_ranks_in_majority_suit / 5
df['suit_rank_fraction'] = df.apply(suit_rank_fraction, axis=1)
end

python
# suit_distribution_score
# Calculates the sum of squared suit counts (frequency of each suit squared).
# Usefulness: Penalizes hands with diverse suits, rewarding hands with concentrated suit patterns like Flushes.
df['suit_distribution_score'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(
    lambda suits: sum(count2 for count in suits.value_counts()), axis=1
)
end

