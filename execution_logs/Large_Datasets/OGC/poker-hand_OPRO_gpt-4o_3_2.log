# Usefulness: Hands with wide rank ranges may correspond to specific poker patterns like Straights or high-card-based hands.
df['rank_range_extent'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda x: max(x) - min(x), axis=1
)
end

