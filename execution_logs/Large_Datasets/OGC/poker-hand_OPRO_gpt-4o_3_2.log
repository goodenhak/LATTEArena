# Computes a binary feature indicating if the gaps between sorted ranks match the perfect Straight pattern: [1, 1, 1, 1].
# Usefulness: Directly identifies Straight hands without needing complex pattern matching logic.
def is_perfect_straight(row):
    sorted_ranks = sorted(row)
    gaps = [sorted_ranks[i + 1] - sorted_ranks[i] for i in range(len(sorted_ranks) - 1)]
    return 1 if gaps == [1, 1, 1, 1] else 0
df['is_perfect_straight'] = df[rank_columns].apply(is_perfect_straight, axis=1)
