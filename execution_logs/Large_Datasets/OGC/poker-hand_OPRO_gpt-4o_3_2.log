# Computes the degree of similarity between suits in the hand, using cosine similarity among suit vectors.
# Usefulness: Highlights potential Flushes by quantifying suit alignment using a similarity metric.
from sklearn.metrics.pairwise import cosine_similarity
def flush_similarity(row):
    suits = [row['V1'], row['V3'], row['V5'], row['V7'], row['V9']]
