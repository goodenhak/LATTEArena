# Feature: Check for Royal Flush Pattern
# Determines whether the hand contains the exact ranks for a Royal Flush ({10, Jack, Queen, King, Ace}) within one suit and identifies it as 1 if true, otherwise 0.
# Usefulness: Directly identifies Royal Flush hands, which are rare and have specific criteria.
def is_royal_flush(row):
    required_ranks = {1, 10, 11, 12, 13}  # Ranks for Royal Flush
    suits = {row['V1'], row['V3'], row['V5'], row['V7'], row['V9']}
    ranks = {row['V2'], row['V4'], row['V6'], row['V8'], row['V10']}
    return 1 if ranks == required_ranks and len(suits) == 1 else 0
df['is_royal_flush'] = df.apply(is_royal_flush, axis=1)
end

