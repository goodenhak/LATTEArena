# suit_rank_cross_entropy
# Computes the cross entropy between suits and ranks to quantify the combined structure of suits and ranks in the hand.
# Usefulness: Highlights dependencies between suits and ranks, which are critical for identifying certain patterns like Flushes, Royal Flushes, and Straight Flushes.
from scipy.stats import entropy
def suit_rank_cross_entropy(row):
    suits = row[['V1', 'V3', 'V5', 'V7', 'V9']].values
    ranks = row[['V2', 'V4', 'V6', 'V8', 'V10']].values
    suit_rank_pairs = [f{suit}-{rank} for suit, rank in zip(suits, ranks)]
    freq = pd.Series(suit_rank_pairs).value_counts(normalize=True)
    entropy_val = entropy(freq)
    return entropy_val

df['suit_rank_cross_entropy'] = df.apply(suit_rank_cross_entropy, axis=1)
end

python
# unique_rank_pair_count
# Counts the number of unique pairs of ranks in the hand.
# Usefulness: Helps detect patterns associated with hands like Two Pairs, Full House, or Four of a Kind, which involve repetition of specific ranks.
def unique_rank_pair_count(row):
    ranks = row[['V2', 'V4', 'V6', 'V8', 'V10']].values
    rank_counts = pd.Series(ranks).value_counts()
    return sum(rank_counts == 2)

df['unique_rank_pair_count'] = df.apply(unique_rank_pair_count, axis=1)
end

python
# rank_high_low_gap
# Calculates the difference between the highest and lowest ranks in the hand.
# Usefulness: Indicates the spread of card ranks in the hand, which helps identify patterns relevant for Straights or Straight Flushes.
df['rank_high_low_gap'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: max(x) - min(x), axis=1)
end

python
# max_suit_repeat_count
# Finds the maximum number of cards with the same suit.
# Usefulness: Highlights the potential for Flushes, which depend on having multiple cards of the same suit.
df['max_suit_repeat_count'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(lambda x: max(x.value_counts()), axis=1)
end

python
# distance_to_royal_flush
# Calculates the distance of a hand's ranks to a perfect Royal Flush (Ace, King, Queen, Jack, Ten).
# Usefulness: Quantifies how close a hand is to forming a Royal Flush, explicitly focusing on the highest-ranking hand in poker.
def distance_to_royal_flush(row):
    royal_flush_ranks = {1, 10, 11, 12, 13}  # Ace, Ten, Jack, Queen, King
    hand_ranks = set(row[['V2', 'V4', 'V6', 'V8', 'V10']])
    return len(royal_flush_ranks - hand_ranks)

df['distance_to_royal_flush'] = df.apply(distance_to_royal_flush, axis=1)
end

python
# suit_spread_score
# Calculates the difference between the number of unique suits and the most frequent suit count.
# Usefulness: Highlights hands that have a skewed suit distribution, which is relevant for Flushes or hands with diverse suits.
def suit_spread_score(row):
    suits = row[['V1', 'V3', 'V5', 'V7', 'V9']].values
    unique_count = len(set(suits))
    max_count = max(pd.Series(suits).value_counts())
    return unique_count - max_count

df['suit_spread_score'] = df.apply(suit_spread_score, axis=1)
end

