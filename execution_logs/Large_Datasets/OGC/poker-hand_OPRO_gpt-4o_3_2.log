# Feature: Consecutive Rank Differences
# Computes the differences between sorted ranks to find consistent gaps (e.g., differences of 1 indicate consecutive cards).
# Usefulness: Helps identify straight patterns, including edge cases like Ace-low straight.
def consecutive_differences(row):
    sorted_ranks = sorted(row)  # Sort the ranks
    return [sorted_ranks[i + 1] - sorted_ranks[i] for i in range(len(sorted_ranks) - 1)]

df['consec_rank_diffs'] = df[rank_columns].apply(consecutive_differences, axis=1)
end

python
