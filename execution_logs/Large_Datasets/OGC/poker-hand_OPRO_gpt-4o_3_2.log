# royal_flush_proximity_score
# Counts how many cards are simultaneously part of a Royal Flush rank set and share the same suit.
# Usefulness: Quantifies closeness to forming Royal Flush hands based on both rank and suit.
def royal_flush_proximity(row):
    royal_ranks = {10, 11, 12, 13, 1}
    suits = row[['V1', 'V3', 'V5', 'V7', 'V9']]
    ranks = row[['V2', 'V4', 'V6', 'V8', 'V10']]
    suit_counts = suits.value_counts()
    max_suit = suit_counts.idxmax()
    royal_flush_cards = sum(
        1 for i in range(len(suits)) if suits.iloc[i] == max_suit and ranks.iloc[i] in royal_ranks
    )
    return royal_flush_cards
df['royal_flush_proximity_score'] = df.apply(royal_flush_proximity, axis=1)
end

python
# rank_gap_mean
# Calculates the mean absolute difference between ranks in the sorted hand.
# Usefulness: Captures rank spread more smoothly than sum, providing insight into sequential rank distribution.
def rank_gap_mean(card_ranks):
    sorted_ranks = sorted(card_ranks)
    gaps = [sorted_ranks[i + 1] - sorted_ranks[i] for i in range(len(sorted_ranks) - 1)]
    return np.mean(gaps)
df['rank_gap_mean'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda x: rank_gap_mean(x), axis=1
)
end

python
# adjusted_full_house_indicator
# Binary indicator signaling whether the hand perfectly matches a Full House pattern.
# Usefulness: Focuses on a critical poker pattern to predict the target class more accurately.
def adjusted_full_house_indicator(card_ranks):
    rank_counts = pd.Series(card_ranks).value_counts()
    return int((rank_counts == 3).sum() == 1 and (rank_counts == 2).sum() == 1)
df['adjusted_full_house_indicator'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda x: adjusted_full_house_indicator(x), axis=1
)
end

python
# suit_entropy
# Calculates the entropy of suit distribution in the hand.
# Usefulness: Measures randomness or uniformity in suit distribution, relevant for identifying Flush-like patterns.
def suit_entropy(card_suits):
    suit_counts = pd.Series(card_suits).value_counts(normalize=True)
    entropy = -sum(p * np.log2(p) for p in suit_counts)
    return entropy
df['suit_entropy'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(lambda x: suit_entropy(x), axis=1)
end

