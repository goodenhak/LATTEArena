# Feature: Is Straight
# A binary feature that determines if the hand contains a Straight (five consecutive ranks).
# Usefulness: Directly identifies the entirety of a critical poker hand category (Straight).
def is_straight(row):
    sorted_ranks = sorted(set(row))  # Remove duplicates first
    if len(sorted_ranks) < 5:  # Cannot be a straight if fewer than 5 unique ranks
        return 0
    for i in range(len(sorted_ranks) - 4):
        if sorted_ranks[i + 4] - sorted_ranks[i] == 4:
            return 1
    return 0

