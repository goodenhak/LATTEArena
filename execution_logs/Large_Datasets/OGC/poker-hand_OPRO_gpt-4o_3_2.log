# Feature: Suit and Rank Mode Frequency
# Calculates the mode frequency for suits and ranks combined, capturing whether any single card type dominates the hand.
# Usefulness: Highlights hands dominated by a specific card suit or rank, critical for detecting groups like Four of a Kind or Flushes.
from statistics import mode
def combined_mode_freq(row):
    combined = [f{suit}-{rank} for suit, rank in zip(
        [row['V1'], row['V3'], row['V5'], row['V7'], row['V9']],
        [row['V2'], row['V4'], row['V6'], row['V8'], row['V10']])]
    return max(Counter(combined).values())
df['combined_mode_freq'] = df.apply(combined_mode_freq, axis=1)
end

