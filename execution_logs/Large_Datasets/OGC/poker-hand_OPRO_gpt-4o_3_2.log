# Usefulness: Measures the variability of rank gaps, helping to identify smooth patterns like straights versus erratic distributions.
df['rank_difference_std'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda ranks: np.std(np.diff(sorted(ranks))), axis=1)
end

python
# adjusted_flush_score
# Feature description: Calculates the product of suit homogeneity and card richness using unique_rank_count.
# Usefulness: Incorporates both suit and rank diversity into a single metric to better detect flush patterns combined with varied ranks.
df['adjusted_flush_score'] = df['unique_suit_count'] / df['unique_rank_count']
end

python
# compact_suit_pattern
# Feature description: Concatenates suits into a compact string (e.g., H_H_S_D_S for pattern analysis).
# Usefulness: Facilitates analysis of suit patterns for advanced model usage or visualization purposes.
df['compact_suit_pattern'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(lambda suits: '_'.join(map(str, suits)), axis=1)
end

python
# high_rank_concentration_score
# Feature description: Calculates the proportion of ranks above a threshold (e.g., ≥10) in the hand.
# Usefulness: Flags hands dominated by high-value cards, aiding in detecting high-ranking poker hands like Royal Flushes, Straight Flushes, etc.
df['high_rank_concentration_score'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda ranks: sum(1 for r in ranks if r >= 10) / 5, axis=1)
end

python
# suit_difference_metric
# Feature description: Calculates the sum of absolute differences between consecutive suits.
# Usefulness: Quantifies suit variability for improving differentiation between mixed-suit hands and flush patterns.
df['suit_difference_metric'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(lambda suits: sum(abs(suits[i + 1] - suits[i]) for i in range(len(suits) - 1)), axis=1)
end

python
# low_rank_to_high_rank_ratio
# Feature description: Divides the number of ranks ≤5 by the number of ranks ≥10 within the hand. Avoids division by zero using a small epsilon (1e-6).
# Usefulness: Provides a balance metric between low and high ranks, useful for detecting hand polarization.
df['low_rank_to_high_rank_ratio'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda ranks: (sum(1 for r in ranks if r <= 5) / (sum(1 for r in ranks if r >= 10) + 1e-6)), axis=1
)
end

python
# sequential_rank_score
# Feature description: Calculates the proportion of ranks that are consecutive.
# Usefulness: Directly reflects the likelihood of straights or near-straight patterns, enhancing model performance for sequential hands.
df['sequential_rank_score'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda ranks: sum(1 for i in range(len(sorted(ranks)) - 1) if sorted(ranks)[i + 1] - sorted(ranks)[i] == 1) / 4, axis=1
)
end

python
# weighted_rank_entropy
# Feature description: Measures entropy for rank distribution weighted by rank concentration.
# Usefulness: Enhances rank diversity detection while factoring in repeated patterns, aiding model discrimination for mixed hands.
df['weighted_rank_entropy'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda ranks: -sum((ranks.count(r) / 5) * np.log2(ranks.count(r) / 5) for r in set(ranks) if ranks.count(r) > 0), axis=1)
end

python
# rank_fluctuation_rate
# Feature description: Calculates the fluctuation metric by dividing rank_distance_sum by unique_rank_count.
# Usefulness: Differentiates smooth rank distributions (e.g., straights) from erratic ones (e.g., mixed hands).
df['rank_fluctuation_rate'] = df['rank_distance_sum'] / df['unique_rank_count']
end

### Dropping irrelevant columns ###
python
df.drop(columns=['duplicate_suit_ratio', 'compact_hand_rank', 'zscore_normalized_rank_variance'], inplace=True)
end

