    suit_counts = Counter([row['V1'], row['V3'], row['V5'], row['V7'], row['V9']])
    probabilities = np.array(list(suit_counts.values())) / 5  # Total cards = 5
    return entropy(probabilities)
df['suit_entropy'] = df.apply(suit_entropy, axis=1)
