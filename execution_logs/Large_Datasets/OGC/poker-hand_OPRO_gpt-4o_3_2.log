# suit_ratio
# Feature description: Calculates the ratio of the number of unique suits to the total number of cards (always 5).
# Usefulness: Encodes the diversity of suits in a compact, normalized metric, helping differentiate flush-related vs. diverse-suit hands.
df['suit_ratio'] = df['unique_suit_count'] / 5
end

python
# normalized_rank_distance
# Feature description: Normalizes the rank_distance_sum by the unique_rank_count to account for hands with differing diversity.
# Usefulness: Identifies the smoothness of rank transitions while accounting for the number of unique ranks, improving the identification of straights and similar hands.
df['normalized_rank_distance'] = df['rank_distance_sum'] / (df['unique_rank_count'] + 1e-6)  # Adding epsilon to avoid division by zero
end

python
# full_house_potential
# Feature description: Captures potential for a full house by summing the proportions of two ranks (most and second-most frequent) in a hand.
# Usefulness: Highlights hands that are likely precursors to full houses by identifying strong rank concentration patterns.
from collections import Counter
df['full_house_potential'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda ranks: sum(sorted(Counter(ranks).values(), reverse=True)[:2]) / 5, axis=1)
end

python
# straight_gap_metric
# Feature description: Calculates the total number of gaps between consecutive ranks in a hand, normalized by the number of rank gaps (4 for 5 cards).
# Usefulness: Helps quantify how far a hand is from being sequential, aiding in predicting straights and near-straight hands.
df['straight_gap_metric'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda ranks: sum(max(0, sorted(ranks)[i + 1] - sorted(ranks)[i] - 1) for i in range(4)) / 4, axis=1)
end

python
# high_card_presence
# Feature description: Binary flag indicating if the hand contains a card with rank ≥ 11 (Jack, Queen, King, Ace).
# Usefulness: Highlights hands with high-value cards, useful for discriminating high-value poker hands like Royal Flushes and Strong Full Houses.
df['high_card_presence'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda ranks: int(any(rank >= 11 for rank in ranks)), axis=1)
end

python
# low_card_presence
# Feature description: Binary flag indicating if the hand contains a card with rank ≤ 5.
# Usefulness: Adds contrast to high_card_presence by highlighting hands with low-value cards, aiding in the identification of mixed-value hands.
df['low_card_presence'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda ranks: int(any(rank <= 5 for rank in ranks)), axis=1)
end

python
# suit_smoothness
# Feature description: Calculates the mean of absolute differences between consecutive card suits in sorted order.
# Usefulness: Quantifies suit variation as a continuous metric, helping identify non-flush hands or hands with suit diversity.
df['suit_smoothness'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(
    lambda suits: np.mean([abs(suits[i + 1] - suits[i]) for i in range(4)]), axis=1)
end

python
# high_rank_pair_indicator
# Feature description: Binary indicator for whether the hand includes at least one pair of high-value cards (rank >= 10).
# Usefulness: Improves identification of valuable poker hands that build on pairs involving strong ranks.
df['high_rank_pair_indicator'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
