# inverse_rank_total
# Sums the inverse of all card ranks.
# Usefulness: Penalizes hands with high card values while amplifying the impact of low cards, providing insight into low-value hands.
df['inverse_rank_total'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: sum(1 / rank for rank in x), axis=1)
end

