df['suit_rank_ratio_variance'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(
    lambda suits: np.var([rank / suit if suit != 0 else 0 for rank, suit in zip([df['V2'], df['V4'], df['V6'], df['V8'], df['V10']], suits)]), axis=1)
end

