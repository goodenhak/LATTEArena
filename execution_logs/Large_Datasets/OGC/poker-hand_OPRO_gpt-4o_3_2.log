# adjusted_two_pair_flag
# Binary flag indicating whether the hand has exactly two pairs of distinct ranks.
# Usefulness: Strong predictor for Two Pair hands, directly focusing on rank patterns relevant to the target class.
def adjusted_two_pair_flag(card_ranks):
    rank_counts = pd.Series(card_ranks).value_counts()
    return int((rank_counts == 2).sum() == 2)
df['adjusted_two_pair_flag'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda x: adjusted_two_pair_flag(x), axis=1
)
