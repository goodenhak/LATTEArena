# rank_position_vector
# Feature description: Encodes the positional rank differences between consecutive cards into a vector. Helps detect sequences and near-sequential patterns.
# Usefulness: Enables the identification of structured hands like Straights or identifying hands one card away from a Straight.
df[['rank_diff1', 'rank_diff2', 'rank_diff3', 'rank_diff4']] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: [row[i+1] - row[i] for i in range(len(row)-1)], axis=1, result_type='expand'
)

# harmonic_sequence_density
# Feature description: Computes the density of the harmonic mean of the rank differences to emphasize near-sequences with low variance gaps.
# Usefulness: Offers a numeric measure for smoothness in rank progression, aiding sequential hand recognition.
df['harmonic_sequence_density'] = df[['rank_diff1', 'rank_diff2', 'rank_diff3', 'rank_diff4']].apply(
    lambda row: len(row) / sum(1.0 / diff if diff != 0 else 1e-3 for diff in row), axis=1
)

# suit_homogeneity_index
# Feature description: Calculates the entropy of suit distributions in the hand to measure randomness in suit allocation.
# Usefulness: Low entropy indicates strong suit clustering (Flush); high entropy suggests suit diversity.
from scipy.stats import entropy
df['suit_homogeneity_index'] = df[['suit1', 'suit2', 'suit3', 'suit4', 'suit5']].apply(
    lambda row: entropy([row.count(suit) for suit in set(row)]), axis=1
)

# prime_rank_density
# Feature description: Counts the number of prime ranks in the hand and normalizes it by the total number of cards.
# Usefulness: Highlights hands where prime ranks are dominant, helping to identify rare configurations in the deck.
df['prime_rank_density'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: sum(rank in [2, 3, 5, 7, 11, 13] for rank in row) / len(row), axis=1
)

# weighted_pairwise_rank_alignment
# Feature description: Computes the weighted alignment score by comparing each rank with pairs of adjacent ranks, penalizing mismatches.
# Usefulness: Helps capture misaligned rank clusters that may indicate pairs, triplets, or straights.
df['weighted_pairwise_rank_alignment'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: sum(abs(row[i] - row[j]) for i in range(len(row)) for j in range(i+1, len(row))), axis=1
)

# adjusted_rank_centrality
# Feature description: Takes the median rank and computes its deviation weighted by the rank sum.
# Usefulness: Measures centrality and magnitude of ranks relative to the hand's overall rank scale, distinguishing structured from random hands.
df['adjusted_rank_centrality'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: abs(np.median(row) - np.mean(row)) * sum(row), axis=1
)

# cross_suit_rank_interaction
# Feature description: Captures joint alignment patterns between suits and ranks by calculating the ratio of suit counts to rank deviations.
# Usefulness: Deepens interpretability of suit-rank interaction patterns, critical for Flush and structured hand detection.
df['cross_suit_rank_interaction'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5', 'suit1', 'suit2', 'suit3', 'suit4', 'suit5']].apply(
    lambda row: (len(set(row[-5:])) / max(1, len(set(row[:5])))) * sum(abs(row[i] - row[i+5]) for i in range(5)), axis=1
)

# logarithmic_high_rank_centrality
# Feature description: Applies a logarithmic transformation to the sum of high card ranks and weights it by the normalized standard deviation.
# Usefulness: Focuses on high-ranking cards while reducing the impact of frequency outliers, improving differentiation for Royal Flush hands.
df['logarithmic_high_rank_centrality'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: np.log(sum(rank for rank in row if rank >= 10) + 1) / (np.std(row) + 1e-5), axis=1
)

# flush_modularity_score
# Feature description: Computes a modularity-inspired score by dividing suit clusters by their rank clusters.
# Usefulness: Captures the balance between suit and rank distribution, aiding classification of hybrid hands like Straight Flush.
df['flush_modularity_score'] = df[['suit1', 'suit2', 'suit3', 'suit4', 'suit5', 'rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: (sum(row.count(suit) for suit in set(row[:5]))) / (max(row[5:]) - min(row[5:])), axis=1
)

# dropping_redundant_log_harmonic_rank_mean
# Dropping redundant feature: log_harmonic_rank_mean
# Reason: Overlaps heavily with harmonic rank-based features like harmonic_sequence_density; no additional predictive power.
df.drop(columns=['log_harmonic_rank_mean'], inplace=True)

# dropping_redundant_flush_alignment_ratio
# Dropping redundant feature: flush_alignment_ratio
# Reason: Provides overlapping information with flush_modularity_score and cross_suit_rank_interaction, which are more enhanced features.
df.drop(columns=['flush_alignment_ratio'], inplace=True)
end
