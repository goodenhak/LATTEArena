# Usefulness: Refines the identification of hands with royal flush potential by combining multiple features in a way that accentuates patterns specific to this high-value scenario.
df['royal_flush_signal_strength'] = ((df['royal_flush_depth_adjusted'] * df['rank_diversity_score']).log()).zscore()
end

python
# pair_probability_indicator
# Feature description: Combines pair_clustering_metric, unique_mod_ratio, and abs_zscore_rank_mean. The values are multiplied and compressed using a sigmoid transformation, making it sensitive to pair-related probabilities while reducing noise.
# Usefulness: Enhances the identification of pairs within a hand by combining relevant features that correlate with repeated ranks and their distribution properties.
df['pair_probability_indicator'] = (df['pair_clustering_metric'] * df['unique_mod_ratio'] * df['abs_zscore_rank_mean']).sigmoid()
end

python
