# composite_sequential_alignment
# Feature description: Computes the weighted product of straight_focus_metric and rank_harmonic_zscore, adjusted by the sine of flush_depth_ratio, to emphasize sequential and suited alignment in hands.
# Usefulness: Helps detect hands with characteristics indicative of straights, straight flushes, or royal flushes by combining sequential and suit alignment factors.
df['composite_sequential_alignment'] = (df['straight_focus_metric'] * df['rank_harmonic_zscore']) * np.sin(df['flush_depth_ratio'])
end

python
# rank_power_amplification
# Feature description: Applies an exponential transformation to log_harmonic_rank_mean, modulated by the square of standardized_rank_diversity, to emphasize the contribution of small ranks with high diversity.
# Usefulness: Amplifies rank signals in diverse hands, helping to differentiate between low-ranking hands (e.g., nothing in hand) and sets with high-ranking diversity (e.g., two pairs, straight).
df['rank_power_amplification'] = np.exp(df['log_harmonic_rank_mean']) * (df['standardized_rank_diversity']  2)
end

python
# pair_synchronization_index
# Feature description: Combines pair_clustering_metric and high_rank_clustering_metric with cosine weighting to emphasize clustering trends in hands with pairs or full house potential.
# Usefulness: Highlights rank clustering indicative of pairs, two pairs, three of a kind, full house, and four of a kind.
df['pair_synchronization_index'] = np.cos(df['pair_clustering_metric'] + df['high_rank_clustering_metric'])
end

python
# straight_flush_alignment_score
# Feature description: Computes the product of rank_weighted_sequence and flush_depth_ratio, with a logarithmic transformation to mitigate extreme values, targeting straight flushes.
# Usefulness: Detects straight flush patterns by combining sequential rank alignment and suit consistency.
df['straight_flush_alignment_score'] = np.log1p(df['rank_weighted_sequence'] * df['flush_depth_ratio'])
end

python
# harmonic_suit_alignment
# Feature description: Calculates the harmonic mean of flush_depth_ratio and odd_even_balance_ratio to focus on hands with consistent suit distributions.
# Usefulness: Improves detection of flush hands by highlighting suit alignment while balancing against rank distribution patterns.
df['harmonic_suit_alignment'] = 2 / ((1 / (df['flush_depth_ratio'] + 1e-6)) + (1 / (df['even_odd_balance_ratio'] + 1e-6)))
end

python
# absolute_rank_deviation_alignment
# Feature description: Combines the absolute value of differences between rank_harmonic_zscore and zscore_rank_mean, while normalizing by rank_power_amplification to leverage deviations in rank harmony.
# Usefulness: Detects patterns of rank misalignment and amplifies the information with features that express rank diversity to highlight inconsistencies.
df['absolute_rank_deviation_alignment'] = np.abs(df['rank_harmonic_zscore'] - df['zscore_rank_mean']) / (df['rank_power_amplification'] + 1e-6)
end

python
# royal_flush_focus
# Feature description: Takes the product of royal_flush_probability and composite_sequential_alignment, applying a square root scaling to smooth out effects.
# Usefulness: Sharpens the model’s focus on royal flush detection by combining royal flush-specific features with strong sequential alignment patterns.
df['royal_flush_focus'] = np.sqrt(df['royal_flush_probability'] * df['composite_sequential_alignment'])
end

python
# straight_uniformity_score
# Feature description: Applies an exponential transformation to the inverse of straight_sequential_metric, modulated by odd_even_balance_ratio, to penalize inconsistencies in sequential rank alignment.
# Usefulness: Enhances sequential pattern detection while accounting for rank distribution and parity consistency.
df['straight_uniformity_score'] = np.exp(1 / (df['straight_sequential_metric'] + 1e-6)) * df['even_odd_balance_ratio']
end

python
# Dropping collinear feature: pair_clustering_metric
# Its core usefulness is now accounted for in pair_synchronization_index and straight_flush_alignment_score.
df.drop(columns=['pair_clustering_metric'], inplace=True)
end

python
