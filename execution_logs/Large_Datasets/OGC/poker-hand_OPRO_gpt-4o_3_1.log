# Usefulness: Highlights hands with tightly grouped ranks, useful for identifying Pairs, Full Houses, or potential Straights.
df['min_rank_diff'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda x: min([x[i+1] - x[i] for i in range(len(x)-1)]) if len(x) > 1 else 0,
    axis=1
)
end

python
# rank_entropy
# Computes the rank entropy, a measure of uncertainty or randomness in the rank distribution.
# Usefulness: Differentiates hands with more randomness in ranks (e.g., High Card hands) from hands with structured or repetitive ranks (e.g., Pairs, Straights, etc.).
import scipy.stats
df['rank_entropy'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda x: scipy.stats.entropy([x.count(rank) for rank in set(x)]), 
    axis=1
)
end

python
# is_straight_gap_free
# Binary feature: 1 if the ranks form a perfect Straight with no gaps, 0 otherwise.
# Usefulness: Directly identifies valid Straights or invalidates hands with rank gaps.
df['is_straight_gap_free'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda x: int(sorted(x)[-1] - sorted(x)[0] == 4 and len(set(x)) == 5),
    axis=1
)
end

python
# suit_dispersion
# Measures the dispersion of suits using a normalized variance metric.
# Usefulness: Identifies hands with more evenly distributed suits versus hands dominated by a single suit (e.g., Flush potential).
df['suit_dispersion'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(
    lambda x: len(set(x)) / max(1, sum(abs(x.count(suit) - len(x)/4) for suit in set(x))),
    axis=1
)
end

python
# mean_distance_from_center
# Calculates the mean distance of each rank from the midpoint of the rank range (7 in this case).
# Usefulness: Highlights hands with extreme ranks (low or high) versus ones centered around the middle.
df['mean_distance_from_center'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda x: sum(abs(rank - 7) for rank in x) / len(x),
    axis=1
)
end

python
# rank_duplicate_factor
# Computes a weighted factor based on the count of duplicate ranks.
# Usefulness: Distinguishes hands with repeating ranks (e.g., Pairs, Full Houses) from those without repetition.
df['rank_duplicate_factor'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda x: sum(x.count(rank)2 for rank in set(x)) - len(x),
    axis=1
)
end

python
# max_suit_cumulative_sum
# Computes the cumulative sum of ranks for the most dominant suit.
# Usefulness: Combines suit frequency and rank dominance into one feature, critical for detecting strong Flush hands.
df['max_suit_cumulative_sum'] = df[['V1', 'V3', 'V5', 'V7', 'V9', 'V2', 'V4', 'V6', 'V8', 'V10']].apply(
    lambda row: sum(rank for suit, rank in zip(row[::2], row[1::2]) if suit == max(set(row[::2]), key=row[::2].count)),
    axis=1
)
end

python
# Drop less significant columns (optional; selective removal based on feature interaction)
df.drop(columns=['V1', 'V3', 'V5', 'V7', 'V9'], inplace=True)
end

### Explanation of Additions:
1. Entropy, Dispersion, and Duplicate Factors: These statistical metrics capture rank and suit uncertainty or concentration, assisting in distinguishing structured hands (like Flushes, Full Houses) from less structured ones.
2. Gap, Dispersion, and Straight Detection: Features like min_rank_diff or is_straight_gap_free directly inspect sequential patterns critical for Straights or Royal Flushes.
3. Cumulative Suit Calculations: Emphasizing dominant suits or combining suit frequency with ranks leverages critical signals for Flush-related hands.
4. Distance from Center: Differentiates rank spread across the range (e.g., low-value combinations vs. high-value clusters).

These features aim to exploit higher-level patterns and interactions between suit and rank for better predictive performance.
