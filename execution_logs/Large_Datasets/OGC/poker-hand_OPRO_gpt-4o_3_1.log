# max_suit_count_percentage
# Feature description: Calculates the percentage of cards in the hand that share the most common suit.
# Usefulness: Provides a normalized measure of suit clustering, which is crucial for identifying Flush and related hands.
df['max_suit_count_percentage'] = df.apply(
    lambda row: max(row[['suit1', 'suit2', 'suit3', 'suit4', 'suit5']].value_counts()) / 5, axis=1
)

# sequential_pair_gaps
# Feature description: Identifies gaps between consecutive ranks and sums the number of gaps equal to 1.
# Usefulness: Highlights hands that are closer to sequential ranks, aiding in the detection of Straights and Straight Flushes.
df['sequential_pair_gaps'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: sum(1 for i in range(len(row) - 1) if sorted(row)[i + 1] - sorted(row)[i] == 1), axis=1
)

# large_gap_penalty_score
# Feature description: Computes the sum of gaps between consecutive ranks, focusing on gaps larger than 1 to penalize non-sequential hands.
# Usefulness: Penalizes large rank gaps, helping to identify structured hands with smaller rank differences like Straights.
df['large_gap_penalty_score'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: sum((sorted(row)[i + 1] - sorted(row)[i])  2 for i in range(len(row) - 1) if sorted(row)[i + 1] - sorted(row)[i] > 1), axis=1
)

# rank_count_entropy
# Feature description: Calculates the Shannon entropy of the rank distribution in the hand.
# Usefulness: A lower entropy indicates concentrated rank clusters, while higher entropy suggests diverse ranks. Useful for identifying structured vs. random hands.
from scipy.stats import entropy
df['rank_count_entropy'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: entropy([row.count(rank) for rank in set(row)]), axis=1
)

# mod_alternation_count
# Feature description: Counts the number of transitions between even and odd ranks in a hand.
# Usefulness: Captures alternating patterns in rank parity, which can indicate structured hands like Straights.
df['mod_alternation_count'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: sum((rank % 2) != (next_rank % 2) for rank, next_rank in zip(sorted(row), sorted(row)[1:])), axis=1
)

# suit_pairwise_distance_score
# Feature description: Computes the pairwise sum of absolute differences between card suits, emphasizing suit diversity.
# Usefulness: Differentiates uniform hands (Flush) from diverse ones by penalizing inconsistent suit distributions.
df['suit_pairwise_distance_score'] = df[['suit1', 'suit2', 'suit3', 'suit4', 'suit5']].apply(
    lambda row: sum(
        abs(row[i] - row[j]) for i in range(len(row)) for j in range(i + 1, len(row))
    ), axis=1
)

# weighted_sequential_growth
# Feature description: Calculates a weighted score based on the rank gaps in sequence, giving higher weight to smaller gaps.
# Usefulness: Focuses on hands that are naturally closer to sequential ranks, aiding in Straight identification.
df['weighted_sequential_growth'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: sum((1 / (gap + 1)) for gap in [sorted(row)[i + 1] - sorted(row)[i] for i in range(len(row) - 1)] if gap > 0), axis=1
)

# high_rank_concentration_score
# Feature description: Computes the concentration of high-value ranks (>10) in a hand by normalizing their count with the mean rank.
# Usefulness: Highlights hands that heavily rely on high-value cards, which is essential for Royal Flush and other premium hands.
df['high_rank_concentration_score'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: sum(rank > 10 for rank in row) / max(1, np.mean(row)), axis=1
)

# rank_fluctuation_score
# Feature description: Computes the standard deviation of rank differences between consecutive cards in a hand.
# Usefulness: Captures the variability in rank positions, which can help to classify highly structured hands versus random ones.
df['rank_fluctuation_score'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: np.std([sorted(row)[i + 1] - sorted(row)[i] for i in range(len(row) - 1)]), axis=1
)

# reverse_rank_alignment_score
# Feature description: Calculates the alignment score of ranks in reverse order, useful for detecting reversed structured patterns like reverse Straights.
# Usefulness: Provides insight into reverse alignment, which can complement standard sequential checks for nuanced cases.
df['reverse_rank_alignment_score'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: sum((sorted(row, reverse=True)[i + 1] - sorted(row, reverse=True)[i]) for i in range(len(row) - 1)), axis=1
)
end

