df['pair_count'] = df.apply(lambda row: sum(count == 2 for count in row[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].value_counts()), axis=1)
end

python
# triplet_count
# Feature description: Counts the number of triplets (three cards of the same rank) in the hand.
# Usefulness: Indicates likelihood for Three of a Kind, Full House, and Four of a Kind.
df['triplet_count'] = df.apply(lambda row: sum(count == 3 for count in row[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].value_counts()), axis=1)
end

python
# is_sequential
# Feature description: Checks if the ranks in the hand are sequential.
# Usefulness: Critical for identifying Straights and Straight Flushes.
df['is_sequential'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(lambda row: sorted(row) == list(range(min(row), max(row) + 1)), axis=1).astype(int)
end

python
# is_flush
# Feature description: Checks if the cards in the hand have the same suit.
# Usefulness: Determines chances for Flush and Royal Flush, a key feature in poker hands.
df['is_flush'] = df.apply(lambda row: len(set([row['suit1'], row['suit2'], row['suit3'], row['suit4'], row['suit5']])) == 1, axis=1).astype(int)
end

python
# high_card_score
# Feature description: Sums the values of cards with a rank of 10 or higher.
# Usefulness: Helps to isolate hands that rely on high-value cards, particularly useful for Royal Flush classification.
df['high_card_score'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(lambda row: sum(rank for rank in row if rank >= 10), axis=1)
end

python
# even_odd_ratio
# Feature description: Computes the ratio of even cards to odd cards in the hand.
# Usefulness: Captures patterns in ranks, useful because even and odd patterns may influence alignment for Straights or other combinations.
df['even_odd_ratio'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(lambda row: sum(1 for rank in row if rank % 2 == 0) / (sum(1 for rank in row if rank % 2 != 0) + 1e-5), axis=1)
end

python
# rank_sum_modulo
# Feature description: Calculates the modulus of the total rank sum by 10.
# Usefulness: Offers insights into patterns for hands, especially when trying to differentiate random alignments versus structured ones.
df['rank_sum_modulo'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].sum(axis=1) % 10
end 

python
# redundancy_pair_cluster
# Dropping redundant feature: pair_clustering_metric
# Reason: Overlapping information with pair_count; pair_clustering_metric is less interpretable.
df.drop(columns=['pair_clustering_metric'], inplace=True)
end
