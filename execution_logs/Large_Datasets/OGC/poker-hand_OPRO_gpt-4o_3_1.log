end

python
# Feature name: straight_flush_depth
# Feature description: Combines exponential_rank_sum, rank_relative_sqrt_sum, and unique_counts_by_mod to quantify a depth for straight flush patterns.
# Usefulness: Prioritizes straight flush detection by capturing the rank-sequential and suit-consistent nature of the hands.
df['straight_flush_depth'] = (df['exponential_rank_sum'] * df['rank_relative_sqrt_sum']) / (df['unique_counts_by_mod'] + 1e-4)
end

python
# Feature name: rank_uniformity_score
# Feature description: Calculates the ratio of harmonic_rank_mean to rank_relative_position_sum to gauge how uniform the ranks are across the hand.
# Usefulness: Useful for identifying hands with balanced rank distributions, which are critical for flushes or uniform hands.
df['rank_uniformity_score'] = df['harmonic_rank_mean'] / (df['rank_relative_position_sum'] + 1e-4)
end

python
# Feature name: low_rank_emphasizer
# Feature description: Computes a sigmoid transformation of log_harmonic_rank_mean to highlight hands dominated by lower-value ranks.
# Usefulness: Targeted for identifying hands indicative of pairs or two-pair combinations with lower rank values.
df['low_rank_emphasizer'] = 1 / (1 + np.exp(-df['log_harmonic_rank_mean']))
end

python
