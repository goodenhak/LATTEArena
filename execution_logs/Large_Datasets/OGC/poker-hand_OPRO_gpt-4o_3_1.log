df['sequential_alignment_zscore'] = (df['straight_focus_metric'] + df['straight_sequential_metric'] - df['straight_focus_metric'].mean()) / df['straight_focus_metric'].std()
end

python
# pair_focus_adjusted
# Feature description: Improves pair detection by taking the product of pair_clustering_metric and abs_negate_total_rank_sum, then applying a reciprocal transformation to amplify strong pair signals while reducing false positives.
