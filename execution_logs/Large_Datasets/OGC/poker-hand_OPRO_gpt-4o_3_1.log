# Feature name: rank_gap_intensity
# Feature description: Computes the normalized difference between the maximum and minimum ranks in the hand using a sigmoid transformation. This captures the spread of ranks that can be useful for identifying patterns like straights or gaps in the hand.
# Usefulness: Highlights the gap size between the highest and lowest cards, which is critical for evaluating potential straight patterns and differentiating dispersed hands from clustered ones.
df['rank_gap_intensity'] = 1 / (1 + np.exp(-(df['exponential_rank_sum'] - df['abs_negate_total_rank_sum'])))
end

python
# Feature name: suit_harmony_score
# Feature description: Computes the ratio of unique_mod_ratio to the square of abs_negate_total_rank_sum, emphasizing how consistent the odd/even suit distribution is compared to the rank strength.
# Usefulness: Useful for assessing hands with consistent suit distributions, helping to identify flush patterns or near-flush hands.
df['suit_harmony_score'] = df['unique_mod_ratio'] / (df['abs_negate_total_rank_sum']2 + 1e-4)
end

python
# Feature name: rank_position_weight
# Feature description: Computes the product of rank_relative_position_sum and zscore_rank_mean, emphasizing the importance of card positions with respect to their statistical rank placement.
# Usefulness: Useful for capturing the combined effect of rank standardization and position in detecting structured rank patterns such as straights or higher card groupings.
df['rank_position_weight'] = df['rank_relative_position_sum'] * (df['zscore_rank_mean'] + 1e-4)
end

python
# Feature name: odd_even_balance_ratio
# Feature description: Calculates the absolute ratio between unique_mod_ratio and unique_counts_by_mod to measure stability in the odd/even pattern of the hand.
# Usefulness: Highlights the hands that are evenly distributed or skewed in odd/even card values, which is helpful for evaluating hands like flushes or full houses.
df['odd_even_balance_ratio'] = abs(df['unique_mod_ratio'] - df['unique_counts_by_mod'] + 1e-4) / (df['unique_mod_ratio'] + df['unique_counts_by_mod'] + 1e-4)
end

python
# Feature name: straight_flush_alignment
# Feature description: Combines zscore_by_exp_rank_sum, rank_relative_position_sum, and unique_mod_ratio using a weighted average to emphasize patterns related to straight flushes.
# Usefulness: This feature helps capture the proximity of card ranks and their alignment with suit distributions, crucial for identifying straight flush hands.
df['straight_flush_alignment'] = (
    0.5 * df['zscore_by_exp_rank_sum'] +
    0.3 * df['rank_relative_position_sum'] +
