# Feature name: adjusted_royal_flush_potential
# Feature description: Combines royal_flush_depth_adjusted with the square of abs_zscore_rank_mean and ranks it within the dataset to further refine signals indicative of royal flush potential.
# Usefulness: Improves targeting of Royal Flush (9) by emphasizing depth-adjusted metrics and the role of rank consistency in highly specific hands.
df['adjusted_royal_flush_potential'] = (df['royal_flush_depth_adjusted'] * (df['abs_zscore_rank_mean']  2)).rank()

# Feature name: sequential_odd_even_depth_adjustment
# Feature description: Multiplies odd_even_synchronization_factor with straight_focus_metric using a logarithmic adjustment, isolating sequential alignment balanced by odd/even consistency.
# Usefulness: Helps to distinguish Straight (4) and Straight Flush (8) hands by emphasizing depth-specific odd/even sequencing nuances.
df['sequential_odd_even_depth_adjustment'] = np.log1p(df['odd_even_synchronization_factor'].abs()) * df['straight_focus_metric']

# Feature name: pair_fluctuation_deviation_score
# Feature description: Computes the deviation between zscore_by_exp_rank_sum and abs_negate_total_rank_sum to emphasize fluctuations in rank sums associated with pair patterns.
# Usefulness: Enhances predictions of pair-centric hands like One Pair (1) and Two Pairs (2) by capturing deviations in rank-based metrics that are characteristic of pairs.
df['pair_fluctuation_deviation_score'] = (df['zscore_by_exp_rank_sum'] - df['abs_negate_total_rank_sum']).abs()

# Feature name: universal_flush_alignment_index
# Feature description: Calculates the product of flush_consistency_factor and the square root of flush_alignment_ratio to emphasize broad alignment patterns associated with flush-related hands.
# Usefulness: Improves predictions for Flush (5) and Straight Flush (8) by incorporating both consistency and depth factors in flush alignment patterns.
df['universal_flush_alignment_index'] = df['flush_consistency_factor'] * np.sqrt(df['flush_alignment_ratio'])

# Feature name: harmonic_sequence_density
# Feature description: Combines the harmonic mean of rank_harmonic_zscore and rank_relative_sqrt_sum to emphasize sequential characteristics in dense rank distributions.
# Usefulness: Highlights sequential hands like Straight (4), Straight Flush (8), and Royal Flush (9) by leveraging dense rank sequence information.
df['harmonic_sequence_density'] = (df['rank_harmonic_zscore'] + df['rank_relative_sqrt_sum']) / 2

# Feature name: outlier_rank_focus
# Feature description: Multiplies zscore_by_exp_rank_sum with the absolute value of rank_harmonic_zscore to isolate hands with outlier rank metrics.
# Usefulness: Captures uncommon hands with extreme rank patterns, aiding in classification across all categories, particularly rare hands like Royal Flush (9).
df['outlier_rank_focus'] = df['zscore_by_exp_rank_sum'] * df['rank_harmonic_zscore'].abs()

# Feature name: straight_flush_transition_score
# Feature description: Combines straight_focus_metric with sequential_flush_depth_focus using a square root adjustment to balance straight and flush sequential characteristics.
# Usefulness: Refines classification of Straight Flush (8) by targeting sequential hands transitioning between straight and full flush patterns.
df['straight_flush_transition_score'] = np.sqrt(df['straight_focus_metric'] * df['sequential_flush_depth_focus'])

# Feature name: pair_rank_depth_ratio
# Feature description: Calculates the ratio between pair_clustering_metric and log_harmonic_rank_mean to emphasize depth-adjusted rank distributions in paired hands.
# Usefulness: Improves differentiation of pair-related categories like One Pair (1), Two Pairs (2), and Full House (6), by highlighting depth-adjusted rank clustering.
df['pair_rank_depth_ratio'] = df['pair_clustering_metric'] / (1 + df['log_harmonic_rank_mean'])

# Dropping less useful columns: zscore_by_exp_rank_sum
# Description: This feature has been integrated into derived features like outlier_rank_focus and pair_fluctuation_deviation_score, reducing standalone significance.
df.drop(columns=['zscore_by_exp_rank_sum'], inplace=True)

# Dropping less useful columns: abs_zscore_rank_mean
# Description: The absolute z-score of rank mean is now represented in adjusted_royal_flush_potential and other features like universal_flush_alignment_index, making it redundant.
df.drop(columns=['abs_zscore_rank_mean'], inplace=True)

# Dropping less useful columns: flush_consistency_factor
# Description: The contribution of this feature has been incorporated into features like universal_flush_alignment_index and straight_flush_transition_score.
df.drop(columns=['flush_consistency_factor'], inplace=True)

# Dropping less useful columns: straight_focus_metric
# Description: This feature has been adapted into harmonic_sequence_density and straight_flush_transition_score, reducing its unique predictive power.
df.drop(columns=['straight_focus_metric'], inplace=True)
end
