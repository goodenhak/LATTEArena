# royal_flush_proximity_score
# Feature description: Computes the proximity of a hand to a Royal Flush by summing the intersection of ranks that match {10, Jack, Queen, King, Ace}.
# Usefulness: Specifically targets the identification of potential Royal Flush hands, which rely on the presence of high-value sequential cards.
df['royal_flush_proximity_score'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: sum(rank in {10, 11, 12, 13, 14} for rank in row), axis=1
)
end

python
# adjusted_straight_gap_score
# Feature description: Computes the sum of all rank gaps for non-sequential hands, adjusted by the central tendency rank (median rank).
# Usefulness: Reduces the impact of extreme values in gaps by normalizing with the median rank, helping identify near-straight patterns.
df['adjusted_straight_gap_score'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: sum(abs(sorted(row)[i] - sorted(row)[i + 1] - 1) for i in range(4)) / (np.median(row) + 1e-5), axis=1
)
end

