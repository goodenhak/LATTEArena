# same_suit_count
# Counts the number of cards with the same suit.
# Usefulness: Helps detect Flushes and Straight Flushes which require all cards to have the same suit.
df['same_suit_count'] = (df[['V1', 'V3', 'V5', 'V7', 'V9']].nunique(axis=1) == 1).astype(int)
end

python
# rank_difference_mean
# Calculates the average difference between consecutive card ranks in a sorted hand.
# Usefulness: Helps identify Straights and Royal Flushes which require sequential ranks with no gaps.
df['rank_difference_mean'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(sorted, axis=1).apply(lambda x: sum(abs(x[i+1] - x[i]) for i in range(len(x)-1)) / (len(x)-1), axis=1)
end

python
# is_royal_flush_candidate
# Verifies if all card ranks belong to the {Ace, King, Queen, Jack, Ten} set and if all suits are identical.
# Usefulness: Specifically helps identify Royal Flush hands which need both flush and specific rank constraints.
royal_ranks = {1, 10, 11, 12, 13} # Ace = 1, Ten = 10, Jack = 11, Queen = 12, King = 13
df['is_royal_flush_candidate'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(set, axis=1).apply(lambda x: x.issubset(royal_ranks)).astype(int) & (df[['V1', 'V3', 'V5', 'V7', 'V9']].nunique(axis=1) == 1).astype(int)
end

python
# pair_count
# Counts the number of pairs of cards with matching ranks.
# Usefulness: Critical for identifying One Pair, Two Pairs, Full House, and Four of a Kind hands.
df['pair_count'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: sum(x.count(rank) == 2 for rank in set(x)), axis=1)
end

python
# triplet_count
# Counts the number of triplets (three cards of the same rank).
# Usefulness: Helps distinguish between Three of a Kind, Full House, and Four of a Kind hands.
df['triplet_count'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: sum(x.count(rank) == 3 for rank in set(x)), axis=1)
end

python
# four_of_a_kind_indicator
