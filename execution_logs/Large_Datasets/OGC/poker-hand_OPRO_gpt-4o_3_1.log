# suit_weighted_rank_sum
# Feature description: Computes the sum of ranks weighted by the suit index (1 for Hearts, 2 for Diamonds, 3 for Clubs, 4 for Spades). This gives additional importance to the suit while preserving rank differences.
# Usefulness: Emphasizes combinations with consistent suit patterns and high card values, which are critical for detecting flushes, straight flushes, and royal flushes.
df['suit_weighted_rank_sum'] = df['exponential_rank_sum'] * (1 + df['flush_alignment_ratio'])
end

python
# rank_variation_ratio
# Feature description: Computes the ratio of the difference between the max and min rank to the mean rank. This highlights the range of rank values relative to the average strength of the hand.
# Usefulness: Helps identify hands with broad rank distributions, useful for detecting straights, straight flushes, and royal flushes. Penalizes hands with similar rank clusters (e.g., full house or four of a kind).
df['rank_variation_ratio'] = (df['rank_relative_sqrt_sum'] - df['straight_focus_metric']) / df['zscore_rank_mean']
end

python
# harmonic_flush_probability
# Feature description: Combines the harmonic mean of log_harmonic_rank_mean and rank_relative_sqrt_sum. A subsequent sine transformation highlights consistent low-rank and suit patterns indicative of flushes.
# Usefulness: Accentuates flushes and straight flushes by focusing on suit alignment and low rank distributions.
df['harmonic_flush_probability'] = np.sin((df['log_harmonic_rank_mean'] + df['rank_relative_sqrt_sum']) / 2)
end

python
