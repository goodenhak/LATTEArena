# rank_sequence_score
# Feature description: Calculates the sum of exponential gaps between consecutive ranks in sorted order.
# Usefulness: Captures patterns in rank arrangement for Straights and Straight Flushes, emphasizing sequential hands.
df['rank_sequence_score'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: sum(np.exp(sorted(row)[i + 1] - sorted(row)[i]) for i in range(4)),
    axis=1
)
end

python
# suit_frequency_entropy
# Feature description: Computes the Shannon entropy of suit frequencies in the hand.
# Usefulness: Low entropy implies a concentrated suit distribution (useful for Flushes), while high entropy indicates diverse suits (useful for detecting other patterns).
from scipy.stats import entropy
df['suit_frequency_entropy'] = df[['suit1', 'suit2', 'suit3', 'suit4', 'suit5']].apply(
    lambda row: entropy(np.bincount(row, minlength=5), base=2),
    axis=1
)
end

python
# normalized_high_rank_count
# Feature description: Calculates the proportion of ranks greater than or equal to 10 in the hand, normalized by the total number of cards.
# Usefulness: Highlights the prevalence of high-value cards in each hand, key for identifying hands with high potential scores or combinations.
df['normalized_high_rank_count'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: sum(rank >= 10 for rank in row) / len(row), 
    axis=1
)
end

python
# cosine_rank_gap_alignment
# Feature description: Computes the cosine similarity between rank gaps and a uniform vector to capture sequential alignments.
# Usefulness: Focuses on how gaps between ranks align either randomly or sequentially, aiding Straights and Straight Flush detection.
from sklearn.metrics.pairwise import cosine_similarity
df['cosine_rank_gap_alignment'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: cosine_similarity(
        np.array([sorted(row)[i + 1] - sorted(row)[i] for i in range(4)]).reshape(1, -1),
        np.ones(4).reshape(1, -1)
    )[0][0],
    axis=1
)
end

python
# adjusted_suit_alignment_factor
# Feature description: Applies geometric mean transformation to the suit frequency to emphasize uniform suit alignment.
# Usefulness: Enhances recognition of Flush-related hands by penalizing non-uniform frequencies, aiding suit-based classifications.
from scipy.stats import gmean
df['adjusted_suit_alignment_factor'] = df[['suit1', 'suit2', 'suit3', 'suit4', 'suit5']].apply(
    lambda row: gmean(np.bincount(row, minlength=5)),
    axis=1
)
end

python
# rank_conformity_score
# Feature description: Computes the mean squared deviation of ranks from their expected sequential values.
# Usefulness: Helps identify patterns for Straights, fluctuations in ranks, or alignment inconsistencies across hands.
df['rank_conformity_score'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: np.mean([(sorted(row)[i] - (min(row) + i))  2 for i in range(5)]),
    axis=1
)
end

python
# redundancy_flush_alignment_ratio
# Dropping redundant feature: flush_alignment_ratio
# Reason: Overlapping information with adjusted_suit_alignment_factor; adjusted_suit_alignment_factor offers smoother transformation for consistency analysis.
df.drop(columns=['flush_alignment_ratio'], inplace=True)
end

python
# redundancy_pair_clustering_metric
# Dropping redundant feature: pair_clustering_metric
# Reason: Overlapping information with pair_count; pair_count provides direct card pair analysis with precise interpretation.
df.drop(columns=['pair_clustering_metric'], inplace=True)
end

python
# redundancy_high_card_alignment_factor
# Dropping redundant feature: high_card_alignment_factor
# Reason: Information better captured by normalized_high_rank_count, offering normalization for high-rank prevalence without relying on position weights.
df.drop(columns=['high_card_alignment_factor'], inplace=True)
end

python
# harmonic_rank_mean_squared
# Feature description: Computes the squared harmonic mean of ranks to amplify lower rank values.
# Usefulness: Helps emphasize lower-ranked cards and their contributions, useful for detecting patterns in scattered rank distributions.
df['harmonic_rank_mean_squared'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: (5 / sum(1 / rank for rank in row))  2,
    axis=1
)
end

python
# sequential_gaps_ratio
# Feature description: Calculates the ratio of total consecutive gaps to the maximum possible gaps (4 for a hand of 5 cards).
# Usefulness: Tracks how ranks align in terms of sequential gaps, aiding detection of Straights or scattered configurations.
df['sequential_gaps_ratio'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: sum(sorted(row)[i + 1] - sorted(row)[i] for i in range(4)) / 4,
    axis=1
)
end

