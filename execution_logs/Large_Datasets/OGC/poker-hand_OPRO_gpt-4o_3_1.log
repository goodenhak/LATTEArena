### Feature Generation:
python
# rank_product
# Feature description: Computes the product of all ranks in the hand.
# Usefulness: Useful for detecting patterns where specific rank combinations amplify overall hand characteristics, such as Straights or Flush.
df['rank_product'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(lambda row: np.prod(row), axis=1)
end

python
# rank_variance
# Feature description: Calculates the variance of ranks in each hand.
# Usefulness: Highlights the spread and uniformity of ranks, aiding in identifying hands like Straights or partially consistent hands.
df['rank_variance'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].var(axis=1)
end

python
# inverse_flush_alignment_ratio
# Feature description: Computes the reciprocal value of flush_alignment_ratio to emphasize hands with inconsistent suit alignment.
# Usefulness: Useful for isolating hands with varied suit distributions under rare combinations.
df['inverse_flush_alignment_ratio'] = 1 / df['flush_alignment_ratio']
end

python
# log_rank_product
# Feature description: Applies the logarithmic transformation to rank_product for compression and interpretability of large values.
# Usefulness: Compresses large rank products while retaining their amplification properties, helpful for detecting combinations involving high cards.
df['log_rank_product'] = df['rank_product'].apply(np.log)
end

python
# cumulative_suit_indicator
# Feature description: Computes cumulative indices for suits across the hand to measure suit alignment over time-like patterns.
# Usefulness: Enhances recognition of hands that gradually build suit alignment, useful for Flush or Royal Flush.
df['cumulative_suit_indicator'] = df[['suit1', 'suit2', 'suit3', 'suit4', 'suit5']].apply(lambda row: sum(row.index(row.max()) + 1 for row in [row]), axis=1)
end

python
# straight_gap_penalty
# Feature description: Calculates the penalty as the absolute difference between the rank range and the number of distinct ranks in the hand.
# Usefulness: Captures hands that deviate slightly from Straight patterns, identifying near-straight configurations.
df['straight_gap_penalty'] = df['rank_range'] - df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].nunique(axis=1)
end

python
# royal_flush_flag
# Feature description: Binary indicator for hands meeting rank and suit conditions for Royal Flush (Ace, King, Queen, Jack, Ten + flush).
# Usefulness: Speeds up detection and classification for Royal Flush hands, a rare but important poker configuration.
df['royal_flush_flag'] = df.apply(lambda row: (set([row['rank1'], row['rank2'], row['rank3'], row['rank4'], row['rank5']]) == {10, 11, 12, 13, 14}) and (len(set([row['suit1'], row['suit2'], row['suit3'], row['suit4'], row['suit5']])) == 1), axis=1).astype(int)
end

python
# sequential_rank_missing_indicator
# Feature description: Detects gaps in sequential ranks by comparing the expected range with the unique ranks found.
# Usefulness: Useful for identifying gaps in hands that appear sequential but are incomplete for Straights or Straight Flushes.
df['sequential_rank_missing_indicator'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(lambda row: len(set(range(min(row), max(row) + 1)) - set(row)), axis=1)
end

python
# suit_diversity
# Feature description: Computes the count of unique suits within the hand.
# Usefulness: Detects diversity of suits in hands, vital for distinguishing Flush and Royal Flush from other hands.
df['suit_diversity'] = df[['suit1', 'suit2', 'suit3', 'suit4', 'suit5']].nunique(axis=1)
end

python
# weighted_rank_sum_by_suit
# Feature description: Computes the sum of ranks weighted by a suit-specific multiplier to account for suit importance in hand strength.
# Usefulness: Offers fine-grained adjustments to rank-based features by considering suit significance, aiding in Flush, Royal Flush, and Straight Flush detection.
df['weighted_rank_sum_by_suit'] = df.apply(lambda row: sum(row['rank' + str(i)] * (row['suit' + str(i)] + 1) for i in range(1, 6)), axis=1)
end

