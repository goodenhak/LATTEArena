# Feature name: rank_range_amplifier
# Feature description: Computes the logarithm of the range (max - min) of the rank-related features to emphasize hands with either wide or narrow rank differences.
# Usefulness: Helps identify hands with significant rank ranges (e.g., indicative of straights) or narrow rank ranges (e.g., indicative of full houses or pairs).
df['rank_range_amplifier'] = np.log(df['rank_relative_position_sum'].max() - df['rank_relative_position_sum'].min() + 1e-4)
end

python
# Feature name: straight_probability_index
# Feature description: Combines rank_relative_sqrt_sum and harmonic_rank_mean through a min-max scaling ratio to calculate a likelihood score of the hand forming sequential ranks.
# Usefulness: Enables better detection of straight patterns by ensuring both rank sequentiality and emphasis on lower rank distributions are considered jointly.
df['straight_probability_index'] = (df['rank_relative_sqrt_sum'] / (df['harmonic_rank_mean'] + 1e-4))
end

python
# Feature name: royal_flush_potential
# Feature description: Calculates a probability-based approach to assess the likelihood of the hand being a royal flush by combining exponential_rank_sum and zscore_rank_mean.
# Usefulness: Directly targets the unique scenario of a royal flush by leveraging high card values and statistical deviation.
df['royal_flush_potential'] = 1 / (1 + np.exp(-(df['exponential_rank_sum'] + df['zscore_rank_mean'])))
end

python
# Feature name: bursty_hand_indicator
# Feature description: Combines abs_zscore_rank_mean and rank_relative_position_sum to indicate hands where rank distributions deviate abruptly, signaling irregular patterns.
# Usefulness: Identifies non-standard or irregular hands that are unlikely to form conventional patterns like flushes or straights, aiding predictive differentiation.
df['bursty_hand_indicator'] = df['abs_zscore_rank_mean'] * df['rank_relative_position_sum']
end

python
# Feature name: high_pair_focus
# Feature description: Computes the logarithmic product of rank_relative_position_sum and abs_zscore_rank_mean to amplify importance of high-value pairs.
# Usefulness: Specifically designed to highlight patterns indicative of hands with high-ranking pairs (e.g., Kings or Aces).
