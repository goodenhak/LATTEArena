# Usefulness: Amplifies hands with high-value ranks critical for classifications like Royal Flush or Straight Flush.
df['normalized_high_rank_sum'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: sum(rank for rank in row if rank >= 10) / max(1, sum(row)), axis=1)
