# rank_entropy
# Feature description: Computes the Shannon entropy of the ranks in the hand.
# Usefulness: High entropy implies uniform distribution of ranks (indicative of Nothing in Hand), while low entropy suggests repeating ranks (indicative of Pairs, Full House, or Four of a Kind).
from scipy.stats import entropy
df['rank_entropy'] = df[['rank1', 'rank2', 'rank3', 'rank4', 'rank5']].apply(
    lambda row: entropy(np.bincount(row) / 5, base=2), axis=1
)
end

python
# suit_uniformity_score
# Feature description: Calculates the cosine similarity between the frequency vector of suits and a uniform vector.
# Usefulness: Helps quantify how evenly suits are distributed across the hand, aiding in differentiating Flush-related hands from others.
from sklearn.metrics.pairwise import cosine_similarity
df['suit_uniformity_score'] = df[['suit1', 'suit2', 'suit3', 'suit4', 'suit5']].apply(
    lambda row: cosine_similarity(
        np.array([row.count(suit) for suit in set(row)]).reshape(1, -1),
        np.array([1, 1, 1, 1]).reshape(1, -1)
    )[0][0],
    axis=1
)
