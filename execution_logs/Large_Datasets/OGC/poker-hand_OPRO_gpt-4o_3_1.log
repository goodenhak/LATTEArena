# Usefulness: Improves granularity in detecting hands like flushes, straight flushes, or royal flushes by integrating sequential and flush-related features.
df['flush_sequence_ratio'] = df['flush_alignment_ratio'] / (df['sequential_alignment_score'] + 1e-10)

