end

python
# normalized_suit_distinctiveness
# Computes the sum of inverse counts of each suit, normalized by the number of cards.
# Usefulness: Captures the variety in suits, useful for distinguishing hands with balanced suits vs dominant suits.
df['normalized_suit_distinctiveness'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(lambda x: sum(1/x.count(suit) for suit in set(x))/len(x), axis=1)
end

