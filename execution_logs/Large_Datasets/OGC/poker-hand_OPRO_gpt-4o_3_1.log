# high_card_ratio
# Feature description: Computes the ratio of the highest rank card to the sum of all ranks in the hand. This emphasizes hands dominated by a single high card, which can be indicative of a strong hand.
# Usefulness: This feature can highlight cases like Royal Flush or hands with high-value cards. It also helps differentiate between strong and weak non-combinatory hands.
df['high_card_ratio'] = df['exponential_rank_sum'] / df['abs_negate_total_rank_sum']
end

python
# pair_strength_ratio
# Feature description: Computes the ratio of pair_clustering_metric to abs_negate_total_rank_sum. This emphasizes hands in which ranks cluster significantly, a strong indicator of hands containing pairs, two pairs, or full house.
# Usefulness: Helps emphasize relationships that might not be evident when ranks are distributed across the cards.
df['pair_strength_ratio'] = df['pair_clustering_metric'] / df['abs_negate_total_rank_sum']
end

python
# flush_alignment_scaled
# Feature description: Scales the flush_alignment_ratio by dividing it by exponential_rank_sum to penalize hands with high rank variance while emphasizing suit alignment for flush detection.
# Usefulness: Improves focus on flush potential while reducing false positives for hands with high rank values that are not well-aligned.
df['flush_alignment_scaled'] = df['flush_alignment_ratio'] / df['exponential_rank_sum']
end

python
# straight_sequential_metric
# Feature description: Computes the difference between rank_relative_sqrt_sum and straight_focus_metric. A strong sequential characteristic will result in low values, helping detect straights and straight flushes.
# Usefulness: Focuses on sequential low-rank alignments while penalizing inconsistent rank distributions.
df['straight_sequential_metric'] = df['rank_relative_sqrt_sum'] - df['straight_focus_metric']
end

python
# royal_flush_probability
# Feature description: Combines royal_flush_depth_adjusted with the absolute value of flush_consistency_factor to isolate royal flush patterns. A sine transformation further amplifies extreme values.
# Usefulness: Enhances the model's ability to detect rare but highly important royal flushes by penalizing non-consistent patterns.
df['royal_flush_probability'] = np.sin(df['royal_flush_depth_adjusted'] * np.abs(df['flush_consistency_factor']))
end

python
# even_odd_balance_ratio
# Feature description: Computes the product of unique_mod_ratio and odd_even_synchronization_factor. This captures the balance between odd/even card values to identify patterns in rank distributions indicative of pairs or straights.
# Usefulness: Highlights hands with strong balance between odd/even rank values, which are key indicators of high-ranking poker hands.
df['even_odd_balance_ratio'] = df['unique_mod_ratio'] * df['odd_even_synchronization_factor']
end

python
# standardized_rank_diversity
# Feature description: Standardizes rank_diversity_score using z-score normalization to focus on extremely diverse or uniform hands.
# Usefulness: Draws attention to datasets where rank diversity significantly deviates from the mean, enhancing signal detection for full house, four of a kind, or hands with similar ranks.
df['standardized_rank_diversity'] = (df['rank_diversity_score'] - df['rank_diversity_score'].mean()) / df['rank_diversity_score'].std()
end

python
# high_rank_clustering_metric
# Feature description: Combines zscore_rank_mean and abs_zscore_rank_mean with the cube of log_harmonic_rank_mean to emphasize clusters of high-rank cards.
# Usefulness: Supports the detection of high-rank clustering, which is critical for straights, flushes, and royal flushes.
df['high_rank_clustering_metric'] = (df['zscore_rank_mean'] + df['abs_zscore_rank_mean']) * (df['log_harmonic_rank_mean']3)
end

python
# dropping unnecessary columns
# Dropping redundant columns not contributing to the understanding of poker hands directly.
df.drop(columns=['flush_consistency_factor'], inplace=True)
end

python
# dropping insignificant calculated column
# Dropping odd_even_synchronization_factor because its lack of variability results in low informational value for discriminative tasks (Std=0.0003).
df.drop(columns=['odd_even_synchronization_factor'], inplace=True)
end

python
# dropping feature overlapping explanations
# Dropping zscore_by_exp_rank_sum, as it is highly collinear with exponential_rank_sum and does not provide independent predictive value.
df.drop(columns=['zscore_by_exp_rank_sum'], inplace=True)
end
