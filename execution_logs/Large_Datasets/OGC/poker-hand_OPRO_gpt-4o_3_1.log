)
end

python
# Feature name: royal_tendency_factor
# Feature description: Calculates the product of exponential_rank_sum and a logarithmic transformation of harmonic_rank_mean to measure the tendency of cards toward high-value royal patterns.
# Usefulness: This feature captures the likelihood of the cards being part of a royal flush or high-card hand while keeping low-rank contributions under control.
df['royal_tendency_factor'] = df['exponential_rank_sum'] * np.log1p(df['harmonic_rank_mean'])
end

python
# Feature name: rank_highlow_contrast
# Feature description: Computes the harmonic mean of zscore_rank_mean and abs_negate_total_rank_sum to weigh the contrast between high and low card ranks.
# Usefulness: This feature highlights hands with a strong contrast between high-value and low-value ranks, useful for detecting straights and mixed combinations.
df['rank_highlow_contrast'] = 2 * (df['zscore_rank_mean'] * df['abs_negate_total_rank_sum']) / (
