# Usefulness: Explains how a cell's elevation compares to the overall terrain, aiding in identifying elevation-specific forest cover.
df['Elevation_Difference_To_Mean'] = df['Elevation'] - df['Elevation'].mean()
end

python
# Fire_Road_Interaction
# Product of Horizontal_Distance_To_Fire_Points and Horizontal_Distance_To_Roadways.
# Usefulness: Captures an interaction between both fire and road proximity. These two factors together directly impact forest cover due to fire spread mitigation and access.
df['Fire_Road_Interaction'] = df['Horizontal_Distance_To_Fire_Points'] * df['Horizontal_Distance_To_Roadways']
end

python
# Soil_Wilderness_Gradient_Interaction
# Product of Combined_Soil_Wilderness_Interaction and Hydrology_Wildfire_Gradient.
# Usefulness: This feature combines soil type and wilderness area information with the terrain's hydrology-fire gradient, which influences vegetation composition.
df['Soil_Wilderness_Gradient_Interaction'] = df['Combined_Soil_Wilderness_Interaction'] * df['Hydrology_Wildfire_Gradient']
end

python
# Brightness_Impact_Index
# Weighted product of Brightness_Adjusted_Slope and Total_Horizontal_Distance.
# Usefulness: Indicates how the terrain slope's brightness adjustment interacts with proximity to key geographical features. Areas with lower brightness and closer distances to hydrology or roadways may have distinct vegetation compared to brighter or distant areas.
df['Brightness_Impact_Index'] = df['Brightness_Adjusted_Slope'] * df['Total_Horizontal_Distance']
