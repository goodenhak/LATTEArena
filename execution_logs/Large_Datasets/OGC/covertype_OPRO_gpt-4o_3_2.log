# Hydrology_Fire_Proximity_Ratio
# Ratio of Horizontal_Distance_To_Hydrology to Horizontal_Distance_To_Fire_Points.
# Usefulness: This feature captures the relative proximity of a cell to water versus wildfire ignition points. Areas closer to water may have more vegetation and hence different forest cover types than those closer to fire points.
df['Hydrology_Fire_Proximity_Ratio'] = df['Horizontal_Distance_To_Hydrology'] / df['Horizontal_Distance_To_Fire_Points']
end

python
