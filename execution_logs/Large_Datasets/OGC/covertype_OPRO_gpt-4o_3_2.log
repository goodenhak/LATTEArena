end

python
# Vertical_Distance_Sign
# Adds a binary indicator for whether the vertical distance to a hydrology feature is above (positive) or below (negative) the elevation level of the surface water.
# Usefulness: Separates areas that are likely to be part of valleys (negative vertical distances) from areas likely uphill of water features.
df['Vertical_Distance_Sign'] = (df['Vertical_Distance_To_Hydrology'] >= 0).astype(int)
end

python
