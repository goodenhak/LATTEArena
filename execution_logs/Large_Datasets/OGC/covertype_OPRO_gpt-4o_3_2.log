# Terrain Wetness Index
# Combine Hydrology_Relative_Elevation and Vertical_Distance_To_Hydrology with logarithmic weighting for surface water influence.
# Usefulness: Emphasizes interaction between vertical position and relative elevation for understanding moisture retention and vegetation patterns.
df['Terrain_Wetness_Index'] = df['Hydrology_Relative_Elevation'] * np.log1p(df['Vertical_Distance_To_Hydrology'].abs() + 1e-5)

# Combined Wilderness Diversity Score
# Sum up all wilderness indicators and normalize by the total number of wilderness types (1-4).
# Usefulness: Captures the collective influence of overlapping wilderness types in one composite metric.
df['Combined_Wilderness_Diversity'] = (
    df[['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3', 'Wilderness_Area4']].sum(axis=1) /
    4
)

# Soil-Road Accessibility Index
# Calculate the product of Soil_Type_Richness_Adjusted and Horizontal_Distance_To_Roadways.
# Usefulness: Identifies areas where highly diverse soil types are influenced by proximity to roadways, impacting forest accessibility and type.
df['Soil_Road_Accessibility_Index'] = df['Soil_Type_Richness_Adjusted'] * df['Horizontal_Distance_To_Roadways']

# Vertical Proximity Impact Factor
# Combine Vertical_Distance_To_Hydrology and Fire_Proximity_Reliance to evaluate composite vertical and fire proximity influences.
# Usefulness: Highlights terrains where vertical height combined with fire remoteness has an outsized role in shaping forest type.
df['Vertical_Proximity_Impact'] = df['Vertical_Distance_To_Hydrology'] * df['Fire_Proximity_Reliance']

# Elevation-Slope Combined Steepness
# Compute the square of slope and multiply it with Elevation for a combined indicator of terrain steepness.
# Usefulness: Captures highly rugged terrains based on steep slopes and elevation, affecting forest type distribution.
df['Elevation_Slope_Steepness'] = df['Slope']2 * df['Elevation']

# Distance Complexity Score
# Compute the standard deviation across horizontal distance metrics (to hydrology, roads, wildfire) as a measure of proximity variability.
# Usefulness: Highlights areas of uneven accessibility, which can influence vegetation via uneven resources or fire risk distributions.
df['Distance_Complexity_Score'] = df[['Horizontal_Distance_To_Hydrology', 'Horizontal_Distance_To_Roadways', 'Horizontal_Distance_To_Fire_Points']].std(axis=1)

# Wilderness-Soil Diversity Interaction
# Multiply Combined_Wilderness_Diversity by Soil_Type_Richness_Adjusted for synergy between wilderness diversity and soil diversity.
# Usefulness: Measures terrain regions where wilderness overlaps with varied soil types, influencing forest cover types.
df['Wilderness_Soil_Interaction'] = df['Combined_Wilderness_Diversity'] * df['Soil_Type_Richness_Adjusted']

# Hydrology-Elevation Sensitivity
# Compute the ratio of Hydrology_Relative_Elevation to Elevation, then apply sigmoid transformation.
# Usefulness: Captures how sensitive terrain vegetation might be to hydrological features relative to overall elevation.
df['Hydrology_Elevation_Sensitivity'] = 1 / (1 + np.exp(-df['Hydrology_Relative_Elevation'] / (df['Elevation'] + 1e-5)))

# Relative Fire Hazard Index
# Combine Horizontal_Distance_To_Fire_Points with Fire_Proximity_Reliance for weighted fire susceptibility.
# Usefulness: Determines terrain spots where fire-based hazards are spatially dominant, heavily influencing vegetation and cover.
df['Relative_Fire_Hazard_Index'] = (
    df['Horizontal_Distance_To_Fire_Points'] * df['Fire_Proximity_Reliance']
)

# Proximity Weighted Terrain Ruggedness
# Calculate the product of Distance_Complexity_Score and Forest_Type_Steepness_Index as a ruggedness-combined terrain metric.
# Usefulness: Highlights areas with high terrain ruggedness and uneven proximities affecting vegetation sustainability.
df['Proximity_Weighted_Ruggedness'] = (
    df['Distance_Complexity_Score'] * df['Forest_Type_Steepness_Index']
)
end

