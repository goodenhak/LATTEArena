python
# Soil_Forest_Proximity_Interaction
# Feature description: Measures the product of soil diversity and proximity to combined wilderness and road features.
# Usefulness: Captures how soil diversity interacts with man-made accessibility and wilderness for forest vegetation.
df['Soil_Forest_Proximity_Interaction'] = (
    df.filter(like='Soil_Type').sum(axis=1) *
    (1 / (df['Combined_Road_Hydrology_Fire_Proximity'] + 1e-6))
)
end

