# Road_Hydrology_Fire_Impact
# Average of distances to hydrology, roadways, and fire points, weighted by each category's relative importance.
# Usefulness: Identifies areas with balanced or imbalanced influences of hydrology, road proximity, and wildfire proximity.
df['Road_Hydrology_Fire_Impact'] = (
    df['Horizontal_Distance_To_Hydrology'] * 0.4 + 
    df['Horizontal_Distance_To_Roadways'] * 0.3 + 
    df['Horizontal_Distance_To_Fire_Points'] * 0.3
)

# Elevation_Hydrology_Slope_Interaction
# Combines Elevation, Vertical_Distance_To_Hydrology, and Slope into a single feature using a weighted sum.
# Usefulness: Highlights how elevation, proximity to surface water, and terrain steepness interact to influence vegetation.
df['Elevation_Hydrology_Slope_Interaction'] = (
    0.5 * df['Elevation'] +
    0.3 * df['Vertical_Distance_To_Hydrology'] +
    0.2 * df['Slope']
)

# Soil_Cluster_Count
# Counts the number of soil type indicators (binary) that are active for each data point.
# Usefulness: Captures soil diversity explicitly, which is likely to influence vegetation and forest type.
soil_columns = [col for col in df.columns if 'Soil_Type' in col]
df['Soil_Cluster_Count'] = df[soil_columns].sum(axis=1)

# Angle_Normalized_Terrain
# Combines Slope and Brightness_Adjusted_Slope into an average feature normalized by Hydrology_Relative_Elevation.
# Usefulness: Encodes relationships between steepness, light exposure, and terrain inclination in an interpretable way.
df['Angle_Normalized_Terrain'] = (
    (df['Slope'] + df['Brightness_Adjusted_Slope']) / 
    (df['Hydrology_Relative_Elevation'] + 1e-10)
)

# Elevation_Road_Influence
# Multiplication of Elevation and Relative_Road_Proximity to identify how high terrain is influenced by nearby roads.
# Usefulness: Elevation and road proximity significantly determine accessibility and forest ecosystem health.
df['Elevation_Road_Influence'] = df['Elevation'] * df['Relative_Road_Proximity']

# Fire_Terrain_Contrast
# Difference between Horizontal_Distance_To_Fire_Points and Slope multiplied by Hydrology_Wildfire_Gradient.
# Usefulness: Captures unique patterns formed by wildfire proximity with terrain gradient and steepness interactions.
df['Fire_Terrain_Contrast'] = (
    df['Horizontal_Distance_To_Fire_Points'] - 
    (df['Slope'] * df['Hydrology_Wildfire_Gradient'])
)

# Wilderness_Elevation_Combination
# Weighted combination of Wilderness_Type and Elevation_Bin_Custom to highlight wilderness influence at different elevations.
# Usefulness: Elevation zones vary substantially across wilderness types, and this relationship is critical for vegetation.
df['Wilderness_Elevation_Combination'] = (
    df['Wilderness_Type'] * 
    df['Elevation_Bin_Custom'].replace({'Low': 1, 'Mid': 2, 'High': 3})
)

# Soil_Richness_Index
# Multiplies Soil_Type_Concentration_Score by Total_Horizontal_Distance to measure richness alongside spatial distribution.
# Usefulness: Soil richness combined with distance factors helps differentiate the ecological diversity in regions.
df['Soil_Richness_Index'] = (
    df['Soil_Type_Concentration_Score'] * 
    df['Total_Horizontal_Distance']
)

# Combined_Vegetation_Elev_Slope
# Interaction between Elevation, Slope, and Forest_Type_Steepness_Index to capture overall terrain's vegetation impact.
# Usefulness: Elevation, slope, and steepness are core drivers of vegetation, together influencing forest health.
df['Combined_Vegetation_Elev_Slope'] = (
    df['Elevation'] * 
    df['Slope'] * 
    df['Forest_Type_Steepness_Index']
)

# Soil_Diversity_Normalized_By_Elevation
# Ratio of Soil_Type_Diversity to Elevation to study soil diversity normalized by local elevation.
# Usefulness: Highlights areas with high soil diversity relative to elevation, which may signify unique forest types.
df['Soil_Diversity_Normalized_By_Elevation'] = (
    df['Soil_Type_Diversity'] / 
    (df['Elevation'] + 1e-10)
)

# Drop unhelpful columns
# Removing irrelevant or less informative features based on previous explorations and intuition.
df.drop(columns=[
    'Road_Hydrology_Combined_Influence', 
    'Log_Hydrology_Fire_Ratio', 
    'Fire_Impact_Normalized_Gradient', 
    'Wilderness_Diversity'
], inplace=True)
end

