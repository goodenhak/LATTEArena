end

python
# Road_Proximity_Index
# Uses an exponential decay based on horizontal distance to roads, favoring nearby regions.
# Usefulness: Gives a strong signal for proximity to roads, decaying for farther distances.
df['Road_Proximity_Index'] = np.exp(-df['Horizontal_Distance_To_Roadways'] / 1000)
end

python
# Soil_Type_Weighted_Sum
# Weighted sum of soil types, with weights assigned based on mean values of each soil type in the dataset.
# Usefulness: Highlights varied contributions of different soil types while reducing the dimensionality of soil features.
soil_columns = [col for col in df.columns if col.startswith('Soil_Type')]
soil_weights = df[soil_columns].mean()
df['Soil_Type_Weighted_Sum'] = df[soil_columns].dot(soil_weights)
end

python
# Fire_Hydrology_Combined_Distance
