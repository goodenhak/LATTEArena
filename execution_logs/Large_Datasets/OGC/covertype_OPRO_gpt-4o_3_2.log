df['Combined_Wilderness_Soil_Score'] = df[['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3', 'Wilderness_Area4']].sum(axis=1) + df.loc[:, 'Soil_Type1':'Soil_Type40'].sum(axis=1)
