# Hydrology_Flat_Proximity
# Combines horizontal and vertical hydrology distances with a weighting mechanism favoring flat areas.
# Usefulness: Areas closer to hydrology but flatter (low vertical distance) are more likely to have increased vegetation or water influence.
df['Hydrology_Flat_Proximity'] = df['Horizontal_Distance_To_Hydrology'] / (1 + df['Vertical_Distance_To_Hydrology'].clip(lower=0))

# Slope_Sensitivity
# Calculates the ratio of vertical distance to hydrology over slope.
# Usefulness: High vertical distances combined with steep slopes may indicate runoff-heavy areas less favorable to dense forest cover.
df['Slope_Sensitivity'] = df['Vertical_Distance_To_Hydrology'] / (df['Slope'] + 1e-5)

# Fire_Road_Proximity_Sum
# Aggregates proximity to roads and wildfire points.
# Usefulness: Highlights areas influenced by human activities and potential fire risks.
df['Fire_Road_Proximity_Sum'] = df['Horizontal_Distance_To_Fire_Points'] + df['Horizontal_Distance_To_Roadways']

# Road_Normalized_Influence
# Combines road proximity using a logarithmic normalization term.
# Usefulness: Models the diminishing impact of farther roads in remote areas, which may be significant in predicting forest cover.
df['Road_Normalized_Influence'] = np.log1p(df['Horizontal_Distance_To_Roadways']) - df['Road_Proximity_Index']

# Brightness_Vegetation_Index
# Multiplies brightness with slope to emphasize steeper areas with lower light exposure.
# Usefulness: Helps detect microclimatic zones where slope and brightness limit vegetation density.
df['Brightness_Vegetation_Index'] = df['Normalized_Brightness'] * df['Slope']

# Soil_Richness_Weighted_Mean
# Averages soil types weighted by their mean in the dataset.
# Usefulness: Captures the overall richness or productivity of the soil in a given area, which directly affects vegetation.
soil_columns = [col for col in df.columns if 'Soil_Type' in col]
df['Soil_Richness_Weighted_Mean'] = (df[soil_columns] * np.array([0.0215, 0.0179, 0.0548, 0.0283, 0.0179, 
                                                                  0.0740, 0.1204, 0.0431, 0.2247, 0.0544, 
                                                                  0.0513, 0.1026, 0.0880, 0.0219, 0.0192, 
                                                                  0.0120])).sum(axis=1)

# Wilderness_Impact_Score
# Calculates a single impact score for wilderness areas, accounting for combined wilderness presence.
# Usefulness: Wilderness areas may have a combined impact that represents conservation efforts or undisturbed areas.
wilderness_columns = ['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3', 'Wilderness_Area4']
df['Wilderness_Impact_Score'] = df[wilderness_columns].dot(np.array([0.5, 1.2, 0.9, 2.0]))

# Aspect_Directional_Encoding
# Encodes the aspect into cardinal directions (North, East, South, West).
# Usefulness: Cardinal aspect directions can have significant ecological and sunlight exposure effects on vegetation.
