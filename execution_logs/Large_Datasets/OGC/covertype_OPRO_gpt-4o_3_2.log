# Usefulness: Differentiates proximity influence based on discrete elevation ranges, which relate to vegetation and cover type.
elevation_bin_encoded = pd.get_dummies(df['Elevation_Range_Bin'], prefix='Elevation_Bin')
elevation_bin_encoded = elevation_bin_encoded.mul(df['Combined_Road_Hydrology_Fire_Proximity'], axis=0)
