# Usefulness: Groups areas with similar hydrology proximity patterns, which might correlate with forest type.
from sklearn.cluster import KMeans
kmeans = KMeans(n_clusters=4, random_state=42)
df['Hydrology_Proximity_Cluster'] = kmeans.fit_predict(df[['Horizontal_Distance_To_Hydrology', 'Vertical_Distance_To_Hydrology']])

# Combined_Indicators
# Combines normalized values of Brightness, Soil richness, Hydrology proximity, and Wilderness impact score to create a synthetic indicator.
# Usefulness: Captures the joint interaction of these variables, highlighting specific environmental traits.
df['Combined_Indicators'] = (
    (df['Normalized_Brightness'].clip(lower=0)) * 
