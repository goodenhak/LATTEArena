# Combines Wilderness_Area indicators with soil presence weighted by their distances to fire and roads.
# Usefulness: Captures diversity of wilderness and soil types as influenced by their proximity to fire points and roadways, which might alter forest cover type.
wilderness_columns = [col for col in df.columns if col.startswith('Wilderness_Area')]
soil_columns = [col for col in df.columns if col.startswith('Soil_Type')]
df['Combined_Soil_Wilderness_Interaction'] = (
    (df[wilderness_columns].sum(axis=1) * df[soil_columns].sum(axis=1)) /
    ((df['Horizontal_Distance_To_Fire_Points'] + df['Horizontal_Distance_To_Roadways']) + 1e-8)
