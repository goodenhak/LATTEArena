python
# Road_Hydrology_Fire_Balance
# Standardizes the mean of Horizontal_Distance_To_Roadways, Horizontal_Distance_To_Hydrology, and Horizontal_Distance_To_Fire_Points using z-score.
# Usefulness: Captures the balance between distances to roads, water features, and wildfire points. This distinction is significant for forest characteristics.
df['Road_Hydrology_Fire_Balance'] = (
    (df['Horizontal_Distance_To_Roadways'] + df['Horizontal_Distance_To_Hydrology'] + df['Horizontal_Distance_To_Fire_Points'] - df[['Horizontal_Distance_To_Roadways', 'Horizontal_Distance_To_Hydrology', 'Horizontal_Distance_To_Fire_Points']].mean(axis=1)) /
