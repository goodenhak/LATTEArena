# Elevation_Log_Transform
# Applies log transform to Elevation to emphasize lower elevation variations and reduce higher elevation effects.
# Usefulness: Some vegetation types thrive in lower altitude zones; this transformation captures such nuances better.
df['Elevation_Log'] = np.log(df['Elevation'])

# Combined_Hydrology_Effect
# Combines horizontal and vertical hydrology distances using a weighted average with more emphasis on vertical distances.
# Usefulness: Vertical distances represent elevation differences and water accessibility, which are crucial for vegetation growth.
df['Combined_Hydrology_Effect'] = 0.6 * df['Vertical_Distance_To_Hydrology'] + 0.4 * df['Horizontal_Distance_To_Hydrology']

# Slope_Aspect_Interaction
# Creates an interaction term between Slope and Aspect (sine transformed) to emphasize slope angles facing specific directions.
# Usefulness: Directional slope influences sunlight exposure and runoff patterns, impacting vegetation types.
df['Slope_Aspect_Interaction'] = df['Slope'] * np.sin(np.radians(df['Aspect']))

# Soil_Type_Most_Present
# Finds the most present soil type per row and assigns it as a categorical feature.
# Usefulness: Identifying the dominant soil type directly relates to the vegetation present in the area.
soil_columns = [col for col in df.columns if 'Soil_Type' in col]
df['Soil_Type_Most_Present'] = df[soil_columns].idxmax(axis=1)

# Fire_Road_Ratio
# Calculates the ratio of horizontal fire points versus roadways distances, normalized using proximity index.
# Usefulness: Highlights areas where fire impact might outweigh road influence, potentially impacting vegetation management.
df['Fire_Road_Ratio'] = df['Horizontal_Distance_To_Fire_Points'] / (df['Horizontal_Distance_To_Roadways'] + df['Road_Proximity_Index'] + 1e-5)

# Wilderness_Weighted_Impact
# Creates a weighted sum of Wilderness_Area indicators, prioritizing more remote or protected areas.
# Usefulness: Reflects the conservation or isolation degree of the cell's wilderness area.
df['Wilderness_Weighted_Impact'] = df['Wilderness_Area1'] * 1.0 + df['Wilderness_Area2'] * 1.5 + df['Wilderness_Area3'] * 1.2 + df['Wilderness_Area4'] * 2.0

# Hydrology_Distance_Bin
# Bins Horizontal_Distance_To_Hydrology into quartiles to simplify proximity analysis.
# Usefulness: Simplifies the hydrology distances into discrete bins for easier understanding of proximity patterns.
df['Hydrology_Distance_Bin'] = pd.qcut(df['Horizontal_Distance_To_Hydrology'], q=4, labels=['Very_Close', 'Close', 'Far', 'Very_Far'])

# Brightness_Corrected_Elevation
# Combines Elevation with Normalized_Brightness by scaling elevation using brightness values.
# Usefulness: Emphasizes areas where elevation and light exposure jointly influence vegetation density.
df['Brightness_Corrected_Elevation'] = df['Elevation'] * (df['Normalized_Brightness'] + 1)

# Road_Hydrology_Distance_Contrast
# Computes the absolute difference between horizontal road and hydrology distances, normalized.
# Usefulness: Highlights areas where transportation proximity greatly contrasts with water feature proximity.
df['Road_Hydrology_Distance_Contrast'] = np.abs(df['Horizontal_Distance_To_Roadways'] - df['Horizontal_Distance_To_Hydrology']) / (df['Horizontal_Distance_To_Hydrology'] + 1e-5)

# Soil_Type_Saturation_Index
# Calculates a saturation index based on the weighted sum of soil types multiplied by richness levels.
# Usefulness: Captures areas with rich soil diversity as high saturation regions, which might indicate robust vegetation support.
df['Soil_Type_Saturation_Index'] = df['Soil_Type_Weighted_Sum'] * df[[col for col in df.columns if 'Soil_Type' in col]].sum(axis=1)

# Combined_Distance_Normalized
# Normalizes the combined distance to hydrology, roads, and fire points using Min-Max scaling.
# Usefulness: By normalizing this distance, the feature can highlight relative remoteness versus concentrated areas.
df['Combined_Distance_Normalized'] = (df['Combined_Distance_To_Features'] - df['Combined_Distance_To_Features'].min()) / (df['Combined_Distance_To_Features'].max() - df['Combined_Distance_To_Features'].min())

# Aspect_Category
# Categorizes Aspect into broader tree-growing directional zones (e.g., North-facing, South-facing, etc.).
# Usefulness: Aspect direction strongly correlates with growth patterns due to light exposure and runoff characteristics.
df['Aspect_Category'] = pd.cut(df['Aspect'], bins=[0, 90, 180, 270, 360], labels=['North', 'East', 'South', 'West'], include_lowest=True)

# Wilderness_Hydrology_Contrast
