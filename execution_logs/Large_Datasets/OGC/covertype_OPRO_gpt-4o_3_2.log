# Usefulness: Balances the influence of multiple environmental factors impacting vegetation cover.
df['Fire_Hydrology_Road_Composite'] = 3 / ((1 / (df['Horizontal_Distance_To_Fire_Points'] + 1e-5)) +
                                           (1 / (df['Horizontal_Distance_To_Hydrology'] + 1e-5)) +
                                           (1 / (df['Horizontal_Distance_To_Roadways'] + 1e-5)))

# Wilderness_Soil_Scaled
# Scales the sum of wilderness indicators by the soil type presence count to examine landscape complexity.
# Usefulness: Captures how soil diversity complements wilderness designation to influence ecological systems.
df['Wilderness_Soil_Scaled'] = (df[['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3', 'Wilderness_Area4']].sum(axis=1)) \
                                / (df[['Soil_Type10', 'Soil_Type11', 'Soil_Type12', 'Soil_Type13', 'Soil_Type20', 'Soil_Type22', 'Soil_Type23', 'Soil_Type24',
                                       'Soil_Type29', 'Soil_Type30', 'Soil_Type31', 'Soil_Type32', 'Soil_Type33']].sum(axis=1) + 1e-5)

# Brightness_Road_Interaction
# Multiplies Normalized_Brightness by Road_Proximity_Index to model vegetation influenced by light exposure near roads.
# Usefulness: Highlights interactions between human activity (roads) and environmental factors like light intensity.
df['Brightness_Road_Interaction'] = df['Normalized_Brightness'] * df['Road_Proximity_Index']

# Hydrology_Gradient_Ratio
# Computes the ratio between Vertical_Distance_To_Hydrology and Slope to highlight terrain gradient effects near water.
# Usefulness: Identifies areas with sharp hydrological gradients that may influence water flow and vegetation.
df['Hydrology_Gradient_Ratio'] = df['Vertical_Distance_To_Hydrology'] / (df['Slope'] + 1e-5)

# Wilderness_Aspect_Interaction
# Multiplies Wilderness indicators by the sine and cosine of Aspect to measure directional effects in protected areas.
# Usefulness: Links wilderness designations to directional ecological patterns influenced by aspect.
df['Wilderness_Aspect_Sine'] = df[['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3', 'Wilderness_Area4']].sum(axis=1) * np.sin(np.radians(df['Aspect']))
df['Wilderness_Aspect_Cosine'] = df[['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3', 'Wilderness_Area4']].sum(axis=1) * np.cos(np.radians(df['Aspect']))

