# Elevation_Sqrt
# Square root of elevation to reduce scale and emphasize smaller variations in the height, which could significantly impact vegetation types.
# Usefulness: Captures non-linear relationships in elevation. Changes in vegetation types can be significant depending on lower elevations.
df['Elevation_Sqrt'] = df['Elevation'].apply(lambda x: x  0.5)
end

python
# Horizontal_Distance_To_Fire_Points_Rank
# Rank of horizontal distance to fire points to better understand relative distances in ordinal terms.
# Usefulness: Helps to assess relative proximity to fire points, which could impact forest cover.
df['Horizontal_Distance_To_Fire_Points_Rank'] = df['Horizontal_Distance_To_Fire_Points'].rank()
end

python
# Hydrology_Distance
# Euclidean distance to nearest hydrology (using horizontal and vertical distance).
# Usefulness: Combines the two hydrology-related distances into one measure, which can be a better representation of physical closeness to water.
df['Hydrology_Distance'] = (df['Horizontal_Distance_To_Hydrology']2 + df['Vertical_Distance_To_Hydrology']2)  0.5
end

python
# Aspect_Cosine, Aspect_Sine
# Trigonometric transformations (cosine and sine) of the aspect angle to represent directionality in X/Y coordinates.
# Usefulness: Aspect is a circular variable, and this transformation allows for better handling in predictive models.
df['Aspect_Cosine'] = np.cos(np.radians(df['Aspect']))
df['Aspect_Sine'] = np.sin(np.radians(df['Aspect']))
end

python
# Mean_Hillshade
# Average hillshade based on the three times of the day (9am, Noon, 3pm).
# Usefulness: Provides a single feature summarizing the overall sunlight exposure of the cell.
df['Mean_Hillshade'] = df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].mean(axis=1)
end

python
# Elevation_Distance_To_Road_Ratio
# Ratio of elevation to the horizontal distance to a roadway.
# Usefulness: Creates a combined feature representing relative height compared to the distance from roads, which could impact forest cover.
df['Elevation_Distance_To_Road_Ratio'] = df['Elevation'] / df['Horizontal_Distance_To_Roadways']
end

python
# Distance_To_Roads_Binned
# Bin the horizontal distance to roadways into equal-sized categorical bins.
# Usefulness: Creates discrete categories for distance from roads, which could help models capture group-level effects.
df['Distance_To_Roads_Binned'] = pd.cut(df['Horizontal_Distance_To_Roadways'], bins=[-1, 1000, 2000, 3000, 4000, 5000, 6000, 8000], labels=[1, 2, 3, 4, 5, 6, 7])
end

python
# Hillshade_Contrast
# Difference between the maximum and minimum hillshade at 9am, noon, and 3pm.
# Usefulness: Captures diurnal variation in sunlight exposure, which can influence forest growth and composition.
df['Hillshade_Contrast'] = df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].max(axis=1) - df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].min(axis=1)
end

python
