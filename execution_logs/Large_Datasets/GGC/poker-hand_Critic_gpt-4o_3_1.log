python
# Feature Name: possible_straight_flush
# Feature Description: Combines straight pattern via sequential ranks (is_straight) and 
# the number of unique suits (unique_suit_count == 1) to identify potential Straight Flush formations.
# Usefulness: Helps in identifying hands close to forming a Straight Flush (Target = 8, 9).

df['possible_straight_flush'] = ((df['unique_suit_count'] == 1) & df['is_straight_flush_ready']).astype(int)
end

python
# Feature Name: high_card_flush_ready
# Feature Description: Indicates hands that combine all high-value cards (Ace, King, Queen, Jack, Ten) 
# with uniform suits for identifying Flush or Royal Flush.
# Usefulness: Useful for detecting hands that qualify as Flush (Target = 5) or Royal Flush (Target = 9).

df['high_card_flush_ready'] = ((df['high_card_presence'] == True) & (df['unique_suit_count'] == 1)).astype(int)
end
  
python
# Feature Name: log_rank_suit_interaction
# Feature Description: Log transformation of rank_suit_interaction to compress variability and mitigate skewness.
# Usefulness: Provides a more normalized representation of the original rank_suit_interaction feature, 
# which suffers from a large range of values.

import numpy as np
df['log_rank_suit_interaction'] = np.log(df['rank_suit_interaction'])
end

