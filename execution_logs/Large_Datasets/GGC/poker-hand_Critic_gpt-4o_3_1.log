# Feature Name: is_perfect_royal_flush
# Feature Description: A binary feature indicating if the hand contains high-value cards {Ace, King, Queen, Jack, Ten} and all of them are of the same suit (unique_suit_count == 1).
# Usefulness: Directly identifies hands that are guaranteed to be Royal Flush (Target = 9) and assists in simplifying classification of high-value hands.

df['is_perfect_royal_flush'] = ((df['is_royal_flush_candidate'] == True) & (df['unique_suit_count'] == 1)).astype(int)
end

python
# Feature Name: two_pairs_strength
# Feature Description: A numeric feature combining the presence of two pairs (is_two_pairs) and the rank diversity (unique_rank_count) to weigh the likelihood of being Target = 2 (Two Pairs).
# Usefulness: Two Pairs rely on the presence of two equal ranks; mixing rank diversity gives additional context to distinguish stronger Two Pair hands.

df['two_pairs_strength'] = df['is_two_pairs'] * df['unique_rank_count']
end

python
# Feature Name: normalized_unique_rank_suit_ratio
# Feature Description: Min-max scaled version of unique_rank_suit_ratio for better interpretability and consistency across records.
# Usefulness: Scaling this feature ensures that large values do not overshadow smaller values in the prediction process, improving downstream model robustness.

from sklearn.preprocessing import MinMaxScaler
scaler = MinMaxScaler()
df['normalized_unique_rank_suit_ratio'] = scaler.fit_transform(df[['unique_rank_suit_ratio']])
end

python
# Feature Name: rank_suit_difference_bin
# Feature Description: A categorized version of rank_suit_difference_ratio to create bins (low, medium, high) based on suit-rank interaction thresholds.
# Usefulness: Binning helps identify natural groupings and thresholds for hands that could signify specific poker categories like Full House or Flush.

def bin_rank_suit_difference_ratio(value):
    if value <= 0.2:
        return 'low'
    elif value <= 0.4:
        return 'medium'
    else:
        return 'high'

df['rank_suit_difference_bin'] = df['rank_suit_difference_ratio'].apply(bin_rank_suit_difference_ratio)
end

python
# Feature Name: royal_flush_strength
# Feature Description: Log-transformed product combining high_card_presence and suit_diversity_bin to rank potential Royal Flush strength.
# Usefulness: Highlights subsets of hands that are likelier to form Royal Flush when suit attributes and high cards align.

df['royal_flush_strength'] = np.log(df['unique_rank_count'] * (df['high_card_presence'] == True).astype(int) * (df['suit_diversity_bin'] == 'high').astype(int) + 1)
end

python
# Dropping Redundant Columns: Remove columns that are captured by new feature engineering.

df.drop(columns=['is_royal_flush_candidate', 'rank_std_bin', 'rank_count_bin_Moderate', 'rank_count_bin_Few'], inplace=True)
end

python
# Feature Name: is_straight_ready
# Feature Description: Indicates if the hand has sequential ranks but does not satisfy suit uniformity to qualify as a Flush.
# Usefulness: Helps to differentiate between Straight (Target = 4) and Straight Flush (Target = 8).

df['is_straight_ready'] = (df['is_straight_flush_ready'] == True).astype(int) & (df['unique_suit_count'] > 1).astype(int)
end

python
# Feature Name: full_house_strength
# Feature Description: Combines is_three_or_more_of_a_kind and rank_std_zscore to detect higher confidence for Full House hands (Target = 6).
# Usefulness: Full House requires a pair and Three of a Kind; combining variability offers clarity for ranking potential strong hands.

df['full_house_strength'] = df['is_three_or_more_of_a_kind'] * abs(df['rank_std_zscore'])
end

python
# Feature Name: flush_probability
# Feature Description: Probability derived from normalized suit_diversity_bin and unique_suit_count to predict likelihood of Flush (Target = 5).
# Usefulness: Flush relies entirely on suit uniformity; combining these features improves prediction specificity.

df['flush_probability'] = (df['suit_diversity_bin'] == 'high').astype(int) / (df['unique_suit_count'] + 1)
end
