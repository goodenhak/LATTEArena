# Feature name: is_two_pairs
# Feature description: Binary feature indicating if the hand contains exactly two pairs of equal ranks.
# Usefulness: Helps distinguish Two Pairs (Target = 2) from other overlapping patterns, such as Full House (Target = 6).
df['is_two_pairs'] = (df['unique_rank_count'] == 3) & (df['rank_is_pair_or_not'] == 1)
end

python
# Feature name: is_full_house
# Feature description: Binary feature indicating if the hand contains both a three-of-a-kind and a pair.
# Usefulness: Directly targets Full House (Target = 6) by combining rank patterns.
df['is_full_house'] = (df['unique_rank_count'] == 2) & (df['rank_is_pair_or_not'] == 1)
end

python
# Feature name: is_straight_flush
# Feature description: Binary feature indicating if the ranks are sequential and all suits are identical.
# Usefulness: Directly supports identifying Straight Flush hands (Target = 8), which combines both is_straight and suit_is_flush.
df['is_straight_flush'] = df['is_straight'] & df['suit_is_flush']
end

python
# Feature name: is_high_card_hand
# Feature description: Binary feature to capture hands with only high-value cards (Ace, King, Queen, Jack, Ten) but no patterns.
# Usefulness: Attempts to help the model better identify 'Nothing in hand' (Target = 0).
df['is_high_card_hand'] = df['high_card_presence'] & ~(
    df['rank_is_pair_or_not'] | df['is_straight'] | df['suit_is_flush']
)
end

python
# Feature name: rank_count_bin
# Feature description: Binned version of unique rank count to categorize ranges into 'Few', 'Moderate', or 'Many'.
# Usefulness: Simplifies the interpretation of unique_rank_count for discrete decision-making.
df['rank_count_bin'] = pd.cut(df['unique_rank_count'], bins=[2, 3, 4, 5], labels=['Few', 'Moderate', 'Many'])
end

python
# Feature name: unique_rank_count_scaled
# Feature description: Min-max scaled version of unique_rank_count.
# Usefulness: Improves the interpretability and numerical stability of unique_rank_count for the model.
df['unique_rank_count_scaled'] = (df['unique_rank_count'] - df['unique_rank_count'].min()) / (
    df['unique_rank_count'].max() - df['unique_rank_count'].min()
)
end

python
# Feature name: suit_rank_difference
# Feature description: Absolute difference between unique_suit_count and unique_rank_count.
# Usefulness: Helps the model understand the relationship between unique ranks and suits when discriminating between patterns like Flush or Full House.
df['suit_rank_difference'] = abs(df['unique_suit_count'] - df['unique_rank_count'])
end

python
# Feature name: unique_suit_distribution_skew
# Feature description: Captures the skewness of unique suit counts per hand.
# Usefulness: Adds diversity of suit distribution and may aid in distinguishing Flush (same-suit hands).
df['unique_suit_distribution_skew'] = (
    df['unique_suit_count_scaled']  3 - df['unique_suit_count_scaled']
) / (1 + df['unique_suit_count_scaled']  2)
end

python
# Feature name: V1V2_normalized
# Feature description: Z-score normalized version of V1V2, adjusting for numerical magnitude.
# Usefulness: Ensures comparable scale across encoded rank-suit combinations, aiding the model.
df['V1V2_normalized'] = (df['V1V2'] - df['V1V2'].mean()) / df['V1V2'].std()
end

python
# Feature name: suit_interaction_std
# Feature description: Standard deviation across all suit-rank interaction features.
# Usefulness: Helps describe the variance in the interaction of suit and rank across the hand.
df['suit_interaction_std'] = df[['V1V2', 'V3V4', 'V5V6', 'V7V8', 'V9V10']].std(axis=1)
end

python
# Feature name: rank_std_zscore
# Feature description: Z-score normalization of rank_distribution_std.
# Usefulness: Converts rank deviation to a normalized scale for better comparability.
df['rank_std_zscore'] = (df['rank_distribution_std'] - df['rank_distribution_std'].mean()) / df['rank_distribution_std'].std()
end

python
# Feature name: scaled_rank_suit_ratio
# Feature description: Ratio of unique ranks to unique suits, scaled using min-max normalization.
# Usefulness: Captures the relationship between rank and suit diversity for the hand.
df['scaled_rank_suit_ratio'] = (df['unique_rank_suit_ratio'] - df['unique_rank_suit_ratio'].min()) / (
    df['unique_rank_suit_ratio'].max() - df['unique_rank_suit_ratio'].min()
)
end

