# Feature name: is_three_of_a_kind_or_more
# Feature description: A binary feature that indicates if the hand has at least three cards of the same rank.
# Usefulness: Helps identify hands belonging to categories Target = 3 (Three of a Kind), Target = 6 (Full House), and Target = 7 (Four of a Kind).

df['is_three_of_a_kind_or_more'] = (df['unique_rank_count'] <= 3) & (df['rank_is_pair_or_not'] == 1)
end

python
# Feature name: is_potential_straight_flush
# Feature description: A binary feature indicating hands with sequential ranks and at least three unique suits.
# Usefulness: Useful for detecting patterns that may lead to Straight Flush (Target = 8).

df['is_potential_straight_flush'] = (df['is_straight'] == True) & (df['unique_rank_count'] == 5) & (df['unique_suit_count'] > 1)
end

python
# Feature name: is_royal_flush_candidate
# Feature description: A binary feature indicating hands with high-value cards (Ace, King, Queen, Jack, Ten) that are also of the same suit.
# Usefulness: Useful for identifying Royal Flush hands (Target = 9).

df['is_royal_flush_candidate'] = (df['is_royal'] == 1) & (df['unique_suit_count'] == 1)
end

python
# Feature name: log_rank_suit_interaction
# Feature description: Log-transformed rank_suit_interaction to reduce skewness and compress data variability.
# Usefulness: Makes heavily skewed rank_suit_interaction more interpretable and manageable during learning.

df['log_rank_suit_interaction'] = np.log(df['rank_suit_interaction'])
end

python
# Feature name: rank_diversity_bin
# Feature description: Categorizes rank diversity into 'low', 'medium', or 'high' bins using unique_rank_count.
# Usefulness: Simplifies relationships between rank diversity and target values by handling ranges more intuitively.

df['rank_diversity_bin'] = pd.cut(df['unique_rank_count'], bins=[2, 3, 4, 5], labels=['low', 'medium', 'high'])
end

python
# Feature name: suit_diversity_bin
# Feature description: Categorizes suit diversity into 'low', 'medium', or 'high' bins using unique_suit_count.
# Usefulness: Captures the complexity of card suit combinations, aiding in predictions like Flush (Target = 5).

df['suit_diversity_bin'] = pd.cut(df['unique_suit_count'], bins=[1, 2, 3, 4], labels=['low', 'medium', 'high'])
end

python
# Feature name: is_pure_high_card_hand
# Feature description: A binary feature indicating hands containing only high cards (Ace, King, Queen, Jack, Ten) but with no recognizable poker hand patterns.
# Usefulness: May offer insights for Target = 0 (Nothing in Hand) and help contrast high-card hands with meaningful poker hands.

df['is_pure_high_card_hand'] = (df['high_card_presence'] == True) & (df['rank_is_pair_or_not'] == 0) & (df['is_royal'] == 0) & (df['is_straight'] == False)
end

