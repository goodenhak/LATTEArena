# Usefulness: Normalizes the difference between suits and ranks, aiding in patterns like Flush,
# Full House or Four of a Kind (Targets 5, 6, 7).

df['suit_rank_ratio'] = df['suit_rank_difference'] / df['unique_rank_count']
end

