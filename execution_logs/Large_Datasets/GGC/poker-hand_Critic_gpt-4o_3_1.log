# Step 1: Combine unique_rank_count and unique_suit_count
# Feature name: is_flush_candidate
# Feature description: Identifies hands with all cards in the same suit (unique_suit_count == 1). Semantically linked to Flush, Straight Flush, and Royal Flush.
# Usefulness: Helps in detecting patterns for targets like Flush (5), Straight Flush (8), and Royal Flush (9).

df[is_flush_candidate] = (df[unique_suit_count] == 1).astype(int)
end

python
# Step 2: Cross is_royal and unique_suit_count
# Feature name: is_royal_flush_clue
# Feature description: Flags hands containing {Ace, King, Queen, Jack, Ten} with all cards in the same suit.
# Usefulness: Direct clue for identifying Royal Flush hands (Target = 9).

df[is_royal_flush_clue] = ((df[is_royal] == 1) & (df[unique_suit_count] == 1)).astype(int)
end

python
# Step 3: Combine is_straight_flush_ready and rank_distribution_std
# Feature name: straight_flush_likelihood
# Feature description: Measures likelihood of a hand forming a Straight Flush or Straight based on sequential ranks and low variability in ranks.
# Usefulness: Provides nuanced insights for detecting Straight (4) and Straight Flush (8).

df[straight_flush_likelihood] = (df[is_straight_flush_ready].astype(int) / (df[rank_distribution_std] + 1e-6)).clip(0, 1)
end

python
# Step 4: Cross is_three_or_more_of_a_kind and rank_is_pair_or_not
# Feature name: full_house_clue
# Feature description: Flags hands having at least one pair and at least three cards of the same rank, indicative of a Full House (Target = 6).
# Usefulness: Enhances model prediction for Full House categories.

df[full_house_clue] = ((df[is_three_of_a_kind_or_more] == True) & (df[rank_is_pair_or_not] == 1)).astype(int)
end

python
# Step 5: Log Transform rank_suit_interaction
# Feature name: log_rank_suit_interaction
# Feature description: Log-transformed version of rank_suit_interaction to reduce skewness and compress data variability.
# Usefulness: Brings more uniform distribution, improving model learnability and performance.

df[log_rank_suit_interaction] = np.log(df[rank_suit_interaction] + 1)
end

python
# Step 6: Normalize rank_suit_difference_ratio (min-max normalization)
# Feature name: normalized_rank_suit_difference_ratio
# Feature description: Normalized version of rank_suit_difference_ratio to highlight subtle differences across records.
# Usefulness: Ensures uniform scaling and better interpretation when combined with other features.

df[normalized_rank_suit_difference_ratio] = (df[rank_suit_difference_ratio] - df[rank_suit_difference_ratio].min()) / (df[rank_suit_difference_ratio].max() - df[rank_suit_difference_ratio].min())
end

python
# Step 7: Bin rank_distribution_std
# Feature name: rank_distribution_std_binned
# Feature description: Categorizes rank_distribution_std into 'low', 'medium', and 'high' bins based on quartiles (Q1, Q2, Q3).
# Usefulness: Improves interpretability and highlights variability patterns in ranks.

rank_std_bins = pd.cut(df[rank_distribution_std], bins=[df[rank_distribution_std].min(), 11.987493482792807, 14.92313639956427, 17.51285242329187, df[rank_distribution_std].max()], labels=[low, medium, high])
df[rank_distribution_std_binned] = rank_std_bins
end

python
# Step 8: Combine is_two_pairs, unique_rank_count, and rank_suit_difference
# Feature name: two_pairs_pattern
# Feature description: Combines three features to detect patterns specific to hands forming Two Pairs (Target = 2).
# Usefulness: Helps refine prediction accuracy for Two Pairs category by capturing its unique mechanics.

df[two_pairs_pattern] = ((df[is_two_pairs] == True) & (df[unique_rank_count] == 3) & (df[suit_rank_difference] <= 2)).astype(int)
end

python
# Step 9: Drop redundant columns
# Dropping columns that don't contribute significant new information.
df.drop(columns=[V1V2, V3V4, V5V6, V7V8, V9V10], inplace=True)
end

python
# Step 10: Additional transformation for interaction features (example placeholder if needed further)
# Example of creating an enhanced interaction feature
# Feature name: enhanced_rank_suit_interaction
# Feature description: Applies advanced transformation combining rank_suit_interaction and suit_diversity_bin.
# Usefulness: Extracts more insights from interaction patterns in rank-suit relationships.

