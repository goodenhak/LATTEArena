# rank_is_pair_or_not
# Binary feature that checks if there is at least one pair of equal ranks among the five cards.
# Usefulness: This helps identify hands like One Pair, Two Pairs, Full House, which rely on rank equality.
df['rank_is_pair_or_not'] = (
    (df['V2'] == df['V4']) | 
    (df['V2'] == df['V6']) | 
    (df['V2'] == df['V8']) | 
    (df['V2'] == df['V10']) | 
    (df['V4'] == df['V6']) | 
    (df['V4'] == df['V8']) | 
    (df['V4'] == df['V10']) | 
    (df['V6'] == df['V8']) | 
    (df['V6'] == df['V10']) | 
    (df['V8'] == df['V10'])
).astype(int)
end

python
# suit_is_flush
# Binary feature that checks if all suits are the same (i.e., it's a flush).
# Usefulness: Used to identify Flushes, Straight Flushes, and Royal Flushes, which are critical poker hands.
df['suit_is_flush'] = (
    (df['V1'] == df['V3']) & 
    (df['V1'] == df['V5']) & 
    (df['V1'] == df['V7']) & 
    (df['V1'] == df['V9'])
).astype(int)
end

python
# is_straight
# Binary feature that checks if the ranks are sequentially ranked.
# Usefulness: This identifies hands like Straight and Straight Flush, which are based on consecutive ranks.
sorted_ranks = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(sorted, axis=1)
df['is_straight'] = (
    (sorted_ranks.iloc[:, 1] - sorted_ranks.iloc[:, 0] == 1) & 
    (sorted_ranks.iloc[:, 2] - sorted_ranks.iloc[:, 1] == 1) & 
    (sorted_ranks.iloc[:, 3] - sorted_ranks.iloc[:, 2] == 1) & 
    (sorted_ranks.iloc[:, 4] - sorted_ranks.iloc[:, 3] == 1)
).astype(int)
end

python
# is_royal
# Binary feature that checks if the hand contains {Ace, King, Queen, Jack, Ten}.
# Usefulness: Necessary to identify Royal Flush, which is the highest-ranked poker hand.
royal_set = {1, 10, 11, 12, 13}
df['is_royal'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda x: set(x) == royal_set, axis=1).astype(int)
end

python
# unique_rank_count
# Counts the number of unique ranks in the player’s hand.
# Usefulness: Helps determine hand types like One Pair, Two Pairs, Full House, and Four of a Kind.
df['unique_rank_count'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].nunique(axis=1)
end

python
# unique_suit_count
# Counts the number of unique suits in the player’s hand.
# Usefulness: Helps quickly identify if a hand is disqualified from being a flush-based hand.
df['unique_suit_count'] = df[['V1', 'V3', 'V5', 'V7', 'V9']].nunique(axis=1)
end

python
# rank_differences_std
# Standard deviation of the differences between consecutive card ranks when sorted.
# Usefulness: A lower standard deviation can indicate sequential ranks (e.g., a Straight) while a higher one indicates more scattered ranks.
sorted_ranks = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(sorted, axis=1)
df['rank_differences_std'] = sorted_ranks.diff(axis=1).std(axis=1)
end

python
# suit_rank_interaction
# Represents a unique combination of suit and rank as a single encoded value.
# Usefulness: Encapsulates full card identity, which can be useful for models that need a holistic feature representation.
df['V1V2'] = df['V1'] * 13 + df['V2']
df['V3V4'] = df['V3'] * 13 + df['V4']
df['V5V6'] = df['V5'] * 13 + df['V6']
df['V7V8'] = df['V7'] * 13 + df['V8']
df['V9V10'] = df['V9'] * 13 + df['V10']
end

python
# dropping columns after processing
# Dropped individual columns after encoding composite features (for example, V1, V2, etc. after creating 'suit_rank_interaction').
df.drop(columns=['V1', 'V2', 'V3', 'V4', 'V5', 'V6', 'V7', 'V8', 'V9', 'V10'], inplace=True)
end
