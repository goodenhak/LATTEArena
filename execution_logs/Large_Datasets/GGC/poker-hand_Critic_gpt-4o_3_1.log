urn 'medium'\n    else:\n        return 'high'\n\ndf['rank_suit_difference_bin'] = df['rank_suit_difference_ratio'].apply(bin_rank_suit_difference_ratio)", "# Feature Name: royal_flush_strength\n# Feature Description: Log-transformed product combining high_card_presence and suit_diversity_bin to rank potential Royal Flush strength.\n# Usefulness: Highlights subsets of hands that are likelier to form Royal Flush when suit attributes and high cards align.\n\ndf['royal_flush_strength'] = np.log(df['unique_rank_count'] * (df['high_card_presence'] == True).astype(int) * (df['suit_diversity_bin'] == 'high').astype(int) + 1)", "# Dropping Redundant Columns: Remove columns that are captured by new feature engineering.\n\ndf.drop(columns=['is_royal_flush_candidate', 'rank_std_bin', 'rank_count_bin_Moderate', 'rank_count_bin_Few'], inplace=True)", "# Feature Name: is_straight_ready\n# Feature Description: Indicates if the hand has sequential ranks but does not satisfy suit uniformity to qualify as a Flush.\n# Usefulness: Helps to differentiate between Straight (Target = 4) and Straight Flush (Target = 8).\n\ndf['is_straight_ready'] = (df['is_straight_flush_ready'] == True).astype(int) & (df['unique_suit_count'] > 1).astype(int)", "# Feature Name: full_house_strength\n# Feature Description: Combines is_three_or_more_of_a_kind and rank_std_zscore to detect higher confidence for Full House hands (Target = 6).\n# Usefulness: Full House requires a pair and Three of a Kind; combining variability offers clarity for ranking potential strong hands.\n\ndf['full_house_strength'] = df['is_three_or_more_of_a_kind'] * abs(df['rank_std_zscore'])", "# Feature Name: flush_probability\n# Feature Description: Probability derived from normalized suit_diversity_bin and unique_suit_count to predict likelihood of Flush (Target = 5).\n# Usefulness: Flush relies entirely on suit uniformity; combining these features improves prediction specificity.\n\ndf['flush_probability'] = (df['suit_diversity_bin'] == 'high').astype(int) / (df['unique_suit_count'] + 1)"]
