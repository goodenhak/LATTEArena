# Feature name: Sunlight_Aspect_Interaction
# Feature description: An interaction effect combining sunlight exposure (Hillshade) and slope direction (Aspect).
# Usefulness: Captures how sunlight interacts with terrain slopes and directions, relevant for vegetation types.
df['Sunlight_Aspect_Interaction'] = (df['Aspect_Cos'] * df['Hillshade_9am']) + (df['Aspect_Sin'] * df['Hillshade_3pm'])
end

python
# Feature name: Elevation_Vegetation_Ratio
# Feature description: Ratio of normalized elevation to vegetation zones (numerically encoded).
# Usefulness: Highlights the relationship between elevation and vegetation, which significantly influences forest cover type.
df['Vegetation_Zones_LabelEncode'] = df['Vegetation_Zones'].map({'Alpine': 3, 'Subalpine': 2, 'Montane': 1, 'Lowland': 0})
df['Elevation_Vegetation_Ratio'] = df['Elevation_Normalized'] / (df['Vegetation_Zones_LabelEncode'] + 1)
end

python
# Feature name: Adjusted_Hydrology
# Feature description: Terrain-adjusted proximity to water bodies.
# Usefulness: Accounts for the impact of steep slopes on accessibility to hydrology, influencing forest characteristics.
df['Adjusted_Hydrology'] = (df['Vertical_Distance_To_Hydrology'] / (df['Horizontal_Distance_To_Hydrology'] + 1)) * (df['Slope'] + 1)
end

python
# Feature name: Combined_Proximity
# Feature description: Aggregated feature for overall proximity to roads, fire points, and hydrology.
# Usefulness: A holistic measure of accessibility, which can influence forest management strategies.
df['Combined_Proximity'] = df['Horizontal_Distance_To_Roadways'] + df['Horizontal_Distance_To_Fire_Points'] + df['Horizontal_Distance_To_Hydrology']
end

python
# Feature name: Log_Fire_Distance
# Feature description: Log transformation of horizontal distance to fire points, reducing skewness.
# Usefulness: Essential to standardize the scale of skewed data for improved model performance.
df['Log_Fire_Distance'] = np.log(df['Horizontal_Distance_To_Fire_Points'] + 1)
end

python
# Feature name: Log_Normalized_Slope
# Feature description: Log-transformed and normalized slope data using z-score normalization.
# Usefulness: Helps to scale and balance the distribution of slope values for better modeling.
df['Log_Normalized_Slope'] = (np.log(df['Slope'] + 1) - np.mean(np.log(df['Slope'] + 1))) / np.std(np.log(df['Slope'] + 1))
end

python
# Feature name: Slope_Binned
# Feature description: Binned slope values into categories: Flat, Moderate, Steep.
# Usefulness: Helps model non-linear relationships between terrain steepness and forest cover type.
df['Slope_Binned'] = pd.cut(df['Slope'], bins=[0, 10, 25, 66], labels=['Flat', 'Moderate', 'Steep'])
end

python
# Feature name: Amenities_Ratio
# Feature description: Ratio of hydrology distances to combined distances of amenities.
# Usefulness: Captures the relative importance of hydrology proximity compared to other amenities.
df['Amenities_Ratio'] = df['Horizontal_Distance_To_Hydrology'] / (df['Horizontal_Distance_To_Roadways'] + df['Horizontal_Distance_To_Fire_Points'] + 1)
end

python
# Feature name: Log_Combined_Amenities
# Feature description: Log of the aggregated distances to amenities for uniform scaling.
# Usefulness: Reduces the skewness of distances to amenities, enabling better handling by the model.
df['Log_Combined_Amenities'] = np.log(df['Combined_Distance_To_Amenities'] + 1)
end

python
# Feature name: Road_Fire_Ratio
# Feature description: Ratio of road distance to fire point distance.
# Usefulness: Highlights the relative ease of access to roads compared to fire points.
df['Road_Fire_Ratio'] = df['Horizontal_Distance_To_Roadways'] / (df['Horizontal_Distance_To_Fire_Points'] + 1)
end

python
# Feature name: Vegetation_Zone_Soil_Interaction
# Feature description: Interactions between vegetation zones and predominant soil type.
# Usefulness: Combines ecological features to enhance understanding of cover type.
df['Vegetation_Zone_Soil_Interaction'] = df['Soil_Type_Mode'].factorize()[0] * df['Vegetation_Zones_LabelEncode']
end

