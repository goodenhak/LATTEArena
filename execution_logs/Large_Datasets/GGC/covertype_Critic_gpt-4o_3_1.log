# Feature name: Elevation_Soil_Interaction
# Feature description: Multiplicative interaction between Elevation and Soil_Type_Grouped to capture ecosystem-specific dependencies.
# Usefulness: Elevation combined with soil type can reflect vegetation zones and forest biome characteristics.
df['Elevation_Soil_Interaction'] = df['Elevation'] * df['Soil_Type_Grouped']
end

python
# Feature name: Adjusted_Hydrology
# Feature description: Interaction of slope with vertical and horizontal distances to hydrology to understand water flow dynamics.
# Usefulness: Reflects the influence of terrain steepness and hydrology proximity on ecological niches.
df['Adjusted_Hydrology'] = (df['Vertical_Distance_To_Hydrology'] / df['Horizontal_Distance_To_Hydrology']) * (1 + df['Slope'])
end

python
# Feature name: Light_Exposure
# Feature description: Aggregated interaction of terrain aspect and hillshade measurements to model sunlight-exposure effects.
# Usefulness: Sunlight direction and intensity are critical predictors for vegetation cover and forest type determination.
df['Light_Exposure'] = (df['Aspect_Cos'] * df['Hillshade_9am']) + (df['Aspect_Sin'] * df['Hillshade_3pm'])
end

python
# Feature name: Amenities_Proximity
# Feature description: Ratio of hydrology proximity distance to combined distances of fire points and roadways.
# Usefulness: Highlights relative proximity to key land-use features, useful for forest cover and risk analysis.
df['Amenities_Proximity'] = df['Horizontal_Distance_To_Hydrology'] / (df['Horizontal_Distance_To_Fire_Points'] + df['Horizontal_Distance_To_Roadways'])
end

python
# Feature name: Log_Hydrology_Distance
# Feature description: Log transformation of horizontal distance to hydrology to address skewness and capture relative proximity.
# Usefulness: Reduces the impact of extreme values and improves modeling consistency for large-distance features.
df['Log_Hydrology_Distance'] = np.log1p(df['Horizontal_Distance_To_Hydrology'])
end

python
# Feature name: Slope_Binned
# Feature description: Categorizing slope into ‘Flat’, ‘Moderate’, and ‘Steep’ terrain classes based on thresholds.
# Usefulness: Helps capture non-linear relationships between slope and environmental attributes affecting forest cover type.
df['Slope_Binned'] = pd.cut(df['Slope'], bins=[0, 10, 25, 66], labels=['Flat', 'Moderate', 'Steep'])
end

python
# Feature name: Clipped_Horizontal_Distance
# Feature description: Clipping the horizontal distance to hydrology to remove effects from extreme outliers. Defined by the 5th and 95th percentiles.
# Usefulness: Improves feature robustness and prevents outliers from skewing the learning of the model.
lower_clip = df['Horizontal_Distance_To_Hydrology'].quantile(0.05)
upper_clip = df['Horizontal_Distance_To_Hydrology'].quantile(0.95)
df['Clipped_Horizontal_Distance'] = df['Horizontal_Distance_To_Hydrology'].clip(lower=lower_clip, upper=upper_clip)
end

python
# Dropping redundant columns
df.drop(columns=['Combined_Distance_To_Amenities', 'Log_Road_Distance', 'Log_Fire_Distance'], inplace=True)
end

python
# Feature name: Terrain_Sun_Interaction
# Feature description: Calculating combined impact of terrain steepness and sunlight exposure using slope, hillshade, and aspect.
# Usefulness: Models microclimate factors influencing forest growth and type.
df['Terrain_Sun_Interaction'] = (df['Slope'] * df['Light_Exposure']) / (1 + abs(df['Aspect_Cos']))
end

python
# Feature name: Vegetation_Elevation_Bin
# Feature description: Encodes vegetation zones based on elevation bins, capturing natural vegetation transitions.
# Usefulness: Improves prediction by mapping elevation directly to ecological classification.
df['Vegetation_Elevation_Bin'] = pd.cut(
    df['Elevation'], 
    bins=[2142, 3000, 3200, 3679], 
    labels=['Montane-Low', 'Montane-High', 'Subalpine']
)
end

python
# Feature name: Hillshade_Ratio
# Feature description: Computes the ratio of morning hillshade to afternoon hillshade to reflect diurnal differences in sunlight impact.
# Usefulness: Differentiates forest types that respond to light patterns across the day.
df['Hillshade_Ratio'] = df['Hillshade_9am'] / (df['Hillshade_3pm'] + 1)
end

python
# Feature name: Slope_Hydrology_Interaction
# Feature description: Combining slope with horizontal and vertical hydrology distances to better understand water flow on sloped terrain.
# Usefulness: Water proximity and slope influence vegetation type.
