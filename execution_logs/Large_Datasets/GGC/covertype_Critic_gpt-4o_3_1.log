2026-05-17 04:56:08,793 - INFO - ops_string = ["# Aspect_Hillshade_Interaction\n# Feature description: Captures interaction between terrain orientation (Aspect) and sunlight intensity (Hillshade indices) to model how terrain direction affects forest vegetation.\n# Usefulness: Helps quantify the influence of sunlight and terrain orientation on vegetation zones, which may correlate with forest cover type.\ndf['Aspect_Hillshade_Interaction'] = (np.cos(np.radians(df['Aspect'])) * df['Hillshade_Noon']) + (np.sin(np.radians(df['Aspect'])) * df['Hillshade_3pm'])", "# Slope_Accessibility_Modifier\n# Feature description: Interaction feature combining terrain steepness (Slope) with accessibility indicators such as Fire_Distance_Log and Road_Distance_Log.\n# Usefulness: Reflects accessibility challenges due to steep slopes, which influences vegetation and forest accessibility patterns.\ndf['Slope_Accessibility_Modifier'] = df['Slope'] * (df['Fire_Distance_Log'] + df['Road_Distance_Log'])", "# Log_Hydrology_Vertical_Distance\n# Feature description: Log transformation of Vertical_Distance_To_Hydrology to reduce skewness in the distribution and highlight relative distance importance.\n# Usefulness: Helps normalize the highly skewed vertical hydrology distance data, making it more predictive for downstream tasks.\ndf['Log_Hydrology_Vertical_Distance'] = np.log(df['Vertical_Distance_To_Hydrology'] + 1)", "# Elevation_Hydrology_Ratio\n# Feature description: Combines Elevation and Horizontal_Distance_To_Hydrology to capture proximity to water features at different altitudes.\n# Usefulness: Representing the relationship between altitude and distance to hydrological features provides valuable insights into ecosystem dynamics.\ndf['Elevation_Hydrology_Ratio'] = df['Elevation'] / (df['Horizontal_Distance_To_Hydrology'] + 1)", "# Hillshade_Combined_Sum\n# Feature description: Aggregate feature combining Hillshade indices at different times of the day (9am, Noon, 3pm).\n# Usefulness: Summarizes sunlight exposure across different times of the day into a single measure of cumulative hillshade effects.\ndf['Hillshade_Combined_Sum'] = df['Hillshade_9am'] + df['Hillshade_Noon'] + df['Hillshade_3pm']", "# Elevation_Aspect_Slope_Interaction\n# Feature description: Interaction among Elevation, Aspect, and Slope features to model topography influence on forest cover.\n# Usefulness: Combining elevation, terrain orientation, and slope helps in understanding complex relationships linked to forest type variations.\ndf['Elevation_Aspect_Slope_Interaction'] = df['Elevation_Normalized'] * np.cos(np.radians(df['Aspect'])) * df['Slope_Normalized']", "# Wilderness_Encoded_Interaction\n# Feature description: Encodes interaction between Wilderness_Area_Encoded and Elevation_Binned for capturing regional elevation patterns in wilderness zones.\n# Usefulness: Reflects how elevation patterns interact with specific wilderness areas, aiding forest type prediction.\ndf['Wilderness_Encoded_Interaction'] = df['Wilderness_Area_Encoded'].astype(str) + '_' + df['Elevation_Binned'].astype(str)", "# Soil_Type_Diversity_Score\n# Feature description: Calculates the number of unique soil-type indicators active in a given sample.\n# Usefulness: Highlights diversity in soil types for assessing vegetation adaptability.\ndf['Soil_Type_Diversity_Score'] = df.filter(like='Soil_Type').sum(axis=1)", "# Road_Fire_Hydrology_Ratio\n# Feature description: Represents relative distances between roads, fire point proximity, and hydrology.\n# Usefulness: Captures multidimensional proximity influences critical to forest cover dynamics.\ndf['Road_Fire_Hydrology_Ratio'] = df['Horizontal_Distance_To_Roadways'] / (df['Horizontal_Distance_To_Fire_Points'] + df['Horizontal_Distance_To_Hydrology'] + 1)", "# Dropping duplicate columns created during transformations such as Log_Road_Distance or Log_Fire_Distance duplications.\ndf.drop(columns=['Road_Distance_Log', 'Log_Fire_Distance'], inplace=True)"]
