# Normalized_Amenities_Proximity
# Feature description: Combines distances to hydrology, roadways, and fire points normalized by elevation. Represents overall accessibility relative to terrain height.
# Usefulness: Accounts for elevation's influence on proximity to amenities, which impacts vegetation and forest cover.
df['Normalized_Amenities_Proximity'] = (df['Horizontal_Distance_To_Hydrology'] + df['Horizontal_Distance_To_Roadways'] + df['Horizontal_Distance_To_Fire_Points']) / df['Elevation']
end

python
# Hydrology_Accessibility
# Feature description: Adjusts hydrology distances using slope to indicate realistic water accessibility. 
# Usefulness: Incorporates slope into hydrology distance calculation, as steeper areas typically make water harder to access.
df['Hydrology_Accessibility'] = (df['Horizontal_Distance_To_Hydrology']2 + df['Vertical_Distance_To_Hydrology']2)0.5 * (1 + df['Slope'] / 100)
end

python
# Wilderness_Soil_Interaction
# Feature description: Captures interactions between specific wilderness areas and presence of soil types.
# Usefulness: Models interactions, given soil type importance for vegetation in different wilderness ecosystems.
df['Wilderness_Soil_Interaction'] = df['Wilderness_Area1'] * df['Soil_Type29']
end

python
# Aspect_Hillshade_9am
# Feature description: Interaction between terrain orientation (Aspect) and morning sunlight (Hillshade_9am).
# Usefulness: Reflects the impact of terrain's orientation on morning light availability, influencing vegetation health.
df['Aspect_Hillshade_9am'] = df['Aspect_Cos'] * df['Hillshade_9am']
end

python
# Log_Road_Distance
# Feature description: Log transformation of horizontal distance to roadways to reduce skewness in data.
# Usefulness: Helps manage extreme values and improves robustness in modeling.
df['Log_Road_Distance'] = np.log1p(df['Horizontal_Distance_To_Roadways'])
end

python
# Slope_Normalized
# Feature description: Min-max normalized version of slope feature.
# Usefulness: Ensures slope is in the same range as other features, promoting model convergence and handling different scale effects.
df['Slope_Normalized'] = (df['Slope'] - df['Slope'].min()) / (df['Slope'].max() - df['Slope'].min())
end

python
# Soil_Type_Grouped
# Feature description: Dimensionality reduction of sparse Soil_Type indicators using clustering or aggregation.
# Usefulness: Reduces sparsity of one-hot indicators, improving computational efficiency and capturing relationships between similar soil types.
from sklearn.cluster import KMeans
import numpy as np

soil_columns = [col for col in df.columns if 'Soil_Type' in col and col != 'Soil_Type_Mode']
soil_matrix = df[soil_columns].values
kmeans = KMeans(n_clusters=5, random_state=42).fit(soil_matrix)  # Cluster to 5 groups
df['Soil_Type_Grouped'] = kmeans.labels_
end

python
# Elevation_Band
# Feature description: Bins elevation into five bands (<2500, 2500-2800, 2800-3100, 3100-3400, >3400 meters).
# Usefulness: Captures non-linear relationship between elevation and vegetation, aligning with ecological zones.
df['Elevation_Band'] = pd.cut(df['Elevation'], bins=[2142, 2500, 2800, 3100, 3400, 3679], labels=['Low', 'Lower-Mid', 'Upper-Mid', 'High', 'Peak'])
end

python
# Dropping redundant distance columns
# Feature description: Drops Combined_Distance_To_Amenities and Distance_To_Amenities_Sum, as Normalized_Amenities_Proximity provides a scaled version.
df.drop(columns=['Combined_Distance_To_Amenities', 'Distance_To_Amenities_Sum'], inplace=True)
end

python
# Terrain category encoding
# Feature description: Encodes Slope_Steepness_Category to numerical values for easier modeling.
# Usefulness: Transforms categorical variable into numeric for machine learning.
terrain_mapping = {'Flat': 0, 'Moderate': 1, 'Steep': 2}
df['Terrain_Steepness_Encoded'] = df['Slope_Steepness_Category'].map(terrain_mapping)
end

python
# Light contrast index
# Feature description: Creates a gradient feature combining Hillshade_Noon and Hillshade_Gradient to capture light contrast on vegetation.
# Usefulness: Influences vegetation health via differences between light exposure across terrain features.
df['Light_Contrast_Index'] = df['Hillshade_Gradient'] + df['Hillshade_Noon'] / 255
end

