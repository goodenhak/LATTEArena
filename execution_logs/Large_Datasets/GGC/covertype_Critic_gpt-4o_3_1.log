# Sunlight_Aspect_Interaction
# Feature description: Combines Aspect_Cos and Aspect_Sin with hillshade features (Hillshade_9am, Hillshade_3pm) to model sunlight exposure based on terrain orientation.
# Usefulness: Captures the interaction between terrain orientation and sunlight exposure, which impacts vegetation and soil conditions.
df['Sunlight_Aspect_Interaction'] = (df['Aspect_Cos'] * df['Hillshade_9am']) + (df['Aspect_Sin'] * df['Hillshade_3pm'])
end

python
# Elevation_Vegetation_Ratio
# Feature description: Combines Elevation with Vegetation_Zones using label encoding to capture height-specific ecological trends.
# Usefulness: Models ecological differentiation trends based on elevation, supporting predictions of forest type influenced by elevation zones.
df['Elevation_Vegetation_Ratio'] = df['Elevation'] / (df['Vegetation_Zones'].map({'Lowland': 1, 'Montane': 2, 'Subalpine': 3, 'Alpine': 4}))
end

python
# Adjusted_Hydrology
# Feature description: Combines Vertical_Distance_To_Hydrology, Horizontal_Distance_To_Hydrology, and Slope to model hydrology accessibility based on terrain steepness.
# Usefulness: Reflects how terrain steepness and hydrology proximity impact vegetation and cover type distribution.
df['Adjusted_Hydrology'] = (df['Vertical_Distance_To_Hydrology'] / (df['Horizontal_Distance_To_Hydrology'] + 1)) * (1 + df['Slope'])
end

python
# Fire_Risk
# Feature description: Combines Horizontal_Distance_To_Fire_Points, Slope, and Vegetation_Zones to create a risk index for wildfire susceptibility.
# Usefulness: Forest cover types differ in their susceptibility to wildfire; this captures interactions between slope, vegetation zones, and fire point proximity.
df['Fire_Risk'] = df['Horizontal_Distance_To_Fire_Points'] / (df['Slope'] * df['Vegetation_Zones'].map({'Lowland': 1, 'Montane': 2, 'Subalpine': 3, 'Alpine': 4}))
end

python
# Log_Fire_Distance
# Feature description: Log transformation of Horizontal_Distance_To_Fire_Points to reduce skewness in distribution of distance-related features.
# Usefulness: Rescales highly skewed numerical features, improving prediction performance and algorithm stability.
df['Log_Fire_Distance'] = np.log(df['Horizontal_Distance_To_Fire_Points'] + 1)  # Adding 1 to avoid log(0)
end

python
# Log_Road_Distance
# Feature description: Log transformation of Horizontal_Distance_To_Roadways to reduce skewness in distribution of distance-related features.
# Usefulness: Encodes a more normalized representation of road proximity, aiding models sensitive to feature distributions.
df['Log_Road_Distance'] = np.log(df['Horizontal_Distance_To_Roadways'] + 1)
end

python
# Amenities_Proximity
# Feature description: Ratio-based feature combining horizontal distances to hydrology, fire points, and roadways.
# Usefulness: Highlights the relative importance of proximity to various features in shaping forest cover type.
df['Amenities_Proximity'] = df['Horizontal_Distance_To_Hydrology'] / (df['Horizontal_Distance_To_Fire_Points'] + df['Horizontal_Distance_To_Roadways'] + 1)
end

python
# Slope_Binned
# Feature description: Binning Slope into categorical ranges (Flat <10°, Moderate 10-30°, Steep ≥30°).
# Usefulness: Captures non-linear relationships between terrain steepness and forest cover type while simplifying data complexity.
df['Slope_Binned'] = pd.cut(df['Slope'], bins=[0, 10, 30, 66], labels=['Flat', 'Moderate', 'Steep'], include_lowest=True)
end

python
# Hillshade_Ratio
# Feature description: Ratio of morning Hillshade (Hillshade_9am) to afternoon Hillshade (Hillshade_3pm).
# Usefulness: Models the overall gradient in sunlight exposure over the terrain throughout a day, key for forest type differentiation.
df['Hillshade_Ratio'] = df['Hillshade_9am'] / (df['Hillshade_3pm'] + 1)
end

python
# Wilderness_Encoded
# Feature description: Combines Wilderness_Area1 through Wilderness_Area4 into a single categorical feature using label encoding.
# Usefulness: Reduces dimensionality of sparse wilderness indicators while preserving semantic structure of wilderness classifications.
df['Wilderness_Encoded'] = df[['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3', 'Wilderness_Area4']].idxmax(axis=1)
df['Wilderness_Encoded'] = df['Wilderness_Encoded'].str.extract('Wilderness_Area(\d)').astype(int)
end

