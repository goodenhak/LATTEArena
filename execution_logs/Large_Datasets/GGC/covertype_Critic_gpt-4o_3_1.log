# Vegetation_Density_Score
# Feature description: Numerical feature combining elevation, slope, and proximity to water sources to estimate vegetation density.
# Usefulness: Captures the relationship between elevation, slope, and water access in influencing vegetation density, which is critical for determining forest cover types.
df['Vegetation_Density_Score'] = df['Elevation_Normalized'] * (1 / (df['Horizontal_Distance_To_Hydrology'] + 1)) * df['Slope']
end

python
# Sunlight_Terrain_Interaction
# Feature description: Numerical feature quantifying the interaction between sunlight exposure and terrain orientation.
# Usefulness: Models how sunlight intensity interacts with terrain slopes and shading, influencing vegetation growth patterns and supporting forest cover predictions.
df['Sunlight_Terrain_Interaction'] = df['Sunlight_Adjusted_Aspect'] * df['Hillshade_Gradient']
end

python
# Log_Accessibility
# Feature description: Log transformation of Distance_To_Amenities_Sum to reduce data skewness and improve linear interpretability.
# Usefulness: Accessibility features are often skewed due to extreme distances; log transformation improves modeling performance.
df['Log_Accessibility'] = np.log(df['Distance_To_Amenities_Sum'] + 1)
end

python
# Elevation_Binned
# Feature description: Categorical indicator for elevation zones (Low, Medium, High).
# Usefulness: Provides non-linear grouping of elevation data, capturing crucial changes in vegetation and forest types across elevation levels.
df['Elevation_Binned'] = pd.cut(df['Elevation_Normalized'], bins=[0, 0.5, 0.75, 1], labels=['Low', 'Medium', 'High'], include_lowest=True)
end

python
# Slope_Binned
# Feature description: Categorical indicator for slope categories (Flat, Moderate, Steep).
# Usefulness: Simplifies slope data by grouping into meaningful categories, aiding in terrain differentiation for forest cover predictions.
df['Slope_Binned'] = pd.cut(df['Slope_Normalized'], bins=[-np.inf, -0.5, 0.5, np.inf], labels=['Flat', 'Moderate', 'Steep'])
end

python
# Combined_Sunlight_Density_Interaction
# Feature description: Interaction of Vegetation_Density_Score and Sunlight_Terrain_Interaction into a unified feature.
# Usefulness: Models combined effects of terrain, water proximity, slope, sunlight exposure, and shading intensity for predicting forest cover types.
df['Combined_Sunlight_Density_Interaction'] = df['Vegetation_Density_Score'] * df['Sunlight_Terrain_Interaction']
end

python
# Soil_Type_HighInteraction
# Feature description: Identifies samples with high interaction between key soil type indicators (e.g., Soil_Type_Mode, Soil_Type_Grouped).
# Usefulness: Combine most frequent soil types across categorical features to enhance soil-specific predictive power.
df['Soil_Type_HighInteraction'] = (df['Soil_Type_Mode'] == df['Soil_Type_Grouped']).astype(int)
end

python
# Terrain_Accessibility_Bin
# Feature description: Categorical grouping of Steepness_Adjusted_Accessibility based on thresholds (Low, Medium, High).
# Usefulness: Simplifies accessibility metrics influenced by terrain steepness into nonlinear actionable categories.
df['Terrain_Accessibility_Bin'] = pd.cut(df['Steepness_Adjusted_Accessibility'], bins=[0, 20000, 50000, np.inf], labels=['Low', 'Medium', 'High'])
end

python
# Dropping redundant features
# Reason: Removing features that are not likely to contribute additional predictive power or are overly redundant.
df.drop(columns=['Road_Distance_Log', 'Log_Fire_Distance', 'Combined_Distance_To_Amenities'], inplace=True)
end

python
# Target Encoding for Categorical Features
# Feature description: Transform Soil_Type_Grouped and Wilderness_Area_Encoded features into target-encoded numerical features based on correlations with target variable.
# Usefulness: Encodes categorical columns while preserving their relationship with the prediction task, reducing dimensionality and improving model robustness.
soil_type_mapping = df.groupby('Soil_Type_Grouped')['target'].mean()
df['Soil_Type_Target_Enc'] = df['Soil_Type_Grouped'].map(soil_type_mapping)

wilderness_area_mapping = df.groupby('Wilderness_Area_Encoded')['target'].mean()
df['Wilderness_Area_Target_Enc'] = df['Wilderness_Area_Encoded'].map(wilderness_area_mapping)
end
