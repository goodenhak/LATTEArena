# Aspect_Light_Interaction
# Feature description: Combines terrain orientation (Aspect_Cos) with direct sunlight exposure at morning (Hillshade_9am) and afternoon (Hillshade_3pm).
# Usefulness: Captures how terrain orientation affects light exposure, crucial for vegetation growth.
df['Aspect_Light_Interaction'] = (df['Aspect_Cos'] * df['Hillshade_9am']) + (df['Aspect_Cos'] * df['Hillshade_3pm'])
end

python
# Adjusted_Elevation
# Feature description: Combines Elevation with Slope to account for terrain steepness and its effect on vegetation density.
# Usefulness: Determines realistic elevation for vegetation growth considering soil erosion and slope.
df['Adjusted_Elevation'] = df['Elevation'] * (1 - (df['Slope'] / 100))
end

python
# Hydrology_Fire_Ratio
# Feature description: Computes the ratio between Horizontal_Distance_To_Hydrology and Horizontal_Distance_To_Fire_Points.
# Usefulness: Understands relative proximity and its correlation with vegetation density or forest cover adaptation.
df['Hydrology_Fire_Ratio'] = df['Horizontal_Distance_To_Hydrology'] / (df['Horizontal_Distance_To_Fire_Points'] + 1)  # Prevent division by zero
end

python
# Wilderness_Soil_Interaction
# Feature description: Combines wilderness area indicators with soil type indicators to model ecosystem-specific vegetation dependency.
# Usefulness: Captures localized relationships between soil and wilderness for better forest cover classification.
df['Wilderness_Soil_Interaction'] = df['Wilderness_Area1'] * df['Soil_Type29']
end

python
# Log_Hydrology_Distance
# Feature description: Log-transformed version of Horizontal_Distance_To_Hydrology to handle skewed distances.
# Usefulness: Reduces skewness in distance-related features and aids in better predictive modeling.
df['Log_Hydrology_Distance'] = np.log1p(df['Horizontal_Distance_To_Hydrology'])  # log1p avoids issues with zero inputs
end

python
# Slope_ZScore
# Feature description: Z-score normalization of Slope to standardize across the dataset.
# Usefulness: Assists in fair comparison of slope variations across different samples.
df['Slope_ZScore'] = (df['Slope'] - df['Slope'].mean()) / df['Slope'].std()
end

python
# Elevation_Bin
# Feature description: Categorizes Elevation into vegetation zones using predefined thresholds.
# Usefulness: Clearly separates elevation ranges that influence vegetation cover types.
elevation_bins = [2142, 2800, 3000, 3200, 3679]
elevation_labels = ['Low', 'Montane', 'Subalpine', 'Alpine']
df['Elevation_Bin'] = pd.cut(df['Elevation'], bins=elevation_bins, labels=elevation_labels)
end

