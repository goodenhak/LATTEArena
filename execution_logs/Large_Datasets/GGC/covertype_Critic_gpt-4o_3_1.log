# Elevation_Vegetation_Interaction
# Feature description: Captures interaction between elevation and vegetation zones to quantify elevation's influence on vegetation.
# Usefulness: Helps model the ecological relationship between elevation levels and vegetation types, relevant for predicting forest cover.
df['Elevation_Vegetation_Interaction'] = df['Elevation_Normalized'] * df['Vegetation_Zones'].apply(lambda x: {'Subalpine': 1, 'Montane': 2, 'Alpine': 3, 'Lowland': 4}[x])
end

python
# Sunlight_Adjusted_Aspect
# Feature description: Combines midday sunlight exposure with terrain orientation to model direction-dependent sunlight intensity.
# Usefulness: Provides insight into how terrain orientation and sunlight exposure affect ecological conditions.
df['Sunlight_Adjusted_Aspect'] = df['Hillshade_Noon'] * df['Aspect_Cos']
end

python
# Steepness_Adjusted_Accessibility
# Feature description: Interaction between slope and proximity measures to reflect accessibility modulated by steepness.
# Usefulness: Models the difficulty of reaching hydrological, road, or fire points based on slope.
df['Steepness_Adjusted_Accessibility'] = (df['Slope'] + 1) * (df['Horizontal_Distance_To_Roadways'] + df['Horizontal_Distance_To_Hydrology'])
end

python
# Log_Amenities
# Feature description: Log transformation of Distance_To_Amenities_Sum to reduce skewness and highlight relative proximity.
# Usefulness: Transformation helps capture diminishing returns in proximity effects for amenities.
df['Log_Amenities'] = np.log(df['Distance_To_Amenities_Sum'] + 1)
end

python
# Slope_Normalized
# Feature description: Z-score normalization of Slope to standardize its distribution.
# Usefulness: Normalization helps ensure that steepness differences are uniformly scaled across the dataset.
df['Slope_Normalized'] = (df['Slope'] - df['Slope'].mean()) / df['Slope'].std()
end

python
# Elevation_Binned
# Feature description: Binning of elevation into categorical zones based on thresholds.
# Usefulness: Groups elevation into Low, Medium, High zones to capture forest cover type alignment with elevation levels.
df['Elevation_Binned'] = pd.cut(df['Elevation'], bins=[2142, 2898, 3178, 3679], labels=['Low', 'Medium', 'High'])
end

python
# Road_Fire_Ratio
# Feature description: Ratio between roadway distance and fire point distance to measure relative accessibility.
