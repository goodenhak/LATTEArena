# Elevation_Normalized
# Feature description: The min-max normalized version of the Elevation feature to scale to the same range as others.
# Usefulness: Normalizing Elevation allows algorithms sensitive to feature scale to work better and ensures comparability of Elevation with other features.
df['Elevation_Normalized'] = (df['Elevation'] - df['Elevation'].min()) / (df['Elevation'].max() - df['Elevation'].min())
end

python
# Aspect_Sin and Aspect_Cos
# Feature description: Sine and Cosine transformations of the Aspect feature.
# Usefulness: Aspect is circular (0° and 360° are the same direction), so transforming it using sine and cosine ensures that its continuity is properly represented.
df['Aspect_Sin'] = np.sin(np.radians(df['Aspect']))
df['Aspect_Cos'] = np.cos(np.radians(df['Aspect']))
end

python
# Hydrology_Euclidean_Distance
# Feature description: Euclidean distance to the nearest surface water feature, combining horizontal and vertical distances.
# Usefulness: Captures comprehensive distance effects of hydrology proximity using Pythagoras theorem.
df['Hydrology_Euclidean_Distance'] = np.sqrt(df['Horizontal_Distance_To_Hydrology']2 + df['Vertical_Distance_To_Hydrology']2)
end

python
# Road_Distance_Log
# Feature description: Log transformation of the horizontal distance to roadways.
# Usefulness: Accounts for diminishing returns of increasing distance to roadways with respect to forest cover type impact.
df['Road_Distance_Log'] = np.log1p(df['Horizontal_Distance_To_Roadways'])
end

python
# Fire_Distance_Log
# Feature description: Log transformation of the horizontal distance to closest fire points.
# Usefulness: Similar to 'Road_Distance_Log,' this transformation stabilizes variance and better models the impact of extreme values.
df['Fire_Distance_Log'] = np.log1p(df['Horizontal_Distance_To_Fire_Points'])
end

python
# Slope_Steepness_Category
# Feature description: Binning the Slope feature into three categories: Flat (<10°), Moderate (10-30°), and Steep (≥30°).
# Usefulness: Slope can heavily influence soil erosion and vegetation, so discretizing it into categories may improve interpretability or downstream model performance.
df['Slope_Steepness_Category'] = pd.cut(df['Slope'], bins=[-1, 10, 30, 90], labels=['Flat', 'Moderate', 'Steep'])
end

python
# Hillshade_Gradient
# Feature description: Difference between morning hillshade and afternoon hillshade.
# Usefulness: Captures the overall slope-facing bias that might affect vegetation patterns.
df['Hillshade_Gradient'] = df['Hillshade_9am'] - df['Hillshade_3pm']
end

python
# Soil_Type_Sum
# Feature description: Sum of all soil type indicators in a given sample.
# Usefulness: Some regions may exhibit characteristic vegetation due to diverse or sparse soil type codes, and the sum can represent soil richness.
df['Soil_Type_Sum'] = df.filter(like='Soil_Type').sum(axis=1)
end

python
# Soil_Type_Mode
# Feature description: The soil type indicator with the highest frequency across all soil types for a given sample.
# Usefulness: Helps capture prominent dominant soil type in cases where soil diversity influences cover type.
df['Soil_Type_Mode'] = df.filter(like='Soil_Type').idxmax(axis=1)
end

python
# Distance_To_Amenities_Sum
# Feature description: Aggregated distances to hydrology, roadways, and fire points.
# Usefulness: Captures the combined effect of all critical distances for modeling forest interaction with the environment.
df['Distance_To_Amenities_Sum'] = df['Horizontal_Distance_To_Hydrology'] \
                                    + df['Horizontal_Distance_To_Roadways'] \
                                    + df['Horizontal_Distance_To_Fire_Points']
end

python
# Vegetation_Zones
# Feature description: Derived from Elevation by binning into vegetation classification zones based on elevation thresholds.
# Usefulness: Helps interpret forest patterns affected by specific vegetation zones, often determined by elevation criteria.
df['Vegetation_Zones'] = pd.cut(df['Elevation'], bins=[2000, 2500, 3000, 3500, 4000], labels=['Lowland', 'Montane', 'Subalpine', 'Alpine'])
end

python
# Hydrology_Road_Ratio
# Feature description: Ratio of Horizontal_Distance_To_Hydrology to Horizontal_Distance_To_Roadways.
# Usefulness: Indicates the relative proximity of a cell to hydrology versus road infrastructure, which can impact forestry cover.
df['Hydrology_Road_Ratio'] = df['Horizontal_Distance_To_Hydrology'] / (df['Horizontal_Distance_To_Roadways'] + 1e-6)
end

python
# Drop non-informative columns (example: Soil_Type1, where all samples are zero)
# Feature description: Removing redundant features that provide no variance.
# Usefulness: Improves computational efficiency and prevents overfitting on meaningless features.
df.drop(columns=['Soil_Type1', 'Soil_Type5', 'Soil_Type14', 'Soil_Type15', 'Soil_Type37'], inplace=True)
end
