# Elevation_Bin
# Discretizes elevation into categories: low, medium, high based on quantiles.
# Usefulness: Adds geographical context related to vegetation zones influenced by altitude differences.
df['Elevation_Bin'] = pd.qcut(df['Elevation'], q=3, labels=['Low', 'Medium', 'High'])

# Ruggedness_Index
# Combines 'Slope' and 'Elevation_zscore' to create a rugged terrain indicator.
# Usefulness: Highlights areas with steep slopes and significant elevation variation, potentially linked to vegetation patterns.
df['Ruggedness_Index'] = df['Slope'] * df['Elevation_zscore']

# Hydrology_Proximity
# Calculates Euclidean distance combining Horizontal_Distance_To_Hydrology and Vertical_Distance_To_Hydrology.
# Usefulness: Captures overall accessibility to water, influencing vegetation growth.
df['Hydrology_Proximity'] = np.sqrt(df['Horizontal_Distance_To_Hydrology']  2 + df['Vertical_Distance_To_Hydrology']  2)

# Hillshade_South
# Represents sunlight exposure for south-facing areas using Hillshade_3pm and Aspect.
# Usefulness: South-facing areas receive more sunlight in the northern hemisphere, important for vegetation types.
df['Hillshade_South'] = df['Hillshade_3pm'] * (df['Aspect_range_bin'] == 'South')

# Human_Impact
# Weighted score of Human activities from Horizontal_Distance_To_Roadways and Horizontal_Distance_To_Fire_Points.
# Usefulness: Identifies cell areas under potential influence of human-induced factors like deforestation or accessibility.
df['Human_Impact'] = 0.8 * df['Horizontal_Distance_To_Roadways'] + 0.2 * df['Horizontal_Distance_To_Fire_Points']

# Log_Horizontal_Distance_To_Hydrology
# Log transformation of 'Horizontal_Distance_To_Hydrology' to address outliers.
# Usefulness: Reduces skewness of data while maintaining significant relationships.
df['Log_Horizontal_Distance_To_Hydrology'] = np.log1p(df['Horizontal_Distance_To_Hydrology'])

# Elevation_zscore
# Standardizes the 'Elevation' feature relative to its mean and standard deviation.
# Usefulness: Places elevation on a comparable scale, improving numeric feature compatibility in modeling.
df['Elevation_zscore'] = (df['Elevation'] - df['Elevation'].mean()) / df['Elevation'].std()

# Road_Proximity_Bin
# Categorizes horizontal distances to roads into bins: close, moderate, far based on quantiles.
# Usefulness: Adds interpretability to infrastructure proximity, which can influence human impact on forest cover types.
df['Road_Proximity_Bin'] = pd.cut(df['Horizontal_Distance_To_Roadways'], bins=[0, df['Horizontal_Distance_To_Roadways'].quantile(0.33), df['Horizontal_Distance_To_Roadways'].quantile(0.66), df['Horizontal_Distance_To_Roadways'].max()], labels=['Close', 'Moderate', 'Far'])

# Slope_Normalized
# Normalizes the 'Slope' feature using Min-Max scaling.
# Usefulness: Puts the feature on a [0, 1] scale for comparison with other features.
df['Slope_Normalized'] = (df['Slope'] - df['Slope'].min()) / (df['Slope'].max() - df['Slope'].min())

# Hillshade_Weighted
# Weighted sum of Hillshade indices at 9am, noon, and 3pm using cosine weights derived from solar arcs.
# Usefulness: Captures realistic sunlight levels across the day for a given location.
weights = [0.5, 0.3, 0.2]  # Example weights for 9am, noon, 3pm
df['Hillshade_Weighted'] = df['Hillshade_9am'] * weights[0] + df['Hillshade_Noon'] * weights[1] + df['Hillshade_3pm'] * weights[2]
end

