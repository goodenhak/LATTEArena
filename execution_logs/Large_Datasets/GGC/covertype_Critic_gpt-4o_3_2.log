# Feature Engineering: Combine Terrain and Sunlight
df['Slope_Hillshade_Ratio'] = df['Slope'] / (df['Average_hillshade'] + 1e-8)
# Description: Combines slope steepness with average sunlight exposure.
# Usefulness: Helps identify areas with steep slopes and lower sunlight where specific forest cover types might thrive.

# Feature Engineering: Relative Position to Water
df['Hydrology_Relative_Scale'] = df['Hydrology_plus_elevation'] / (df['Total_horizontal_distance_features'] + 1e-8)
# Description: Computes the relative scaling of elevation-water proximity over total horizontal proximity.
# Usefulness: Ideal for reflecting the interplay between elevation and water proximity, which affects vegetation thrive zones.

# Feature Engineering: Soil Type Grouping
similar_soil_groups = {
    'Alluvial_Group': ['Soil_Type22', 'Soil_Type23', 'Soil_Type29', 'Soil_Type30'],
    'Rocky_Group': ['Soil_Type12', 'Soil_Type20', 'Soil_Type39', 'Soil_Type40']
}
for group_name, columns in similar_soil_groups.items():
    df[group_name] = df[columns].sum(axis=1)
# Description: Condenses highly sparse soil binary columns into meaningful groups.
# Usefulness: Simplifies soil indicators into clustered groups, boosting predictive power with fewer features.

# Feature Engineering: Road-Fire Influence
df['Human_Influence'] = df['Road_to_fire_ratio'] * df['Hillshade_and_Slope_Interaction']
# Description: Interaction feature measuring the impact of road proximity and fire proximity on land use.
# Usefulness: Highlights areas likely impacted by human activities, potentially reflecting on forest degradation or planting redesign.

# Feature Engineering: Log Transform Interaction Features
df['Log_Hydrology_Elevation_Interaction'] = np.log1p(df['Hydrology_and_Elevation_Interaction'])
# Description: Log transformation of Hydrology and Elevation interaction.
# Usefulness: Addresses skewness and helps normalize the range of values, making it better suitable for machine learning workflows.

# Feature Engineering: Normalize Total Horizontal Distance
scaler = MinMaxScaler()
df['Normalized_Total_Distance'] = scaler.fit_transform(df[['Total_horizontal_distance_features']])
# Description: Normalizes total proximity distances using Min-Max scaling.
# Usefulness: Keeps proximity features consistent and scale-agnostic for easier interpretation by models.

# Feature Engineering: Bin Hydrology Distance Ratio
def bin_hydrology_ratio(value):
    if value < 5:
        return 'low'
    elif value < 10:
        return 'medium'
    else:
        return 'high'

df['Hydrology_Ratio_Bin'] = df['Hydrology_distance_ratio'].apply(bin_hydrology_ratio)
# Description: Bins Hydrology Distance Ratio into categories.
# Usefulness: Simplifies complex continuous distance values into directional categorical ranges for clearer trends.

# Feature Engineering: Quadrant Encoding for Aspect
one_hot_aspect = pd.get_dummies(df['Aspect_range_bin'], prefix='Aspect')
df = pd.concat([df, one_hot_aspect], axis=1)
# Description: Transforms Aspect directionality into one-hot encoded quadrants.
# Usefulness: Captures categorical terrain directionality, removing unnecessary model bias and retaining interpretability.
end

