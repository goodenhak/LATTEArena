# Feature name: Relative_Elevation_Hydrology_Interaction
# Feature description: Combines Relative_Elevation and Log_Hydrology_Distance_Ratio to capture how elevation interacts with hydrology proximity in influencing terrain conditions.
# Usefulness: Highlights critical terrain and water interaction, which directly impacts the vegetation and forest cover type.

df['Relative_Elevation_Hydrology_Interaction'] = df['Relative_Elevation'] * df['Log_Hydrology_Distance_Ratio']
end

python
# Feature name: Proximity_Density
# Feature description: Represents the density of proximity to key terrain features relative to the number of soil types present.
# Usefulness: Combines spatial proximity with soil variation, providing a more quantitative measure of terrain composition affecting forest cover.

df['Proximity_Density'] = df['Total_horizontal_distance_features'] / (df['Total_Soil_Type_Sum'] + 1e-9)  # Adding a small value to handle division by zero
end

python
# Feature name: Aspect_Hillshade_Interaction
# Feature description: Combines Aspect_cos and Average_hillshade to model the interaction between directional light exposure and terrain orientation.
# Usefulness: Captures the interplay between sunlight exposure and aspect direction, both critical for understanding vegetation growth.

df['Aspect_Hillshade_Interaction'] = df['Aspect_cos'] * df['Average_hillshade']
end

python
# Feature name: Elevation_STD_Scaled
# Feature description: Standardizes the Elevation feature for scaling across the dataset.
# Usefulness: Standardizing allows the model to better interpret changes relative to average elevation without being affected by magnitude.

df['Elevation_STD_Scaled'] = (df['Elevation'] - df['Elevation'].mean()) / df['Elevation'].std()
end

python
# Feature name: Log_Total_Proximity
# Feature description: Applies log transformation to Total_Proximity to address skewness and stabilize variance.
# Usefulness: Decreases the influence of extreme values in proximity measurements, improving model robustness.

df['Log_Total_Proximity'] = np.log1p(df['Total_Proximity'])
end

python
# Feature name: Normalized_Human_Influence
# Feature description: Applies Min-Max normalization to Human_Influence for consistent scaling of human impact.
# Usefulness: Simplifies the range and relative scale of human influence, allowing models to equally weight these distances across samples.

df['Normalized_Human_Influence'] = (df['Human_Influence'] - df['Human_Influence'].min()) / (df['Human_Influence'].max() - df['Human_Influence'].min())
end

python
# Feature name: Proximity_Outlier_Flag
# Feature description: Flags samples where Total_Proximity lies outside 3 standard deviations from the mean as outliers.
# Usefulness: Identifies outlier samples that might introduce bias into the model, enabling better handling or exclusion of extreme values.

df['Proximity_Outlier_Flag'] = np.where((df['Total_Proximity'] - df['Total_Proximity'].mean()) > 3 * df['Total_Proximity'].std(), 1, 0)
end

python
# Feature name: Elevation_Bin_Flag
