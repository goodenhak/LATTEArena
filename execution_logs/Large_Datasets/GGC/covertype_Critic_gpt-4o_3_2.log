2026-05-17 05:55:03,981 - INFO - ops_string = ["# Elevation_range_bin\n# Binned representation of elevation into categories (low, medium, high) to capture relative elevation levels.\n# Usefulness: Helps models learn better patterns for elevation effect, as forest cover type might depend on elevation zones.\ndf['Elevation_range_bin'] = pd.cut(df['Elevation'], bins=[2142, 2898, 3179, 3686], labels=['low', 'medium', 'high'])", "# Aspect_sin_cos\n# Generates sin and cos features for the Aspect to account for circular nature of the azimuth degree.\n# Usefulness: This transformation ensures proper handling of cyclical data where 0 degrees is equivalent to 360 degrees in direction.\ndf['Aspect_sin'] = np.sin(np.radians(df['Aspect']))\ndf['Aspect_cos'] = np.cos(np.radians(df['Aspect']))", "# Hydrology_distance_ratio\n# Ratio of Horizontal_Distance_To_Hydrology and Vertical_Distance_To_Hydrology.\n# Usefulness: Indicates relative location of the point regarding water features and slope adjustment (directionality and steepness).\ndf['Hydrology_distance_ratio'] = df['Horizontal_Distance_To_Hydrology'] / (df['Vertical_Distance_To_Hydrology'] + 1)", "# Road_to_fire_ratio\n# Ratio of Horizontal_Distance_To_Roadways to Horizontal_Distance_To_Fire_Points.\n# Usefulness: Highlights proximity to human settlements vs wildfire-prone areas, which can affect cover type.\ndf['Road_to_fire_ratio'] = df['Horizontal_Distance_To_Roadways'] / (df['Horizontal_Distance_To_Fire_Points'] + 1)", "# Average_hillshade\n# Average of Hillshade indices at 9am, noon, and 3pm.\n# Usefulness: Creates an aggregated representation of hillshade to better represent overall terrain sunlight exposure.\ndf['Average_hillshade'] = df[['Hillshade_9am', 'Hillshade_Noon', 'Hillshade_3pm']].mean(axis=1)", "# Hydrology_plus_elevation\n# Combined feature of elevation and horizontal distance to hydrology.\n# Usefulness: High elevation may interact with proximity to water for vegetation and soil quality patterns linking to cover type.\ndf['Hydrology_plus_elevation'] = df['Elevation'] + df['Horizontal_Distance_To_Hydrology']", "# Total_horizontal_distance_features\n# Sum of Horizontal_Distance_To_Hydrology, Horizontal_Distance_To_Roadways, and Horizontal_Distance_To_Fire_Points.\n# Usefulness: Captures cumulative effect of distances/proximity to water, roadways, and wildfire points on forest type.\ndf['Total_horizontal_distance_features'] = df[['Horizontal_Distance_To_Hydrology', 'Horizontal_Distance_To_Roadways', 'Horizontal_Distance_To_Fire_Points']].sum(axis=1)", "# Elevation_zscore\n# Z-scored elevation value relative to its mean and standard deviation.\n# Usefulness: Normalizes elevation for scaling, could improve model behavior in presence of different feature ranges.\ndf['Elevation_zscore'] = (df['Elevation'] - df['Elevation'].mean()) / df['Elevation'].std()", "# Soil_Type_sum\n# Sums up all the binary soil type columns to get a consolidated count of soil types present.\n# Usefulness: Indicates the diversity of soil types in a cell, could correlate with vegetation and cover types.\ndf['Soil_Type_sum'] = df[[col for col in df.columns if 'Soil_Type' in col]].sum(axis=1)", "# Wilderness_Areas_sum\n# Sum of all wilderness area indicators.\n# Usefulness: Represents if the cell is present in multiple wilderness areas, aiding in identifying remote or protected regions.\ndf['Wilderness_Areas_sum'] = df[['Wilderness_Area1', 'Wilderness_Area2', 'Wilderness_Area3', 'Wilderness_Area4']].sum(axis=1)", "# Drop Soil_Type1, Soil_Type5, Soil_Type14, Soil_Type37\n# Drop soil type columns entirely filled with zeros (no variation).\ndf.drop(columns=['Soil_Type1', 'Soil_Type5', 'Soil_Type14', 'Soil_Type37'], inplace=True)", "# Water_proximity_bin\n# Creates binned categories for horizontal distance to hydrology (near, medium, far).\n# Usefulness: Proximity to water bodies likely affects forest cover types.\ndf['Water_proximity_bin'] = pd.cut(df['Horizontal_Distance_To_Hydrology'], bins=[0, 108, 391, 1383], labels=['near', 'medium', 'far'])", "# Road_proximity_bin\n# Creates binned categories for horizontal distance to roadways (close, moderate, far).\n# Usefulness: Proximity to human activity may impact the type of forest cover present.\ndf['Road_proximity_bin'] = pd.cut(df['Horizontal_Distance_To_Roadways'], bins=[0, 1259, 3538, 7117], labels=['close', 'moderate', 'far'])", "# Steep_slope_indicator\n# Binary indicator whether slope exceeds 20 degrees (1 if steep, 0 if not).\n# Usefulness: Extreme steep slopes affect vegetation and possibly forest cover distributions.\ndf['Steep_slope_indicator'] = (df['Slope'] > 20).astype(int)", "# Fire_proximity_bin\n# Creates binned categories for proximity to fire points (proximal, moderate, far).\n# Usefulness: Wildfire risks near the area are expected to relate to forest cover changes/types.\ndf['Fire_proximity_bin'] = pd.cut(df['Horizontal_Distance_To_Fire_Points'], bins=[0, 1140, 2646, 7172], labels=['proximal', 'moderate', 'far'])", "# Aspect_range_bin\n# Classifies the Aspect into quadrants indicating direction (North, East, South, West).\n# Usefulness: Simplifies directional information associated with slope orientation, which can influence vegetation type.\ndf['Aspect_range_bin'] = pd.cut(df['Aspect'], bins=[0, 90, 180, 270, 360], labels=['North', 'East', 'South', 'West'], right=False)"]
