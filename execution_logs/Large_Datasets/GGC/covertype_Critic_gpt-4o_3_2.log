### Feature Engineering
python
# Relative_Elevation_Hydrology_Interaction
# Feature: Product of Relative_Elevation * Hydrology_Relative_Scale
# Usefulness: This feature captures the combined influence of elevation and proximity to water sources on vegetation cover.
df['Relative_Elevation_Hydrology_Interaction'] = df['Relative_Elevation'] * df['Hydrology_Relative_Scale']
end

python
# Weighted_Total_Proximity
# Feature: Sum of log-transformed horizontal proximity features that considers skewness.
# Usefulness: Provides a stabilized representation of the combined proximity effect from roads, fire points, and hydrology.
df['Weighted_Total_Proximity'] = (df['Log_Horizontal_Distance_To_Roadways'] + 
                                  df['Log_Horizontal_Distance_To_Fire_Points'] + 
                                  df['Log_Horizontal_Distance_To_Hydrology'])
end

python
# Slope_Weighted_By_Aspect
# Feature: Product of Slope * Aspect_cos
# Usefulness: Captures the interaction between slope direction and sunlight, which impacts vegetation growth patterns based on exposure.
df['Slope_Weighted_By_Aspect'] = df['Slope'] * df['Aspect_cos']
end

---

### Normalization
python
# Normalized_Hydrology_plus_elevation
# Feature: Scaled representation of Hydrology_plus_elevation using MinMax normalization
# Usefulness: Standardizes Hydrology_plus_elevation for comparisons across the dataset and ensures features are in a similar range for machine learning models.
min_val = df['Hydrology_plus_elevation'].min()
max_val = df['Hydrology_plus_elevation'].max()
df['Normalized_Hydrology_plus_elevation'] = (df['Hydrology_plus_elevation'] - min_val) / (max_val - min_val)
end

python
# Log transformation for skewed features
# Feature: Log transformed Road_to_fire_ratio, Total_Proximity, and Human_Influence
# Usefulness: Reduces skewness and stabilizes variance in features that have extreme values or long tails.
df['Log_Road_to_fire_ratio'] = np.log1p(df['Road_to_fire_ratio'])
df['Log_Total_Proximity'] = np.log1p(df['Total_Proximity'])
df['Log_Human_Influence'] = np.log1p(df['Human_Influence'])
end

---

### Outlier Detection
python
# Proximity_Outlier_Flag
# Feature: Flag for extreme proximity values using 3 standard deviations from the mean
# Usefulness: Identifies samples with unusually high proximity values for special consideration by models.
threshold_proximity = df['Total_Proximity'].mean() + 3 * df['Total_Proximity'].std()
df['Proximity_Outlier_Flag'] = np.where(df['Total_Proximity'] > threshold_proximity, 1, 0)
end

python
# High_Hillshade_Variability_Flag
# Feature: Flag for high variability in hillshade values (Hillshade_std > 3 standard deviations above the mean)
# Usefulness: Flags instances where hillshade varies significantly, indicating unique light exposure.
threshold_hillshade_std = df['Hillshade_Std'].mean() + 3 * df['Hillshade_Std'].std()
df['High_Hillshade_Variability_Flag'] = np.where(df['Hillshade_Std'] > threshold_hillshade_std, 1, 0)
end

---

