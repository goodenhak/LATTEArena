['Hillshade_Std'].std()\ndf['Outlier_Hillshade_Flag'] = (df['Hillshade_Std'] > mean_hillshade_std + 3 * std_hillshade_std).astype(int)", "# Log_Road_to_fire_ratio\n# Address extreme skewness and large range by log transformation of Road_to_fire_ratio.\n# Usefulness: Stabilizes data variance for better model training and results.\ndf['Log_Road_to_fire_ratio'] = np.log1p(df['Road_to_fire_ratio'])", "# Normalized_Elevation_Global\n# Min-Max normalization across the dataset-wide Elevation values.\n# Usefulness: Standardizes elevation values globally to handle variability better across samples.\ndf['Normalized_Elevation_Global'] = (df['Elevation'] - df['Elevation'].min()) / (df['Elevation'].max() - df['Elevation'].min())", "# Slope_Category_Binned\n# Converts Slope into categorical bins: low (≤10), medium (10-20), steep (>20).\n# Usefulness: Simplifies slope variability and identifies areas with steep terrain (important for vegetation).\ndf['Slope_Category_Binned'] = pd.cut(df['Slope'], bins=[0, 10, 20, np.inf], labels=['low', 'medium', 'steep'])", "# Water_Proximity_Combined\n# Create a single feature combining water proximity categories: Water_near, Water_medium, Water_far\n# Usefulness: Improves model interpretability by reducing redundant water-related features.\ndf['Water_Proximity_Combined'] = np.select(\n    [df['Water_near'] == True, df['Water_medium'] == True, df['Water_far'] == True],\n    ['near', 'medium', 'far'], default='unknown'\n)", "# Slope_Hydrology_Effect\n# Interaction term between slope and hydrology distance ratio.\n# Usefulness: Captures how terrain steepness interacts with proximity to water sources, influencing vegetation.\ndf['Slope_Hydrology_Effect'] = df['Slope'] * df['Hydrology_Relative_Scale']", "# Proximity_Outlier_Flag\n# Detects proximity values (Total_Proximity) that are 3 standard deviations away from mean.\n# Usefulness: Flags potential outliers for careful handling in model training.\nmean_tot_proximity = df['Total_Proximity'].mean()\