tal_Proximity'])\ndf['Log_Human_Influence'] = np.log1p(df['Human_Influence'])", "# Proximity_Outlier_Flag\n# Feature: Flag for extreme proximity values using 3 standard deviations from the mean\n# Usefulness: Identifies samples with unusually high proximity values for special consideration by models.\nthreshold_proximity = df['Total_Proximity'].mean() + 3 * df['Total_Proximity'].std()\ndf['Proximity_Outlier_Flag'] = np.where(df['Total_Proximity'] > threshold_proximity, 1, 0)", "# High_Hillshade_Variability_Flag\n# Feature: Flag for high variability in hillshade values (Hillshade_std > 3 standard deviations above the mean)\n# Usefulness: Flags instances where hillshade varies significantly, indicating unique light exposure.\nthreshold_hillshade_std = df['Hillshade_Std'].mean() + 3 * df['Hillshade_Std'].std()\ndf['High_Hillshade_Variability_Flag'] = np.where(df['Hillshade_Std'] > threshold_hillshade_std, 1, 0)", "# Dropping Columns Unlikely to Contribute to Predictive Power\n# Reason: Removing highly correlated features, redundant/duplicative features, or features with high percentage of missing data.\ndf.drop(columns=['Log_Hydrology_Elevation_Interaction'], inplace=True)  # Dropped due to infinite values (NaNs)\ndf.drop(columns=['Elevation_Normalized_Global'], inplace=True)  # Dropped; duplicates Normalized_Elevation\ndf.drop(columns=['Total_horizontal_distance_features'], inplace=True)  # Dropped; duplicate of Total_Proximity\ndf.drop(columns=['Hillshade_3pm'], inplace=True)  # Similar to Average_hillshade, provides redundant temporal shade data", "# Multiple Soil Type Indicators to be dropped for simplicity and feature interaction\n# Reason: Replace individual soil types with Dominant_Soil_Type, reducing cardinality for soil types.\nsoil_cols_to_drop = [\n    'Soil_Type29', 'Soil_Type22', 'Soil_Type23',\n    'Soil_Type31', 'Soil_Type33', 'Soil_Type30', \n    # Add other individual soil columns here...\n]\ndf.drop(columns=soil_cols_to_drop, inplace=True)"]
