# Elevation_Hydrology_Relative_Interaction
# Interaction between elevation and hydrology relative scale.
# Usefulness: Captures the interplay between elevation and proximity to water sources, impacting vegetation health.
df['Elevation_Hydrology_Relative_Interaction'] = df['Elevation'] * df['Hydrology_Relative_Scale']
end

python
# Weighted_Proximity
# A geometric representation of combined proximity to roads, fire points, and hydrology.
# Usefulness: Impacts environmental conditions by calculating a combined proximity metric.
df['Weighted_Proximity'] = np.sqrt(df['Horizontal_Distance_To_Roadways']2 + df['Horizontal_Distance_To_Fire_Points']2 + df['Horizontal_Distance_To_Hydrology']2)
end

python
# Slope_Light_Aspect_Interaction
# Represents the interaction between slope steepness and average sunlight exposure (hillshade).
# Usefulness: Important for detecting vegetation characteristics influenced by topography and light.
df['Slope_Light_Aspect_Interaction'] = df['Slope'] * df['Average_hillshade']
end

python
# Log_Total_Proximity
# Log transformation of Total_Proximity to address skewed data distribution.
# Usefulness: Provides stable variance to make data more suitable for machine learning algorithms.
df['Log_Total_Proximity'] = np.log(df['Total_Proximity'] + 1)
end

python
# Normalized_Hydrology_Elevation
# Min-Max normalization for Hydrology_plus_elevation feature.
# Usefulness: Ensures comparability across samples and stabilizes widely variable feature ranges for machine learning algorithms.
df['Normalized_Hydrology_Elevation'] = (df['Hydrology_plus_elevation'] - df['Hydrology_plus_elevation'].min()) / (df['Hydrology_plus_elevation'].max() - df['Hydrology_plus_elevation'].min())
end

python
# Outlier_Hillshade_Flag
# Flag samples with three standard deviations from the mean in Hillshade_Std.
# Usefulness: Identifies extreme cases, which may otherwise bias model learning.
mean_hillshade_std = df['Hillshade_Std'].mean()
std_hillshade_std = df['Hillshade_Std'].std()
df['Outlier_Hillshade_Flag'] = (df['Hillshade_Std'] > mean_hillshade_std + 3 * std_hillshade_std).astype(int)
end

python
# Log_Road_to_fire_ratio
# Address extreme skewness and large range by log transformation of Road_to_fire_ratio.
# Usefulness: Stabilizes data variance for better model training and results.
df['Log_Road_to_fire_ratio'] = np.log1p(df['Road_to_fire_ratio'])
end

python
# Normalized_Elevation_Global
# Min-Max normalization across the dataset-wide Elevation values.
# Usefulness: Standardizes elevation values globally to handle variability better across samples.
df['Normalized_Elevation_Global'] = (df['Elevation'] - df['Elevation'].min()) / (df['Elevation'].max() - df['Elevation'].min())
end

python
# Slope_Category_Binned
# Converts Slope into categorical bins: low (≤10), medium (10-20), steep (>20).
# Usefulness: Simplifies slope variability and identifies areas with steep terrain (important for vegetation).
df['Slope_Category_Binned'] = pd.cut(df['Slope'], bins=[0, 10, 20, np.inf], labels=['low', 'medium', 'steep'])
end

python
# Water_Proximity_Combined
# Create a single feature combining water proximity categories: Water_near, Water_medium, Water_far
# Usefulness: Improves model interpretability by reducing redundant water-related features.
df['Water_Proximity_Combined'] = np.select(
    [df['Water_near'] == True, df['Water_medium'] == True, df['Water_far'] == True],
    ['near', 'medium', 'far'], default='unknown'
)
end

python
# Slope_Hydrology_Effect
# Interaction term between slope and hydrology distance ratio.
# Usefulness: Captures how terrain steepness interacts with proximity to water sources, influencing vegetation.
df['Slope_Hydrology_Effect'] = df['Slope'] * df['Hydrology_Relative_Scale']
end

python
# Proximity_Outlier_Flag
# Detects proximity values (Total_Proximity) that are 3 standard deviations away from mean.
# Usefulness: Flags potential outliers for careful handling in model training.
mean_tot_proximity = df['Total_Proximity'].mean()
std_tot_proximity = df['Total_Proximity'].std()
df['Proximity_Outlier_Flag'] = (df['Total_Proximity'] > mean_tot_proximity + 3 * std_tot_proximity).astype(int)
end

python
# Dominant_Soil_Type_LabelEncode
# Label-encoding Dominant_Soil_Type instead of categorical representation.
# Usefulness: Converts soil type names into numerical labels for machine learning models.
from sklearn.preprocessing import LabelEncoder
le = LabelEncoder()
df['Dominant_Soil_Type_LabelEncode'] = le.fit_transform(df['Dominant_Soil_Type'])
end

python
# Drop Unnecessary Columns
# Columns with inf/nan values or duplicates are dropped to ensure clean data.
# Usefulness: Improves model robustness by excluding non-predictive or redundant features.
columns_to_drop = ['Log_Hydrology_Elevation_Interaction', 'Dominant_Soil_Type', 'Water_near', 'Water_medium', 'Water_far']
df.drop(columns=columns_to_drop, inplace=True)
end
