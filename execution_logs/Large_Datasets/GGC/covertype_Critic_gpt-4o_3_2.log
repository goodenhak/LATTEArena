he 'Elevation' feature relative to its mean and standard deviation.\n# Usefulness: Places elevation on a comparable scale, improving numeric feature compatibility in modeling.\ndf['Elevation_zscore'] = (df['Elevation'] - df['Elevation'].mean()) / df['Elevation'].std()\n\n# Road_Proximity_Bin\n# Categorizes horizontal distances to roads into bins: close, moderate, far based on quantiles.\n# Usefulness: Adds interpretability to infrastructure proximity, which can influence human impact on forest cover types.\ndf['Road_Proximity_Bin'] = pd.cut(df['Horizontal_Distance_To_Roadways'], bins=[0, df['Horizontal_Distance_To_Roadways'].quantile(0.33), df['Horizontal_Distance_To_Roadways'].quantile(0.66), df['Horizontal_Distance_To_Roadways'].max()], labels=['Close', 'Moderate', 'Far'])\n\n# Slope_Normalized\n# Normalizes the 'Slope' feature using Min-Max scaling.\n# Usefulness: Puts the feature on a [0, 1] scale for comparison with other features.\ndf['Slope_Normalized'] = (df['Slope'] - df['Slope'].min()) / (df['Slope'].max() - df['Slope'].min())\n\n# Hillshade_Weighted\n# Weighted sum of Hillshade indices at 9am, noon, and 3pm using cosine weights derived from solar arcs.\n# Usefulness: Captures realistic sunlight levels across the day for a given location.\nweights = [0.5, 0.3, 0.2]  # Example weights for 9am, noon, 3pm\ndf['Hillshade_Weighted'] = df['Hillshade_9am'] * weights[0] + df['Hillshade_Noon'] * weights[1] + df['Hillshade_3pm'] * weights[2]", "# Drop the following columns due to irrelevance or redundancy.\ndf.drop(columns=[\n    'Soil_Type15',  # Contains only 0\n    'Wilderness_Areas_sum',  # Always 1, no variability\n    'Soil_Type_sum',  # Always 1, no variability\n    'Total_Proximity',  # Duplicate of Total_horizontal_distance_features\n    'Water_far', 'Water_medium', 'Water_near'  # Redundant with hydrological bins\n], inplace=True)"]
