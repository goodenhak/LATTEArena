# Usefulness: Scales elevation globally to a range of [0, 1] for better comparability between wilderness areas.
df['Elevation_Normalized_Global'] = (df['Elevation'] - df['Elevation'].min()) / (df['Elevation'].max() - df['Elevation'].min())
end

python
