# Normalized_Engine_Capacity
# Feature description: Normalize Engine_Capacity_(CC) using min-max scaling to reduce effects of large value ranges on model performance.
# Usefulness: This helps balance feature importance and ensures consistency during model training by reducing the impact of extreme values.
df['Normalized_Engine_Capacity'] = (df['Engine_Capacity_(CC)'] - df['Engine_Capacity_(CC)'].min()) / (df['Engine_Capacity_(CC)'].max() - df['Engine_Capacity_(CC)'].min())
end

python
# Driver_Age_Category
# Feature description: Bins Age_of_Driver into categories such as Teen, Young Adult, Middle Age, Senior, based on fixed intervals.
# Usefulness: Driver behavior often varies significantly across age groups due to experience, risk perception, and driving habits. This helps capture group-specific patterns.
df['Driver_Age_Category'] = pd.cut(df['Age_of_Driver'], bins=[0, 20, 40, 60, 100], labels=['Teen', 'Young_Adult', 'Middle_Age', 'Senior'])
end

python
# Driver_Age_Engine_Combination
# Feature description: Combines Age_of_Driver and Engine_Capacity_(CC) to identify potential correlations between driver age and engine size preferences.
# Usefulness: It captures patterns reflecting whether younger or older drivers opt for certain engine capacities, helping infer sex differences in preferences.
df['Driver_Age_Engine_Combination'] = df['Age_of_Driver'] * df['Engine_Capacity_(CC)']
end

python
# Absolute_Age_Difference
# Feature description: Calculates the absolute difference in age between the driver and casualty to reflect interpersonal relationships, such as parent-child or spousal dynamics.
# Usefulness: Age differences can correlate with carpooling or driving relationships, offering contextual insights that can inform predictions.
df['Absolute_Age_Difference'] = abs(df['Age_of_Driver'] - df['Age_of_Casualty'])
end

python
# Regional_Context
# Feature description: Combines Urban_or_Rural_Area and Police_Force to create a composite feature reflecting regional driving patterns in urban or rural settings under specific police jurisdictions.
# Usefulness: Different police jurisdictions may enforce rules differently for urban/rural areas, influencing driving behavior and accident circumstances.
df['Regional_Context'] = df['Urban_or_Rural_Area'].astype(str) + '_' + df['Police_Force'].astype(str)
end

python
# Log_Engine_Capacity
# Feature description: Applies log transformation to Engine_Capacity_(CC) to reduce skewness and highlight relative changes in features with large outlier values.
# Usefulness: Helps mitigate impacts of extreme engine capacities while maintaining resolution in small differences.
df['Log_Engine_Capacity'] = np.log1p(df['Engine_Capacity_(CC)'])
end

python
# Collision_Event
# Feature description: Creates a binary feature summarizing whether any collision-related activity occurred (e.g., combining Hit_Object_in_Carriageway, Hit_Object_off_Carriageway, and Vehicle_Location-Restricted_Lane).
# Usefulness: A compact representation of impactful collision-related events that might influence driver demographics and behavior.
df['Collision_Event'] = ((df['Hit_Object_in_Carriageway'] > 0) | 
                         (df['Hit_Object_off_Carriageway'] > 0) | 
                         (df['Vehicle_Location-Restricted_Lane'] > 0)).astype(int)
end

python
# Target_Encoding_Police_Force
# Feature description: Replaces Police_Force values with their mean target (Sex_of_Driver) encoding. This can help with high-cardinality categorical features.
# Usefulness: Helps capture how different police forces might correlate to driver sex based on historical data.
police_mean_target = df.groupby('Police_Force')['Sex_of_Driver'].mean()
df['Target_Encoding_Police_Force'] = df['Police_Force'].map(police_mean_target)
end

python
# Bin_Local_Authority_District
# Feature description: Creates bins for Local_Authority_(District) based on percentiles or fixed intervals to reduce dimensionality in high-cardinality features.
# Usefulness: By categorizing districts, we capture general demographic or geographic patterns instead of specific authorities, improving model robustness.
df['Bin_Local_Authority_District'] = pd.qcut(df['Local_Authority_(District)'], q=10, labels=False)
end

python
# Drop Features with High Sparsity or Uninformative Value Ranges
# Feature description: Drops columns with sparse data or little variation, as they are unlikely to contribute significantly to predictive performance.
# Example: Dropping columns where >95% of values are the same or irrelevant features based on domain knowledge.
df.drop(columns=['Regional_Patterns', '1st_Road_Number', '2nd_Road_Number'], inplace=True)
end

