# Feature name: Engine_Capacity_Driver_Age_Ratio
# Feature description: Calculates the ratio between engine capacity and driver's age to understand preferences for engine power based on age.
# Usefulness: Reveals links between specific demographic groups and their vehicle preferences.
df['Engine_Capacity_Driver_Age_Ratio'] = df['Engine_Capacity_(CC)'] / (df['Age_of_Driver'] + 1e-5)  # Adding a small constant to avoid division by zero.
end

python
# Feature name: Police_Casualty_Sex_Interaction
# Feature description: Interaction between police jurisdiction, number of casualties, and casualty's sex to analyze jurisdictional impacts by demographics.
# Usefulness: Highlights how external factors (like local enforcement) vary across gender and accidents' severity.
df['Police_Casualty_Sex_Interaction'] = df['Police_Force'] * df['Number_of_Casualties'] * df['Sex_of_Casualty']
end

python
# Feature name: Normalized_Northing
# Feature description: Min-max normalization of the Location_Northing_OSGR feature to scale the large range of values for modeling.
# Usefulness: Improves the numeric scale for use in models and avoids dominance by large-valued features.
df['Normalized_Northing'] = (df['Location_Northing_OSGR'] - df['Location_Northing_OSGR'].min()) / (df['Location_Northing_OSGR'].max() - df['Location_Northing_OSGR'].min())
end

python
# Feature name: Log_Number_of_Vehicles
# Feature description: Log-transformed Number_of_Vehicles to handle skewness and compress outliers.
# Usefulness: Normalizes distributions of accidents involving many vehicles for better feature representation.
df['Log_Number_of_Vehicles'] = np.log1p(df['Number_of_Vehicles'])
end

python
# Feature name: Age_of_Driver_Binned
# Feature description: Categorized Age_of_Driver into meaningful age groups like Teen, Young Adult, Middle Age, and Senior.
# Usefulness: Simplifies interpreting age differences and makes age feature more categorical for decision-tree-based models.
age_bins = [0, 20, 40, 60, 100]
age_labels = ['Teen', 'Young Adult', 'Middle Age', 'Senior']
df['Age_of_Driver_Binned'] = pd.cut(df['Age_of_Driver'], bins=age_bins, labels=age_labels, right=False)
end

python
# Feature name: Vehicle_Type_Target_Encode
# Feature description: Encoded Vehicle_Type based on the mean target value (Sex_of_Driver).
# Usefulness: Incorporates the target's distribution into the categorical feature, often improving predictive performance.
vehicle_type_means = df.groupby('Vehicle_Type')['Sex_of_Driver'].mean()
df['Vehicle_Type_Target_Encode'] = df['Vehicle_Type'].map(vehicle_type_means)
end

