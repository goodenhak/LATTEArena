# Feature name: Vehicle_Manoeuvre_Vehicle_Type_Interaction
# Feature description: Combines Vehicle_Manoeuvre and Vehicle_Type to create an interaction feature reflecting maneuver patterns specific to certain vehicle types.
# Usefulness: Certain maneuvers, such as overtaking or turning, might be associated more with specific vehicle types (e.g., motorcycles, trucks) and may indirectly correlate with driver gender.

df['Vehicle_Manoeuvre_Vehicle_Type_Interaction'] = df['Vehicle_Manoeuvre'] * df['Vehicle_Type']
end

python
# Feature name: Age_of_Driver_Age_of_Vehicle_Interaction
# Feature description: Evaluates the interaction between Age_of_Driver and Age_of_Vehicle to gain insights into driving tendencies.
# Usefulness: Younger drivers may be more likely to use older vehicles, while older drivers may prefer newer vehicles. These patterns could correlate with gender-based preferences.

df['Age_of_Driver_Age_of_Vehicle_Interaction'] = df['Age_of_Driver'] / (df['Age_of_Vehicle'] + 1)  # Adding 1 to avoid division by 0
end

python
# Feature name: Regional_Patterns
# Feature description: Combines Urban_or_Rural_Area and Police_Force to create a feature reflecting regional driving patterns.
# Usefulness: Urban and rural areas exhibit different demographic trends. Certain police forces serve especially urban or rural communities, capturing location-specific gender trends.

df['Regional_Patterns'] = df['Urban_or_Rural_Area'].astype(str) + '_' + df['Police_Force'].astype(str)
df['Regional_Patterns'] = df['Regional_Patterns'].apply(lambda x: hash(x))  # Hashing to encode categorical interaction
end

python
# Feature name: Engine_Capacity_Normalized
# Feature description: Scales Engine_Capacity_(CC) using min-max normalization to reduce effects of large raw value ranges.
# Usefulness: Large ranges in Engine_Capacity_(CC) could disproportionately affect model training; normalization ensures proper scaling.

from sklearn.preprocessing import MinMaxScaler
scaler = MinMaxScaler()
df['Engine_Capacity_Normalized'] = scaler.fit_transform(df[['Engine_Capacity_(CC)']])
end

python
# Feature name: Age_of_Driver_Binned
# Feature description: Bins Age_of_Driver into broader, meaningful categories using fixed intervals.
# Usefulness: Driving habits and crash likelihood correlate with broader age groups (e.g., teens, young adults, elderly).

df['Age_of_Driver_Binned'] = pd.cut(df['Age_of_Driver'], bins=[0, 20, 40, 60, 100], labels=['teen', 'young_adult', 'middle_aged', 'elderly'])
end

python
# Feature name: Collision_Indicator
# Feature description: Creates a binary feature indicating whether any Vehicle_Location-Restricted_Lane or Hit_Object events occurred.
# Usefulness: Sparse categorical codes from collision-related features could be aggregated into a clearer binary indicator.

df['Collision_Indicator'] = (df['Vehicle_Location-Restricted_Lane'] > 0) | (df['Hit_Object_in_Carriageway'] > 0) | (df['Hit_Object_off_Carriageway'] > 0)
df['Collision_Indicator'] = df['Collision_Indicator'].astype(int)
end

python
# Feature name: Driver_Casualty_Age_Ratio
# Feature description: Calculates ratio between Age_of_Driver and Age_of_Casualty.
# Usefulness: Age differences between drivers and casualties in accidents can offer insights into patterns related to gender.

df['Driver_Casualty_Age_Ratio'] = df['Age_of_Driver'] / (df['Age_of_Casualty'] + 1)  # Adding 1 to avoid division by zero
end

python
# Feature name: Casualty_Count_RT
# Feature description: Root of Number_of_Casualties for cases where exponential patterns might matter.
# Usefulness: Square roots often bring non-linear patterns to manageable scales and uncover trends like proportions of gender in accidents.

df['Casualty_Count_RT'] = df['Number_of_Casualties']  0.5
end

