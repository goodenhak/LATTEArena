# Indicates whether the driver is in an age group typically considered mature (Age_Band_of_Driver >= 8).  
# Usefulness: Older drivers may have specific behavioral and demographic patterns that correlate with gender.
df['driver_mature_indicator'] = df['Age_Band_of_Driver'].apply(lambda x: 1 if x >= 8 else 0)
end

python
# engine_capacity_per_age
# Ratio of the vehicle's engine capacity to the driver's age.
# Usefulness: Provides a normalized measure of the type of vehicle driven relative to the driver's age, possibly reflecting socioeconomic factors, which may influence the sex of the driver.
df['engine_capacity_per_age'] = df['Engine_Capacity_(CC)'] / df['Age_of_Driver']
end

python
# is_urban
# Indicates whether the accident occurred in an urban area (Urban_or_Rural_Area == 1).
# Usefulness: Gender distributions may vary depending on urban vs rural contexts due to different driving patterns and activities.
df['is_urban'] = df['Urban_or_Rural_Area'].apply(lambda x: 1 if x == 1 else 0)
end

python
# casualty_same_age_band
# Indicates whether the driver and casualty are in the same age band.
# Usefulness: Shared environmental or relational factors (e.g., family members, peers) could influence driving contexts and may correlate with the driver's gender.
df['casualty_same_age_band'] = (df['Age_Band_of_Driver'] == df['Age_Band_of_Casualty']).astype(int)
end

python
# lane_restriction_impact
# Binary indicator for whether a lane restriction was present during the accident.
# Usefulness: Lane-restricted collisions might follow certain patterns that differ between male and female drivers.
df['lane_restriction_impact'] = df['Vehicle_Location-Restricted_Lane'].apply(lambda x: 1 if x > 0 else 0)
end

python
# normalized_vehicles_per_casualty
# Ratio of the number of vehicles involved to the number of casualties, normalized (z-score).
# Usefulness: Indicates accident severity based on object density, potentially reflecting contextual driving differences correlated with gender.
df['normalized_vehicles_per_casualty'] = (df['Number_of_Vehicles'] / df['Number_of_Casualties'] - df['Number_of_Vehicles'].mean()) / df['Number_of_Vehicles'].std()
end

python
# engine_capacity_binned
# Binned version of Engine_Capacity_(CC) into classes such as 'low', 'medium', 'high', 'luxury.'
# Usefulness: Some vehicle types and engine capacities may show trends related to gender preferences.
df['engine_capacity_binned'] = pd.cut(df['Engine_Capacity_(CC)'], bins=[0, 1200, 1600, 2500, float('inf')], labels=['low', 'medium', 'high', 'luxury'])
end

python
# driver_age_decade
# The decade of the driver's age (e.g., 20s, 30s, 40s).
# Usefulness: Captures generational behavior differences with regard to driving styles and gender norms.
df['driver_age_decade'] = (df['Age_of_Driver'] // 10) * 10
end

python
# distance_to_casualty_age
# Absolute difference between the age of the driver and the casualty.
# Usefulness: Reflects another relational aspect that could hint at behavioral patterns affecting driver gender.
df['distance_to_casualty_age'] = abs(df['Age_of_Driver'] - df['Age_of_Casualty'])
end

python
# casualty_sex_match
# Indicates whether the driver's sex matches the casualty's sex.
# Usefulness: Casualties' gender might correlate with the driver's gender based on environmental or familial relationships.
df['casualty_sex_match'] = (df['Sex_of_Casualty'] == df['Sex_of_Driver']).astype(int)
end

python
# rural_long_distance_driver
# Indicates if the accident occurred in a rural area and involved a high engine-capacity vehicle, suggesting possible long-distance driving.
# Usefulness: Drivers in rural areas engaging in long-distance work may exhibit a gender disparity.
df['rural_long_distance_driver'] = ((df['Urban_or_Rural_Area'] == 2) & (df['Engine_Capacity_(CC)'] > 2000)).astype(int)
end

python
# police_force_high_density
# Encodes whether the police force ID belongs to a high-density region (assumed based on ID range).
# Usefulness: Certain dense regions may exhibit behavioral differences that correlate with driver gender.
