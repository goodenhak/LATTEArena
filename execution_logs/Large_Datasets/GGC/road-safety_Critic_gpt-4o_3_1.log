2026-05-17 09:32:22,397 - INFO - ops_string = ["# Modern_Driver_Preference\n# Feature description: Represents the ratio between the age of the vehicle and the age of the driver. \n# Usefulness: Captures generational trends in vehicle preference. Older drivers may prefer older vehicles, and younger drivers may favor modern vehicles.\ndf['Modern_Driver_Preference'] = df['Age_of_Vehicle'] / (df['Age_of_Driver'] + 1)", "# Driver_to_Casualty_Age_Ratio\n# Feature description: Represents the ratio of driver’s age to casualty’s age. Helps identify generational interactions between driver and casualty.\n# Usefulness: Captures age-related interactions which might influence sex-of-driver predictions (e.g., parental relationships or age patterns).\ndf['Driver_to_Casualty_Age_Ratio'] = df['Age_of_Driver'] / (df['Sex_of_Casualty'] + 1)  # Avoid division by zero", "# Severity_Contextual\n# Feature description: Weighted representation of Traffic_Severity_Score adjusted by urban vs rural area.\n# Usefulness: Provides context-sensitive severity information, enhancing predictive ability for accidents.\ndf['Severity_Contextual'] = df['Traffic_Severity_Score'] * df['Adjusted_Severity']", "# Geo_Cluster (via KMeans clustering on geographic coordinates)\n# Feature description: Group spatial data into clusters based on Longitude and Latitude.\n# Usefulness: Creates categorical representation of geographic locations for identification of spatial patterns in driving accidents.\nfrom sklearn.cluster import KMeans\n\ngeo_features = df[['Longitude', 'Latitude']].copy()\nkmeans = KMeans(n_clusters=10, random_state=42)\ndf['Geo_Cluster'] = kmeans.fit_predict(geo_features)", "# Min-Max Normalization for Propulsion_Code\n# Feature description: Normalize Propulsion_Code to [0, 1] range.\n# Usefulness: Smoothens contribution of propulsion data to downstream predictions, avoiding dominance of larger numerical ranges.\ndf['Normalized_Propulsion'] = (df['Propulsion_Code'] - df['Propulsion_Code'].min()) / (df['Propulsion_Code'].max() - df['Propulsion_Code'].min())", "# Engine_Efficiency\n# Feature description: Calculates engine capacity per year of the vehicle's age.\n# Usefulness: Highlights whether a driver is using an older car with a high/lower capacity or a newer high-performance vehicle.\ndf['Engine_Efficiency'] = df['Engine_Capacity_(CC)'] / (df['Age_of_Vehicle'] + 1)", "# Log_Engine_Capacity (already provided)\n# Feature description: Maintain as present in dataset but ensure transformation in case it's not already applied.\n# Usefulness: Smoothens distribution of robust yet highly skewed data, leading to efficient model predictions and better variance representation.\ndf['Log_Engine_Capacity'] = np.log(df['Engine_Capacity_(CC)'] + 1)", "# Age_Gap_Scaled\n# Feature description: Scales the difference in age by the casualty age (plus 1 to avoid divide-by-zero issue).\n# Usefulness: Expresses raw difference in an interpretable fraction for mitigating extreme values in Difference_in_Age.\ndf['Age_Gap_Scaled'] = df['Difference_in_Age'] / (df['Casualty_Type'] + 1)", "# Vehicle_Type_Binned\n# Feature description: Bin Vehicle_Type into broader categories such as 'Motorized', 'Non-motorized', 'Heavy Vehicle', 'Two-Wheelers', and 'Others'.\n# Usefulness: Captures general patterns between vehicle types and driving behavior irrespective of specific numeric precision.\nbins = [0, 10, 20, 50, 100]\nlabels = ['Light_Vehicles', 'Heavy_Vehicles', 'Two_Wheelers', 'Others']\ndf['Vehicle_Type_Binned'] = pd.cut(df['Vehicle_Type'], bins=bins, labels=labels, right=False)", "# Hit_Object_Indicator\n# Feature description: Binary representation indicating whether the vehicle hit an object.\n# Usefulness: Simplifies information and ensures focus on critical events without overfitting sparsely distributed values.\ndf['Hit_Object_Indicator'] = (df['Hit_Object_off_Carriageway'] > 0).astype(int)", "# Engine_Capacity_Above_Median\n# Feature description: Indicates whether Engine Capacity is above the median.\n# Usefulness: Helps identify preference for high-performance or typical vehicles among different drivers, potentially differentiating between sexes.\nmedian_engine_capacity = df['Engine_Capacity_(CC)'].median()\ndf['Engine_Capacity_Above_Median'] = (df['Engine_Capacity_(CC)'] > median_engine_capacity).astype(int)", "# Drop non-informative or overly sparse columns\n# Make these drops after validating feature utility in exploratory data analysis steps.\ndrop_columns = ['1st_Road_Number', 'Police_Force', 'Local_Authority_(District)', 'Hit_Object_off_Carriageway']\ndf.drop(columns=drop_columns, inplace=True)"]
