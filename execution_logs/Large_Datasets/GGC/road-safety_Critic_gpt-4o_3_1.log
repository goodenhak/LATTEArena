# Usefulness: Provides an insightful metric into vehicle efficiency, reflecting on possible driver preferences related to sex.
df['Modern_Engine_Efficiency'] = df['Engine_Capacity_(CC)'] / (df['Age_of_Vehicle'] + 1)  # Avoid division by zero
end

python
# Log_Engine_Capacity
# Feature description: Log-transformed Engine_Capacity_(CC) to reduce skewness in data and mitigate the impact of extreme values.
# Usefulness: Facilitates modeling by converting highly skewed numeric features into a distribution closer to normal.
import numpy as np
df['Log_Engine_Capacity'] = np.log(df['Engine_Capacity_(CC)'] + 1)  # Avoid log(0)
end

python
# Geo_Cluster
# Feature description: Uses KMeans clustering on Longitude and Latitude to categorize geographical location into 5 groups.
# Usefulness: Encodes geographical locations consistently, increases information density on spatial patterns, and points to potential associations with sex-related driving behaviors.
from sklearn.cluster import KMeans
kmeans = KMeans(n_clusters=5, random_state=42)
df['Geo_Cluster'] = kmeans.fit_predict(df[['Longitude', 'Latitude']])
end

python
# District_Target_Enc
# Feature description: Encoding based on the average Sex_of_Driver for each Local_Authority_(District).
# Usefulness: Shares insights about local area-specific patterns and the relationship between different local authorities and driver sex frequencies.
df['District_Target_Enc'] = df.groupby('Local_Authority_(District)')['Sex_of_Driver'].transform('mean')
end

python
# Hit_Object_Indicator
# Feature description: Binary feature indicating if an object was hit off the carriageway (Hit_Object_in_Carriageway > 0).
# Usefulness: Simplifies sparse features with excessive zeros and aligns the interpretation with potential correlations to driver behavior.
df['Hit_Object_Indicator'] = (df['Hit_Object_in_Carriageway'] > 0).astype(int)
end

python
# Pedestrian_Hit_Indicator
# Feature description: Binary feature indicating if a pedestrian was hit based on Pedestrian_Location (>0).
# Usefulness: Simplifies sparse features with excessive zeros and connects pedestrian location patterns to driver behavior.
df['Pedestrian_Hit_Indicator'] = (df['Pedestrian_Location'] > 0).astype(int)
end

python
# Bin_Difference_in_Age
# Feature description: Fits Difference_in_Age into new bins: close, moderate, large, extreme difference.
# Usefulness: Improves feature interpretability and introduces non-linear patterns that may influence driver sex prediction.
bins = [0, 5, 20, 30, 85]  # Example bin limits based on range of Difference_in_Age
labels = ['Close_Age', 'Moderate_Difference', 'Large_Difference', 'Extreme_Difference']
df['Bin_Difference_in_Age'] = pd.cut(df['Difference_in_Age'], bins=bins, labels=labels)
end

### Drop columns that may create noise or are redundant for prediction
python
df.drop(columns=['Casualty_IMD_Decile'], inplace=True)
end

python
df.drop(columns=['Hit_Object_in_Carriageway', 'Pedestrian_Location'], inplace=True)  # Replaced by binary indicators
end


