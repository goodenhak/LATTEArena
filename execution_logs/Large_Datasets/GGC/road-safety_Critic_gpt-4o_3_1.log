# Usefulness: Normalizes efficiency data, improving its integration into predictive models.

df['Log_Modern_Engine_Efficiency'] = np.log1p(df['Modern_Engine_Efficiency'])
end

python
# Feature: Spatial_Region
# Feature description: Bins Latitude into South and North regions to represent broad geographical patterns in driving behavior.
# Usefulness: Captures regional differences in accident patterns based on latitude.

df['Spatial_Region'] = pd.cut(df['Latitude'], bins=[50, 54, 58], labels=['South', 'North'])
end

python
# Feature: Location_Cluster
# Feature description: Bins Longitude into West, Central, and East regions to represent longitudinal driving behavior clusters.
# Usefulness: Adds spatial information to uncover driver gender differences across regions.

df['Location_Cluster'] = pd.cut(df['Longitude'], bins=[-6, -3, 0, 2], labels=['West', 'Central', 'East'])
end

python
# Feature: ZScored_Traffic_Severity_Score
# Feature description: Applies Z-Score transformation to normalize Traffic_Severity_Score.
# Usefulness: Reduces the influence of outliers and enables integration into gradient-sensitive models.

from scipy.stats import zscore
df['ZScored_Traffic_Severity_Score'] = zscore(df['Traffic_Severity_Score'])
end

python
# Feature: ZScored_Modern_Driver_Index
# Feature description: Applies Z-Score transformation to normalize Modern_Driver_Index.
# Usefulness: Normalizes driver preferences for high-performance modern vehicles, reducing prediction noise.

df['ZScored_Modern_Driver_Index'] = zscore(df['Modern_Driver_Index'])
end

python
# Feature: Drive_Power_Index
# Feature description: Multiplies Engine_Capacity_(CC) with Age_of_Driver to create a combined driver-power indicator.
# Usefulness: Enhances predictions by capturing relationships between driver behavior and vehicle performance.

df['Drive_Power_Index'] = df['Engine_Capacity_(CC)'] * df['Age_of_Driver']
