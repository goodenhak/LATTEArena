# Usefulness: Useful in understanding how drivers’ behaviors and vehicle choices interact with varying casualty severity.
df['Casualty_Normalized_Vehicle_Type'] = df['Vehicle_Type'] / (df['Number_of_Casualties'] + 1)
end

