### Step 1: Creating Semantically Informative Features
#### 1. Rank Mode Ratio
python
# Feature Name: rank_mode_ratio
# Feature Description: Ratio of frequency of most common rank to total cards in the hand.
# Usefulness: Helps in identifying patterns of concentration, enabling differentiation of One Pair, Three of a Kind, or Four of a Kind hands.
df['rank_mode_ratio'] = df['rank_mode_count'] / 5
end

#### 2. Rank Pair Density
python
# Feature Name: pair_density
# Feature Description: Density of pair combinations within the number of unique ranks.
# Usefulness: Useful for detecting Two Pairs and Full House hands.
df['pair_density'] = df['pair_count'] / (df['rank_unique_count'] + 1e-6)  # Adding epsilon to prevent division by zero.
end

#### 3. Royal Ranks Presence Indicator
python
# Feature Name: royal_ranks_count
# Feature Description: Count of Royal ranks ({10, Jack, Queen, King, Ace}) in the hand.
# Usefulness: Key for identifying Royal Flush candidates and distinguishing high-reward hands.
royal_ranks = [10, 11, 12, 13, 1]
df['royal_ranks_count'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(lambda row: sum(rank in royal_ranks for rank in row), axis=1)
end

#### 4. Royal Flush Probability Score
python
# Feature Name: royal_flush_score
# Feature Description: Weighted combination of royal_flag and is_flush.
# Usefulness: Represents the probability a hand is a Royal Flush, combining both key criteria.
df['royal_flush_score'] = df['royal_flag'] * df['is_flush']
end

#### 5. High Rank Gap Indicator
python
# Feature Name: high_rank_gap_flag
# Feature Description: Boolean indicator for rank_gap_sum above a certain threshold (e.g., > Q3).
# Usefulness: Helps highlight hands that are unlikely to be straight combinations due to large rank gaps.
df['high_rank_gap_flag'] = (df['rank_gap_sum'] > df['rank_gap_sum'].quantile(0.75)).astype(int)
end

---

### Step 2: Handling Data Distribution and Improving Robustness
#### 1. Log Transformation of Rank Gap Sum
python
# Feature Name: log_rank_gap_sum
# Feature Description: Log transformation of rank_gap_sum to handle skewness.
# Usefulness: Controls skewness in rank_gap_sum, making downstream models less prone to extreme values.
import numpy as np
df['log_rank_gap_sum'] = np.log1p(df['rank_gap_sum'])  # log1p gives log(1+x), safe for 0 values
end

#### 2. Binning Rank Range
python
# Feature Name: binned_rank_range
# Feature Description: Binned version of rank_range into categories {Narrow, Moderate, Wide}.
# Usefulness: Aggregates granular variability in rank_range, improving feature interpretability.
import pandas as pd
bins = [0, 4, 8, 12]
labels = ['Narrow', 'Moderate', 'Wide']
df['binned_rank_range'] = pd.cut(df['rank_range'], bins=bins, labels=labels)
end

#### 3. Normalized Suit Variance
python
# Feature Name: normalized_suit_variance
# Feature Description: Standardized suit variance to align its scale with other features.
# Usefulness: Removes the bias of scale differences, emphasizing relative variability.
df['normalized_suit_variance'] = (df['suit_variance'] - df['suit_variance'].mean()) / df['suit_variance'].std()
end

#### 4. Straight Flag Enhancement
python
# Feature Name: enhanced_straight_flag
# Feature Description: Combines straight_flag and suit_variance to refine detection of straight hands.
# Usefulness: Helps differentiate Straight Flush from ordinary Straight by factoring in suit uniformity.
df['enhanced_straight_flag'] = df['straight_flag'] * (df['suit_variance'] < 0.5).astype(int)  # Suit variance close to 0 implies uniform suits.
end

---

### Step 3: Dropping Redundant or Low-Impact Columns
#### Evaluate and remove features that are highly correlated with others or provide little incremental value.
python
# Example: Dropping columns that are redundant with new engineered features.
df.drop(columns=['is_flush', 'royal_flag'], inplace=True)  # Already encoded into royal_flush_score
end

---

### Step 4: Advanced Feature Engineering Using Operators
#### 1. Card Rank Sum Z-Score
python
# Feature Name: card_rank_sum_zscore
# Feature Description: Z-score normalization of card_rank_sum.
# Usefulness: Standardizes sums of card ranks for consistency across hands.
df['card_rank_sum_zscore'] = (df['card_rank_sum'] - df['card_rank_sum'].mean()) / df['card_rank_sum'].std()
end

#### 2. Ratio of High Card Rank to Low Card Rank
python
# Feature Name: high_low_rank_ratio
# Feature Description: Ratio of the highest rank to the lowest rank in the hand.
# Usefulness: Highlights hands with disproportionately high cards, aiding in classification of High Card hands.
df['high_low_rank_ratio'] = df['high_card_rank'] / (df['low_card_rank'] + 1e-6)  # Adding epsilon to prevent division by zero.
end

#### 3. Interaction Between Suit Mode Count and Rank Mode Count
python
# Feature Name: suit_rank_interaction
# Feature Description: Interaction between suit_mode_count and rank_mode_count.
# Usefulness: Helps capture combined patterns of rank and suit concentration.
df['suit_rank_interaction'] = df['suit_mode_count'] * df['rank_mode_count']
end

