)
end

python
# log_scaled_variance
# Feature description: Apply log scaling to suit_variance for smoother distribution and reduced skewness.
# Usefulness: Improves interpretability of suit variance and assists in detecting patterns for Flush-related hands (target = 5).
import numpy as np
df['log_scaled_variance'] = np.log1p(df['suit_variance'])
end

python
# normalized_rank_gap_sum
# Feature description: Min-Max normalized version of rank_gap_sum for better handling of extreme values.
