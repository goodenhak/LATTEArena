2026-05-18 16:24:35,204 - INFO - ops_string = ["# straight_rank_order_match\n# Feature description: Checks if the ranks of the five cards form a perfect consecutive sequence (e.g., [2, 3, 4, 5, 6]).\n# Usefulness: Helps identify hands that qualify for Straight (target = 4) or Straight Flush (target = 8).\ndf['straight_rank_order_match'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(\n    lambda x: sorted(x) == list(range(min(x), min(x) + 5)), axis=1\n)", "# suit_mode_difference\n# Feature description: Difference between the frequency of the most common suit in the hand and the second most common suit.\n# Usefulness: Highlights close-to-flush hands when suit uniformity is not absolute; supports Flush detection (target = 5).\nsuit_counts = df[['V1', 'V3', 'V5', 'V7', 'V9']].apply(lambda x: [x.count(suit) for suit in range(1, 5)], axis=1)\ndf['suit_mode_difference'] = suit_counts.apply(lambda x: sorted(x, reverse=True)[0] - sorted(x, reverse=True)[1])", "# royal_flush_partial_flag\n# Feature description: Boolean indicator for presence of at least 3 royal ranks {10, Jack, Queen, King, Ace}.\n# Usefulness: Useful for identifying hands that are close to forming a Royal Flush (target = 9).\ndf['royal_flush_partial_flag'] = df[['V2', 'V4', 'V6', 'V8', 'V10']].apply(\n    lambda x: sum(rank in [10, 11, 12, 13, 1] for rank in x) >= 3, axis=1\n)", "# log_scaled_variance\n# Feature description: Apply log scaling to suit_variance for smoother distribution and reduced skewness.\n# Usefulness: Improves interpretability of suit variance and assists in detecting patterns for Flush-related hands (target = 5).\nimport numpy as np\ndf['log_scaled_variance'] = np.log1p(df['suit_variance'])", "# normalized_rank_gap_sum\n# Feature description: Min-Max normalized version of rank_gap_sum for better handling of extreme values.\n# Usefulness: Improves the consistency of rank gap analysis, making predictions more stable across varying hand types.\nfrom sklearn.preprocessing import MinMaxScaler\nscaler = MinMaxScaler()\ndf['normalized_rank_gap_sum'] = scaler.fit_transform(df[['rank_gap_sum']])", "# binned_card_rank_sum\n# Feature description: Bucketize card_rank_sum into equal-width bins (Low, Medium, High).\n# Usefulness: Highlights patterns in card total values for easier interpretation and analysis of hand strength.\nbins = [6, 20, 40, 64]\nlabels = ['Low', 'Medium', 'High']\ndf['binned_card_rank_sum'] = pd.cut(df['card_rank_sum'], bins=bins, labels=labels)", "# royal_flush_flag\n# Feature description: Boolean indicator for hands that contain {10, Jack, Queen, King, Ace} and share the same suit.\n# Usefulness: Explicitly marks potential Royal Flush situations, saving computational effort during downstream tasks.\n# Already available in original features, dropping code for illustrative purposes.\ndf.drop(columns=['royal_flush_flag'], inplace=True)", "# straight_flag\n# Feature description: Checks if the hand contains consecutive ranks (rank_range == 4 & rank_unique_count == 5).\n# Usefulness: Simplifies identification of Straight hands when used alongside other rank and suit-related indicators.\n# Already available in original features, dropping code for illustrative purposes.\ndf.drop(columns=['straight_flag'], inplace=True)", "# high_card_rank + low_card_rank difference\n# Feature description: Difference between the highest and lowest card ranks in the hand.\n# Usefulness: Highlights the spread of ranks, useful for identifying wide gaps not suited for hands such as Straights or Flushes.\ndf['high_low_rank_diff'] = df['high_card_rank'] - df['low_card_rank']", "# target_encoding of suit_variance for hand ranking task\n# Feature description: Calculate mean of suit_variance grouped by target values.\n# Usefulness: Learns predictive patterns in suit variance correlating with poker hand categories.\ndf['suit_variance_target_encoded'] = df.groupby('target')['suit_variance'].transform('mean')", "# rank_mode_count_normalized\n# Feature description: Min-Max normalization applied to rank_mode_count for easier comparison across samples.\n# Usefulness: Ensures rank frequency counts are scaled appropriately to highlight hands with repetitive ranks.\nscaler = MinMaxScaler()\ndf['rank_mode_count_normalized'] = scaler.fit_transform(df[['rank_mode_count']])"]
